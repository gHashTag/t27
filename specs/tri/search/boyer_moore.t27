// SPDX-License-Identifier: Apache-2.0
// t27/specs/tri/search/boyer_moore.t27
// Skip sections of text using bad character rule | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_boyer_moore.tri. The port
// was not native and partly invented: build_bad_char filled a local table
// and returned void (the .tri returns BMBadChar), search took only the
// text and scanned for a hard-coded "abc" (the .tri takes the pattern and
// the table and returns all occurrences), BMBadChar.pattern_len had the
// quoted type "usize", and both tests read default_input(), defined
// nowhere. The .tri: BMBadChar { table: [256]usize, pattern_len: usize }
// is the bad character skip table; search(text, pattern, bad_char) finds
// all occurrences and skips sections of text with the bad character rule.
// The skip convention kept from the port's table fill (Horspool): table[c]
// = m - 1 - (last index of c in pattern[0 .. m - 1]), m for a byte not
// there; after each window the shift is table[last text byte of window].
// The allocator-returned []usize becomes a caller buffer out: search writes
// match starts there and returns the count. An empty pattern matches
// nothing. The good-suffix rule is not in the .tri and not here.

module TriBoyerMoore;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const BMBadChar = struct {
        table : [256]usize,
        pattern_len : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn build_bad_char(pattern: []const u8) -> BMBadChar {
        const m = pattern.len;
        var table : [256]usize = [0] ** 256;
        var c : usize = 0;
        while (c < 256) {
            table[c] = m;
            c = c + 1;
        }
        var i : usize = 0;
        while (i + 1 < m) {
            table[pattern[i] as usize] = m - 1 - i;
            i = i + 1;
        }
        return BMBadChar{ .table = table, .pattern_len = m };
    }

    // pattern[0 .. m] == text[pos .. pos + m], compared right to left
    fn window_matches(text: []const u8, pattern: []const u8, pos: usize) -> bool {
        var j : usize = pattern.len;
        while (j > 0) {
            j = j - 1;
            if (text[pos + j] != pattern[j]) {
                return false;
            }
        }
        return true;
    }

    // writes match start indices to out; returns the number of matches
    fn search(text: []const u8, pattern: []const u8, bad_char: BMBadChar, out: []usize) -> usize {
        const m = pattern.len;
        var count : usize = 0;
        if (m == 0) {
            return 0;
        }
        var pos : usize = 0;
        while (pos + m <= text.len) {
            if (window_matches(text, pattern, pos)) {
                if (count < out.len) {
                    out[count] = pos;
                }
                count = count + 1;
            }
            pos = pos + bad_char.table[text[pos + m - 1] as usize];
        }
        return count;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // coded sum of x[k] * (k + 1): one number that pins every slot
    fn code(values: []const usize) -> usize {
        var sum : usize = 0;
        var k : usize = 0;
        while (k < values.len) {
            sum = sum + values[k] * (k + 1);
            k = k + 1;
        }
        return sum;
    }

    // "abra": a -> 3, b -> 2, r -> 1, c and z -> 4 (not in pattern[0..3])
    fn skips_abra() -> usize {
        const bc = build_bad_char("abra");
        const a = bc.table[97];
        const b = bc.table[98];
        const r = bc.table[114];
        const c = bc.table[99];
        const z = bc.table[122];
        return a * 10000 + b * 1000 + r * 100 + c * 10 + z + bc.pattern_len * 100000;
    }

    // "abab" in "abababcabababcab" starts at 0, 2, 7, 9: 4 matches, code 61
    fn search_overlap_code() -> usize {
        var out : [4]usize = [99] ** 4;
        const bc = build_bad_char("abab");
        const n = search("abababcabababcab", "abab", bc, &out);
        return n * 1000 + code(&out);
    }

    // "aa" in "aaaaa" starts at 0, 1, 2, 3: code 20
    fn search_runs_code() -> usize {
        var out : [4]usize = [99] ** 4;
        const bc = build_bad_char("aa");
        const n = search("aaaaa", "aa", bc, &out);
        return n * 1000 + code(&out);
    }

    // "abra" in "abracadabra" starts at 0 and 7
    fn search_abracadabra() -> usize {
        var out : [2]usize = [99] ** 2;
        const bc = build_bad_char("abra");
        const n = search("abracadabra", "abra", bc, &out);
        return n * 1000 + code(&out);
    }

    // "xbra" differs from "abra" only in its first byte: one match, at 4
    fn first_byte_mismatch() -> usize {
        var out : [2]usize = [99] ** 2;
        const bc = build_bad_char("abra");
        const n = search("xbraabra", "abra", bc, &out);
        return n * 1000 + code(&out);
    }

    // no match, pattern longer than text, empty pattern, out too small
    fn edges_ok() -> bool {
        var out : [1]usize = [99] ** 1;
        const xyz = build_bad_char("xyz");
        const none = search("hello", "xyz", xyz, &out) == 0 and out[0] == 99;
        const longer = search("xy", "xyz", xyz, &out) == 0;
        const e = build_bad_char("");
        const empty = search("abc", "", e, &out) == 0 and e.table[97] == 0;
        const a = build_bad_char("a");
        const capped = search("aaa", "a", a, &out) == 3 and out[0] == 0;
        return none and longer and empty and capped;
    }

    test bad_char_skips_abra
        given result = skips_abra()
        when expected = 4 * 100000 + 3 * 10000 + 2 * 1000 + 1 * 100 + 4 * 10 + 4
        then result == expected

    test search_finds_overlapping_matches
        given result = search_overlap_code()
        when expected = 4 * 1000 + 61
        then result == expected

    test search_finds_every_run_start
        given result = search_runs_code()
        when expected = 4 * 1000 + 20
        then result == expected

    test search_abracadabra
        given result = search_abracadabra()
        when expected = 2 * 1000 + 0 * 1 + 7 * 2
        then result == expected

    test search_checks_the_first_byte
        given result = first_byte_mismatch()
        when expected = 1 * 1000 + 4 * 1 + 99 * 2
        then result == expected

    test search_edge_inputs
        given result = edges_ok()
        when expected = true
        then result == expected
