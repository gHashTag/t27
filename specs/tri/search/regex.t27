    fn not_regexes() -> usize {
        var ok : usize = 0;
        ok = ok + refused("*");
        ok = ok + refused("a**");
        ok = ok + refused("a*+");
        ok = ok + refused("a++");
        ok = ok + refused("a?+");
        ok = ok + refused("a???");
        ok = ok + refused("|*");
        ok = ok + refused("+a");
        ok = ok + refused("(a)");
        ok = ok + refused("a)");
        ok = ok + refused("^a");
        ok = ok + refused("a$");
        ok = ok + refused("a{2}");
        ok = ok + refused("}");
        ok = ok + refused("]");
        ok = ok + refused("[");
        ok = ok + refused("[a");
        ok = ok + refused("[]");
        ok = ok + refused("[^]");
        ok = ok + refused("[]a]");
        ok = ok + refused("[b-a]");
        ok = ok + refused("[a\\]]");
        ok = ok + refused("[[a]");
        ok = ok + refused("\\");
        ok = ok + refused("a\\");
        ok = ok + refused("\\d");
        ok = ok + refused("\\1");
        ok = ok + refused("\\n");
        ok = ok + refused("a*?*");
        ok = ok + refused("[z-a]");
        return ok;
    }

    fn limits() -> usize {
        var ok : usize = 0;
        var prog : [128]Inst = [Inst{ .op = 0, .c = 0, .lo = 0, .hi = 0, .neg = false, .x = 0, .y = 0 }] ** 128;
        // "ab*" is SPLIT, a, SPLIT, b, JMP, MATCH: 6 instructions
        if (compile("ab*", prog[0 .. 6]).compiled and compile("ab*", prog[0 .. 5]).compiled == false) {
            ok = ok + 1;
        }
        // "a|b" is SPLIT, a, JMP, SPLIT, b, MATCH
        const r = compile("a|b", &prog);
        if (r.compiled and r.prog.len == 6 and r.prog[0].op == OP_SPLIT and r.prog[0].y == 3 and r.prog[2].op == OP_JMP and r.prog[2].x == 5 and r.prog[5].op == OP_MATCH) {
            ok = ok + 1;
        }
        if (compile("a|b", prog[0 .. 5]).compiled == false and compile("a|b", prog[0 .. 2]).compiled == false) {
            ok = ok + 1;
        }
        var ms : [2]Match = [Match{ .start = 0, .end = 0 }] ** 2;
        const a = compile("a", &prog);
        if (find_all(a, "aa", &ms) == 2 and find_all(a, "aaa", &ms) == NONE) {
            ok = ok + 1;
        }
        if (search(a, "aba", 1, false).start == 2 and search(a, "a", 2, false).start == NONE) {
            ok = ok + 1;
        }
        return ok;
    }

    test find_all_matches_python_finditer
        given result = all_found()
        when expected = 112
        then result == expected

    test match_matches_python_search
        given result = firsts()
        when expected = 112
        then result == expected

    test patterns_outside_the_subset_are_refused
        given result = not_regexes()
        when expected = 30
        then result == expected

    test program_size_and_buffers
        given result = limits()
        when expected = 5
        then result == expected
