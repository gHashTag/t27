// SPDX-License-Identifier: Apache-2.0
; specs/tri/net/async.t27 -- async/await semantics in the value form the compiler proves.
; t27 has no task runtime: the original draft's busy-wait `await` loop, in-place promise
; mutation, generic `Future(T)` / `Promise(T)` declarations, and function-typed callback
; parameters do not lower yet. This rewrite keeps the names and contracts in the value
; semantics: every function takes its input by value and returns the updated value (the
; StackI64 pattern from specs/tri/agent/stack.t27), `await` returns `?i64` (null while
; pending -- the Maybe(T) -> T? mapping the issue calls for), and the map transformation is
; a `MapOp` enum instead of a function-typed parameter. `new_promise` names the value up
; front, so a fulfilled future always carries a real value and no one ever reads undefined
; memory; a promise can be fulfilled exactly once.
; Proven-construct notes: optional returns (`-> ?i64`, `== null`), enum definition and
; variant comparison, struct literals and copy-in/copy-out, if/else-if chains.
; Go-like async semantics | φ² + 1/φ² = 3 | TRINITY

module TriAsync;

// FutureI64 is the reading side: `completed` says whether `value` is available.
pub const FutureI64 = struct {
    completed: bool,
    value: i64,
};

// PromiseI64 is the writing side: a future together with its one-shot fulfilment flag.
pub const PromiseI64 = struct {
    fulfilled: bool,
    future: FutureI64,
};

pub enum MapOp {
    Double,
    Negate,
    Increment,
}

// new_promise(value: i64) -> PromiseI64
// Both sides start unfulfilled. The original draft returned an undefined payload; here the
// producer names the value it will publish when it fulfils the promise, so `await` never
// reads undefined memory.
pub fn new_promise(value: i64) -> PromiseI64 {
    const future = FutureI64{ .completed = false, .value = value };
    return PromiseI64{ .fulfilled = false, .future = future };
}

// fulfill(promise: PromiseI64) -> PromiseI64
// Completes the promise's future, publishing its value. Value semantics: the updated
// promise is returned, not mutated in place. A promise can only be fulfilled once --
// fulfilling an already-fulfilled promise returns it unchanged.
pub fn fulfill(promise: PromiseI64) -> PromiseI64 {
    if (promise.fulfilled) {
        return promise;
    }
    return PromiseI64{
        .fulfilled = true,
        .future = FutureI64{ .completed = true, .value = promise.future.value },
    };
}

// await(f: FutureI64) -> ?i64
// The original draft spun until the future completed. In this synchronous value model
// there is nothing to spin on: awaiting a completed future yields its value, awaiting a
// pending future yields null.
pub fn await(f: FutureI64) -> ?i64 {
    if (f.completed) {
        return f.value;
    }
    return null;
}

// map(f: FutureI64, op: MapOp) -> FutureI64
// Transforms a completed future's value. The original draft passed a transformation
// function; function-typed parameters do not lower yet, so the transformation is one of
// the named MapOp operations. A pending future maps to itself (the operation stays
// deferred).
pub fn map(f: FutureI64, op: MapOp) -> FutureI64 {
    if (f.completed == false) {
        return f;
    }
    if (op == MapOp.Double) {
        return FutureI64{ .completed = true, .value = f.value * 2 };
    }
    if (op == MapOp.Negate) {
        return FutureI64{ .completed = true, .value = 0 - f.value };
    }
    if (op == MapOp.Increment) {
        return FutureI64{ .completed = true, .value = f.value + 1 };
    }
    return f;
}

test new_promise_starts_unfulfilled {
    const p = new_promise(7);
    assert(p.fulfilled == false);
    assert(p.future.completed == false);
}

test fulfill_completes_the_future {
    const p = fulfill(new_promise(7));
    assert(p.fulfilled == true);
    assert(p.future.completed == true);
    assert(await(p.future) == 7);
}

test await_reads_a_fulfilled_future {
    const done = fulfill(new_promise(42));
    assert(await(done.future) == 42);
}

test await_on_a_pending_future_is_null {
    const p = new_promise(42);
    assert(await(p.future) == null);
}

test a_promise_can_only_be_fulfilled_once {
    const once = fulfill(new_promise(7));
    const twice = fulfill(once);
    assert(twice.fulfilled == true);
    assert(await(twice.future) == 7);
}

test map_transforms_a_completed_future {
    const done = fulfill(new_promise(21));
    assert(await(map(done.future, MapOp.Double)) == 42);
    assert(await(map(done.future, MapOp.Negate)) == -21);
    assert(await(map(done.future, MapOp.Increment)) == 22);
}

test map_leaves_a_pending_future_pending {
    const p = new_promise(21);
    const deferred = map(p.future, MapOp.Double);
    assert(deferred.completed == false);
    assert(await(deferred) == null);
}
