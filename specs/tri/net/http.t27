    pub const HttpMethod = struct {
        enum : [GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS],
    };

    pub const HttpStatus = struct {
        code : u16,
        reason : []const u8,
    };

    pub const Url = struct {
        scheme : ?[]const u8,
        host : ?[]const u8,
        port : ?u16,
        path : []const u8,
        query : ?[]const u8,
        fragment : ?[]const u8,
    };

