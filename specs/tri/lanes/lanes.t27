// SPDX-License-Identifier: Apache-2.0
; specs/tri/lanes/lanes.t27 -- what `tri lanes` reads about a loop's lanes, and its verdict per lane
; A night loop (ledger gHashTag/trios#1729) runs its work as lanes: one branch per lane, checked out in
; its own worktree of one clone, each with a pull request into the loop's integration branch
; (`actors-next-2` in gHashTag/trios). Every tick the loop checked by hand for the anomalies the ledger
; names: a red PR, a stale agent (45 min without a change), a lane that conflicts with its base.
; This spec holds every decision of `tri lanes`: the defaults, which pull requests and worktrees are
; read, how a check rollup is judged, how old a lane is, the verdict per lane, which verdicts are
; alarms, and the exit code. The command (cli/tri/src/main.rs, through `t27c gen-rust` in
; gen/rust/tri/lanes/lanes.rs) is glue: it runs gh and git, and prints what the functions return.
; Three texts are read:
;   PRS   `gh pr list --json <PR_FIELDS>` as serde_json pretty-prints it: an array, a pull request
;         `  {` ... `  }` at indent 2, its keys at 4, a check of its statusCheckRollup at 8.
;   WTS   `git worktree list --porcelain`: records split by a blank line, `worktree <path>` first,
;         then `HEAD <sha>` and `branch refs/heads/<name>` (or `detached`). The first record is the
;         clone itself, never a lane.
;   REFS  `git for-each-ref <REF_FORMAT> refs/heads`: `refs/heads/<name>` TAB `<unix seconds>`.
;   MERGED `gh pr list --state merged --json headRefName` as gh prints it (one line, no spaces): the
;         head branches of the base's merged pull requests. A worktree on one of them is a finished
;         lane, not a stale one.
; A lane's age is the minutes since the later of its PR's updatedAt and its local branch's last
; commit. The ledger's rule is 45 min without a file change; this reads commits and pushes, not edits
; in a worktree, so a lane editing for 45 min without a commit reads as stale.
; The line readers are specs/tri/lab/receipt.t27's, imported. Fixtures are gh's real answer for
; gHashTag/trios PRs #1696 and #958 (2026-10-10), shortened, and the porcelain of the loop's clone.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriLanes;

use tri::lab::receipt::line_end;
use tri::lab::receipt::span_is;
use tri::lab::receipt::line_is;
use tri::lab::receipt::key_value;
use tri::lab::receipt::key_at;
use tri::lab::receipt::value_from;
use tri::lab::receipt::value_to;

// The defaults: the loop of gHashTag/trios#1729, its integration branch and the ledger's 45 minutes.
pub const OWNER : str = "gHashTag/";
pub const REPO : str = "trios";
pub const BASE : str = "actors-next-2";
pub const STALE_MINUTES : u64 = 45;
pub const PR_FIELDS : str = "number,headRefName,isDraft,mergeStateStatus,statusCheckRollup,updatedAt";
pub const PR_LIMIT : str = "200";
pub const MERGED_FIELDS : str = "headRefName";
pub const REF_FORMAT : str = "--format=%(refname)%09%(committerdate:unix)";
/// The age of a lane with no time to read.
pub const AGE_UNKNOWN : u64 = 4294967295;
pub const UNKNOWN : str = "?";

// A pull request's checks.
pub const CI_GREEN : u8 = 0;
pub const CI_PENDING : u8 = 1;
pub const CI_RED : u8 = 2;

// The verdict on one lane. RED, CONFLICT and STALE are the ledger's anomalies: alarms.
pub const V_READY : u8 = 0;
pub const V_PENDING : u8 = 1;
pub const V_BLOCKED : u8 = 2;
pub const V_BEHIND : u8 = 3;
pub const V_NO_PR : u8 = 4;
pub const V_DETACHED : u8 = 5;
pub const V_RED : u8 = 6;
pub const V_CONFLICT : u8 = 7;
pub const V_STALE : u8 = 8;
pub const V_MERGED : u8 = 9;

pub const EXIT_OK : u8 = 0;
pub const EXIT_ALARM : u8 = 1;
pub const EXIT_UNREAD : u8 = 2;

// A pull request row: these keys, printed `label=value`, then its checks, age and worktree.
pub const PR_CELLS : u8 = 4;

invariant the_verdicts_are_numbered { assert V_READY == 0 and V_STALE == 8 and V_MERGED == 9 and CI_RED == 2 and EXIT_UNREAD == 2 and PR_CELLS == 4 and STALE_MINUTES == 45; }

/// A repository named without an owner is gHashTag's.
pub fn needs_owner(repo: string) -> bool {
    var i : usize = 0;
    while (i < repo.len) {
        if (repo[i] == 47) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn pr_key(k: u8) -> string {
    if (k == 0) { return "number"; }
    if (k == 1) { return "headRefName"; }
    if (k == 2) { return "isDraft"; }
    return "mergeStateStatus";
}

pub fn pr_label(k: u8) -> string {
    if (k == 0) { return "pr"; }
    if (k == 1) { return "branch"; }
    if (k == 2) { return "draft"; }
    return "merge";
}

/// The offset of the next pull request `  {` at or after `at`; text.len at the array's end.
pub fn next_pr(text: string, at: usize) -> usize {
    var k : usize = at;
    while (k < text.len) {
        const end : usize = line_end(text, k);
        if (line_is(text, k, end, 2, "{")) { return k; }
        if (line_is(text, k, end, 0, "]")) { return text.len; }
        k = end + 1;
    }
    return text.len;
}

/// The end of the pull request that opens at `at`: its `  }` line, or text.len.
pub fn pr_end(text: string, at: usize) -> usize {
    var k : usize = line_end(text, at) + 1;
    while (k < text.len) {
        const end : usize = line_end(text, k);
        if (line_is(text, k, end, 2, "}")) { return end; }
        k = end + 1;
    }
    return text.len;
}

pub fn pr_from(text: string, o: usize, e: usize, k: u8) -> usize {
    return value_from(text, key_at(text, o, e, 4, pr_key(k)));
}

pub fn pr_to(text: string, o: usize, e: usize, k: u8) -> usize {
    return value_to(text, key_at(text, o, e, 4, pr_key(k)));
}

/// Is a check's conclusion (CheckRun) or state (StatusContext) the word of a failed check? A
/// cancelled run is one: on the head commit it means the check did not run, and it blocks as a red one.
pub fn failed_word(text: string, from: usize, to: usize) -> bool {
    return span_is(text, from, to, "FAILURE") or span_is(text, from, to, "ERROR") or span_is(text, from, to, "TIMED_OUT") or span_is(text, from, to, "CANCELLED") or span_is(text, from, to, "ACTION_REQUIRED") or span_is(text, from, to, "STARTUP_FAILURE") or span_is(text, from, to, "STALE");
}

/// The checks of the pull request text[o..e]: RED when one failed, PENDING when one has not finished
/// (a CheckRun status other than COMPLETED, a StatusContext state PENDING or EXPECTED), else GREEN
/// (no check at all included: nothing failed).
pub fn ci(text: string, o: usize, e: usize) -> u8 {
    var pending : bool = false;
    var at : usize = o;
    while (at < e and at < text.len) {
        const end : usize = line_end(text, at);
        const c : usize = key_value(text, at, end, 8, "conclusion");
        const s : usize = key_value(text, at, end, 8, "state");
        const st : usize = key_value(text, at, end, 8, "status");
        if (c <= end and failed_word(text, value_from(text, c), value_to(text, c))) { return CI_RED; }
        if (s <= end) {
            if (failed_word(text, value_from(text, s), value_to(text, s))) { return CI_RED; }
            if (span_is(text, value_from(text, s), value_to(text, s), "PENDING") or span_is(text, value_from(text, s), value_to(text, s), "EXPECTED")) { pending = true; }
        }
        if (st <= end and span_is(text, value_from(text, st), value_to(text, st), "COMPLETED") == false) { pending = true; }
        at = end + 1;
    }
    if (pending) { return CI_PENDING; }
    return CI_GREEN;
}

pub fn ci_name(c: u8) -> string {
    if (c == CI_GREEN) { return "green"; }
    if (c == CI_PENDING) { return "pending"; }
    return "RED";
}

/// Days from 1970-01-01 to the civil date y-m-d (Howard Hinnant's days_from_civil), for y >= 1970.
pub fn days_from_civil(y: u64, m: u64, d: u64) -> u64 {
    var yy : u64 = y;
    if (m <= 2) { yy = yy - 1; }
    const era : u64 = yy / 400;
    const yoe : u64 = yy - era * 400;
    var mp : u64 = m + 9;
    if (m > 2) { mp = m - 3; }
    const doy : u64 = (153 * mp + 2) / 5 + d - 1;
    const doe : u64 = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

/// The decimal number text[from..to], or 0 when it is empty or holds anything but digits.
pub fn digits(text: string, from: usize, to: usize) -> u64 {
    if (to <= from or to - from > 18) { return 0; }
    var n : u64 = 0;
    var i : usize = from;
    while (i < to) {
        if (text[i] < 48 or text[i] > 57) { return 0; }
        n = n * 10 + ((text[i] as u64) - 48);
        i = i + 1;
    }
    return n;
}

/// Unix seconds of a UTC time `YYYY-MM-DDTHH:MM:SSZ` at text[from..to], as GitHub writes updatedAt;
/// 0 for anything else.
pub fn iso_seconds(text: string, from: usize, to: usize) -> u64 {
    if (to - from != 20 or text[from + 4] != 45 or text[from + 7] != 45 or text[from + 10] != 84 or text[from + 13] != 58 or text[from + 16] != 58 or text[from + 19] != 90) { return 0; }
    const y : u64 = digits(text, from, from + 4);
    const mo : u64 = digits(text, from + 5, from + 7);
    const d : u64 = digits(text, from + 8, from + 10);
    if (y < 1970 or mo < 1 or mo > 12 or d < 1 or d > 31) { return 0; }
    return days_from_civil(y, mo, d) * 86400 + digits(text, from + 11, from + 13) * 3600 + digits(text, from + 14, from + 16) * 60 + digits(text, from + 17, from + 19);
}

pub fn pr_updated(text: string, o: usize, e: usize) -> u64 {
    const v : usize = key_at(text, o, e, 4, "updatedAt");
    return iso_seconds(text, value_from(text, v), value_to(text, v));
}

/// Does the line w[at..] start with lit?
pub fn starts(w: string, at: usize, lit: string) -> bool {
    if (at + lit.len > w.len) { return false; }
    return span_is(w, at, at + lit.len, lit);
}

/// The end of the worktree record that starts at `at`: the offset of its blank line, or w.len.
pub fn record_end(w: string, at: usize) -> usize {
    var k : usize = at;
    while (k < w.len) {
        const end : usize = line_end(w, k);
        if (end == k) { return k; }
        k = end + 1;
    }
    return w.len;
}

/// The next lane worktree at or after `at`: a `worktree <path>` line that does not open the porcelain
/// (that record is the clone itself) and whose path starts with dir. w.len when there is none.
pub fn next_worktree(w: string, at: usize, dir: string) -> usize {
    var k : usize = at;
    while (k < w.len) {
        const end : usize = line_end(w, k);
        if (k > 0 and starts(w, k, "worktree ") and starts(w, k + 9, dir)) { return k; }
        k = end + 1;
    }
    return w.len;
}

pub fn path_from(w: string, at: usize) -> usize {
    if (at >= w.len) { return w.len; }
    return at + 9;
}

pub fn path_to(w: string, at: usize) -> usize {
    if (at >= w.len) { return w.len; }
    return line_end(w, at);
}

/// Where the record's branch name starts (after `branch refs/heads/`); w.len when it has none.
pub fn branch_from(w: string, at: usize) -> usize {
    const stop : usize = record_end(w, at);
    var k : usize = at;
    while (k < stop) {
        if (starts(w, k, "branch refs/heads/")) { return k + 18; }
        k = line_end(w, k) + 1;
    }
    return w.len;
}

pub fn branch_to(w: string, at: usize) -> usize {
    const b : usize = branch_from(w, at);
    if (b >= w.len) { return w.len; }
    return line_end(w, b);
}

/// Is the worktree at `at` on the branch text[from..to]?
pub fn on_branch(w: string, at: usize, text: string, from: usize, to: usize) -> bool {
    const b : usize = branch_from(w, at);
    const be : usize = branch_to(w, at);
    if (b >= w.len or be - b != to - from) { return false; }
    var i : usize = 0;
    while (i < to - from) {
        if (w[b + i] != text[from + i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// The lane worktree (under dir) checked out on the pull request's head branch; w.len when none is.
pub fn worktree_of(w: string, dir: string, text: string, o: usize, e: usize) -> usize {
    var at : usize = next_worktree(w, 0, dir);
    while (at < w.len) {
        if (on_branch(w, at, text, pr_from(text, o, e, 1), pr_to(text, o, e, 1))) { return at; }
        at = next_worktree(w, record_end(w, at), dir);
    }
    return w.len;
}

/// Is the worktree at `at` the head of one of the pull requests?
pub fn has_pr(text: string, w: string, at: usize) -> bool {
    var o : usize = next_pr(text, 0);
    while (o < text.len) {
        const e : usize = pr_end(text, o);
        if (on_branch(w, at, text, pr_from(text, o, e, 1), pr_to(text, o, e, 1))) { return true; }
        o = next_pr(text, e);
    }
    return false;
}

/// Unix seconds of the last commit of the worktree's branch, from REFS; 0 when it has no branch or
/// REFS does not name it.
pub fn commit_time(refs: string, w: string, at: usize) -> u64 {
    if (at >= w.len) { return 0; }
    const b : usize = branch_from(w, at);
    const be : usize = branch_to(w, at);
    if (b >= w.len) { return 0; }
    var k : usize = 0;
    while (k < refs.len) {
        const end : usize = line_end(refs, k);
        if (starts(refs, k, "refs/heads/") and k + 11 + (be - b) < end and refs[k + 11 + (be - b)] == 9) {
            var same : bool = true;
            var i : usize = 0;
            while (i < be - b) {
                if (refs[k + 11 + i] != w[b + i]) { same = false; }
                i = i + 1;
            }
            if (same) { return digits(refs, k + 12 + (be - b), end); }
        }
        k = end + 1;
    }
    return 0;
}

/// Is the worktree's branch the head of a merged pull request in MERGED (`"headRefName":"<name>"`)?
pub fn merged(m: string, w: string, at: usize) -> bool {
    const b : usize = branch_from(w, at);
    const be : usize = branch_to(w, at);
    if (b >= w.len) { return false; }
    var k : usize = 0;
    while (k + 15 + (be - b) + 1 <= m.len) {
        if (span_is(m, k, k + 15, "\"headRefName\":\"") and m[k + 15 + (be - b)] == 34) {
            var same : bool = true;
            var i : usize = 0;
            while (i < be - b) {
                if (m[k + 15 + i] != w[b + i]) { same = false; }
                i = i + 1;
            }
            if (same) { return true; }
        }
        k = k + 1;
    }
    return false;
}

/// The later of two times; a lane moved when either its PR or its branch did.
pub fn later(a: u64, b: u64) -> u64 {
    if (a > b) { return a; }
    return b;
}

/// Whole minutes from then to now; AGE_UNKNOWN when there is no time (0) or it is in the future.
pub fn age_minutes(now: u64, then: u64) -> u64 {
    if (then == 0 or then > now) { return AGE_UNKNOWN; }
    return (now - then) / 60;
}

pub fn age_known(age: u64) -> bool {
    return age != AGE_UNKNOWN;
}

/// The verdict on a pull request lane. A failed check is RED and a conflict with the base is
/// CONFLICT, whatever its age; then a lane that has not moved for `stale` minutes is STALE, ready or
/// not (a ready lane nobody merged is the same anomaly). Then: checks running is PENDING, a branch
/// behind its base is BEHIND (rebase it), green and CLEAN (or HAS_HOOKS) is READY, and any other
/// merge state (BLOCKED, UNSTABLE, DRAFT, UNKNOWN) is BLOCKED by a rule of the base branch.
pub fn pr_verdict(text: string, o: usize, e: usize, age: u64, stale: u64) -> u8 {
    const c : u8 = ci(text, o, e);
    const mf : usize = pr_from(text, o, e, 3);
    const mt : usize = pr_to(text, o, e, 3);
    if (c == CI_RED) { return V_RED; }
    if (span_is(text, mf, mt, "DIRTY")) { return V_CONFLICT; }
    if (age_known(age) and age >= stale) { return V_STALE; }
    if (c == CI_PENDING) { return V_PENDING; }
    if (span_is(text, mf, mt, "BEHIND")) { return V_BEHIND; }
    if (span_is(text, mf, mt, "CLEAN") or span_is(text, mf, mt, "HAS_HOOKS")) { return V_READY; }
    return V_BLOCKED;
}

/// The verdict on a worktree no open pull request comes from: DETACHED when it is on no branch (a
/// base snapshot, not a lane), MERGED when its branch was merged (a finished lane), STALE when its
/// branch has not moved for `stale` minutes, else NO_PR.
pub fn worktree_verdict(w: string, at: usize, age: u64, stale: u64, done: bool) -> u8 {
    if (branch_from(w, at) >= w.len) { return V_DETACHED; }
    if (done) { return V_MERGED; }
    if (age_known(age) and age >= stale) { return V_STALE; }
    return V_NO_PR;
}

pub fn is_alarm(v: u8) -> bool {
    return v == V_RED or v == V_CONFLICT or v == V_STALE;
}

pub fn why(v: u8) -> string {
    if (v == V_READY) { return "ready: checks green, mergeable"; }
    if (v == V_PENDING) { return "pending: checks running"; }
    if (v == V_BLOCKED) { return "blocked: a rule of the base holds it (a required review or check, a draft)"; }
    if (v == V_BEHIND) { return "behind: rebase it on its base"; }
    if (v == V_NO_PR) { return "no PR yet"; }
    if (v == V_DETACHED) { return "detached: on no branch, not a lane"; }
    if (v == V_RED) { return "RED: a check failed"; }
    if (v == V_CONFLICT) { return "CONFLICT: it does not merge into its base"; }
    if (v == V_MERGED) { return "merged: a finished lane, its worktree can go"; }
    return "STALE: no commit or push for the stale minutes";
}

/// The exit code: no verdict when gh gave no pull request list (not even `[]`); ALARM on an anomaly.
pub fn exit_code(prs_read: bool, alarms: u64) -> u8 {
    if (prs_read == false) { return EXIT_UNREAD; }
    if (alarms > 0) { return EXIT_ALARM; }
    return EXIT_OK;
}

pub fn exit_why(x: u8) -> string {
    if (x == EXIT_OK) { return "exit 0: no lane is red, conflicting or stale"; }
    if (x == EXIT_ALARM) { return "exit 1: a lane is RED, in CONFLICT or STALE"; }
    return "exit 2: no verdict -- gh gave no pull request list (not logged in, no network, no such repository)";
}

const PRS : string = "[\n  {\n    \"headRefName\": \"docs/actors-not-threads\",\n    \"isDraft\": false,\n    \"mergeStateStatus\": \"BLOCKED\",\n    \"number\": 1696,\n    \"statusCheckRollup\": [\n      {\n        \"__typename\": \"CheckRun\",\n        \"conclusion\": \"SUCCESS\",\n        \"name\": \"Test\",\n        \"status\": \"COMPLETED\",\n        \"workflowName\": \"CI\"\n      }\n    ],\n    \"updatedAt\": \"2026-10-08T17:34:24Z\"\n  },\n  {\n    \"headRefName\": \"feat/trios-phd-no-image-train\",\n    \"isDraft\": false,\n    \"mergeStateStatus\": \"DIRTY\",\n    \"number\": 958,\n    \"statusCheckRollup\": [\n      {\n        \"__typename\": \"CheckRun\",\n        \"conclusion\": \"FAILURE\",\n        \"name\": \"Test\",\n        \"status\": \"COMPLETED\",\n        \"workflowName\": \"CI\"\n      }\n    ],\n    \"title\": \"\\\"conclusion\\\": \\\"FAILURE\\\" in a title is not a check\",\n    \"updatedAt\": \"2026-10-02T15:20:57Z\"\n  }\n]";

const WTS : string = "worktree /w/trios\nHEAD 55fb49f1b715c3a06387605b05b521b58b1bd012\nbranch refs/heads/actors-next\n\nworktree /w/lane-drain\nHEAD cd18f6f7de635c83b38a46d3c270227123a1965e\nbranch refs/heads/queen-drain-bound\n\nworktree /w/costflakes-base\nHEAD a6dd63b73de0c6da67c715899756550e2035756e\ndetached\n\nworktree /w/docs\nHEAD 9e7b583e889852126d16a31456166572ca45af6d\nbranch refs/heads/docs/actors-not-threads\n\nworktree /other/x\nHEAD 9e7b583e889852126d16a31456166572ca45af6d\nbranch refs/heads/queen-x\n";

const REFS : string = "refs/heads/actors-next\t1791600000\nrefs/heads/docs/actors-not-threads\t1791580000\nrefs/heads/queen-drain\t1791000000\nrefs/heads/queen-drain-bound\t1791630000\n";

// Scenario: the two pull requests are walked once each and their cells read.
test the_prs_are_walked_and_read {
    const a : usize = next_pr(PRS, 0);
    const ae : usize = pr_end(PRS, a);
    const b : usize = next_pr(PRS, ae);
    const be : usize = pr_end(PRS, b);
    assert a == 2 and next_pr(PRS, be) == PRS.len;
    assert span_is(PRS, pr_from(PRS, a, ae, 0), pr_to(PRS, a, ae, 0), "1696");
    assert span_is(PRS, pr_from(PRS, a, ae, 1), pr_to(PRS, a, ae, 1), "docs/actors-not-threads");
    assert span_is(PRS, pr_from(PRS, b, be, 3), pr_to(PRS, b, be, 3), "DIRTY");
    assert span_is(PRS, pr_from(PRS, b, be, 2), pr_to(PRS, b, be, 2), "false");
    assert next_pr("[]", 0) == 2;
    assert next_pr("", 0) == 0;
}

// Scenario: the checks of each pull request, and the check words one at a time. A title that holds
// the words is at indent 4, not a check.
test the_checks_are_judged {
    const a : usize = next_pr(PRS, 0);
    const ae : usize = pr_end(PRS, a);
    const b : usize = next_pr(PRS, ae);
    assert ci(PRS, a, ae) == CI_GREEN;
    assert ci(PRS, b, pr_end(PRS, b)) == CI_RED;
    const run : string = "        \"conclusion\": null,\n        \"status\": \"IN_PROGRESS\"\n";
    assert ci(run, 0, run.len) == CI_PENDING;
    const ctx : string = "        \"state\": \"PENDING\"\n";
    assert ci(ctx, 0, ctx.len) == CI_PENDING;
    const err : string = "        \"state\": \"ERROR\"\n";
    assert ci(err, 0, err.len) == CI_RED;
    const cancelled : string = "        \"conclusion\": \"CANCELLED\",\n        \"status\": \"COMPLETED\"\n";
    assert ci(cancelled, 0, cancelled.len) == CI_RED;
    const skipped : string = "        \"conclusion\": \"SKIPPED\",\n        \"status\": \"COMPLETED\"\n";
    assert ci(skipped, 0, skipped.len) == CI_GREEN;
    const title : string = "    \"title\": \"FAILURE\",\n    \"conclusion\": \"FAILURE\"\n";
    assert ci(title, 0, title.len) == CI_GREEN;
    assert ci("", 0, 0) == CI_GREEN;
}

// Scenario: GitHub's UTC times as Unix seconds, against values `date -u -j -f` gives.
test utc_times_are_read {
    assert iso_seconds("1970-01-01T00:00:00Z", 0, 20) == 0;
    assert iso_seconds("2026-10-08T17:34:24Z", 0, 20) == 1791480864;
    assert iso_seconds("2024-02-29T23:59:59Z", 0, 20) == 1709251199;
    assert iso_seconds("2026-10-08 17:34:24Z", 0, 20) == 0;
    assert iso_seconds("2026-10-08T17:34:24", 0, 19) == 0;
    assert iso_seconds("2026-10-08T17:34:24+", 0, 20) == 0;
    assert iso_seconds("2026-13-08T17:34:24Z", 0, 20) == 0;
    const a : usize = next_pr(PRS, 0);
    assert pr_updated(PRS, a, pr_end(PRS, a)) == 1791480864;
    assert digits("12x", 0, 3) == 0 and digits("", 0, 0) == 0 and digits("045", 0, 3) == 45;
}

// Scenario: the worktrees: the clone's own record is skipped, --dir is a path prefix, a detached one
// has no branch, and a PR's worktree is found by its head branch.
test the_worktrees_are_read {
    const l : usize = next_worktree(WTS, 0, "/w/");
    assert span_is(WTS, path_from(WTS, l), path_to(WTS, l), "/w/lane-drain");
    assert span_is(WTS, branch_from(WTS, l), branch_to(WTS, l), "queen-drain-bound");
    const d : usize = next_worktree(WTS, record_end(WTS, l), "/w/");
    assert branch_from(WTS, d) == WTS.len;
    const x : usize = next_worktree(WTS, record_end(WTS, d), "/w/");
    assert span_is(WTS, branch_from(WTS, x), branch_to(WTS, x), "docs/actors-not-threads");
    assert next_worktree(WTS, record_end(WTS, x), "/w/") == WTS.len;
    assert next_worktree(WTS, record_end(WTS, x), "") < WTS.len;
    const a : usize = next_pr(PRS, 0);
    const ae : usize = pr_end(PRS, a);
    assert worktree_of(WTS, "/w/", PRS, a, ae) == x;
    const b : usize = next_pr(PRS, ae);
    assert worktree_of(WTS, "/w/", PRS, b, pr_end(PRS, b)) == WTS.len;
    assert has_pr(PRS, WTS, x) == true;
    assert has_pr(PRS, WTS, l) == false;
    assert path_from(WTS, WTS.len) == WTS.len;
}

// Scenario: a branch's last commit from REFS, by its whole name: queen-drain is not queen-drain-bound.
test a_branch_time_is_its_own {
    const l : usize = next_worktree(WTS, 0, "/w/");
    assert commit_time(REFS, WTS, l) == 1791630000;
    const d : usize = next_worktree(WTS, record_end(WTS, l), "/w/");
    assert commit_time(REFS, WTS, d) == 0;
    const x : usize = next_worktree(WTS, record_end(WTS, d), "/w/");
    assert commit_time(REFS, WTS, x) == 1791580000;
    assert commit_time("refs/heads/queen-drain\t1791000000\n", WTS, l) == 0;
    assert commit_time("refs/heads/queen-drain-bound71791000000\n", WTS, l) == 0;
    assert commit_time(REFS, WTS, WTS.len) == 0;
    assert later(3, 5) == 5 and later(5, 3) == 5;
    assert age_minutes(1791630000 + 2700, 1791630000) == 45;
    assert age_minutes(1791630000 + 2699, 1791630000) == 44;
    assert age_minutes(100, 0) == AGE_UNKNOWN;
    assert age_minutes(100, 200) == AGE_UNKNOWN;
    assert age_known(AGE_UNKNOWN) == false and age_known(0) == true;
}

// Scenario: a merged lane is found by its whole branch name in gh's compact answer.
test a_merged_lane_is_its_own_branch {
    const l : usize = next_worktree(WTS, 0, "/w/");
    const d : usize = next_worktree(WTS, record_end(WTS, l), "/w/");
    assert merged("[{\"headRefName\":\"queen-drain-bound\"},{\"headRefName\":\"x\"}]", WTS, l) == true;
    assert merged("[{\"headRefName\":\"x\"},{\"headRefName\":\"queen-drain-bound\"}]", WTS, l) == true;
    assert merged("[{\"headRefName\":\"queen-drain-bound-2\"}]", WTS, l) == false;
    assert merged("[{\"headRefName\":\"queen-drain\"}]", WTS, l) == false;
    assert merged("[]", WTS, l) == false;
    assert merged("", WTS, l) == false;
    assert merged("[{\"headRefName\":\"\"}]", WTS, d) == false;
}

// Scenario: the lanes judged. #958 fails a check and conflicts: RED first. #1696 is green and BLOCKED:
// STALE at 45 minutes, BLOCKED at 44 and with no age.
test the_lanes_are_judged {
    const a : usize = next_pr(PRS, 0);
    const ae : usize = pr_end(PRS, a);
    const b : usize = next_pr(PRS, ae);
    const be : usize = pr_end(PRS, b);
    assert pr_verdict(PRS, b, be, 0, STALE_MINUTES) == V_RED;
    assert pr_verdict(PRS, a, ae, 45, STALE_MINUTES) == V_STALE;
    assert pr_verdict(PRS, a, ae, 44, STALE_MINUTES) == V_BLOCKED;
    assert pr_verdict(PRS, a, ae, AGE_UNKNOWN, STALE_MINUTES) == V_BLOCKED;
    const dirty : string = "  {\n    \"mergeStateStatus\": \"DIRTY\"\n  }";
    assert pr_verdict(dirty, 0, dirty.len, 900, STALE_MINUTES) == V_CONFLICT;
    const clean : string = "  {\n    \"mergeStateStatus\": \"CLEAN\"\n  }";
    assert pr_verdict(clean, 0, clean.len, 3, STALE_MINUTES) == V_READY;
    assert pr_verdict(clean, 0, clean.len, 46, STALE_MINUTES) == V_STALE;
    const behind : string = "  {\n    \"mergeStateStatus\": \"BEHIND\"\n  }";
    assert pr_verdict(behind, 0, behind.len, 3, STALE_MINUTES) == V_BEHIND;
    const running : string = "  {\n    \"mergeStateStatus\": \"CLEAN\",\n        \"status\": \"QUEUED\"\n  }";
    assert pr_verdict(running, 0, running.len, 3, STALE_MINUTES) == V_PENDING;
    const l : usize = next_worktree(WTS, 0, "/w/");
    const d : usize = next_worktree(WTS, record_end(WTS, l), "/w/");
    assert worktree_verdict(WTS, l, 10, STALE_MINUTES, false) == V_NO_PR;
    assert worktree_verdict(WTS, l, 45, STALE_MINUTES, false) == V_STALE;
    assert worktree_verdict(WTS, l, 900, STALE_MINUTES, true) == V_MERGED;
    assert worktree_verdict(WTS, d, 900, STALE_MINUTES, true) == V_DETACHED;
}

// Scenario: alarms, exits, the owner rule and the words.
test alarms_exits_and_words {
    assert is_alarm(V_RED) and is_alarm(V_CONFLICT) and is_alarm(V_STALE);
    assert is_alarm(V_READY) == false and is_alarm(V_PENDING) == false and is_alarm(V_BLOCKED) == false;
    assert is_alarm(V_BEHIND) == false and is_alarm(V_NO_PR) == false and is_alarm(V_DETACHED) == false and is_alarm(V_MERGED) == false;
    assert why(V_MERGED)[0] == 109;
    assert exit_code(false, 0) == EXIT_UNREAD;
    assert exit_code(false, 3) == EXIT_UNREAD;
    assert exit_code(true, 1) == EXIT_ALARM;
    assert exit_code(true, 0) == EXIT_OK;
    assert needs_owner("trios") == true and needs_owner("gHashTag/t27") == false;
    assert why(V_RED)[0] == 82 and why(V_CONFLICT)[0] == 67 and why(V_STALE)[0] == 83;
    assert why(V_READY)[0] == 114 and why(V_NO_PR)[0] == 110 and why(V_DETACHED)[0] == 100;
    assert why(V_PENDING)[0] == 112 and why(V_BLOCKED)[2] == 111 and why(V_BEHIND)[2] == 104;
    assert exit_why(EXIT_OK)[5] == 48 and exit_why(EXIT_ALARM)[5] == 49 and exit_why(EXIT_UNREAD)[5] == 50;
    assert span_is(ci_name(CI_RED), 0, 3, "RED") and span_is(pr_label(1), 0, 6, "branch");
}
