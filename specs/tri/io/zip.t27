        ok = ok + walks("01231123", "urdddddrdllludrururddrddrddrddu", "x x 1:-:4 2:-:- 3:-:- x x x x x x x 2:-:- 3:-:- x 2:-:- x 1:-:4 4:1:5 x x 5:4:- 6:-:- 7:-:- x x x x x x 6:-:-");
        ok = ok + walks("01111222111222212344", "drdrlurrruulrddlurdrldr", "1:-:2 2:1:3 x 3:2:4 2:1:3 0:-:- x x x x x x x 1:-:2 x x 0:-:- x 1:-:2 2:1:3 1:-:2 x 2:1:3");
