        ok = ok + walks("012344123122", "lrdrudddlddrudru", "x x 1:-:6 6:1:9 0:-:- 1:-:6 2:-:- 3:-:- x 4:-:5 x 5:4:- 3:-:- 4:-:5 5:4:- 3:-:-");
        ok = ok + walks("012312", "rdrluddlrlurrrddrlud", "x 1:-:4 4:1:- 1:-:4 0:-:- 1:-:4 2:-:- x x x 1:-:4 4:1:- x x 5:-:- x x x 4:1:- 5:-:-");
        ok = ok + walks("0111111121221122232234563231", "rulurduddlrlduuluddrlrdllrudddldruldrdr", "x x x x x 1:-:2 0:-:- 1:-:2 x x 2:1:3 1:-:2 x 0:-:- x x x 1:-:2 x 2:1:3 1:-:2 2:1:3 x 1:-:2 x 2:1:3 0:-:- 1:-:2 x x x x 2:1:3 0:-:- x 1:-:2 2:1:3 x 3:2:4");
        ok = ok + walks("01211111111211", "udrdddrd", "x 1:-:3 3:1:4 x x x 4:3:5 x");
        ok = ok + walks("01112", "dududdrduduuulddrrrrruurldddludrrdd", "1:-:2 0:-:- 1:-:2 0:-:- 1:-:2 x 2:1:3 x 0:-:- 1:-:2 0:-:- x x x 1:-:2 x 2:1:3 3:2:- x x x 0:-:- x x x 1:-:2 x x x 0:-:- 1:-:2 2:1:3 3:2:- 4:-:- x");
        ok = ok + walks("0122", "urlrdrudldrdrdlldddudllldudldlldrrdrr", "x x x x 1:-:- x 0:-:- 1:-:- x 2:-:3 3:2:- x x x 2:-:3 x x x x 1:-:- 2:-:3 x x x x 1:-:- 2:-:3 x x x x x 3:2:- x x x x");
