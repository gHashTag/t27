// SPDX-License-Identifier: Apache-2.0
// t27/specs/tri/io/zip.t27
// Immutable tree traversal | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_zipper.tri. The port was a
// stub: every move returned void after asserting `x != undefined`, Zipper
// held a quoted "List(T)" string type, and the five tests called a
// default_input() that does not exist and claimed only `result !=
// undefined`. The .tri: Zipper(T) { focus: T, left: List(T), right:
// List(T) }, "Focus point with left and right contexts"; current -> T,
// "Get focused element"; goDown, "Move focus to left child"; goUp, "Move
// focus to parent"; goLeft / goRight, "Move focus left / right sibling";
// behaviour functional_navigation, "Immutable tree traversal", "O(1)
// movement between siblings".
// The .tri's fields describe a list zipper and its moves a tree zipper;
// this is Huet's tree zipper (J. Funct. Prog. 7(5), 1997) over a tree kept
// in a caller-owned arena of Node, which the moves only read. left and
// right are the heads of the two sibling lists, linked through prev and
// next: left is the nearest left sibling (Huet keeps that list reversed),
// right the nearest right sibling, NONE for an empty list. focus is the
// focused node. The parent context of Huet's path is read from
// Node.parent. Every move is O(1) and returns a new Zipper; a move off the
// tree (no child, no parent, no sibling) returns FAIL and the caller keeps
// the old value. from_depths builds an arena from preorder depths
// ("0112" = root, two children, the second with one child); value is the
// preorder index. Generic T is i64 here (NOT CHECKED for other T).

module TriZipper;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const Node = struct {
        value : i64,
        parent : usize,
        child : usize,
        prev : usize,
        next : usize,
    };

    pub const Zipper = struct {
        focus : usize,
        left : usize,
        right : usize,
    };

    pub const NONE : usize = 18446744073709551615;

    pub const FAIL : Zipper = Zipper{ .focus = NONE, .left = NONE, .right = NONE };

    // ═══════════════════════════════════════════════════════════
    // 2. Building a tree
    // ═══════════════════════════════════════════════════════════

    // depths are ASCII digits; NONE when nodes is short, the string is
    // empty, the first depth is not 0, a second node has depth 0, or a
    // depth jumps more than one below its predecessor
    fn from_depths(depths: []const u8, nodes: []Node) -> usize {
        if (depths.len == 0 or depths.len > nodes.len or depths[0] != 48) {
            return NONE;
        }
        // last[d] is the latest node at depth d
        var last : [10]usize = [NONE] ** 10;
        var i : usize = 0;
        while (i < depths.len) {
            if (depths[i] < 48 or depths[i] > 57) {
                return NONE;
            }
            const d = (depths[i] - 48) as usize;
            if (i > 0 and (d == 0 or last[d - 1] == NONE)) {
                return NONE;
            }
            var parent = NONE;
            if (d > 0) {
                parent = last[d - 1];
            }
            var prev = NONE;
            // last[d] is reset whenever a shallower node comes, so a
            // surviving one shares this node's parent
            if (last[d] != NONE) {
                prev = last[d];
                nodes[prev].next = i;
            } else if (parent != NONE) {
                nodes[parent].child = i;
            }
            nodes[i] = Node{ .value = i as i64, .parent = parent, .child = NONE, .prev = prev, .next = NONE };
            last[d] = i;
            var k = d + 1;
            while (k < 10) {
                last[k] = NONE;
                k = k + 1;
            }
            i = i + 1;
        }
        return depths.len;
    }

    // ═══════════════════════════════════════════════════════════
    // 3. Moves
    // ═══════════════════════════════════════════════════════════

    fn root() -> Zipper {
        return Zipper{ .focus = 0, .left = NONE, .right = NONE };
    }

    fn current(nodes: []const Node, zipper: Zipper) -> i64 {
        return nodes[zipper.focus].value;
    }

    // to the first (leftmost) child
    fn go_down(nodes: []const Node, zipper: Zipper) -> Zipper {
        const c = nodes[zipper.focus].child;
        if (c == NONE) {
            return FAIL;
        }
        return Zipper{ .focus = c, .left = NONE, .right = nodes[c].next };
    }

    fn go_up(nodes: []const Node, zipper: Zipper) -> Zipper {
        const p = nodes[zipper.focus].parent;
        if (p == NONE) {
            return FAIL;
        }
        return Zipper{ .focus = p, .left = nodes[p].prev, .right = nodes[p].next };
    }

    // the left list's head becomes the focus, the focus goes onto the
    // right list
    fn go_left(nodes: []const Node, zipper: Zipper) -> Zipper {
        const l = zipper.left;
        if (l == NONE) {
            return FAIL;
        }
        return Zipper{ .focus = l, .left = nodes[l].prev, .right = zipper.focus };
    }

    fn go_right(nodes: []const Node, zipper: Zipper) -> Zipper {
        const r = zipper.right;
        if (r == NONE) {
            return FAIL;
        }
        return Zipper{ .focus = r, .left = zipper.focus, .right = nodes[r].next };
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: walks checked against a Python copy of Huet's zipper on
    // nested (value, [children]) tuples; after every move the focus and
    // the heads of both sibling lists ("-" for empty), or "x" when the
    // move fails and the walk stays put
    // ═══════════════════════════════════════════════════════════

    fn same(a: []const u8, b: []const u8) -> bool {
        if (a.len != b.len) {
            return false;
        }
        var i : usize = 0;
        while (i < a.len) {
            if (a[i] != b[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn put_num(out: []u8, at: usize, v: usize) -> usize {
        var d : usize = 1;
        while (v / d >= 10) {
            d = d * 10;
        }
        var k = at;
        while (d > 0) {
            out[k] = 48 + ((v / d) % 10) as u8;
            k = k + 1;
            d = d / 10;
        }
        return k;
    }

    fn put_head(nodes: []const Node, out: []u8, at: usize, h: usize) -> usize {
        if (h == NONE) {
            out[at] = 45;
            return at + 1;
        }
        return put_num(out, at, nodes[h].value as usize);
    }

    // moves: d u l r
    fn walks(depths: []const u8, moves: []const u8, want: []const u8) -> usize {
        var nodes : [40]Node = [Node{ .value = 0, .parent = NONE, .child = NONE, .prev = NONE, .next = NONE }] ** 40;
        if (from_depths(depths, &nodes) != depths.len) {
            return 0;
        }
        var z = root();
        var out : [400]u8 = [0] ** 400;
        var at : usize = 0;
        var i : usize = 0;
        while (i < moves.len) {
            var w = FAIL;
            if (moves[i] == 100) {
                w = go_down(&nodes, z);
            } else if (moves[i] == 117) {
                w = go_up(&nodes, z);
            } else if (moves[i] == 108) {
                w = go_left(&nodes, z);
            } else {
                w = go_right(&nodes, z);
            }
            if (i > 0) {
                out[at] = 32;
                at = at + 1;
            }
            if (w.focus == NONE) {
                out[at] = 120;
                at = at + 1;
            } else {
                z = w;
                at = put_num(&out, at, current(&nodes, z) as usize);
                out[at] = 58;
                at = put_head(&nodes, &out, at + 1, z.left);
                out[at] = 58;
                at = put_head(&nodes, &out, at + 1, z.right);
            }
            i = i + 1;
        }
        if (same(out[0 .. at], want)) {
            return 1;
        }
        return 0;
    }

    fn malformed(depths: []const u8) -> usize {
        var nodes : [40]Node = [Node{ .value = 0, .parent = NONE, .child = NONE, .prev = NONE, .next = NONE }] ** 40;
        if (from_depths(depths, &nodes) == NONE) {
            return 1;
        }
        return 0;
    }

    fn all_walks() -> usize {
        var ok : usize = 0;
        ok = ok + walks("0", "duld", "x x x x");
        ok = ok + walks("01", "dulr", "1:-:- 0:-:- x x");
        ok = ok + walks("0111", "drrrlllu", "1:-:2 2:1:3 3:2:- x 2:1:3 1:-:2 x 0:-:-");
        ok = ok + walks("0121", "drdudurul", "1:-:3 3:1:- x 0:-:- 1:-:3 0:-:- x x x");
        ok = ok + walks("0112", "drdlur", "1:-:2 2:1:- 3:-:- x 2:1:- x");
        ok = ok + walks("012345", "ddddduuuuuu", "1:-:- 2:-:- 3:-:- 4:-:- 5:-:- 4:-:- 3:-:- 2:-:- 1:-:- 0:-:- x");
        ok = ok + walks("011111", "drrrrrllllll", "1:-:2 2:1:3 3:2:4 4:3:5 5:4:- x 4:3:5 3:2:4 2:1:3 1:-:2 x x");
        ok = ok + walks("01221", "ddrlurudr", "1:-:4 2:-:3 3:2:- 2:-:3 1:-:4 4:1:- 0:-:- 1:-:4 4:1:-");
        ok = ok + walks("01223232311111122", "rddddlddddulddudrddrdrlddrddlldu", "x 1:-:9 2:-:3 x x x x x x x 1:-:9 x 2:-:3 x 1:-:9 2:-:3 3:2:5 4:-:- x x x x x x x x x x x x x 3:2:5");
        ok = ok + walks("01111122112331231222121", "dddldldludlrdldddluudlddurduludrddrdldrd", "1:-:2 x x x x x x x 0:-:- 1:-:2 x 2:1:3 x 1:-:2 x x x x 0:-:- x 1:-:2 x x x 0:-:- x 1:-:2 0:-:- x x 1:-:2 2:1:3 x x 3:2:4 x 2:1:3 x 3:2:4 x");
        ok = ok + walks("01212211223431221", "ldulludurrulrdldld", "x 1:-:3 0:-:- x x x 1:-:3 0:-:- x x x x x 1:-:3 x 2:-:- x x");
        ok = ok + walks("01212223112121212", "lllllduudldruddrrdurldr", "x x x x x 1:-:3 0:-:- x 1:-:3 x 2:-:- x 1:-:3 2:-:- x x x x 1:-:3 3:1:8 1:-:3 2:-:- x");
        ok = ok + walks("01212123421221234312221123232", "udlrdldudrrddlduldd", "x 1:-:3 x 3:1:5 4:-:- x x 3:1:5 4:-:- x x x x x x 3:1:5 1:-:3 2:-:- x");
