        ok = ok + walks("0123411123234531", "lddllrrlddldrrrlrrddrrludludlrrrlrrl", "x 1:-:5 2:-:- x x x x x 3:-:- 4:-:- x x x x x x x x x x x x x 3:-:- 4:-:- x 3:-:- 4:-:- x x x x x x x x");
        ok = ok + walks("011112111221123345661", "drdrrddr", "1:-:2 2:1:3 x 3:2:4 4:3:6 5:-:- x x");
        ok = ok + walks("0122121211", "lldddddllurrulurlduurrrdur", "x x 1:-:4 2:-:3 x x x x x 1:-:4 4:1:6 6:4:8 0:-:- x x x x 1:-:4 0:-:- x x x x 1:-:4 0:-:- x");
        ok = ok + walks("011212111123223111", "ulrdrdrdrddlrduurlrd", "x x x 1:-:2 2:1:4 3:-:- x x x x x x x x 2:1:4 0:-:- x x x 1:-:2");
        ok = ok + walks("012122111122112111212233451223", "rdrrrrddlddruurulr", "x 1:-:3 3:1:6 6:3:7 7:6:8 8:7:9 x x 7:6:8 x x 8:7:9 0:-:- x x x x x");
        ok = ok + walks("011212123", "rlrrlddurrddduurdrdrdddllrrdrr", "x x x x x 1:-:2 x 0:-:- x x 1:-:2 x x 0:-:- x x 1:-:2 2:1:4 3:-:- x x x x x x x x x x x");
        ok = ok + walks("01221212322122211212112311212", "lddurldldudduldudrlluldrldurrldrudu", "x 1:-:4 2:-:3 1:-:4 4:1:6 1:-:4 2:-:3 x x 1:-:4 2:-:3 x 1:-:4 x 2:-:3 1:-:4 2:-:3 3:2:- 2:-:3 x 1:-:4 x 2:-:3 3:2:- 2:-:3 x 1:-:4 4:1:6 6:4:11 4:1:6 5:-:- x 4:1:6 5:-:- 4:1:6");
        ok = ok + walks("0112331212", "ldrdul", "x 1:-:2 2:1:6 3:-:- 2:1:6 1:-:2");
        ok = ok + walks("01233444", "ddrrudr", "1:-:- 2:-:- x x 1:-:- 2:-:- x");
        return ok;
    }

    fn bad_trees() -> usize {
        var ok : usize = 0;
        ok = ok + malformed("");
        ok = ok + malformed("1");
        ok = ok + malformed("00");
        ok = ok + malformed("0102");
        ok = ok + malformed("02");
        ok = ok + malformed("013");
        ok = ok + malformed("0a");
        ok = ok + malformed("01:");
        ok = ok + malformed(" 0");
        ok = ok + malformed("0120 ");
        var two : [2]Node = [Node{ .value = 0, .parent = NONE, .child = NONE, .prev = NONE, .next = NONE }] ** 2;
        if (from_depths("011", &two) == NONE and from_depths("01", &two) == 2) {
            ok = ok + 1;
        }
        // the moves only read the arena: the old zipper still works
        const z = go_down(&two, root());
        if (go_up(&two, z).focus == 0 and current(&two, z) == 1 and go_down(&two, z).focus == NONE and current(&two, root()) == 0) {
            ok = ok + 1;
        }
        return ok;
    }

    test walks_match_python_huet_zipper
        given result = all_walks()
        when expected = 68
        then result == expected

    test malformed_depths_are_refused
        given result = bad_trees()
        when expected = 12
        then result == expected
