// t27/specs/
// IO monad | φ² + 1/φ² = 3 | TRINITY

module TriIO;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const IO(T) = struct {
        value : T,
    };

    // Function type aliases for higher-order functions
    pub const MapFnInt = fn(int) int;
    pub const BindFnInt = fn(int) IO(int);

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // map(io: IO(int), f: MapFnInt) → IO(int)
    fn map(io: IO(int), f: MapFnInt) -> IO(int) {
        return IO(int) {
            value: f(io.value),
        };
    }

    // bind(io: IO(int), f: BindFnInt) → IO(int)
    fn bind(io: IO(int), f: BindFnInt) -> IO(int) {
        return f(io.value);
    }

    // pure(value: T) → IO(T)
    fn pure(value: int) -> IO(int) {
        return IO(int) {
            value: value,
        };
    }

    // ═══════════════════════════════════════════════════════════
    // 4. Test Functions
    // ═══════════════════════════════════════════════════════════

    // Test function for map
    fn test_map() -> IO(int) {
        var io_value = pure(42);
        return map(io_value, fn(x: int) -> int { return x * 2; });
    }

    // Test function for bind  
    fn test_bind() -> IO(int) {
        var io_value = pure(21);
        return bind(io_value, fn(x: int) -> IO(int) { 
            return pure(x * 3); 
        });
    }

    // ═══════════════════════════════════════════════════════════
    // 5. TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test map_basic_case
        given input = default_input()
        when result = map(input, fn(x: int) -> int { return x; })
        then result != undefined

    test bind_basic_case
        given input = default_input()
        when result = bind(input, fn(x: int) -> IO(int) { return pure(x); })
        then result != undefined

    test pure_basic_case
        given input = default_input()
        when result = pure(42)
        then result != undefined