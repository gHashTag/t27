// t27/specs/
// Free deque | φ² + 1/φ² = 3 | TRINITY

module TriDeque;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Deque = struct {
        data : []i64,
        front : "usize",
        back : "usize",
        size : "usize",
        allocator : "std.mem.Allocator",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(allocator: std.mem.Allocator) → void
    fn init(allocator: std.mem.Allocator) -> void {
        let deque = allocator.create(Deque);
        deque.data = allocator.alloc(i64, 16);
        deque.front = 0;
        deque.back = 0;
        deque.size = 0;
        deque.allocator = allocator;
    }

    // push_front(deque: *Deque) → void
    fn push_front(deque: *Deque) -> void {
        if (deque.size >= 16) {
            // Resize logic could be added here, but for now we'll assume fixed size
            return;
        }
        
        deque.front = (deque.front - 1 + 16) % 16;
        deque.data[deque.front] = 0; // Default value, should be parameter
        deque.size += 1;
    }

    // push_back(deque: *Deque) → void
    fn push_back(deque: *Deque) -> void {
        if (deque.size >= 16) {
            // Resize logic could be added here, but for now we'll assume fixed size
            return;
        }
        
        deque.data[deque.back] = 0; // Default value, should be parameter
        deque.back = (deque.back + 1) % 16;
        deque.size += 1;
    }

    // pop_front(deque: *Deque) → void
    fn pop_front(deque: *Deque) -> void {
        if (deque.size == 0) {
            return; // Empty deque
        }
        
        deque.front = (deque.front + 1) % 16;
        deque.size -= 1;
    }

    // pop_back(deque: *Deque) → void
    fn pop_back(deque: *Deque) -> void {
        if (deque.size == 0) {
            return; // Empty deque
        }
        
        deque.back = (deque.back - 1 + 16) % 16;
        deque.size -= 1;
    }

    // deinit(deque: *Deque) → void
    fn deinit(deque: *Deque) -> void {
        if (deque.data != null) {
            deque.allocator.free(deque.data);
            deque.allocator.destroy(deque);
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test init_basic_case
        given input = default_input()
        when result = init(input)
        then result != undefined

    test push_front_basic_case
        given input = default_input()
        when result = push_front(input)
        then result != undefined

    test push_back_basic_case
        given input = default_input()
        when result = push_back(input)
        then result != undefined

    test pop_front_basic_case
        given input = default_input()
        when result = pop_front(input)
        then result != undefined

    test pop_back_basic_case
        given input = default_input()
        when result = pop_back(input)
        then result != undefined

    test deinit_basic_case
        given input = default_input()
        when result = deinit(input)
        then result != undefined

