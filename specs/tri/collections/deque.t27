// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Free deque | φ² + 1/φ² = 3 | TRINITY

module TriDeque;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Deque = struct {
        data : []i64,
        front : "usize",
        back : "usize",
        size : "usize",
        allocator : "std.mem.Allocator",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(allocator: std.mem.Allocator) → Deque
    fn init(allocator: std.mem.Allocator) -> Deque {
        return Deque{
            .data = &[_]i64{},
            .front = 0,
            .back = 0,
            .size = 0,
            .allocator = allocator,
        };
    }

    // push_front(deque: *Deque, value: i64) → !void
    fn push_front(deque: *Deque, value: i64) -> !void {
        if (deque.size == deque.data.len) {
            const new_capacity = if (deque.data.len == 0) 4 else deque.data.len * 2;
            const new_data = deque.allocator.alloc(i64, new_capacity) catch return;
            for (0..deque.size) |i| {
                new_data[i] = deque.data[(deque.front + i) % deque.data.len];
            }
            deque.allocator.free(deque.data);
            deque.data = new_data;
            deque.front = 0;
            deque.back = deque.size;
        }
        if (deque.data.len > 0) {
            deque.front = (deque.front + deque.data.len - 1) % deque.data.len;
        }
        deque.data[deque.front] = value;
        deque.size += 1;
    }

    // push_back(deque: *Deque, value: i64) → !void
    fn push_back(deque: *Deque, value: i64) -> !void {
        if (deque.size == deque.data.len) {
            const new_capacity = if (deque.data.len == 0) 4 else deque.data.len * 2;
            const new_data = deque.allocator.alloc(i64, new_capacity) catch return;
            for (0..deque.size) |i| {
                new_data[i] = deque.data[(deque.front + i) % deque.data.len];
            }
            deque.allocator.free(deque.data);
            deque.data = new_data;
            deque.front = 0;
            deque.back = deque.size;
        }
        deque.data[deque.back] = value;
        deque.back = (deque.back + 1) % deque.data.len;
        deque.size += 1;
    }

    // pop_front(deque: *Deque) → i64
    fn pop_front(deque: *Deque) -> i64 {
        if (deque.size == 0) {
            @panic("pop_front on empty deque is a programmer error");
        }
        const value = deque.data[deque.front];
        deque.front = (deque.front + 1) % deque.data.len;
        deque.size -= 1;
        return value;
    }

    // pop_back(deque: *Deque) → i64
    fn pop_back(deque: *Deque) -> i64 {
        if (deque.size == 0) {
            @panic("pop_back on empty deque is a programmer error");
        }
        deque.back = (deque.back + deque.data.len - 1) % deque.data.len;
        const value = deque.data[deque.back];
        deque.size -= 1;
        return value;
    }

    // deinit(deque: *Deque) → void
    fn deinit(deque: *Deque) -> void {
        deque.allocator.free(deque.data);
        deque.front = 0;
        deque.back = 0;
        deque.size = 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test init_basic_case
        given input = std.testing.allocator
        when result = init(input)
        then result != undefined

    test push_front_basic_case
        given d = init(std.testing.allocator)
        when d.push_front(42) catch unreachable
        then d.size == 1
        and d.data[d.front] == 42

    test push_back_basic_case
        given d = init(std.testing.allocator)
        when d.push_back(42) catch unreachable
        then d.size == 1
        and d.data[d.back - 1] == 42

    test pop_front_basic_case
        given d = init(std.testing.allocator)
        when d.push_back(10) catch unreachable
        and d.push_back(20) catch unreachable
        and result = d.pop_front()
        then result == 10
        and d.size == 1
        and d.data[d.front] == 20

    test pop_back_basic_case
        given d = init(std.testing.allocator)
        when d.push_front(10) catch unreachable
        and d.push_front(20) catch unreachable
        and result = d.pop_back()
        then result == 10
        and d.size == 1
        and d.data[d.front] == 20

    test deinit_basic_case
        given d = init(std.testing.allocator)
        when d.push_back(10) catch unreachable
        and d.deinit()
        then d.size == 0
        and d.front == 0
        and d.back == 0

    test init_creates_empty_deque
        given d = init(std.testing.allocator)
        then d.data.len == 0
        and d.front == 0
        and d.back == 0
        and d.size == 0

    test push_front_adds_element_to_empty_deque
        given d = init(std.testing.allocator)
        when d.push_front(42) catch unreachable
        then d.size == 1
        and d.data[d.front] == 42
        and d.back == 1

    test push_back_adds_element_to_empty_deque
        given d = init(std.testing.allocator)
        when d.push_back(42) catch unreachable
        then d.size == 1
        and d.data[d.back - 1] == 42
        and d.front == 0

    test push_front_grows_capacity_when_full
        given d = Deque{.data=@constCast(&[_]i64{10,20}),.front=0,.back=2,.size=2,.allocator=std.testing.allocator}
        when d.push_front(30) catch unreachable
        then d.data.len == 4
        and d.size == 3
        and d.data[d.front] == 30
        and d.data[1] == 10
        and d.data[2] == 20

    test push_back_grows_capacity_when_full
        given d = Deque{.data=@constCast(&[_]i64{10,20}),.front=0,.back=2,.size=2,.allocator=std.testing.allocator}
        when d.push_back(30) catch unreachable
        then d.data.len == 4
        and d.size == 3
        and d.data[2] == 30
        and d.data[0] == 10
        and d.data[1] == 20

    test pop_front_removes_and_returns_front_element
        given d = init(std.testing.allocator)
        when d.push_back(10) catch unreachable
        and d.push_back(20) catch unreachable
        and result = d.pop_front()
        then result == 10
        and d.size == 1
        and d.data[d.front] == 20

    test pop_back_removes_and_returns_back_element
        given d = init(std.testing.allocator)
        when d.push_front(10) catch unreachable
        and d.push_front(20) catch unreachable
        and result = d.pop_back()
        then result == 10
        and d.size == 1
        and d.data[d.front] == 20

    test pop_front_maintains_circular_buffer_after_wrap
        given d = Deque{.data=@constCast(&[_]i64{0,10,20,0}),.front=1,.back=3,.size=2,.allocator=std.testing.allocator}
        when d.push_front(30) catch unreachable
        and result = d.pop_front()
        then result == 30
        and d.size == 2
        and d.data[d.front] == 10
        and d.data[d.back - 1] == 20

    test pop_back_maintains_circular_buffer_after_wrap
        given d = Deque{.data=@constCast(&[_]i64{0,10,20,0}),.front=1,.back=3,.size=2,.allocator=std.testing.allocator}
        when d.push_back(30) catch unreachable
        and result = d.pop_back()
        then result == 30
        and d.size == 2
        and d.data[d.front] == 10
        and d.data[d.back - 1] == 20

    test deinit_frees_memory_and_resets_state
        given d = init(std.testing.allocator)
        when d.push_back(10) catch unreachable
        and d.deinit()
        then d.size == 0
        and d.front == 0
        and d.back == 0

    test deque_holds_its_elements_and_its_two_ends_apart
        given d = Deque{.data=@constCast(&[_]i64{10,20,30,40}),.front=1,.back=3,.size=3,.allocator=std.testing.allocator}
        then d.data.len == 4
        and d.data[d.front] == 20
        and d.data[d.back] == 40
        and d.size <= d.data.len