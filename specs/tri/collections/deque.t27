// t27/specs/tri/collections/deque.t27
// Double-ended queue | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_deque.tri. The port did
// not compile (quoted field types, `let`, `allocator.alloc`, `!void` with
// `error.Overflow`, `+=`) and its tests could not run. The .tri: Deque
// { data: []i64, front, back, size, allocator }, "Double-ended queue with
// dynamic array"; init(allocator) creates an empty deque; pushFront and
// pushBack(deque, value) -> !void add to the front and back; popFront and
// popBack(deque) -> i64 remove from the front and back; deinit frees.
// Here the allocator becomes a caller buffer, a ring of data.len slots:
// front is the slot of the first value, back the slot after the last,
// size the count. A push into a full deque returns false (the !void
// error) and changes nothing. A pop writes the value to out[0] and returns
// true, or returns false on an empty deque without writing out; the .tri's
// popFront and popBack return a bare i64 and do not say what an empty pop
// gives. out is a one-slot slice (#6358 item 4). deinit has nothing to
// free and is gone. NOT CHECKED: "dynamic array" growth (capacity is
// data.len, fixed). Values are written as 0 - k in the tests, never as
// unary minus (#6549). Mutation-checked 2026-10-06: 13 mutants of every
// function fail a test.

module TriDeque;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const Deque = struct {
        data : []i64,
        front : usize,
        back : usize,
        size : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn init(data: []i64) -> Deque {
        return Deque{ .data = data, .front = 0, .back = 0, .size = 0 };
    }

    fn push_front(d: *Deque, value: i64) -> bool {
        const cap = d.data.len;
        if (d.size >= cap) {
            return false;
        }
        d.front = (d.front + cap - 1) % cap;
        d.data[d.front] = value;
        d.size = d.size + 1;
        return true;
    }

    fn push_back(d: *Deque, value: i64) -> bool {
        const cap = d.data.len;
        if (d.size >= cap) {
            return false;
        }
        d.data[d.back] = value;
        d.back = (d.back + 1) % cap;
        d.size = d.size + 1;
        return true;
    }

    fn pop_front(d: *Deque, out: []i64) -> bool {
        if (d.size == 0) {
            return false;
        }
        out[0] = d.data[d.front];
        d.front = (d.front + 1) % d.data.len;
        d.size = d.size - 1;
        return true;
    }

    fn pop_back(d: *Deque, out: []i64) -> bool {
        if (d.size == 0) {
            return false;
        }
        const cap = d.data.len;
        d.back = (d.back + cap - 1) % cap;
        out[0] = d.data[d.back];
        d.size = d.size - 1;
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // pop everything from the front, coding the values as a decimal
    // string of (value + 50), two digits each
    fn drain_front(d: *Deque) -> i64 {
        var out : [1]i64 = [0];
        var sum : i64 = 0;
        while (pop_front(d, &out)) {
            sum = sum * 100 + out[0] + 50;
        }
        return sum;
    }

    // capacity 4: push_back 1, 2; push_front 3, then 0 - 4: the order is
    // -4, 3, 1, 2 and the front has wrapped below slot 0
    fn mixed_code() -> i64 {
        var data : [4]i64 = [0] ** 4;
        var d = init(&data);
        const pushed = push_back(&d, 1) and push_back(&d, 2) and push_front(&d, 3)
            and push_front(&d, 0 - 4);
        if (!pushed or d.size != 4 or d.front != 2 or d.back != 2) {
            return 0;
        }
        return drain_front(&d);
    }

    // a full deque refuses both pushes; an empty one refuses both pops and
    // leaves out alone
    fn bounds_ok() -> bool {
        var data : [2]i64 = [0] ** 2;
        var d = init(&data);
        var out : [1]i64 = [9];
        const empty = !pop_front(&d, &out) and !pop_back(&d, &out) and out[0] == 9;
        const filled = push_back(&d, 5) and push_front(&d, 6);
        const full = !push_back(&d, 7) and !push_front(&d, 8) and d.size == 2 and data[0] == 5
            and data[1] == 6;
        return empty and filled and full;
    }

    // pop_back takes from the back, pop_front from the front, and the ring
    // keeps working after wrapping both ways
    fn both_ends_code() -> i64 {
        var data : [3]i64 = [0] ** 3;
        var d = init(&data);
        var out : [1]i64 = [0];
        const a = push_back(&d, 1) and push_back(&d, 2) and push_back(&d, 3);
        const b = pop_back(&d, &out) and out[0] == 3 and pop_front(&d, &out) and out[0] == 1;
        const c = push_back(&d, 4) and push_back(&d, 5) and d.size == 3;
        const e = pop_back(&d, &out) and out[0] == 5 and push_front(&d, 0 - 6);
        if (!a or !b or !c or !e or d.size != 3) {
            return 0;
        }
        // order -6, 2, 4
        return drain_front(&d);
    }

    test push_front_and_back_wrap
        given result = mixed_code()
        when expected = 46535152
        then result == expected

    test full_and_empty_refuse
        given result = bounds_ok()
        when expected = true
        then result == expected

    test pops_from_both_ends
        given result = both_ends_code()
        when expected = 445254
        then result == expected
