// SPDX-License-Identifier: Apache-2.0
//
// Doubly linked list of i64 values.
//
// Nodes carry an i64 payload and optional links to the previous and next
// nodes. The list head and tail are optional node pointers. The nodes are
// built and linked by the caller; this module provides pure analysis
// functions over the resulting chain. The original allocator-backed
// mutating operations (append, prepend, remove, deinit) were removed
// because the reference compiler generates code that requires concrete
// struct types and value-based data flow, so the module now exposes pure
// queries over caller-linked nodes.
//
// TRINITY: 3-6-9 | 6-3-9 | 9-6-3
module TriLinkedList;

pub const ListNode = struct {
    value : i64,
    prev : ?*ListNode = null,
    next : ?*ListNode = null,
};

pub const LinkedList = struct {
    head : ?*ListNode = null,
    tail : ?*ListNode = null,
    length : i64 = 0,
};

pub fn init() -> LinkedList {
    return LinkedList{ .head = null, .tail = null, .length = 0 };
}

// Walk the chain starting at node and count every node reached.
fn walk(node : ?*ListNode) -> i64 {
    if (node == null) {
        return 0;
    }
    var current : ?*ListNode = node;
    var count : i64 = 0;
    while (current != null) {
        count = count + 1;
        current = current.?.next;
    }
    return count;
}

// Walk the chain starting at node and count every node reached via prev.
fn walk_prev(node : ?*ListNode) -> i64 {
    if (node == null) {
        return 0;
    }
    var current : ?*ListNode = node;
    var count : i64 = 0;
    while (current != null) {
        count = count + 1;
        current = current.?.prev;
    }
    return count;
}

// Count the nodes reachable from the list head.
pub fn size(list : LinkedList) -> i64 {
    return walk(list.head);
}

// Return the value stored at the head, or null when the list is empty.
pub fn first(list : LinkedList) -> ?i64 {
    if (list.head == null) {
        return null;
    }
    const node : ?*ListNode = list.head;
    return node.?.value;
}

// Return the value stored at the tail, or null when the list is empty.
pub fn last(list : LinkedList) -> ?i64 {
    if (list.tail == null) {
        return null;
    }
    const node : ?*ListNode = list.tail;
    return node.?.value;
}

// Return the first node holding the value, or null when absent.
pub fn find(list : LinkedList, value : i64) -> ?*ListNode {
    var current : ?*ListNode = list.head;
    while (current != null) {
        if (current.?.value == value) {
            return current;
        }
        current = current.?.next;
    }
    return null;
}

// Report whether the list holds the value.
pub fn contains(list : LinkedList, value : i64) -> bool {
    const hit : ?*ListNode = find(list, value);
    if (hit == null) {
        return false;
    }
    return true;
}

// Return the chain as an array of values in head-to-tail order.
pub fn to_array(list : LinkedList) -> [8]i64 {
    var out : [8]i64 = [8]i64{ 0, 0, 0, 0, 0, 0, 0, 0 };
    var live : i64 = 0;
    var i : usize = 0;
    var current : ?*ListNode = list.head;
    while (current != null) {
        if (i < 8) {
            out[i] = current.?.value;
            live = live + 1;
            i = i + 1;
        }
        current = current.?.next;
    }
    if (live > 8) {
        live = 8;
    }
    return out;
}

test "init creates an empty list" {
    const list = init();
    assert(size(list) == 0);
    assert(list.head == null);
    assert(list.tail == null);
    assert(list.length == 0);
}

test "forward walk counts one plus size of rest" {
    var c = ListNode{ .value = 30, .prev = null, .next = null };
    var b = ListNode{ .value = 20, .prev = null, .next = null };
    var a = ListNode{ .value = 10, .prev = null, .next = null };
    a.next = &b;
    b.prev = &a;
    b.next = &c;
    c.prev = &b;
    const list = LinkedList{ .head = &a, .tail = &c, .length = 3 };
    assert(size(list) == 3);
    assert(size(LinkedList{ .head = &b, .tail = &c, .length = 2 }) == 2);
    assert(size(LinkedList{ .head = &c, .tail = &c, .length = 1 }) == 1);
}

test "backward walk counts one plus size of prev" {
    var c = ListNode{ .value = 30, .prev = null, .next = null };
    var b = ListNode{ .value = 20, .prev = null, .next = null };
    var a = ListNode{ .value = 10, .prev = null, .next = null };
    a.next = &b;
    b.prev = &a;
    b.next = &c;
    c.prev = &b;
    assert(walk_prev(a.prev) == 0);
    assert(walk_prev(b.prev) == 1);
    assert(walk_prev(c.prev) == 2);
}

test "empty list is size zero" {
    const list = init();
    assert(size(list) == 0);
    assert(first(list) == null);
    assert(last(list) == null);
    assert(contains(list, 42) == false);
}

test "first and last expose the end values" {
    var c = ListNode{ .value = 30, .prev = null, .next = null };
    var b = ListNode{ .value = 20, .prev = null, .next = null };
    var a = ListNode{ .value = 10, .prev = null, .next = null };
    a.next = &b;
    b.prev = &a;
    b.next = &c;
    c.prev = &b;
    const list = LinkedList{ .head = &a, .tail = &c, .length = 3 };
    assert(first(list).? == 10);
    assert(last(list).? == 30);
}

test "find returns the first node with the value" {
    var c = ListNode{ .value = 30, .prev = null, .next = null };
    var b = ListNode{ .value = 20, .prev = null, .next = null };
    var a = ListNode{ .value = 10, .prev = null, .next = null };
    a.next = &b;
    b.prev = &a;
    b.next = &c;
    c.prev = &b;
    const list = LinkedList{ .head = &a, .tail = &c, .length = 3 };
    const hit : ?*ListNode = find(list, 20);
    assert(hit != null);
    assert(hit.?.value == 20);
    assert(hit.?.next.?.value == 30);
    assert(find(list, 99) == null);
}

test "contains reports membership with concrete values" {
    var c = ListNode{ .value = 30, .prev = null, .next = null };
    var b = ListNode{ .value = 20, .prev = null, .next = null };
    var a = ListNode{ .value = 10, .prev = null, .next = null };
    a.next = &b;
    b.prev = &a;
    b.next = &c;
    c.prev = &b;
    const list = LinkedList{ .head = &a, .tail = &c, .length = 3 };
    assert(contains(list, 10) == true);
    assert(contains(list, 30) == true);
    assert(contains(list, 40) == false);
}

test "to_array returns head to tail order" {
    var c = ListNode{ .value = 30, .prev = null, .next = null };
    var b = ListNode{ .value = 20, .prev = null, .next = null };
    var a = ListNode{ .value = 10, .prev = null, .next = null };
    a.next = &b;
    b.prev = &a;
    b.next = &c;
    c.prev = &b;
    const list = LinkedList{ .head = &a, .tail = &c, .length = 3 };
    const arr = to_array(list);
    assert(arr[0] == 10);
    assert(arr[1] == 20);
    assert(arr[2] == 30);
    const empty_arr = to_array(init());
    assert(empty_arr[0] == 0);
}
