// t27/specs/
//  | φ² + 1/φ² = 3 | TRINITY

module TriNamespace;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Restored 2026-10-05 from trinity specs/tri/tri_namespace.tri: the port
    // wrote the variants and the union arms as typeless fields (#3225).
    pub const Namespace = enum {
        core,
        dev,
        forge,
        agent,
        mcp,
        system,
    };

    pub const NamespacedCommand = struct {
        namespace : Namespace,
        command : []const u8,
    };

    // An empty `command` in `namespaced` means "list the namespace".
    pub const ParsedCommand = union(enum) {
        namespaced: NamespacedCommand,
        flat: []const u8,
        help,
    };

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test namespaces_are_the_six_in_display_order
        given first = @intFromEnum(Namespace.core)
        and forge = @intFromEnum(Namespace.forge)
        and last = @intFromEnum(Namespace.system)
        then first == 0 and forge == 2 and last == 5
