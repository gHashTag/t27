module TriNamespace;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Namespace = struct {
        // Recovered from the upstream spec this file was converted from:
        // trinity-fpga specs/tri/tri_namespace.tri:7. The converter dropped bare
        // `- name` bullets, leaving `kind : Enum, variants : ,` with no names.
        enum : [core, dev, forge, agent, mcp, system],
    };

    pub const ParsedCommand = struct {
        kind : Union(enum),
        variants : ,
        namespaced : ,
        flat : ,
        help : void,
    };

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "namespace_smoke_test" {
        expect(true)
    }

    test namespace_lists_the_six_command_groups
        // Recovered from trinity-fpga specs/tri/tri_namespace.tri:7. The
        // upstream spec's own behaviors say Namespace.toString returns the
        // lowercase variant name, so the spelling below is load-bearing.
        then @typeInfo(Namespace).@"enum".fields.len == 6
        and std.mem.eql(u8, @typeInfo(Namespace).@"enum".fields[0].name, "core")
        and std.mem.eql(u8, @typeInfo(Namespace).@"enum".fields[5].name, "system")
