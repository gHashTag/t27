// t27/specs/
// Forces checking error case | φ² + 1/φ² = 3 | TRINITY

module TriResult;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Result(T, E) = struct {
        is_ok : bool,
        value : T,
        error : E,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // ok(value: T) → Result(T, E)
    fn ok(value: T) -> Result(T, E) {
        return Result(T, E){ .is_ok = true, .value = value, .error = undefined };
    }

    // err(error: E) → Result(T, E)
    fn err(error: E) -> Result(T, E) {
        return Result(T, E){ .is_ok = false, .error = error, .value = undefined };
    }

    // unwrap_or(result: Result(T, E), fallback: T) → T
    fn unwrap_or(result: Result(T, E), fallback: T) -> T {
        if (result.is_ok) {
            return result.value;
        } else {
            return fallback;
        }
    }

    // is_error(result: Result(T, E)) → bool
    fn is_error(result: Result(T, E)) -> bool {
        return !result.is_ok;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "ok_sets_is_ok_true_and_carries_the_value" {
        var r = ok(7);
        assert(r.is_ok == true);
        assert(r.value == 7);
    }

    test "ok_sets_error_to_undefined" {
        var r = ok(42);
        assert(r.is_ok == true);
        assert(r.error == undefined);
    }

    test "err_sets_is_ok_false_and_carries_the_error" {
        var r = err("error message");
        assert(r.is_ok == false);
        assert(r.error == "error message");
    }

    test "err_sets_value_to_undefined" {
        var r = err(99);
        assert(r.is_ok == false);
        assert(r.value == undefined);
    }

    test "unwrap_or_returns_the_value_on_ok_result" {
        var r = ok(123);
        assert(is_error(r) == false);
        assert(unwrap_or(r, 456) == 123);
    }

    test "unwrap_or_returns_the_fallback_on_error_result" {
        var r = err("error");
        assert(is_error(r) == true);
        assert(unwrap_or(r, 789) == 789);
    }

    test "is_error_returns_false_on_ok_result" {
        var r = ok("success");
        assert(is_error(r) == false);
    }

    test "is_error_returns_true_on_error_result" {
        var r = err("failure");
        assert(is_error(r) == true);
    }

    test "unwrap_or_fallback_differs_from_carried_value" {
        var r = ok(100);
        assert(unwrap_or(r, 200) == 100);
        assert(unwrap_or(r, 200) != 200);
    }

test "unwrap_or_error_payload_never_returned" {
        var r = err("error");
        assert(unwrap_or(r, "fallback") == "fallback");
        assert(unwrap_or(r, "fallback") != "error");
    }

    // Test for copy_propagate bug: undefined should not be propagated as a source value
    test "copy_propagate_undefined_not_propagated" {
        var result_value : i32 = undefined;
        var error_flag : bool = false;
        
        // Initialize result to undefined, then set it in a conditional
        if (true) {
            result_value = 42;  // Write to result in conditional block
            error_flag = false;
        }
        
        // This should return 42, not undefined (copy_propagate bug might propagate undefined)
        assert(result_value == 42);
        assert(error_flag == false);
    }

    // Test for copy_propagate bug: variable initialized to undefined then written in nested block
    test "copy_propagate_nested_block_write_not_undefined" {
        var output : i32 = undefined;
        var counter : usize = 0;
        
        while (counter < 2) {
            // Nested block where variable is assigned
            if (counter == 0) {
                output = 10;
            } else {
                output = 20;
            }
            counter = counter + 1;
        }
        
        // This should return 20, not undefined (copy_propagate bug might not see nested writes)
        assert(output == 20);
    }

    // Test for copy_propagate bug: Result with undefined values should not be incorrectly propagated
    test "copy_propagate_result_undefined_handling" {
        var test_result : Result(i32, str) = err("test error");
        
        // This should return the fallback, not propagate undefined from the error case
        var fallback_value = unwrap_or(test_result, 99);
        assert(fallback_value == 99);
        
        // Create a valid result and test that undefined fields are handled correctly
        var valid_result = ok(123);
        assert(valid_result.is_ok == true);
        assert(valid_result.value == 123);
        // error field should be undefined, but copy_propagate shouldn't propagate it as a source
        assert(valid_result.error == undefined);
    }

    