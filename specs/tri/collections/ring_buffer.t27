// t27/specs/tri/collections/ring_buffer.t27
// Fixed-size ring buffer that refuses a push when full | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_ring.tri. The port did
// not compile (generic T never bound, create_buffer and Option(T) defined
// nowhere, `if is_full(ring)` without parens) and its tests contradicted
// each other: is_full kept one slot empty, so a ring of capacity 3 holds
// 2 values, while wrap_around_behavior pushed 3 values into it and
// expected all three to succeed; another test was named "both show head
// equal to tail" over a full ring whose head and tail differ. The .tri:
// Ring(T) { buffer: []T, head, tail, capacity }, "Fixed-size circular
// buffer"; new(capacity); push(ring, value) -> bool, "Add to back, false
// if full"; pop(ring) -> Option(T), "Remove from front"; isEmpty; isFull.
// The .tri contradicts itself: its behaviour "circular" adds the note
// "Overwrites old data when pushing to full ring", against push's "false
// if full". This spec follows the function contract (push refuses);
// circular_buffer.t27 is the overwriting buffer. Here T is usize, the
// buffer is the caller's (capacity = buffer.len, refused at 0 by
// capacity_ok), and a count field tells full from empty, so all capacity
// slots hold values. pop writes the value to out[0] and returns whether
// there was one (the Option); out is a one-slot slice because a pointer
// out-param written through .* hits codegen bug #6358 item 4.
// Mutation-checked 2026-10-06: 11 mutants of every function fail a test.

module TriRing;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const Ring = struct {
        buffer : []usize,
        head : usize,
        tail : usize,
        count : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn new(buffer: []usize) -> Ring {
        return Ring{ .buffer = buffer, .head = 0, .tail = 0, .count = 0 };
    }

    fn capacity_ok(buffer: []const usize) -> bool {
        return buffer.len > 0;
    }

    fn is_empty(ring: *Ring) -> bool {
        return ring.count == 0;
    }

    fn is_full(ring: *Ring) -> bool {
        return ring.count == ring.buffer.len;
    }

    fn push(ring: *Ring, value: usize) -> bool {
        if (is_full(ring)) {
            return false;
        }
        ring.buffer[ring.tail] = value;
        ring.tail = (ring.tail + 1) % ring.buffer.len;
        ring.count = ring.count + 1;
        return true;
    }

    fn pop(ring: *Ring, out: []usize) -> bool {
        if (is_empty(ring)) {
            return false;
        }
        out[0] = ring.buffer[ring.head];
        ring.head = (ring.head + 1) % ring.buffer.len;
        ring.count = ring.count - 1;
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // pop everything, coded as sum of value * 10^k in pop order
    fn drain_code(ring: *Ring) -> usize {
        var sum : usize = 0;
        var scale : usize = 1;
        var guard : usize = 0;
        var got : [1]usize = [0];
        while (guard <= ring.buffer.len) {
            const some = pop(ring, &got);
            if (!some) {
                return sum;
            }
            sum = sum + got[0] * scale;
            scale = scale * 10;
            guard = guard + 1;
        }
        return 0;
    }

    // capacity 3 holds 3 values; a fourth push is refused and changes
    // nothing; pops come out in push order
    fn full_code() -> usize {
        var buf : [3]usize = [0] ** 3;
        var r = new(&buf);
        const fresh = is_empty(&r) and !is_full(&r) and r.head == 0 and r.tail == 0;
        const pushed = push(&r, 1) and push(&r, 2) and push(&r, 3);
        const full = is_full(&r) and !is_empty(&r) and r.head == 0 and r.tail == 0;
        const refused = !push(&r, 4) and r.count == 3 and buf[0] == 1;
        if (!fresh or !pushed or !full or !refused) {
            return 0;
        }
        return drain_code(&r);
    }

    // wrap-around: capacity 3, push 1 2, pop 1, push 3 4 (4 wraps to
    // slot 0), pop 2 3 4
    fn wrap_code() -> usize {
        var buf : [3]usize = [0] ** 3;
        var r = new(&buf);
        var got : [1]usize = [0];
        const pushed = push(&r, 1) and push(&r, 2);
        const first = pop(&r, &got) and got[0] == 1;
        const more = push(&r, 3) and push(&r, 4) and is_full(&r) and buf[0] == 4 and r.tail == 1;
        if (!pushed or !first or !more) {
            return 0;
        }
        return drain_code(&r);
    }

    // pop on empty leaves out alone; capacity 1; capacity_ok refuses 0
    fn edges_ok() -> bool {
        var buf : [2]usize = [0] ** 2;
        var r = new(&buf);
        var got : [1]usize = [7];
        const none = !pop(&r, &got) and got[0] == 7 and r.count == 0 and r.head == 0;
        var one : [1]usize = [0];
        var s = new(&one);
        const single = push(&s, 5) and is_full(&s) and !push(&s, 6) and pop(&s, &got) and got[0] == 5
            and is_empty(&s) and !pop(&s, &got) and got[0] == 5;
        const sized = capacity_ok(&buf) and capacity_ok(&one) and !capacity_ok(one[0..0]);
        return none and single and sized;
    }

    test a_full_ring_refuses_a_push
        given result = full_code()
        when expected = 1 + 20 + 300
        then result == expected

    test pops_in_push_order_with_wrap
        given result = wrap_code()
        when expected = 2 + 30 + 400
        then result == expected

    test empty_pops_and_capacity_one
        given result = edges_ok()
        when expected = true
        then result == expected
