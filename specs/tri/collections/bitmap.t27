// SPDX-License-Identifier: Apache-2.0
// t27/specs/tri/collections/bitmap.t27
// Fixed-capacity bit set over usize words | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_bitmap.tri. The port did
// not compile (`let`, `allocator.alloc`, `return undefined` for a ?usize),
// clear_all skipped the last partial word, find_last looped `while
// bit_index >= 0` on a usize, and its 22 tests read init(...,
// std.mem.default_allocator), which no backend has. The .tri: Bitmap {
// bits: []usize, capacity }, "Fixed-capacity bit set"; init(capacity,
// allocator) -> !Bitmap creates n bits; get tests a bit; set sets it to 1;
// clear sets it to 0; flip toggles it; setAll sets all bits to 1;
// clearAll sets all to 0; count is the popcount; findFirst and findLast
// -> ?usize are the index of the first and last set bit; behaviour
// compact: "Uses usize words", "O(n/word_size) operations".
// Here the allocator becomes a caller word buffer: init takes at least
// words_for(capacity) words (fits says so), zeroes and keeps exactly that
// many. Bit k lives in word k / 64 at position k % 64. set_all sets the
// capacity bits only, so the bits past capacity in the last word stay 0
// and count never sees them. find_first and find_last write the index to
// out[0] and return whether a bit is set (the ?usize); out is a one-slot
// slice (#6358 item 4). Masks are bound to a typed const before ~, and a
// full word is the literal ALL_ONES: the Zig backend folds ~ of a usize
// const 0 to -1, which usize cannot hold (#6549).
// NOT CHECKED: index < capacity in get, set, clear and flip; and the word
// complexity of count, find_first and find_last, which here walk bits.
// Mutation-checked 2026-10-06: 13 mutants of every function fail a test.

module TriBitmap;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const Bitmap = struct {
        bits : []usize,
        capacity : usize,
    };

    pub const WORD_BITS : usize = 64;
    pub const ALL_ONES : usize = 18446744073709551615;

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn words_for(capacity: usize) -> usize {
        return (capacity + WORD_BITS - 1) / WORD_BITS;
    }

    fn fits(words: []const usize, capacity: usize) -> bool {
        return words.len >= words_for(capacity);
    }

    fn init(words: []usize, capacity: usize) -> Bitmap {
        const n = words_for(capacity);
        var i : usize = 0;
        while (i < n) {
            words[i] = 0;
            i = i + 1;
        }
        return Bitmap{ .bits = words[0..n], .capacity = capacity };
    }

    fn get(bitmap: *Bitmap, index: usize) -> bool {
        return ((bitmap.bits[index / WORD_BITS] >> (index % WORD_BITS)) & 1) == 1;
    }

    fn set(bitmap: *Bitmap, index: usize) -> void {
        const w = index / WORD_BITS;
        const mask : usize = (1 as usize) << (index % WORD_BITS);
        bitmap.bits[w] = bitmap.bits[w] | mask;
    }

    fn clear(bitmap: *Bitmap, index: usize) -> void {
        const w = index / WORD_BITS;
        const mask : usize = (1 as usize) << (index % WORD_BITS);
        bitmap.bits[w] = bitmap.bits[w] & ~mask;
    }

    fn flip(bitmap: *Bitmap, index: usize) -> void {
        const w = index / WORD_BITS;
        const mask : usize = (1 as usize) << (index % WORD_BITS);
        bitmap.bits[w] = bitmap.bits[w] ^ mask;
    }

    fn set_all(bitmap: *Bitmap) -> void {
        const full = bitmap.capacity / WORD_BITS;
        var i : usize = 0;
        while (i < full) {
            bitmap.bits[i] = ALL_ONES;
            i = i + 1;
        }
        const rest = bitmap.capacity % WORD_BITS;
        if (rest > 0) {
            const one : usize = (1 as usize) << rest;
            bitmap.bits[full] = one - 1;
        }
    }

    fn clear_all(bitmap: *Bitmap) -> void {
        var i : usize = 0;
        while (i < bitmap.bits.len) {
            bitmap.bits[i] = 0;
            i = i + 1;
        }
    }

    fn count(bitmap: *Bitmap) -> usize {
        var total : usize = 0;
        var k : usize = 0;
        while (k < bitmap.capacity) {
            if (get(bitmap, k)) {
                total = total + 1;
            }
            k = k + 1;
        }
        return total;
    }

    fn find_first(bitmap: *Bitmap, out: []usize) -> bool {
        var k : usize = 0;
        while (k < bitmap.capacity) {
            if (get(bitmap, k)) {
                out[0] = k;
                return true;
            }
            k = k + 1;
        }
        return false;
    }

    fn find_last(bitmap: *Bitmap, out: []usize) -> bool {
        var k = bitmap.capacity;
        while (k > 0) {
            k = k - 1;
            if (get(bitmap, k)) {
                out[0] = k;
                return true;
            }
        }
        return false;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // init zeroes the buffer and keeps words_for(n) words
    fn init_ok() -> bool {
        var words : [3]usize = [7] ** 3;
        var b = init(&words, 65);
        const shape = b.capacity == 65 and b.bits.len == 2 and words[0] == 0 and words[1] == 0
            and words[2] == 7 and count(&b) == 0;
        const counts = words_for(0) == 0 and words_for(1) == 1 and words_for(64) == 1 and words_for(65) == 2;
        var one : [1]usize = [0];
        const sized = fits(&words, 192) and !fits(&words, 193) and fits(&one, 64) and !fits(&one, 65);
        return shape and counts and sized;
    }

    // set, clear and flip one bit each, across the word boundary
    fn bits_ok() -> bool {
        var words : [2]usize = [0] ** 2;
        var b = init(&words, 128);
        set(&b, 0);
        set(&b, 63);
        set(&b, 64);
        set(&b, 127);
        set(&b, 63);
        const placed = words[0] == 9223372036854775809 and words[1] == 9223372036854775809
            and get(&b, 64) and !get(&b, 1) and !get(&b, 65) and count(&b) == 4;
        clear(&b, 0);
        clear(&b, 1);
        flip(&b, 2);
        flip(&b, 127);
        const changed = words[0] == 9223372036854775812 and words[1] == 1 and !get(&b, 0) and get(&b, 2)
            and count(&b) == 3;
        flip(&b, 2);
        return placed and changed and !get(&b, 2) and count(&b) == 2;
    }

    // set_all on 96 bits fills word 0 and the low 32 bits of word 1 only;
    // clear_all empties both words
    fn all_ok() -> bool {
        var words : [2]usize = [0] ** 2;
        var b = init(&words, 96);
        set_all(&b);
        const filled = words[0] == 18446744073709551615 and words[1] == 4294967295 and count(&b) == 96;
        clear_all(&b);
        const emptied = words[0] == 0 and words[1] == 0 and count(&b) == 0;
        var w64 : [1]usize = [0];
        var c = init(&w64, 64);
        set_all(&c);
        return filled and emptied and w64[0] == 18446744073709551615 and count(&c) == 64;
    }

    // first and last set bit; an empty bitmap leaves out alone
    fn find_code() -> usize {
        var words : [2]usize = [0] ** 2;
        var b = init(&words, 100);
        var out : [1]usize = [55];
        const none = !find_first(&b, &out) and !find_last(&b, &out) and out[0] == 55;
        set(&b, 5);
        set(&b, 70);
        set(&b, 99);
        var first : [1]usize = [0];
        var last : [1]usize = [0];
        const found = find_first(&b, &first) and find_last(&b, &last);
        clear(&b, 5);
        clear(&b, 99);
        var mid1 : [1]usize = [0];
        var mid2 : [1]usize = [0];
        const one = find_first(&b, &mid1) and find_last(&b, &mid2);
        set(&b, 0);
        var zero : [1]usize = [9];
        const low = find_last(&b, &mid2) and find_first(&b, &zero) and zero[0] == 0;
        if (!none or !found or !one or !low) {
            return 0;
        }
        return first[0] * 1000000 + last[0] * 10000 + mid1[0] * 100 + mid2[0];
    }

    test init_zeroes_and_sizes
        given result = init_ok()
        when expected = true
        then result == expected

    test set_clear_flip_and_get
        given result = bits_ok()
        when expected = true
        then result == expected

    test set_all_keeps_to_capacity
        given result = all_ok()
        when expected = true
        then result == expected

    test find_first_and_last
        given result = find_code()
        when expected = 5 * 1000000 + 99 * 10000 + 70 * 100 + 70
        then result == expected
