// SPDX-License-Identifier: Apache-2.0
// t27/specs/tri/collections/bitvector.t27
// Growable bit array | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_bitvector.tri. The port was
// Zig, not t27 (allocator.alloc/free, `for (0..n) |i|`, `|=`, `+=`,
// if-expressions, @bitSizeOf, `?bool`/null), and all eight tests read
// default_input() and asserted `result != undefined`. The .tri:
// BitVector { bits: []usize, length }; empty(); withCapacity(bits,
// allocator); push(bv, bit, allocator) appends; pop(bv) -> ?bool removes
// the last bit; get(bv, index); set(bv, index, value); len(bv);
// append(bv, other, allocator) concatenates; behaviour "grows as needed".
// Here the allocator becomes a caller word buffer, so the vector cannot
// grow past it: capacity is bits.len * WORD_BITS, and push and append
// return false (and change nothing) when the bits do not fit. empty() is a
// zero-word view of the caller's buffer; with_capacity zeroes the buffer
// it is given. pop returns a Popped { ok, bit } instead of ?bool: ok is
// false on an empty vector. get and set take index < len (NOT CHECKED
// beyond the word buffer, as in the .tri). Bit k lives in word k / 64 at
// position k % 64, so the word layout is observable and tested.
// Mutation-checked 2026-10-06: 12 mutants of get, set, push, pop, append,
// with_capacity and capacity all fail a test.

module TriBitvector;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const BitVector = struct {
        bits : []usize,
        length : usize,
    };

    pub const Popped = struct {
        ok : bool,
        bit : bool,
    };

    pub const WORD_BITS : usize = 64;

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn empty(words: []usize) -> BitVector {
        return BitVector{ .bits = words[0..0], .length = 0 };
    }

    fn with_capacity(words: []usize) -> BitVector {
        var i : usize = 0;
        while (i < words.len) {
            words[i] = 0;
            i = i + 1;
        }
        return BitVector{ .bits = words, .length = 0 };
    }

    fn capacity(bv: BitVector) -> usize {
        return bv.bits.len * WORD_BITS;
    }

    fn len(bv: BitVector) -> usize {
        return bv.length;
    }

    fn get(bv: BitVector, index: usize) -> bool {
        const word = bv.bits[index / WORD_BITS];
        return ((word >> (index % WORD_BITS)) & 1) == 1;
    }

    fn set(bv: *BitVector, index: usize, value: bool) -> void {
        const w = index / WORD_BITS;
        const mask : usize = (1 as usize) << (index % WORD_BITS);
        if (value) {
            bv.bits[w] = bv.bits[w] | mask;
        } else {
            bv.bits[w] = bv.bits[w] & ~mask;
        }
    }

    fn push(bv: *BitVector, bit: bool) -> bool {
        if (bv.length >= capacity(bv.*)) {
            return false;
        }
        bv.length = bv.length + 1;
        set(bv, bv.length - 1, bit);
        return true;
    }

    fn pop(bv: *BitVector) -> Popped {
        if (bv.length == 0) {
            return Popped{ .ok = false, .bit = false };
        }
        bv.length = bv.length - 1;
        return Popped{ .ok = true, .bit = get(bv.*, bv.length) };
    }

    fn append(bv: *BitVector, other: BitVector) -> bool {
        if (bv.length + other.length > capacity(bv.*)) {
            return false;
        }
        var i : usize = 0;
        while (i < other.length) {
            set(bv, bv.length, get(other, i));
            bv.length = bv.length + 1;
            i = i + 1;
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // the bits of bv as a binary number, first bit most significant
    fn read(bv: BitVector) -> usize {
        var out : usize = 0;
        var i : usize = 0;
        while (i < bv.length) {
            out = out * 2;
            if (get(bv, i)) {
                out = out + 1;
            }
            i = i + 1;
        }
        return out;
    }

    // push 1 0 1 1 0, pop twice (0 then 1), push 1: 1 0 1 1 = 11
    fn push_pop_code() -> usize {
        var words : [1]usize = [7];
        var bv = with_capacity(&words);
        const cleared = words[0] == 0 and len(bv) == 0 and capacity(bv) == 64;
        const pushed = push(&bv, true) and push(&bv, false) and push(&bv, true) and push(&bv, true)
            and push(&bv, false);
        const a = pop(&bv);
        const b = pop(&bv);
        const again = push(&bv, true);
        if (!cleared or !pushed or !a.ok or a.bit or !b.ok or !b.bit or !again or len(bv) != 4) {
            return 0;
        }
        return read(bv);
    }

    // bit k is word k / 64, position k % 64: setting bits 0, 3, 64, 65
    // gives words (9, 3); clearing bit 3 gives (1, 3)
    fn layout_ok() -> bool {
        var words : [2]usize = [5] ** 2;
        var bv = with_capacity(&words);
        var k : usize = 0;
        var pushed : bool = true;
        while (k < 70) {
            const p = push(&bv, k == 0 or k == 3 or k == 64 or k == 65);
            pushed = pushed and p;
            k = k + 1;
        }
        const placed = words[0] == 9 and words[1] == 3 and get(bv, 64) and !get(bv, 63) and get(bv, 3);
        set(&bv, 3, false);
        set(&bv, 0, true);
        const cleared = words[0] == 1 and words[1] == 3 and !get(bv, 3) and len(bv) == 70;
        return pushed and placed and cleared;
    }

    // a pop that crosses back over the word boundary; pop on empty
    fn boundary_ok() -> bool {
        var words : [2]usize = [0] ** 2;
        var bv = with_capacity(&words);
        var k : usize = 0;
        var filled : bool = true;
        while (k < 65) {
            const p = push(&bv, k == 63);
            filled = filled and p;
            k = k + 1;
        }
        const last = pop(&bv);
        const top = pop(&bv);
        const below = pop(&bv);
        var none = empty(&words);
        const nothing = pop(&none);
        return filled and last.ok and !last.bit and top.ok and top.bit and below.ok and !below.bit
            and len(bv) == 62 and !nothing.ok and len(none) == 0 and capacity(none) == 0
            and !push(&none, true);
    }

    // append concatenates in order; it refuses what would not fit and
    // accepts what fills the capacity exactly
    fn append_code() -> usize {
        var wa : [1]usize = [0];
        var wb : [1]usize = [0];
        var a = with_capacity(&wa);
        var b = with_capacity(&wb);
        const made = push(&a, true) and push(&a, false) and push(&b, false) and push(&b, true) and push(&b, true);
        if (!made or !append(&a, b)) {
            return 0;
        }
        var wc : [1]usize = [0];
        var c = with_capacity(&wc);
        var i : usize = 0;
        var filled : bool = true;
        while (i < 62) {
            const p = push(&c, true);
            filled = filled and p;
            i = i + 1;
        }
        const refused = filled and !append(&c, b) and len(c) == 62 and len(b) == 3;
        var wd : [1]usize = [0];
        var d = with_capacity(&wd);
        const two = push(&d, false) and push(&d, true);
        const exact = two and append(&c, d) and len(c) == 64 and get(c, 63) and !get(c, 62);
        if (!refused or !exact) {
            return 1;
        }
        return len(a) * 1000 + read(a);
    }

    test push_and_pop
        given result = push_pop_code()
        when expected = 11
        then result == expected

    test word_layout_and_set
        given result = layout_ok()
        when expected = true
        then result == expected

    test pop_across_a_word_boundary
        given result = boundary_ok()
        when expected = true
        then result == expected

    test append_concatenates
        given result = append_code()
        when expected = 5 * 1000 + 19
        then result == expected
