// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Free queue | φ² + 1/φ² = 3 | TRINITY

module TriPriorityQueue;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const PriorityQueue = struct {
        data : []i64,
        size : "usize",
        allocator : "std.mem.Allocator",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(allocator: std.mem.Allocator) → void
    fn init(allocator: std.mem.Allocator) -> void {
        return PriorityQueue{ .data = &[_]i64{}, .size = 0, .allocator = allocator };
    }

    // enqueue(pq: *PriorityQueue, value: i64) → void
    fn enqueue(pq: *PriorityQueue, value: i64) -> !void {
        if (pq.size == pq.data.len) {
            let new_capacity = if (pq.data.len == 0) 1 else pq.data.len * 2;
            let new_data = @as([]i64, @ptrCast(@alignCast(pq.allocator.alloc(u8, new_capacity * @sizeOf(i64))))));
            @memcpy(@ptrCast(new_data), @ptrCast(pq.data), pq.size);
            pq.allocator.free(@ptrCast(pq.data));
            pq.data = new_data;
        }
        
        let i = pq.size;
        pq.data[i] = value;
        
        while (i > 0) {
            let parent = (i - 1) / 2;
            if (pq.data[parent] <= pq.data[i]) {
                break;
            }
            let temp = pq.data[parent];
            pq.data[parent] = pq.data[i];
            pq.data[i] = temp;
            i = parent;
        }
        
        pq.size = pq.size + 1;
    }

    // dequeue(pq: *PriorityQueue) → void
    fn dequeue(pq: *PriorityQueue) -> i64 {
        // Note: Caller should check is_empty() first. On empty queue, behavior is undefined.
        let min = pq.data[0];
        pq.size = pq.size - 1;
        
        if (pq.size > 0) {
            pq.data[0] = pq.data[pq.size];
            
            let i = 0;
            while (true) {
                let left = 2 * i + 1;
                let right = 2 * i + 2;
                let smallest = i;
                
                if (left < pq.size and pq.data[left] < pq.data[smallest]) {
                    smallest = left;
                }
                if (right < pq.size and pq.data[right] < pq.data[smallest]) {
                    smallest = right;
                }
                
                if (smallest == i) {
                    break;
                }
                
                let temp = pq.data[i];
                pq.data[i] = pq.data[smallest];
                pq.data[smallest] = temp;
                i = smallest;
            }
        }
        
        return min;
    }

    // peek(pq: *PriorityQueue) → void
    fn peek(pq: *PriorityQueue) -> i64 {
        // Note: Caller should check is_empty() first. On empty queue, behavior is undefined.
        return pq.data[0];
    }

    // is_empty(pq: *PriorityQueue) → void
    fn is_empty(pq: *PriorityQueue) -> bool {
        return pq.size == 0;
    }

    // deinit(pq: *PriorityQueue) → void
    fn deinit(pq: *PriorityQueue) -> void {
        pq.allocator.free(@ptrCast(pq.data));
        pq.size = 0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test init_basic_case
        given input = default_input()
        when result = init(input)
        then result != undefined

    test enqueue_basic_case
        given input = default_input()
        when result = enqueue(input)
        then result != undefined

    test dequeue_basic_case
        given input = default_input()
        when result = dequeue(input)
        then result != undefined

    test peek_basic_case
        given input = default_input()
        when result = peek(input)
        then result != undefined

    test is_empty_basic_case
        given input = default_input()
        when result = is_empty(input)
        then result != undefined

    test deinit_basic_case
        given input = default_input()
        when result = deinit(input)
        then result != undefined

    test init_creates_empty_queue
        given pq = init(std.mem.global_allocator)
        then pq.size == 0
        and pq.data.len == 0

    test peek_returns_minimum_at_root
        given pq = init(std.mem.global_allocator)
        when enqueue(pq, 5)
        and enqueue(pq, 1)
        and enqueue(pq, 3)
        then peek(pq) == 1

    test parent_index_calculation
        given pq = init(std.mem.global_allocator)
        when enqueue(pq, 10)
        and enqueue(pq, 20)
        and enqueue(pq, 30)
        then for i in 1..2: (i - 1) / 2 == 0

    test children_of_root_index_0
        given pq = init(std.mem.global_allocator)
        when enqueue(pq, 10)
        and enqueue(pq, 20)
        and enqueue(pq, 30)
        then children of index 0 are 1 and 2

    test negative_priority_sorts_first
        given pq = init(std.mem.global_allocator)
        when enqueue(pq, 5)
        and enqueue(pq, -2)
        and enqueue(pq, 0)
        then peek(pq) == -2

    test heap_maintains_order_after_multiple_operations
        given pq = init(std.mem.global_allocator)
        when enqueue(pq, 3)
        and enqueue(pq, 1)
        and enqueue(pq, 4)
        and dequeue(pq)
        and enqueue(pq, 2)
        then peek(pq) == 2

