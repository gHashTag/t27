// t27/specs/
// Lists are immutable — operations return new lists | φ² + 1/φ² = 3 | TRINITY

module TriList;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const List(T) = struct {
        is_empty : bool,
        head : T,
        tail : "List(T)",
    };

    // Function type aliases for higher-order functions
    pub const MapFnInt = fn(int) int;
    pub const FilterFnInt = fn(int) bool;
    pub const FoldFnInt = fn(int, int) int;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // empty() → List(void)
    fn empty() -> List(void) {
        var empty_list: List(void);
        empty_list.is_empty = true;
        empty_list.head = undefined;
        empty_list.tail = undefined;
        return empty_list;
    }

    // cons(head: T, tail: List(T)) → List(T)
    fn cons(head: int, tail: List(int)) -> List(int) {
        return List(int) {
            is_empty: false,
            head: head,
            tail: tail,
        };
    }

    // head(list: List(T)) → T
    fn head(list: List(int)) -> int {
        if (list.is_empty) {
            // In a real implementation, this would panic or return an error
            return undefined;
        }
        return list.head;
    }

    // tail(list: List(T)) → List(T)
    fn tail(list: List(int)) -> List(int) {
        if (list.is_empty) {
            // In a real implementation, this would panic or return an error
            return empty();
        }
        return list.tail;
    }

    // map(list: List(int), f: MapFnInt) → List(int)
    fn map(list: List(int), f: MapFnInt) -> List(int) {
        if (list.is_empty) {
            return empty();
        }
        var mapped_head = f(list.head);
        var mapped_tail = map(list.tail, f);
        return cons(mapped_head, mapped_tail);
    }

    // filter(list: List(int), pred: FilterFnInt) → List(int)
    fn filter(list: List(int), pred: FilterFnInt) -> List(int) {
        if (list.is_empty) {
            return empty();
        }
        var tail_filtered = filter(list.tail, pred);
        if (pred(list.head)) {
            return cons(list.head, tail_filtered);
        } else {
            return tail_filtered;
        }
    }

    // fold(list: List(int), init: int, f: FoldFnInt) → int
    fn fold(list: List(int), init: int, f: FoldFnInt) -> int {
        if (list.is_empty) {
            return init;
        }
        var accumulator = fold(list.tail, init, f);
        return f(accumulator, list.head);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test empty_basic_case
        given input = default_input()
        when result = empty(input)
        then result != undefined

    test cons_basic_case
        given input = default_input()
        when result = cons(42, empty())
        then result != undefined

    test head_basic_case
        given input = default_input()
        when result = head(input)
        then result != undefined

    test tail_basic_case
        given input = default_input()
        when result = tail(input)
        then result != undefined

    test map_basic_case
        given input = default_input()
        when result = map(input, fn(x: int) -> int { return x; })
        then result != undefined

    test filter_basic_case
        given input = default_input()
        when result = filter(input, fn(x: int) -> bool { return true; })
        then result != undefined

    test fold_basic_case
        given input = default_input()
        when result = fold(input, 0, fn(acc: int, x: int) -> int { return acc; })
        then result != undefined