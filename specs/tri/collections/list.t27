// SPDX-License-Identifier: Apache-2.0
//
// Immutable value list of i64 elements with a fixed capacity of 8.
//
// The original spec used a generic cons cell with allocator-backed
// mutation. The reference compiler only accepts concrete struct types and
// value-based data flow, so the list is now a fixed-size array plus a
// live element count, and every operation returns a new value.
//
// TRINITY: 3-6-9 | 6-3-9 | 9-6-3
module TriList;

pub const List = struct {
    items : [8]i64 = [8]i64{ 0, 0, 0, 0, 0, 0, 0, 0 },
    size : i64 = 0,
};

pub fn empty() -> List {
    return List{};
}

// Prepend a value to the front of the list. Returns the list unchanged
// when it already holds 8 elements.
pub fn cons(list : List, value : i64) -> List {
    if (list.size >= 8) {
        return list;
    }
    var out : List = list;
    var carried : i64 = value;
    var live : i64 = 0;
    var i : usize = 0;
    while (i < 8) {
        if (live <= list.size) {
            const next_carried : i64 = out.items[i];
            out.items[i] = carried;
            carried = next_carried;
            live = live + 1;
        }
        i = i + 1;
    }
    out.size = list.size + 1;
    return out;
}

// Return the first element, or null when the list is empty.
pub fn head(list : List) -> ?i64 {
    if (list.size <= 0) {
        return null;
    }
    return list.items[0];
}

// Return the list without its first element.
pub fn tail(list : List) -> List {
    var out : List = list;
    var live : i64 = 0;
    var i : usize = 0;
    while (i < 8) {
        if (live < list.size) {
            if (i + 1 < 8) {
                out.items[i] = out.items[i + 1];
            }
        }
        live = live + 1;
        i = i + 1;
    }
    if (out.size > 0) {
        out.size = out.size - 1;
    }
    return out;
}

// Return a new list with every element doubled.
pub fn map(list : List) -> List {
    var out : List = list;
    var live : i64 = 0;
    var i : usize = 0;
    while (i < 8) {
        if (live < list.size) {
            out.items[i] = list.items[i] + list.items[i];
            live = live + 1;
        }
        i = i + 1;
    }
    return out;
}

// Return a new list keeping only the even elements, in order.
pub fn filter(list : List) -> List {
    var out : List = list;
    var kept : i64 = 0;
    var dst : usize = 0;
    var live : i64 = 0;
    var i : usize = 0;
    while (i < 8) {
        if (live < list.size) {
            const v : i64 = list.items[i];
            if (v / 2 * 2 == v) {
                out.items[dst] = v;
                dst = dst + 1;
                kept = kept + 1;
            }
            live = live + 1;
        }
        i = i + 1;
    }
    out.size = kept;
    return out;
}

// Sum every element of the list.
pub fn fold(list : List) -> i64 {
    var total : i64 = 0;
    var live : i64 = 0;
    var i : usize = 0;
    while (i < 8) {
        if (live < list.size) {
            total = total + list.items[i];
            live = live + 1;
        }
        i = i + 1;
    }
    return total;
}

test "empty list holds nothing" {
    const list = empty();
    assert(list.size == 0);
    assert(head(list) == null);
}

test "cons prepends to the front" {
    const one = cons(empty(), 10);
    assert(one.size == 1);
    assert(head(one).? == 10);
    const two = cons(one, 20);
    assert(two.size == 2);
    assert(head(two).? == 20);
    assert(tail(two).items[0] == 10);
}

test "cons beyond capacity returns the list unchanged" {
    var list = empty();
    list = cons(list, 1);
    list = cons(list, 2);
    list = cons(list, 3);
    list = cons(list, 4);
    list = cons(list, 5);
    list = cons(list, 6);
    list = cons(list, 7);
    list = cons(list, 8);
    const full = cons(list, 9);
    assert(full.size == 8);
    assert(head(full).? == 8);
}

test "head returns the first element" {
    var list = empty();
    list = cons(list, 10);
    list = cons(list, 20);
    assert(head(list).? == 20);
    assert(head(empty()) == null);
}

test "tail drops the first element" {
    var list = empty();
    list = cons(list, 10);
    list = cons(list, 20);
    list = cons(list, 30);
    const rest = tail(list);
    assert(rest.size == 2);
    assert(rest.items[0] == 20);
    assert(rest.items[1] == 10);
    const empty_tail = tail(empty());
    assert(empty_tail.size == 0);
}

test "map doubles every element" {
    var list = empty();
    list = cons(list, 1);
    list = cons(list, 2);
    list = cons(list, 3);
    const doubled = map(list);
    assert(doubled.size == 3);
    assert(doubled.items[0] == 6);
    assert(doubled.items[1] == 4);
    assert(doubled.items[2] == 2);
}

test "filter keeps only the even elements" {
    var list = empty();
    list = cons(list, 1);
    list = cons(list, 2);
    list = cons(list, 3);
    list = cons(list, 4);
    const evens = filter(list);
    // cons prepends, so cons 1,2,3,4 stores [4, 3, 2, 1]; filter keeps [4, 2].
    assert(evens.size == 2);
    assert(evens.items[0] == 4);
    assert(evens.items[1] == 2);
    const odds_only = filter(cons(empty(), 1));
    assert(odds_only.size == 0);
}

test "fold sums every element" {
    var list = empty();
    list = cons(list, 10);
    list = cons(list, 20);
    list = cons(list, 30);
    assert(fold(list) == 60);
    assert(fold(empty()) == 0);
}
