// SPDX-License-Identifier: Apache-2.0
//
// Least recently used cache mapping i64 keys to i64 values, capacity 3.
//
// The original spec used generic keys with named-tuple entries and
// builtin math helpers. The reference compiler only accepts concrete
// struct types and value-based data flow, so the cache is now two
// parallel arrays plus a live count. Live entries occupy slots 0 through
// size - 1, ordered from least to most recently used by put; get is a
// pure lookup and does not reorder. Every operation returns a new value.
//
// TRINITY: 3-6-9 | 6-3-9 | 9-6-3
module TriLruCache;

pub const LRUCache = struct {
    keys : [3]i64 = [3]i64{ 0, 0, 0 },
    values : [3]i64 = [3]i64{ 0, 0, 0 },
    size : i64 = 0,
};

pub fn init() -> LRUCache {
    return LRUCache{};
}

fn value_at(cache : LRUCache, key : i64) -> ?i64 {
    var idx : i64 = 0;
    var i : usize = 0;
    while (i < 3) {
        if (idx < cache.size) {
            if (cache.keys[i] == key) {
                return cache.values[i];
            }
            idx = idx + 1;
        }
        i = i + 1;
    }
    return null;
}

// Rebuild the cache with the key-value pair moved to the most recently
// used slot. Appends the pair when the key is absent; when the cache is
// full the least recently used entry (slot 0) is dropped to make room.
fn move_pair_to_back(cache : LRUCache, key : i64, value : i64) -> LRUCache {
    const present : bool = value_at(cache, key) != null;
    var skip_first : bool = false;
    if (present == false) {
        if (cache.size >= 3) {
            skip_first = true;
        }
    }
    var out_keys : [3]i64 = [3]i64{ 0, 0, 0 };
    var out_values : [3]i64 = [3]i64{ 0, 0, 0 };
    var dst : usize = 0;
    var live : i64 = 0;
    var i : usize = 0;
    while (i < 3) {
        if (live < cache.size) {
            const k : i64 = cache.keys[i];
            var keep : bool = true;
            if (present) {
                if (k == key) {
                    keep = false;
                }
            }
            if (skip_first) {
                if (live == 0) {
                    keep = false;
                }
            }
            if (keep) {
                out_keys[dst] = k;
                out_values[dst] = cache.values[i];
                dst = dst + 1;
            }
            live = live + 1;
        }
        i = i + 1;
    }
    if (present) {
        out_keys[dst] = key;
        out_values[dst] = value;
    } else {
        if (cache.size < 3) {
            out_keys[dst] = key;
            out_values[dst] = value;
        } else {
            out_keys[2] = key;
            out_values[2] = value;
        }
    }
    var out : LRUCache = cache;
    out.keys = out_keys;
    out.values = out_values;
    return out;
}

// Return the value for a present key, or null when absent.
pub fn get(cache : LRUCache, key : i64) -> ?i64 {
    return value_at(cache, key);
}

// Insert or update a key, refreshing it as most recently used. When the
// cache is full the least recently used key is evicted.
pub fn put(cache : LRUCache, key : i64, value : i64) -> LRUCache {
    const rebuilt : LRUCache = move_pair_to_back(cache, key, value);
    var out : LRUCache = rebuilt;
    const present : bool = value_at(cache, key) != null;
    if (present) {
        out.size = cache.size;
    } else {
        if (cache.size < 3) {
            out.size = cache.size + 1;
        } else {
            out.size = cache.size;
        }
    }
    return out;
}

test "init creates an empty cache" {
    const cache = init();
    assert(cache.size == 0);
    assert(get(cache, 1) == null);
}

test "get returns the value for an existing key" {
    var cache = init();
    cache = put(cache, 1, 100);
    cache = put(cache, 2, 200);
    assert(get(cache, 1).? == 100);
    assert(get(cache, 2).? == 200);
}

test "get returns null for a missing key" {
    var cache = init();
    cache = put(cache, 1, 100);
    assert(get(cache, 42) == null);
}

test "put updates an existing value in place" {
    var cache = init();
    cache = put(cache, 1, 100);
    cache = put(cache, 2, 200);
    cache = put(cache, 1, 111);
    assert(cache.size == 2);
    assert(cache.keys[0] == 2);
    assert(cache.keys[1] == 1);
    assert(cache.values[1] == 111);
    assert(get(cache, 1).? == 111);
}

test "put refreshes an updated key as most recently used" {
    var cache = init();
    cache = put(cache, 1, 100);
    cache = put(cache, 2, 200);
    cache = put(cache, 3, 300);
    cache = put(cache, 2, 222);
    assert(cache.keys[0] == 1);
    assert(cache.keys[1] == 3);
    assert(cache.keys[2] == 2);
    assert(cache.values[2] == 222);
}

test "put evicts the least recently used key when full" {
    var cache = init();
    cache = put(cache, 1, 100);
    cache = put(cache, 2, 200);
    cache = put(cache, 3, 300);
    cache = put(cache, 4, 400);
    assert(cache.size == 3);
    assert(cache.keys[0] == 2);
    assert(cache.keys[1] == 3);
    assert(cache.keys[2] == 4);
    assert(get(cache, 1) == null);
    assert(get(cache, 4).? == 400);
}
