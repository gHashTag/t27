// t27/specs/tri/collections/array.t27
// Array utilities: slices, views and copies | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_array.tri. The port did
// not compile (generic T never bound, `return undefined` placeholders,
// allocator.alloc, std.mem.eql in tests), nine tests read default_input()
// and asserted `result != undefined`, two asserted `element == undefined`,
// and concat_combines_two_arrays claimed 2 + 2 elements make len 6. The
// .tri: ArrayView(T) { ptr, len }, "Non-owning view into a slice";
// SliceRange { start, end, step }; slice(arr, start, end) "[start:end)";
// sliceFrom(arr, start); first, last, isEmpty, contains, indexOf -> ?usize;
// reverse(allocator, arr) "Create reversed copy"; concat(allocator, a, b);
// behaviours slice_bounds_check ("Panic if start > end or end > len"),
// const_slices (inputs never mutated), zero_copy_views. Here T is usize.
// A slice already is the non-owning (ptr, len) view, so ArrayView is not
// repeated. The panic becomes range_ok(arr, start, end), which callers
// check first (slicing out of range is NOT CHECKED inside slice). first
// and last write to out[0] and return false on an empty array instead of
// the .tri's bare T (the port returned undefined); out is a one-slot
// slice (#6358 item 4). index_of returns arr.len for "absent" (the ?usize).
// reverse and concat fill a caller buffer (the allocator) and return the
// written prefix; copy_fits says whether it is big enough. SliceRange.step
// is kept from the .tri but no function reads it (NOT CHECKED).
// Mutation-checked 2026-10-06: 15 mutants of every function fail a test.

module TriArray;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const SliceRange = struct {
        start : usize,
        end : usize,
        step : i64,
    };

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn range_ok(arr: []const usize, start: usize, end: usize) -> bool {
        return start <= end and end <= arr.len;
    }

    fn slice(arr: []const usize, start: usize, end: usize) -> []const usize {
        return arr[start..end];
    }

    fn slice_from(arr: []const usize, start: usize) -> []const usize {
        return arr[start..arr.len];
    }

    fn is_empty(arr: []const usize) -> bool {
        return arr.len == 0;
    }

    fn first(arr: []const usize, out: []usize) -> bool {
        if (is_empty(arr)) {
            return false;
        }
        out[0] = arr[0];
        return true;
    }

    fn last(arr: []const usize, out: []usize) -> bool {
        if (is_empty(arr)) {
            return false;
        }
        out[0] = arr[arr.len - 1];
        return true;
    }

    // first index of item, or arr.len if absent
    fn index_of(arr: []const usize, item: usize) -> usize {
        var i : usize = 0;
        while (i < arr.len) {
            if (arr[i] == item) {
                return i;
            }
            i = i + 1;
        }
        return arr.len;
    }

    fn contains(arr: []const usize, item: usize) -> bool {
        return index_of(arr, item) < arr.len;
    }

    fn copy_fits(dst: []const usize, n: usize) -> bool {
        return dst.len >= n;
    }

    fn reverse(dst: []usize, arr: []const usize) -> []usize {
        var i : usize = 0;
        while (i < arr.len) {
            dst[i] = arr[arr.len - 1 - i];
            i = i + 1;
        }
        return dst[0..arr.len];
    }

    fn concat(dst: []usize, a: []const usize, b: []const usize) -> []usize {
        var i : usize = 0;
        while (i < a.len) {
            dst[i] = a[i];
            i = i + 1;
        }
        var j : usize = 0;
        while (j < b.len) {
            dst[a.len + j] = b[j];
            j = j + 1;
        }
        return dst[0..a.len + b.len];
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // a slice as sum of value * (position + 1), plus 1000 * len
    fn code(s: []const usize) -> usize {
        var sum : usize = s.len * 1000;
        var i : usize = 0;
        while (i < s.len) {
            sum = sum + s[i] * (i + 1);
            i = i + 1;
        }
        return sum;
    }

    // [1..4) of 10, 20, 30, 40, 50 is 20, 30, 40; [3..) is 40, 50; the
    // bounds check refuses start > end and end > len
    fn slice_code() -> usize {
        const data = [_]usize{ 10, 20, 30, 40, 50 };
        const bounds = range_ok(&data, 1, 4) and range_ok(&data, 5, 5) and range_ok(&data, 0, 5)
            and !range_ok(&data, 3, 2) and !range_ok(&data, 4, 6);
        const empty = slice(&data, 2, 2).len == 0 and slice_from(&data, 5).len == 0;
        if (!bounds or !empty) {
            return 0;
        }
        return code(slice(&data, 1, 4)) * 10000 + code(slice_from(&data, 3));
    }

    // first and last read the ends; on an empty array they return false
    // and leave out alone; is_empty
    fn ends_ok() -> bool {
        const data = [_]usize{ 7, 8, 9 };
        var none : [1]usize = [0];
        var out : [1]usize = [0];
        const f = first(&data, &out) and out[0] == 7;
        const l = last(&data, &out) and out[0] == 9;
        out[0] = 5;
        const ef = !first(none[0..0], &out) and out[0] == 5;
        const el = !last(none[0..0], &out) and out[0] == 5;
        const one = [_]usize{ 4 };
        const single = first(&one, &out) and out[0] == 4 and last(&one, &out) and out[0] == 4;
        return f and l and ef and el and single and is_empty(none[0..0]) and !is_empty(&one);
    }

    // index_of finds the first match; absent is len; contains agrees
    fn search_code() -> usize {
        const data = [_]usize{ 1, 3, 5, 3, 9 };
        var none : [1]usize = [0];
        const found = contains(&data, 9) and contains(&data, 1) and !contains(&data, 4)
            and !contains(none[0..0], 0);
        if (!found) {
            return 0;
        }
        return index_of(&data, 3) * 100 + index_of(&data, 9) * 10 + index_of(&data, 4);
    }

    // reverse and concat fill the caller buffer and return the written
    // prefix; inputs are unchanged
    fn copy_code() -> usize {
        const a = [_]usize{ 1, 2 };
        const b = [_]usize{ 3, 4, 5 };
        var buf : [6]usize = [99] ** 6;
        const r = reverse(&buf, &b);
        const rc = code(r);
        const tail = buf[3] == 99;
        const c = concat(&buf, &a, &b);
        var none : [1]usize = [0];
        const ec = concat(&buf, none[0..0], none[0..0]).len == 0 and reverse(&buf, none[0..0]).len == 0;
        const fits = copy_fits(&buf, 6) and !copy_fits(&buf, 7);
        if (!tail or !ec or !fits or buf[5] != 99 or b[0] != 3) {
            return 0;
        }
        return rc * 100000 + code(c);
    }

    test slice_and_slice_from_with_bounds
        given result = slice_code()
        when expected = (3000 + 20 + 60 + 120) * 10000 + (2000 + 40 + 100)
        then result == expected

    test first_last_and_empty
        given result = ends_ok()
        when expected = true
        then result == expected

    test index_of_finds_the_first_match
        given result = search_code()
        when expected = 1 * 100 + 4 * 10 + 5
        then result == expected

    test reverse_and_concat_copy
        given result = copy_code()
        when expected = (3000 + 5 + 8 + 9) * 100000 + (5000 + 1 + 4 + 9 + 16 + 25)
        then result == expected
