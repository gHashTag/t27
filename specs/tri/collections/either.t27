// t27/specs/tri/collections/either.t27
// Either: one of two values | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_either.tri. The port did
// not compile (generic L and R never bound, `undefined` payloads compared
// with ==, string-named test blocks with assert) and unwrap of a Left
// returned undefined. The .tri: Either(L, R) { is_left, left, right },
// "One of Left or Right value"; left(value) and right(value) create the
// variants; isLeft and isRight check the tag; unwrap "Get value (merged
// type)" returns ?T; behaviour type_safe_sum: "Left and Right cannot both
// be active". Here L and R are usize, so the merged type is usize and
// unwrap returns the active payload. NOT CHECKED: the .tri's unwrap also
// lists default_left and default_right parameters, in entries with
// unbalanced quotes and no stated use; they are left out, and so is the
// `?` (both variants always hold a value). The inactive payload is 0, not
// undefined, so an Either compares and prints deterministically; that 0
// is never read by unwrap. Exactly one of is_left and is_right holds for
// every Either, by construction from the one tag. Mutation-checked
// 2026-10-06: 8 mutants of every function fail a test.

module TriEither;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const Either = struct {
        is_left : bool,
        left : usize,
        right : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn left(value: usize) -> Either {
        return Either{ .is_left = true, .left = value, .right = 0 };
    }

    fn right(value: usize) -> Either {
        return Either{ .is_left = false, .left = 0, .right = value };
    }

    fn is_left(e: Either) -> bool {
        return e.is_left;
    }

    fn is_right(e: Either) -> bool {
        return !e.is_left;
    }

    // the active payload: left for a Left, right for a Right
    fn unwrap(e: Either) -> usize {
        if (e.is_left) {
            return e.left;
        }
        return e.right;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // tag, payloads and unwrap of e in one number:
    // tag * 1000000 + left * 10000 + right * 100 + unwrap
    fn code(e: Either) -> usize {
        var tag : usize = 0;
        if (is_left(e)) {
            tag = tag + 1;
        }
        if (is_right(e)) {
            tag = tag + 2;
        }
        return tag * 1000000 + e.left * 10000 + e.right * 100 + unwrap(e);
    }

    test left_holds_the_left_value
        given result = code(left(7))
        when expected = 1 * 1000000 + 7 * 10000 + 0 * 100 + 7
        then result == expected

    test right_holds_the_right_value
        given result = code(right(9))
        when expected = 2 * 1000000 + 0 * 10000 + 9 * 100 + 9
        then result == expected

    // a zero payload is still a value: left(0) and right(0) differ by tag
    test zero_payloads_keep_their_side
        given result = code(left(0)) * 10 + code(right(0)) / 1000000
        when expected = 1 * 1000000 * 10 + 2
        then result == expected
