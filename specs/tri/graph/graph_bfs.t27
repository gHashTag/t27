// t27/specs/tri/graph/graph_bfs.t27
// Breadth-First Search for graph traversal | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_graph_bfs.tri. The port
// was Zig, not t27 (allocator.alloc, @memcpy, @constCast, std.ArrayList,
// `for |i|`, a quoted allocator field), it did not compile (lab-exec
// 2026-10-06: CODEGEN, duplicate struct member 'std'), its add_edge wrote
// both directions where the .tri says "Add directed edge", and four tests
// read default_input() and asserted `result != undefined`. The .tri:
// Graph { adj: [][]usize, allocator }; init(vertex_count); addEdge(graph,
// from, to) adds a directed edge; traverse(graph, start) -> BFSResult
// { order, distance }; deinit frees. Here the allocator is replaced by
// caller buffers, so deinit has nothing to free and is gone: the caller
// owns one row per vertex (its length is that vertex's out-edge capacity)
// and a degree slot per vertex; add_edge returns false and adds nothing
// when the row is full. traverse uses its order buffer as the queue
// (BFS visits vertices in queue order) and returns order[0 .. reached];
// a vertex start cannot reach has distance UNREACHED. Neighbours are
// visited in the order their edges were added.

module TriGraphBfs;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const Graph = struct {
        adj : [][]usize,
        degree : []usize,
    };

    pub const BFSResult = struct {
        order : []usize,
        distance : []usize,
    };

    pub const UNREACHED : usize = 18446744073709551615;

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn init(rows: [][]usize, degree: []usize) -> Graph {
        var v : usize = 0;
        while (v < degree.len) {
            degree[v] = 0;
            v = v + 1;
        }
        return Graph{ .adj = rows, .degree = degree };
    }

    fn vertex_count(graph: Graph) -> usize {
        return graph.adj.len;
    }

    fn buffers_ok(graph: Graph, start: usize, order: []const usize, distance: []const usize) -> bool {
        const n = graph.adj.len;
        return graph.degree.len == n and start < n and order.len == n and distance.len == n;
    }

    // directed edge from -> to; false (nothing added) if from's row is full
    fn add_edge(graph: *Graph, from: usize, to: usize) -> bool {
        const k = graph.degree[from];
        if (k >= graph.adj[from].len) {
            return false;
        }
        graph.adj[from][k] = to;
        graph.degree[from] = k + 1;
        return true;
    }

    fn traverse(graph: Graph, start: usize, order: []usize, distance: []usize) -> BFSResult {
        var v : usize = 0;
        while (v < distance.len) {
            distance[v] = UNREACHED;
            v = v + 1;
        }
        distance[start] = 0;
        order[0] = start;
        var head : usize = 0;
        var tail : usize = 1;
        while (head < tail) {
            const u = order[head];
            head = head + 1;
            var i : usize = 0;
            while (i < graph.degree[u]) {
                const w = graph.adj[u][i];
                if (distance[w] == UNREACHED) {
                    distance[w] = distance[u] + 1;
                    order[tail] = w;
                    tail = tail + 1;
                }
                i = i + 1;
            }
        }
        return BFSResult{ .order = order[0..tail], .distance = distance };
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // coded sum of x[k] * (k + 1): one number that pins every slot
    fn code(values: []const usize) -> usize {
        var sum : usize = 0;
        var k : usize = 0;
        while (k < values.len) {
            sum = sum + values[k] * (k + 1);
            k = k + 1;
        }
        return sum;
    }

    // 0 -> 1, 0 -> 2, 1 -> 3: 3 is reached only through 1, which is
    // dequeued before 2 (first in, first out): order (0, 1, 2, 3), code 20
    fn fifo_ok() -> bool {
        var r0 : [2]usize = [9] ** 2;
        var r1 : [1]usize = [9];
        var r2 : [0]usize = [];
        var r3 : [0]usize = [];
        var rows : [4][]usize = [&r0, &r1, &r2, &r3];
        var deg : [4]usize = [9] ** 4;
        var g = init(&rows, &deg);
        const added = add_edge(&g, 0, 1) and add_edge(&g, 0, 2) and add_edge(&g, 1, 3);
        var order : [4]usize = [99] ** 4;
        var dist : [4]usize = [99] ** 4;
        const r = traverse(g, 0, &order, &dist);
        return added and r.order.len == 4 and code(r.order) == 20 and dist[3] == 2;
    }

    // 0 -> 1, 0 -> 2, 1 -> 3, 2 -> 3, 3 -> 4; vertex 5 isolated.
    // From 0: order (0, 1, 2, 3, 4), code 40; distances (0, 1, 1, 2, 3),
    // code 28; 5 unreached
    fn diamond_from_zero() -> usize {
        var r0 : [2]usize = [9] ** 2;
        var r1 : [1]usize = [9];
        var r2 : [1]usize = [9];
        var r3 : [1]usize = [9];
        var r4 : [0]usize = [];
        var r5 : [0]usize = [];
        var rows : [6][]usize = [&r0, &r1, &r2, &r3, &r4, &r5];
        var deg : [6]usize = [9] ** 6;
        var g = init(&rows, &deg);
        const added = add_edge(&g, 0, 1) and add_edge(&g, 0, 2) and add_edge(&g, 1, 3)
            and add_edge(&g, 2, 3) and add_edge(&g, 3, 4);
        var order : [6]usize = [99] ** 6;
        var dist : [6]usize = [99] ** 6;
        if (!added or !buffers_ok(g, 0, &order, &dist)) {
            return 0;
        }
        const r = traverse(g, 0, &order, &dist);
        if (r.order.len != 5 or dist[5] != UNREACHED) {
            return 1;
        }
        return code(r.order) * 1000 + code(r.distance[0..5]);
    }

    // edges are directed: from 3 only 4 is reachable
    fn directed_from_three() -> bool {
        var r0 : [2]usize = [9] ** 2;
        var r1 : [1]usize = [9];
        var r2 : [1]usize = [9];
        var r3 : [1]usize = [9];
        var r4 : [0]usize = [];
        var rows : [5][]usize = [&r0, &r1, &r2, &r3, &r4];
        var deg : [5]usize = [9] ** 5;
        var g = init(&rows, &deg);
        const added = add_edge(&g, 0, 1) and add_edge(&g, 0, 2) and add_edge(&g, 1, 3)
            and add_edge(&g, 2, 3) and add_edge(&g, 3, 4);
        var order : [5]usize = [99] ** 5;
        var dist : [5]usize = [99] ** 5;
        const r = traverse(g, 3, &order, &dist);
        return added and r.order.len == 2 and order[0] == 3 and order[1] == 4
            and dist[3] == 0 and dist[4] == 1 and dist[0] == UNREACHED
            and dist[1] == UNREACHED and dist[2] == UNREACHED;
    }

    // 0 -> 1, 1 -> 2, 0 -> 2: 2 is one step away, not two
    fn shortcut_ok() -> bool {
        var r0 : [2]usize = [9] ** 2;
        var r1 : [1]usize = [9];
        var r2 : [0]usize = [];
        var rows : [3][]usize = [&r0, &r1, &r2];
        var deg : [3]usize = [9] ** 3;
        var g = init(&rows, &deg);
        const added = add_edge(&g, 0, 1) and add_edge(&g, 1, 2) and add_edge(&g, 0, 2);
        var order : [3]usize = [99] ** 3;
        var dist : [3]usize = [99] ** 3;
        const r = traverse(g, 0, &order, &dist);
        return added and r.order.len == 3 and code(r.order) == 8 and dist[1] == 1 and dist[2] == 1;
    }

    // 0 -> 1, 1 -> 0, 1 -> 2: the cycle back to 0 is not visited twice
    fn cycle_ok() -> bool {
        var r0 : [1]usize = [9];
        var r1 : [2]usize = [9] ** 2;
        var r2 : [0]usize = [];
        var rows : [3][]usize = [&r0, &r1, &r2];
        var deg : [3]usize = [9] ** 3;
        var g = init(&rows, &deg);
        const added = add_edge(&g, 0, 1) and add_edge(&g, 1, 0) and add_edge(&g, 1, 2);
        var order : [3]usize = [99] ** 3;
        var dist : [3]usize = [99] ** 3;
        const r = traverse(g, 0, &order, &dist);
        return added and r.order.len == 3 and code(r.order) == 8 and dist[0] == 0 and dist[2] == 2;
    }

    // init clears degrees; a full row refuses an edge; buffer checks
    fn edges_ok() -> bool {
        var r0 : [1]usize = [9];
        var r1 : [0]usize = [];
        var rows : [2][]usize = [&r0, &r1];
        var deg : [2]usize = [9] ** 2;
        var g = init(&rows, &deg);
        const cleared = deg[0] == 0 and deg[1] == 0 and vertex_count(g) == 2;
        const first = add_edge(&g, 0, 1);
        const full = !add_edge(&g, 0, 0) and deg[0] == 1 and r0[0] == 1;
        const none = !add_edge(&g, 1, 0) and deg[1] == 0;
        var o2 : [2]usize = [0] ** 2;
        var d2 : [2]usize = [0] ** 2;
        var o1 : [1]usize = [0];
        const sized = buffers_ok(g, 1, &o2, &d2) and !buffers_ok(g, 2, &o2, &d2)
            and !buffers_ok(g, 0, &o1, &d2) and !buffers_ok(g, 0, &o2, &o1);
        return cleared and first and full and none and sized;
    }

    test bfs_order_and_distances
        given result = diamond_from_zero()
        when expected = 40 * 1000 + 28
        then result == expected

    test bfs_dequeues_first_in_first_out
        given result = fifo_ok()
        when expected = true
        then result == expected

    test edges_are_directed
        given result = directed_from_three()
        when expected = true
        then result == expected

    test bfs_finds_the_shorter_path
        given result = shortcut_ok()
        when expected = true
        then result == expected

    test bfs_visits_each_vertex_once
        given result = cycle_ok()
        when expected = true
        then result == expected

    test graph_buffer_edges
        given result = edges_ok()
        when expected = true
        then result == expected
