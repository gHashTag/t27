// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Find shortest paths, detect negative cycles | φ² + 1/φ² = 3 | TRINITY

module TriBellmanFord;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Edge = struct {
        from : "usize",
        to : "usize",
        weight : "i64",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // shortest_path(edges: []const Edge) -> i64: distance from vertex 0 to the
    // highest-numbered vertex, NEG_CYCLE if a negative cycle is reachable.
    // Was `-> void` with a test claiming `result != undefined` on an
    // undefined input: nothing observable, and the run crashed (lab-exec
    // 2026-10-05, General protection exception).
    pub const NEG_CYCLE: i64 = -9223372036854775807;

    fn shortest_path(edges: []const Edge) -> i64 {
        // Bellman-Ford: find shortest paths from vertex 0, detect negative cycles
        // Determine number of vertices from edges
        var max_vertex: usize = 0;
        for (edges) |edge| {
            if (edge.from > max_vertex) max_vertex = edge.from;
            if (edge.to > max_vertex) max_vertex = edge.to;
        }
        const V = max_vertex + 1;
        
        // Initialize distances
        var dist: [100]i64 = undefined;
        var i: usize = 0;
        while (i < V) {
            dist[i] = if (i == 0) 0 else 9223372036854775807; // i64 max as infinity
            i += 1;
        }
        
        // Relax edges V-1 times
        var iter: usize = 0;
        while (iter < V - 1) {
            var updated: bool = false;
            for (edges) |edge| {
                if (dist[edge.from] != 9223372036854775807) {
                    const new_dist = dist[edge.from] + edge.weight;
                    if (new_dist < dist[edge.to]) {
                        dist[edge.to] = new_dist;
                        updated = true;
                    }
                }
            }
            if (!updated) break;
            iter += 1;
        }
        
        // Check for negative cycles
        for (edges) |edge| {
            if (dist[edge.from] != 9223372036854775807) {
                const new_dist = dist[edge.from] + edge.weight;
                if (new_dist < dist[edge.to]) {
                    return NEG_CYCLE;
                }
            }
        }
        return dist[max_vertex];
    }

    // 0 -> 1 (4), 0 -> 2 (1), 2 -> 1 (2), 1 -> 3 (1): best 0-2-1-3 = 4.
    fn sample_edges() -> [4]Edge {
        var e: [4]Edge = undefined;
        e[0] = Edge{ from: 0, to: 1, weight: 4 };
        e[1] = Edge{ from: 0, to: 2, weight: 1 };
        e[2] = Edge{ from: 2, to: 1, weight: 2 };
        e[3] = Edge{ from: 1, to: 3, weight: 1 };
        return e;
    }

    // 0 -> 1 (1), 1 -> 2 (-1), 2 -> 1 (-1): the 1-2 loop sums to -2.
    fn cycle_edges() -> [3]Edge {
        var e: [3]Edge = undefined;
        e[0] = Edge{ from: 0, to: 1, weight: 1 };
        e[1] = Edge{ from: 1, to: 2, weight: -1 };
        e[2] = Edge{ from: 2, to: 1, weight: -1 };
        return e;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // original: given input = default_input(); then result != undefined
    test shortest_path_basic_case
        given e = sample_edges()
        when result = shortest_path(&e)
        then result == 4

    test shortest_path_negative_cycle
        given e = cycle_edges()
        when result = shortest_path(&e)
        then result == NEG_CYCLE

