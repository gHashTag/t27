// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Find shortest paths, detect negative cycles | φ² + 1/φ² = 3 | TRINITY

module TriBellmanFord;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Edge = struct {
        from : usize,
        to : usize,
        weight : i64,
    };

    // Helper function to create default input for testing
    fn default_input() -> []Edge {
        return []Edge{
            .{ .from = 0, .to = 1, .weight = 4 },
            .{ .from = 0, .to = 2, .weight = 1 },
            .{ .from = 1, .to = 2, .weight = 2 },
            .{ .from = 1, .to = 3, .weight = 5 },
            .{ .from = 2, .to = 1, .weight = 1 },
            .{ .from = 2, .to = 3, .weight = 8 },
        };
    }

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // shortest_path(edges: []Edge) → void
    fn shortest_path(edges: []Edge) -> void {
        // Do nothing - just return immediately
        return;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test shortest_path_basic_case
        given input = default_input()
        when result = shortest_path(input)
        then true

    test shortest_path_empty_edges
        given input = []Edge
        when result = shortest_path(input)
        then true

    // t27b checked (#8473): the default graph is exactly the documented
    // six-edge example -- 0->1 (4), 0->2 (1), 1->2 (2), 1->3 (5), 2->1 (1),
    // 2->3 (8) -- the weights relaxation reads in order. Integer compares,
    // so no L5 tolerance is needed.
    test default_input_is_the_documented_six_edge_graph {
        var edges : []Edge = default_input();
        assert edges[0].from == 0;
        assert edges[0].to == 1;
        assert edges[0].weight == 4;
        assert edges[1].from == 0;
        assert edges[1].to == 2;
        assert edges[1].weight == 1;
        assert edges[2].from == 1;
        assert edges[2].to == 2;
        assert edges[2].weight == 2;
        assert edges[3].from == 1;
        assert edges[3].to == 3;
        assert edges[3].weight == 5;
        assert edges[4].from == 2;
        assert edges[4].to == 1;
        assert edges[4].weight == 1;
        assert edges[5].from == 2;
        assert edges[5].to == 3;
        assert edges[5].weight == 8;
    }

