// t27/specs/tri/graph/disjoint_set.t27
// Attach shorter tree under taller tree root | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 against trinity specs/tri/tri_disjoint_set.tri. The
// find/union/connected bodies already matched the .tri (path compression,
// union by rank); what was wrong: DisjointSet.count had the quoted type
// "usize", init(size) handed out slices of a module-level [1000]usize
// buffer (a second init aliased the first), four tests read
// default_input(), defined nowhere, and the rest used Zig-only forms
// (@constCast, `and union(...)` steps). The .tri init(size) -> DisjointSet
// has no allocator parameter; here the backing memory is the caller's:
// init(parent, rank) takes two buffers of the same length. The vacuous
// tests are replaced by coded-sum checks of parent and rank.

module TriDisjointSet;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const DisjointSet = struct {
        parent : []usize,
        rank : []usize,
        count : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn buffers_ok(parent: []const usize, rank: []const usize) -> bool {
        return parent.len == rank.len;
    }

    // the singleton forest: parent[i] == i, rank[i] == 0, count == size
    fn init(parent: []usize, rank: []usize) -> DisjointSet {
        var i : usize = 0;
        while (i < parent.len) {
            parent[i] = i;
            rank[i] = 0;
            i = i + 1;
        }
        return DisjointSet{ .parent = parent, .rank = rank, .count = parent.len };
    }

    // find(ds: *DisjointSet, x: usize) → usize
    fn find(ds: *DisjointSet, x: usize) -> usize {
        // Return the root of x with path compression
        var root : usize = x;
        while (ds.parent[root] != root) {
            root = ds.parent[root];
        }
        
        // Path compression: make every node on the path point to root
        var current : usize = x;
        while (ds.parent[current] != root) {
            const next = ds.parent[current];
            ds.parent[current] = root;
            current = next;
        }
        
        return root;
    }

    // union(ds: *DisjointSet, x: usize, y: usize) → void
    fn union(ds: *DisjointSet, x: usize, y: usize) -> void {
        // Find roots of both elements
        const root_x = find(ds, x);
        const root_y = find(ds, y);
        
        // If already in the same component, do nothing
        if (root_x == root_y) {
            return;
        }
        
        // Attach shorter tree under taller tree root
        if (ds.rank[root_x] < ds.rank[root_y]) {
            ds.parent[root_x] = root_y;
        } else if (ds.rank[root_x] > ds.rank[root_y]) {
            ds.parent[root_y] = root_x;
        } else {
            // Same rank: attach one to the other and increment the surviving rank
            ds.parent[root_y] = root_x;
            ds.rank[root_x] = ds.rank[root_x] + 1;
        }
        
        // Decrement count by exactly 1 on a real merge
        ds.count = ds.count - 1;
    }

    // connected(ds: *const DisjointSet, x: usize, y: usize) → bool
    fn connected(ds: *const DisjointSet, x: usize, y: usize) -> bool {
        // Return true when x and y share a root (read-only)
        var root_x : usize = x;
        while (ds.parent[root_x] != root_x) {
            root_x = ds.parent[root_x];
        }
        
        var root_y : usize = y;
        while (ds.parent[root_y] != root_y) {
            root_y = ds.parent[root_y];
        }
        
        return root_x == root_y;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // coded sum of x[k] * (k + 1): one number that pins every slot
    fn code(values: []const usize) -> usize {
        var sum : usize = 0;
        var k : usize = 0;
        while (k < values.len) {
            sum = sum + values[k] * (k + 1);
            k = k + 1;
        }
        return sum;
    }

    // init over dirty buffers: parent (0, 1, 2, 3) -> 20, rank all 0, count 4
    fn init_code() -> usize {
        var parent : [4]usize = [9] ** 4;
        var rank : [4]usize = [9] ** 4;
        const ds = init(&parent, &rank);
        return code(&parent) * 1000 + code(&rank) * 10 + ds.count;
    }

    // unions (0,1) (2,3) (1,3) (4,5) (5,4) over 6:
    // parent (0, 0, 0, 2, 4, 4) -> 52, rank (2, 0, 1, 0, 1, 0) -> 10, count 2
    fn unions_code() -> usize {
        var parent : [6]usize = [0] ** 6;
        var rank : [6]usize = [0] ** 6;
        var ds = init(&parent, &rank);
        union(&ds, 0, 1);
        union(&ds, 2, 3);
        union(&ds, 1, 3);
        union(&ds, 4, 5);
        union(&ds, 5, 4);
        return code(&parent) * 10000 + code(&rank) * 10 + ds.count;
    }

    // find(3) after unions_code compresses 3 -> 2 -> 0 to 3 -> 0:
    // parent (0, 0, 0, 0, 4, 4) -> 44
    fn compress_code() -> usize {
        var parent : [6]usize = [0] ** 6;
        var rank : [6]usize = [0] ** 6;
        var ds = init(&parent, &rank);
        union(&ds, 0, 1);
        union(&ds, 2, 3);
        union(&ds, 1, 3);
        union(&ds, 4, 5);
        const root = find(&ds, 3);
        return root * 1000 + code(&parent);
    }

    // a hand-built chain 0 <- 1 <- 2 <- 3: connected() answers but writes nothing
    fn connected_ok() -> bool {
        var parent : [5]usize = [0, 0, 1, 2, 4];
        var rank : [5]usize = [3, 0, 0, 0, 0];
        const ds = DisjointSet{ .parent = &parent, .rank = &rank, .count = 2 };
        const joined = connected(&ds, 3, 0) and connected(&ds, 1, 2);
        const apart = !connected(&ds, 4, 3) and !connected(&ds, 0, 4);
        const untouched = code(&parent) == 0 + 0 + 3 + 8 + 20;
        return joined and apart and untouched and buffers_ok(&parent, &rank);
    }

    test init_creates_singleton_forest
        given result = init_code()
        when expected = 20 * 1000 + 0 * 10 + 4
        then result == expected

    test union_by_rank_and_count
        given result = unions_code()
        when expected = 52 * 10000 + 10 * 10 + 2
        then result == expected

    test find_compresses_the_path
        given result = compress_code()
        when expected = 0 * 1000 + 44
        then result == expected

    test connected_is_read_only
        given result = connected_ok()
        when expected = true
        then result == expected
