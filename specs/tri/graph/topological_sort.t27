// t27/specs/tri/graph/topological_sort.t27
// Kahn's algorithm for topological sorting | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_topological.tri. The port
// did not compile (lab-exec 2026-10-06: undeclared Graph and graph), was
// not t27 (`let`, `for i in`, push/shift, `-=`), sort and is_valid
// returned void, and both tests read default_input(). The .tri:
// TopologicalSort { order: []usize, has_cycle: bool }; sort(graph: *const
// Graph, allocator) -> !TopologicalSort by Kahn's algorithm; is_valid(
// result, graph) -> bool verifies the ordering respects edges; behaviours:
// DAGs only, and an edge u -> v puts u before v. The .tri names Graph but
// does not define it; the only .tri that does is tri_graph_bfs.tri
// (adjacency lists), so Graph here is that one, as restored in
// graph_bfs.t27. The allocator becomes caller buffers: order (vertex
// count slots, also Kahn's FIFO queue) and indegree. Vertices of in-degree
// 0 enter the queue by index, so the order is deterministic. On a cycle
// has_cycle is true and order holds only the vertices that were sorted.
// is_valid holds when order is a permutation of every vertex and every
// edge goes forward in it; it is false for a cyclic result.

module TriTopological;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const Graph = struct {
        adj : [][]usize,
        degree : []usize,
    };

    pub const TopologicalSort = struct {
        order : []usize,
        has_cycle : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn init(rows: [][]usize, degree: []usize) -> Graph {
        var v : usize = 0;
        while (v < degree.len) {
            degree[v] = 0;
            v = v + 1;
        }
        return Graph{ .adj = rows, .degree = degree };
    }

    // directed edge from -> to; false (nothing added) if from's row is full
    fn add_edge(graph: *Graph, from: usize, to: usize) -> bool {
        const k = graph.degree[from];
        if (k >= graph.adj[from].len) {
            return false;
        }
        graph.adj[from][k] = to;
        graph.degree[from] = k + 1;
        return true;
    }

    fn buffers_ok(graph: Graph, order: []const usize, indegree: []const usize) -> bool {
        const n = graph.adj.len;
        return graph.degree.len == n and order.len == n and indegree.len == n;
    }

    fn sort(graph: Graph, order: []usize, indegree: []usize) -> TopologicalSort {
        const n = graph.adj.len;
        var v : usize = 0;
        while (v < n) {
            indegree[v] = 0;
            v = v + 1;
        }
        v = 0;
        while (v < n) {
            var i : usize = 0;
            while (i < graph.degree[v]) {
                indegree[graph.adj[v][i]] = indegree[graph.adj[v][i]] + 1;
                i = i + 1;
            }
            v = v + 1;
        }
        var tail : usize = 0;
        v = 0;
        while (v < n) {
            if (indegree[v] == 0) {
                order[tail] = v;
                tail = tail + 1;
            }
            v = v + 1;
        }
        var head : usize = 0;
        while (head < tail) {
            const u = order[head];
            head = head + 1;
            var i : usize = 0;
            while (i < graph.degree[u]) {
                const w = graph.adj[u][i];
                indegree[w] = indegree[w] - 1;
                if (indegree[w] == 0) {
                    order[tail] = w;
                    tail = tail + 1;
                }
                i = i + 1;
            }
        }
        return TopologicalSort{ .order = order[0..tail], .has_cycle = tail != n };
    }

    // index of v in order, or order.len if absent
    fn position(order: []const usize, v: usize) -> usize {
        var i : usize = 0;
        while (i < order.len) {
            if (order[i] == v) {
                return i;
            }
            i = i + 1;
        }
        return order.len;
    }

    fn is_valid(result: TopologicalSort, graph: Graph) -> bool {
        const n = graph.adj.len;
        if (result.has_cycle or result.order.len != n) {
            return false;
        }
        var v : usize = 0;
        while (v < n) {
            const pv = position(result.order, v);
            if (pv == n) {
                return false;
            }
            var i : usize = 0;
            while (i < graph.degree[v]) {
                if (position(result.order, graph.adj[v][i]) <= pv) {
                    return false;
                }
                i = i + 1;
            }
            v = v + 1;
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // coded sum of x[k] * (k + 1): one number that pins every slot
    fn code(values: []const usize) -> usize {
        var sum : usize = 0;
        var k : usize = 0;
        while (k < values.len) {
            sum = sum + values[k] * (k + 1);
            k = k + 1;
        }
        return sum;
    }

    // 5 -> 2, 5 -> 0, 4 -> 0, 4 -> 1, 2 -> 3, 3 -> 1:
    // order (4, 5, 2, 0, 3, 1), code 41, no cycle, valid
    fn dag_code() -> usize {
        var r0 : [0]usize = [];
        var r1 : [0]usize = [];
        var r2 : [1]usize = [9];
        var r3 : [1]usize = [9];
        var r4 : [2]usize = [9] ** 2;
        var r5 : [2]usize = [9] ** 2;
        var rows : [6][]usize = [&r0, &r1, &r2, &r3, &r4, &r5];
        var deg : [6]usize = [9] ** 6;
        var g = init(&rows, &deg);
        const added = add_edge(&g, 5, 2) and add_edge(&g, 5, 0) and add_edge(&g, 4, 0)
            and add_edge(&g, 4, 1) and add_edge(&g, 2, 3) and add_edge(&g, 3, 1);
        var order : [6]usize = [99] ** 6;
        var indeg : [6]usize = [99] ** 6;
        if (!added or !buffers_ok(g, &order, &indeg)) {
            return 0;
        }
        const r = sort(g, &order, &indeg);
        if (r.has_cycle or !is_valid(r, g)) {
            return 1;
        }
        return r.order.len * 1000 + code(r.order);
    }

    // 0 -> 1, 1 -> 2, 2 -> 1: only 0 is sorted, has_cycle, not valid
    fn cycle_ok() -> bool {
        var r0 : [1]usize = [9];
        var r1 : [1]usize = [9];
        var r2 : [1]usize = [9];
        var rows : [3][]usize = [&r0, &r1, &r2];
        var deg : [3]usize = [9] ** 3;
        var g = init(&rows, &deg);
        const added = add_edge(&g, 0, 1) and add_edge(&g, 1, 2) and add_edge(&g, 2, 1);
        var order : [3]usize = [99] ** 3;
        var indeg : [3]usize = [99] ** 3;
        const r = sort(g, &order, &indeg);
        return added and r.has_cycle and r.order.len == 1 and order[0] == 0 and !is_valid(r, g);
    }

    // is_valid on hand-made orders of the dag above
    fn validity_ok() -> bool {
        var r0 : [0]usize = [];
        var r1 : [0]usize = [];
        var r2 : [1]usize = [9];
        var r3 : [1]usize = [9];
        var r4 : [2]usize = [9] ** 2;
        var r5 : [2]usize = [9] ** 2;
        var rows : [6][]usize = [&r0, &r1, &r2, &r3, &r4, &r5];
        var deg : [6]usize = [9] ** 6;
        var g = init(&rows, &deg);
        const added = add_edge(&g, 5, 2) and add_edge(&g, 5, 0) and add_edge(&g, 4, 0)
            and add_edge(&g, 4, 1) and add_edge(&g, 2, 3) and add_edge(&g, 3, 1);
        var other : [6]usize = [5, 4, 2, 3, 1, 0];
        var swapped : [6]usize = [4, 5, 3, 2, 0, 1];
        var repeated : [6]usize = [4, 5, 2, 0, 3, 3];
        var short : [5]usize = [4, 5, 2, 0, 3];
        const yes = is_valid(TopologicalSort{ .order = &other, .has_cycle = false }, g);
        const back = !is_valid(TopologicalSort{ .order = &swapped, .has_cycle = false }, g);
        const dup = !is_valid(TopologicalSort{ .order = &repeated, .has_cycle = false }, g);
        const missing = !is_valid(TopologicalSort{ .order = &short, .has_cycle = false }, g);
        const flagged = !is_valid(TopologicalSort{ .order = &other, .has_cycle = true }, g);
        return added and yes and back and dup and missing and flagged;
    }

    // a self-loop 0 -> 0 is a cycle; an order that hides it is not valid
    fn self_loop_ok() -> bool {
        var r0 : [1]usize = [9];
        var rows : [1][]usize = [&r0];
        var deg : [1]usize = [9];
        var g = init(&rows, &deg);
        const added = add_edge(&g, 0, 0);
        var order : [1]usize = [99];
        var indeg : [1]usize = [99];
        const r = sort(g, &order, &indeg);
        var forged : [1]usize = [0];
        const hidden = !is_valid(TopologicalSort{ .order = &forged, .has_cycle = false }, g);
        return added and r.has_cycle and r.order.len == 0 and hidden;
    }

    // a graph with no edges sorts by index
    fn no_edges_code() -> usize {
        var r0 : [0]usize = [];
        var r1 : [0]usize = [];
        var r2 : [0]usize = [];
        var rows : [3][]usize = [&r0, &r1, &r2];
        var deg : [3]usize = [9] ** 3;
        const g = init(&rows, &deg);
        var order : [3]usize = [99] ** 3;
        var indeg : [3]usize = [99] ** 3;
        var two : [2]usize = [0] ** 2;
        const r = sort(g, &order, &indeg);
        if (r.has_cycle or !is_valid(r, g) or buffers_ok(g, &two, &indeg) or buffers_ok(g, &order, &two)) {
            return 0;
        }
        return code(r.order);
    }

    test kahn_orders_a_dag
        given result = dag_code()
        when expected = 6 * 1000 + 41
        then result == expected

    test a_cycle_is_reported
        given result = cycle_ok()
        when expected = true
        then result == expected

    test is_valid_checks_edges_and_permutation
        given result = validity_ok()
        when expected = true
        then result == expected

    test a_self_loop_is_a_cycle
        given result = self_loop_ok()
        when expected = true
        then result == expected

    test no_edges_sorts_by_index
        given result = no_edges_code()
        when expected = 0 * 1 + 1 * 2 + 2 * 3
        then result == expected
