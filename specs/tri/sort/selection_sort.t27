// t27/specs/
// Find minimum, swap to front | φ² + 1/φ² = 3 | TRINITY

module TriSelectionSort;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // sort(values: []i64) → void
    fn sort(values: []i64) -> void {
        // Selection sort: find minimum in unsorted portion, swap with first unsorted element
        var n = values.len;
        var i = 0;
        while i < n - 1 {
            // Find minimum element in unsorted portion
            var min_idx = i;
            var j = i + 1;
            while j < n {
                if values[j] < values[min_idx] {
                    min_idx = j;
                }
                j += 1;
            }
            // Swap found minimum element with first unsorted element
            if min_idx != i {
                var temp = values[i];
                values[i] = values[min_idx];
                values[min_idx] = temp;
            }
            i += 1;
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test sort_basic_case
        given input = default_input()
        when result = sort(input)
        then result != undefined

    test sort_empty_array
        given input = []
        when result = sort(input)
        then result != undefined

