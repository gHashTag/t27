// t27/specs/tri/sort/quick_sort.t27
// Use last element as pivot | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_quick_sort.tri. The port
// was not native (`let`, len(), append(), concat(), assigning to the slice
// parameter), so it partitioned into new arrays and returned nothing --
// not the in-place Lomuto sort the .tri names -- and sort_range had lost
// its low/high bounds. Its tests compared whole arrays with `==`, which
// gen-zig refuses. The .tri: sort(values) in place with Lomuto partition;
// sortRange(values, low, high) sorts [low, high] inclusive; "Pivot =
// values[high]. Partition: elements < pivot to left. Recursively sort
// both partitions". swap() keeps the #4317 test, with usize indices.

module TriQuickSort;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn swap(values: []i64, i: usize, j: usize) -> void {
        const temp = values[i];
        values[i] = values[j];
        values[j] = temp;
    }

    // Lomuto: pivot = values[high]; returns the pivot's final slot
    fn partition(values: []i64, low: usize, high: usize) -> usize {
        const pivot = values[high];
        var i : usize = low;
        var j : usize = low;
        while (j < high) {
            if (values[j] < pivot) {
                swap(values, i, j);
                i = i + 1;
            }
            j = j + 1;
        }
        swap(values, i, high);
        return i;
    }

    // sort values[low..=high]
    fn sort_range(values: []i64, low: usize, high: usize) -> void {
        if (low >= high) {
            return;
        }
        const p = partition(values, low, high);
        if (p > low) {
            sort_range(values, low, p - 1);
        }
        sort_range(values, p + 1, high);
    }

    fn sort(values: []i64) -> void {
        if (values.len < 2) {
            return;
        }
        sort_range(values, 0, values.len - 1);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // coded sum of x[k] * (k + 1): one number that pins every slot
    fn code(values: []const i64) -> i64 {
        var sum : i64 = 0;
        var k : usize = 0;
        while (k < values.len) {
            sum = sum + values[k] * ((k + 1) as i64);
            k = k + 1;
        }
        return sum;
    }

    // (1, 2, 3, 4, 5) swap 1 <-> 3 -> (1, 4, 3, 2, 5): 51
    fn swap_code() -> i64 {
        var v : [5]i64 = [1, 2, 3, 4, 5];
        swap(&v, 1, 3);
        return code(&v);
    }

    // pivot 6 over (3, 1, 4, 1, 5, 9, 2, 6) -> (3, 1, 4, 1, 5, 2, 6, 9),
    // pivot lands in slot 6: coded 172, times 10 plus the slot
    fn partition_code() -> i64 {
        var v : [8]i64 = [3, 1, 4, 1, 5, 9, 2, 6];
        const p = partition(&v, 0, 7);
        return code(&v) * 10 + (p as i64);
    }

    // strictly less moves left: pivot 6 over (6, 2, 6, 1, 6)
    // -> (2, 1, 6, 6, 6), slot 2: coded 76, times 10 plus the slot
    // (`<=` would give (6, 2, 6, 1, 6), slot 4: 624)
    fn partition_ties_code() -> i64 {
        var v : [5]i64 = [6, 2, 6, 1, 6];
        const p = partition(&v, 0, 4);
        return code(&v) * 10 + (p as i64);
    }

    // (5, -2, 8, 5, 0, -7, 3) -> (-7, -2, 0, 3, 5, 5, 8): 112
    fn sort_mixed() -> i64 {
        var v : [7]i64 = [5, 0 - 2, 8, 5, 0, 0 - 7, 3];
        sort(&v);
        return code(&v);
    }

    // only [1, 3] is sorted: (9, 4, 3, 2, 0) -> (9, 2, 3, 4, 0): 38
    fn sort_range_code() -> i64 {
        var v : [5]i64 = [9, 4, 3, 2, 0];
        sort_range(&v, 1, 3);
        return code(&v);
    }

    fn edges_ok() -> bool {
        var rev : [5]i64 = [5, 4, 3, 2, 1];
        sort(&rev);
        var one : [1]i64 = [42];
        sort(&one);
        var none : [0]i64 = [];
        sort(&none);
        return code(&rev) == 55 and one[0] == 42;
    }

    test swap_exchanges_two_slots
        given result = swap_code()
        when expected = 51
        then result == expected

    test partition_is_lomuto
        given result = partition_code()
        when expected = 1726
        then result == expected

    test partition_ties_stay_right
        given result = partition_ties_code()
        when expected = 762
        then result == expected

    test sort_mixed_with_duplicates
        given result = sort_mixed()
        when expected = 112
        then result == expected

    test sort_range_is_inclusive
        given result = sort_range_code()
        when expected = 38
        then result == expected

    test sort_edge_inputs
        given result = edges_ok()
        when expected = true
        then result == expected
