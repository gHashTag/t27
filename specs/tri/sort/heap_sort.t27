// t27/specs/
// Build max heap, then extract max repeatedly | φ² + 1/φ² = 3 | TRINITY

module TriHeapSort;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // sort(values: []i64) → void
    fn sort(values: []i64) -> void {
        // Simple heap sort implementation
        var n = values.len;
        if (n < 2) {
            return;
        }
        
        // Build max heap
        var i = n / 2 - 1;
        while (i >= 0) {
            heapify(values, n, i);
            i = i - 1;
        }
        
        // Extract elements from heap
        var j = n - 1;
        while (j > 0) {
            swap(values, 0, j);
            heapify(values, j, 0);
            j = j - 1;
        }
    }
    
    // Heapify function
    fn heapify(values: []i64, n: usize, i: usize) -> void {
        var largest = i;
        var left = 2 * i + 1;
        var right = 2 * i + 2;
        
        if (left < n and values[left] > values[largest]) {
            largest = left;
        }
        
        if (right < n and values[right] > values[largest]) {
            largest = right;
        }
        
        if (largest != i) {
            swap(values, i, largest);
            heapify(values, n, largest);
        }
    }
    
    // Swap helper
    fn swap(a: []i64, i: usize, j: usize) -> void {
        var temp = a[i];
        a[i] = a[j];
        a[j] = temp;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test sort_basic_case
        given input = default_input()
        when result = sort(input)
        then result != undefined

    test sort_empty_array
        given input = []i64
        when result = sort(input)
        then result != undefined