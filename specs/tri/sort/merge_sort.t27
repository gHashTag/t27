// t27/specs/
// Split in half, recursively sort, merge | φ² + 1/φ² = 3 | TRINITY

module TriMergeSort;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // sort(values: []i64) → []i64
    fn sort(values: []i64) -> []i64 {
        // Implementation of merge sort
        if (values.len <= 1) {
            return values;
        }
        
        let mid = values.len / 2;
        let left = values[0..mid];
        let right = values[mid..values.len];
        
        let sorted_left = sort(left);
        let sorted_right = sort(right);
        
        return merge(sorted_left, sorted_right);
    }

    // sort_in_place(values: []i64) → void
    fn sort_in_place(values: []i64) -> void {
        // Implementation of in-place merge sort
        let sorted = sort(values);
        for (i in 0..values.len) {
            values[i] = sorted[i];
        }
    }

    // merge(left: []i64, right: []i64) → []i64
    fn merge(left: []i64, right: []i64) -> []i64 {
        let result = []i64{0};
        let k = 0;
        let i = 0;
        let j = 0;
        
        while (i < left.len and j < right.len) {
            if (left[i] <= right[j]) {
                result[k] = left[i];
                i = i + 1;
            } else {
                result[k] = right[j];
                j = j + 1;
            }
            k = k + 1;
        }
        
        while (i < left.len) {
            result[k] = left[i];
            i = i + 1;
            k = k + 1;
        }
        
        while (j < right.len) {
            result[k] = right[j];
            j = j + 1;
            k = k + 1;
        }
        
        return result;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test sort_basic_case
        given input = [3, 1, 4, 1, 5, 9, 2, 6]
        when result = sort(input)
        then result[0] == 1 and result[1] == 1 and result[2] == 2 and result[3] == 3 and result[4] == 4 and result[5] == 5 and result[6] == 6 and result[7] == 9

    test sort_in_place_basic_case
        given input = [3, 1, 4, 1, 5, 9, 2, 6]
        when sort_in_place(input)
        then input[0] == 1 and input[1] == 1 and input[2] == 2 and input[3] == 3 and input[4] == 4 and input[5] == 5 and input[6] == 6 and input[7] == 9

