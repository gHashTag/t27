// t27/specs/tri/sort/shell_sort.t27
// Sort elements at gap distance, reduce gap | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_shell_sort.tri. The port
// was not native (`let mut`, `values.length`, growing an array with `+`),
// used Knuth's gaps 1, 4, 13, ... where the .tri names Shell's original
// sequence n/2, n/4, ..., 1, and its tests read default_input() (defined
// nowhere) or compared whole arrays with `==`. The .tri behavior:
// "Start with gap = n/2, g-sorted insertion sort. Reduce gap until 1,
// then final insertion sort." -- ascending, in place.

module TriShellSort;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Core Functions
    // ═══════════════════════════════════════════════════════════

    // Shell's original sequence: n/2, then halve
    fn first_gap(n: usize) -> usize {
        return n / 2;
    }

    fn next_gap(gap: usize) -> usize {
        return gap / 2;
    }

    // insertion sort over every chain values[k], values[k - gap], ...
    fn gap_pass(values: []i64, gap: usize) -> void {
        var k : usize = gap;
        while (k < values.len) {
            const item = values[k];
            var j : usize = k;
            while (j >= gap and values[j - gap] > item) {
                values[j] = values[j - gap];
                j = j - gap;
            }
            values[j] = item;
            k = k + 1;
        }
    }

    // the last gap is n/2 halved down to 1, so the final pass is plain insertion
    fn sort(values: []i64) -> void {
        var gap : usize = first_gap(values.len);
        while (gap > 0) {
            gap_pass(values, gap);
            gap = next_gap(gap);
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // coded sum of x[k] * (k + 1): one number that pins every slot
    fn code(values: []const i64) -> i64 {
        var sum : i64 = 0;
        var k : usize = 0;
        while (k < values.len) {
            sum = sum + values[k] * ((k + 1) as i64);
            k = k + 1;
        }
        return sum;
    }

    // n = 10 runs gaps 5, 2, 1: coded 5*1 + 2*2 + 1*3 = 12
    // (Knuth's 4, 1 would give 6)
    fn gaps_code() -> usize {
        var sum : usize = 0;
        var k : usize = 1;
        var gap : usize = first_gap(10);
        while (gap > 0) {
            sum = sum + gap * k;
            gap = next_gap(gap);
            k = k + 1;
        }
        return sum;
    }

    // one gap-3 pass over (9, 8, ..., 0) gives (0, 2, 1, 3, 5, 4, 6, 8, 7, 9): 327
    fn gap3_code() -> i64 {
        var v : [10]i64 = [9, 8, 7, 6, 5, 4, 3, 2, 1, 0];
        gap_pass(&v, 3);
        return code(&v);
    }

    // (5, -2, 8, 5, 0, -7, 3) -> (-7, -2, 0, 3, 5, 5, 8): 112
    fn sort_mixed() -> i64 {
        var v : [7]i64 = [5, 0 - 2, 8, 5, 0, 0 - 7, 3];
        sort(&v);
        return code(&v);
    }

    fn edges_ok() -> bool {
        var two : [2]i64 = [2, 1];
        sort(&two);
        var one : [1]i64 = [42];
        sort(&one);
        var none : [0]i64 = [];
        sort(&none);
        return two[0] == 1 and two[1] == 2 and one[0] == 42;
    }

    test gaps_are_shell_original
        given result = gaps_code()
        when expected = 12
        then result == expected

    test gap_pass_sorts_each_chain
        given result = gap3_code()
        when expected = 327
        then result == expected

    test sort_mixed_with_duplicates
        given result = sort_mixed()
        when expected = 112
        then result == expected

    test sort_edge_inputs
        given result = edges_ok()
        when expected = true
        then result == expected
