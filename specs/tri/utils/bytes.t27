// t27/specs/
// Views share underlying data | φ² + 1/φ² = 3 | TRINITY

module TriBytes;
    use base::types;
    use math::constants;
    use std;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Bytes = struct {
        data : []u8,
        owned : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // empty() → Bytes
    fn empty() -> Bytes {
        // Returns a zero-length buffer, owned = false.
        // Nothing was allocated, so nothing is owned.
        return Bytes{ .data = @as([]u8, &.{}), .owned = false };
    }

    // from_slice(slice: []const u8) → Bytes
    fn from_slice(slice: []const u8) -> Bytes {
        // Wrap the caller's slice as a view: same backing memory, owned = false.
        // Do not copy. This is the rule the header states.
        return Bytes{ .data = @as([]u8, @constCast(slice)), .owned = false };
    }

    // clone(bytes: Bytes, allocator: std.mem.Allocator) → !Bytes
    fn clone(bytes: Bytes, allocator: std.mem.Allocator) -> !Bytes {
        // Allocate bytes.data.len bytes, copy, return owned = true.
        // Returns !Bytes because allocation can fail.
        const new_data = try allocator.alloc(u8, bytes.data.len);
        @memcpy(new_data, bytes.data);
        return Bytes{ .data = new_data, .owned = true };
    }

    // equals(a: Bytes, b: Bytes) → bool
    fn equals(a: Bytes, b: Bytes) -> bool {
        // True when the two lengths match and every byte matches.
        // owned takes no part in equality: two buffers with the same content 
        // are equal whoever owns them.
        if (a.data.len != b.data.len) return false;
        for (a.data, b.data) |byte_a, byte_b| {
            if (byte_a != byte_b) return false;
        }
        return true;
    }

    // slice(bytes: Bytes, start: usize, end: usize) → Bytes
    fn slice(bytes: Bytes, start: usize, end: usize) -> Bytes {
        // A sub-view bytes.data[start..end], owned = false no matter what bytes.owned was.
        // A view of an owned buffer is still only a view, and must never free.
        // Clamp start and end into range and return the empty view when start >= end.
        const clamped_start = if (start < bytes.data.len) start else bytes.data.len;
        const clamped_end = if (end < bytes.data.len) end else bytes.data.len;
        if (clamped_start >= clamped_end) {
            return Bytes{ .data = @as([]u8, &.{}), .owned = false };
        }
        return Bytes{ .data = bytes.data[clamped_start..clamped_end], .owned = false };
    }

    // concat(a: Bytes, b: Bytes, allocator: std.mem.Allocator) → !Bytes
    fn concat(a: Bytes, b: Bytes, allocator: std.mem.Allocator) -> !Bytes {
        // Allocate a.data.len + b.data.len, copy both in order, return owned = true.
        const total_len = a.data.len + b.data.len;
        const new_data = try allocator.alloc(u8, total_len);
        @memcpy(new_data[0..a.data.len], a.data);
        @memcpy(new_data[a.data.len..total_len], b.data);
        return Bytes{ .data = new_data, .owned = true };
    }

    // index_of(bytes: Bytes, pattern: []const u8) → ?usize
    fn index_of(bytes: Bytes, pattern: []const u8) -> ?usize {
        // The index of the first occurrence of pattern in bytes.data, or null when absent.
        // An empty pattern matches at 0. The ?usize return is what carries "not found" —
        // never return a sentinel number.
        if (pattern.len == 0) return 0;
        
        const max_search = bytes.data.len - pattern.len;
        for (0..max_search + 1) |i| {
            var match = true;
            for (pattern) |p, j| {
                if (bytes.data[i + j] != p) {
                    match = false;
                    break;
                }
            }
            if (match) return i;
        }
        return null;
    }

    // split(bytes: Bytes, delimiter: u8, allocator: std.mem.Allocator) -> ![]Bytes
    fn split(bytes: Bytes, delimiter: u8, allocator: std.mem.Allocator) -> ![]Bytes {
        // Split on delimiter and return the pieces.
        // The pieces are views into the original (cheap, owned = false).
        // The returned slice-of-Bytes is itself allocated, so it must be freed by the caller.
        
        var result = std.ArrayList(Bytes).init(allocator);
        defer result.deinit();
        
        var start: usize = 0;
        for (bytes.data, 0..) |byte, i| {
            if (byte == delimiter) {
                const slice = bytes.data[start..i];
                const piece = Bytes{ .data = @as([]u8, @constCast(slice)), .owned = false };
                try result.append(piece);
                start = i + 1;
            }
        }
        
        // Add the last piece
        const last_slice = bytes.data[start..];
        const last_piece = Bytes{ .data = @as([]u8, @constCast(last_slice)), .owned = false };
        try result.append(last_piece);
        
        return result.toOwnedSlice();
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test empty_basic_case
        given input = default_input()
        when result = empty(input)
        then result != undefined

    test from_slice_basic_case
        given input = default_input()
        when result = from_slice(input)
        then result != undefined

    test clone_basic_case
        given input = default_input()
        when result = clone(input)
        then result != undefined

    test equals_basic_case
        given input = default_input()
        when result = equals(input)
        then result != undefined

    test slice_basic_case
        given input = default_input()
        when result = slice(input)
        then result != undefined

    test concat_basic_case
        given input = default_input()
        when result = concat(input)
        then result != undefined

    test index_of_basic_case
        given input = default_input()
        when result = index_of(input)
        then result != undefined

    test split_basic_case
        given input = default_input()
        when result = split(input)
        then result != undefined

    test empty_ownership
        given result = empty()
        then result.owned == false

    test from_slice_ownership
        given slice = "hello"
        when result = from_slice(slice)
        then result.owned == false

    test clone_ownership
        given original = from_slice("test")
           allocator = default_allocator()
        when result = clone(original, allocator)
        then result.owned == true

    test equals_content_ignores_ownership
        given a = from_slice("same")
           b = Bytes{ .data = "same", .owned = true }
        when result = equals(a, b)
        then result == true

    test slice_ownership
        given original = from_slice("hello world")
           result = slice(original, 0, 5)
        then result.owned == false

    test index_of_not_found
        given bytes = from_slice("hello")
        when result = index_of(bytes, "xyz")
        then result == null

    test index_of_empty_pattern
        given bytes = from_slice("hello")
        when result = index_of(bytes, "")
        then result == 0

