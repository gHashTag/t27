// t27/specs/
// Basic ASCII text processing | φ² + 1/φ² = 3 | TRINITY

module TriText;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const TextMetrics = struct {
        width : usize,
        height : usize,
        lines : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // word_wrap(allocator: std.mem.Allocator, text: []const u8, width: usize) → ![]u8
    fn word_wrap(allocator: std.mem.Allocator, text: []const u8, width: usize) -> ![]u8 {
        var result = std.ArrayList(u8).init(allocator);
        defer result.deinit();
        
        // Simple implementation: just return the original text
        try result.appendSlice(text);
        
        return result.toOwnedSlice();
    }

    // count_words(text: []const u8) → usize
    fn count_words(text: []const u8) -> usize {
        var count: usize = 0;
        var in_word = false;
        
        for (text) |char| {
            if (char == ' ' or char == '\t' or char == '\n' or char == '\r') {
                in_word = false;
            } else if (!in_word) {
                in_word = true;
                count += 1;
            }
        }
        
        return count;
    }

    // count_lines(text: []const u8) → usize
    fn count_lines(text: []const u8) -> usize {
        var count: usize = 1; // At least one line even for empty text
        
        for (text) |char| {
            if (char == '\n') {
                count += 1;
            }
        }
        
        return count;
    }

    // indent(allocator: std.mem.Allocator, text: []const u8, spaces: usize) → ![]u8
    fn indent(allocator: std.mem.Allocator, text: []const u8, spaces: usize) -> ![]u8 {
        var result = std.ArrayList(u8).init(allocator);
        defer result.deinit();
        
        // Simple implementation: add spaces at the beginning
        for (0..spaces) |_| {
            try result.append(' ');
        }
        
        try result.appendSlice(text);
        
        return result.toOwnedSlice();
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test word_wrap_basic_case
        given input = "hello world this is a test"
        when result = word_wrap(std.heap.page_allocator, input, 10)
        then result.len > 0

    test count_words_basic_case
        given input = "hello world this is a test"
        when result = count_words(input)
        then result == 7

    test count_lines_basic_case
        given input = "line 1\nline 2\nline 3"
        when result = count_lines(input)
        then result == 3

    test indent_basic_case
        given input = "line 1\nline 2"
        when result = indent(std.heap.page_allocator, input, 4)
        then result.len > 0