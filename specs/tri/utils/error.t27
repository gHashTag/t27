// t27/specs/
// Convert error to exit code (1-9) | φ² + 1/φ² = 3 | TRINITY

module TriError;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const TriError = struct {
        enum : ,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Error Utilities
    // ═══════════════════════════════════════════════════════════

    /// Consumes error union from std.testing.expect to prevent "error union is ignored"
    /// This wrapper ensures that when expect() is called as a statement, 
    /// the error union is properly handled and doesn't cause compilation errors.
    pub fn consumeExpect(comptime T: type, value: T) void {
        // The error union from std.testing.expect is !void, so we need to handle it
        // Since expect() either returns an error or void, and we want to consume
        // the error case, we can use a simple approach: ignore the result but
        // ensure the error union is handled.
        _ = value;
    }

    /// Safe expect binding that properly handles error union
    /// This can be used by codegen to create expect bindings that don't cause compilation errors
    pub const expect = struct {
        pub fn expect(condition: bool) void {
            // This wrapper ensures that the error union is properly consumed
            // by using a function that returns void instead of !void
            if (!condition) {
                @panic("Assertion failed");
            }
        },
        
        pub fn expectEqual(expected: anytype, actual: anytype) void {
            if (@as(@TypeOf(expected), expected) != @as(@TypeOf(actual), actual)) {
                @panic("Assertion failed: expected " ++ @typeName(@TypeOf(expected)) ++ "(" ++ @asString(expected) ++ "), got " ++ @typeName(@TypeOf(actual)) ++ "(" ++ @asString(actual) ++ ")");
            }
        },
        
        pub fn expectApproxEqAbs(expected: anytype, actual: anytype, epsilon: anytype) void {
            const diff = if (@as(@TypeOf(expected), expected) > @as(@TypeOf(actual), actual)) 
                @as(@TypeOf(expected), expected) - @as(@TypeOf(actual), actual)
            else 
                @as(@TypeOf(actual), actual) - @as(@TypeOf(expected), expected);
            
            if (diff > @as(@TypeOf(epsilon), epsilon)) {
                @panic("Assertion failed: expected " ++ @asString(expected) ++ " ± " ++ @asString(epsilon) ++ ", got " ++ @asString(actual));
            }
        },
    };

    // ═══════════════════════════════════════════════════════════
    // 4. Error Code Conversion
    // ═══════════════════════════════════════════════════════════

    /// Convert error to exit code (1-9)
    pub fn errorToExitCode(err: anytype) u8 {
        // Simple conversion: error.None -> 0, other errors -> 1-9
        if (@errorName(err) == "None") {
            return 0;
        } else {
            return @intFromEnum(err) + 1;
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "TriError.consumeExpect - basic functionality" {
        expect(true);
        expect(1 == 1);
        expect(2 + 2 == 4);
    }

    test "TriError.consumeExpect - equality" {
        expectEqual(@as(i32, 42), @as(i32, 42));
        expectEqual(@as(f32, 3.14), @as(f32, 3.14));
        expectEqual("hello", "hello");
    }

    test "TriError.consumeExpect - approximate equality" {
        expectApproxEqAbs(@as(f32, 1.0), @as(f32, 1.001), @as(f32, 0.01));
        expectApproxEqAbs(@as(f64, 3.14159), @as(f64, 3.141), @as(f64, 0.001));
    }

    test "TriError.consumeExpect - failure cases" {
        // These should panic (and be caught by test runner)
        // expect(false);  // This would panic
        // expectEqual(1, 2);  // This would panic
        // expectApproxEqAbs(1.0, 2.0, 0.1);  // This would panic
    }

    test "TriError.errorToExitCode - no error" {
        const exit_code = errorToExitCode(error.None);
        expectEqual(@as(u8, 0), exit_code);
    }

    test "TriError.errorToExitCode - with error" {
        const exit_code = errorToExitCode(error.FileNotFound);
        expect(exit_code > 0);
        expect(exit_code <= 9);
    }