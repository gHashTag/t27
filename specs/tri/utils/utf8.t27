// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Full Unicode support | φ² + 1/φ² = 3 | TRINITY

module TriUtf8;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Codepoint = struct {
        underlying : "u21",
    };

    pub const Rune = struct {
        bytes : [4]u8,
        len : "u8",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // decode(str: []const u8, index: usize) → Rune
    fn decode(str: []const u8, index: usize) -> Rune {
        var result = Rune{.bytes=[_]u8{0,0,0,0},.len=0};
        
        if (index >= str.len) {
            result.len = 1;
            result.bytes[0] = 0; // null byte for out of bounds
            return result;
        }
        
        const lead = str[index];
        var byte_count: usize = 0;
        
        if ((lead & 0x80) == 0x00) { // 0xxxxxxx
            byte_count = 1;
        } else if ((lead & 0xE0) == 0xC0) { // 110xxxxx
            byte_count = 2;
        } else if ((lead & 0xF0) == 0xE0) { // 1110xxxx
            byte_count = 3;
        } else if ((lead & 0xF8) == 0xF0) { // 11110xxx
            byte_count = 4;
        } else {
            // Malformed lead byte
            result.len = 1;
            result.bytes[0] = lead;
            return result;
        }
        
        // Check if we have enough bytes
        if (index + byte_count > str.len) {
            result.len = 1;
            result.bytes[0] = lead;
            return result;
        }
        
        // Copy the bytes
        result.len = byte_count;
        var i: usize = 0;
        while (i < byte_count) {
            result.bytes[i] = str[index + i];
            i = i + 1;
        }
        
        return result;
    }

    // encode(codepoint: Codepoint, allocator: std.mem.Allocator) → ![]u8
    fn encode(codepoint: Codepoint, allocator: std.mem.Allocator) -> ![]u8 {
        const cp = codepoint.underlying;
        var bytes: [4]u8 = undefined;
        var len: usize = 0;
        
        if (cp < 0x80) {
            // 1 byte: 0xxxxxxx
            bytes[0] = cp;
            len = 1;
        } else if (cp < 0x800) {
            // 2 bytes: 110xxxxx 10xxxxxx
            bytes[0] = 0xC0 | (cp >> 6);
            bytes[1] = 0x80 | (cp & 0x3F);
            len = 2;
        } else if (cp < 0x10000) {
            // 3 bytes: 1110xxxx 10xxxxxx 10xxxxxx
            bytes[0] = 0xE0 | (cp >> 12);
            bytes[1] = 0x80 | ((cp >> 6) & 0x3F);
            bytes[2] = 0x80 | (cp & 0x3F);
            len = 3;
        } else if (cp <= 0x10FFFF) {
            // 4 bytes: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
            bytes[0] = 0xF0 | (cp >> 18);
            bytes[1] = 0x80 | ((cp >> 12) & 0x3F);
            bytes[2] = 0x80 | ((cp >> 6) & 0x3F);
            bytes[3] = 0x80 | (cp & 0x3F);
            len = 4;
        } else {
            return error.InvalidCodepoint;
        }
        
        // Allocate and copy the bytes
        const result = allocator.alloc(u8, len);
        var i: usize = 0;
        while (i < len) {
            result[i] = bytes[i];
            i = i + 1;
        }
        
        return result;
    }

    // count_codepoints(str: []const u8) → usize
    fn count_codepoints(str: []const u8) -> usize {
        var count: usize = 0;
        var i: usize = 0;
        
        while (i < str.len) {
            const lead = str[i];
            
            if ((lead & 0x80) == 0x00) { // 0xxxxxxx
                count += 1;
                i += 1;
            } else if ((lead & 0xE0) == 0xC0) { // 110xxxxx
                count += 1;
                i += 2;
            } else if ((lead & 0xF0) == 0xE0) { // 1110xxxx
                count += 1;
                i += 3;
            } else if ((lead & 0xF8) == 0xF0) { // 11110xxx
                count += 1;
                i += 4;
            } else {
                // Malformed byte, skip it
                i += 1;
            }
        }
        
        return count;
    }

    // validate(str: []const u8) → bool
    fn validate(str: []const u8) -> bool {
        var i: usize = 0;
        
        while (i < str.len) {
            const lead = str[i];
            var expected_len: usize = 0;
            
            if ((lead & 0x80) == 0x00) { // 0xxxxxxx
                expected_len = 1;
            } else if ((lead & 0xE0) == 0xC0) { // 110xxxxx
                expected_len = 2;
            } else if ((lead & 0xF0) == 0xE0) { // 1110xxxx
                expected_len = 3;
            } else if ((lead & 0xF8) == 0xF0) { // 11110xxx
                expected_len = 4;
            } else {
                // Invalid lead byte
                return false;
            }
            
            // Check if we have enough bytes
            if (i + expected_len > str.len) {
                return false;
            }
            
            // Check continuation bytes
            var j: usize = 1;
            while (j < expected_len) {
                if ((str[i + j] & 0xC0) != 0x80) {
                    return false;
                }
                j = j + 1;
            }
            
            // Check for overlong encoding
            if (expected_len > 1) {
                var value: usize = 0;
                j = 0;
                while (j < expected_len) {
                    if (j == 0) {
                        value = lead & (0x1F >> (j));
                    } else {
                        value = (value << 6) | (str[i + j] & 0x3F);
                    }
                    j = j + 1;
                }
                
                // Check for overlong encoding
                if (expected_len == 2 && value < 0x80) return false;
                if (expected_len == 3 && value < 0x800) return false;
                if (expected_len == 4 && value < 0x10000) return false;
                
                // Check for codepoint > 0x10FFFF
                if (value > 0x10FFFF) return false;
            }
            
            i += expected_len;
        }
        
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // decode/encode/count_codepoints/validate are now implemented with UTF-8
    // encoding/decoding logic. The tests below check boundary conditions and
    // basic functionality for each function.

    test decode_basic_case
        given text = "A"
        when r = decode(text, 0)
        then r.len == 1 and r.bytes[0] == 65

    test encode_basic_case
        given cp = Codepoint{.underlying=65}
        when result = encode(cp, @import("std").heap.page_allocator)
        then result.len == 1 and result[0] == 65

    test count_codepoints_basic_case
        given text = "Hello"
        when count = count_codepoints(text)
        then count == 5

    test validate_basic_case
        given text = "Valid UTF-8"
        when valid = validate(text)
        then valid == true

    test rune_buffer_is_four_bytes_the_utf8_maximum
        // Verify: the declared fixed buffer matches the longest UTF-8 sequence
        given r = Rune{.bytes=[_]u8{0,0,0,0},.len=0}
        then r.bytes.len == 4

    test four_byte_rune_fills_the_whole_buffer
        // Verify: U+10FFFF encodes as F4 8F BF BF -- four bytes, exactly the
        // declared buffer size
        given r = Rune{.bytes=[_]u8{0xF4,0x8F,0xBF,0xBF},.len=4}
        then r.len == 4 and r.bytes[3] == 0xBF

    test decode_multibyte_sequence
        given text = "é"
        when r = decode(text, 0)
        then r.len == 2 and r.bytes[0] == 0xC3 and r.bytes[1] == 0xA9

    test encode_max_codepoint
        given cp = Codepoint{.underlying=0x10FFFF}
        when result = encode(cp, @import("std").heap.page_allocator)
        then result.len == 4 and result[0] == 0xF4 and result[1] == 0x8F and result[2] == 0xBF and result[3] == 0xBF

    test count_codepoints_multibyte
        given text = "café"
        when count = count_codepoints(text)
        then count == 4

    test validate_invalid_utf8
        given text = [_]u8{0xFF, 0xFF, 0xFF}
        when valid = validate(text)
        then valid == false

    test decode_out_of_bounds
        given text = "A"
        when r = decode(text, 1)
        then r.len == 1 and r.bytes[0] == 0