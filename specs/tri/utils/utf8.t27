// t27/specs/
// Full Unicode support | φ² + 1/φ² = 3 | TRINITY

module TriUtf8;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Codepoint = struct {
        underlying : "u21",
    };

    pub const Rune = struct {
        bytes : [4]u8,
        len : "u8",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // decode(str: []const u8, index: usize) → Rune
    fn decode(str: []const u8, index: usize) -> Rune {
        var result = Rune{.bytes=[_]u8{0,0,0,0},.len=0};
        
        if (index >= str.len) {
            result.len = 1;
            result.bytes[0] = 0;
            return result;
        }
        
        const lead = str[index];
        var byte_count : u8 = 0;
        
        if ((lead & 0x80) == 0x00) {
            // 1-byte sequence: 0xxxxxxx
            byte_count = 1;
        } else if ((lead & 0xE0) == 0xC0) {
            // 2-byte sequence: 110xxxxx
            byte_count = 2;
        } else if ((lead & 0xF0) == 0xE0) {
            // 3-byte sequence: 1110xxxx
            byte_count = 3;
        } else if ((lead & 0xF8) == 0xF0) {
            // 4-byte sequence: 11110xxx
            byte_count = 4;
        } else {
            // Malformed lead byte
            result.len = 1;
            result.bytes[0] = lead;
            return result;
        }
        
        // Check if we have enough bytes
        if (index + byte_count > str.len) {
            // Truncated sequence
            result.len = 1;
            result.bytes[0] = lead;
            return result;
        }
        
        // Copy the bytes
        var i : usize = 0;
        while (i < byte_count) : (i += 1) {
            result.bytes[i] = str[index + i];
        }
        result.len = byte_count;
        
        return result;
    }

    // encode(codepoint: Codepoint, allocator: std.mem.Allocator) → ![]u8
    fn encode(codepoint: Codepoint, allocator: std.mem.Allocator) -> ![]u8 {
        const value = codepoint.underlying;
        var bytes : [4]u8 = undefined;
        var len : u8 = 0;
        
        if (value < 0x80) {
            // 1 byte: 0xxxxxxx
            bytes[0] = @truncate(u8, value);
            len = 1;
        } else if (value < 0x800) {
            // 2 bytes: 110xxxxx 10xxxxxx
            bytes[1] = @truncate(u8, (value & 0x3F) | 0x80);
            bytes[0] = @truncate(u8, ((value >> 6) & 0x1F) | 0xC0);
            len = 2;
        } else if (value < 0x10000) {
            // 3 bytes: 1110xxxx 10xxxxxx 10xxxxxx
            bytes[2] = @truncate(u8, (value & 0x3F) | 0x80);
            bytes[1] = @truncate(u8, ((value >> 6) & 0x3F) | 0x80);
            bytes[0] = @truncate(u8, ((value >> 12) & 0x0F) | 0xE0);
            len = 3;
        } else if (value <= 0x10FFFF) {
            // 4 bytes: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
            bytes[3] = @truncate(u8, (value & 0x3F) | 0x80);
            bytes[2] = @truncate(u8, ((value >> 6) & 0x3F) | 0x80);
            bytes[1] = @truncate(u8, ((value >> 12) & 0x3F) | 0x80);
            bytes[0] = @truncate(u8, ((value >> 18) & 0x07) | 0xF0);
            len = 4;
        } else {
            // Invalid codepoint
            return error.InvalidCodepoint;
        }
        
        // Allocate and return the result
        const result = allocator.alloc(u8, len) catch return error.OutOfMemory;
        var i : usize = 0;
        while (i < len) : (i += 1) {
            result[i] = bytes[i];
        }
        return result;
    }

    // count_codepoints(str: []const u8) → usize
    fn count_codepoints(str: []const u8) -> usize {
        var count : usize = 0;
        var i : usize = 0;
        
        while (i < str.len) : (i += 1) {
            const byte = str[i];
            if ((byte & 0xC0) != 0x80) {
                // Not a continuation byte, so it's a lead byte
                count += 1;
            }
        }
        
        return count;
    }

    // validate(str: []const u8) → bool
    fn validate(str: []const u8) -> bool {
        var i : usize = 0;
        
        while (i < str.len) : (i += 1) {
            const lead = str[i];
            var byte_count : u8 = 0;
            
            if ((lead & 0x80) == 0x00) {
                // 1-byte sequence: 0xxxxxxx
                byte_count = 1;
            } else if ((lead & 0xE0) == 0xC0) {
                // 2-byte sequence: 110xxxxx
                byte_count = 2;
            } else if ((lead & 0xF0) == 0xE0) {
                // 3-byte sequence: 1110xxxx
                byte_count = 3;
            } else if ((lead & 0xF8) == 0xF0) {
                // 4-byte sequence: 11110xxx
                byte_count = 4;
            } else {
                // Invalid lead byte
                return false;
            }
            
            // Check if we have enough continuation bytes
            if (i + byte_count > str.len) {
                return false;
            }
            
            // Check continuation bytes
            var j : usize = 1;
            while (j < byte_count) : (j += 1) {
                if ((str[i + j] & 0xC0) != 0x80) {
                    return false;
                }
            }
            
            // Check for overlong encoding
            if (byte_count > 1) {
                var min_value : u21 = 0;
                if (byte_count == 2) {
                    min_value = 0x80;
                } else if (byte_count == 3) {
                    min_value = 0x800;
                } else if (byte_count == 4) {
                    min_value = 0x10000;
                }
                
                // Calculate the actual value
                var actual_value : u21 = 0;
                var k : usize = 0;
                while (k < byte_count) : (k += 1) {
                    actual_value = (actual_value << 6) | (@as(u21, str[i + k]) & 0x3F);
                }
                
                // Remove the prefix bits
                if (byte_count == 2) {
                    actual_value &= 0x1F;
                } else if (byte_count == 3) {
                    actual_value &= 0x0F;
                } else if (byte_count == 4) {
                    actual_value &= 0x07;
                }
                
                if (actual_value < min_value) {
                    return false;
                }
            }
            
            // Check for codepoint > U+10FFFF
            if (byte_count == 4) {
                var actual_value : u21 = 0;
                var k : usize = 0;
                while (k < 4) : (k += 1) {
                    actual_value = (actual_value << 6) | (@as(u21, str[i + k]) & 0x3F);
                }
                actual_value &= 0x07; // Remove the prefix bits
                
                if (actual_value > 0x10FFFF) {
                    return false;
                }
            }
            
            i += byte_count;
        }
        
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // decode/encode/count_codepoints/validate are now implemented with proper UTF-8 handling.
    // The tests below verify boundary conditions and basic functionality.

    test decode_basic_case
        given input = "A"
        when r = decode(input, 0)
        then r.len == 1 and r.bytes[0] == 65

    test encode_basic_case
        given cp = Codepoint{.underlying=65}
        when result = encode(cp, allocator)
        then result.len == 1 and result[0] == 65

    test count_codepoints_basic_case
        given input = "Hello"
        when count = count_codepoints(input)
        then count == 5

    test validate_basic_case
        given input = "Hello"
        when valid = validate(input)
        then valid == true

    test rune_buffer_is_four_bytes_the_utf8_maximum
        // Verify: the declared fixed buffer matches the longest UTF-8 sequence
        given r = Rune{.bytes=[_]u8{0,0,0,0},.len=0}
        then r.bytes.len == 4

    test four_byte_rune_fills_the_whole_buffer
        // Verify: U+10FFFF encodes as F4 8F BF BF -- four bytes, exactly the
        // declared buffer size
        given r = Rune{.bytes=[_]u8{0xF4,0x8F,0xBF,0xBF},.len=4}
        then r.len == 4 and r.bytes[3] == 0xBF

    test decode_ascii_character
        given text = "Z"
        when r = decode(text, 0)
        then r.len == 1 and r.bytes[0] == 90

    test encode_two_byte_rune
        given cp = Codepoint{.underlying=0x00E9} // é
        when result = encode(cp, allocator)
        then result.len == 2 and result[0] == 0xC3 and result[1] == 0xA9

    test count_codepoints_with_multibyte
        given input = "Café"
        when count = count_codepoints(input)
        then count == 4

    test validate_invalid_utf8
        given input = "\xC0\x80" // Overlong encoding of null
        when valid = validate(input)
        then valid == false
