// t27/specs/tri/trees/segment_tree.t27
// Segment tree, range sums with point updates | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_segment_tree.tri. The port
// did not compile (`let`, `let mut`, `?? panic`, quoted field types, a
// reversed range `(size - 1)..0` that never builds the internal nodes) and
// its init test asserted `result != undefined`. The .tri: SegmentTree {
// data: []i64, size, allocator }, "Binary tree for range queries";
// init(allocator, values) "Build segment tree from array"; query(tree,
// left, right) -> i64 "Sum query on range [left, right]"; update(tree,
// index, value) "Update element at index"; deinit frees; behaviour
// range_sum: "Tree size is next power of 2. Leaf at index i stores
// original[i]. Internal node stores sum of children."
// Here the allocator becomes a caller buffer of 2 * size words, where size
// is the next power of 2 at or above values.len (pow2_at_least); deinit
// has nothing to free and is gone. Node 1 is the root, node i has children
// 2i and 2i + 1, leaves are size + i, padding leaves hold 0, data[0] is
// unused. query is inclusive on both ends and needs left <= right <
// values.len (NOT CHECKED inside). NOT CHECKED: the .tri note "O(log n)"
// (the loops halve, but cost is not measured). Mutation-checked
// 2026-10-06: 13 mutants of every function fail a test.

module TriSegmentTree;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const SegmentTree = struct {
        data : []i64,
        size : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    // smallest power of 2 that is >= n (1 for n = 0)
    fn pow2_at_least(n: usize) -> usize {
        var p : usize = 1;
        while (p < n) {
            p = p * 2;
        }
        return p;
    }

    fn fits(buffer: []const i64, n: usize) -> bool {
        return buffer.len >= 2 * pow2_at_least(n);
    }

    fn init(buffer: []i64, values: []const i64) -> SegmentTree {
        const size = pow2_at_least(values.len);
        var i : usize = 0;
        while (i < size) {
            if (i < values.len) {
                buffer[size + i] = values[i];
            } else {
                buffer[size + i] = 0;
            }
            i = i + 1;
        }
        buffer[0] = 0;
        var j = size - 1;
        while (j > 0) {
            buffer[j] = buffer[2 * j] + buffer[2 * j + 1];
            j = j - 1;
        }
        return SegmentTree{ .data = buffer[0..2 * size], .size = size };
    }

    // sum of values[left..=right], walking the half-open leaf range up
    fn query(tree: *SegmentTree, left: usize, right: usize) -> i64 {
        var sum : i64 = 0;
        var lo = left + tree.size;
        var hi = right + tree.size + 1;
        while (lo < hi) {
            if (lo % 2 == 1) {
                sum = sum + tree.data[lo];
                lo = lo + 1;
            }
            if (hi % 2 == 1) {
                hi = hi - 1;
                sum = sum + tree.data[hi];
            }
            lo = lo / 2;
            hi = hi / 2;
        }
        return sum;
    }

    fn update(tree: *SegmentTree, index: usize, value: i64) -> void {
        var i = index + tree.size;
        tree.data[i] = value;
        while (i > 1) {
            i = i / 2;
            tree.data[i] = tree.data[2 * i] + tree.data[2 * i + 1];
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // how many of the ranges [l, r] of values the tree sums correctly
    fn agree(tree: *SegmentTree, values: []const i64) -> usize {
        var ok : usize = 0;
        var l : usize = 0;
        while (l < values.len) {
            var r = l;
            var direct : i64 = 0;
            while (r < values.len) {
                direct = direct + values[r];
                if (query(tree, l, r) == direct) {
                    ok = ok + 1;
                }
                r = r + 1;
            }
            l = l + 1;
        }
        return ok;
    }

    // 5 values pad to size 8: leaves 8..12 hold them, 13..15 hold 0, the
    // root holds the total 12; all 15 ranges agree; values[1..=3] sum to 4
    fn build_ok() -> bool {
        var buf : [16]i64 = [99] ** 16;
        const values : [5]i64 = [3, 0 - 1, 4, 1, 5];
        var t = init(&buf, &values);
        const shape = t.size == 8 and t.data.len == 16 and buf[8] == 3 and buf[12] == 5
            and buf[13] == 0 and buf[15] == 0 and buf[1] == 12 and buf[2] == 7 and buf[3] == 5;
        return shape and agree(&t, &values) == 15 and query(&t, 1, 3) == 4;
    }

    // set index 4 to 0 - 1, then index 1 to 6 (its path is the last to
    // reach the root): every range sum follows and the total moves 12 -> 13
    fn update_ok() -> bool {
        var buf : [16]i64 = [0] ** 16;
        var values : [5]i64 = [3, 0 - 1, 4, 1, 5];
        var t = init(&buf, &values);
        update(&t, 4, 0 - 1);
        values[4] = 0 - 1;
        update(&t, 1, 6);
        values[1] = 6;
        return buf[1] == 13 and buf[9] == 6 and buf[2] == 14 and agree(&t, &values) == 15
            and query(&t, 0, 4) == 13 and query(&t, 4, 4) == 0 - 1;
    }

    // sizes and the one-value tree
    fn edges_ok() -> bool {
        const pows = pow2_at_least(0) == 1 and pow2_at_least(1) == 1 and pow2_at_least(4) == 4
            and pow2_at_least(5) == 8 and pow2_at_least(9) == 16;
        var b16 : [16]i64 = [0] ** 16;
        var b15 : [15]i64 = [0] ** 15;
        const sized = fits(&b16, 8) and !fits(&b15, 8) and !fits(&b16, 9);
        var two : [2]i64 = [0] ** 2;
        const one : [1]i64 = [7];
        var t = init(&two, &one);
        const single = t.size == 1 and query(&t, 0, 0) == 7;
        update(&t, 0, 0 - 4);
        return pows and sized and single and query(&t, 0, 0) == 0 - 4;
    }

    test build_pads_to_a_power_of_two
        given result = build_ok()
        when expected = true
        then result == expected

    test update_keeps_every_range_sum
        given result = update_ok()
        when expected = true
        then result == expected

    test sizes_and_single_value
        given result = edges_ok()
        when expected = true
        then result == expected
