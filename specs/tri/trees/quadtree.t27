    pub const Rect = struct {
        x : f64,
        y : f64,
        width : f64,
        height : f64,
    };

    pub const QuadNode = struct {
        boundary : Rect,
        children : [4]?QuadNode,
        points : [][2]f64,
        divided : bool,
        allocator : std.mem.Allocator,
    };

    pub const QuadTree = struct {
        root : ?QuadNode,
        capacity : usize,
        allocator : std.mem.Allocator,
    };

