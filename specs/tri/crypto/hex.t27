// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Every byte becomes 2 chars | φ² + 1/φ² = 3 | TRINITY

module TriHex;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Hex = struct {
        uppercase : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // lower_case() → Hex
    fn lower_case() -> Hex {
        Hex{ .uppercase = false }
    }

    // upper_case() → Hex
    fn upper_case() -> Hex {
        Hex{ .uppercase = true }
    }

    // encode(codec: Hex, input: []const u8, allocator: std.mem.Allocator) -> ![]const u8
    fn encode(codec: Hex, input: []const u8, allocator: std.mem.Allocator) -> ![]const u8 {
        const output = allocator.alloc(u8, input.len * 2) catch return error.OutOfMemory;
        var i: usize = 0;
        while (i < input.len) : (i += 1) {
            const byte = input[i];
            const hi = (byte >> 4) & 0x0F;
            const lo = byte & 0x0F;
            output[i * 2] = nibble_to_char(codec, hi);
            output[i * 2 + 1] = nibble_to_char(codec, lo);
        }
        return output;
    }

    // decode(input: []const u8, allocator: std.mem.Allocator) -> ![]const u8
    fn decode(input: []const u8, allocator: std.mem.Allocator) -> ![]const u8 {
        if (input.len % 2 != 0) {
            return error.InvalidHexLength;
        }
        const output = allocator.alloc(u8, input.len / 2) catch return error.OutOfMemory;
        var i: usize = 0;
        while (i < input.len) : (i += 2) {
            const hi = char_to_nibble(input[i]);
            const lo = char_to_nibble(input[i + 1]);
            output[i / 2] = (hi << 4) | lo;
        }
        return output;
    }

    // Private helper functions
    fn nibble_to_char(codec: Hex, nibble: u8) -> u8 {
        if (nibble < 10) {
            return '0' + nibble;
        } else if (codec.uppercase) {
            return 'A' + (nibble - 10);
        } else {
            return 'a' + (nibble - 10);
        }
    }

    fn char_to_nibble(c: u8) -> u8 {
        if (c >= '0' and c <= '9') {
            return c - '0';
        } else if (c >= 'a' and c <= 'f') {
            return c - 'a' + 10;
        } else if (c >= 'A' and c <= 'F') {
            return c - 'A' + 10;
        } else {
            return 0xFF; // Invalid character
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test hex_codec_records_its_letter_case
        given lower = Hex{.uppercase=false}
        and upper = Hex{.uppercase=true}
        then !lower.uppercase
        and upper.uppercase

    test hex_the_two_codecs_are_distinguishable
        given lower = Hex{.uppercase=false}
        and upper = Hex{.uppercase=true}
        then lower.uppercase != upper.uppercase

    test lower_case_returns_lowercase_codec
        given codec = lower_case()
        then !codec.uppercase

    test upper_case_returns_uppercase_codec
        given codec = upper_case()
        then codec.uppercase

    test encode_doubles_the_length
        given input = []const u8{ 0x12, 0x34, 0x56 }
        and codec = lower_case()
        when encoded = encode(codec, input, allocator)
        then encoded.len == input.len * 2

    test decode_inverts_encode_round_trip
        given input = []const u8{ 0x12, 0x34, 0x56 }
        and codec = lower_case()
        when encoded = encode(codec, input, allocator)
        and decoded = decode(encoded, allocator)
        then decoded.len == input.len
        and decoded[0] == input[0]
        and decoded[1] == input[1]
        and decoded[2] == input[2]

    test decode_accepts_both_cases
        given input_lower = []const u8{ 'a', 'b', 'c', 'd' }
        and input_upper = []const u8{ 'A', 'B', 'C', 'D' }
        when decoded_lower = decode(input_lower, allocator)
        and decoded_upper = decode(input_upper, allocator)
        then decoded_lower[0] == 0xAB
        and decoded_lower[1] == 0xCD
        and decoded_upper[0] == 0xAB
        and decoded_upper[1] == 0xCD