// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// RFC 4648 compliant | φ² + 1/φ² = 3 | TRINITY

module TriBase64;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Base64 = struct {
        alphabet : []const u8,
        padding : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // standard() → Base64
    fn standard() -> Base64 {
        return Base64{ .alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", .padding = true };
    }

    // url_safe() → Base64
    fn url_safe() -> Base64 {
        return Base64{ .alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", .padding = false };
    }

    // encode(codec: Base64, input: []const u8, allocator: std.mem.Allocator) → ![]const u8
    fn encode(codec: Base64, input: []const u8, allocator: std.mem.Allocator) -> ![]const u8 {
        var output = allocator.alloc(u8, encoded_length(codec, input.len)) catch return error.OutOfMemory;
        var output_index = 0;
        var input_index = 0;
        
        while (input_index + 2) < input.len : (input_index += 3) {
            var chunk = input[input_index..input_index + 3];
            var triple = @as(u32, chunk[0]) << 16 | @as(u32, chunk[1]) << 8 | chunk[2];
            
            output[output_index + 0] = codec.alphabet[(triple >> 18) & 0x3F];
            output[output_index + 1] = codec.alphabet[(triple >> 12) & 0x3F];
            output[output_index + 2] = codec.alphabet[(triple >> 6) & 0x3F];
            output[output_index + 3] = codec.alphabet[triple & 0x3F];
            output_index += 4;
        }
        
        var remaining = input.len - input_index;
        if (remaining > 0) {
            var triple = @as(u32, input[input_index]) << 16;
            if (remaining > 1) {
                triple |= @as(u32, input[input_index + 1]) << 8;
            }
            if (remaining > 2) {
                triple |= input[input_index + 2];
            }
            
            output[output_index + 0] = codec.alphabet[(triple >> 18) & 0x3F];
            output[output_index + 1] = codec.alphabet[(triple >> 12) & 0x3F];
            if (remaining > 1) {
                output[output_index + 2] = codec.alphabet[(triple >> 6) & 0x3F];
            } else if (codec.padding) {
                output[output_index + 2] = '=';
            }
            if (remaining > 2) {
                output[output_index + 3] = codec.alphabet[triple & 0x3F];
            } else if (codec.padding) {
                output[output_index + 3] = '=';
            }
        }
        
        return output;
    }

    // decode(codec: Base64, input: []const u8, allocator: std.mem.Allocator) -> ![]const u8
    fn decode(codec: Base64, input: []const u8, allocator: std.mem.Allocator) -> ![]const u8 {
        var output = allocator.alloc(u8, decoded_length(input)) catch return error.OutOfMemory;
        var output_index = 0;
        var input_index = 0;
        
        while (input_index + 3) < input.len : (input_index += 4) {
            var chunk = input[input_index..input_index + 4];
            var quad = 0;
            
            for (chunk) |c, i| {
                if (c == '=') {
                    quad <<= (3 - i) * 6;
                } else {
                    var found = false;
                    for (codec.alphabet) |a, j| {
                        if (a == c) {
                            quad |= @as(u32, j) << ((3 - i) * 6);
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        return error.InvalidCharacter;
                    }
                }
            }
            
            output[output_index + 0] = @as(u8, (quad >> 16) & 0xFF);
            output[output_index + 1] = @as(u8, (quad >> 8) & 0xFF);
            output[output_index + 2] = @as(u8, quad & 0xFF);
            output_index += 3;
        }
        
        var remaining = input.len - input_index;
        if (remaining > 0) {
            var quad = 0;
            var padding_count = 0;
            
            for (input[input_index..]) |c, i| {
                if (i >= remaining) break;
                if (c == '=') {
                    padding_count += 1;
                } else {
                    var found = false;
                    for (codec.alphabet) |a, j| {
                        if (a == c) {
                            quad |= @as(u32, j) << ((3 - i) * 6);
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        return error.InvalidCharacter;
                    }
                }
            }
            
            if (remaining == 2) {
                output[output_index + 0] = @as(u8, (quad >> 10) & 0xFF);
            } else if (remaining == 3) {
                output[output_index + 0] = @as(u8, (quad >> 16) & 0xFF);
                output[output_index + 1] = @as(u8, (quad >> 8) & 0xFF);
            }
        }
        
        return output[0..output_index];
    }

    // encoded_length(codec: Base64, input_len: usize) → usize
    fn encoded_length(codec: Base64, input_len: usize) -> usize {
        if (codec.padding) {
            return 4 * ((input_len + 2) / 3);
        } else {
            return (input_len * 4 + 2) / 3;
        }
    }

    // decoded_length(input: []const u8) → !usize
    fn decoded_length(input: []const u8) -> !usize {
        var padding_count = 0;
        for (input) |c| {
            if (c == '=') {
                padding_count += 1;
            }
        }
        
        if (input.len % 4 != 0) {
            return error.InvalidLength;
        }
        
        if (padding_count > 2) {
            return error.InvalidPadding;
        }
        
        return (input.len / 4) * 3 - padding_count;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test standard_basic_case
        given input = default_input()
        when result = standard(input)
        then result != undefined

    test url_safe_basic_case
        given input = default_input()
        when result = url_safe(input)
        then result != undefined

    test encode_basic_case
        given input = default_input()
        when result = encode(input)
        then result != undefined

    test decode_basic_case
        given input = default_input()
        when result = decode(input)
        then result != undefined

    test encoded_length_basic_case
        given input = default_input()
        when result = encoded_length(input)
        then result != undefined

    test decoded_length_basic_case
        given input = default_input()
        when result = decoded_length(input)
        then result != undefined

    test standard_alphabet_and_padding
        given codec = standard()
        then codec.alphabet == "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" and codec.padding == true

    test url_safe_alphabet_holds_sixty_four_symbols
        given codec = url_safe()
        then codec.alphabet.len == 64 and codec.padding == false

    test encoded_length_is_four_characters_per_three_bytes
        given three = 4 * ((3 + 2) / 3)
        and four = 4 * ((4 + 2) / 3)
        then three == 4 and four == 8

    test decoded_length_undoes_encoded_length_on_whole_groups
        given encoded = 4 * ((9 + 2) / 3)
        when decoded = encoded / 4 * 3
        then encoded == 12 and decoded == 9

    test encode_man_example
        given codec = standard()
        and input = "Man"
        when result = encode(codec, input, allocator)
        then result == "TWFu"

    test decode_twfu_example
        given codec = standard()
        and input = "TWFu"
        when result = decode(codec, input, allocator)
        then result == "Man"