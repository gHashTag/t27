// t27/specs/
// Exponential distribution | φ² + 1/φ² = 3 | TRINITY

module TriProbability;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // bernoulli(p: f64, rng: *std.Random.Default) -> bool
    fn bernoulli(p: f64, rng: *std.Random.Default) -> bool {
        if (p < 0.0 or p > 1.0) {
            return false;
        }
        const rand_val = rng.random() % 1000;
        const threshold = @as(usize, @intFromFloat(p * 1000.0));
        return rand_val < threshold;
    }

    // binomial(n: usize, p: f64, rng: *std.Random.Default) -> usize
    fn binomial(n: usize, p: f64, rng: *std.Random.Default) -> usize {
        if (p < 0.0 or p > 1.0) {
            return 0;
        }
        if (n == 0) {
            return 0;
        }
        
        var successes: usize = 0;
        var i: usize = 0;
        while (i < n) : (i += 1) {
            const rand_val = rng.random() % 1000;
            const threshold = @as(usize, @intFromFloat(p * 1000.0));
            if (rand_val < threshold) {
                successes += 1;
            }
        }
        return successes;
    }

    // poisson(lambda: f64, rng: *std.Random.Default) -> usize
    fn poisson(lambda: f64, rng: *std.Random.Default) -> usize {
        if (lambda < 0.0) {
            return 0;
        }
        if (lambda == 0.0) {
            return 0;
        }
        
        // Knuth's algorithm for Poisson generation
        var L = @exp(-lambda);
        var p: f64 = 1.0;
        var k: usize = 0;
        
        while (p > L) {
            k += 1;
            const rand_val = @as(f64, @floatFromInt(rng.random() % 1000000)) / 1000000.0;
            p = p * rand_val;
        }
        return k - 1;
    }

    // normal(mean: f64, std_dev: f64, rng: *std.Random.Default) -> f64
    fn normal(mean: f64, std_dev: f64, rng: *std.Random.Default) -> f64 {
        if (std_dev <= 0.0) {
            return mean;
        }
        
        // Box-Muller transform
        const u1 = @as(f64, @floatFromInt(rng.random() % 1000000)) / 1000000.0;
        const u2 = @as(f64, @floatFromInt(rng.random() % 1000000)) / 1000000.0;
        
        const z0 = @sqrt(-2.0 * @log(u1)) * @cos(2.0 * math::constants.pi * u2);
        return mean + std_dev * z0;
    }

    // exponential(lambda: f64, rng: *std.Random.Default) -> f64
    fn exponential(lambda: f64, rng: *std.Random.Default) -> f64 {
        if (lambda <= 0.0) {
            return 0.0;
        }
        
        const u = @as(f64, @floatFromInt(rng.random() % 1000000)) / 1000000.0;
        return -@log(1.0 - u) / lambda;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "bernoulli_basic_test" {
        const rng = std.Random.Default.init(12345);
        const result = bernoulli(0.5, &rng);
        assert(result == true or result == false);
    }

    test "bernoulli_high_probability_test" {
        const rng = std.Random.Default.init(12345);
        var count: usize = 0;
        var i: usize = 0;
        while (i < 100) : (i += 1) {
            if (bernoulli(0.9, &rng)) {
                count += 1;
            }
        }
        assert(count > 70); // Should be close to 90
    }

    test "bernoulli_low_probability_test" {
        const rng = std.Random.Default.init(12345);
        var count: usize = 0;
        var i: usize = 0;
        while (i < 100) : (i += 1) {
            if (bernoulli(0.1, &rng)) {
                count += 1;
            }
        }
        assert(count < 30); // Should be close to 10
    }

    test "bernoulli_zero_probability_test" {
        const rng = std.Random.Default.init(12345);
        var i: usize = 0;
        while (i < 10) : (i += 1) {
            assert(bernoulli(0.0, &rng) == false);
        }
    }

    test "bernoulli_unit_probability_test" {
        const rng = std.Random.Default.init(12345);
        var i: usize = 0;
        while (i < 10) : (i += 1) {
            assert(bernoulli(1.0, &rng) == true);
        }
    }

    test "binomial_basic_test" {
        const rng = std.Random.Default.init(12345);
        const result = binomial(10, 0.5, &rng);
        assert(result >= 0 and result <= 10);
    }

    test "binomial_zero_trials_test" {
        const rng = std.Random.Default.init(12345);
        const result = binomial(0, 0.5, &rng);
        assert(result == 0);
    }

    test "binomial_zero_probability_test" {
        const rng = std.Random.Default.init(12345);
        const result = binomial(10, 0.0, &rng);
        assert(result == 0);
    }

    test "binomial_unit_probability_test" {
        const rng = std.Random.Default.init(12345);
        const result = binomial(10, 1.0, &rng);
        assert(result == 10);
    }

    test "binomial_expected_value_test" {
        const rng = std.Random.Default.init(12345);
        var sum: usize = 0;
        var i: usize = 0;
        while (i < 1000) : (i += 1) {
            sum += binomial(10, 0.3, &rng);
        }
        const average = @as(f64, @floatFromInt(sum)) / 1000.0;
        assert(@abs(average - 3.0) < 0.5); // Should be close to np = 10 * 0.3 = 3
    }

    test "poisson_basic_test" {
        const rng = std.Random.Default.init(12345);
        const result = poisson(2.0, &rng);
        assert(result >= 0);
    }

    test "poisson_zero_lambda_test" {
        const rng = std.Random.Default.init(12345);
        const result = poisson(0.0, &rng);
        assert(result == 0);
    }

    test "poisson_small_lambda_test" {
        const rng = std.Random.Default.init(12345);
        var sum: usize = 0;
        var i: usize = 0;
        while (i < 1000) : (i += 1) {
            sum += poisson(0.5, &rng);
        }
        const average = @as(f64, @floatFromInt(sum)) / 1000.0;
        assert(@abs(average - 0.5) < 0.3); // Should be close to lambda = 0.5
    }

    test "poisson_large_lambda_test" {
        const rng = std.Random.Default.init(12345);
        var sum: usize = 0;
        var i: usize = 0;
        while (i < 1000) : (i += 1) {
            sum += poisson(5.0, &rng);
        }
        const average = @as(f64, @floatFromInt(sum)) / 1000.0;
        assert(@abs(average - 5.0) < 1.0); // Should be close to lambda = 5.0
    }

    test "normal_basic_test" {
        const rng = std.Random.Default.init(12345);
        const result = normal(0.0, 1.0, &rng);
        assert(@abs(result) < 5.0); // Most values should be within 5 standard deviations
    }

    test "normal_zero_std_dev_test" {
        const rng = std.Random.Default.init(12345);
        const result = normal(5.0, 0.0, &rng);
        assert(@abs(result - 5.0) < 1e-10);
    }

    test "normal_mean_shift_test" {
        const rng = std.Random.Default.init(12345);
        const result1 = normal(0.0, 1.0, &rng);
        const result2 = normal(10.0, 1.0, &rng);
        // The second should be approximately 10 more than the first
        assert(@abs((result2 - result1) - 10.0) < 5.0);
    }

    test "normal_std_dev_scale_test" {
        const rng = std.Random.Default.init(12345);
        const result1 = normal(0.0, 1.0, &rng);
        const result2 = normal(0.0, 2.0, &rng);
        // The second should have roughly twice the magnitude
        assert(@abs(result2) > @abs(result1) * 0.5);
    }

    test "normal_expected_value_test" {
        const rng = std.Random.Default.init(12345);
        var sum: f64 = 0.0;
        var i: usize = 0;
        while (i < 1000) : (i += 1) {
            sum += normal(0.0, 1.0, &rng);
        }
        const average = sum / 1000.0;
        assert(@abs(average) < 0.1); // Should be close to mean = 0
    }

    test "exponential_basic_test" {
        const rng = std.Random.Default.init(12345);
        const result = exponential(1.0, &rng);
        assert(result >= 0.0);
    }

    test "exponential_zero_lambda_test" {
        const rng = std.Random.Default.init(12345);
        const result = exponential(0.0, &rng);
        assert(@abs(result - 0.0) < 1e-10);
    }

    test "exponential_positive_values_test" {
        const rng = std.Random.Default.init(12345);
        const result = exponential(2.0, &rng);
        assert(result >= 0.0);
    }

    test "exponential_expected_value_test" {
        const rng = std.Random.Default.init(12345);
        var sum: f64 = 0.0;
        var i: usize = 0;
        while (i < 1000) : (i += 1) {
            sum += exponential(1.0, &rng);
        }
        const average = sum / 1000.0;
        assert(@abs(average - 1.0) < 0.2); // Should be close to 1/lambda = 1.0
    }

    test "exponential_different_lambda_test" {
        const rng = std.Random.Default.init(12345);
        const result1 = exponential(1.0, &rng);
        const result2 = exponential(2.0, &rng);
        // Higher lambda should produce smaller values on average
        assert(result1 > result2 * 0.5);
    }

    test "exponential_range_test" {
        const rng = std.Random.Default.init(12345);
        var i: usize = 0;
        while (i < 100) : (i += 1) {
            const result = exponential(1.0, &rng);
            assert(result >= 0.0);
        }
    }
