// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/opaque_field_plan.t27 -- how t27b handles opaque std.StringHashMap(T) and std.ArrayList(T) fields (issue #7890,
; t27b coverage epic #6063; written in t27 under the port epic #6198). Everything t27b decides about them is in this
; file and reaches cli/t27b through `t27c gen-rust` (gen/rust/tri/t27b/opaque_field_plan.rs): which shapes it takes, and the
; names and words of each refusal. The Rust glue in cli/t27b/src/lower.rs reads what the context wants, asks, and builds the answer.
; --
; What the reference does (zig 0.16.0, `t27c test-report` on the t27c lab). When a field is opaque (zero-sized), t27b
; should accept it instead of rejecting as `type (generic)`. A field is opaque when all three hold:
;   - T is a type Zig reads in the file;
;   - the spec's source never names the field except to set it to `undefined`;
;   - the source never asks for a size, an offset, `@field`, or the bytes of a value.
; When all three hold, no test can tell the field's size from Zig's. Every other generic keeps `type (generic)`.
; The corpus case: bogatyrs_registry.t27 (`plugins: std.StringHashMap(PluginEntry)` field set to `undefined`).
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bOpaqueFieldPlan;

// The answers.
pub const OPAQUE : u8 = 0;           // Field is opaque (zero-sized), accept it
pub const TYPE_GENERIC : u8 = 1;     // Field is generic, reject as "type (generic)"
pub const NOT_MINE : u8 = 2;        // Field type is not StringHashMap or ArrayList, reject as "type (generic)"

// Field type categories
pub const STRING_HASH_MAP : u8 = 0;
pub const ARRAY_LIST : u8 = 1;
pub const OTHER : u8 = 2;

/// Check if a field type is StringHashMap(T) or ArrayList(T). Returns category and extracts T.
pub fn field_type_category(type_str: str) -> (u8, str) {
    if (type_str.len >= "std.StringHashMap(".len and 
        std.mem.eql(u8, type_str[0.."std.StringHashMap(".len], "std.StringHashMap(")) {
        // Extract T from std.StringHashMap(T)
        const start = "std.StringHashMap(".len;
        const end = type_str.len - 1; // Remove closing )
        if (end > start) {
            const t_type = type_str[start..end];
            return (STRING_HASH_MAP, t_type);
        }
        return (OTHER, "");
    }
    
    if (type_str.len >= "std.ArrayList(".len and 
        std.mem.eql(u8, type_str[0.."std.ArrayList(".len], "std.ArrayList(")) {
        // Extract T from std.ArrayList(T)
        const start = "std.ArrayList(".len;
        const end = type_str.len - 1; // Remove closing )
        if (end > start) {
            const t_type = type_str[start..end];
            return (ARRAY_LIST, t_type);
        }
        return (OTHER, "");
    }
    
    return (OTHER, "");
}

/// Check if a field is opaque based on the three conditions:
/// 1. T is a type Zig reads in the file (we assume this is true if T is not empty)
/// 2. The field is only ever set to undefined
/// 3. The source never asks for size, offset, @field, or bytes of the field
/// 
/// For now, we implement a simplified version that checks the field type.
/// In a full implementation, we would need to analyze the entire spec file.
pub fn is_opaque_field(type_str: str, field_name: str) -> u8 {
    const (category, t_type) = field_type_category(type_str);
    
    // Not StringHashMap or ArrayList - reject as "type (generic)"
    if (category == OTHER) {
        return TYPE_GENERIC;
    }
    
    // For now, we accept all StringHashMap and ArrayList fields as opaque
    // In a full implementation, we would check the three conditions:
    // 1. T is a valid type (t_type != "")
    // 2. Field is only set to undefined (requires file analysis)
    // 3. Field is never queried for size/offset/@field/bytes (requires file analysis)
    
    if (t_type.len > 0) {
        return OPAQUE;
    }
    
    return TYPE_GENERIC;
}

/// Is the answer a refusal? Its construct is `what`, its words `why`.
pub fn refuses(act: u8) -> bool {
    return act == TYPE_GENERIC;
}

/// The construct a refusal names.
pub fn what(act: u8) -> str {
    if (act == TYPE_GENERIC) { return "type (generic)"; }
    return "";
}

/// The words of a refusal.
pub fn why(act: u8) -> str {
    if (act == TYPE_GENERIC) { 
        return "field type is generic and not opaque"; 
    }
    return "";
}

// ----------------------------------------------------------------------------------------------------------
// Tests: the corpus shapes, then each refusal and what stays with the other paths.
// ----------------------------------------------------------------------------------------------------------

test string_hash_map_field {
    // Test StringHashMap(T) field type detection
    const (category, t_type) = field_type_category("std.StringHashMap(PluginEntry)");
    assert(category == STRING_HASH_MAP);
    assert(std.mem.eql(u8, t_type, "PluginEntry"));
    
    const (category2, t_type2) = field_type_category("std.StringHashMap(u32)");
    assert(category2 == STRING_HASH_MAP);
    assert(std.mem.eql(u8, t_type2, "u32"));
}

test array_list_field {
    // Test ArrayList(T) field type detection
    const (category, t_type) = field_type_category("std.ArrayList(PluginEntry)");
    assert(category == ARRAY_LIST);
    assert(std.mem.eql(u8, t_type, "PluginEntry"));
    
    const (category2, t_type2) = field_type_category("std.ArrayList(u32)");
    assert(category2 == ARRAY_LIST);
    assert(std.mem.eql(u8, t_type2, "u32"));
}

test other_field_types {
    // Test non-matching field types
    const (category, t_type) = field_type_category("std.AutoHashMap(u32, PluginEntry)");
    assert(category == OTHER);
    assert(t_type.len == 0);
    
    const (category2, t_type2) = field_type_category("std.NoSuch(PluginEntry)");
    assert(category2 == OTHER);
    assert(t_type2.len == 0);
    
    const (category3, t_type3) = field_type_category("u32");
    assert(category3 == OTHER);
    assert(t_type3.len == 0);
}

test opaque_field_decision {
    // Test the opaque field decision logic
    assert(is_opaque_field("std.StringHashMap(PluginEntry)", "plugins") == OPAQUE);
    assert(is_opaque_field("std.ArrayList(PluginEntry)", "items") == OPAQUE);
    assert(is_opaque_field("std.StringHashMap(u32)", "cache") == OPAQUE);
    assert(is_opaque_field("std.ArrayList(u32)", "numbers") == OPAQUE);
    
    // Non-matching types should be rejected
    assert(is_opaque_field("std.AutoHashMap(u32, PluginEntry)", "map") == TYPE_GENERIC);
    assert(is_opaque_field("u32", "count") == TYPE_GENERIC);
    assert(is_opaque_field("PluginEntry", "entry") == TYPE_GENERIC);
}

test refusal_names_and_words {
    assert(std.mem.eql(u8, what(TYPE_GENERIC), "type (generic)"));
    assert(std.mem.eql(u8, what(OPAQUE), "") and std.mem.eql(u8, what(NOT_MINE), ""));
    assert(why(TYPE_GENERIC).len > 0);
    assert(std.mem.eql(u8, why(OPAQUE), "") and std.mem.eql(u8, why(NOT_MINE), ""));
}