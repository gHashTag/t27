// SPDX-License-Identifier: Apache-2.0
; i128_arith.t27 -- conformance spec for t27b (epic #6063, stage 2 of #7915's run-time i128, #8763)
; What specs/tri/t27b/source_text.t27 asks of an i128 at run time, and the edges around it: module
; constants used beside run-time values (a pair constant each), a constant folded from others, annotated
; locals and a reassigned var, `@intCast` of narrower integers, checked `+`, `-` and `*` up to both ends of
; the type, and `@divTrunc` down each path of the division routine t27b calls (one division of words, two
; 32-bit digits, binary long division), with operands of each sign. Every test passes `t27c test-report`;
; t27b must give the same verdict on each, or refuse the file. The traps (overflow of `+ - *`, a zero
; divisor, minInt / -1) fail a test by design, so they are in cli/t27b/tests/i128_traps.t27.
; phi^2 + phi^-2 = 3 | TRINITY

module T27bConformanceI128Arith;

pub const NO_VALUE : i128 = -1;
pub const I128_MAX : i128 = 170141183460469231731687303715884105727;
pub const I128_MIN : i128 = 0 - 170141183460469231731687303715884105727 - 1;
pub const U64_MAX : i128 = 18446744073709551615;
pub const TWO_64 : i128 = 18446744073709551616;
/// Folded from other constants: a pair constant too.
pub const NEAR_MAX : i128 = I128_MAX - 5;

/// An i128 from its high word (signed) and its low word.
fn ia_word(hi: i64, lo: u64) -> i128 {
    const h : i128 = @intCast(hi);
    const l : i128 = @intCast(lo);
    return h * TWO_64 + l;
}

/// A digit's value, as source_text's digit_value: `@intCast` of a u8.
fn ia_digit(c: u8) -> i128 {
    if (c >= 48 and c <= 57) { return @intCast(c - 48); }
    return 99;
}

/// The value of decimal digits, NO_VALUE when one is not a digit or the value passes I128_MAX: source_text's
/// parse_int loop, a var reassigned with `* +` and guarded by `@divTrunc` of a run-time divisor.
fn ia_parse(s: []const u8) -> i128 {
    const base : i128 = ia_digit(49) + 9;
    var v : i128 = 0;
    var i : usize = 0;
    while (i < s.len) {
        const d : i128 = ia_digit(s[i]);
        if (d >= base) { return NO_VALUE; }
        if (v > @divTrunc(I128_MAX - d, base)) { return NO_VALUE; }
        v = v * base + d;
        i = i + 1;
    }
    return v;
}

fn ia_sum(a_hi: i64, a_lo: u64, b_hi: i64, b_lo: u64) -> i128 {
    return ia_word(a_hi, a_lo) + ia_word(b_hi, b_lo);
}

fn ia_difference(a_hi: i64, a_lo: u64, b_hi: i64, b_lo: u64) -> i128 {
    return ia_word(a_hi, a_lo) - ia_word(b_hi, b_lo);
}

fn ia_product(a_hi: i64, a_lo: u64, b_hi: i64, b_lo: u64) -> i128 {
    const a : i128 = ia_word(a_hi, a_lo);
    const b : i128 = ia_word(b_hi, b_lo);
    return a * b;
}

fn ia_quotient(a_hi: i64, a_lo: u64, b_hi: i64, b_lo: u64) -> i128 {
    const a : i128 = ia_word(a_hi, a_lo);
    const b : i128 = ia_word(b_hi, b_lo);
    return @divTrunc(a, b);
}

test module_constants_beside_run_time_values {
    const x : i128 = ia_word(0, 7);
    assert(x != NO_VALUE);
    assert(x <= U64_MAX);
    assert(U64_MAX < TWO_64);
    assert(ia_word(1, 0) == TWO_64);
    assert(ia_word(0, 18446744073709551615) == U64_MAX);
    assert(I128_MAX - x == 170141183460469231731687303715884105720);
    assert(I128_MIN + x == 0 - 170141183460469231731687303715884105721);
    assert(NEAR_MAX + ia_word(0, 5) == I128_MAX);
    assert(NEAR_MAX < I128_MAX);
    assert(ia_word(0 - 9223372036854775808, 0) == I128_MIN);
}

test annotated_locals_and_a_reassigned_var {
    const a : i128 = ia_word(2, 3);
    var v : i128 = a;
    v = v - TWO_64;
    assert(v == TWO_64 + 3);
    v = v * 2 + 1;
    assert(v == 36893488147419103239);
    var w : i128 = 0;
    w = w - 1;
    assert(w == NO_VALUE);
}

test int_cast_of_narrower_integers {
    assert(ia_digit(48) == 0);
    assert(ia_digit(57) == 9);
    assert(ia_digit(65) == 99);
    const k : u32 = 4000000000;
    const n : i64 = -9223372036854775807;
    const wide_k : i128 = @intCast(k);
    const wide_n : i128 = @intCast(n);
    assert(wide_k == 4000000000);
    assert(wide_n - 1 == 0 - 9223372036854775808);
    assert(wide_n < wide_k);
}

test the_parse_loop_of_source_text {
    assert(ia_parse("0") == 0);
    assert(ia_parse("1000000") == 1000000);
    assert(ia_parse("18446744073709551616") == TWO_64);
    assert(ia_parse("170141183460469231731687303715884105727") == I128_MAX);
    assert(ia_parse("170141183460469231731687303715884105728") == NO_VALUE);
    assert(ia_parse("99999999999999999999999999999999999999999") == NO_VALUE);
    assert(ia_parse("12a") == NO_VALUE);
}

test sums_and_differences_up_to_both_ends {
    assert(ia_sum(0, 18446744073709551615, 0, 1) == TWO_64);
    assert(ia_sum(9223372036854775807, 18446744073709551614, 0, 1) == I128_MAX);
    assert(ia_sum(0 - 9223372036854775808, 0, 9223372036854775807, 18446744073709551615) == 0 - 1);
    assert(ia_sum(0 - 1, 18446744073709551615, 0 - 1, 18446744073709551615) == 0 - 2);
    assert(ia_sum(0 - 9223372036854775808, 1, 0 - 1, 18446744073709551615) == I128_MIN);
    assert(ia_difference(0, 0, 0, 1) == 0 - 1);
    assert(ia_difference(1, 0, 0, 1) == U64_MAX);
    assert(ia_difference(0 - 9223372036854775808, 1, 0, 1) == I128_MIN);
    assert(ia_difference(0 - 1, 18446744073709551615, 0 - 9223372036854775808, 0) == I128_MAX);
    assert(ia_difference(9223372036854775807, 18446744073709551615, 9223372036854775807, 18446744073709551615) == 0);
}

test products_with_cross_terms_and_signs {
    assert(ia_product(0, 3, 0, 7) == 21);
    assert(ia_product(0, 18446744073709551615, 0, 9223372036854775807) == 170141183460469231704017187605319778305);
    assert(ia_product(1, 18446744073709551615, 0, 4611686018427387904) == 170141183460469231727075617697456717824);
    assert(ia_product(1, 0, 0, 3) == 55340232221128654848);
    assert(ia_product(0, 3, 1, 0) == 55340232221128654848);
    assert(ia_product(0, 9223372036854775808, 0, 9223372036854775808) == 85070591730234615865843651857942052864);
    assert(ia_product(0 - 1, 0, 0, 9223372036854775808) == I128_MIN);
    assert(ia_product(0 - 9223372036854775808, 0, 0, 1) == I128_MIN);
    assert(ia_product(0 - 1, 18446744073709551615, 9223372036854775807, 18446744073709551615) == 0 - 170141183460469231731687303715884105727);
    assert(ia_product(0 - 1, 18446744073709551614, 0 - 1, 18446744073709551613) == 6);
    assert(ia_product(0, 0, 0 - 9223372036854775808, 0) == 0);
    assert(ia_product(0 - 1, 18446744073709551615, 0, 0) == 0);
    assert(ia_product(1, 1, 0 - 1, 18446744073709551615) == 0 - 18446744073709551617);
}

test division_down_each_path {
    // Both fit 64 bits: one division of words.
    assert(ia_quotient(0, 7, 0, 2) == 3);
    assert(ia_quotient(0 - 1, 18446744073709551609, 0, 2) == 0 - 3);
    assert(ia_quotient(0, 7, 0 - 1, 18446744073709551614) == 0 - 3);
    assert(ia_quotient(0 - 1, 18446744073709551609, 0 - 1, 18446744073709551614) == 3);
    // A divisor of 32 bits: the high word, then two digits.
    assert(ia_quotient(9223372036854775807, 18446744073709551615, 0, 10) == 17014118346046923173168730371588410572);
    assert(ia_quotient(9223372036854775807, 18446744073709551615, 0 - 1, 18446744073709551600) == 0 - 10633823966279326983230456482242756607);
    assert(ia_quotient(1, 0, 0, 4294967295) == 4294967297);
    // A wider divisor: binary long division.
    assert(ia_quotient(9223372036854775807, 18446744073709551615, 1, 0) == 9223372036854775807);
    assert(ia_quotient(9223372036854775807, 18446744073709551615, 0, 18446744073709551615) == 9223372036854775808);
    assert(ia_quotient(9223372036854775807, 18446744073709551615, 4294967296, 7) == 2147483647);
    assert(ia_quotient(0 - 9223372036854775808, 0, 0, 7286977268806824) == 0 - 23348663949973909715360);
    // The least i128 over 1 and over 2, and the greatest over -1.
    assert(ia_quotient(0 - 9223372036854775808, 0, 0, 1) == I128_MIN);
    assert(ia_quotient(0 - 9223372036854775808, 0, 0, 2) == 0 - 85070591730234615865843651857942052864);
    assert(ia_quotient(9223372036854775807, 18446744073709551615, 0 - 1, 18446744073709551615) == 0 - 170141183460469231731687303715884105727);
    assert(ia_quotient(0, 3, 0, 7) == 0);
}

test a_quotient_inside_an_expression_keeps_the_operands_around_it {
    const a : i128 = ia_word(0, 100);
    const b : i128 = ia_word(5, 0);
    assert(a + @divTrunc(b, ia_word(0, 10)) * ia_word(0, 3) == 27670116110564327524);
    assert(b < @divTrunc(I128_MAX - a, ia_word(0, 16)));
    assert(@divTrunc(I128_MAX - a, TWO_64) == 9223372036854775807);
}
