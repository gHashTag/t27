// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/libm_logf.t27 -- `@log`, `@log2` and `@log10` of an f32 against specs/tri/t27b/libm.t27's
; ports of compiler_rt `logf`, `log2f` and `log10f` (gHashTag/t27#7822, part of #7746, a lane of #6063). Every test
; here passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; Under the reference each sweep holds a port (`use tri::t27b::libm;` brings it in) to Zig's builtin, bit for bit:
; `t27c test-report` runs `zig test` without libc, so a run-time `@log` of an f32 is a call of compiler_rt `logf`,
; and so on. Under t27b the builtin is a call of the same port under t27b's reserved name, so the sweeps hold t27b's
; run of the port to itself, and the fixed bits below hold it to the reference's.
; The bits are compared, not the values, so a signed zero, an infinity and a NaN's payload count. A negative operand
; gives `(x - x) / 0.0`: its NaN's bits are the platform's, but the port and Zig's routine make it with the same
; operations on the same machine, so they agree on x86_64 and on aarch64 alike.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceLibmLogf;

use tri::t27b::libm;

// The bits where a port and its builtin differ: 0 for `@log`, 1 for `@log2`, 2 for `@log10`.
fn lf_one(op: u32, x: f32) -> u32 {
    if (op == 0) { return bits_of_f32(t27b_libm_logf(x)) ^ bits_of_f32(@log(x)); }
    if (op == 1) { return bits_of_f32(t27b_libm_log2f(x)) ^ bits_of_f32(@log2(x)); }
    return bits_of_f32(t27b_libm_log10f(x)) ^ bits_of_f32(@log10(x));
}

// Points of the bit patterns start, start + step, .. (n of them) where a port and its builtin differ, over the
// three builtins.
fn lf_misses(start: u32, step: u32, n: u32) -> u32 {
    var misses: u32 = 0;
    var b: u32 = start;
    var i: u32 = 0;
    while (i < n) {
        const x: f32 = f32_of(b);
        var op: u32 = 0;
        while (op < 3) {
            if (lf_one(op, x) != 0) {
                misses = misses + 1;
            }
            op = op + 1;
        }
        b = b + step;
        i = i + 1;
    }
    return misses;
}

fn log_of(x: f32) -> f32 {
    return @log(x);
}

fn log2_of(x: f32) -> f32 {
    return @log2(x);
}

fn log10_of(x: f32) -> f32 {
    return @log10(x);
}

test log_family_agrees_with_zig_on_every_exponent {
    // Both signs, every exponent, the infinities and the NaNs.
    assert(lf_misses(0x00000001, 716851, 3000) == 0);
    assert(lf_misses(0x80000001, 716851, 2990) == 0);
}

test log_family_agrees_near_one_and_on_subnormals {
    // 0.5 .. 2, across the sqrt(2) / 2 and sqrt(2) bands of the reduction, then the subnormals.
    assert(lf_misses(0x3F000000, 5591, 3000) == 0);
    assert(lf_misses(0x3F3504E0, 1, 64) == 0);
    assert(lf_misses(0x3FB504E0, 1, 64) == 0);
    assert(lf_misses(0x00000001, 2796, 3000) == 0);
}

// Points where one ulp of a constant changes the result, found for #7822 by a search of every 17th positive f32
// (125 million points) with a Zig probe on the t27c lab: ln2_lo in `logf` (2017 points), Lg2 (67) and ivln2lo (245)
// in `log2f`, ivln10lo (184) and log10_2lo (317) in `log10f`, and `log10f`'s hi mask (256). Lg3 shows on no such
// point; a search of every positive finite f32 (2139095039 points) found 29 for `logf`, 4 for `log2f` (one mantissa,
// four exponents) and 20 for `log10f`. One ulp of Lg4 changes no result of any of the three on any f32: that search
// found none. The sweeps above step over all of these points.
test log_family_agrees_where_one_ulp_of_a_constant_shows {
    assert(lf_one(0, f32_of(0x0017FABB)) == 0);
    assert(lf_one(0, f32_of(0x00185153)) == 0);
    assert(lf_one(1, f32_of(0x23B667BF)) == 0);
    assert(lf_one(1, f32_of(0x2C3667BF)) == 0);
    assert(lf_one(1, f32_of(0x0247D7F0)) == 0);
    assert(lf_one(1, f32_of(0x02ED071B)) == 0);
    assert(lf_one(2, f32_of(0x06D657EE)) == 0);
    assert(lf_one(2, f32_of(0x0A432E30)) == 0);
    assert(lf_one(2, f32_of(0x0040A570)) == 0);
    assert(lf_one(2, f32_of(0x0178F75C)) == 0);
    assert(lf_one(2, f32_of(0x0E477778)) == 0);
    assert(lf_one(2, f32_of(0x0F399EE6)) == 0);
    assert(lf_one(0, f32_of(0x194097C0)) == 0);
    assert(lf_one(0, f32_of(0x222C8A5C)) == 0);
    assert(lf_one(1, f32_of(0x3EB7811C)) == 0);
    assert(lf_one(1, f32_of(0x3F37811C)) == 0);
    assert(lf_one(2, f32_of(0x0134E380)) == 0);
    assert(lf_one(2, f32_of(0x20B3B523)) == 0);
}

test log_family_gives_the_reference_bits {
    // Measured on the t27c lab, zig 0.16.0. None is correctly rounded: log10(1e-40) is one ulp from -40.
    assert(bits_of_f32(log_of(2.0)) == 0x3F317218);
    assert(bits_of_f32(log_of(10.0)) == 0x40135D8E);
    assert(bits_of_f32(log_of(0.7)) == 0xBEB69E1A);
    assert(bits_of_f32(log2_of(10.0)) == 0x40549A78);
    assert(bits_of_f32(log2_of(3.0)) == 0x3FCAE00D);
    assert(bits_of_f32(log2_of(8.0)) == 0x40400000);
    assert(bits_of_f32(log2_of(f32_of(0x7F7FFFFF))) == 0x43000000);
    assert(bits_of_f32(log10_of(10.0)) == 0x3F800000);
    assert(bits_of_f32(log10_of(2.0)) == 0x3E9A209B);
    assert(bits_of_f32(log10_of(0.001)) == 0xC0400000);
    assert(bits_of_f32(log10_of(f32_of(0x000116C2))) == 0xC2200001);
}

test log_family_at_zero_infinity_and_nan {
    // The ports and the builtins on the points the sweeps miss: the zeros, one, the infinities, a NaN of either sign.
    var op: u32 = 0;
    while (op < 3) {
        assert(lf_one(op, f32_of(0x00000000)) == 0);
        assert(lf_one(op, f32_of(0x80000000)) == 0);
        assert(lf_one(op, f32_of(0x3F800000)) == 0);
        assert(lf_one(op, f32_of(0x7F800000)) == 0);
        assert(lf_one(op, f32_of(0xFF800000)) == 0);
        assert(lf_one(op, f32_of(0x7F800001)) == 0);
        assert(lf_one(op, f32_of(0xFFC00001)) == 0);
        op = op + 1;
    }
    assert(bits_of_f32(log_of(f32_of(0x00000000))) == 0xFF800000);
    assert(bits_of_f32(log_of(f32_of(0x80000000))) == 0xFF800000);
    assert(bits_of_f32(log2_of(f32_of(0x00000000))) == 0xFF800000);
    assert(bits_of_f32(log10_of(f32_of(0x80000000))) == 0xFF800000);
    assert(bits_of_f32(log_of(f32_of(0x7F800000))) == 0x7F800000);
    assert(bits_of_f32(log_of(1.0)) == 0x00000000);
    // +inf and a NaN come back as they are, a signalling NaN too; a negative gives a NaN.
    assert(bits_of_f32(log_of(f32_of(0x7F800001))) == 0x7F800001);
    assert(bits_of_f32(log10_of(f32_of(0x7FC00123))) == 0x7FC00123);
    const a: f32 = log_of(-1.0);
    assert(a != a);
    const b: f32 = log2_of(f32_of(0xFF800000));
    assert(b != b);
    const c: f32 = log10_of(f32_of(0x80000001));
    assert(c != c);
}

// A `@log` Zig folds at compile time gives the run-time bits too (specs/tri/t27b/libm_plan.t27, measured for #7822).
const LF_TEN : f32 = 10.0;

test log_family_of_a_compile_time_operand_has_the_run_time_bits {
    const two: f32 = 2.0;
    assert(@log(two) == log_of(2.0));
    assert(@log2(LF_TEN) == log2_of(10.0));
    assert(@log10(LF_TEN) == log10_of(10.0));
    const least: f32 = 1.0e-45;
    assert(@log(least) == log_of(f32_of(0x00000001)));
}
