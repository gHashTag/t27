// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/param_discard.t27 -- `_ = p;` for a parameter the body does not otherwise read,
; as the reference runs it (gHashTag/t27#6063 lane: StmtAssign(undeclared), the discard `_`). Every test here
; passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; Zig refuses an unused parameter, so a port that keeps one for its interface writes `_ = p;`, and t27c's
; Zig backend prints that as written. The discard does nothing at run time. Zig's AstGen, which runs on
; every fn whether or not a test calls it, refuses the discard when the body also reads the parameter
; ("pointless discard of function parameter").
; Not here (the reference cannot compile them): `_ = p;` next to a read of `p`, and a second `_ = p;`.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceParamDiscard;

struct DiscPair {
    a: i64,
    b: i64,
}

fn triple_first(x: i64, unused: i64) -> i64 {
    _ = unused;
    return x * 3;
}

fn first_of(p: DiscPair, q: DiscPair) -> i64 {
    _ = q;
    return p.a;
}

fn head(s: []const u8, n: usize) -> u8 {
    _ = n;
    return s[0];
}

fn long_enough(s: []const u8, flag: bool) -> bool {
    if (s.len > 2) {
        _ = flag;
    }
    return s.len > 2;
}

fn seven(a: u32, b: u32) -> u32 {
    _ = a;
    _ = b;
    return 7;
}

fn never_called(frame: DiscPair) -> i64 {
    _ = frame;
    return 0;
}

test a_discarded_scalar_parameter_changes_nothing {
    assert(triple_first(5, 100) == 15);
    assert(triple_first(-2, 0) == -6);
}

test a_discarded_struct_parameter_changes_nothing {
    const p = DiscPair { a: 4, b: 9 };
    const q = DiscPair { a: 40, b: 90 };
    assert(first_of(p, q) == 4);
    assert(first_of(q, p) == 40);
}

test a_discarded_parameter_next_to_a_slice {
    assert(head("tri", 99) == 't');
    assert(head("phi", 0) == 'p');
}

test a_discard_inside_a_branch {
    assert(long_enough("trinity", true));
    assert(!long_enough("ab", false));
}

test every_parameter_discarded {
    assert(seven(1, 2) == 7);
    assert(seven(0, 0) + 1 == 8);
}
