// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/carried_allocator.t27 -- a `std.mem.Allocator` that is held and passed on but never
; called, as the reference runs it (gHashTag/t27#7917, a lane of #6063). Every test here passes
; `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; What t27c's Zig backend prints: `std.mem.Allocator` and `std.testing.allocator` as written. Zig's Allocator is
; two words, `ptr` and `vtable`; nothing here opens it, so the test runner's leak check has nothing to find.
; The shapes are the corpus's own: gen_regression.t27 stores the allocator in a struct field from a parameter
; and binds `std.testing.allocator` to a local in each test; claude_md.t27 takes it as a parameter. Then: the
; allocator between two fields that keep their values, passed through and returned, and copied with its struct
; and written again. Every test reads a field a call writes, so each has a runtime assert.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceCarriedAllocator;

const CaSuite = struct {
    count: u32,
    allocator: std.mem.Allocator,
    last: u8,
};

/// gen_regression.t27's RegressionSuite_init: the allocator stored from a parameter.
fn ca_init(allocator: std.mem.Allocator, last: u8) -> CaSuite {
    return CaSuite{ .count = 0, .allocator = allocator, .last = last };
}

/// Passes the allocator back: nothing opens it.
fn ca_pass(allocator: std.mem.Allocator) -> std.mem.Allocator {
    return allocator;
}

fn ca_bump(s: *CaSuite, by: u32) -> void {
    s.count = s.count + by;
}

test held_between_two_fields {
    const allocator = std.testing.allocator;
    var s = ca_init(allocator, 9);
    ca_bump(&s, 5);
    assert(s.count == 5 and s.last == 9);
}

test passed_through_and_returned {
    const a = ca_pass(ca_pass(std.testing.allocator));
    var s = ca_init(a, 200);
    ca_bump(&s, 1);
    assert(s.count == 1);
    assert(s.last == 200);
}

test copied_with_its_struct_and_written_again {
    var s = ca_init(std.testing.allocator, 1);
    var t = s;
    t.allocator = ca_pass(s.allocator);
    ca_bump(&t, 3);
    assert(t.count == 3 and s.count == 0);
    assert(t.last == 1 and s.last == 1);
}
