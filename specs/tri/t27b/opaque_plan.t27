// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/opaque_plan.t27 -- how t27b lowers `anyopaque` and `@ptrFromInt` to an optional pointer (issue #7737,
; t27b coverage epic #6063; written in t27 under the port epic #6198), and a `std.mem.Allocator` it carries but never
; calls (issue #7917), and a `std.ArrayList(T)` or `std.StringHashMap(V)` it carries the same way (issue #8701). Everything t27b decides about them is in this file and reaches cli/t27b through `t27c gen-rust`
; (gen/rust/tri/t27b/opaque_plan.rs): which shapes it takes, and the names and words of each refusal. The Rust glue
; in cli/t27b/src/lower.rs (`lty_in`, `expr_as`, `ptr_from_int`) and lower_float.rs (`std_const`) reads what the
; context wants, asks, and builds the answer.
; --
; What the reference does (zig 0.16.0, `t27c test-report` on the t27c lab; pinned by
; specs/tri/t27b/conformance/opaque_pointer.t27). gen-zig prints all of it as written.
;   - `anyopaque` has no size and alignment 1. Only a pointer to it can be named, passed, stored and compared with
;     null; by value it is a compile error. t27b gives it a struct with no layout: a pointer to it is an ordinary
;     pointer, and anything that needs its size (a dereference) is refused as `type anyopaque`, the name t27b gave
;     every use of it before.
;   - `@ptrFromInt(x)` takes its pointer type from the result location and x as a usize. For an optional pointer,
;     address 0 is `null`. Any other address must be aligned for the pointee, or a Debug build panics, and a
;     non-optional pointer panics on 0. t27b takes an optional pointer to an alignment-1 pointee (anyopaque, u8, bool),
;     where no address traps, and refuses a non-optional pointer and a wider alignment by name: t27b has no such
;     check yet. Any other result type, or any other number of operands, is NOT_MINE: the call stays
;     `ExprCall(@ptrFromInt)`, as before.
; The corpus cases: gen_assertion.t27 (`?*anyopaque` parameters and local, `assertNotNull(@ptrFromInt(0))`) and
; gen_hazard_pointers.t27 (`?*anyopaque` fields and parameter).
;   - `std.mem.Allocator` is Zig's `struct { ptr: *anyopaque, vtable: *const VTable }`, 16 bytes aligned to 8, and
;     `std.testing.allocator` is one over the test runner's leak-checking allocator; gen-zig prints both as written.
;     A spec may hold one (a field, a parameter, a local), copy, pass and return it, and Zig refuses `==` on a
;     struct, so no test can read its bytes. t27b carries it (CARRY): a struct with no fields and Zig's size and
;     alignment, which copies, stores, passes and returns as any struct does. `std.testing.allocator`, its one
;     source, is a fresh one of zero bytes. Nothing opens it: a method call (`alloc`, `free`, `create`, ...) keeps
;     its refusal by name (`ExprCall(method)` or `ExprCall(std.*)`, naming the call), and so does a field read
;     (`.ptr`, `.vtable`): t27b has no testing allocator and no leak check. Any other type name and any other
;     allocator (`std.heap.page_allocator`) is NOT_MINE. Pinned by specs/tri/t27b/conformance/carried_allocator.t27;
;     the corpus cases are gen_regression.t27 (a field, a parameter, `std.testing.allocator` in each test) and
;     claude_md.t27 (parameters and unused locals).
;   - `std.ArrayList(T)` and `std.StringHashMap(V)` are generic: Zig instantiates each with its argument, which must
;     name a type, and the struct it returns has a size that does not depend on it. In a Debug build (the
;     reference's) `std.ArrayList(T)` is `{ items: []T, capacity: usize }`, 24 bytes aligned to 8, and
;     `std.StringHashMap(V)` is a HashMap holding its unmanaged part (a metadata pointer, two u32 counts and a
;     Debug-only safety lock), an allocator and a context of no bytes: 40 bytes aligned to 8 (`@sizeOf` and
;     `@alignOf` under zig 0.16.0 on the t27c lab). t27b carries each as it carries an allocator (CARRY_LIST,
;     CARRY_MAP), after the glue has named its argument (`arg_lo`) as a pointee: an argument t27b cannot name keeps
;     its own refusal. Nothing opens one: `.append`, `.put`, `.items` keep their refusals by name, as the
;     allocator's do. Any other generic (`std.AutoHashMap(K, V)`, `std.ArrayList(u8).Slice`) is NOT_MINE and stays
;     `type (generic)`: t27b has no generics. The corpus cases are claude_md.t27 (`parts: *std.ArrayList(u8)`
;     parameters of fns no test calls) and bogatyrs_registry.t27 (a `plugins: std.StringHashMap(PluginEntry)` field
;     set to `undefined` and never read).
;   - The name a call that no declared fn answers is refused by (`call_what`), the allocator's methods among them:
;     a builtin `@f(..)` and a bare `len(..)` or `expect(..)` as `ExprCall(<name>)`, `assert` in an expression,
;     `Ok`/`Err`/`Some`/`None`, any `std.` path, any other dotted path as a method, the rest as an undeclared fn.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bOpaquePlan;

use tri::t27b::type_text;

// The answers.
pub const OPAQUE : u8 = 0;
pub const REFUSE_BY_VALUE : u8 = 1;
pub const NOT_MINE : u8 = 2;
pub const FROM_INT : u8 = 3;
pub const REFUSE_PLAIN : u8 = 4;
pub const REFUSE_ALIGNED : u8 = 5;
pub const CARRY : u8 = 6;
pub const CARRY_LIST : u8 = 7;
pub const CARRY_MAP : u8 = 8;

// Zig's two words, on the 64-bit targets t27b and the reference run on.
pub const CARRY_SIZE : u32 = 16;
pub const CARRY_ALIGN : u32 = 8;

// Zig's `std.ArrayList(T)` and `std.StringHashMap(V)` in a Debug build, aligned to CARRY_ALIGN.
pub const LIST_SIZE : u32 = 24;
pub const MAP_SIZE : u32 = 40;

// What `@ptrFromInt` is wanted as.
pub const W_OPT_PTR : u8 = 0;
pub const W_PTR : u8 = 1;
pub const W_OTHER : u8 = 2;

/// `anyopaque` where a type is read. by_value: its size is needed there (a field, a parameter, a local, an array
/// element), as opposed to the pointee of a pointer or a slice.
pub fn opaque_type(by_value: bool) -> u8 {
    if (by_value) { return REFUSE_BY_VALUE; }
    return OPAQUE;
}

// Reuse type_text::same rather than another byte-comparison body (#8756).

/// The type named `t` where a type is read, by_value as in opaque_type: OPAQUE or REFUSE_BY_VALUE for
/// `anyopaque`, CARRY for `std.mem.Allocator`, CARRY_LIST for `std.ArrayList(T)`, CARRY_MAP for
/// `std.StringHashMap(V)`, NOT_MINE for any other name.
pub fn named(t: []const u8, by_value: bool) -> u8 {
    if (type_text::same(t, "anyopaque")) { return opaque_type(by_value); }
    if (type_text::same(t, "std.mem.Allocator")) { return CARRY; }
    if (instance(t, "std.ArrayList(")) { return CARRY_LIST; }
    if (instance(t, "std.StringHashMap(")) { return CARRY_MAP; }
    return NOT_MINE;
}

const B_AT : u8 = 64;
const B_DOT : u8 = 46;
const B_LPAREN : u8 = 40;
const B_RPAREN : u8 = 41;

/// Does the text begin with `w`?
fn begins(s: []const u8, w: str) -> bool {
    if (s.len < w.len) { return false; }
    return type_text::same(s[0 .. w.len], w);
}

/// Is the text `head` (which ends in `(`), an argument, and the `)` that closes that `(` as its last byte?
fn instance(t: []const u8, head: str) -> bool {
    if (t.len < head.len + 2 or !begins(t, head)) { return false; }
    var depth : i64 = 1;
    var k : usize = head.len;
    while (k < t.len) {
        if (t[k] == B_LPAREN) { depth = depth + 1; }
        if (t[k] == B_RPAREN) {
            depth = depth - 1;
            if (depth == 0) { return k == t.len - 1; }
        }
        k = k + 1;
    }
    return false;
}

/// Where the argument of a CARRY_LIST or CARRY_MAP type's text begins, after its first `(`; it ends before the
/// last byte.
pub fn arg_lo(t: []const u8) -> usize {
    var k : usize = 0;
    while (k < t.len and t[k] != B_LPAREN) { k = k + 1; }
    return k + 1;
}

/// Is answer `act` a generic instance, whose argument the glue names first?
pub fn generic(act: u8) -> bool {
    return act == CARRY_LIST or act == CARRY_MAP;
}

/// Does answer `act` stand for a struct with no fields that t27b builds, laid out by `size` and `align`?
pub fn has_struct(act: u8) -> bool {
    return act == OPAQUE or act == CARRY or generic(act);
}

/// The construct the struct for answer `act` refuses where its size is needed (a dereference): `type anyopaque`
/// for OPAQUE, in the words of REFUSE_BY_VALUE; "" for a struct that has a size.
pub fn unsized_what(act: u8) -> str {
    if (act == OPAQUE) { return what(REFUSE_BY_VALUE); }
    return "";
}

/// Does the text hold a `.`?
fn dotted(s: []const u8) -> bool {
    var k : usize = 0;
    while (k < s.len) {
        if (s[k] == B_DOT) { return true; }
        k = k + 1;
    }
    return false;
}

/// The construct a call of `name` that no declared fn answers is refused as; "" means `ExprCall(<name>)`.
pub fn call_what(name: []const u8) -> str {
    if (name.len > 0 and name[0] == B_AT) { return ""; }
    if (type_text::same(name, "assert") or type_text::same(name, "assert_eq")) { return "ExprCall(assert in expression)"; }
    if (type_text::same(name, "Ok") or type_text::same(name, "Err") or type_text::same(name, "Some") or type_text::same(name, "None")) {
        return "ExprCall(Result/Option constructor)";
    }
    if (begins(name, "std.")) { return "ExprCall(std.*)"; }
    if (dotted(name)) { return "ExprCall(method)"; }
    if (type_text::same(name, "len") or type_text::same(name, "expect")) { return ""; }
    return "ExprCall(undeclared fn)";
}

/// The size the struct for answer `act` has: Zig's two words for CARRY, Zig's Debug sizes for CARRY_LIST and
/// CARRY_MAP, none (0) for `anyopaque`.
pub fn size(act: u8) -> u32 {
    if (act == CARRY) { return CARRY_SIZE; }
    if (act == CARRY_LIST) { return LIST_SIZE; }
    if (act == CARRY_MAP) { return MAP_SIZE; }
    return 0;
}

/// The alignment the struct for answer `act` has.
pub fn align(act: u8) -> u32 {
    if (act == CARRY or generic(act)) { return CARRY_ALIGN; }
    return 1;
}

/// `std.<ns>.<name>` read as a value: CARRY for `std.testing.allocator`, the one source of a carried allocator,
/// whose type is `carried_type`; NOT_MINE for any other.
pub fn std_value(ns: []const u8, name: []const u8) -> u8 {
    if (type_text::same(ns, "testing") and type_text::same(name, "allocator")) { return CARRY; }
    return NOT_MINE;
}

/// The type a carried value has.
pub fn carried_type() -> str {
    return "std.mem.Allocator";
}

/// `@ptrFromInt(...)`. want: W_OPT_PTR, W_PTR or W_OTHER. align: the pointee's alignment in bytes. args: how many
/// operands the call has.
pub fn from_int(want: u8, align: u32, args: usize) -> u8 {
    if (want == W_OTHER or args != 1) { return NOT_MINE; }
    if (want == W_PTR) { return REFUSE_PLAIN; }
    if (align > 1) { return REFUSE_ALIGNED; }
    return FROM_INT;
}

/// Is the answer a refusal? Its construct is `what`, its words `why`.
pub fn refuses(act: u8) -> bool {
    return act == REFUSE_BY_VALUE or act == REFUSE_PLAIN or act == REFUSE_ALIGNED;
}

/// The construct a refusal names.
pub fn what(act: u8) -> str {
    if (act == REFUSE_BY_VALUE) { return "type anyopaque"; }
    if (act == REFUSE_PLAIN or act == REFUSE_ALIGNED) { return "ExprCall(@ptrFromInt)"; }
    return "";
}

/// The words of a refusal.
pub fn why(act: u8) -> str {
    if (act == REFUSE_BY_VALUE) { return "`anyopaque` has no size: only a pointer to it can be used"; }
    if (act == REFUSE_PLAIN) {
        return "to a pointer that is not optional (Zig panics on address 0, which t27b does not check yet)";
    }
    if (act == REFUSE_ALIGNED) {
        return "to a pointer whose pointee is aligned to more than 1 byte (Zig panics on a misaligned address, which t27b does not check yet)";
    }
    return "";
}

// ----------------------------------------------------------------------------------------------------------
// Tests: the corpus shapes, then each refusal and what stays with the other paths.
// ----------------------------------------------------------------------------------------------------------

test anyopaque_is_a_pointee_only {
    // gen_hazard_pointers.t27's `pointer: ?*anyopaque`; a field of type `anyopaque` is a compile error.
    assert(opaque_type(false) == OPAQUE);
    assert(opaque_type(true) == REFUSE_BY_VALUE);
    assert(!refuses(OPAQUE) and refuses(REFUSE_BY_VALUE));
}

test from_int_to_an_optional_opaque_pointer {
    // gen_assertion.t27's `assertNotNull(@ptrFromInt(1))` into `ptr: ?*anyopaque`.
    assert(from_int(W_OPT_PTR, 1, 1) == FROM_INT);
    assert(!refuses(FROM_INT));
}

test from_int_refusals {
    assert(from_int(W_PTR, 1, 1) == REFUSE_PLAIN);
    assert(from_int(W_PTR, 8, 1) == REFUSE_PLAIN);
    assert(from_int(W_OPT_PTR, 2, 1) == REFUSE_ALIGNED);
    assert(from_int(W_OPT_PTR, 8, 1) == REFUSE_ALIGNED);
    assert(refuses(REFUSE_PLAIN) and refuses(REFUSE_ALIGNED));
}

test from_int_not_mine {
    // No pointer wanted, or not exactly one operand: the call stays ExprCall(@ptrFromInt).
    assert(from_int(W_OTHER, 1, 1) == NOT_MINE);
    assert(from_int(W_OPT_PTR, 1, 0) == NOT_MINE);
    assert(from_int(W_OPT_PTR, 1, 2) == NOT_MINE);
    assert(from_int(W_PTR, 8, 2) == NOT_MINE);
    assert(!refuses(NOT_MINE));
}

test refusal_names_and_words {
    assert(std.mem.eql(u8, what(REFUSE_BY_VALUE), "type anyopaque"));
    assert(std.mem.eql(u8, what(REFUSE_PLAIN), "ExprCall(@ptrFromInt)"));
    assert(std.mem.eql(u8, what(REFUSE_ALIGNED), "ExprCall(@ptrFromInt)"));
    assert(std.mem.eql(u8, what(FROM_INT), "") and std.mem.eql(u8, what(OPAQUE), ""));
    assert(why(REFUSE_BY_VALUE).len > 0);
    assert(!std.mem.eql(u8, why(REFUSE_PLAIN), why(REFUSE_ALIGNED)));
    assert(std.mem.eql(u8, why(NOT_MINE), ""));
}

test an_allocator_is_carried {
    // gen_regression.t27's `allocator: std.mem.Allocator` field and parameter; claude_md.t27's parameters.
    assert(named("std.mem.Allocator", true) == CARRY);
    assert(named("std.mem.Allocator", false) == CARRY);
    assert(size(CARRY) == 16 and align(CARRY) == 8);
    assert(!refuses(CARRY));
    assert(std.mem.eql(u8, what(CARRY), "") and std.mem.eql(u8, why(CARRY), ""));
}

test anyopaque_keeps_its_answers {
    assert(named("anyopaque", false) == OPAQUE);
    assert(named("anyopaque", true) == REFUSE_BY_VALUE);
    assert(size(OPAQUE) == 0 and align(OPAQUE) == 1);
}

test other_names_are_not_mine {
    assert(named("std.mem", false) == NOT_MINE);
    assert(named("std.mem.Allocatorx", false) == NOT_MINE);
    assert(named("Allocator", true) == NOT_MINE);
    assert(named("std.heap.ArenaAllocator", true) == NOT_MINE);
    assert(named("", false) == NOT_MINE);
}

test std_testing_allocator_is_the_one_source {
    // `const allocator = std.testing.allocator;` in each test of gen_regression.t27 and claude_md.t27.
    assert(std_value("testing", "allocator") == CARRY);
    assert(named(carried_type(), true) == CARRY);
    assert(std_value("heap", "page_allocator") == NOT_MINE);
    assert(std_value("testing", "allocatorx") == NOT_MINE);
    assert(std_value("testing", "expect") == NOT_MINE);
    assert(std_value("math", "pi") == NOT_MINE);
}

test a_call_on_a_carried_allocator_keeps_its_refusal {
    assert(std.mem.eql(u8, call_what("allocator.alloc"), "ExprCall(method)"));
    assert(std.mem.eql(u8, call_what("suite.allocator.free"), "ExprCall(method)"));
    assert(std.mem.eql(u8, call_what("std.testing.allocator.create"), "ExprCall(std.*)"));
}

test call_refusal_names {
    assert(std.mem.eql(u8, call_what("@foo"), ""));
    assert(std.mem.eql(u8, call_what("@"), ""));
    assert(std.mem.eql(u8, call_what("len"), "") and std.mem.eql(u8, call_what("expect"), ""));
    assert(std.mem.eql(u8, call_what("assert"), "ExprCall(assert in expression)"));
    assert(std.mem.eql(u8, call_what("assert_eq"), "ExprCall(assert in expression)"));
    assert(std.mem.eql(u8, call_what("Ok"), "ExprCall(Result/Option constructor)"));
    assert(std.mem.eql(u8, call_what("None"), "ExprCall(Result/Option constructor)"));
    assert(std.mem.eql(u8, call_what("std.debug.print"), "ExprCall(std.*)"));
    assert(std.mem.eql(u8, call_what("std"), "ExprCall(undeclared fn)"));
    assert(std.mem.eql(u8, call_what("list.append"), "ExprCall(method)"));
    assert(std.mem.eql(u8, call_what("lenx"), "ExprCall(undeclared fn)"));
    assert(std.mem.eql(u8, call_what(""), "ExprCall(undeclared fn)"));
}

test a_list_and_a_string_map_are_carried {
    // claude_md.t27's `parts: *std.ArrayList(u8)`; bogatyrs_registry.t27's `plugins: std.StringHashMap(PluginEntry)`.
    assert(named("std.ArrayList(u8)", false) == CARRY_LIST);
    assert(named("std.ArrayList(u8)", true) == CARRY_LIST);
    assert(named("std.StringHashMap(PluginEntry)", true) == CARRY_MAP);
    assert(named("std.ArrayList(std.ArrayList(u8))", true) == CARRY_LIST);
    assert(size(CARRY_LIST) == 24 and align(CARRY_LIST) == 8);
    assert(size(CARRY_MAP) == 40 and align(CARRY_MAP) == 8);
    assert(!refuses(CARRY_LIST) and !refuses(CARRY_MAP));
    assert(std.mem.eql(u8, what(CARRY_MAP), "") and std.mem.eql(u8, why(CARRY_LIST), ""));
}

test the_argument_is_named_first {
    assert(arg_lo("std.ArrayList(u8)") == 14);
    assert(arg_lo("std.StringHashMap(PluginEntry)") == 18);
    assert(generic(CARRY_LIST) and generic(CARRY_MAP));
    assert(!generic(CARRY) and !generic(OPAQUE) and !generic(NOT_MINE));
}

test a_struct_stands_for_each_carried_or_opaque_name {
    assert(has_struct(OPAQUE) and has_struct(CARRY) and has_struct(CARRY_LIST) and has_struct(CARRY_MAP));
    assert(!has_struct(NOT_MINE) and !has_struct(REFUSE_BY_VALUE) and !has_struct(FROM_INT));
    assert(std.mem.eql(u8, unsized_what(OPAQUE), "type anyopaque"));
    assert(std.mem.eql(u8, unsized_what(CARRY), "") and std.mem.eql(u8, unsized_what(CARRY_LIST), ""));
    assert(std.mem.eql(u8, unsized_what(CARRY_MAP), ""));
}

test other_generics_are_not_mine {
    assert(named("std.ArrayList()", true) == NOT_MINE);
    assert(named("std.ArrayList(u8", true) == NOT_MINE);
    assert(named("std.ArrayList(u8).Slice", true) == NOT_MINE);
    assert(named("std.ArrayList(u8)(u8)", false) == NOT_MINE);
    assert(named("std.ArrayListUnmanaged(u8)", true) == NOT_MINE);
    assert(named("std.AutoHashMap(u32, u8)", true) == NOT_MINE);
    assert(named("ArrayList(u8)", true) == NOT_MINE);
}
