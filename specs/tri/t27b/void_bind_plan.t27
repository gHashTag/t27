// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/void_bind_plan.t27 -- how t27b lowers a local bound to the result of a void fn,
; `when result = f(x)` or `const result = f(x);`, and a comparison of such a local with `undefined`
; (issue #7690, t27b coverage epic #6063; written in t27 under the port epic #6198).
; Everything t27b decides about these two shapes is in this file and reaches cli/t27b through `t27c gen-rust`
; (gen/rust/tri/t27b/void_bind_plan.rs). The Rust glue in cli/t27b/src/lower.rs only reads the shape, asks
; `bind` or `compare`, and builds the answer: the call as a statement and a name bound to a zero-bit value,
; or a constant bool.
; --
; What the reference does (zig 0.16.0, the default x86_64 Debug backend `t27c test-report` builds with;
; measured on the t27c lab and pinned by specs/tri/t27b/conformance/void_bind.t27):
;   - t27c's Zig backend prints the local as written, `const result = f(x);` (or `var result = f(x);` and
;     `_ = &result;`), and adds `_ = result; // dead after const-inlining` when nothing reads it. Zig accepts
;     it: `void` is a value. The call runs once, for its effects, in statement order.
;   - The local's one value is void's. `result == undefined` is comptime true and `result != undefined` is
;     comptime false, either way round; `t27c test-report`'s counter does not count an assert of either,
;     as its operands are comptime-known. The corpus asserts `result == undefined` after a void call
;     (specs/port/browseros/.../browser/history.t27, specs/port/scripts/gen_w381_lean.t27).
;   - The local can be passed on where a `void` parameter is declared.
; --
; What t27b does. A local with no type whose initializer is a call of a declared fn with no result (BIND):
; the call is lowered as the statement `f(x);` is, and the name is bound to a value of t27b's `void`, the
; struct with no fields (#7267). A name bound to a `void` value compared with `undefined` by `==` or `!=`
; folds to the constant Zig gives (FOLD_TRUE, FOLD_FALSE). Every other read of the name goes on to t27b's
; other paths, which take what they lower for a `void` (an argument for a `void` parameter) and refuse the
; rest by their own names (a `void` in a condition, in arithmetic, compared with anything but `undefined`).
; Not taken (NOT_MINE): a local that names its type, `const r: void = f(x);`, which no corpus spec writes;
; a call whose signature was not lowered; a comparison whose other side is not a name (a call there runs
; for its effects, and the void fn's refusal names it). Those keep their refusals.
; --
; `?void` (issue #8694). What the reference does (zig 0.16.0 on the t27c lab, the default x86_64 backend and
; -fllvm alike; pinned by specs/tri/t27b/conformance/opt_void.t27): an optional with a zero-bit payload is one
; flag byte, `@sizeOf(?void) == 1`. gen-zig prints `?void`, `return null;` and `return undefined;` as written.
; `null` writes the flag 0. `undefined` is the Debug build's fill byte 0xAA, and a flag that is not 0 reads as
; non-null: `x != null` is true, `x == null` is false (see #7877 for ReleaseFast, which writes no fill; the
; reference is the Debug build). t27b's optional over its `void` is already that byte: a zero-size payload,
; then the flag at offset 0. t27b keeps a flag 0 or 1, so `undefined` written to a `?void` sets the flag
; (SET_FLAG), which every read of it sees as Zig's Debug build sees 0xAA. An optional with a payload written
; with `undefined` keeps what its memory held (LEAVE), as before. The corpus case is gen_websocket.t27.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bVoidBindPlan;

// The answer.
pub const NOT_MINE : u8 = 0;
pub const BIND : u8 = 1;
pub const FOLD_TRUE : u8 = 2;
pub const FOLD_FALSE : u8 = 3;
pub const LEAVE : u8 = 4;
pub const SET_FLAG : u8 = 5;

/// A local's initializer. void_call: it is a call of a fn whose signature t27b lowered with no result.
/// typed: the local names its type. BIND: the call is a statement and the name is void's one value.
pub fn bind(void_call: bool, typed: bool) -> u8 {
    if (!void_call) { return NOT_MINE; }
    if (typed) { return NOT_MINE; }
    return BIND;
}

/// `a == b` or `a != b` where one side is `undefined`. eq: the operator is `==`. ne: it is `!=`.
/// void_name: the other side is a name bound to a `void` value, so reading it runs nothing.
pub fn compare(eq: bool, ne: bool, void_name: bool) -> u8 {
    if (!void_name) { return NOT_MINE; }
    if (eq) { return FOLD_TRUE; }
    if (ne) { return FOLD_FALSE; }
    return NOT_MINE;
}

/// The bool a fold gives.
pub fn folded(act: u8) -> bool {
    return act == FOLD_TRUE;
}

/// `undefined` written to an optional. void_payload: the payload is t27b's `void`, so the flag is the whole value.
pub fn undefined_optional(void_payload: bool) -> u8 {
    if (void_payload) { return SET_FLAG; }
    return LEAVE;
}

// ----------------------------------------------------------------------------------------------------------
// Tests: the shapes the corpus has, then what is left alone.
// ----------------------------------------------------------------------------------------------------------

test a_void_call_with_no_type_is_bound {
    // graph.t27's `when result = add_node(&graph)`, history.t27's `const result = deleteUrl(cdp, url);`,
    // gen_w381_lean.t27's `var result = main();`.
    assert(bind(true, false) == BIND);
}

test a_typed_local_or_a_call_with_a_result_is_left_alone {
    assert(bind(true, true) == NOT_MINE);
    assert(bind(false, false) == NOT_MINE);
    assert(bind(false, true) == NOT_MINE);
}

test void_against_undefined_folds_as_zig_does {
    // `assert(result == undefined)` passes; `result != undefined` is false.
    assert(compare(true, false, true) == FOLD_TRUE);
    assert(compare(false, true, true) == FOLD_FALSE);
    assert(folded(compare(true, false, true)));
    assert(!folded(compare(false, true, true)));
}

test only_a_void_name_and_only_equality_fold {
    assert(compare(true, false, false) == NOT_MINE);
    assert(compare(false, true, false) == NOT_MINE);
    assert(compare(false, false, true) == NOT_MINE);
    assert(compare(false, false, false) == NOT_MINE);
    assert(!folded(NOT_MINE));
    assert(!folded(BIND));
}

test an_undefined_opt_void_reads_as_non_null {
    // gen_websocket.t27's `return undefined;` from a `-> ?void` fn: Zig's 0xAA, a set flag.
    assert(undefined_optional(true) == SET_FLAG);
    assert(undefined_optional(false) == LEAVE);
    assert(SET_FLAG != LEAVE and SET_FLAG != NOT_MINE and LEAVE != BIND);
}
