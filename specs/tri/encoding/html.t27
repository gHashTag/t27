// SPDX-License-Identifier: Apache-2.0
// t27/specs/tri/encoding/html.t27
// HTML5 subset | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_html.tri. The port's parse
// and query_selector ignored their arguments and returned nothing, HtmlNode
// had quoted types, and the tests asserted `result != undefined` and
// `then true`. The .tri: HtmlNode { tag, attributes:
// std.StringHashMap([]const u8), children: []HtmlNode, inner_text };
// parse(html, allocator) -> !HtmlNode, "Parse HTML document";
// querySelector(node, selector) -> ?HtmlNode, "Find element by CSS
// selector"; behaviour subset, "HTML5 subset", note "Common elements only".
// Without an allocator the tree stays in the caller's bytes: parse(text)
// returns the document as an HtmlNode with an empty tag (end NONE when text
// is outside the subset), and an element is an HtmlNode holding its tag as
// written, where its start tag begins, where its content begins and ends,
// and where it ends. The .tri's attributes, children and inner_text are
// reached through it: attribute(text, node, name) finds an attribute (names
// ignore ASCII case) and value() decodes it, children() and child() walk
// the child elements, and inner_text() writes the textContent.
// query_selector(text, node, selector) is querySelector: the first element
// inside node, in document order, that a selector list matches, end NONE
// when none does or the selector is outside the subset.
// The subset is the set of documents on which the HTML5 tree is the tree of
// the tags as written, so no element is opened, closed or moved that the
// text does not open, close or place. parse refuses, beyond what HTML5
// itself calls a parse error: a non-void element without its end tag (HTML5
// lets </p>, </li> and others be left out); "/>" on a non-void element
// (HTML5 ignores the slash, html.parser closes the element); a start tag
// HTML5 would close an open element for (a p-closing element such as div,
// ul or h1 while a p is open; li inside an open li, dd or dt inside an open
// dd or dt, with no list between; a heading inside a heading; a, button or
// form inside the same); a line feed or carriage return right after <pre>,
// <listing> or <textarea> (HTML5 drops it, html.parser keeps it); "<!--"
// inside script; elements whose rules are not ordinary (tables, select and
// option, ruby annotations, frames, template, object, svg, math, iframe,
// noscript, nobr, image, xmp, plaintext and the like); html anywhere but as
// the first top-level item, head and body anywhere but as the children of
// html (head first; both written), and in html or head any text but white
// space or anything that does not belong there; a character reference
// without its ";" or naming anything but amp, lt, gt, quot, apos and nbsp
// (html.parser knows 2231 names), or a numeric one HTML5 replaces or calls
// a parse error (controls, surrogates, noncharacters; it keeps the last
// two in the text); a "<!"
// or "<?" that is not a comment or <!DOCTYPE html>; a comment that HTML5
// ends early ("<!-->", "<!--->", "--!>"); control bytes; duplicate
// attributes; an attribute without white space before it; an unquoted
// value holding " ' = < or ` (or empty); a tag name with characters other
// than letters, digits and "-"; and nesting deeper than MAX_DEPTH. A "<"
// that cannot start markup is text, as in HTML5. The tree differs from a
// browser's in two declared ways: the html, head and body elements HTML5
// implies when they are not written are not made, and white space HTML5
// drops or moves stays where it is written (white space before the first
// element or text, and directly inside html, which HTML5 drops before head
// and moves into body after </body>). Line ends are normalised as in HTML5.
// query_selector takes type, universal, #id and .class selectors joined by
// descendant (white space) and child (">") combinators, in a list split by
// ","; identifiers are ASCII without escapes. It compares id and class as
// in no-quirks mode (a document with <!DOCTYPE html>; quirks mode ignores
// their ASCII case), and an id or class attribute decoding to more than
// MAX_VALUE bytes never matches. NOT CHECKED: that bytes 128 and up are
// valid UTF-8. The oracles: html5lib's tree (a body-context fragment when
// html is not written), its textContent, and soupsieve's select_one on it.

module TriHtml;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    // an element: its start tag begins at at, its content is
    // text[content_at .. content_end], and it ends before end
    pub const HtmlNode = struct {
        tag : []const u8,
        at : usize,
        content_at : usize,
        content_end : usize,
        end : usize,
    };

    // one markup or text item: a tag name text[name_at .. name_end], and
    // the text of a comment or a raw text or RCDATA element at
    // text[body_at .. body_end]
    pub const Token = struct {
        kind : usize,
        name_at : usize,
        name_end : usize,
        body_at : usize,
        body_end : usize,
        end : usize,
    };

    pub const Attr = struct {
        name_at : usize,
        name_end : usize,
        value_at : usize,
        value_end : usize,
        end : usize,
    };

    pub const Ref = struct {
        code : u64,
        end : usize,
    };

    pub const NONE : usize = 18446744073709551615;
    pub const MAX_DEPTH : usize = 128;
    pub const MAX_PARTS : usize = 16;
    pub const MAX_VALUE : usize = 256;

    pub const TEXT : usize = 0;
    pub const START : usize = 1;
    pub const VOID : usize = 2;
    pub const END : usize = 3;
    pub const COMMENT : usize = 4;
    pub const DOCTYPE : usize = 5;
    pub const RAW : usize = 6;
    pub const RCDATA : usize = 7;
    pub const BAD : usize = 8;

    pub const VOIDS : []const u8 = "area base br embed hr img input link meta source track wbr";
    pub const REFUSED : []const u8 = "applet basefont bgsound caption col colgroup frame frameset iframe image keygen marquee math nobr noembed noframes noscript object optgroup option param plaintext rb rp rt rtc select selectedcontent svg table tbody td template tfoot th thead tr xmp";
    pub const P_CLOSERS : []const u8 = "address article aside blockquote center details dialog dir div dl dd dt fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6 header hgroup hr li listing main menu nav ol p pre search section summary ul";
    pub const HEADINGS : []const u8 = "h1 h2 h3 h4 h5 h6";
    pub const HEAD_CONTENT : []const u8 = "base link meta script style title";

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn bad_token() -> Token {
        return Token{ .kind = BAD, .name_at = 0, .name_end = 0, .body_at = 0, .body_end = 0, .end = NONE };
    }

    fn bad_attr() -> Attr {
        return Attr{ .name_at = 0, .name_end = 0, .value_at = 0, .value_end = 0, .end = NONE };
    }

    fn bad_node() -> HtmlNode {
        return HtmlNode{ .tag = "", .at = 0, .content_at = 0, .content_end = 0, .end = NONE };
    }

    fn is_space(c: u8) -> bool {
        return c == 32 or c == 9 or c == 10 or c == 12 or c == 13;
    }

    fn is_digit(c: u8) -> bool {
        return c >= 48 and c <= 57;
    }

    fn is_alpha(c: u8) -> bool {
        return (c >= 65 and c <= 90) or (c >= 97 and c <= 122);
    }

    fn tag_char(c: u8) -> bool {
        return is_alpha(c) or is_digit(c) or c == 45;
    }

    fn attr_start(c: u8) -> bool {
        return is_alpha(c) or c == 95 or c == 58;
    }

    fn attr_char(c: u8) -> bool {
        return attr_start(c) or is_digit(c) or c == 45 or c == 46;
    }

    // a byte the subset allows; bytes 128 and up are taken as UTF-8 unchecked
    fn char_ok(c: u8) -> bool {
        return (c >= 32 and c != 127) or c == 9 or c == 10 or c == 12 or c == 13;
    }

    fn lower(c: u8) -> u8 {
        if (c >= 65 and c <= 90) {
            return c + 32;
        }
        return c;
    }

    fn same(a: []const u8, b: []const u8) -> bool {
        if (a.len != b.len) {
            return false;
        }
        var i : usize = 0;
        while (i < a.len) {
            if (a[i] != b[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // a and b equal ignoring ASCII case
    fn same_ci(a: []const u8, b: []const u8) -> bool {
        if (a.len != b.len) {
            return false;
        }
        var i : usize = 0;
        while (i < a.len) {
            if (lower(a[i]) != lower(b[i])) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // name is one of the space-separated words of list, ignoring ASCII case
    fn listed(name: []const u8, list: []const u8) -> bool {
        var a : usize = 0;
        while (a < list.len) {
            var b = a;
            while (b < list.len and list[b] != 32) {
                b = b + 1;
            }
            if (same_ci(name, list[a .. b])) {
                return true;
            }
            a = b + 1;
        }
        return false;
    }

    fn starts_ci(text: []const u8, at: usize, s: []const u8) -> bool {
        if (at > text.len or text.len - at < s.len) {
            return false;
        }
        return same_ci(text[at .. at + s.len], s);
    }

    // the first position at or after at where s begins, NONE if none
    fn find(text: []const u8, at: usize, s: []const u8) -> usize {
        var p = at;
        while (p < text.len) {
            if (text.len - p >= s.len and same(text[p .. p + s.len], s)) {
                return p;
            }
            p = p + 1;
        }
        return NONE;
    }

    fn skip_space(text: []const u8, at: usize) -> usize {
        var p = at;
        while (p < text.len and is_space(text[p])) {
            p = p + 1;
        }
        return p;
    }

    fn blank(text: []const u8, a: usize, b: usize) -> bool {
        return skip_space(text[0 .. b], a) == b;
    }

    // a code point a numeric reference may name: HTML5 replaces the others
    // (NUL, C1 controls, surrogates, beyond U+10FFFF) or calls them errors
    fn code_ok(c: u64) -> bool {
        return c == 9 or c == 10 or c == 12 or c == 13 or (c >= 32 and c <= 126)
            or (c >= 160 and c <= 55295)
            or (c >= 57344 and c <= 1114111 and (c < 64976 or c > 65007) and c % 65536 < 65534);
    }

    // the value of digit c in base 10 or 16, 16 when c is not one
    fn digit_of(c: u8, base: u64) -> u64 {
        if (is_digit(c)) {
            return (c as u64) - 48;
        }
        if (base == 16 and c >= 97 and c <= 102) {
            return (c as u64) - 87;
        }
        if (base == 16 and c >= 65 and c <= 70) {
            return (c as u64) - 55;
        }
        return 16;
    }

    // the character reference at text[at] == '&', end NONE when it is
    // outside the subset; an ampersand not followed by a letter or '#' is
    // itself
    fn reference(text: []const u8, at: usize) -> Ref {
        const bad = Ref{ .code = 0, .end = NONE };
        if (at + 1 >= text.len or (is_alpha(text[at + 1]) == false and text[at + 1] != 35)) {
            return Ref{ .code = 38, .end = at + 1 };
        }
        const semi = find(text, at, ";");
        if (semi == NONE) {
            return bad;
        }
        const body = text[at + 1 .. semi];
        if (same(body, "amp")) { return Ref{ .code = 38, .end = semi + 1 }; }
        if (same(body, "lt")) { return Ref{ .code = 60, .end = semi + 1 }; }
        if (same(body, "gt")) { return Ref{ .code = 62, .end = semi + 1 }; }
        if (same(body, "quot")) { return Ref{ .code = 34, .end = semi + 1 }; }
        if (same(body, "apos")) { return Ref{ .code = 39, .end = semi + 1 }; }
        if (same(body, "nbsp")) { return Ref{ .code = 160, .end = semi + 1 }; }
        if (body.len < 2 or body[0] != 35) {
            return bad;
        }
        var base : u64 = 10;
        var i : usize = 1;
        if (lower(body[1]) == 120) {
            base = 16;
            i = 2;
        }
        if (i >= body.len) {
            return bad;
        }
        var code : u64 = 0;
        while (i < body.len) {
            const d = digit_of(body[i], base);
            if (d == 16) {
                return bad;
            }
            code = code * base + d;
            if (code > 1114111) {
                return bad;
            }
            i = i + 1;
        }
        if (code_ok(code) == false) {
            return bad;
        }
        return Ref{ .code = code, .end = semi + 1 };
    }

    // text[a .. b] holds allowed bytes and, with refs, valid references
    fn chars_ok(text: []const u8, a: usize, b: usize, refs: bool) -> bool {
        var i = a;
        while (i < b) {
            const c = text[i];
            if (char_ok(c) == false) {
                return false;
            }
            if (c == 38 and refs) {
                const r = reference(text, i);
                if (r.end == NONE) {
                    return false;
                }
                i = r.end;
            } else {
                i = i + 1;
            }
        }
        return true;
    }

    // a '<' here starts markup: a tag, an end tag, "<!" or "<?"
    fn markup_at(text: []const u8, i: usize) -> bool {
        if (text[i] != 60 or i + 1 >= text.len) {
            return false;
        }
        const c = text[i + 1];
        return is_alpha(c) or c == 47 or c == 33 or c == 63;
    }

    fn tag_end(text: []const u8, at: usize) -> usize {
        var p = at;
        while (p < text.len and tag_char(text[p])) {
            p = p + 1;
        }
        return p;
    }

    // the attribute whose name starts at at: the name, then optionally
    // S? '=' S? and a value
    fn attr_next(text: []const u8, at: usize) -> Attr {
        if (at >= text.len or attr_start(text[at]) == false) {
            return bad_attr();
        }
        var ne = at + 1;
        while (ne < text.len and attr_char(text[ne])) {
            ne = ne + 1;
        }
        const e = skip_space(text, ne);
        if (e >= text.len or text[e] != 61) {
            return Attr{ .name_at = at, .name_end = ne, .value_at = ne, .value_end = ne, .end = ne };
        }
        const v = skip_space(text, e + 1);
        if (v >= text.len) {
            return bad_attr();
        }
        const q = text[v];
        if (q == 34 or q == 39) {
            var j = v + 1;
            while (j < text.len and text[j] != q) {
                j = j + 1;
            }
            if (j >= text.len or chars_ok(text, v + 1, j, true) == false) {
                return bad_attr();
            }
            return Attr{ .name_at = at, .name_end = ne, .value_at = v + 1, .value_end = j, .end = j + 1 };
        }
        var k = v;
        while (k < text.len and is_space(text[k]) == false and text[k] != 62) {
            const c = text[k];
            if (c == 34 or c == 39 or c == 61 or c == 60 or c == 96) {
                return bad_attr();
            }
            k = k + 1;
        }
        if (k == v or chars_ok(text, v, k, true) == false) {
            return bad_attr();
        }
        return Attr{ .name_at = at, .name_end = ne, .value_at = v, .value_end = k, .end = k };
    }

    // an attribute named name is among those in text[from .. to]
    fn repeated(text: []const u8, from: usize, to: usize, name: []const u8) -> bool {
        var r = skip_space(text, from);
        while (r < to) {
            const b = attr_next(text, r);
            if (same_ci(text[b.name_at .. b.name_end], name)) {
                return true;
            }
            r = skip_space(text, b.end);
        }
        return false;
    }

    // where "</name" followed by white space, '/' or '>' first begins at or
    // after at, NONE if nowhere
    fn end_tag_at(text: []const u8, at: usize, name: []const u8) -> usize {
        var p = at;
        while (p + 2 + name.len < text.len) {
            if (text[p] == 60 and text[p + 1] == 47 and same_ci(text[p + 2 .. p + 2 + name.len], name)) {
                const c = text[p + 2 + name.len];
                if (is_space(c) or c == 47 or c == 62) {
                    return p;
                }
            }
            p = p + 1;
        }
        return NONE;
    }

    // the start tag at text[at] == '<' followed by a letter; a raw text or
    // RCDATA element is one token up to the end of its end tag
    fn start_tag(text: []const u8, at: usize) -> Token {
        const ne = tag_end(text, at + 1);
        const name = text[at + 1 .. ne];
        var p = ne;
        var slash = false;
        var stop : usize = NONE;
        while (stop == NONE) {
            const q = skip_space(text, p);
            if (q >= text.len) {
                return bad_token();
            }
            if (text[q] == 62) {
                stop = q + 1;
            } else if (text[q] == 47) {
                if (q + 1 >= text.len or text[q + 1] != 62) {
                    return bad_token();
                }
                slash = true;
                stop = q + 2;
            } else {
                if (q == p) {
                    return bad_token();
                }
                const a = attr_next(text, q);
                if (a.end == NONE or repeated(text, ne, q, text[a.name_at .. a.name_end])) {
                    return bad_token();
                }
                p = a.end;
            }
        }
        if (listed(name, VOIDS)) {
            return Token{ .kind = VOID, .name_at = at + 1, .name_end = ne, .body_at = stop, .body_end = stop, .end = stop };
        }
        if (slash) {
            return bad_token();
        }
        const raw = listed(name, "script style");
        if (raw or listed(name, "title textarea")) {
            const c = end_tag_at(text, stop, name);
            if (c == NONE) {
                return bad_token();
            }
            const e = skip_space(text, c + 2 + name.len);
            if (e >= text.len or text[e] != 62 or chars_ok(text, stop, c, raw == false) == false) {
                return bad_token();
            }
            if (same_ci(name, "script") and find(text[0 .. c], stop, "<!--") != NONE) {
                return bad_token();
            }
            var kind = RCDATA;
            if (raw) {
                kind = RAW;
            }
            return Token{ .kind = kind, .name_at = at + 1, .name_end = ne, .body_at = stop, .body_end = c, .end = e + 1 };
        }
        return Token{ .kind = START, .name_at = at + 1, .name_end = ne, .body_at = stop, .body_end = stop, .end = stop };
    }

    // the token starting at at < text.len
    fn token(text: []const u8, at: usize) -> Token {
        if (markup_at(text, at) == false) {
            var j = at + 1;
            while (j < text.len and markup_at(text, j) == false) {
                j = j + 1;
            }
            if (chars_ok(text, at, j, true) == false) {
                return bad_token();
            }
            return Token{ .kind = TEXT, .name_at = at, .name_end = at, .body_at = at, .body_end = j, .end = j };
        }
        if (text.len - at >= 4 and same(text[at .. at + 4], "<!--")) {
            const c = find(text, at + 4, "-->");
            if (c == NONE or starts_ci(text, at + 4, ">") or starts_ci(text, at + 4, "->")
                    or find(text[0 .. c + 3], at + 4, "--!>") != NONE or chars_ok(text, at + 4, c, false) == false) {
                return bad_token();
            }
            return Token{ .kind = COMMENT, .name_at = at, .name_end = at, .body_at = at + 4, .body_end = c, .end = c + 3 };
        }
        if (starts_ci(text, at, "<!doctype")) {
            const h = skip_space(text, at + 9);
            if (h == at + 9 or starts_ci(text, h, "html") == false) {
                return bad_token();
            }
            const e = skip_space(text, h + 4);
            if (e >= text.len or text[e] != 62) {
                return bad_token();
            }
            return Token{ .kind = DOCTYPE, .name_at = h, .name_end = h + 4, .body_at = e, .body_end = e, .end = e + 1 };
        }
        const c = text[at + 1];
        if (c == 47) {
            if (at + 2 >= text.len or is_alpha(text[at + 2]) == false) {
                return bad_token();
            }
            const ne = tag_end(text, at + 2);
            const e = skip_space(text, ne);
            if (e >= text.len or text[e] != 62) {
                return bad_token();
            }
            return Token{ .kind = END, .name_at = at + 2, .name_end = ne, .body_at = e, .body_end = e, .end = e + 1 };
        }
        if (is_alpha(c)) {
            return start_tag(text, at);
        }
        return bad_token();
    }

    fn is_element(kind: usize) -> bool {
        return kind == START or kind == VOID or kind == RAW or kind == RCDATA;
    }

    fn open_name(text: []const u8, opens: []const usize, closes: []const usize, k: usize) -> []const u8 {
        return text[opens[k] .. closes[k]];
    }

    // walking the open elements from the innermost, one named in targets
    // comes before any named in stops
    fn open_before(text: []const u8, opens: []const usize, closes: []const usize, depth: usize,
                   targets: []const u8, stops: []const u8) -> bool {
        var k = depth;
        while (k > 0) {
            k = k - 1;
            const n = open_name(text, opens, closes, k);
            if (listed(n, targets)) {
                return true;
            }
            if (listed(n, stops)) {
                return false;
            }
        }
        return false;
    }

    // the element of t may start here: the HTML5 tree builder would neither
    // close an open element for it nor treat it by rules of its own
    fn placed(text: []const u8, t: Token, opens: []const usize, closes: []const usize, depth: usize) -> bool {
        const name = text[t.name_at .. t.name_end];
        if (listed(name, REFUSED) or (same_ci(name, "html") and depth != 0)) {
            return false;
        }
        var parent : []const u8 = "";
        if (depth > 0) {
            parent = open_name(text, opens, closes, depth - 1);
        }
        if (same_ci(parent, "head") and listed(name, HEAD_CONTENT) == false) {
            return false;
        }
        if (same_ci(parent, "html") != listed(name, "head body")) {
            return false;
        }
        if (listed(name, P_CLOSERS) and open_before(text, opens, closes, depth, "p", "button html")) {
            return false;
        }
        if (same_ci(name, "li") and open_before(text, opens, closes, depth, "li", "ul ol menu")) {
            return false;
        }
        if (listed(name, "dd dt") and open_before(text, opens, closes, depth, "dd dt", "dl")) {
            return false;
        }
        if (listed(name, HEADINGS) and open_before(text, opens, closes, depth, HEADINGS, "")) {
            return false;
        }
        if (listed(name, "a button form") and open_before(text, opens, closes, depth, name, "")) {
            return false;
        }
        if (listed(name, "pre listing textarea") and t.body_at < text.len
                and (text[t.body_at] == 10 or text[t.body_at] == 13)) {
            return false;
        }
        return true;
    }

    fn byte_order_mark(text: []const u8) -> usize {
        if (text.len >= 3 and text[0] == 239 and text[1] == 187 and text[2] == 191) {
            return 3;
        }
        return 0;
    }

    fn parse(text: []const u8) -> HtmlNode {
        var opens : [128]usize = [0] ** 128;
        var closes : [128]usize = [0] ** 128;
        var depth : usize = 0;
        var top : usize = 0;
        var html = false;
        var head = false;
        var body = false;
        var doctype = false;
        const first = byte_order_mark(text);
        var at = first;
        while (at < text.len) {
            const t = token(text, at);
            if (t.kind == BAD) {
                return bad_node();
            }
            const name = text[t.name_at .. t.name_end];
            if (t.kind == TEXT and blank(text, at, t.end) == false) {
                if (depth == 0) {
                    if (html) {
                        return bad_node();
                    }
                    top = top + 1;
                } else if (listed(open_name(text, &opens, &closes, depth - 1), "html head")) {
                    return bad_node();
                }
            }
            if (t.kind == DOCTYPE) {
                if (doctype or top != 0) {
                    return bad_node();
                }
                doctype = true;
            }
            if (is_element(t.kind)) {
                if (placed(text, t, &opens, &closes, depth) == false) {
                    return bad_node();
                }
                if (depth == 0) {
                    if (html or (same_ci(name, "html") and top != 0)) {
                        return bad_node();
                    }
                    top = top + 1;
                    html = same_ci(name, "html");
                }
                if (same_ci(name, "head")) {
                    if (head) {
                        return bad_node();
                    }
                    head = true;
                }
                if (same_ci(name, "body")) {
                    if (body or head == false) {
                        return bad_node();
                    }
                    body = true;
                }
            }
            if (t.kind == START) {
                if (depth == MAX_DEPTH) {
                    return bad_node();
                }
                opens[depth] = t.name_at;
                closes[depth] = t.name_end;
                depth = depth + 1;
            }
            if (t.kind == END) {
                if (depth == 0 or same_ci(name, open_name(text, &opens, &closes, depth - 1)) == false) {
                    return bad_node();
                }
                if (same_ci(name, "html") and body == false) {
                    return bad_node();
                }
                depth = depth - 1;
            }
            at = t.end;
        }
        if (depth != 0) {
            return bad_node();
        }
        return HtmlNode{ .tag = "", .at = 0, .content_at = first, .content_end = text.len, .end = text.len };
    }

    // the element whose start tag is at at, in a document parse accepted
    fn node_at(text: []const u8, at: usize) -> HtmlNode {
        const t = token(text, at);
        const tag = text[t.name_at .. t.name_end];
        if (t.kind != START) {
            return HtmlNode{ .tag = tag, .at = at, .content_at = t.body_at, .content_end = t.body_end, .end = t.end };
        }
        var depth : usize = 1;
        var p = t.end;
        while (p < text.len) {
            const u = token(text, p);
            if (u.kind == START) {
                depth = depth + 1;
            }
            if (u.kind == END) {
                depth = depth - 1;
                if (depth == 0) {
                    return HtmlNode{ .tag = tag, .at = at, .content_at = t.end, .content_end = p, .end = u.end };
                }
            }
            p = u.end;
        }
        return bad_node();
    }

    // the number of child elements of node
    fn children(text: []const u8, node: HtmlNode) -> usize {
        var n : usize = 0;
        var p = node.content_at;
        while (p < node.content_end) {
            const t = token(text, p);
            if (is_element(t.kind)) {
                n = n + 1;
                p = node_at(text, p).end;
            } else {
                p = t.end;
            }
        }
        return n;
    }

    // child element i (from 0) of node; end NONE when there is none
    fn child(text: []const u8, node: HtmlNode, i: usize) -> HtmlNode {
        var n : usize = 0;
        var p = node.content_at;
        while (p < node.content_end) {
            const t = token(text, p);
            if (is_element(t.kind)) {
                const c = node_at(text, p);
                if (n == i) {
                    return c;
                }
                n = n + 1;
                p = c.end;
            } else {
                p = t.end;
            }
        }
        return bad_node();
    }

    // node's attribute named name (ignoring ASCII case); end NONE when it
    // has none
    fn attribute(text: []const u8, node: HtmlNode, name: []const u8) -> Attr {
        if (node.tag.len == 0) {
            return bad_attr();
        }
        var r = skip_space(text, node.at + 1 + node.tag.len);
        while (text[r] != 62 and text[r] != 47) {
            const a = attr_next(text, r);
            if (same_ci(text[a.name_at .. a.name_end], name)) {
                return a;
            }
            r = skip_space(text, a.end);
        }
        return bad_attr();
    }

    fn put_byte(out: []u8, n: usize, b: u8) -> usize {
        if (n >= out.len) {
            return NONE;
        }
        out[n] = b;
        return n + 1;
    }

    // character code as UTF-8
    fn put_code(out: []u8, n: usize, code: u64) -> usize {
        var w : usize = 1;
        if (code >= 128) { w = 2; }
        if (code >= 2048) { w = 3; }
        if (code >= 65536) { w = 4; }
        if (n > out.len or out.len - n < w) {
            return NONE;
        }
        if (w == 1) {
            out[n] = code as u8;
        } else if (w == 2) {
            out[n] = (192 + code / 64) as u8;
        } else if (w == 3) {
            out[n] = (224 + code / 4096) as u8;
        } else {
            out[n] = (240 + code / 262144) as u8;
        }
        var k : usize = 1;
        while (k < w) {
            var shift : u64 = 1;
            var j : usize = k;
            while (j < w - 1) {
                shift = shift * 64;
                j = j + 1;
            }
            out[n + k] = (128 + (code / shift) % 64) as u8;
            k = k + 1;
        }
        return n + w;
    }

    // text[a .. b] decoded after out[0 .. n]: line ends normalised and,
    // with refs, references expanded; the new length, NONE when out is too
    // short
    fn decode(text: []const u8, a: usize, b: usize, refs: bool, out: []u8, n: usize) -> usize {
        var i = a;
        var m = n;
        while (i < b and m != NONE) {
            const c = text[i];
            if (c == 38 and refs) {
                const r = reference(text, i);
                m = put_code(out, m, r.code);
                i = r.end;
            } else {
                var x = c;
                i = i + 1;
                if (c == 13) {
                    x = 10;
                    if (i < b and text[i] == 10) {
                        i = i + 1;
                    }
                }
                m = put_byte(out, m, x);
            }
        }
        return m;
    }

    // the decoded value of an attribute found by attribute(); a name alone
    // has the empty value
    fn value(text: []const u8, a: Attr, out: []u8) -> usize {
        if (a.end == NONE) {
            return NONE;
        }
        return decode(text, a.value_at, a.value_end, true, out, 0);
    }

    // the textContent of node: the text in it, at any depth, in order
    fn inner_text(text: []const u8, node: HtmlNode, out: []u8) -> usize {
        if (node.tag.len != 0) {
            const t = token(text, node.at);
            if (t.kind == RAW or t.kind == RCDATA) {
                return decode(text, t.body_at, t.body_end, t.kind == RCDATA, out, 0);
            }
        }
        var p = node.content_at;
        var m : usize = 0;
        while (p < node.content_end and m != NONE) {
            const t = token(text, p);
            if (t.kind == TEXT) {
                m = decode(text, p, t.end, true, out, m);
            }
            if (t.kind == RAW or t.kind == RCDATA) {
                m = decode(text, t.body_at, t.body_end, t.kind == RCDATA, out, m);
            }
            p = t.end;
        }
        return m;
    }

    // ── selectors ──

    fn sel_skip(s: []const u8, at: usize) -> usize {
        var p = at;
        while (p < s.len and is_space(s[p])) {
            p = p + 1;
        }
        return p;
    }

    // the end of the ASCII CSS identifier at s[at], NONE if none starts there
    fn ident_end(s: []const u8, at: usize) -> usize {
        var p = at;
        if (at < s.len and s[at] == 45) {
            p = at + 1;
        }
        if (p >= s.len or (is_alpha(s[p]) == false and s[p] != 95)) {
            return NONE;
        }
        var q = p + 1;
        while (q < s.len and (is_alpha(s[q]) or is_digit(s[q]) or s[q] == 95 or s[q] == 45)) {
            q = q + 1;
        }
        return q;
    }

    // the end of the compound selector at s[at]: a type or '*', then any
    // #id and .class parts; NONE when none is there
    fn compound_end(s: []const u8, at: usize) -> usize {
        if (at >= s.len) {
            return NONE;
        }
        var p = at;
        if (s[at] == 42) {
            p = at + 1;
        } else if (s[at] != 35 and s[at] != 46) {
            p = ident_end(s, at);
            if (p == NONE) {
                return NONE;
            }
        }
        while (p < s.len and (s[p] == 35 or s[p] == 46)) {
            p = ident_end(s, p + 1);
            if (p == NONE) {
                return NONE;
            }
        }
        if (p == at) {
            return NONE;
        }
        return p;
    }

    // selector list s as compounds s[froms[i] .. tos[i]], each with the
    // combinator before it (',' when it begins a selector of the list); the
    // count, NONE when s is outside the subset
    fn split(s: []const u8, froms: []usize, tos: []usize, combs: []u8) -> usize {
        var n : usize = 0;
        var p = sel_skip(s, 0);
        var comb : u8 = 44;
        while (n < MAX_PARTS) {
            const e = compound_end(s, p);
            if (e == NONE) {
                return NONE;
            }
            froms[n] = p;
            tos[n] = e;
            combs[n] = comb;
            n = n + 1;
            const q = sel_skip(s, e);
            if (q >= s.len) {
                return n;
            }
            if (s[q] == 44 or s[q] == 62) {
                comb = s[q];
                p = sel_skip(s, q + 1);
            } else {
                if (q == e) {
                    return NONE;
                }
                comb = 32;
                p = q;
            }
        }
        return NONE;
    }

    // el's attribute name decodes to want
    fn attr_is(text: []const u8, el: HtmlNode, name: []const u8, want: []const u8) -> bool {
        var buf : [256]u8 = [0] ** 256;
        const n = value(text, attribute(text, el, name), &buf);
        return n != NONE and same(buf[0 .. n], want);
    }

    // want is one of the white-space separated words of el's class
    fn has_class(text: []const u8, el: HtmlNode, want: []const u8) -> bool {
        var buf : [256]u8 = [0] ** 256;
        const n = value(text, attribute(text, el, "class"), &buf);
        if (n == NONE) {
            return false;
        }
        var a : usize = 0;
        while (a < n) {
            var b = a;
            while (b < n and is_space(buf[b]) == false) {
                b = b + 1;
            }
            if (b > a and same(buf[a .. b], want)) {
                return true;
            }
            a = b + 1;
        }
        return false;
    }

    // the element whose start tag is at at matches compound s[a .. b]
    fn compound_ok(text: []const u8, at: usize, s: []const u8, a: usize, b: usize) -> bool {
        const t = token(text, at);
        const el = HtmlNode{ .tag = text[t.name_at .. t.name_end], .at = at, .content_at = 0, .content_end = 0, .end = 0 };
        var p = a;
        if (s[a] == 42) {
            p = a + 1;
        } else if (s[a] != 35 and s[a] != 46) {
            const q = ident_end(s, a);
            if (same_ci(s[a .. q], el.tag) == false) {
                return false;
            }
            p = q;
        }
        while (p < b) {
            const name_at = p + 1;
            const q = ident_end(s, name_at);
            const want = s[name_at .. q];
            if (s[p] == 35 and attr_is(text, el, "id", want) == false) {
                return false;
            }
            if (s[p] == 46 and has_class(text, el, want) == false) {
                return false;
            }
            p = q;
        }
        return true;
    }

    // the element at stack[k], whose ancestors start at stack[0 .. k],
    // matches the selector that ends in compound i
    fn chain(text: []const u8, stack: []const usize, k: usize, s: []const u8,
             froms: []const usize, tos: []const usize, combs: []const u8, i: usize) -> bool {
        if (compound_ok(text, stack[k], s, froms[i], tos[i]) == false) {
            return false;
        }
        if (combs[i] == 44) {
            return true;
        }
        if (k == 0) {
            return false;
        }
        if (combs[i] == 62) {
            return chain(text, stack, k - 1, s, froms, tos, combs, i - 1);
        }
        var j = k;
        while (j > 0) {
            j = j - 1;
            if (chain(text, stack, j, s, froms, tos, combs, i - 1)) {
                return true;
            }
        }
        return false;
    }

    // querySelector: the first element inside node, in document order,
    // that selector list s matches (ancestors outside node count, as in the
    // DOM); end NONE when none does or s is outside the subset. text is a
    // document parse accepted.
    fn query_selector(text: []const u8, node: HtmlNode, s: []const u8) -> HtmlNode {
        var froms : [16]usize = [0] ** 16;
        var tos : [16]usize = [0] ** 16;
        var combs : [16]u8 = [0] ** 16;
        const n = split(s, &froms, &tos, &combs);
        if (n == NONE) {
            return bad_node();
        }
        var stack : [129]usize = [0] ** 129;
        var depth : usize = 0;
        var at = byte_order_mark(text);
        while (at < text.len) {
            const t = token(text, at);
            if (is_element(t.kind)) {
                stack[depth] = at;
                if (at >= node.content_at and at < node.content_end) {
                    var i : usize = 0;
                    while (i < n) {
                        if ((i + 1 == n or combs[i + 1] == 44)
                                and chain(text, stack[0 .. depth + 1], depth, s, &froms, &tos, &combs, i)) {
                            return node_at(text, at);
                        }
                        i = i + 1;
                    }
                }
                if (t.kind == START) {
                    depth = depth + 1;
                }
            }
            if (t.kind == END) {
                depth = depth - 1;
            }
            at = t.end;
        }
        return bad_node();
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    fn hex_value(c: u8) -> usize {
        if (c >= 97) {
            return (c as usize) - 87;
        }
        return (c as usize) - 48;
    }

    fn from_hex(hex: []const u8, out: []u8) -> []u8 {
        var i : usize = 0;
        while (2 * i < hex.len) {
            out[i] = (hex_value(hex[2 * i]) * 16 + hex_value(hex[2 * i + 1])) as u8;
            i = i + 1;
        }
        return out[0 .. i];
    }

    fn bytes_are(d: []const u8, hex: []const u8) -> bool {
        if (hex.len != 2 * d.len) {
            return false;
        }
        var i : usize = 0;
        while (i < d.len) {
            if ((d[i] as usize) != hex_value(hex[2 * i]) * 16 + hex_value(hex[2 * i + 1])) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn refused(s: []const u8) -> usize {
        if (parse(s).end == NONE) {
            return 1;
        }
        return 0;
    }

    fn accepted(s: []const u8) -> usize {
        if (parse(s).end == s.len) {
            return 1;
        }
        return 0;
    }

    fn refused_hex(hex: []const u8) -> usize {
        var buf : [64]u8 = [0] ** 64;
        return refused(from_hex(hex, &buf));
    }

    // the textContent of document s is the UTF-8 hex given (html5lib)
    fn text_is(s: []const u8, hex: []const u8) -> usize {
        var out : [64]u8 = [0] ** 64;
        const d = parse(s);
        if (d.end == NONE) {
            return 0;
        }
        const n = inner_text(s, d, &out);
        if (n != NONE and bytes_are(out[0 .. n], hex)) {
            return 1;
        }
        return 0;
    }

    fn text_hex(doc: []const u8, hex: []const u8) -> usize {
        var buf : [64]u8 = [0] ** 64;
        return text_is(from_hex(doc, &buf), hex);
    }

    pub const DOC : []const u8 = "<div id=main class=\"a b\"><p class=x>1</p><section><p id=q class=\"x y\">2</p></section></div><p class=y>3</p>";

    // the first element selector list sel matches in DOC begins at at
    // (soupsieve select_one), NONE for none
    fn found(sel: []const u8, at: usize) -> usize {
        const d = parse(DOC);
        const e = query_selector(DOC, d, sel);
        if ((at == NONE and e.end == NONE) or (e.end != NONE and e.at == at)) {
            return 1;
        }
        return 0;
    }

    fn sample() -> usize {
        var out : [16]u8 = [0] ** 16;
        var ok : usize = 0;
        const d = parse(DOC);
        if (d.end == DOC.len and children(DOC, d) == 2) { ok = ok + 1; }
        const div = child(DOC, d, 0);
        if (same(div.tag, "div") and div.at == 0 and div.content_at == 25 and div.end == 91 and children(DOC, div) == 2) { ok = ok + 1; }
        const sec = child(DOC, div, 1);
        if (same(sec.tag, "section") and sec.at == 41 and sec.content_end == 75 and sec.end == 85) { ok = ok + 1; }
        if (value(DOC, attribute(DOC, div, "CLASS"), &out) == 3 and same(out[0 .. 3], "a b")) { ok = ok + 1; }
        if (attribute(DOC, div, "title").end == NONE and child(DOC, sec, 1).end == NONE) { ok = ok + 1; }
        if (inner_text(DOC, d, &out) == 3 and same(out[0 .. 3], "123") and inner_text(DOC, d, out[0 .. 2]) == NONE) { ok = ok + 1; }
        if (inner_text(DOC, sec, &out) == 1 and out[0] == 50) { ok = ok + 1; }
        return ok;
    }

    // html5lib builds the tree as written for each of these
    fn well_formed() -> usize {
        var ok : usize = 0;
        ok = ok + accepted("<p>a<b>c</b></p>");
        ok = ok + accepted("<!DOCTYPE html><html><head><title>T</title></head><body><p>x</p></body></html>");
        ok = ok + accepted("<ul><li>a</li><li>b</li></ul>");
        ok = ok + accepted("<div><p>x</p><p>y</p></div>");
        ok = ok + accepted("<img src=a.png alt=''>");
        ok = ok + accepted("<br/><hr>");
        ok = ok + accepted("<p a.b=1></p>");
        ok = ok + accepted("a < b");
        ok = ok + accepted("<script>if (a<b) x='</p>';</script>");
        ok = ok + accepted("<style>p>a{}</style>");
        ok = ok + accepted("<textarea>a<b>&amp;</textarea>");
        ok = ok + accepted("<!-- c --><p>x</p>");
        ok = ok + accepted("<dl><dt>a</dt><dd>b</dd></dl>");
        ok = ok + accepted("<p><button><div>x</div></button></p>");
        ok = ok + accepted("<ul><li><ul><li>x</li></ul></li></ul>");
        ok = ok + accepted("<a href=x><span>y</span></a>");
        ok = ok + accepted("<h1>a</h1><h2>b</h2>");
        ok = ok + accepted("<DIV CLASS=x>y</div>");
        ok = ok + accepted("<p>&nbsp;&#x41;</p>");
        ok = ok + accepted("<html><head></head><body></body></html>");
        ok = ok + accepted("<pre> x</pre>");
        ok = ok + accepted("<input disabled>");
        ok = ok + accepted("<form><input></form>");
        ok = ok + accepted("<1>");
        ok = ok + accepted("<p></P >");
        ok = ok + accepted("<p>x</p\n>");
        ok = ok + accepted("<html>\n<head>\n<meta charset=utf-8>\n</head>\n<body>x</body></html>");
        ok = ok + accepted("<dl><dt><dl><dd>x</dd></dl></dt></dl>");
        ok = ok + accepted("<p><span><b>x</b></span></p>");
        ok = ok + accepted("<a href=\"a&lt;b\" title='q'>x</a>");
        ok = ok + accepted("<!DOCTYPE html>\n<html><head></head><!--c--><body><p>x</p></body><!--d--></html>");
        ok = ok + accepted("<title>t</title><p>x</p>");
        ok = ok + accepted("<my-el a-b=1>x</my-el>");
        ok = ok + accepted("<p>a<!--<p>-->b</p>");
        ok = ok + accepted("<p>x<!--a--->y</p>");
        ok = ok + accepted("<b><i>x</i></b>");
        return ok;
    }

    // HTML5 builds another tree, or html.parser other events, or the
    // subset's own rules refuse it
    fn outside_subset() -> usize {
        var ok : usize = 0;
        ok = ok + refused("<p>x");
        ok = ok + refused("<div><p>x</div>");
        ok = ok + refused("<p><div>x</div></p>");
        ok = ok + refused("<ul><li>a<li>b</li></li></ul>");
        ok = ok + refused("<dl><dt>a<dd>b</dd></dt></dl>");
        ok = ok + refused("<h1><span><h2>x</h2></span></h1>");
        ok = ok + refused("<a><a>x</a></a>");
        ok = ok + refused("<form><div><form></form></div></form>");
        ok = ok + refused("<table></table>");
        ok = ok + refused("<pre>\nx</pre>");
        ok = ok + refused("<br></br>");
        ok = ok + refused("<div/>");
        ok = ok + refused("</p>");
        ok = ok + refused("<p></p x>");
        ok = ok + refused("<p></b>");
        ok = ok + refused("<!x>");
        ok = ok + refused("<?php?>");
        ok = ok + refused("<!-->");
        ok = ok + refused("<!--->");
        ok = ok + refused("<!--->x-->");
        ok = ok + refused("<div/></div>");
        ok = ok + refused("<p>&#x110000;</p>");
        ok = ok + refused("<!--a--!>b-->");
        ok = ok + refused("<!--a");
        ok = ok + refused("<p a=1 A=2></p>");
        ok = ok + refused("<p a='1'b='2'></p>");
        ok = ok + refused("<p a=`x`></p>");
        ok = ok + refused("<p a=></p>");
        ok = ok + refused("<p a=x=y></p>");
        ok = ok + refused("<p a></p");
        ok = ok + refused("<p_a></p_a>");
        ok = ok + refused("<script><!--</script>");
        ok = ok + refused("<script>x</script x>");
        ok = ok + refused("<style>x");
        ok = ok + refused("x<html><head></head><body></body></html>");
        ok = ok + refused("<html><p>x</p></html>");
        ok = ok + refused("<html><body></body></html>");
        ok = ok + refused("<html><head></head></html>");
        ok = ok + refused("<html><head></head><body></body><head></head></html>");
        ok = ok + refused("<html><head></head>x<body></body></html>");
        ok = ok + refused("<html><head><p>x</p></head><body></body></html>");
        ok = ok + refused("<html><head></head><body></body></html>x");
        ok = ok + refused("<html><head></head><body><html></html></body></html>");
        ok = ok + refused("<head></head>");
        ok = ok + refused("<p><body></body></p>");
        ok = ok + refused("<!DOCTYPE html><!DOCTYPE html>");
        ok = ok + refused("x<!DOCTYPE html>");
        ok = ok + refused("<!DOCTYPE html5>");
        ok = ok + refused("<!DOCTYPEhtml>");
        ok = ok + refused("a </ b");
        ok = ok + refused("<select></select>");
        ok = ok + refused("<svg></svg>");
        return ok;
    }

    fn references() -> usize {
        var ok : usize = 0;
        ok = ok + text_is("<p>a<b>c</b>d</p>", "616364");
        ok = ok + text_is("<p>&lt;&gt;&amp;&quot;&apos;</p>", "3c3e262227");
        ok = ok + text_is("<p>&#65;&#x42;&#X43;</p>", "414243");
        ok = ok + text_is("<p>&nbsp;&#xA0;</p>", "c2a0c2a0");
        ok = ok + text_is("<p>&#x1F600;&#x10FFFD;&#xE000;&#xFDCF;&#xFDF0;&#xD7FF;</p>", "f09f9880f48fbfbdee8080efb78fefb7b0ed9fbf");
        ok = ok + text_is("<script>&amp;</script>", "26616d703b");
        ok = ok + text_is("<title>&amp;</title>", "26");
        ok = ok + text_is("<p>a & b</p>", "6120262062");
        ok = ok + text_is("<!--x-->a<!--y-->", "61");
        ok = ok + text_is("<p>&#13;</p>", "0d");
        ok = ok + text_is("<p>&#9;&#10;&#12;&#32;&#126;&#160;</p>", "090a0c207ec2a0");
        ok = ok + text_is("&&#38;", "2626");
        ok = ok + refused("<p>&copy;</p>");
        ok = ok + refused("<p>&amp</p>");
        ok = ok + refused("<p>&#0;</p>");
        ok = ok + refused("<p>&#11;</p>");
        ok = ok + refused("<p>&#127;</p>");
        ok = ok + refused("<p>&#128;</p>");
        ok = ok + refused("<p>&#159;</p>");
        ok = ok + refused("<p>&#xD800;</p>");
        ok = ok + refused("<p>&#xDFFF;</p>");
        ok = ok + refused("<p>&#xFDD0;</p>");
        ok = ok + refused("<p>&#xFDEF;</p>");
        ok = ok + refused("<p>&#xFFFE;</p>");
        ok = ok + refused("<p>&#x1FFFF;</p>");
        ok = ok + refused("<p>&#x110000;</p>");
        ok = ok + refused("<p>&#;</p>");
        ok = ok + refused("<p>&#x;</p>");
        ok = ok + refused("<p>&#1a;</p>");
        ok = ok + refused("<p a='&x;'></p>");
        return ok;
    }

    // line ends, byte order mark and control bytes, as hex documents
    fn bytes() -> usize {
        var ok : usize = 0;
        ok = ok + text_hex("610d0a620d630a", "610a620a630a");
        ok = ok + text_hex("3c74657874617265613e780d0a793c2f74657874617265613e", "780a79");
        ok = ok + text_hex("3c7363726970743e0d783c2f7363726970743e", "0a78");
        ok = ok + text_hex("efbbbf3c703e783c2f703e", "78");
        ok = ok + text_hex("efbbbf", "");
        ok = ok + text_hex("3c703e0c09783c2f703e", "0c0978");
        ok = ok + text_hex("3c700c613d313e783c2f703e", "78");
        ok = ok + refused_hex("3c74657874617265613e0d783c2f74657874617265613e");
        ok = ok + refused_hex("3c703e013c2f703e");
        ok = ok + refused_hex("3c703e7f3c2f703e");
        ok = ok + refused_hex("3c703e003c2f703e");
        ok = ok + refused_hex("3c7020613d2201223e3c2f703e");
        ok = ok + refused_hex("3c212d2d1b2d2d3e");
        ok = ok + refused_hex("3c7374796c653e1b3c2f7374796c653e");
        return ok;
    }

    fn attributes() -> usize {
        var out : [16]u8 = [0] ** 16;
        var ok : usize = 0;
        const s = "<a HREF = \"x&amp;y\" title=t&lt; disabled data-x='&#x42;'>z</a>";
        const a = child(s, parse(s), 0);
        if (value(s, attribute(s, a, "href"), &out) == 3 and same(out[0 .. 3], "x&y")) { ok = ok + 1; }
        if (value(s, attribute(s, a, "TITLE"), &out) == 2 and same(out[0 .. 2], "t<")) { ok = ok + 1; }
        if (value(s, attribute(s, a, "disabled"), &out) == 0 and attribute(s, a, "disabled").end != NONE) { ok = ok + 1; }
        if (value(s, attribute(s, a, "data-x"), &out) == 1 and out[0] == 66) { ok = ok + 1; }
        if (attribute(s, a, "id").end == NONE and value(s, attribute(s, a, "id"), &out) == NONE) { ok = ok + 1; }
        if (value(s, attribute(s, a, "href"), out[0 .. 2]) == NONE) { ok = ok + 1; }
        const v = "<img alt=x src=y/>";
        const img = child(v, parse(v), 0);
        if (img.end == 18 and img.content_at == 18 and value(v, attribute(v, img, "src"), &out) == 2 and same(out[0 .. 2], "y/")) { ok = ok + 1; }
        return ok;
    }

    fn selectors() -> usize {
        var ok : usize = 0;
        ok = ok + found("p", 25);
        ok = ok + found("#q", 50);
        ok = ok + found(".y", 50);
        ok = ok + found("div > p", 25);
        ok = ok + found("div > section > p.y", 50);
        ok = ok + found("section p", 50);
        ok = ok + found("div p.y", 50);
        ok = ok + found("p.x.y", 50);
        ok = ok + found("*", 0);
        ok = ok + found(".b", 0);
        ok = ok + found("span", NONE);
        ok = ok + found("div > .y", NONE);
        ok = ok + found("span, .y", 50);
        ok = ok + found("#Q", NONE);
        ok = ok + found("DIV", 0);
        ok = ok + found("p#q.x", 50);
        ok = ok + found("section>p", 50);
        ok = ok + found("div  p", 25);
        ok = ok + found(".x .y", NONE);
        ok = ok + found("div p p", NONE);
        ok = ok + found("main", NONE);
        ok = ok + found("#main > section p", 50);
        ok = ok + found("p, div", 0);
        ok = ok + found("   p  ", 25);
        ok = ok + found("-a", NONE);
        ok = ok + found("_a", NONE);
        ok = ok + found("div > p.y, p.y", 50);
        ok = ok + found("div ~ p", NONE);
        ok = ok + found("#q, span", 50);
        return ok;
    }

    // soupsieve raises a syntax error, or the subset has no such selector
    fn bad_selectors() -> usize {
        var ok : usize = 0;
        ok = ok + found("", NONE);
        ok = ok + found("p >", NONE);
        ok = ok + found("> p", NONE);
        ok = ok + found("p,,a", NONE);
        ok = ok + found("#1a", NONE);
        ok = ok + found(".", NONE);
        ok = ok + found("p..x", NONE);
        ok = ok + found("p,", NONE);
        ok = ok + found("#-1", NONE);
        ok = ok + found("p:first-child", NONE);
        ok = ok + found("[a]", NONE);
        ok = ok + found("p.x#", NONE);
        ok = ok + found("**", NONE);
        ok = ok + found("a b c d e f g h i j k l m n o p q", NONE);
        return ok;
    }

    // querySelector on an element: candidates inside it, ancestors anywhere
    fn scoped() -> usize {
        var ok : usize = 0;
        const sec = child(DOC, child(DOC, parse(DOC), 0), 1);
        if (query_selector(DOC, sec, "p").at == 50) { ok = ok + 1; }
        if (query_selector(DOC, sec, "div p").at == 50) { ok = ok + 1; }
        if (query_selector(DOC, sec, "section p").at == 50) { ok = ok + 1; }
        if (query_selector(DOC, sec, "div > p").end == NONE) { ok = ok + 1; }
        if (query_selector(DOC, sec, "section").end == NONE) { ok = ok + 1; }
        const p = query_selector(DOC, parse(DOC), "#q");
        if (p.content_at == 70 and p.content_end == 71 and query_selector(DOC, p, "*").end == NONE) { ok = ok + 1; }
        const n = "<div><span><span class=_a>x</span></span></div>";
        const outer = child(n, child(n, parse(n), 0), 0);
        if (query_selector(n, outer, "div > span").end == NONE and query_selector(n, outer, "span").at == 11) { ok = ok + 1; }
        if (query_selector(n, parse(n), "._a").at == 11 and query_selector(n, parse(n), "span > ._a").at == 11) { ok = ok + 1; }
        return ok;
    }

    fn deep(n: usize, out: []u8) -> []u8 {
        var at : usize = 0;
        var i : usize = 0;
        while (i < n) {
            out[at] = 60;
            out[at + 1] = 98;
            out[at + 2] = 62;
            at = at + 3;
            i = i + 1;
        }
        i = 0;
        while (i < n) {
            out[at] = 60;
            out[at + 1] = 47;
            out[at + 2] = 98;
            out[at + 3] = 62;
            at = at + 4;
            i = i + 1;
        }
        return out[0 .. at];
    }

    fn depth_limit() -> bool {
        var buf : [1024]u8 = [0] ** 1024;
        const d = deep(MAX_DEPTH, &buf);
        const ok = parse(d).end == 7 * MAX_DEPTH and query_selector(d, parse(d), "b b").at == 3;
        return ok and parse(deep(MAX_DEPTH + 1, &buf)).end == NONE;
    }

    test sample_tree_matches_html5lib
        given result = sample()
        when expected = 7
        then result == expected

    test as_written_trees_are_accepted
        given result = well_formed()
        when expected = 36
        then result == expected

    test documents_outside_the_subset_are_refused
        given result = outside_subset()
        when expected = 52
        then result == expected

    test references_decode_to_utf8
        given result = references()
        when expected = 30
        then result == expected

    test line_ends_bom_and_control_bytes
        given result = bytes()
        when expected = 14
        then result == expected

    test attributes_ignore_name_case
        given result = attributes()
        when expected = 7
        then result == expected

    test selectors_match_soupsieve
        given result = selectors()
        when expected = 29
        then result == expected

    test selectors_outside_the_subset_find_nothing
        given result = bad_selectors()
        when expected = 14
        then result == expected

    test query_selector_is_scoped_like_the_dom
        given result = scoped()
        when expected = 8
        then result == expected

    test nesting_stops_at_max_depth
        given result = depth_limit()
        when expected = true
        then result == expected
