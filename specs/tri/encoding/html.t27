// t27/specs/
// HTML encoding parser | φ² + 1/φ² = 3 | TRINITY

module TriHtmlParser;
    use base::types;
    use TriEncodingCommon;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub struct HtmlParser {
        input: []const u8,
        position: u32,
        line: u32,
        column: u32,
    }

    pub struct HtmlElement {
        name: []const u8,
        attributes: []HtmlAttribute,
        self_closing: bool,
        start_line: u32,
        end_line: u32,
    }

    pub struct HtmlAttribute {
        name: []const u8,
        value: []const u8,
        quoted: bool,
    }

    pub struct HtmlParseResult {
        elements: []HtmlElement,
        errors: []ParseError,
    }

    pub struct ParseError {
        message: []const u8,
        line: u32,
        column: u32,
    }

    // ═══════════════════════════════════════════════════════════
    // 2. Parser Implementation
    // ═══════════════════════════════════════════════════════════

    pub fn new_parser(input: []const u8) -> HtmlParser {
        return HtmlParser{
            .input = input,
            .position = 0,
            .line = 1,
            .column = 1,
        };
    }

    pub fn parse(input: []const u8) -> HtmlParseResult {
        var parser = new_parser(input);
        var elements: []HtmlElement = .{};
        var errors: []ParseError = .{};

        // Skip BOM if present
        if (byte_order_mark(input)) |bom_pos| {
            parser.position = bom_pos + 3;
        }

        while (parser.position < input.len) {
            parser.skip_whitespace();
            
            if (parser.position >= input.len) break;
            
            const element = parser.parse_element();
            if (element) |elem| {
                elements = elements ++ [elem];
            } else {
                // Parse error, skip to next tag
                parser.position = parser.find_next_tag();
                if (parser.position == input.len) break;
            }
        }

        return HtmlParseResult{
            .elements = elements,
            .errors = errors,
        };
    }

    fn parse_element(?*Self) -> ?HtmlElement {
        if (self.peek_char() != '<') {
            return null;
        }

        const start_pos = self.position;
        self.consume_char(); // '<'

        // Check for closing tag
        if (self.peek_char() == '/') {
            self.consume_char(); // '/'
            self.skip_tag_name();
            self.skip_whitespace();
            if (self.consume_char() != '>') {
                return null;
            }
            return null; // Ignore closing tags for element collection
        }

        // Parse element name
        const name = self.parse_tag_name();
        if (name.len == 0) {
            return null;
        }

        // Parse attributes
        var attributes: []HtmlAttribute = .{};
        while (true) {
            self.skip_whitespace();
            if (self.peek_char() == '>') {
                self.consume_char();
                break;
            } else if (self.peek_char() == '/') {
                // Self-closing tag
                self.consume_char();
                self.skip_whitespace();
                if (self.consume_char() != '>') {
                    return null;
                }
                break;
            }

            // Parse attribute
            const attr = self.parse_attribute();
            if (attr) |a| {
                attributes = attributes ++ [a];
            } else {
                return null;
            }
        }

        return HtmlElement{
            .name = name,
            .attributes = attributes,
            .self_closing = self.peek_char_at(start_pos + name.len + 1) == '/',
            .start_line = self.line,
            .end_line = self.line,
        };
    }

    fn parse_attribute(?*Self) -> ?HtmlAttribute {
        const name = self.parse_tag_name();
        if (name.len == 0 or bad_attr(name)) {
            return null;
        }

        self.skip_whitespace();
        
        if (self.peek_char() != '=') {
            return HtmlAttribute{
                .name = name,
                .value = "",
                .quoted = false,
            };
        }

        self.consume_char(); // '='
        self.skip_whitespace();

        const quoted = self.peek_char() == '"';
        var value: []const u8 = .{};

        if (quoted) {
            self.consume_char(); // '"'
            while (self.peek_char() != '"') {
                if (self.peek_char() == 0) {
                    return null; // Unterminated quoted string
                }
                value = value ++ [self.consume_char()];
            }
            self.consume_char(); // '"'
        } else {
            while (self.peek_char() != '>' and self.peek_char() != ' ' and self.peek_char() != '\t' and self.peek_char() != '\n' and self.peek_char() != '\r') {
                value = value ++ [self.consume_char()];
            }
        }

        return HtmlAttribute{
            .name = name,
            .value = value,
            .quoted = quoted,
        };
    }

    fn parse_tag_name(?*Self) -> []const u8 {
        var name: []const u8 = .{};
        
        while (true) {
            const c = self.peek_char();
            if (c == '>' or c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '/') {
                break;
            }
            if (c == 0) {
                break;
            }
            name = name ++ [self.consume_char()];
        }
        
        return name;
    }

    fn skip_whitespace(?*Self) {
        common.skip_space(self.input, self.position);
    }

    fn skip_tag_name(?*Self) {
        while (true) {
            const c = self.peek_char();
            if (c == '>' or c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '/') {
                break;
            }
            if (c == 0) {
                break;
            }
            self.consume_char();
        }
    }

    fn find_next_tag(?*Self) -> u32 {
        var pos = self.position;
        while (pos < self.input.len) {
            if (self.input[pos] == '<') {
                return pos;
            }
            pos += 1;
        }
        return pos;
    }

    fn peek_char(?*Self) -> u8 {
        common.peek_char(self);
    }

    fn peek_char_at(?*Self, pos: u32) -> u8 {
        common.peek_char_at(self, pos);
    }

    fn consume_char(?*Self) -> u8 {
        common.consume_char(self);
    }

    // ═══════════════════════════════════════════════════════════
    // 3. Utility Functions
    // ═══════════════════════════════════════════════════════════

    pub fn get_element_by_name(result: HtmlParseResult, name: []const u8) -> []HtmlElement {
        var matching: []HtmlElement = .{};
        for (result.elements) |element| {
            if (bytes_are(element.name, name)) {
                matching = matching ++ [element];
            }
        }
        return matching;
    }

    pub fn get_element_attributes(result: HtmlParseResult, element_index: u32) -> []HtmlAttribute {
        if (element_index >= result.elements.len) {
            return .{};
        }
        return result.elements[element_index].attributes;
    }

    pub fn has_attribute(result: HtmlParseResult, element_index: u32, attr_name: []const u8) -> bool {
        common.has_attribute(result, element_index, attr_name);
    }

    pub fn get_attribute_value(result: HtmlParseResult, element_index: u32, attr_name: []const u8) -> ?[]const u8 {
        common.get_attribute_value(result, element_index, attr_name);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test "parse_empty_html"
        given input = ""
        when result = parse(input)
        then result.elements.len == 0

    test "parse_simple_element"
        given input = "<div></div>"
        when result = parse(input)
        then result.elements.len == 1 and bytes_are(result.elements[0].name, "div")

    test "parse_element_with_attributes"
        given input = "<div class=\"example\" id=\"main\">"
        when result = parse(input)
        then result.elements.len == 1 and 
              result.elements[0].attributes.len == 2

    test "parse_self_closing_element"
        given input = "<br/>"
        when result = parse(input)
        then result.elements.len == 1 and result.elements[0].self_closing

    test "parse_with_bom"
        given input = "\xEF\xBB\xBF<div></div>"
        when result = parse(input)
        then result.elements.len == 1

    test "bad_attr_detection"
        given input = "<div\x00bad=\"value\"></div>"
        when result = parse(input)
        then result.elements.len == 0

    test "skip_whitespace"
        given input = "  \t\n<div></div>"
        when result = parse(input)
        then result.elements.len == 1

    test "get_element_by_name"
        given input = "<div></div><span></span><div></div>"
        when result = parse(input)
        when elements = get_element_by_name(result, "div")
        then elements.len == 2

    test "has_attribute"
        given input = "<div class=\"test\"></div>"
        when result = parse(input)
        then has_attribute(result, 0, "class") == true

    test "get_attribute_value"
        given input = "<div data-value=\"42\"></div>"
        when result = parse(input)
        when value = get_attribute_value(result, 0, "data-value")
        then value.? == "42"

    test "hex_helper_functions"
        given hex_str = "2A"
        when result = from_hex(hex_str)
        then result.? == 42

    test "digit_helper_function"
        given char = '5'
        when result = digit_of(char)
        then result.? == 5

    test "bytes_are_helper"
        given a = "hello"
        given b = "hello"
        when result = bytes_are(a, b)
        then result == true

    test "bytes_are_helper_different"
        given a = "hello"
        given b = "world"
        when result = bytes_are(a, b)
        then result == false

    test "skip_space_helper"
        given data = "  \t\nhello"
        when result = skip_space(data, 0)
        then result == 4

    test "refused_hex_helper"
        given hex_str = "2AXF"
        when result = refused_hex(hex_str)
        then result == true

    test "put_byte_helper"
        given buffer = [0u8, 0u8, 0u8]
        when result = put_byte(buffer, 1, 0xFF)
        then result == true and buffer[1] == 0xFF

    test "put_code_helper_ascii"
        given buffer = [0u8, 0u8, 0u8, 0u8]
        when result = put_code(buffer, 0, 'A')
        then result == 1 and buffer[0] == 'A'

    test "put_code_helper_multibyte"
        given buffer = [0u8, 0u8, 0u8, 0u8]
        when result = put_code(buffer, 0, 0x00E9) // é
        then result == 2 and buffer[0] == 0xC3 and buffer[1] == 0xA9

    test "bad_attr_helper_empty"
        given name = ""
        when result = bad_attr(name)
        then result == true

    test "bad_attr_helper_control_char"
        given name = "attr\x01"
        when result = bad_attr(name)
        then result == true

    test "byte_order_mark_helper_present"
        given data = [0xEF, 0xBB, 0xBF, 'H', 'i']
        when result = byte_order_mark(data)
        then result.? == 0

    test "byte_order_mark_helper_absent"
        given data = "Hello"
        when result = byte_order_mark(data)
        then result == null
