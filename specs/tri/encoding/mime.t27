    // TDD
    // ═══════════════════════════════════════════════════════════

    test sample_matches_python_email
        given result = sample()
        when expected = 9
        then result == expected

    test writer_matches_python_as_bytes
        given result = writer()
        when expected = 7
        then result == expected

    test messages_outside_rfc5322_are_refused
        given result = malformed()
        when expected = 26
        then result == expected

    test bytes_outside_rfc5322_are_refused
        given result = malformed_bytes()
        when expected = 14
        then result == expected

    test header_lines_stop_at_998
        given result = header_lines()
        when expected = 4
        then result == expected

    test well_formed_messages_parse
        given result = accepted_messages()
        when expected = 6
        then result == expected

    test dates_follow_section_3_3
        given result = dates()
        when expected = 58
        then result == expected

    test weekdays_match_python
        given result = weekdays()
        when expected = 3
        then result == expected

    test address_lists_match_getaddresses
        given result = address_lists()
        when expected = 35
        then result == expected

    test writer_refuses_what_it_cannot_write
        given result = writer_refusals()
        when expected = 10
        then result == expected

    test writer_lines_stop_at_998
        given result = writer_line()
        when expected = 2
        then result == expected
