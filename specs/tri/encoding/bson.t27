    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // parse() and serialize() have no body yet, so they panic when called and
    // the serialize(parse(x)) == x round trip cannot be stated. What the
    // module states is its two types.
    //
    // Note on BsonValue: the `enum : [...]` line inside a struct does not
    // make an enum -- it lands as eleven void-typed struct fields, so the
    // eleven BSON kinds are declared but are not yet distinguishable tags.
    // The count is what holds today; the tag-ness does not.

    test bson_value_declares_the_eleven_bson_value_kinds
        // Double, String, Document, Array, Binary, ObjectId, Boolean,
        // DateTime, Null, Int32, Int64
        given kinds = std.meta.fields(BsonValue).len
        then kinds == 11

    test bson_value_kinds_carry_no_payload_yet
        // eleven void fields occupy no storage; a real BSON value would
        // carry a double, a string, a document, ...
        given size = @sizeOf(BsonValue)
        then size == 0

    test bson_document_is_still_an_empty_placeholder
        given doc = BsonDocument{}
        then std.meta.fields(@TypeOf(doc)).len == 0

