// SPDX-License-Identifier: Apache-2.0
// t27/specs/tri/encoding/xml.t27
// Simplified XML parser | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_xml.tri. The port's parse
// and format ignored their arguments ("creates empty root node for now",
// "TODO: Implement full XML parsing") and returned nothing, XmlNode had
// quoted types, and the test asserted `result != undefined`. The .tri:
// XmlNode { tag, attributes: std.StringHashMap([]const u8), children:
// []XmlNode, text }; parse(text, allocator) -> !XmlNode, "Parse XML
// document"; format(node, allocator) -> ![]u8, "Serialize to XML";
// behaviour simple, "Simplified XML parser", note "No DTD, namespaces".
// This checks the well-formedness rules of XML 1.0 (Fifth Edition) for a
// document without a DTD. Without an allocator the tree stays in the
// caller's bytes: parse(text) returns the root element as an XmlNode (its
// tag, where its start tag begins, where its content begins and ends, and
// where it ends; end is NONE when text is not one well-formed document).
// The .tri's attributes, children and text are reached through it:
// attribute(text, node, name) finds an attribute and value() decodes it,
// children() and child() walk the child elements, and inner_text() writes
// all character data of the element and its descendants (what
// ElementTree's itertext gives), with references expanded and line ends
// normalised. format is a writer into a caller buffer: open, put_attr,
// content, close_empty, put_text and close each take the write position and
// return the next one, or NONE (and pass NONE on) when out is too short, a
// name is not an XML name or a value holds a byte XML 1.0 cannot carry; a
// refused call writes nothing. Its bytes are ElementTree's tostring bytes,
// except that a carriage return in text is written &#13; (ElementTree
// writes it raw and a reader turns it into a line feed).
// Like expat without namespace processing, parse refuses: control bytes;
// a '<' or a bare '&' in text or in an attribute value; "]]>" in text; an
// undefined entity (only lt, gt, amp, apos and quot exist without a DTD);
// a character reference to a character XML does not allow (0, the other
// controls, surrogates, U+FFFE, U+FFFF, above U+10FFFF); "--" inside a
// comment; a PI target spelled xml in any case, except the declaration at
// the very start (after an optional UTF-8 byte-order mark); a malformed
// declaration (version, then optional encoding, then optional standalone
// yes or no); a duplicate attribute; mismatched or unclosed tags; and
// anything but white space, comments and PIs outside the root element. A
// colon is an ordinary name character ("No namespaces"). Where it is
// stricter than expat it says so: a DOCTYPE is refused ("No DTD"), the
// version must be 1. followed by digits (expat takes any string), and the
// only encoding accepted is UTF-8 (expat transcodes Latin-1 and others).
// Nesting deeper than MAX_DEPTH elements is refused, where expat has no
// fixed limit. NOT CHECKED: that bytes 128 and up form valid UTF-8, and
// which non-ASCII characters XML allows in a name (all are taken). The
// oracles are Python's pyexpat (no namespace processing) verdicts and
// character data, and ElementTree.tostring bytes.
// Mutation-checked 2026-10-06: 60 mutants, all killed but four
// equivalent ones (a hex digit 'G' read as 16 is already the "not a digit"
// mark; the early code > 1114111 exit only stops overflow, valid_code
// refuses the same codes; parse never starts a token inside the byte-order
// mark; an unclosed root at the end is refused by node_at too).

module TriXml;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    // an element: its start tag begins at at, its content is
    // text[content_at .. content_end], and it ends before end
    pub const XmlNode = struct {
        tag : []const u8,
        at : usize,
        content_at : usize,
        content_end : usize,
        end : usize,
    };

    // one markup or text item; name is text[name_at .. name_end] (the
    // body of a comment, CDATA section or text run, or a PI target)
    pub const Token = struct {
        kind : usize,
        name_at : usize,
        name_end : usize,
        end : usize,
    };

    pub const Attr = struct {
        name_at : usize,
        name_end : usize,
        value_at : usize,
        value_end : usize,
        end : usize,
    };

    pub const Ref = struct {
        code : u64,
        end : usize,
    };

    pub const NONE : usize = 18446744073709551615;
    pub const MAX_DEPTH : usize = 128;

    pub const TEXT : usize = 0;
    pub const START : usize = 1;
    pub const EMPTY : usize = 2;
    pub const END : usize = 3;
    pub const COMMENT : usize = 4;
    pub const PI : usize = 5;
    pub const CDATA : usize = 6;
    pub const BAD : usize = 7;

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn bad_token() -> Token {
        return Token{ .kind = BAD, .name_at = 0, .name_end = 0, .end = NONE };
    }

    fn bad_attr() -> Attr {
        return Attr{ .name_at = 0, .name_end = 0, .value_at = 0, .value_end = 0, .end = NONE };
    }

    fn bad_node() -> XmlNode {
        return XmlNode{ .tag = "", .at = 0, .content_at = 0, .content_end = 0, .end = NONE };
    }

    fn is_space(c: u8) -> bool {
        return c == 32 or c == 9 or c == 10 or c == 13;
    }

    fn is_digit(c: u8) -> bool {
        return c >= 48 and c <= 57;
    }

    fn name_start(c: u8) -> bool {
        return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c == 58 or c >= 128;
    }

    fn name_char(c: u8) -> bool {
        return name_start(c) or is_digit(c) or c == 45 or c == 46;
    }

    // a byte XML 1.0 allows; bytes 128 and up are taken as UTF-8 unchecked
    fn char_ok(c: u8) -> bool {
        return c >= 32 or c == 9 or c == 10 or c == 13;
    }

    fn same(a: []const u8, b: []const u8) -> bool {
        if (a.len != b.len) {
            return false;
        }
        var i : usize = 0;
        while (i < a.len) {
            if (a[i] != b[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn starts(text: []const u8, at: usize, s: []const u8) -> bool {
        if (at > text.len or text.len - at < s.len) {
            return false;
        }
        return same(text[at .. at + s.len], s);
    }

    // the first position at or after at where s begins, NONE if none
    fn find(text: []const u8, at: usize, s: []const u8) -> usize {
        var p = at;
        while (p < text.len) {
            if (starts(text, p, s)) {
                return p;
            }
            p = p + 1;
        }
        return NONE;
    }

    fn skip_space(text: []const u8, at: usize) -> usize {
        var p = at;
        while (p < text.len and is_space(text[p])) {
            p = p + 1;
        }
        return p;
    }

    // the end of the name starting at at, NONE if no name starts there
    fn name_end(text: []const u8, at: usize) -> usize {
        if (at >= text.len or name_start(text[at]) == false) {
            return NONE;
        }
        var p = at + 1;
        while (p < text.len and name_char(text[p])) {
            p = p + 1;
        }
        return p;
    }

    fn blank(text: []const u8, a: usize, b: usize) -> bool {
        return skip_space(text[0 .. b], a) == b;
    }

    // every byte of text[a .. b] is one XML allows
    fn bytes_ok(text: []const u8, a: usize, b: usize) -> bool {
        var i = a;
        while (i < b) {
            if (char_ok(text[i]) == false) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn valid_code(c: u64) -> bool {
        return c == 9 or c == 10 or c == 13 or (c >= 32 and c <= 55295)
            or (c >= 57344 and c <= 65533) or (c >= 65536 and c <= 1114111);
    }

    // the value of digit c in base 10 or 16, 16 when c is not one
    fn digit_of(c: u8, base: u64) -> u64 {
        if (is_digit(c)) {
            return (c as u64) - 48;
        }
        if (base == 16 and c >= 97 and c <= 102) {
            return (c as u64) - 87;
        }
        if (base == 16 and c >= 65 and c <= 70) {
            return (c as u64) - 55;
        }
        return 16;
    }

    // the entity or character reference at text[at] == '&'
    fn reference(text: []const u8, at: usize) -> Ref {
        const bad = Ref{ .code = 0, .end = NONE };
        const semi = find(text, at, ";");
        if (semi == NONE) {
            return bad;
        }
        const body = text[at + 1 .. semi];
        if (same(body, "lt")) { return Ref{ .code = 60, .end = semi + 1 }; }
        if (same(body, "gt")) { return Ref{ .code = 62, .end = semi + 1 }; }
        if (same(body, "amp")) { return Ref{ .code = 38, .end = semi + 1 }; }
        if (same(body, "apos")) { return Ref{ .code = 39, .end = semi + 1 }; }
        if (same(body, "quot")) { return Ref{ .code = 34, .end = semi + 1 }; }
        if (body.len < 2 or body[0] != 35) {
            return bad;
        }
        var base : u64 = 10;
        var i : usize = 1;
        if (body[1] == 120) {
            base = 16;
            i = 2;
        }
        var code : u64 = 0;
        while (i < body.len) {
            const d = digit_of(body[i], base);
            if (d == 16) {
                return bad;
            }
            code = code * base + d;
            if (code > 1114111) {
                return bad;
            }
            i = i + 1;
        }
        if (valid_code(code) == false) {
            return bad;
        }
        return Ref{ .code = code, .end = semi + 1 };
    }

    // text[a .. b] as character data: allowed bytes, no '<', every '&'
    // a reference, and in content (attr false) no "]]>"
    fn chars_ok(text: []const u8, a: usize, b: usize, attr: bool) -> bool {
        var i = a;
        while (i < b) {
            const c = text[i];
            if (char_ok(c) == false or c == 60) {
                return false;
            }
            if (c == 38) {
                const r = reference(text, i);
                if (r.end == NONE) {
                    return false;
                }
                i = r.end;
            } else {
                if (attr == false and starts(text, i, "]]>")) {
                    return false;
                }
                i = i + 1;
            }
        }
        return true;
    }

    // name S? '=' S? quoted value, the name starting at at
    fn attr_next(text: []const u8, at: usize) -> Attr {
        const ne = name_end(text, at);
        if (ne == NONE) {
            return bad_attr();
        }
        const e = skip_space(text, ne);
        if (e >= text.len or text[e] != 61) {
            return bad_attr();
        }
        const v = skip_space(text, e + 1);
        if (v >= text.len or (text[v] != 34 and text[v] != 39)) {
            return bad_attr();
        }
        const va = v + 1;
        var j = va;
        while (j < text.len and text[j] != text[v]) {
            j = j + 1;
        }
        if (j >= text.len or chars_ok(text, va, j, true) == false) {
            return bad_attr();
        }
        return Attr{ .name_at = at, .name_end = ne, .value_at = va, .value_end = j, .end = j + 1 };
    }

    // an attribute named name among those in text[from .. to]
    fn repeated(text: []const u8, from: usize, to: usize, name: []const u8) -> bool {
        var r = skip_space(text, from);
        while (r < to) {
            const b = attr_next(text, r);
            if (same(text[b.name_at .. b.name_end], name)) {
                return true;
            }
            r = skip_space(text, b.end);
        }
        return false;
    }

    // a start tag or empty-element tag at text[at] == '<'
    fn start_tag(text: []const u8, at: usize) -> Token {
        const ne = name_end(text, at + 1);
        if (ne == NONE) {
            return bad_token();
        }
        var p = ne;
        while (p < text.len) {
            const q = skip_space(text, p);
            if (q >= text.len) {
                return bad_token();
            }
            if (text[q] == 62) {
                return Token{ .kind = START, .name_at = at + 1, .name_end = ne, .end = q + 1 };
            }
            if (text[q] == 47) {
                if (q + 1 < text.len and text[q + 1] == 62) {
                    return Token{ .kind = EMPTY, .name_at = at + 1, .name_end = ne, .end = q + 2 };
                }
                return bad_token();
            }
            if (q == p) {
                return bad_token();
            }
            const a = attr_next(text, q);
            if (a.end == NONE or repeated(text, ne, q, text[a.name_at .. a.name_end])) {
                return bad_token();
            }
            p = a.end;
        }
        return bad_token();
    }

    fn byte_order_mark(text: []const u8) -> usize {
        if (text.len >= 3 and text[0] == 239 and text[1] == 187 and text[2] == 191) {
            return 3;
        }
        return 0;
    }

    fn lower(c: u8) -> u8 {
        if (c >= 65 and c <= 90) {
            return c + 32;
        }
        return c;
    }

    fn reserved(target: []const u8) -> bool {
        return target.len == 3 and lower(target[0]) == 120 and lower(target[1]) == 109 and lower(target[2]) == 108;
    }

    // S name '=' value, exactly that name
    fn pseudo(text: []const u8, p: usize, name: []const u8) -> Attr {
        const q = skip_space(text, p);
        if (q == p) {
            return bad_attr();
        }
        const a = attr_next(text, q);
        if (a.end == NONE or same(text[a.name_at .. a.name_end], name) == false) {
            return bad_attr();
        }
        return a;
    }

    fn version_ok(v: []const u8) -> bool {
        if (v.len < 3 or v[0] != 49 or v[1] != 46) {
            return false;
        }
        var i : usize = 2;
        while (i < v.len) {
            if (is_digit(v[i]) == false) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn utf8_name(v: []const u8) -> bool {
        return v.len == 5 and lower(v[0]) == 117 and lower(v[1]) == 116 and lower(v[2]) == 102
            and v[3] == 45 and v[4] == 56;
    }

    // the declaration's pseudo-attributes from at; text ends where "?>" begins
    fn declaration(text: []const u8, at: usize) -> bool {
        const v = pseudo(text, at, "version");
        if (v.end == NONE or version_ok(text[v.value_at .. v.value_end]) == false) {
            return false;
        }
        var p = v.end;
        const e = pseudo(text, p, "encoding");
        if (e.end != NONE) {
            if (utf8_name(text[e.value_at .. e.value_end]) == false) {
                return false;
            }
            p = e.end;
        }
        const s = pseudo(text, p, "standalone");
        if (s.end != NONE) {
            const sv = text[s.value_at .. s.value_end];
            if (same(sv, "yes") == false and same(sv, "no") == false) {
                return false;
            }
            p = s.end;
        }
        return skip_space(text, p) == text.len;
    }

    // a processing instruction (or the declaration) at text[at] == '<', '?'
    fn instruction(text: []const u8, at: usize) -> Token {
        const ne = name_end(text, at + 2);
        if (ne == NONE) {
            return bad_token();
        }
        const close_at = find(text, ne, "?>");
        if (close_at == NONE or (close_at > ne and is_space(text[ne]) == false) or bytes_ok(text, ne, close_at) == false) {
            return bad_token();
        }
        if (reserved(text[at + 2 .. ne])) {
            if (same(text[at + 2 .. ne], "xml") == false or at != byte_order_mark(text)
                    or declaration(text[0 .. close_at], ne) == false) {
                return bad_token();
            }
        }
        return Token{ .kind = PI, .name_at = at + 2, .name_end = ne, .end = close_at + 2 };
    }

    // the token starting at at < text.len
    fn token(text: []const u8, at: usize) -> Token {
        if (text[at] != 60) {
            var j = at;
            while (j < text.len and text[j] != 60) {
                j = j + 1;
            }
            if (chars_ok(text, at, j, false) == false) {
                return bad_token();
            }
            return Token{ .kind = TEXT, .name_at = at, .name_end = j, .end = j };
        }
        if (starts(text, at, "<!--")) {
            const c = find(text, at + 4, "--");
            if (c == NONE or starts(text, c, "-->") == false or bytes_ok(text, at + 4, c) == false) {
                return bad_token();
            }
            return Token{ .kind = COMMENT, .name_at = at + 4, .name_end = c, .end = c + 3 };
        }
        if (starts(text, at, "<![CDATA[")) {
            const c = find(text, at + 9, "]]>");
            if (c == NONE or bytes_ok(text, at + 9, c) == false) {
                return bad_token();
            }
            return Token{ .kind = CDATA, .name_at = at + 9, .name_end = c, .end = c + 3 };
        }
        if (starts(text, at, "<?")) {
            return instruction(text, at);
        }
        if (starts(text, at, "</")) {
            const ne = name_end(text, at + 2);
            if (ne == NONE) {
                return bad_token();
            }
            const p = skip_space(text, ne);
            if (p >= text.len or text[p] != 62) {
                return bad_token();
            }
            return Token{ .kind = END, .name_at = at + 2, .name_end = ne, .end = p + 1 };
        }
        return start_tag(text, at);
    }

    // the element whose start tag is at at, in a document parse accepted
    fn node_at(text: []const u8, at: usize) -> XmlNode {
        const t = token(text, at);
        const tag = text[t.name_at .. t.name_end];
        if (t.kind == EMPTY) {
            return XmlNode{ .tag = tag, .at = at, .content_at = t.end, .content_end = t.end, .end = t.end };
        }
        var depth : usize = 1;
        var p = t.end;
        while (p < text.len) {
            const u = token(text, p);
            if (u.kind == START) {
                depth = depth + 1;
            }
            if (u.kind == END) {
                depth = depth - 1;
                if (depth == 0) {
                    return XmlNode{ .tag = tag, .at = at, .content_at = t.end, .content_end = p, .end = u.end };
                }
            }
            p = u.end;
        }
        return bad_node();
    }

    fn parse(text: []const u8) -> XmlNode {
        var opens : [128]usize = [0] ** 128;
        var closes : [128]usize = [0] ** 128;
        var depth : usize = 0;
        var root : usize = NONE;
        var at = byte_order_mark(text);
        while (at < text.len) {
            const t = token(text, at);
            if (t.kind == BAD) {
                return bad_node();
            }
            if (depth == 0) {
                if (t.kind == TEXT and blank(text, at, t.end) == false) {
                    return bad_node();
                }
                if (t.kind == CDATA or t.kind == END) {
                    return bad_node();
                }
                if (t.kind == START or t.kind == EMPTY) {
                    if (root != NONE) {
                        return bad_node();
                    }
                    root = at;
                }
            }
            if (t.kind == START) {
                if (depth == MAX_DEPTH) {
                    return bad_node();
                }
                opens[depth] = t.name_at;
                closes[depth] = t.name_end;
                depth = depth + 1;
            }
            if (t.kind == END) {
                if (same(text[t.name_at .. t.name_end], text[opens[depth - 1] .. closes[depth - 1]]) == false) {
                    return bad_node();
                }
                depth = depth - 1;
            }
            at = t.end;
        }
        if (depth != 0 or root == NONE) {
            return bad_node();
        }
        return node_at(text, root);
    }

    // the number of child elements of node
    fn children(text: []const u8, node: XmlNode) -> usize {
        var n : usize = 0;
        var p = node.content_at;
        while (p < node.content_end) {
            const t = token(text, p);
            if (t.kind == START or t.kind == EMPTY) {
                n = n + 1;
                p = node_at(text, p).end;
            } else {
                p = t.end;
            }
        }
        return n;
    }

    // child element i (from 0) of node; end NONE when there is none
    fn child(text: []const u8, node: XmlNode, i: usize) -> XmlNode {
        var n : usize = 0;
        var p = node.content_at;
        while (p < node.content_end) {
            const t = token(text, p);
            if (t.kind == START or t.kind == EMPTY) {
                const c = node_at(text, p);
                if (n == i) {
                    return c;
                }
                n = n + 1;
                p = c.end;
            } else {
                p = t.end;
            }
        }
        return bad_node();
    }

    // node's attribute named name; end NONE when it has none
    fn attribute(text: []const u8, node: XmlNode, name: []const u8) -> Attr {
        var r = skip_space(text, node.at + 1 + node.tag.len);
        while (text[r] != 62 and text[r] != 47) {
            const a = attr_next(text, r);
            if (same(text[a.name_at .. a.name_end], name)) {
                return a;
            }
            r = skip_space(text, a.end);
        }
        return bad_attr();
    }

    fn put_byte(out: []u8, n: usize, b: u8) -> usize {
        if (n >= out.len) {
            return NONE;
        }
        out[n] = b;
        return n + 1;
    }

    // character code as UTF-8
    fn put_code(out: []u8, n: usize, code: u64) -> usize {
        var w : usize = 1;
        if (code >= 128) { w = 2; }
        if (code >= 2048) { w = 3; }
        if (code >= 65536) { w = 4; }
        if (n > out.len or out.len - n < w) {
            return NONE;
        }
        if (w == 1) {
            out[n] = code as u8;
        } else if (w == 2) {
            out[n] = (192 + code / 64) as u8;
        } else if (w == 3) {
            out[n] = (224 + code / 4096) as u8;
        } else {
            out[n] = (240 + code / 262144) as u8;
        }
        var k : usize = 1;
        while (k < w) {
            var shift : u64 = 1;
            var j : usize = k;
            while (j < w - 1) {
                shift = shift * 64;
                j = j + 1;
            }
            out[n + k] = (128 + (code / shift) % 64) as u8;
            k = k + 1;
        }
        return n + w;
    }

    // text[a .. b] decoded after out[0 .. n]: line ends normalised, then in
    // an attribute (attr) tab and line feed become spaces, and with refs
    // the references expanded; the new length, NONE when out is too short
    fn decode(text: []const u8, a: usize, b: usize, attr: bool, refs: bool, out: []u8, n: usize) -> usize {
        var i = a;
        var m = n;
        while (i < b) {
            const c = text[i];
            if (c == 38 and refs) {
                const r = reference(text, i);
                m = put_code(out, m, r.code);
                i = r.end;
            } else {
                var x = c;
                i = i + 1;
                if (c == 13) {
                    x = 10;
                    if (i < b and text[i] == 10) {
                        i = i + 1;
                    }
                }
                if (attr and (x == 9 or x == 10)) {
                    x = 32;
                }
                m = put_byte(out, m, x);
            }
        }
        return m;
    }

    // the decoded value of an attribute found by attribute()
    fn value(text: []const u8, a: Attr, out: []u8) -> usize {
        if (a.end == NONE) {
            return NONE;
        }
        return decode(text, a.value_at, a.value_end, true, true, out, 0);
    }

    // all character data in node and its descendants, decoded into out
    fn inner_text(text: []const u8, node: XmlNode, out: []u8) -> usize {
        var p = node.content_at;
        var m : usize = 0;
        while (p < node.content_end) {
            const t = token(text, p);
            if (t.kind == TEXT) {
                m = decode(text, p, t.end, false, true, out, m);
            }
            if (t.kind == CDATA) {
                m = decode(text, t.name_at, t.name_end, false, false, out, m);
            }
            p = t.end;
        }
        return m;
    }

    // ── writer ──

    fn room(out: []u8, at: usize, n: usize) -> bool {
        return at <= out.len and out.len - at >= n;
    }

    fn copy_at(src: []const u8, out: []u8, at: usize) -> usize {
        var i : usize = 0;
        while (i < src.len) {
            out[at + i] = src[i];
            i = i + 1;
        }
        return at + src.len;
    }

    fn name_ok(name: []const u8) -> bool {
        return name.len > 0 and name_end(name, 0) == name.len;
    }

    // what c is written as, empty when it is written as itself
    fn escape(c: u8, attr: bool) -> []const u8 {
        if (c == 38) { return "&amp;"; }
        if (c == 60) { return "&lt;"; }
        if (c == 62) { return "&gt;"; }
        if (c == 13) { return "&#13;"; }
        if (attr and c == 34) { return "&quot;"; }
        if (attr and c == 9) { return "&#09;"; }
        if (attr and c == 10) { return "&#10;"; }
        return "";
    }

    // bytes s takes escaped, NONE when it holds a byte XML cannot carry
    fn escaped_len(s: []const u8, attr: bool) -> usize {
        var n : usize = 0;
        var i : usize = 0;
        while (i < s.len) {
            if (char_ok(s[i]) == false) {
                return NONE;
            }
            const e = escape(s[i], attr);
            if (e.len == 0) {
                n = n + 1;
            } else {
                n = n + e.len;
            }
            i = i + 1;
        }
        return n;
    }

    fn put_escaped(out: []u8, at: usize, s: []const u8, attr: bool) -> usize {
        var p = at;
        var i : usize = 0;
        while (i < s.len) {
            const e = escape(s[i], attr);
            if (e.len == 0) {
                out[p] = s[i];
                p = p + 1;
            } else {
                p = copy_at(e, out, p);
            }
            i = i + 1;
        }
        return p;
    }

    // "<tag"
    fn open(out: []u8, at: usize, tag: []const u8) -> usize {
        if (name_ok(tag) == false or room(out, at, 1 + tag.len) == false) {
            return NONE;
        }
        out[at] = 60;
        return copy_at(tag, out, at + 1);
    }

    // ` name="value"`, value escaped
    fn put_attr(out: []u8, at: usize, name: []const u8, v: []const u8) -> usize {
        const n = escaped_len(v, true);
        if (name_ok(name) == false or n == NONE or room(out, at, 4 + name.len + n) == false) {
            return NONE;
        }
        out[at] = 32;
        var p = copy_at(name, out, at + 1);
        out[p] = 61;
        out[p + 1] = 34;
        p = put_escaped(out, p + 2, v, true);
        out[p] = 34;
        return p + 1;
    }

    // ">" ends a start tag
    fn content(out: []u8, at: usize) -> usize {
        if (room(out, at, 1) == false) {
            return NONE;
        }
        out[at] = 62;
        return at + 1;
    }

    // " />" ends an empty element
    fn close_empty(out: []u8, at: usize) -> usize {
        if (room(out, at, 3) == false) {
            return NONE;
        }
        return copy_at(" />", out, at);
    }

    fn put_text(out: []u8, at: usize, s: []const u8) -> usize {
        const n = escaped_len(s, false);
        if (n == NONE or room(out, at, n) == false) {
            return NONE;
        }
        return put_escaped(out, at, s, false);
    }

    // "</tag>"
    fn close(out: []u8, at: usize, tag: []const u8) -> usize {
        if (name_ok(tag) == false or room(out, at, 3 + tag.len) == false) {
            return NONE;
        }
        var p = copy_at("</", out, at);
        p = copy_at(tag, out, p);
        out[p] = 62;
        return p + 1;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    fn hex_value(c: u8) -> usize {
        if (c >= 97) {
            return (c as usize) - 87;
        }
        return (c as usize) - 48;
    }

    fn from_hex(hex: []const u8, out: []u8) -> []u8 {
        var i : usize = 0;
        while (2 * i < hex.len) {
            out[i] = (hex_value(hex[2 * i]) * 16 + hex_value(hex[2 * i + 1])) as u8;
            i = i + 1;
        }
        return out[0 .. i];
    }

    fn bytes_are(d: []const u8, hex: []const u8) -> bool {
        if (hex.len != 2 * d.len) {
            return false;
        }
        var i : usize = 0;
        while (i < d.len) {
            if ((d[i] as usize) != hex_value(hex[2 * i]) * 16 + hex_value(hex[2 * i + 1])) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn refused(s: []const u8) -> usize {
        if (parse(s).end == NONE) {
            return 1;
        }
        return 0;
    }

    fn accepted(s: []const u8, tag: []const u8) -> usize {
        const n = parse(s);
        if (n.end != NONE and same(n.tag, tag)) {
            return 1;
        }
        return 0;
    }

    fn refused_hex(hex: []const u8) -> usize {
        var buf : [64]u8 = [0] ** 64;
        return refused(from_hex(hex, &buf));
    }

    fn accepted_hex(hex: []const u8, tag: []const u8) -> usize {
        var buf : [64]u8 = [0] ** 64;
        return accepted(from_hex(hex, &buf), tag);
    }

    // pyexpat: root r, character data "t<<&z" U+10FFFF, a = "1&2", b = "x\ty"
    fn sample() -> usize {
        const s = "<?xml version='1.0' encoding='UTF-8'?><!-- c --><r a='1&amp;2' b='x&#9;y'><s>t&lt;</s><?p d?><u k='v'/><![CDATA[<&]]>z&#x10FFFF;</r>";
        var out : [16]u8 = [0] ** 16;
        var ok : usize = 0;
        const r = parse(s);
        if (r.end == s.len and s.len == 132 and same(r.tag, "r") and r.at == 48) { ok = ok + 1; }
        const n = inner_text(s, r, &out);
        if (n == 9 and bytes_are(out[0 .. 9], "743c3c267af48fbfbf")) { ok = ok + 1; }
        if (value(s, attribute(s, r, "a"), &out) == 3 and same(out[0 .. 3], "1&2")) { ok = ok + 1; }
        if (value(s, attribute(s, r, "b"), &out) == 3 and bytes_are(out[0 .. 3], "780979")) { ok = ok + 1; }
        if (attribute(s, r, "c").end == NONE and value(s, attribute(s, r, "c"), &out) == NONE) { ok = ok + 1; }
        if (children(s, r) == 2 and same(child(s, r, 0).tag, "s") and same(child(s, r, 1).tag, "u")) { ok = ok + 1; }
        const u = child(s, r, 1);
        if (child(s, r, 2).end == NONE and u.content_at == u.end and children(s, u) == 0 and attribute(s, u, "z").end == NONE) { ok = ok + 1; }
        if (value(s, attribute(s, u, "k"), &out) == 1 and out[0] == 118) { ok = ok + 1; }
        const t = child(s, r, 0);
        if (inner_text(s, t, &out) == 2 and same(out[0 .. 2], "t<") and same(s[t.content_at .. t.content_end], "t&lt;")) { ok = ok + 1; }
        if (inner_text(s, r, out[0 .. 8]) == NONE and inner_text(s, t, out[0 .. 1]) == NONE) { ok = ok + 1; }
        return ok;
    }

    // each of these pyexpat refuses
    fn malformed() -> usize {
        var ok : usize = 0;
        ok = ok + refused("");
        ok = ok + refused("   ");
        ok = ok + refused("<?xml version='1.0' standalone='maybe'?><a/>");
        ok = ok + refused(" <?xml version='1.0'?><a/>");
        ok = ok + refused("<a/><?xml version='1.0'?>");
        ok = ok + refused("<?xml?><a/>");
        ok = ok + refused("<?XML version='1.0'?><a/>");
        ok = ok + refused("<a><?XmL x?></a>");
        ok = ok + refused("<?xml version='1.0'encoding='utf-8'?><a/>");
        ok = ok + refused("<?xml version='1.0' standalone='no' encoding='utf-8'?><a/>");
        ok = ok + refused("<?xml encoding='utf-8'?><a/>");
        ok = ok + refused("<?xml version='1.0' encoding='1x'?><a/>");
        ok = ok + refused("<?xml version='1.0' foo='1'?><a/>");
        ok = ok + refused("<?a?b?><a/>");
        ok = ok + refused("<a><!-- c -- d --></a>");
        ok = ok + refused("<a><!-- c ---></a>");
        ok = ok + refused("<a><!--x-></a>");
        ok = ok + refused("<![CDATA[x]]><a/>");
        ok = ok + refused("<a><![CDATA[x]]</a>");
        ok = ok + refused("<a><![CDAT[x]]></a>");
        ok = ok + refused("<a>]]></a>");
        ok = ok + refused("<a>&nbsp;</a>");
        ok = ok + refused("<a>&#0;</a>");
        ok = ok + refused("<a>&#1;</a>");
        ok = ok + refused("<a>&#xD800;</a>");
        ok = ok + refused("<a>&#x110000;</a>");
        ok = ok + refused("<a>&#xFFFE;</a>");
        ok = ok + refused("<a>&#xFFFF;</a>");
        ok = ok + refused("<a>&#99999999999999999999999999;</a>");
        ok = ok + refused("<a>&#;</a>");
        ok = ok + refused("<a>&#x;</a>");
        ok = ok + refused("<a>&amp</a>");
        ok = ok + refused("<a>&#X41;</a>");
        ok = ok + refused("<a>& </a>");
        ok = ok + refused("<a>&#65a;</a>");
        ok = ok + refused("<a b='1' b='2'/>");
        ok = ok + refused("<a b='1' c='2' b='3'/>");
        ok = ok + refused("<a b='1'c='2'/>");
        ok = ok + refused("<a b=1/>");
        ok = ok + refused("<a b='<'/>");
        ok = ok + refused("<a b='&'/>");
        ok = ok + refused("<a></b>");
        ok = ok + refused("<a><b></a></b>");
        ok = ok + refused("<a>");
        ok = ok + refused("</a>");
        ok = ok + refused("<a/><b/>");
        ok = ok + refused("<a/>x");
        ok = ok + refused("<a/>&amp;");
        ok = ok + refused("<a/><!--x");
        ok = ok + refused("x<a/>");
        ok = ok + refused("<1a/>");
        ok = ok + refused("<-a/>");
        ok = ok + refused("<a></ a>");
        ok = ok + refused("< a/>");
        ok = ok + refused("<a/ >");
        ok = ok + refused("<a b/>");
        ok = ok + refused("<a b=/>");
        ok = ok + refused_hex("3c613e013c2f613e");
        ok = ok + refused_hex("3c6120623d27011b272f3e");
        ok = ok + refused_hex("3c613e3c212d2d012d2d3e3c2f613e");
        ok = ok + refused_hex("3c613e1f3c2f613e");
        ok = ok + refused_hex("3c613e3c215b43444154415b015d5d3e3c2f613e");
        ok = ok + refused("<r><a/x></r>");
        ok = ok + refused("<r><a></a x></r>");
        return ok;
    }

    // each of these pyexpat accepts, with this root tag
    fn well_formed() -> usize {
        var ok : usize = 0;
        ok = ok + accepted("<a/>", "a");
        ok = ok + accepted("<a></a>", "a");
        ok = ok + accepted("<?xml version='1.0'?><a/>", "a");
        ok = ok + accepted("<?xml version='1.1'?><a/>", "a");
        ok = ok + accepted("<?xml  version = '1.0'  encoding = 'UTF-8' ?><a/>", "a");
        ok = ok + accepted("<?xml version='1.0' encoding='utf-8' standalone='yes'?><a/>", "a");
        ok = ok + accepted("<?xml version='1.0' standalone='no'?><a/>", "a");
        ok = ok + accepted("<?xml version='1.0' ?><a/>", "a");
        ok = ok + accepted("<a><?xml-stylesheet x?></a>", "a");
        ok = ok + accepted("<?xmlx?><a/>", "a");
        ok = ok + accepted("<a><?pi?></a>", "a");
        ok = ok + accepted("<?a ?><a/>", "a");
        ok = ok + accepted("<a><!----></a>", "a");
        ok = ok + accepted("<a><!-- - --></a>", "a");
        ok = ok + accepted("<a/> ", "a");
        ok = ok + accepted("<a1-.:_b/>", "a1-.:_b");
        ok = ok + accepted("<:a/>", ":a");
        ok = ok + accepted("<_a/>", "_a");
        ok = ok + accepted("<a ></a >", "a");
        ok = ok + accepted("<a b = '1' />", "a");
        ok = ok + accepted("<a b='>' c='&#60;&lt;'/>", "a");
        ok = ok + accepted("<a>]]</a>", "a");
        ok = ok + accepted("<a>]>]]&gt;</a>", "a");
        ok = ok + accepted("<a><![CDATA[]]]></a>", "a");
        ok = ok + accepted("<a><b><c/></b>t</a>", "a");
        ok = ok + accepted_hex("3c6120623d27222720633d2227222f3e", "a");
        ok = ok + accepted_hex("3c6109623d2731270a2f3e", "a");
        ok = ok + accepted_hex("efbbbf3c612f3e", "a");
        ok = ok + accepted_hex("efbbbf3c3f786d6c2076657273696f6e3d27312e30273f3e3c612f3e", "a");
        ok = ok + accepted_hex("3c613e7f3c2f613e", "a");
        var buf : [8]u8 = [0] ** 8;
        const n = parse(from_hex("3cc4802f3e", &buf));
        if (n.end == 5 and bytes_are(n.tag, "c480")) { ok = ok + 1; }
        return ok;
    }

    // a root followed by comments and PIs: end is the root's end
    fn misc_after_root() -> bool {
        const s = "<!--x--><a/><!--y--><?p?>";
        const r = parse(s);
        return r.at == 8 and r.end == 12 and same(r.tag, "a");
    }

    // pyexpat accepts these; the .tri's "No DTD" and UTF-8-only text refuse them
    fn stricter_than_expat() -> usize {
        var ok : usize = 0;
        ok = ok + refused("<!DOCTYPE a><a/>");
        ok = ok + refused("<?xml version='1.0' encoding='latin1'?><a/>");
        ok = ok + refused("<?xml version='2.0'?><a/>");
        ok = ok + refused("<?xml version=''?><a/>");
        ok = ok + refused("<?xml version='1.x'?><a/>");
        ok = ok + refused("<?xml version='1x0'?><a/>");
        ok = ok + refused("<?xml version='1.'?><a/>");
        return ok;
    }

    // all character data of the root is the UTF-8 hex given (pyexpat)
    fn text_is(s: []const u8, hex: []const u8) -> usize {
        var out : [16]u8 = [0] ** 16;
        const n = parse(s);
        if (n.end == NONE) {
            return 0;
        }
        const m = inner_text(s, n, &out);
        if (m != NONE and bytes_are(out[0 .. m], hex)) {
            return 1;
        }
        return 0;
    }

    fn references() -> usize {
        var ok : usize = 0;
        ok = ok + text_is("<a>&lt;&gt;&amp;&apos;&quot;</a>", "3c3e262722");
        ok = ok + text_is("<a>&#65;&#x42;&#x0041;&#00065;</a>", "41424141");
        ok = ok + text_is("<a>&#9;&#10;&#13;&#32;</a>", "090a0d20");
        ok = ok + text_is("<a>&#x7F;&#x80;&#x7FF;&#x800;</a>", "7fc280dfbfe0a080");
        ok = ok + text_is("<a>&#xD7FF;&#xE000;&#xFFFD;</a>", "ed9fbfee8080efbfbd");
        ok = ok + text_is("<a>&#x10000;&#x1F600;&#x10FFFF;</a>", "f0908080f09f9880f48fbfbf");
        ok = ok + text_is("<a>&#xaB;&#xAb;</a>", "c2abc2ab");
        ok = ok + text_is("<a>&#x40000;</a>", "f1808080");
        ok = ok + text_is("<a>x<!--c-->y<?p?>z<b>w</b></a>", "78797a77");
        ok = ok + text_is("<a><![CDATA[<&]]></a>", "3c26");
        ok = ok + refused("<a>&#x8;</a>");
        ok = ok + refused("<a>&#31;</a>");
        ok = ok + refused("<a>&#xDFFF;</a>");
        ok = ok + refused("<a>&#xg;</a>");
        return ok;
    }

    // line ends and attribute white space, as pyexpat reports them
    fn normalisation() -> usize {
        var buf : [64]u8 = [0] ** 64;
        var out : [16]u8 = [0] ** 16;
        var ok : usize = 0;
        var s = from_hex("3c6120623d22780d0a790d7a0a09222f3e", &buf);
        var r = parse(s);
        if (value(s, attribute(s, r, "b"), &out) == 7 and same(out[0 .. 7], "x y z  ")) { ok = ok + 1; }
        s = from_hex("3c613e780d0a790d7a0a3c2f613e", &buf);
        r = parse(s);
        if (inner_text(s, r, &out) == 6 and bytes_are(out[0 .. 6], "780a790a7a0a") and inner_text(s, r, out[0 .. 5]) == NONE) { ok = ok + 1; }
        s = from_hex("3c613e3c215b43444154415b780d0a790d5d5d3e3c2f613e", &buf);
        r = parse(s);
        if (inner_text(s, r, &out) == 4 and bytes_are(out[0 .. 4], "780a790a")) { ok = ok + 1; }
        s = from_hex("3c6120623d222623393b262331303b262331333b222f3e", &buf);
        r = parse(s);
        if (value(s, attribute(s, r, "b"), &out) == 3 and bytes_are(out[0 .. 3], "090a0d")) { ok = ok + 1; }
        s = from_hex("3c613e0d3c2f613e", &buf);
        r = parse(s);
        if (inner_text(s, r, &out) == 1 and out[0] == 10) { ok = ok + 1; }
        return ok;
    }

    // ElementTree.tostring of <a b=V>T<c/>t</a>, V and T the hex inputs
    fn writer_matches_elementtree() -> bool {
        var buf : [16]u8 = [0] ** 16;
        var buf2 : [16]u8 = [0] ** 16;
        var out : [96]u8 = [42] ** 96;
        const v = from_hex("263c3e2227090a0d2078", &buf);
        const t = from_hex("263c3e2227090a205d5d3e", &buf2);
        var at = open(&out, 0, "a");
        at = put_attr(&out, at, "b", v);
        at = content(&out, at);
        at = put_text(&out, at, t);
        at = open(&out, at, "c");
        at = close_empty(&out, at);
        at = put_text(&out, at, "t");
        at = close(&out, at, "a");
        return at == 79 and out[79] == 42 and bytes_are(out[0 .. 79],
            "3c6120623d2226616d703b266c743b2667743b2671756f743b27262330393b262331303b262331333b2078223e26616d703b266c743b2667743b2227090a205d5d2667743b3c63202f3e743c2f613e");
    }

    fn writer_refusals() -> usize {
        var o1 : [16]u8 = [42] ** 16;
        var o2 : [16]u8 = [42] ** 16;
        var o3 : [16]u8 = [42] ** 16;
        var o4 : [16]u8 = [42] ** 16;
        var o5 : [16]u8 = [42] ** 16;
        var o6 : [16]u8 = [42] ** 16;
        var bad : [3]u8 = [97, 1, 98];
        var ok : usize = 0;
        if (open(&o1, 0, "") == NONE and open(&o1, 0, "1a") == NONE and open(&o1, 0, "a b") == NONE and o1[0] == 42) { ok = ok + 1; }
        if (open(&o1, 14, "ab") == NONE and o1[14] == 42 and open(&o1, 13, "ab") == 16) { ok = ok + 1; }
        if (put_attr(&o2, 0, "a", &bad) == NONE and put_text(&o2, 0, &bad) == NONE and o2[0] == 42) { ok = ok + 1; }
        if (put_attr(&o2, 0, "-", "v") == NONE and put_attr(&o2, 11, "a", "v") == NONE and o2[0] == 42 and o2[11] == 42) { ok = ok + 1; }
        if (put_attr(&o3, 8, "a", "<") == NONE and o3[8] == 42 and put_attr(&o3, 7, "a", "<") == 16) { ok = ok + 1; }
        if (put_text(&o4, 12, "a&") == NONE and o4[12] == 42 and put_text(&o4, 10, "a&") == 16) { ok = ok + 1; }
        if (close(&o5, 12, "ab") == NONE and close(&o5, 0, "") == NONE and o5[0] == 42 and o5[12] == 42 and close(&o5, 11, "ab") == 16) { ok = ok + 1; }
        if (content(&o6, 16) == NONE and content(&o6, 15) == 16 and close_empty(&o6, 14) == NONE and o6[14] == 42 and close_empty(&o6, 13) == 16) { ok = ok + 1; }
        if (open(&o6, NONE, "a") == NONE and put_text(&o6, NONE, "a") == NONE and close(&o6, NONE, "a") == NONE and content(&o6, NONE) == NONE) { ok = ok + 1; }
        if (put_text(&o6, 0, "") == 0 and put_text(&o6, 16, "") == 16 and put_text(&o6, 17, "") == NONE) { ok = ok + 1; }
        return ok;
    }

    fn deep(n: usize, out: []u8) -> []u8 {
        var at : usize = 0;
        var i : usize = 0;
        while (i < n) {
            at = content(out, open(out, at, "a"));
            i = i + 1;
        }
        i = 0;
        while (i < n) {
            at = close(out, at, "a");
            i = i + 1;
        }
        return out[0 .. at];
    }

    fn depth_limit() -> bool {
        var buf : [1024]u8 = [0] ** 1024;
        const ok = parse(deep(MAX_DEPTH, &buf)).end == 7 * MAX_DEPTH;
        return ok and parse(deep(MAX_DEPTH + 1, &buf)).end == NONE;
    }

    fn count_elements(text: []const u8, node: XmlNode) -> usize {
        var n : usize = 1;
        var p = node.content_at;
        while (p < node.content_end) {
            const t = token(text, p);
            if (t.kind == START or t.kind == EMPTY) {
                n = n + 1;
            }
            p = t.end;
        }
        return n;
    }

    fn lcg(s: usize) -> usize {
        return (s * 1103515245 + 12345) % 2147483648;
    }

    // random trees through the writer parse back to the same character
    // data, root attribute and element count
    fn round_trips() -> usize {
        const tags = "abc";
        var alphabet : [13]u8 = [38, 60, 62, 34, 39, 9, 10, 13, 93, 97, 32, 35, 59];
        var s : usize = 2026;
        var ok : usize = 0;
        var trial : usize = 0;
        while (trial < 30) {
            var out : [2048]u8 = [0] ** 2048;
            var want : [256]u8 = [0] ** 256;
            var got : [256]u8 = [0] ** 256;
            var rv : [8]u8 = [0] ** 8;
            var gv : [8]u8 = [0] ** 8;
            var stack : [8]usize = [0] ** 8;
            var wn : usize = 0;
            s = lcg(s);
            const rl = (s / 7) % 8;
            var k : usize = 0;
            while (k < rl) {
                s = lcg(s);
                rv[k] = alphabet[(s / 11) % 13];
                k = k + 1;
            }
            var at = open(&out, 0, "a");
            at = content(&out, put_attr(&out, at, "k", rv[0 .. rl]));
            var depth : usize = 1;
            var elements : usize = 1;
            var step : usize = 0;
            while (step < 40) {
                s = lcg(s);
                const op = (s / 13) % 4;
                if (op == 0 and depth < 7) {
                    const t = (s / 101) % 3;
                    at = open(&out, at, tags[t .. t + 1]);
                    elements = elements + 1;
                    if ((s / 997) % 2 == 0) {
                        at = close_empty(&out, at);
                    } else {
                        at = content(&out, at);
                        stack[depth] = t;
                        depth = depth + 1;
                    }
                } else if (op == 1 and depth > 1) {
                    depth = depth - 1;
                    const t = stack[depth];
                    at = close(&out, at, tags[t .. t + 1]);
                } else {
                    var piece : [5]u8 = [0] ** 5;
                    const pl = 1 + (s / 17) % 5;
                    var j : usize = 0;
                    while (j < pl) {
                        s = lcg(s);
                        piece[j] = alphabet[(s / 19) % 13];
                        want[wn] = piece[j];
                        wn = wn + 1;
                        j = j + 1;
                    }
                    at = put_text(&out, at, piece[0 .. pl]);
                }
                step = step + 1;
            }
            while (depth > 1) {
                depth = depth - 1;
                const t = stack[depth];
                at = close(&out, at, tags[t .. t + 1]);
            }
            at = close(&out, at, "a");
            if (at != NONE) {
                const text = out[0 .. at];
                const r = parse(text);
                if (r.end == at and same(r.tag, "a") and count_elements(text, r) == elements) {
                    const gn = inner_text(text, r, &got);
                    const vn = value(text, attribute(text, r, "k"), &gv);
                    if (gn == wn and vn == rl and same(got[0 .. wn], want[0 .. wn]) and same(gv[0 .. rl], rv[0 .. rl])) {
                        ok = ok + 1;
                    }
                }
            }
            trial = trial + 1;
        }
        return ok;
    }

    test sample_matches_pyexpat
        given result = sample()
        when expected = 10
        then result == expected

    test malformed_documents_are_refused
        given result = malformed()
        when expected = 64
        then result == expected

    test well_formed_documents_parse
        given result = well_formed()
        when expected = 31
        then result == expected

    test comments_and_pis_may_follow_the_root
        given result = misc_after_root()
        when expected = true
        then result == expected

    test no_dtd_and_utf8_only
        given result = stricter_than_expat()
        when expected = 7
        then result == expected

    test references_decode_to_utf8
        given result = references()
        when expected = 14
        then result == expected

    test line_ends_and_attribute_space_are_normalised
        given result = normalisation()
        when expected = 5
        then result == expected

    test writer_matches_elementtree_bytes
        given result = writer_matches_elementtree()
        when expected = true
        then result == expected

    test writer_refuses_before_writing
        given result = writer_refusals()
        when expected = 10
        then result == expected

    test nesting_stops_at_max_depth
        given result = depth_limit()
        when expected = true
        then result == expected

    test random_trees_round_trip
        given result = round_trips()
        when expected = 30
        then result == expected
