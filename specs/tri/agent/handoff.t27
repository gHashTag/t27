// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// | | φ² + 1/φ² = 3 | TRINITY

module Handoff;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const PlannerOutput = struct {
        issue_number : u32,
        subtasks : [4]str,
        files : [4]str,
        approach : str,
        spec_path : str,
        timestamp : i32,
        cost_tokens_in : u32,
        cost_tokens_out : u32,
        cost_usd : u32,
    };

    pub const CoderOutput = struct {
        issue_number : u32,
        branch : str,
        files_modified : [4]str,
        commits : [4]str,
        lines_added : u32,
        lines_removed : u32,
        timestamp : i32,
        cost_tokens_in : u32,
        cost_tokens_out : u32,
        cost_usd : u32,
    };

    pub const ReviewerVerdict = struct {
        issue_number : u32,
        approved : bool,
        feedback : [4]str,
        iteration : u8,
        max_iterations : u8,
        files_reviewed : [4]str,
        timestamp : i32,
        cost_tokens_in : u32,
        cost_tokens_out : u32,
        cost_usd : u32,
    };

    pub const TesterReport = struct {
        issue_number : u32,
        tests_passed : u32,
        tests_total : u32,
        benchmarks : [4]str,
        regressions : [4]str,
        timestamp : i32,
    };

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test planner_output_creation {
        const output = PlannerOutput{
            .issue_number = 6520,
            .subtasks = ["task1", "task2", "task3", ""],
            .files = ["file1", "file2", "file3", ""],
            .approach = "test approach",
            .spec_path = "specs/tri/agent/handoff.t27",
            .timestamp = 1234567890,
            .cost_tokens_in = 1000,
            .cost_tokens_out = 500,
            .cost_usd = 10,
        };
        assert output.issue_number == 6520;
        assert output.subtasks[0] == "task1";
        assert output.files[1] == "file2";
        assert output.approach == "test approach";
        assert output.spec_path == "specs/tri/agent/handoff.t27";
        assert output.timestamp == 1234567890;
        assert output.cost_tokens_in == 1000;
        assert output.cost_tokens_out == 500;
        assert output.cost_usd == 10;
    }

    test coder_output_creation {
        const output = CoderOutput{
            .issue_number = 6520,
            .branch = "queen-6520",
            .files_modified = ["file1", "file2", "file3", ""],
            .commits = ["commit1", "commit2", "commit3", ""],
            .lines_added = 100,
            .lines_removed = 50,
            .timestamp = 1234567890,
            .cost_tokens_in = 2000,
            .cost_tokens_out = 1000,
            .cost_usd = 20,
        };
        assert output.issue_number == 6520;
        assert output.branch == "queen-6520";
        assert output.files_modified[0] == "file1";
        assert output.commits[1] == "commit2";
        assert output.lines_added == 100;
        assert output.lines_removed == 50;
        assert output.timestamp == 1234567890;
        assert output.cost_tokens_in == 2000;
        assert output.cost_tokens_out == 1000;
        assert output.cost_usd == 20;
    }

    test reviewer_verdict_creation {
        const verdict = ReviewerVerdict{
            .issue_number = 6520,
            .approved = true,
            .feedback = ["good", "needs work", "approved", ""],
            .iteration = 1,
            .max_iterations = 3,
            .files_reviewed = ["file1", "file2", "file3", ""],
            .timestamp = 1234567890,
            .cost_tokens_in = 1500,
            .cost_tokens_out = 750,
            .cost_usd = 15,
        };
        assert verdict.issue_number == 6520;
        assert verdict.approved == true;
        assert verdict.feedback[0] == "good";
        assert verdict.iteration == 1;
        assert verdict.max_iterations == 3;
        assert verdict.files_reviewed[1] == "file2";
        assert verdict.timestamp == 1234567890;
        assert verdict.cost_tokens_in == 1500;
        assert verdict.cost_tokens_out == 750;
        assert verdict.cost_usd == 15;
    }

    test tester_report_creation {
        const report = TesterReport{
            .issue_number = 6520,
            .tests_passed = 2,
            .tests_total = 2,
            .benchmarks = ["bench1", "bench2", "", ""],
            .regressions = ["", "", "", ""],
            .timestamp = 1234567890,
        };
        assert report.issue_number == 6520;
        assert report.tests_passed == 2;
        assert report.tests_total == 2;
        assert report.benchmarks[0] == "bench1";
        assert report.benchmarks[1] == "bench2";
        assert report.regressions[0] == "";
        assert report.regressions[1] == "";
        assert report.timestamp == 1234567890;
    }