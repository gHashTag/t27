    assert(out_is(n, &out, 0, "fn len_of(v: []const u8) -> ?u32 {\n    return (v.len as u32);\n}\n\nfn first_len(v: []const u8) -> u32 {\n    const n_t27o = len_of(v);\n    if (n_t27o != null) {\n        const n = n_t27o.?;\n        return n;\n    } else {\n        return 0;\n    }\n}\n\n"));
    assert(st[NOK] == 2);
}

