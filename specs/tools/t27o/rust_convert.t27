}

test refusals_cascade_to_their_users {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("use other::Thing;\nfn a() -> u32 { b() + 1 }\nfn b() -> u32 { let v: Vec<u8> = Vec::new(); 0 }\nfn c(t: Thing) -> u32 { 0 }\nfn d() -> u32 { gone(1) }\nfn e() -> u32 { a() }", &out, &st);
    assert(out_is(n, &out, 0, "// t27o: refused fn a (line 2): uses refused `b` at line 2\n\nfn a() -> u32 {\n}\n\n// t27o: refused fn b (line 3): type `Vec` at line 3\n\nfn b() -> u32 {\n}\n\n// t27o: refused fn c (line 4): uses external `Thing` at line 4\n\n// t27o: refused fn d (line 5): undeclared `gone` at line 5\n\nfn d() -> u32 {\n}\n\n// t27o: refused fn e (line 6): uses refused `a` at line 6\n\nfn e() -> u32 {\n}\n\n"));
    assert(st[NOK] == 0);
    assert(st[NFN] == 5);
}

test a_selfless_member_of_a_refused_impl_type_converts {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("struct Gen { code: Vec<u8> }\nimpl Gen {\n    fn is_bin(op: &str) -> bool { matches!(op, \"+\" | \"-\") }\n    fn wide(w: u32, op: &str) -> u32 { if w > 8 { w } else if Self::is_bin(op) { 1 } else { 0 } }\n    fn same(a: &Self, b: u8) -> bool { b > 0 }\n}", &out, &st);
    assert(out_is(n, &out, 0, "use tri::t27b::type_text;\n\n// t27o: refused struct Gen (line 1): type `Vec` at line 1\n\nfn Gen_is_bin(op: []const u8) -> bool {\n    return (type_text::same(op, \"+\") or type_text::same(op, \"-\"));\n}\n\nfn Gen_wide(w: u32, op: []const u8) -> u32 {\n    if (w > 8) {\n        return w;\n    } else if (Gen_is_bin(op)) {\n        return 1;\n    } else {\n        return 0;\n    }\n}\n\n// t27o: refused fn same (line 5): uses refused `Self` at line 5\n\n"));
    assert(st[NOK] == 2);
}

test while_let_reads_its_call_once_into_a_temp {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn next(i: u32) -> Option<u32> { if i < 4 { i + 1 } else { None } }\nfn walk(from: u32) -> u32 {\n    let mut at = from;\n    while let Some(v) = next(at) { at = v; }\n    at\n}", &out, &st);
    assert(out_is(n, &out, 0, "fn next(i: u32) -> ?u32 {\n    if (i < 4) {\n        return i + 1;\n    } else {\n        return null;\n    }\n}\n\nfn walk(from: u32) -> u32 {\n    var at = from;\n    while (true) {\n        const v_t27o = next(at);\n        if (v_t27o == null) {\n            break;\n        }\n        const v = v_t27o.?;\n        at = v;\n    }\n    return at;\n}\n\n"));
    assert(st[NOK] == 2);
}

