    assert(out_is(n, &out, 0, "fn check(s: []const u8) -> ?u32 {\n    if (s.len > 1) {\n        return 1;\n    } else {\n        return null;\n    }\n}\n\nfn ok_long(s: []const u8) -> bool {\n    if (check(s) == null) {\n        return false;\n    }\n    return true;\n}\n\n// t27o: refused fn says_why (line 3): if let / while let `e` at line 3\n\nfn says_why(s: []const u8) -> bool {\n}\n\n"));
    assert(st[NOK] == 2);
}

