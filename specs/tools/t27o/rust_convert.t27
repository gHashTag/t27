    assert(out_is(n, &out, 0, "// t27o: cfg(has_zig_lib) is off on the default host (not test, no features or --cfg; linux x86_64, debug): fn q dropped\n\npub fn q(_e: f64) -> f64 {\n    _ = _e;\n    return 0.0;\n}\n\nconst W : u32 = 64;\n\nfn on() -> bool {\n    return true and !false;\n}\n\n"));
    assert(st[NCFG] == 1);
}

test results_are_optionals_and_try_returns_early {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("type R<T> = Result<T, ()>;\nfn half(x: u32) -> Result<u32, String> { if x % 2 == 1 { return Err(\"odd\".into()); } Ok(x / 2) }\nfn quarter(x: u32) -> R<u32> { let h = half(x)?; let q: u32 = half(h)?; Ok(q) }\nfn check(x: u32) -> Result<(), String> { if x == 0 { return Err(format!(\"zero\")); } Ok(()) }\nfn both(x: u32) -> Result<(), String> { check(x)?; let _ = half(x)?; Ok(()) }\nfn pick(o: Option<u8>) -> Option<u8> { let v = o?; Some(v + 1) }", &out, &st);
    assert(out_is(n, &out, 0, "fn half(x: u32) -> ?u32 {\n    if (x % 2 == 1) {\n        return null;\n    }\n    return (x / 2);\n}\n\nfn quarter(x: u32) -> ?u32 {\n    const h_t27o = half(x);\n    if (h_t27o == null) {\n        return null;\n    }\n    const h = h_t27o.?;\n    const q_t27o = half(h);\n    if (q_t27o == null) {\n        return null;\n    }\n    const q : u32 = q_t27o.?;\n    return q;\n}\n\nfn check(x: u32) -> bool {\n    if (x == 0) {\n        return false;\n    }\n    return true;\n}\n\nfn both(x: u32) -> bool {\n    if ((check(x)) == false) {\n        return false;\n    }\n    if (half(x) == null) {\n        return false;\n    }\n    return true;\n}\n\nfn pick(o: ?u8) -> ?u8 {\n    const v_t27o = o;\n    if (v_t27o == null) {\n        return null;\n    }\n    const v = v_t27o.?;\n    return (v + 1);\n}\n\n"));
}

