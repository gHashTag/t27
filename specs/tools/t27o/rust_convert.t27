test the_split_join_loop_writes_the_piece_before_the_separator {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn zig_ident(name: &str) -> String {\n    if name.contains(\"::\") {\n        return name\n            .split(\"::\")\n            .map(zig_ident)\n            .collect::<Vec<_>>()\n            .join(\".\");\n    }\n    name.to_string()\n}", &out, &st);
    assert(out_is(n, &out, 0, "use tools::t27o::rust_std;\nuse hosting::toolchain;\nuse tri::t27b::type_text;\n\nfn zig_ident(name: []const u8, out: []u8) -> usize {\n    var t27o_w : usize = 0;\n    if (rust_std::str_contains(name, \"::\")) {\n        var t27o_i3 : usize = 0;\n        var t27o_s3 : usize = 0;\n        while (t27o_i3 < name.len) {\n            if (toolchain::starts_with(name[t27o_i3 .. name.len], \"::\")) {\n                t27o_w = t27o_w + zig_ident(name[t27o_s3 .. t27o_i3], out[t27o_w .. out.len]);\n                t27o_w = rust_std::append_text(out, t27o_w, \".\");\n                t27o_i3 = t27o_i3 + 2;\n                t27o_s3 = t27o_i3;\n            } else {\n                t27o_i3 = t27o_i3 + 1;\n            }\n        }\n        t27o_w = t27o_w + zig_ident(name[t27o_s3 .. t27o_i3], out[t27o_w .. out.len]);\n        return t27o_w;\n    }\n    t27o_w = rust_std::append_text(out, t27o_w, name);\n    return t27o_w;\n}\n\n"));
}

test an_owned_string_outside_the_out_buffer_form_names_the_read {
    var out : [512]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn mk(x: u32) -> String {\n    let mut s = String::new();\n    s.push_str(\"x=\");\n    s.push_str(&x.to_string());\n    s\n}", &out, &st);
    assert(out_is(n, &out, 0, "use tools::t27o::rust_std;\n\n// t27o: refused fn mk (line 1): an owned String outside the out-buffer form `&` at line 4\n\n"));
}

test a_string_local_of_one_fn_does_not_poison_a_later_fns_name {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    // `earlier` owns a String local `name`; `render` reads a *param* of the same name. Before the
    // locals carried their fn's range, render's `name.contains` read matched earlier's local and
    // refused the whole fn -- the whole-file table knew no boundary
    const n : usize = body("fn earlier(s: &str) -> String {\n    let name = s.to_string();\n    name\n}\n\nfn render(name: &str) -> String {\n    if name.contains(\"::\") { return name.to_string(); }\n    name.to_string()\n}", &out, &st);
    assert(out_text_has(&out, n, "fn render(name: []const u8, out: []u8) -> usize {"));
    assert(out_text_has(&out, n, "if (rust_std::str_contains(name, \"::\")) {"));
    assert(out_text_has(&out, n, "fn earlier(s: []const u8, out: []u8) -> usize {"));
    assert(!out_text_has(&out, n, "refused"));
}

test a_gen_module_scrutinee_types_the_if_let_binding_as_text {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("#[path = \"../gen/rust/compiler/operator_text.rs\"]\nmod operator_text;\n\nfn assign_op_text(extra_op: &str) -> String {\n    if let Some(op) = operator_text::compound_binop(extra_op.as_bytes()) {\n        return format!(\" {}= \", op);\n    }\n    let t = extra_op.trim();\n    if t.len() >= 2 && t.ends_with('=') && !matches!(t, \"==\" | \"!=\" | \"<=\" | \">=\") {\n        return format!(\" {} \", t);\n    }\n    \" = \".to_string()\n}", &out, &st);
    assert(out_is(n, &out, 0, "use tools::t27o::rust_std;\nuse hosting::toolchain;\nuse tri::t27b::type_text;\nuse compiler::operator_text;\n\nfn assign_op_text(extra_op: []const u8, out: []u8) -> usize {\n    var t27o_w : usize = 0;\n    const op_t27o = operator_text::compound_binop(extra_op);\n    if (op_t27o != null) {\n        const op = op_t27o.?;\n        t27o_w = rust_std::append_text(out, t27o_w, \" \");\n        t27o_w = rust_std::append_text(out, t27o_w, op);\n        t27o_w = rust_std::append_text(out, t27o_w, \"= \");\n        return t27o_w;\n    }\n    const t = extra_op[type_text::trim_lo(extra_op, 0, extra_op.len) .. type_text::trim_hi(extra_op, type_text::trim_lo(extra_op, 0, extra_op.len), extra_op.len)];\n    if (t.len >= 2 and toolchain::ends_with(t, \"=\") and !(type_text::same(t, \"==\") or type_text::same(t, \"!=\") or type_text::same(t, \"<=\") or type_text::same(t, \">=\"))) {\n        t27o_w = rust_std::append_text(out, t27o_w, \" \");\n        t27o_w = rust_std::append_text(out, t27o_w, t);\n        t27o_w = rust_std::append_text(out, t27o_w, \" \");\n        return t27o_w;\n    }\n    t27o_w = rust_std::append_text(out, t27o_w, \" = \");\n    return t27o_w;\n}\n\n"));
}

test decl_type_stops_at_the_fns_end_so_a_later_same_name_param_is_not_its_type {
    var out : [4096]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    // `t` is the `extra_op.trim()` slice two lines up, but `fn type_rank(t: &TypeInfo)` sits AFTER
    // the fn, and decl_type's scan ran to src.len keeping the LAST `t:` of the file -- so the whole
    // #9098 file typed this fn's `t` as `&TypeInfo`, a class out_format refuses, and the whole-file
    // run blamed an owned String that was never there. The scan now stops at fn_end, the boundary
    // the K_STRLOC windows already gave the name table (the test above theirs).
    const n : usize = body("#[path = \"../gen/rust/compiler/operator_text.rs\"]\nmod operator_text;\n\nfn assign_op_text(extra_op: &str) -> String {\n    if let Some(op) = operator_text::compound_binop(extra_op.as_bytes()) {\n        return format!(\" {}= \", op);\n    }\n    let t = extra_op.trim();\n    if t.len() >= 2 && t.ends_with('=') && !matches!(t, \"==\" | \"!=\" | \"<=\" | \">=\") {\n        return format!(\" {} \", t);\n    }\n    \" = \".to_string()\n}\n\nfn type_rank(t: &TypeInfo) -> u8 { 0 }", &out, &st);
    assert(out_text_has(&out, n, "fn assign_op_text(extra_op: []const u8, out: []u8) -> usize {"));
    assert(out_text_has(&out, n, "t27o_w = rust_std::append_text(out, t27o_w, t);"));
    assert(!out_text_has(&out, n, "refused fn assign_op_text"));
}

test a_gen_path_attribute_tolerates_other_attributes_before_the_mod {
    var out : [4096]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    // compiler.rs spells every gen mod `#[path = ".."] #[allow(dead_code, unused_parens)] mod m;`,
    // and the whole #9098 file was refused with the binder `op` named: the adjacency check read the
    // #[path] attribute's end as the mod's position and the #[allow] between the two broke it, so
    // gen_mod_name denied the very module that path names. The mod now matches the END of an
    // unbroken attribute run that carries a gen path, whichever attribute ends it.
    const n : usize = body("#[path = \"../gen/rust/compiler/operator_text.rs\"]\n#[allow(dead_code, unused_parens)]\nmod operator_text;\n\nfn assign_op_text(extra_op: &str) -> String {\n    if let Some(op) = operator_text::compound_binop(extra_op.as_bytes()) {\n        return format!(\" {}= \", op);\n    }\n    \" = \".to_string()\n}", &out, &st);
    assert(out_text_has(&out, n, "use compiler::operator_text;"));
    assert(out_text_has(&out, n, "const op = op_t27o.?;"));
    assert(out_text_has(&out, n, "t27o_w = rust_std::append_text(out, t27o_w, op);"));
    assert(!out_text_has(&out, n, "refused fn assign_op_text"));
}

test a_catch_all_arm_binding_the_scrutinees_own_name_writes_no_shadowing_const {
    var out : [4096]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    // a catch-all `c => ..` of a match on `c` used to write `const c = c;`, shadowing the for
    // capture holding the value -- t27c refuses the shadow, and #9098's whole-file check was BLOCKED
    // on exactly that (escape_for_fmt). The name already binds the value, so nothing is written; a
    // binder of another name still gets its const.
    const n : usize = body("fn count_special(s: &str) -> usize {\n    let mut n = 0usize;\n    for c in s.chars() {\n        match c {\n            '{' | '}' => { n += 1; }\n            c => { n += 1; }\n        }\n    }\n    n\n}\n\nfn other_name(s: &str) -> usize {\n    let mut n = 0usize;\n    for c in s.chars() {\n        match c {\n            x => { n += 1; }\n        }\n    }\n    n\n}", &out, &st);
    assert(out_text_has(&out, n, "for c in s {"));
    assert(!out_text_has(&out, n, "const c = c;"));
    assert(out_text_has(&out, n, "const x = c;"));
}

test tuple_structs_have_fields_0_and_1 {
    var out : [512]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("#[derive(Clone, Copy)]\npub struct Pair(pub u8, u16);\nimpl Pair {\n    pub fn new(a: u8) -> Self { Pair(a, 0) }\n    pub fn sum(&self) -> u16 { self.0 as u16 + self.1 }\n}\n#[test]\nfn pairs() { assert_eq!(Pair::new(3).sum(), 3); assert_eq!(Pair::new(1), Pair(1, 0)); }", &out, &st);
    assert(out_is(n, &out, 0, "pub const Pair = struct {\n    _0 : u8,\n    _1 : u16,\n};\n\npub fn Pair_new(a: u8) -> Pair {\n    return Pair{ ._0 = a, ._1 = 0 };\n}\n\npub fn Pair_sum(self: Pair) -> u16 {\n    return (self._0 as u16) + self._1;\n}\n\n// t27o: refused fn pairs (line 8): == of structs `Pair` at line 8\n\n"));
}

test std_calls_go_through_the_table {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("const KINDS: [&str; 2] = [\"a\", \"b\"];\nfn f(x: f64, n: i32, s: &str, v: &[u32]) -> bool {\n    let d: u32 = s.trim().parse().unwrap();\n    (x - 1.5).abs().max(0.5) > 1.0 && n.abs() > 2 && s.starts_with(\"a\") && v.iter().sum::<u32>() == d && KINDS.contains(&s) && n.checked_add(1).is_some() && std::cmp::max(d, n as u32) == d\n}\nfn g(n: u32) -> u32 { n.max(1) }", &out, &st);
    assert(out_is(n, &out, 0, "use tools::t27o::rust_std;\nuse hosting::toolchain;\nuse tri::t27b::type_text;\n\nconst KINDS : [2][]const u8 = [\"a\", \"b\"];\n\nfn f(x: f64, n: i32, s: []const u8, v: []const u32) -> bool {\n    const d : u32 = rust_std::parse_u32(s[type_text::trim_lo(s, 0, s.len) .. type_text::trim_hi(s, type_text::trim_lo(s, 0, s.len), s.len)]).?;\n    return @max(@abs((x - 1.5)), 0.5) > 1.0 and rust_std::abs_i32(n) > 2 and toolchain::starts_with(s, \"a\") and rust_std::sum_u32(v) == d and (type_text::same(s, \"a\") or type_text::same(s, \"b\")) and (rust_std::checked_add_i32(n, 1) != null) and @max(d, n as u32) == d;\n}\n\nfn g(n: u32) -> u32 {\n    return @max(n, 1);\n}\n\n"));
}

test a_char_needle_reaches_the_text_fn_as_the_byte_it_is {
    var out : [512]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn p(ty: &str) -> bool {\n    ty.starts_with('(') && ty.contains(':') && ty.ends_with(')')\n}", &out, &st);
    assert(out_is(n, &out, 0, "use tools::t27o::rust_std;\nuse hosting::toolchain;\n\nfn p(ty: []const u8) -> bool {\n    return rust_std::starts_with_byte(ty, '(') and rust_std::str_contains(ty, \":\") and toolchain::ends_with(ty, \")\");\n}\n\n"));
}

test the_trims_come_from_type_text_so_a_converted_spec_compiles_alone {
    var out : [512]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn w(ty: &str) -> u32 {\n    match ty.trim() {\n        \"u8\" => 8,\n        _ => 0,\n    }\n}", &out, &st);
    assert(out_is(n, &out, 0, "use tri::t27b::type_text;\n\nfn w(ty: []const u8) -> u32 {\n    const m2 = ty[type_text::trim_lo(ty, 0, ty.len) .. type_text::trim_hi(ty, type_text::trim_lo(ty, 0, ty.len), ty.len)];\n    if (type_text::same(m2, \"u8\")) {\n        return 8;\n    } else {\n        return 0;\n    }\n}\n\n"));
}

test a_method_two_impls_carry_goes_to_the_owners {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("pub struct Link { pub errors: u32 }\npub struct Sim { pub errors: u32 }\nimpl Link { pub fn passed(&self) -> bool { self.errors == 0 } }\nimpl Sim { pub fn passed(&self) -> bool { self.errors == 0 } }\n#[test]\nfn sim_ok() { let r = Sim { errors: 0 }; assert!(r.passed()); }", &out, &st);
    assert(out_is(n, &out, 0, "pub const Link = struct {\n    errors : u32,\n};\n\npub const Sim = struct {\n    errors : u32,\n};\n\npub fn Link_passed(self: Link) -> bool {\n    return self.errors == 0;\n}\n\npub fn Sim_passed(self: Sim) -> bool {\n    return self.errors == 0;\n}\n\ntest sim_ok {\n    const r = Sim{ .errors = 0 };\n    assert(Sim_passed(r));\n}\n\n"));
}

/// Does out[0 .. n] hold the text s somewhere?
fn out_text_has(out: []const u8, n: usize, s: []const u8) -> bool {
    if (n < s.len or n > out.len) { return false; }
    var i : usize = 0;
    while (i + s.len <= n) {
        var k : usize = 0;
        while (k < s.len and out[i + k] == s[k]) { k = k + 1; }
        if (k == s.len) { return true; }
        i = i + 1;
    }
    return false;
}

test a_kept_impl_of_a_refused_type_decls_the_type_in_the_harness {
    var out : [4096]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = oracle("struct Bad {\n    name: String,\n}\n\nimpl Bad {\n    fn twice(n: u32) -> u32 { n * 2 }\n}\n", &out, &st);
    // the struct is refused (a String field) and writes nothing of its own; the static member
    // converts, so the harness keeps the impl -- and carries a one-line stub of the type it
    // names, which compiles even though the type's own fields do not
    assert(out_text_has(&out, n, "impl Bad {"));
    assert(out_text_has(&out, n, "fn twice(n: u32) -> u32 { n * 2 }"));
    assert(out_text_has(&out, n, "}\n\nstruct Bad;\n\n"));
}

test a_wrapping_op_form_writes_the_wrapping_operator {
    var out : [512]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("pub fn wm(h: u64, b: u8) -> u64 { h.wrapping_mul(0x100000001b3) }", &out, &st);
    assert(out_is(n, &out, 0, "pub fn wm(h: u64, b: u8) -> u64 {\n    _ = b;\n    return (h *% 0x100000001b3);\n}\n\n"));
    const m : usize = body("pub fn wa(a: i32, b: i32) -> i32 { a.wrapping_add(b) }", &out, &st);
    assert(out_text_has(&out, m, "+% b"));
}

test a_self_in_a_signature_of_a_refused_owner_writes_no_stub {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("struct Bad {\n    n: String,\n}\n\nimpl Bad {\n    pub fn make() -> Self { Self { n: String::new() } }\n}\n", &out, &st);
    assert(out_text_has(&out, n, "refused struct Bad"));
    assert(!out_text_has(&out, n, "fn Bad_make"));
}

test a_slice_of_slices_parameter_lowers_with_the_innermost_const {
    var out : [512]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn count_bad(toks: &[&str]) -> u32 {\n    toks.len() as u32\n}", &out, &st);
    // a slice of slices has no t27 spelling of its own: it lowers as an array type with the
    // element const innermost -- the shape gen-rust indexes and t27c reads back
    assert(out_is(n, &out, 0, "fn count_bad(toks: [][]const u8) -> u32 {\n    return toks.len as u32;\n}\n\n"));
}

test modules_and_reused_fns_are_used_not_copied {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("#[path = \"../../../gen/rust/tri/t27b/source_text.rs\"]\nmod st;\nfn line_of_a(s: &str) -> u32 { st::decl_line(s.as_bytes(), \"A\".as_bytes()) }\nfn parse_int(s: &str) -> i128 { st::parse_int(s.as_bytes()) }\npub fn phi_add(a: f32, b: f32) -> f32 { a + b }\nfn twice(a: f32) -> f32 { phi_add(a, a) }\n//@t27o reuse phi_add port::trios::crates::trios-trinity-brain::src::phi\n", &out, &st);
    assert(out_is(n, &out, 0, "use port::trios::crates::trios-trinity-brain::src::phi;\nuse tri::t27b::source_text;\n\nfn line_of_a(s: []const u8) -> u32 {\n    return source_text::decl_line(s, \"A\");\n}\n\n// t27o: refused fn parse_int (line 4): a used module's name, declared here too (use splices flat, see #7176) `parse_int` at line 4\n\n// t27o: phi_add is phi::phi_add of port::trios::crates::trios-trinity-brain::src::phi, with the same I/O on the oracle vectors: used, not written again\n\nfn twice(a: f32) -> f32 {\n    return phi_add(a, a);\n}\n\n"));
    assert(st[NREUSE] == 1);
}

test a_module_whose_own_use_t27c_cannot_splice_refuses {
    var out : [1024]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("#[path = \"../../../gen/rust/compiler/int_type_names.rs\"]\nmod int_type_names;\nfn suffix(t: &str) -> bool { int_type_names::is_integer_type_suffix(t.as_bytes()) }", &out, &st);
    assert(out_is(n, &out, 0, "// t27o: refused fn suffix (line 3): a used module's own use t27c does not splice (its type_text:: names stay unresolved, the gap specs/compiler/int_type_names.t27 records) `int_type_names::is_integer_type_suffix` at line 3\n\nfn suffix(t: []const u8) -> bool {\n}\n\n"));
    assert(st[NOK] == 0);
}

test matches_default_and_a_for_over_an_array_literal {
    var out : [512]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("#[derive(PartialEq)]\nenum V { A, B, C }\nimpl Default for V { fn default() -> Self { V::B } }\nimpl V { fn edge(&self) -> bool { matches!(self, V::A | V::C) } }\n#[test]\nfn walk() { for v in [V::A, V::C] { assert!(v.edge()); } assert!(V::default() == V::B); }", &out, &st);
    assert(out_is(n, &out, 0, "const V = enum(u32) {\n    A,\n    B,\n    C,\n};\n\nfn V_default() -> V {\n    return V.B;\n}\n\nfn V_edge(self: V) -> bool {\n    return (self == V.A or self == V.C);\n}\n\ntest walk {\n    const t27o_a6 : [2]V = [V.A, V.C];\n    for v in t27o_a6 {\n        assert(V_edge(v));\n    }\n    assert(V_default() == V.B);\n}\n\n"));
}

test the_oracle_records_an_owned_string_result_byte_for_byte {
    var out : [4096]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = oracle("fn tag(n: u32) -> String { format!(\"<{}>\", n) }", &out, &st);
    // the Rust side runs the original; the recorded call names the out-buffer form, and the test it
    // prints owns a 256-byte buffer, takes the bytes written and compares them with the String
    assert(out_text_has(&out, n, "catch_unwind(|| tag(0))"));
    assert(out_text_has(&out, n, "\"tag(0, t27o_o0[0 .. 256])\""));
    assert(out_text_has(&out, n, "var t27o_o0 : [256]u8 = undefined;\\n    const t27o_n0 = {};\\n    assert(type_text::same(t27o_o0[0 .. t27o_n0], {:?}));"));
    assert(out_text_has(&out, n, "test oracle_tag {"));
}

test the_oracle_samples_enums_arrays_and_results {
    var out : [4096]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = oracle("#[derive(Clone, Copy, Debug)]\nenum K { A, B }\nfn pick(k: K, b: bool) -> Option<K> { if b { Some(k) } else { None } }\nfn head(a: &[i8; 2]) -> i32 { a[0] as i32 }\nfn ok(x: bool) -> Result<(), ()> { if x { Ok(()) } else { Err(()) } }", &out, &st);
    assert(out_is(n, &out, 0, "// t27o oracle harness (specs/tools/t27o/rust_convert.t27): the converted items, run to record\n// their behaviour as t27 tests.\n#![allow(warnings)]\n\n#[derive(Clone, Copy, Debug)]\nenum K { A, B }\n\nfn pick(k: K, b: bool) -> Option<K> { if b { Some(k) } else { None } }\n\nfn head(a: &[i8; 2]) -> i32 { a[0] as i32 }\n\nfn ok(x: bool) -> Result<(), ()> { if x { Ok(()) } else { Err(()) } }\n\nfn main() {\n    std::panic::set_hook(Box::new(|_| {}));\n    {\n        let mut v: Vec<String> = Vec::new();\n        if let Ok(r) = std::panic::catch_unwind(|| pick(K::A, true)) { let c = \"pick(K.A, true)\"; match r { Some(x) => { v.push(format!(\"    assert({}.? == K.{});\", c, match x { K::A => \"A\", K::B => \"B\", })); } None => v.push(format!(\"    assert({} == null);\", c)) } }\n        if let Ok(r) = std::panic::catch_unwind(|| pick(K::B, false)) { let c = \"pick(K.B, false)\"; match r { Some(x) => { v.push(format!(\"    assert({}.? == K.{});\", c, match x { K::A => \"A\", K::B => \"B\", })); } None => v.push(format!(\"    assert({} == null);\", c)) } }\n        if !v.is_empty() { println!(\"test oracle_pick {{\"); for l in &v { println!(\"{}\", l); } println!(\"}}\\n\"); }\n    }\n    {\n        let mut v: Vec<String> = Vec::new();\n        if let Ok(r) = std::panic::catch_unwind(|| head(&[0; 2])) { let c = \"head(&t27o_0_0)\"; let d = \"    const t27o_0_0 : [2]i8 = [@as(i8, 0)] ** 2;\\n\"; v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| head(&[1; 2])) { let c = \"head(&t27o_1_0)\"; let d = \"    const t27o_1_0 : [2]i8 = [@as(i8, 1)] ** 2;\\n\"; v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| head(&[-1; 2])) { let c = \"head(&t27o_2_0)\"; let d = \"    const t27o_2_0 : [2]i8 = [@as(i8, -1)] ** 2;\\n\"; v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| head(&[7; 2])) { let c = \"head(&t27o_3_0)\"; let d = \"    const t27o_3_0 : [2]i8 = [@as(i8, 7)] ** 2;\\n\"; v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| head(&[-100; 2])) { let c = \"head(&t27o_4_0)\"; let d = \"    const t27o_4_0 : [2]i8 = [@as(i8, -100)] ** 2;\\n\"; v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| head(&[127; 2])) { let c = \"head(&t27o_5_0)\"; let d = \"    const t27o_5_0 : [2]i8 = [@as(i8, 127)] ** 2;\\n\"; v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| head(&[(-128); 2])) { let c = \"head(&t27o_6_0)\"; let d = \"    const t27o_6_0 : [2]i8 = [@as(i8, (-128))] ** 2;\\n\"; v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); }\n        if !v.is_empty() { println!(\"test oracle_head {{\"); for l in &v { println!(\"{}\", l); } println!(\"}}\\n\"); }\n    }\n    {\n        let mut v: Vec<String> = Vec::new();\n        if let Ok(r) = std::panic::catch_unwind(|| ok(false)) { let c = \"ok(false)\"; match r { Ok(()) => v.push(format!(\"    assert({});\", c)), Err(_) => v.push(format!(\"    assert(({}) == false);\", c)) } }\n        if let Ok(r) = std::panic::catch_unwind(|| ok(true)) { let c = \"ok(true)\"; match r { Ok(()) => v.push(format!(\"    assert({});\", c)), Err(_) => v.push(format!(\"    assert(({}) == false);\", c)) } }\n        if !v.is_empty() { println!(\"test oracle_ok {{\"); for l in &v { println!(\"{}\", l); } println!(\"}}\\n\"); }\n    }\n}\n"));
}

test needle_methods_take_their_char_sibling {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn close_at(t: &str) -> Option<usize> { t.find(']') }\nfn name_at(hay: &str, from: usize, name: &str) -> Option<usize> { hay[from..].find(name) }\nfn strip0(d: &str) -> &str { d.trim_start_matches('0') }\nfn strip_kind(s: &str) -> &str { s.trim_end_matches(\"::\") }\nfn has_inner(t: &str) -> bool { t.strip_prefix('[').is_some() }\nfn after_bracket(t: &str) -> Option<&str> { t.strip_prefix(\"[]\") }\nfn lead_a(s: &str) -> bool { s.starts_with('a') }", &out, &st);
    assert(out_is(n, &out, 0, "use tools::t27o::rust_std;\nuse tri::t27b::type_text;\n\nfn close_at(t: []const u8) -> ?usize {\n    return rust_std::find_byte(t, ']');\n}\n\nfn name_at(hay: []const u8, from: usize, name: []const u8) -> ?usize {\n    return rust_std::find_text(hay[from .. hay.len], name);\n}\n\nfn strip0(d: []const u8) -> []const u8 {\n    return rust_std::trim_start_matches_byte(d, '0');\n}\n\nfn strip_kind(s: []const u8) -> []const u8 {\n    return rust_std::trim_end_matches_text(s, \"::\");\n}\n\nfn has_inner(t: []const u8) -> bool {\n    return (rust_std::strip_prefix_byte(t, '[') != null);\n}\n\nfn after_bracket(t: []const u8) -> ?[]const u8 {\n    return rust_std::strip_prefix_text(t, \"[]\");\n}\n\nfn lead_a(s: []const u8) -> bool {\n    return rust_std::starts_with_byte(s, 'a');\n}\n\n"));
}

test ascii_classes_chars_identity_and_all_closures {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn ident_byte(b: u8) -> bool { b.is_ascii_alphanumeric() || b == b'_' }\nfn alpha_b(b: u8) -> bool { b.is_ascii_alphabetic() }\nfn digit_b(c: u8) -> bool { c.is_ascii_digit() }\nfn digits_only(s: &str) -> bool { s.chars().all(|c| c.is_ascii_digit()) }\nfn word_chars(s: &str) -> bool { s.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') }\nfn first_digit(s: &str) -> bool { s.starts_with(|c: char| c.is_ascii_digit()) }", &out, &st);
    assert(out_is(n, &out, 0, "use tools::t27o::rust_std;\nuse tri::t27b::type_text;\n\nfn ident_byte(b: u8) -> bool {\n    return rust_std::alnum(b) or b == '_';\n}\n\nfn alpha_b(b: u8) -> bool {\n    return type_text::alpha(b);\n}\n\nfn digit_b(c: u8) -> bool {\n    return type_text::digit(c);\n}\n\nfn digits_only(s: []const u8) -> bool {\n    return rust_std::chars_all_digit(s);\n}\n\nfn word_chars(s: []const u8) -> bool {\n    return rust_std::chars_all_word(s);\n}\n\nfn first_digit(s: []const u8) -> bool {\n    return rust_std::starts_with_digit(s);\n}\n\n"));
}

test a_let_bound_receiver_carries_the_call_class {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn bracket_at(ty: &str) -> Option<usize> { let t = ty.trim(); t.find('[') }\nfn digits(d: &str) -> &str { let v = d.trim_start_matches('0'); v.trim() }", &out, &st);
    assert(out_is(n, &out, 0, "use tools::t27o::rust_std;\nuse tri::t27b::type_text;\n\nfn bracket_at(ty: []const u8) -> ?usize {\n    const t = ty[type_text::trim_lo(ty, 0, ty.len) .. type_text::trim_hi(ty, type_text::trim_lo(ty, 0, ty.len), ty.len)];\n    return rust_std::find_byte(t, '[');\n}\n\nfn digits(d: []const u8) -> []const u8 {\n    const v = rust_std::trim_start_matches_byte(d, '0');\n    return v[type_text::trim_lo(v, 0, v.len) .. type_text::trim_hi(v, type_text::trim_lo(v, 0, v.len), v.len)];\n}\n\n"));
}

test a_field_receiver_keeps_its_fields_class {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("pub struct Tok { pub value: &'static str, pub line: u32 }\nfn lead_num(t: &Tok) -> bool { t.value.starts_with('1') }\nfn neg_lit(t: &Tok) -> bool { t.value.trim_start().starts_with('-') }", &out, &st);
    assert(out_is(n, &out, 0, "use tools::t27o::rust_std;\nuse tri::t27b::type_text;\n\npub const Tok = struct {\n    value : []const u8,\n    line : u32,\n};\n\nfn lead_num(t: Tok) -> bool {\n    return rust_std::starts_with_byte(t.value, '1');\n}\n\nfn neg_lit(t: Tok) -> bool {\n    return rust_std::starts_with_byte(t.value[type_text::trim_lo(t.value, 0, t.value.len) .. t.value.len], '-');\n}\n\n"));
}

test matches_on_a_call_and_a_bound_match_arm {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("fn is_float(ty: &str) -> bool { matches!(ty.trim(), \"f32\" | \"f64\") }\nfn elem_ty(ty: &str) -> bool { let t = ty.trim(); match t { \"u8\" => true, other => other.starts_with('i') } }\nfn w_max(w: u32) -> u32 { w.max(1) }", &out, &st);
    assert(out_is(n, &out, 0, "use tools::t27o::rust_std;\nuse tri::t27b::type_text;\n\nfn is_float(ty: []const u8) -> bool {\n    return (type_text::same((ty[type_text::trim_lo(ty, 0, ty.len) .. type_text::trim_hi(ty, type_text::trim_lo(ty, 0, ty.len), ty.len)]), \"f32\") or type_text::same((ty[type_text::trim_lo(ty, 0, ty.len) .. type_text::trim_hi(ty, type_text::trim_lo(ty, 0, ty.len), ty.len)]), \"f64\"));\n}\n\nfn elem_ty(ty: []const u8) -> bool {\n    const t = ty[type_text::trim_lo(ty, 0, ty.len) .. type_text::trim_hi(ty, type_text::trim_lo(ty, 0, ty.len), ty.len)];\n    if (type_text::same(t, \"u8\")) {\n        return true;\n    } else {\n        const other = t;\n        return rust_std::starts_with_byte(other, 'i');\n    }\n}\n\nfn w_max(w: u32) -> u32 {\n    return @max(w, 1);\n}\n\n"));
}

test an_enum_path_receiver_names_its_own_impl {
    var out : [2048]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = body("enum Rel { Abs32, Rel32 }\nenum Alt { A }\nimpl Rel { fn code(self) -> u8 { 1 } }\nimpl Alt { fn code(self) -> u8 { 2 } }\nfn tag() -> u8 { Rel::Abs32.code() }", &out, &st);
    assert(out_is(n, &out, 0, "const Rel = enum(u32) {\n    Abs32,\n    Rel32,\n};\n\nconst Alt = enum(u32) {\n    A,\n};\n\nfn Rel_code(self_: Rel) -> u8 {\n    return 1;\n}\n\nfn Alt_code(self_: Alt) -> u8 {\n    return 2;\n}\n\nfn tag() -> u8 {\n    return Rel_code(Rel.Abs32);\n}\n\n"));
}

test the_oracle_records_struct_fields_and_slices {
    var out : [8192]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = oracle("pub struct Pt { pub x: i32, pub on: bool }\npub struct W(pub [u8; 2]);\nfn mk(x: i32) -> Pt { Pt { x, on: x > 0 } }\nfn w(b: u8) -> W { W([b, 0]) }\nfn total(v: &mut [f64], k: f64) -> f64 { v[0] = k; v[0] + v.len() as f64 }", &out, &st);
    assert(out_is(n, &out, 0, "// t27o oracle harness (specs/tools/t27o/rust_convert.t27): the converted items, run to record\n// their behaviour as t27 tests.\n#![allow(warnings)]\n\npub struct Pt { pub x: i32, pub on: bool }\n\npub struct W(pub [u8; 2]);\n\nfn mk(x: i32) -> Pt { Pt { x, on: x > 0 } }\n\nfn w(b: u8) -> W { W([b, 0]) }\n\nfn total(v: &mut [f64], k: f64) -> f64 { v[0] = k; v[0] + v.len() as f64 }\n\nfn main() {\n    std::panic::set_hook(Box::new(|_| {}));\n    {\n        let mut v: Vec<String> = Vec::new();\n        if let Ok(r) = std::panic::catch_unwind(|| mk(0)) { let c = \"mk(0)\"; v.push(format!(\"    assert({}.x == {:?});\", c, r.x)); v.push(format!(\"    assert({}.on == {:?});\", c, r.on)); }\n        if let Ok(r) = std::panic::catch_unwind(|| mk(1)) { let c = \"mk(1)\"; v.push(format!(\"    assert({}.x == {:?});\", c, r.x)); v.push(format!(\"    assert({}.on == {:?});\", c, r.on)); }\n        if let Ok(r) = std::panic::catch_unwind(|| mk(-1)) { let c = \"mk(-1)\"; v.push(format!(\"    assert({}.x == {:?});\", c, r.x)); v.push(format!(\"    assert({}.on == {:?});\", c, r.on)); }\n        if let Ok(r) = std::panic::catch_unwind(|| mk(7)) { let c = \"mk(7)\"; v.push(format!(\"    assert({}.x == {:?});\", c, r.x)); v.push(format!(\"    assert({}.on == {:?});\", c, r.on)); }\n        if let Ok(r) = std::panic::catch_unwind(|| mk(-100)) { let c = \"mk(-100)\"; v.push(format!(\"    assert({}.x == {:?});\", c, r.x)); v.push(format!(\"    assert({}.on == {:?});\", c, r.on)); }\n        if let Ok(r) = std::panic::catch_unwind(|| mk(2147483647)) { let c = \"mk(2147483647)\"; v.push(format!(\"    assert({}.x == {:?});\", c, r.x)); v.push(format!(\"    assert({}.on == {:?});\", c, r.on)); }\n        if let Ok(r) = std::panic::catch_unwind(|| mk((-2147483648))) { let c = \"mk((-2147483648))\"; v.push(format!(\"    assert({}.x == {:?});\", c, r.x)); v.push(format!(\"    assert({}.on == {:?});\", c, r.on)); }\n        if let Ok(r) = std::panic::catch_unwind(|| mk(0)) { let c = \"mk(0)\"; v.push(format!(\"    assert({}.x == {:?});\", c, r.x)); v.push(format!(\"    assert({}.on == {:?});\", c, r.on)); }\n        if let Ok(r) = std::panic::catch_unwind(|| mk(1)) { let c = \"mk(1)\"; v.push(format!(\"    assert({}.x == {:?});\", c, r.x)); v.push(format!(\"    assert({}.on == {:?});\", c, r.on)); }\n        if !v.is_empty() { println!(\"test oracle_mk {{\"); for l in &v { println!(\"{}\", l); } println!(\"}}\\n\"); }\n    }\n    {\n        let mut v: Vec<String> = Vec::new();\n        if let Ok(r) = std::panic::catch_unwind(|| w(0)) { let c = \"w(0)\"; v.push(format!(\"    assert({}._0[0] == {:?});\", c, r.0[0])); v.push(format!(\"    assert({}._0[1] == {:?});\", c, r.0[1])); }\n        if let Ok(r) = std::panic::catch_unwind(|| w(1)) { let c = \"w(1)\"; v.push(format!(\"    assert({}._0[0] == {:?});\", c, r.0[0])); v.push(format!(\"    assert({}._0[1] == {:?});\", c, r.0[1])); }\n        if let Ok(r) = std::panic::catch_unwind(|| w(2)) { let c = \"w(2)\"; v.push(format!(\"    assert({}._0[0] == {:?});\", c, r.0[0])); v.push(format!(\"    assert({}._0[1] == {:?});\", c, r.0[1])); }\n        if let Ok(r) = std::panic::catch_unwind(|| w(7)) { let c = \"w(7)\"; v.push(format!(\"    assert({}._0[0] == {:?});\", c, r.0[0])); v.push(format!(\"    assert({}._0[1] == {:?});\", c, r.0[1])); }\n        if let Ok(r) = std::panic::catch_unwind(|| w(10)) { let c = \"w(10)\"; v.push(format!(\"    assert({}._0[0] == {:?});\", c, r.0[0])); v.push(format!(\"    assert({}._0[1] == {:?});\", c, r.0[1])); }\n        if let Ok(r) = std::panic::catch_unwind(|| w(100)) { let c = \"w(100)\"; v.push(format!(\"    assert({}._0[0] == {:?});\", c, r.0[0])); v.push(format!(\"    assert({}._0[1] == {:?});\", c, r.0[1])); }\n        if let Ok(r) = std::panic::catch_unwind(|| w(255)) { let c = \"w(255)\"; v.push(format!(\"    assert({}._0[0] == {:?});\", c, r.0[0])); v.push(format!(\"    assert({}._0[1] == {:?});\", c, r.0[1])); }\n        if let Ok(r) = std::panic::catch_unwind(|| w(0)) { let c = \"w(0)\"; v.push(format!(\"    assert({}._0[0] == {:?});\", c, r.0[0])); v.push(format!(\"    assert({}._0[1] == {:?});\", c, r.0[1])); }\n        if let Ok(r) = std::panic::catch_unwind(|| w(1)) { let c = \"w(1)\"; v.push(format!(\"    assert({}._0[0] == {:?});\", c, r.0[0])); v.push(format!(\"    assert({}._0[1] == {:?});\", c, r.0[1])); }\n        if !v.is_empty() { println!(\"test oracle_w {{\"); for l in &v { println!(\"{}\", l); } println!(\"}}\\n\"); }\n    }\n    {\n        let mut v: Vec<String> = Vec::new();\n        if let Ok(r) = std::panic::catch_unwind(|| total(&mut [0.0; 3], 1.0)) { let c = \"total(&t27o_0_0, 1.0)\"; let d = \"    var t27o_0_0 : [3]f64 = [@as(f64, 0.0)] ** 3;\\n\"; if r.is_finite() { v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); } }\n        if let Ok(r) = std::panic::catch_unwind(|| total(&mut [1.0; 3], -1.5)) { let c = \"total(&t27o_1_0, -1.5)\"; let d = \"    var t27o_1_0 : [3]f64 = [@as(f64, 1.0)] ** 3;\\n\"; if r.is_finite() { v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); } }\n        if let Ok(r) = std::panic::catch_unwind(|| total(&mut [-1.5; 3], 2.5)) { let c = \"total(&t27o_2_0, 2.5)\"; let d = \"    var t27o_2_0 : [3]f64 = [@as(f64, -1.5)] ** 3;\\n\"; if r.is_finite() { v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); } }\n        if let Ok(r) = std::panic::catch_unwind(|| total(&mut [2.5; 3], 100.0)) { let c = \"total(&t27o_3_0, 100.0)\"; let d = \"    var t27o_3_0 : [3]f64 = [@as(f64, 2.5)] ** 3;\\n\"; if r.is_finite() { v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); } }\n        if let Ok(r) = std::panic::catch_unwind(|| total(&mut [100.0; 3], 0.0)) { let c = \"total(&t27o_4_0, 0.0)\"; let d = \"    var t27o_4_0 : [3]f64 = [@as(f64, 100.0)] ** 3;\\n\"; if r.is_finite() { v.push(format!(\"{}    assert({} == {:?});\", d, c, r)); } }\n        if !v.is_empty() { println!(\"test oracle_total {{\"); for l in &v { println!(\"{}\", l); } println!(\"}}\\n\"); }\n    }\n}\n"));
}

test body_string_literals_sample_alone_and_wrapped {
    var st : [1024]usize = [0] ** 1024;
    const src : []const u8 = "fn arm(s: &str) -> Option<&str> { match s { \"+=\" => Some(\"+\"), _ => None } }";
    const fb : usize = find_at(src, 0, B_LBRACE);
    st[FBLO] = fb + 1;
    st[FBHI] = block_end(src, fb) - 1;
    // the arm's discriminant alone and wrapped in one space, then the arm's own text the same way
    assert(derived_at(src, &st, V_STR, 0, 0) and st[DCSP] == 0 and st[DCLB] - st[DCLA] == 2 and src[st[DCLA]] == B_PLUS);
    assert(derived_at(src, &st, V_STR, 0, 1) and st[DCSP] == 1 and st[DCLB] - st[DCLA] == 2);
    assert(derived_at(src, &st, V_STR, 0, 2) and st[DCSP] == 0 and st[DCLB] - st[DCLA] == 1 and src[st[DCLA]] == B_PLUS);
    assert(derived_at(src, &st, V_STR, 0, 3) and st[DCSP] == 1 and st[DCLB] - st[DCLA] == 1);
    assert(!derived_at(src, &st, V_STR, 0, 4));
    assert(slen(src, &st, V_STR, 0) == 12);
    // an escaped text and an empty one name no sample: neither reads the same between the quotes
    const bad : []const u8 = "fn esc(s: &str) -> bool { s == \"a\\nb\" || s == \"\" }";
    const bf : usize = find_at(bad, 0, B_LBRACE);
    st[FBLO] = bf + 1;
    st[FBHI] = block_end(bad, bf) - 1;
    assert(!derived_at(bad, &st, V_STR, 0, 0));
    assert(slen(bad, &st, V_STR, 0) == 8);
}

test body_integer_literals_sample_the_edges_the_type_holds {
    var st : [1024]usize = [0] ** 1024;
    const hi : []const u8 = "fn hi(x: u8) -> bool { x == 255 }";
    const hq : usize = skip_ws(hi, tok_end(hi, skip_ws(hi, tok_end(hi, skip_ws(hi, find_at(hi, 0, B_LPAREN) + 1)))));
    const hb : usize = find_at(hi, 0, B_LBRACE);
    st[FBLO] = hb + 1;
    st[FBHI] = block_end(hi, hb) - 1;
    // one below and at it; 256 is past what a u8 holds, so the walk names no third sample
    assert(derived_at(hi, &st, V_UNSIGNED, hq, 0) and st[DVAL] == 254 and st[DNEG] == 0);
    assert(derived_at(hi, &st, V_UNSIGNED, hq, 1) and st[DVAL] == 255 and st[DNEG] == 0);
    assert(!derived_at(hi, &st, V_UNSIGNED, hq, 2));
    assert(slen(hi, &st, V_UNSIGNED, hq) == 9);
    const lo : []const u8 = "fn lo(x: i32) -> bool { x == -3 }";
    const lq : usize = skip_ws(lo, tok_end(lo, skip_ws(lo, tok_end(lo, skip_ws(lo, find_at(lo, 0, B_LPAREN) + 1)))));
    const lb : usize = find_at(lo, 0, B_LBRACE);
    st[FBLO] = lb + 1;
    st[FBHI] = block_end(lo, lb) - 1;
    // the `-` glued to the 3 is its sign: the samples are -4, -3 and -2
    assert(derived_at(lo, &st, V_SIGNED, lq, 0) and st[DVAL] == 4 and st[DNEG] == 1);
    assert(derived_at(lo, &st, V_SIGNED, lq, 1) and st[DVAL] == 3 and st[DNEG] == 1);
    assert(derived_at(lo, &st, V_SIGNED, lq, 2) and st[DVAL] == 2 and st[DNEG] == 1);
    assert(!derived_at(lo, &st, V_SIGNED, lq, 3));
    assert(slen(lo, &st, V_SIGNED, lq) == 10);
}

test clean_text_and_num_value_gate_the_samples {
    assert(clean_text("+=", 0, 2));
    assert(!clean_text("a\\b", 0, 3));
    assert(!clean_text("a\"b", 0, 3));
    assert(!clean_text("xy", 1, 1));
    // sixty-four bytes fit, sixty-five do not (FR-003 of #9102)
    assert(!clean_text("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 0, 65));
    assert(clean_text("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 0, 64));
    assert(num_value("0x1f", 0, tok_end("0x1f", 0)) == 31);
    assert(num_value("1_0", 0, tok_end("1_0", 0)) == 10);
    assert(num_value("42u8", 0, tok_end("42u8", 0)) == 42);
    // a float reads as NUM_REFUSED, "no sample": its low bits are gone by then
    assert(num_value("1.5", 0, tok_end("1.5", 0)) == 4611686018427387904);
    assert(num_value("3e2", 0, tok_end("3e2", 0)) == 4611686018427387904);
}

test byte_and_char_literals_are_one_byte_texts {
    var st : [1024]usize = [0] ** 1024;
    const src : []const u8 = "fn op(b: &[u8]) -> bool { b == b\"+\" || b[0] as char == '+' }";
    const fb : usize = find_at(src, 0, B_LBRACE);
    st[FBLO] = fb + 1;
    st[FBHI] = block_end(src, fb) - 1;
    // the byte string b\"+\" twice (alone, wrapped), the char '+' once: one-byte texts
    assert(derived_at(src, &st, V_BYTES, 0, 0) and st[DCSP] == 0 and st[DCLB] - st[DCLA] == 1 and src[st[DCLA]] == B_PLUS);
    assert(derived_at(src, &st, V_BYTES, 0, 1) and st[DCSP] == 1);
    assert(derived_at(src, &st, V_BYTES, 0, 2) and st[DCSP] == 0 and src[st[DCLA]] == B_PLUS);
    assert(!derived_at(src, &st, V_BYTES, 0, 3));
    assert(slen(src, &st, V_BYTES, 0) == 8);
}

test the_sample_count_caps_at_64 {
    var st : [1024]usize = [0] ** 1024;
    const src : []const u8 = "fn many(s: &str) -> bool { s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || s == \"0\" || false }";
    const fb : usize = find_at(src, 0, B_LBRACE);
    st[FBLO] = fb + 1;
    st[FBHI] = block_end(src, fb) - 1;
    // thirty literals hold sixty samples; the count stops at DCAP: 8 fixed + 56 derived (FR-003 of #9102)
    assert(slen(src, &st, V_STR, 0) == 64);
    assert(derived_at(src, &st, V_STR, 0, 59));
    assert(!derived_at(src, &st, V_STR, 0, 60));
}

test the_oracle_samples_the_arms_discriminants {
    var out : [4096]u8 = undefined;
    var st : [1024]usize = [0] ** 1024;
    const n : usize = oracle("fn tag(s: &str) -> bool { s == \"x\" }", &out, &st);
    // the eight fixed texts, then the predicate's own \"x\" alone and wrapped in one space (#9102)
    assert(out_is(n, &out, 0, "// t27o oracle harness (specs/tools/t27o/rust_convert.t27): the converted items, run to record\n// their behaviour as t27 tests.\n#![allow(warnings)]\n\nfn tag(s: &str) -> bool { s == \"x\" }\n\nfn main() {\n    std::panic::set_hook(Box::new(|_| {}));\n    {\n        let mut v: Vec<String> = Vec::new();\n        if let Ok(r) = std::panic::catch_unwind(|| tag(\"\")) { let c = \"tag(\\\"\\\")\"; v.push(format!(\"    assert({} == {:?});\", c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| tag(\"a\")) { let c = \"tag(\\\"a\\\")\"; v.push(format!(\"    assert({} == {:?});\", c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| tag(\"abc\")) { let c = \"tag(\\\"abc\\\")\"; v.push(format!(\"    assert({} == {:?});\", c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| tag(\"0\")) { let c = \"tag(\\\"0\\\")\"; v.push(format!(\"    assert({} == {:?});\", c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| tag(\"42\")) { let c = \"tag(\\\"42\\\")\"; v.push(format!(\"    assert({} == {:?});\", c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| tag(\"0x1f\")) { let c = \"tag(\\\"0x1f\\\")\"; v.push(format!(\"    assert({} == {:?});\", c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| tag(\"a b\")) { let c = \"tag(\\\"a b\\\")\"; v.push(format!(\"    assert({} == {:?});\", c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| tag(\"-7\")) { let c = \"tag(\\\"-7\\\")\"; v.push(format!(\"    assert({} == {:?});\", c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| tag(\"x\")) { let c = \"tag(\\\"x\\\")\"; v.push(format!(\"    assert({} == {:?});\", c, r)); }\n        if let Ok(r) = std::panic::catch_unwind(|| tag(\" x \")) { let c = \"tag(\\\" x \\\")\"; v.push(format!(\"    assert({} == {:?});\", c, r)); }\n        if !v.is_empty() { println!(\"test oracle_tag {{\"); for l in &v { println!(\"{}\", l); } println!(\"}}\\n\"); }\n    }\n}\n"));
}
