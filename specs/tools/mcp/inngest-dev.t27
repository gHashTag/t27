    // Create Inngest server specification
    fn create_server() -> InngestServer {
        let deprecated_count = count_tools_by_permission(ToolPermission::Deprecated);
        
        InngestServer {
            info: ServerInfo {
                name: SERVER_NAME,
                version: SERVER_VERSION,
                transport: TRANSPORT_TYPE,
                description: "Inngest MCP server for workflow automation",
                tools_count: 20,
                deprecated_count: deprecated_count,
            },
            tools: AVAILABLE_TOOLS,
            environment_vars: [REQUIRED_ENV],
            base_url: "https://inngestinngest-production-c468.up.railway.app",
        }
    }

    // Count tools by permission level
    fn count_tools_by_permission(permission: ToolPermission) -> u32 {
        let count = 0;
        for tool in AVAILABLE_TOOLS {
            if tool.permission == permission {
                count = count + 1;
            }
        }
        count
    }

    // Get tool by ID
    fn get_tool(tool_id: str) -> Result<InngestTool, str> {
        for tool in AVAILABLE_TOOLS {
            if tool.id == tool_id {
                return Ok(tool);
            }
        }
        Err(format!("Tool not found: {}", tool_id))
    }

    // List tools by category
    fn list_tools_by_category(category: ToolCategory) -> [InngestTool] {
        let result = [];
        for tool in AVAILABLE_TOOLS {
            if tool.category == category {
                result = result + [tool];
            }
        }
        result
    }

    // Check if tool requires authentication
    fn tool_requires_auth(tool_id: str) -> bool {
        match get_tool(tool_id) {
            Ok(tool) => tool.requires_auth,
            Err(_) => false,
        }
    }

    // Validate environment variables
    fn validate_environment() -> Result<void, str> {
        // Check if required environment variable is set
        // This would be done at runtime, not compile time
        Ok(())
    }

    test "create_server_success"
        const server = create_server();
        assert(server.info.name == "inngest-dev");
        assert(server.info.version == "1.0.0");
        assert(server.info.tools_count == 20);
        assert(server.info.deprecated_count == 2); // list_events and get_event
        assert(server.tools.len == 20);
    }

    test "count_deprecated_tools"
        const count = count_tools_by_permission(ToolPermission::Deprecated);
        assert(count == 2); // list_events and get_event
    }

    test "get_tool_success"
        const tool = get_tool("health_get");
        match tool {
            Ok(t) => {
                assert(t.id == "health_get");
                assert(t.name == "Health Check");
                assert(t.requires_auth == false);
            },
            Err(_) => assert(false),
        }
    }

    test "get_tool_failure"
        const tool = get_tool("nonexistent_tool");
        match tool {
            Ok(_) => assert(false),
            Err(e) => assert(e.contains("Tool not found")),
        }
    }

    test "list_health_tools"
        const health_tools = list_tools_by_category(ToolCategory::Health);
        assert(health_tools.len == 2);
        assert(health_tools[0].id == "health_get");
        assert(health_tools[1].id == "health_apps");
    }

    test "tool_requires_auth_check"
        const requires_auth = tool_requires_auth("apps_list");
        assert(requires_auth == true);
        
        const no_auth = tool_requires_auth("health_get");
        assert(no_auth == false);
    }
}