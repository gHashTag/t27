# specs/tools/mcp/inngest-dev.t27
# Inngest MCP Server Tool Card
# phi^2 + 1/phi^2 = 3 | TRINITY

module tools::mcp::inngest_dev {
    use base::types;
    use tools::schema;

    // Tool card from the live tools/list (20 tools, 4 marked deprecated by the server)
    // TRANSPORT http, ENV INNGEST_SIGNING_KEY
    // Measured: health/get, apps/list, list_runs answer 401 without the key
    // list_docs/grep_docs answer

    const SERVER_NAME : str = "inngest-dev";
    const SERVER_VERSION : str = "1.0.0";
    const TRANSPORT_TYPE : str = "http";
    const REQUIRED_ENV : str = "INNGEST_SIGNING_KEY";

    // MCP Server Information
    struct ServerInfo {
        name: str,
        version: str,
        transport: str,
        description: str,
        tools_count: u32,
        deprecated_count: u32,
    }

    // Tool categories for Inngest operations
    enum ToolCategory {
        Health = 0,           // Health checks
        AppManagement = 1,    // Application operations
        Workflow = 2,         // Workflow/run operations
        Documentation = 3,     // Documentation operations
        System = 4,           // System operations
    }

    // Tool permission levels
    enum ToolPermission {
        Allowed = 0,           // Tool can be used freely
        Deprecated = 1,        // Tool is deprecated but still works
        Denied = 2,            // Tool is disabled
    }

    // Tool parameter schema
    struct ToolParameter {
        name: str,
        type: str,
        description: str,
        required: bool,
        default: any?,
    }

    // Inngest tool definition
    struct InngestTool {
        id: str,
        name: str,
        category: ToolCategory,
        permission: ToolPermission,
        description: str,
        parameters: [ToolParameter],
        requires_auth: bool,
        deprecated_reason: str?,
    }

    // Complete MCP server specification
    struct InngestServer {
        info: ServerInfo,
        tools: [InngestTool],
        environment_vars: [str],
        base_url: str,
    }

