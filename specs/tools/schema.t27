// specs/tools/schema.t27
// Tools Types Specification
// M-OM-^FM-BM-2 + 1/M-OM-^FM-BM-2 = 3 | TRINITY

module Tools {
    use base::types;

    // Tool ID Type
    // ════════════════════════════════════════════════════════════════════

    // ToolID is a branded string representing a tool identifier
    struct ToolID {
        value: str,
    }

    // CallID is a branded string representing a tool call identifier
    struct CallID {
        value: str,
    }

    // ════════════════════════════════════════════════════════════════════
    // Tool Types
    // ════════════════════════════════════════════════════════════════════

    // Tool represents a callable tool with metadata
    pub struct Tool {
        name: str,                    // Tool name (unique identifier)
        description: str,             // Human-readable description
        parameters: [ParameterSchema], // Parameter definitions
        return_type: str,            // Return type specification
        category: str,               // Tool category (e.g., "math", "string", "system")
        version: str,                // Tool version
        deprecated: bool,            // Whether the tool is deprecated
        experimental: bool,          // Whether the tool is experimental
    }

    // Parameter represents a function parameter with type and metadata
    pub struct ParameterSchema {
        type: str,             // Parameter type (string, number, boolean, etc.)
        description: str?,     // Parameter description
        required: bool,         // Whether parameter is required
        default: any?,          // Default value
        enum: [any]?,          // Enum values if applicable
    }
}