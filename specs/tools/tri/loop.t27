; specs/tools/tri/loop.t27 -- tool tri/loop, the `tri loop` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/loop).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_loop;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/loop";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/loop";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri loop";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Loop";
pub const SOURCE : str = "cli/tri/src/loopclaim.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; The clap about text (first /// paragraph), as `tri --help` would print it.
pub const ABOUT : str = "What is failing on the default branch right now, and since when. Take a named claim so two sessions of the loop cannot pick the same task.";
pub const ABOUT_SOURCE : str = "clap /// doc on Commands::Loop (cli/tri/src/main.rs; module cli/tri/src/loopclaim.rs)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [1]str = ["claim"];
pub const ACTIONS_ABOUT : [1]str = ["Take the named claim, or say who already holds it."];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [0]str = [];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "J"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead J: CHANGED (dropped Q): the one action is \"Take the named claim, or say who already holds it\" so \"two sessions of the loop cannot pick the same task\" -- the spec says nothing about a queue, ordering, scheduling or starvation, which is what Q's domain is defined by; claiming and assigning tasks is J's Jobs / Task Routing (\"all jobs assigned\").";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "What is failing on the default branch right now, and since when. Take a named claim so two sessions of the loop cannot pick the same task.";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

; The identity of the card, held to the rules it is written under: specs/tools/catalog.t27
; (ID_RULE: a legacy card has ID = <family>/<name> and QUALIFIED_ID = REPO:ID; every card
; carries SCHEMA = 2) and the header above (the `tri <name>` command of the tri CLI, read off
; a clap #[derive(Subcommand)] enum, which spells the name of a variant in kebab-case).

test qualified_id_is_repo_colon_id {
    assert SCHEMA == 2;
    assert QUALIFIED_ID.len == REPO.len + 1 + ID.len;
    var i : usize = 0;
    while (i < REPO.len) {
        assert QUALIFIED_ID[i] == REPO[i];
        i = i + 1;
    }
    assert QUALIFIED_ID[REPO.len] == ':';
    var j : usize = 0;
    while (j < ID.len) {
        assert QUALIFIED_ID[REPO.len + 1 + j] == ID[j];
        j = j + 1;
    }
}

test id_command_and_variant_name_one_subcommand {
    // ID is `tri/<name>` and COMMAND is `tri <name>`: the same bytes but the separator.
    assert ID.len == COMMAND.len;
    var i : usize = 0;
    while (i < ID.len) {
        if (i == 3) {
            assert ID[i] == '/';
            assert COMMAND[i] == ' ';
        } else {
            assert ID[i] == COMMAND[i];
        }
        i = i + 1;
    }
    assert COMMAND[0] == 't';
    assert COMMAND[1] == 'r';
    assert COMMAND[2] == 'i';
    // VARIANT is `Commands::<Name>`, and the kebab-case of <Name> is <name>: an upper-case
    // letter starts each word, and a word boundary is a `-` in the name.
    assert VARIANT[8] == ':';
    assert VARIANT[9] == ':';
    var v : usize = 10;
    var n : usize = 4;
    var word_start : bool = true;
    while (n < ID.len) {
        if (ID[n] == '-') {
            word_start = true;
        } else {
            if (word_start) {
                assert VARIANT[v] == ID[n] - 32;
            } else {
                assert VARIANT[v] == ID[n];
            }
            word_start = false;
            v = v + 1;
        }
        n = n + 1;
    }
    assert v == VARIANT.len;
}

test clap_names_are_kebab_case {
    // The own name of the command and every action are lower-case words joined by `-`, and each
    // action has its about text (`""` when the source has none) at the same index.
    assert ACTIONS.len == ACTIONS_ABOUT.len;
    var n : usize = 4;
    while (n < ID.len) {
        assert (ID[n] >= 'a' and ID[n] <= 'z') or ID[n] == '-';
        n = n + 1;
    }
    assert ID[4] != '-';
    assert ID[ID.len - 1] != '-';
    var a : usize = 0;
    while (a < ACTIONS.len) {
        var k : usize = 0;
        while (k < ACTIONS[a].len) {
            assert (ACTIONS[a][k] >= 'a' and ACTIONS[a][k] <= 'z') or (ACTIONS[a][k] >= '0' and ACTIONS[a][k] <= '9') or ACTIONS[a][k] == '-';
            k = k + 1;
        }
        assert ACTIONS[a][0] != '-';
        a = a + 1;
    }
    // ARGS are `<positional>` or `--flag`, each with its doc after `: ` when it has one.
    var g : usize = 0;
    while (g < ARGS.len) {
        assert ARGS[g][0] == '<' or (ARGS[g][0] == '-' and ARGS[g][1] == '-');
        g = g + 1;
    }
}

test the_queen_holds_every_tool_beside_its_lead {
    // AGENTS_ALPHABET.md binds every tool to the Queen (T) and names its domain lead(s):
    // one letter each, the Queen first, no letter twice.
    assert AGENTS.len >= 2;
    assert AGENTS[0] == "T";
    var i : usize = 0;
    while (i < AGENTS.len) {
        assert AGENTS[i].len == 1;
        assert AGENTS[i][0] >= 'A' and AGENTS[i][0] <= 'Z';
        var j : usize = i + 1;
        while (j < AGENTS.len) {
            assert AGENTS[i][0] != AGENTS[j][0];
            j = j + 1;
        }
        i = i + 1;
    }
}

// Wave Loop 891 pattern: packed-vector array-of-struct with outer dimension 601
// Outer dimension: 601 (non-power-of-two)
// Inner struct: [2]^6 Pt (384 bits per element)
// Total elements: 601 × 64 = 38,464
// Packed vector width: 38,464 × 32 = 1,230,848 bits (~1.174 MiBit)

// Pt struct definition for Wave Loop 891
struct Pt {
    x : u32,
    y : u32,
    z : u32,
    w : u32,
    v : u32,
    u : u32,
}

// Module-scope variable for Wave Loop 891 pattern
pub const WAVE_LOOP_891_ARRAY : [601][64]Pt;

// Pure function to initialize the Wave Loop 891 array
fn init_wave_loop_891() -> [601][64]Pt {
    var result : [601][64]Pt;
    var outer_idx : i32 = -1;
    
    // Initialize with pattern data
    for (0..601) |i| {
        for (0..64) |j| {
            result[i][j] = Pt {
                x: (i * 64 + j) as u32,
                y: ((i * 64 + j) * 2) as u32,
                z: ((i * 64 + j) * 3) as u32,
                w: ((i * 64 + j) * 4) as u32,
                v: ((i * 64 + j) * 5) as u32,
                u: ((i * 64 + j) * 6) as u32,
            };
        }
    }
    
    return result;
}

// Initialize the module-scope variable
const WAVE_LOOP_891_ARRAY : [601][64]Pt = init_wave_loop_891();

// Wave Loop 891 bench test
bench wave_loop_891_pattern {
    // Test: module-scope variable initialized from a pure function call
    // mutated via signed-index field writes
    // read back with assert_eq inside a bench block
    
    var test_array : [601][64]Pt = WAVE_LOOP_891_ARRAY;
    
    // Mutate via signed-index field writes
    // Positive indices
    test_array[10][20].x = 12345;
    test_array[10][20].y = 67890;
    test_array[100][50].z = 11111;
    test_array[200][30].w = 22222;
    
    // Negative indices (wrapping)
    test_array[-1][0].x = 33333;  // Should wrap to 600
    test_array[0][-1].y = 44444;  // Should wrap to 63
    test_array[-10][-20].z = 55555; // Should wrap to 591, 44
    
    // Read back with assert_eq
    assert test_array[10][20].x == 12345;
    assert test_array[10][20].y == 67890;
    assert test_array[100][50].z == 11111;
    assert test_array[200][30].w == 22222;
    
    // Verify wrapping behavior
    assert test_array[600][63].x == 33333;  // -1 wraps to 600
    assert test_array[0][63].y == 44444;   // -1 wraps to 63
    assert test_array[591][44].z == 55555;  // -10 wraps to 591, -20 wraps to 44
    
    // Verify other fields unchanged
    assert test_array[10][20].z == (10 * 64 + 20) * 3;
    assert test_array[10][20].w == (10 * 64 + 20) * 4;
    assert test_array[10][20].v == (10 * 64 + 20) * 5;
    assert test_array[10][20].u == (10 * 64 + 20) * 6;
}
