// SPDX-License-Identifier: Apache-2.0
// Tests for while (c) : (step) loops with continue statements
// Issue: gHashTag/t27#3009 - while (c) : (step) with continue is infinite loop in C and Rust

module tool_tri_jumps;

// Probe function from the issue
fn count_odds(n: u32) -> u32 {
    var i: u32 = 0;
    var c: u32 = 0;
    while (i < n) : (i += 1) {
        if (i % 2 == 0) { continue; }
        c = c + 1;
    }
    return c;
}

// Test simple continue with step
fn test_simple_continue() -> u32 {
    var i: u32 = 0;
    var count: u32 = 0;
    while (i < 5) : (i += 1) {
        if (i == 3) { continue; }
        count = count + 1;
    }
    return count;
}

// Test continue in nested if
fn test_continue_in_if() -> u32 {
    var i: u32 = 0;
    var count: u32 = 0;
    while (i < 6) : (i += 1) {
        if (i % 2 == 0) {
            if (i == 4) { continue; }
            count = count + 1;
        }
    }
    return count;
}

// Test multiple continues
fn test_multiple_continues() -> u32 {
    var i: u32 = 0;
    var count: u32 = 0;
    while (i < 8) : (i += 1) {
        if (i == 2 || i == 5 || i == 7) { continue; }
        count = count + 1;
    }
    return count;
}

// Test continue with break (should execute step on continue but not break)
fn test_continue_and_break() -> u32 {
    var i: u32 = 0;
    var count: u32 = 0;
    while (i < 10) : (i += 1) {
        if (i == 3) { continue; }
        if (i == 7) { break; }
        count = count + 1;
    }
    return count;
}