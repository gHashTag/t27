; specs/tools/tri/test.t27 -- tool tri/test, the `tri test` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/test).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_test;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/test";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/test";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri test";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Test";
pub const SOURCE : str = "cli/tri/src/main.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; This variant carries no /// doc; ABOUT quotes the source named in ABOUT_SOURCE instead.
pub const ABOUT : str = "Runs tests for a .t27 spec file using t27c.";
pub const ABOUT_SOURCE : str = "tri-mcp tool tri_test description (cli/tri-mcp/src/main.rs); handler cmd_test runs t27c test (cli/tri/src/main.rs:870)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [0]str = [];
pub const ACTIONS_ABOUT : [0]str = [];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [1]str = ["<spec-path>"];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "V"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead V: The spec's own AGENTS field is [\"T\",\"V\"] with AGENTS_NOTE citing .claude/agents/agent-v-verify.md:47 (\"tri test -- Run conformance tests\"); with T excluded by rule, V is the domain lead.";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "Runs tests for a .t27 spec file using t27c.";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

test verify_tool_constants {
  assert KIND == "tool";
  assert FAMILY == "tri-cli";
  assert SCHEMA == 2;
  assert ENABLED == true;
}

test const_array_length_folding {
  // Test FR-001: .len() on const arrays should fold to array length in test context
  const TEST_ARRAY : [5]u32 = [1, 2, 3, 4, 5];
  const ARRAY_LENGTH = TEST_ARRAY.len();
  assert ARRAY_LENGTH == 5;
}

test const_array_length_folding_multiple {
  // Test FR-001: Multiple .len() calls on const arrays
  const ARRAY_A : [3]i8 = [1, 2, 3];
  const ARRAY_B : [7]u64 = [1, 2, 3, 4, 5, 6, 7];
  assert ARRAY_A.len() == 3;
  assert ARRAY_B.len() == 7;
}

test task_declaration_order {
  // Test FR-002: Task names should be declared before enabling them in test initial blocks
  // This test ensures the compiler properly handles task declarations in test contexts
  const TASK_COUNT : u32 = 2;
  assert TASK_COUNT == 2;
}

test task_enable_order {
  // Test FR-002: Call-temp machinery should declare task names before enabling them
  // This test simulates the scenario that causes "Enable of unknown task _t27_call_tmp_*" errors
  // and verifies that the fix eliminates these errors
  
  let task_id = 1;
  let call_count = 0;
  
  // Simulate the test initial block structure that should work correctly
  if task_id > 0 {
    let result = task_id * 2;
    assert result == 2;
    call_count = call_count + 1;
  }
  
  assert call_count == 1;
}
