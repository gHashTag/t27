// SPDX-License-Identifier: Apache-2.0
; specs/tools/tri/skill.t27 -- tool tri/skill, the `tri skill` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/skill).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_skill;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/skill";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/skill";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri skill";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Skill";
pub const SOURCE : str = "cli/tri/src/main.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; This variant carries no /// doc; ABOUT quotes the source named in ABOUT_SOURCE instead.
pub const ABOUT : str = "Begins a new PHI LOOP skill session bound to an issue. Ends the active PHI LOOP skill session. The add/fold/check/lost/refs/claims/renumber actions carry their own clap docs (SKILL.md lesson spool).";
pub const ABOUT_SOURCE : str = "tri-mcp tools tri_skill_begin and tri_skill_end descriptions (cli/tri-mcp/src/main.rs); SkillAction enum cli/tri/src/main.rs:349";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [9]str = ["add", "fold", "check", "lost", "refs", "claims", "renumber", "begin", "end"];
pub const ACTIONS_ABOUT : [9]str = ["Write a new lesson to the spool, unnumbered.", "Fold every spooled lesson into SKILL.md, numbering them on the way in.", "Check every SKILL.md's section numbering for collisions.", "Sections whose body was cut short at some point in the file's history.", "Every cross-reference in the skills, and whether it resolves.", "Sections that state a FIGURE, and which of those a reader can re-take.", "Move sections you appended to the numbers the base branch left free.", "", ""];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [0]str = [];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "E"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead E: ABOUT names the \"SKILL.md lesson spool\" and seven of nine actions operate it -- \"Write a new lesson to the spool\", \"Fold every spooled lesson into SKILL.md\", plus check/lost/refs/claims/renumber -- which is E's exit invariant \"Lessons learned catalogued\", the same domain as the E-bound tri/experience.";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "Begins a new PHI LOOP skill session bound to an issue. Ends the active PHI LOOP skill session. The add/fold/check/lost/refs/claims/renumber actions carry their own clap docs (SKILL.md lesson spool).";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

; The identity of the card, held to the rules it is written under: specs/tools/catalog.t27
; (ID_RULE: a legacy card has ID = <family>/<name> and QUALIFIED_ID = REPO:ID; every card
; carries SCHEMA = 2) and the header above (the `tri <name>` command of the tri CLI, read off
; a clap #[derive(Subcommand)] enum, which spells the name of a variant in kebab-case).

test qualified_id_is_repo_colon_id {
    assert SCHEMA == 2;
    assert QUALIFIED_ID.len == REPO.len + 1 + ID.len;
    var i : usize = 0;
    while (i < REPO.len) {
        assert QUALIFIED_ID[i] == REPO[i];
        i = i + 1;
    }
    assert QUALIFIED_ID[REPO.len] == ':';
    var j : usize = 0;
    while (j < ID.len) {
        assert QUALIFIED_ID[REPO.len + 1 + j] == ID[j];
        j = j + 1;
    }
}

test id_command_and_variant_name_one_subcommand {
    // ID is `tri/<name>` and COMMAND is `tri <name>`: the same bytes but the separator.
    assert ID.len == COMMAND.len;
    var i : usize = 0;
    while (i < ID.len) {
        if (i == 3) {
            assert ID[i] == '/';
            assert COMMAND[i] == ' ';
        } else {
            assert ID[i] == COMMAND[i];
        }
        i = i + 1;
    }
    assert COMMAND[0] == 't';
    assert COMMAND[1] == 'r';
    assert COMMAND[2] == 'i';
    // VARIANT is `Commands::<Name>`, and the kebab-case of <Name> is <name>: an upper-case
    // letter starts each word, and a word boundary is a `-` in the name.
    assert VARIANT[8] == ':';
    assert VARIANT[9] == ':';
    var v : usize = 10;
    var n : usize = 4;
    var word_start : bool = true;
    while (n < ID.len) {
        if (ID[n] == '-') {
            word_start = true;
        } else {
            if (word_start) {
                assert VARIANT[v] == ID[n] - 32;
            } else {
                assert VARIANT[v] == ID[n];
            }
            word_start = false;
            v = v + 1;
        }
        n = n + 1;
    }
    assert v == VARIANT.len;
}

test clap_names_are_kebab_case {
    // The own name of the command and every action are lower-case words joined by `-`, and each
    // action has its about text (`""` when the source has none) at the same index.
    assert ACTIONS.len == ACTIONS_ABOUT.len;
    var n : usize = 4;
    while (n < ID.len) {
        assert (ID[n] >= 'a' and ID[n] <= 'z') or ID[n] == '-';
        n = n + 1;
    }
    assert ID[4] != '-';
    assert ID[ID.len - 1] != '-';
    var a : usize = 0;
    while (a < ACTIONS.len) {
        var k : usize = 0;
        while (k < ACTIONS[a].len) {
            assert (ACTIONS[a][k] >= 'a' and ACTIONS[a][k] <= 'z') or (ACTIONS[a][k] >= '0' and ACTIONS[a][k] <= '9') or ACTIONS[a][k] == '-';
            k = k + 1;
        }
        assert ACTIONS[a][0] != '-';
        a = a + 1;
    }
    // ARGS are `<positional>` or `--flag`, each with its doc after `: ` when it has one.
    var g : usize = 0;
    while (g < ARGS.len) {
        assert ARGS[g][0] == '<' or (ARGS[g][0] == '-' and ARGS[g][1] == '-');
        g = g + 1;
    }
}

test the_queen_holds_every_tool_beside_its_lead {
    // AGENTS_ALPHABET.md binds every tool to the Queen (T) and names its domain lead(s):
    // one letter each, the Queen first, no letter twice.
    assert AGENTS.len >= 2;
    assert AGENTS[0] == "T";
    var i : usize = 0;
    while (i < AGENTS.len) {
        assert AGENTS[i].len == 1;
        assert AGENTS[i][0] >= 'A' and AGENTS[i][0] <= 'Z';
        var j : usize = i + 1;
        while (j < AGENTS.len) {
            assert AGENTS[i][0] != AGENTS[j][0];
            j = j + 1;
        }
        i = i + 1;
    }
}
