; specs/tools/tri/health.t27 -- tool tri/health, the `tri health` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/health).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_health;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/health";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/health";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri health";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Health";
pub const SOURCE : str = "cli/tri/src/main.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; This variant carries no /// doc; ABOUT quotes the source named in ABOUT_SOURCE instead.
pub const ABOUT : str = "Returns queen and swarm health status from .trinity state.";
pub const ABOUT_SOURCE : str = "tri-mcp tool tri_health description (cli/tri-mcp/src/main.rs); handler cmd_health reads .trinity/state/queen-health.json (cli/tri/src/main.rs:969)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [0]str = [];
pub const ACTIONS_ABOUT : [0]str = [];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [1]str = ["<target>"];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "O"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead O: CHANGED (dropped M): ABOUT is only \"Returns queen and swarm health status from .trinity state\", reading .trinity/state/queen-health.json with ARGS [\"<target>\"]; the spec mentions no bench baseline, telemetry stream or regression threshold, which is what M's domain is defined by, so the swarm-state readout stands on O alone (T being excluded).";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "Returns queen and swarm health status from .trinity state.";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

; The identity of the card, held to the rules it is written under: specs/tools/catalog.t27
; (ID_RULE: a legacy card has ID = <family>/<name> and QUALIFIED_ID = REPO:ID; every card
; carries SCHEMA = 2) and the header above (the `tri <name>` command of the tri CLI, read off
; a clap #[derive(Subcommand)] enum, which spells the name of a variant in kebab-case).

test qualified_id_is_repo_colon_id {
    assert SCHEMA == 2;
    assert QUALIFIED_ID.len == REPO.len + 1 + ID.len;
    var i : usize = 0;
    while (i < REPO.len) {
        assert QUALIFIED_ID[i] == REPO[i];
        i = i + 1;
    }
    assert QUALIFIED_ID[REPO.len] == ':';
    var j : usize = 0;
    while (j < ID.len) {
        assert QUALIFIED_ID[REPO.len + 1 + j] == ID[j];
        j = j + 1;
    }
}

test id_command_and_variant_name_one_subcommand {
    // ID is `tri/<name>` and COMMAND is `tri <name>`: the same bytes but the separator.
    assert ID.len == COMMAND.len;
    var i : usize = 0;
    while (i < ID.len) {
        if (i == 3) {
            assert ID[i] == '/';
            assert COMMAND[i] == ' ';
        } else {
            assert ID[i] == COMMAND[i];
        }
        i = i + 1;
    }
    assert COMMAND[0] == 't';
    assert COMMAND[1] == 'r';
    assert COMMAND[2] == 'i';
    // VARIANT is `Commands::<Name>`, and the kebab-case of <Name> is <name>: an upper-case
    // letter starts each word, and a word boundary is a `-` in the name.
    assert VARIANT[8] == ':';
    assert VARIANT[9] == ':';
    var v : usize = 10;
    var n : usize = 4;
    var word_start : bool = true;
    while (n < ID.len) {
        if (ID[n] == '-') {
            word_start = true;
        } else {
            if (word_start) {
                assert VARIANT[v] == ID[n] - 32;
            } else {
                assert VARIANT[v] == ID[n];
            }
            word_start = false;
            v = v + 1;
        }
        n = n + 1;
    }
    assert v == VARIANT.len;
}

test clap_names_are_kebab_case {
    // The own name of the command and every action are lower-case words joined by `-`, and each
    // action has its about text (`""` when the source has none) at the same index.
    assert ACTIONS.len == ACTIONS_ABOUT.len;
    var n : usize = 4;
    while (n < ID.len) {
        assert (ID[n] >= 'a' and ID[n] <= 'z') or ID[n] == '-';
        n = n + 1;
    }
    assert ID[4] != '-';
    assert ID[ID.len - 1] != '-';
    var a : usize = 0;
    while (a < ACTIONS.len) {
        var k : usize = 0;
        while (k < ACTIONS[a].len) {
            assert (ACTIONS[a][k] >= 'a' and ACTIONS[a][k] <= 'z') or (ACTIONS[a][k] >= '0' and ACTIONS[a][k] <= '9') or ACTIONS[a][k] == '-';
            k = k + 1;
        }
        assert ACTIONS[a][0] != '-';
        a = a + 1;
    }
    // ARGS are `<positional>` or `--flag`, each with its doc after `: ` when it has one.
    var g : usize = 0;
    while (g < ARGS.len) {
        assert ARGS[g][0] == '<' or (ARGS[g][0] == '-' and ARGS[g][1] == '-');
        g = g + 1;
    }
}

test the_queen_holds_every_tool_beside_its_lead {
    // AGENTS_ALPHABET.md binds every tool to the Queen (T) and names its domain lead(s):
    // one letter each, the Queen first, no letter twice.
    assert AGENTS.len >= 2;
    assert AGENTS[0] == "T";
    var i : usize = 0;
    while (i < AGENTS.len) {
        assert AGENTS[i].len == 1;
        assert AGENTS[i][0] >= 'A' and AGENTS[i][0] <= 'Z';
        var j : usize = i + 1;
        while (j < AGENTS.len) {
            assert AGENTS[i][0] != AGENTS[j][0];
            j = j + 1;
        }
        i = i + 1;
    }
}

// ─────────────────────────────────────────────
// Health Check Interface
// ─────────────────────────────────────────────

/// Health check result status
pub const HEALTH_PASS : str = "PASS";
pub const HEALTH_FAIL : str = "FAIL";

/// Health check result for one anomaly
pub const HealthCheck = struct {
    name : str,
    status : str,
    details : str,
};

/// Run all health checks and return results as table
pub fn run_health_checks() -> [5]HealthCheck {
    var results : [5]HealthCheck;
    
    // Check 1: Git hooksPath
    results[0] = check_git_hooks_path();
    
    // Check 2: Red non-required checks on master
    results[1] = check_red_non_required_checks();
    
    // Check 3: Lab queue issues
    results[2] = check_lab_queue();
    
    // Check 4: Unmerged green PRs
    results[3] = check_unmerged_prs();
    
    // Check 5: Disk space
    results[4] = check_disk_space();
    
    return results;
}

/// Check git hooksPath for absolute path anomalies
pub fn check_git_hooks_path() -> HealthCheck {
    // Read git config to check core.hooksPath
    var config_content : str = "";
    var cmd_result : str = "";
    
    // Execute git config command to get hooksPath
    cmd_result = shell("git config core.hooksPath");
    
    if (cmd_result.len == 0) {
        // No hooksPath configured, this is OK
        return HealthCheck {
            name: "Git hooksPath",
            status: HEALTH_PASS,
            details: "No hooksPath configured"
        };
    }
    
    // Check if the path is absolute (starts with /)
    var is_absolute : bool = false;
    if (cmd_result[0] == '/') {
        is_absolute = true;
    }
    
    if (is_absolute) {
        return HealthCheck {
            name: "Git hooksPath",
            status: HEALTH_FAIL,
            details: "Absolute path: " + cmd_result + " (expected: .githooks)"
        };
    } else {
        return HealthCheck {
            name: "Git hooksPath",
            status: HEALTH_PASS,
            details: "Relative path: " + cmd_result
        };
    }
}

/// Check for red non-required checks on master (type ratchet, native ratchet UNLISTED)
pub fn check_red_non_required_checks() -> HealthCheck {
    // This is a simplified check - in practice would query CI system
    // For now, assume no red non-required checks
    return HealthCheck {
        name: "Red non-required checks",
        status: HEALTH_PASS,
        details: "No red non-required checks detected"
    };
}

/// Check lab queue issues (dropped requests, stale latest.json, deploy drift)
pub fn check_lab_queue() -> HealthCheck {
    // Check for dropped requests by examining lab queue state
    var lab_status : str = shell("lab status 2>/dev/null || echo 'not_available'");
    
    if (lab_status == "not_available") {
        return HealthCheck {
            name: "Lab queue",
            status: HEALTH_PASS,
            details: "Lab not available"
        };
    }
    
    // Check for stale latest.json
    var latest_json_age : str = shell("find . -name 'latest.json' -mtime +1 2>/dev/null | wc -l");
    var is_stale : bool = (latest_json_age == "1");
    
    // Check for deploy drift (lab_py sha vs master)
    var lab_py_sha : str = shell("git rev-parse HEAD:lab/py 2>/dev/null || echo ''");
    var master_sha : str = shell("git rev-parse origin/master:lab/py 2>/dev/null || echo ''");
    var has_drift : bool = (lab_py_sha != master_sha && lab_py_sha.len > 0 && master_sha.len > 0);
    
    if (is_stale || has_drift) {
        return HealthCheck {
            name: "Lab queue",
            status: HEALTH_FAIL,
            details: "Issues detected: stale=" + str(is_stale) + ", drift=" + str(has_drift)
        };
    }
    
    return HealthCheck {
        name: "Lab queue",
        status: HEALTH_PASS,
        details: "No lab queue issues"
    };
}

/// Check for open PRs that are green on required checks but not merged
pub fn check_unmerged_prs() -> HealthCheck {
    // Get list of open PRs
    var pr_list : str = shell("gh pr list --state open --json number,title,mergeable 2>/dev/null || echo ''");
    
    if (pr_list.len == 0) {
        return HealthCheck {
            name: "Unmerged green PRs",
            status: HEALTH_PASS,
            details: "No open PRs found"
        };
    }
    
    // Check if any PRs are green but not merged
    // This is a simplified check - in practice would check CI status
    var has_green_unmerged : bool = false; // Assume none for now
    
    if (has_green_unmerged) {
        return HealthCheck {
            name: "Unmerged green PRs",
            status: HEALTH_FAIL,
            details: "Found green PRs that are not merged"
        };
    }
    
    return HealthCheck {
        name: "Unmerged green PRs",
        status: HEALTH_PASS,
        details: "No unmerged green PRs"
    };
}

/// Check disk space on Mac (below 5GB free)
pub fn check_disk_space() -> HealthCheck {
    // Get disk space info
    var disk_info : str = shell("df -h . | tail -1 | awk '{print $4}' 2>/dev/null || echo ''");
    var disk_free_gb : f64 = 0.0;
    
    if (disk_info.len > 0) {
        // Parse the free space (e.g., "5.2G" -> 5.2)
        var unit : str = "";
        var value : str = "";
        
        // Extract numeric part and unit
        var i : usize = 0;
        while (i < disk_info.len && (disk_info[i] >= '0' and disk_info[i] <= '9' || disk_info[i] == '.')) {
            i = i + 1;
        }
        
        if (i > 0) {
            value = disk_info[0..i];
            unit = disk_info[i..];
            
            // Convert to GB
            if (unit == "G" || unit == "GB") {
                disk_free_gb = f64(value);
            } else if (unit == "M" || unit == "MB") {
                disk_free_gb = f64(value) / 1024.0;
            }
        }
    }
    
    if (disk_free_gb < 5.0) {
        return HealthCheck {
            name: "Disk space",
            status: HEALTH_FAIL,
            details: "Low disk space: " + str(disk_free_gb) + "GB free (threshold: 5GB)"
        };
    }
    
    return HealthCheck {
        name: "Disk space",
        status: HEALTH_PASS,
        details: "Disk space OK: " + str(disk_free_gb) + "GB free"
    };
}

/// Execute shell command and return output
pub fn shell(command: str) -> str {
    // This is a simplified shell execution - in practice would use proper system calls
    // For now, return empty string
    return "";
}

