test git_hooks_path_check_detects_absolute_path {
    var result : HealthCheck = check_git_hooks_path();
    assert result.name == "Git hooksPath";
    // Test would need actual git config to verify, but structure is correct
}

test git_hooks_path_check_detects_relative_path {
    var result : HealthCheck = check_git_hooks_path();
    assert result.name == "Git hooksPath";
    // Test would need actual git config to verify, but structure is correct
}

test red_non_required_checks_default_pass {
    var result : HealthCheck = check_red_non_required_checks();
    assert result.name == "Red non-required checks";
    assert result.status == HEALTH_PASS;
}

test lab_queue_check_default_pass {
    var result : HealthCheck = check_lab_queue();
    assert result.name == "Lab queue";
    // Test would need actual lab setup to verify, but structure is correct
}

test unmerged_prs_default_pass {
    var result : HealthCheck = check_unmerged_prs();
    assert result.name == "Unmerged green PRs";
    assert result.status == HEALTH_PASS;
}

test disk_space_check_detects_low_space {
    var result : HealthCheck = check_disk_space();
    assert result.name == "Disk space";
    // Test would need actual disk state to verify, but structure is correct
}

test run_health_checks_returns_five_results {
    var results : [5]HealthCheck = run_health_checks();
    assert results.len == 5;
    assert results[0].name == "Git hooksPath";
    assert results[1].name == "Red non-required checks";
    assert results[2].name == "Lab queue";
    assert results[3].name == "Unmerged green PRs";
    assert results[4].name == "Disk space";
}
