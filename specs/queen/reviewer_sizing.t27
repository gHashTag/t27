// SPDX-License-Identifier: Apache-2.0
; specs/queen/reviewer_sizing.t27 -- the reviewer's worker pool follows its backlog and its lanes
; Owner, 2026-10-09 (translated): "implement all the improvements" (epic gHashTag/trios#1712, item 3:
; load and concurrency by measurement). reviewer.t27 (t27#8212) already says how many rows may be
; reviewed at once: `reviewer_concurrency(keys, lanes_per_key, free_mb, mb_per_review, waiting)`, never
; above REVIEWER_CEILING. The runtime still starts a fixed REVIEWER_CONCURRENCY = 4 workers. This card
; says what the runtime feeds that rule and what it does with the answer:
; - which lanes count: what a key still carries for a review, never more than its provider is measured
;   to carry (z.ai: two requests a key), plus the lanes the pool's own busy reviews already hold;
; - which rows count: the ones under review and the ones queued, so a pool whose workers are all busy
;   still grows for the row behind them;
; - when an idle worker stops: only while the pool is larger than the rule allows, and only after it
;   has been idle a while, as Akka Cluster Sharding passivates an idle entity.
; Starting a worker asks actors.t27 `start_answer` with the target as max_children, as Elixir's
; DynamicSupervisor does: a lowered target refuses new starts and stops nobody.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenReviewerSizing;

use queen::reviewer::reviewer_concurrency;
use queen::reviewer::keeps_up;
use queen::reviewer::slots_needed;

/// Measured 2026-09-15 on the swarm (trios queen-dispatch.ts, configuredRemoteLanesPerCredential): four
/// completions fired at once on one z.ai key, two answered (11.6 s, 12.4 s) and two were refused in
/// under half a second with `1302 Rate limit reached for requests`. A third request on a key is not
/// slower; it is refused.
pub const ZAI_REQUESTS_PER_KEY : u32 = 2;

/// The largest u32, for the sums below that must not wrap.
pub const U32_MAX : u32 = 4294967295;

/// Lanes one key still has for a review: the lanes it is configured with, never more than its provider
/// is measured to carry, less the requests it carries now (bees and reviews alike). Only z.ai is
/// measured; for any other provider the configuration stands, because one provider's measurement is
/// not another's.
pub fn key_free_lanes(configured: u32, carried: u32, zai: bool) -> u32 {
    var cap : u32 = configured;
    if (zai and cap > ZAI_REQUESTS_PER_KEY) { cap = ZAI_REQUESTS_PER_KEY; }
    if (carried >= cap) { return 0; }
    return cap - carried;
}

/// Lanes the worker pool may fill: the lanes free now and the ones its own busy reviews already hold.
/// A lane held by a review whose turn was killed is in neither. It stays taken until that review ends
/// (actors.t27 holds_after_kill), and counting it would let the pool start a review the provider then
/// refuses.
pub fn pool_lanes(free_lanes: u32, held_by_busy: u32) -> u32 {
    if (free_lanes > U32_MAX - held_by_busy) { return U32_MAX; }
    return free_lanes + held_by_busy;
}

/// Rows that want a worker: the ones a worker is reviewing and the ones queued behind them. Counting
/// only the queued ones would size the pool below its own busy workers and leave the next row waiting.
pub fn pool_demand(busy: u32, queued: u32) -> u32 {
    if (busy > U32_MAX - queued) { return U32_MAX; }
    return busy + queued;
}

/// Megabytes a review is charged until the host has measured one. Chosen, not measured: the figure
/// reviewer.t27's own test uses for a host with 8 GB free. Without it the host would pass 0, and
/// reviewer_concurrency reads 0 as "one review", so the pool could never grow. The adaptive pool stays
/// behind a flag until a measured figure replaces this one.
pub const REVIEW_MB_UNTIL_MEASURED : u32 = 512;

/// The memory charged to one review: the host's measurement, or REVIEW_MB_UNTIL_MEASURED (0 = none).
pub fn review_mb(measured: u32) -> u32 {
    if (measured == 0) { return REVIEW_MB_UNTIL_MEASURED; }
    return measured;
}

/// How many workers the pool should have: reviewer.t27 `reviewer_concurrency` over the pool's lanes,
/// its memory and its demand. The lanes go in as that many keys of one lane each, because they are
/// counted lane by lane: bees hold some lanes of some keys, and keys x lanes_per_key would count those
/// as free.
pub fn pool_target(lanes: u32, free_mb: u32, mb_per_review: u32, busy: u32, queued: u32) -> u32 {
    return reviewer_concurrency(lanes, 1, free_mb, review_mb(mb_per_review), pool_demand(busy, queued));
}

/// Seconds an idle worker waits before it stops while the pool is larger than its target. Chosen, not
/// measured: Akka Cluster Sharding's default for passivating an idle entity
/// (`passivate-idle-entity-after = 120s`). That is twelve reviewer heartbeats, so a quiet pass between
/// two bursts does not stop a worker the next burst would start again.
pub const POOL_IDLE_STOP_SECONDS : u32 = 120;

/// Whether one idle worker stops now: only while the pool is larger than its target, and only after it
/// has been idle POOL_IDLE_STOP_SECONDS. Sizing never stops a busy worker. A lowered target only holds
/// back new rows.
pub fn worker_retires(live: u32, target: u32, idle_seconds: u32) -> bool {
    if (live <= target) { return false; }
    return idle_seconds >= POOL_IDLE_STOP_SECONDS;
}

test a_key_carries_no_more_than_its_provider_is_measured_to {
    // z.ai: two a key, however many lanes are configured
    assert key_free_lanes(4, 0, true) == ZAI_REQUESTS_PER_KEY;
    assert key_free_lanes(4, 1, true) == 1;
    assert key_free_lanes(4, 2, true) == 0;
    assert key_free_lanes(4, 3, true) == 0;
    // a key configured below the measurement keeps its configuration
    assert key_free_lanes(1, 0, true) == 1;
    assert key_free_lanes(1, 1, true) == 0;
    // any other provider: the configuration stands
    assert key_free_lanes(4, 1, false) == 3;
    assert key_free_lanes(4, 4, false) == 0;
    assert key_free_lanes(0, 0, false) == 0;
}

test the_pool_counts_its_own_lanes_and_not_a_killed_reviews {
    // 3 lanes free, 2 held by busy workers: the pool may fill 5
    assert pool_lanes(3, 2) == 5;
    // a killed review's lane is not free and not the pool's: the host leaves it out of both
    assert pool_lanes(0, 0) == 0;
    assert pool_lanes(U32_MAX, 1) == U32_MAX;
    assert pool_lanes(1, U32_MAX) == U32_MAX;
    // demand is the busy rows and the queued ones
    assert pool_demand(4, 1) == 5;
    assert pool_demand(0, 0) == 0;
    assert pool_demand(U32_MAX, 1) == U32_MAX;
}

test the_pool_follows_the_backlog {
    // backlog 0: no worker
    assert pool_target(47, 8192, 512, 0, 0) == 0;
    // a small backlog: one worker a row
    assert pool_target(47, 8192, 512, 0, 3) == 3;
    assert pool_target(47, 8192, 512, 2, 1) == 3;
    // a huge backlog: the ceiling, 16
    assert pool_target(47, 8192, 512, 0, 111) == 16;
    assert pool_target(47, 8192, 512, 16, 95) == 16;
    // every worker busy and one more row queued: the pool grows for it
    assert pool_target(47, 8192, 512, 4, 1) == 5;
}

test the_pool_never_exceeds_its_lanes {
    // scarce lanes bound the pool, however long the backlog
    assert pool_target(3, 8192, 512, 0, 111) == 3;
    assert pool_target(3, 8192, 512, 3, 108) == 3;
    assert pool_target(1, 8192, 512, 0, 111) == 1;
    // and memory bounds it: 1000 MB at 300 MB a review
    assert pool_target(47, 1000, 300, 0, 111) == 3;
    // memory never measured: REVIEW_MB_UNTIL_MEASURED, so 8 GB free admits 16, and 1000 MB admits 1
    assert review_mb(0) == REVIEW_MB_UNTIL_MEASURED;
    assert review_mb(300) == 300;
    assert pool_target(47, 8192, 0, 0, 111) == 16;
    assert pool_target(47, 1000, 0, 0, 111) == 1;
    // no lane at all: reviewer.t27 still keeps one worker while anything waits (FR-001)
    assert pool_target(0, 8192, 512, 0, 5) == 1;
}

test the_measured_load_is_kept_up_with_where_the_lanes_are_free {
    // 2026-10-09: 70 lanes, 23 bees running, so 47 free; 58 finished an hour needs 5 at once
    assert slots_needed(58) == 5;
    assert keeps_up(pool_target(47, 8192, 512, 0, 111), 58) == true;
    // with only 3 lanes free no pool size keeps up, and the pool does not pretend otherwise
    assert keeps_up(pool_target(3, 8192, 512, 0, 111), 58) == false;
}

test an_idle_worker_stops_only_when_the_pool_is_too_big_and_after_a_while {
    // the pool is not too big: nobody stops
    assert worker_retires(4, 4, 99999) == false;
    assert worker_retires(3, 4, 99999) == false;
    // too big, but not idle long enough
    assert worker_retires(5, 4, 0) == false;
    assert worker_retires(5, 4, POOL_IDLE_STOP_SECONDS - 1) == false;
    // too big and idle long enough
    assert worker_retires(5, 4, POOL_IDLE_STOP_SECONDS) == true;
    assert worker_retires(1, 0, POOL_IDLE_STOP_SECONDS) == true;
}

invariant the_pool_is_sized_by_measurement {
    // the measured z.ai figure is what a key carries
    assert ZAI_REQUESTS_PER_KEY == 2;
    // an idle worker outlives several heartbeats of the reviewer (REVIEWER_EVERY_SECONDS = 10)
    assert POOL_IDLE_STOP_SECONDS >= 60;
    // the assumed memory never reads as "not measured"
    assert REVIEW_MB_UNTIL_MEASURED > 0;
    assert review_mb(0) > 0;
}
