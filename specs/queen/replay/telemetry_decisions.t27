// SPDX-License-Identifier: Apache-2.0
; specs/queen/replay/telemetry_decisions.t27 -- the telemetry card's logged answers, as asserts
; GENERATED from a decision log. Do not edit by hand: regenerate it (below). Source: the decision
; log of the seeded reviewer run (seed 7852: 45 arrivals an hour for 6 h, 180 s median review, 5%
; crashes, 2% stalls; slices off) in gHashTag/trios
; trios/agent-server/apps/server/tests/api/queen-actors-telemetry.test.ts, logged at trios commit
; 71b45642585abddcb7ad1b6391a82ac670363af0. It holds 14580 calls into queen/telemetry.wasm (sha256
; a26ceeb353ffe961a5f8169f3dc4e795e33ce97f19c3337aaa3b0a61b7fa54d3), compiled from
; queen/telemetry.t27 (sha256 007d2562943afa47b3a4ed7bb5c9a28caf70e32fc9a64b855b478cc693ac4faf).
; Each assert is one distinct (fn, args) of those calls with the answer the wasm card gave: 1328
; asserts over 11 functions. t27c test-report runs them on the reference path (gen, then zig) and
; t27b runs them on its native AArch64 JIT, so production's wasm, the reference and t27b give the
; same answer to every question production asked, or this module fails. Epic gHashTag/trios#1712.
; Regenerate: in trios/agent-server/apps/server,
;   QUEEN_DECISION_SPEC_OUT=<t27 checkout> QUEEN_DECISION_SPEC_FROM=<trios commit>
;   bun test tests/api/queen-actors-telemetry.test.ts -t 'replays to the same'
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenReplayTelemetryDecisions;

use queen::telemetry::long_at_ms;
use queen::telemetry::turn_event;
