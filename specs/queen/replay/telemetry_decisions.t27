use queen::telemetry::window_over;
use queen::telemetry::kept;
use queen::telemetry::summary_due;

; long_at_ms: 2 calls logged, 2 distinct
test long_at_ms_answers_as_logged {
    assert long_at_ms(300) == 150000;
    assert long_at_ms(3600) == 1800000;
}

