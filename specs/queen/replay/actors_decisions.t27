    assert restarted(2, 2, 1, 0, true) == false;
    assert restarted(2, 2, 2, 0, true) == true;
    assert restarted(2, 2, 3, 0, true) == true;
    assert restarted(2, 2, 4, 0, true) == true;
    assert restarted(2, 3, 0, 0, true) == false;
    assert restarted(2, 3, 1, 0, true) == false;
    assert restarted(2, 3, 2, 0, true) == false;
    assert restarted(2, 3, 3, 0, true) == true;
    assert restarted(2, 3, 4, 0, true) == true;
    assert restarted(2, 4, 0, 0, true) == false;
