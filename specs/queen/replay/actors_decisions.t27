; stopped_by_restart: 90 calls logged, 20 distinct
test stopped_by_restart_answers_as_logged {
    assert stopped_by_restart(2, 1, 0, true) == false;
    assert stopped_by_restart(2, 1, 1, true) == false;
    assert stopped_by_restart(2, 1, 2, true) == true;
    assert stopped_by_restart(2, 1, 3, true) == true;
    assert stopped_by_restart(2, 1, 4, true) == true;
    assert stopped_by_restart(2, 2, 0, true) == false;
    assert stopped_by_restart(2, 2, 1, true) == false;
    assert stopped_by_restart(2, 2, 2, true) == false;
    assert stopped_by_restart(2, 2, 3, true) == true;
    assert stopped_by_restart(2, 2, 4, true) == true;
    assert stopped_by_restart(2, 3, 0, true) == false;
    assert stopped_by_restart(2, 3, 1, true) == false;
    assert stopped_by_restart(2, 3, 2, true) == false;
    assert stopped_by_restart(2, 3, 3, true) == false;
    assert stopped_by_restart(2, 3, 4, true) == true;
    assert stopped_by_restart(2, 4, 0, true) == false;
    assert stopped_by_restart(2, 4, 1, true) == false;
    assert stopped_by_restart(2, 4, 2, true) == false;
    assert stopped_by_restart(2, 4, 3, true) == false;
    assert stopped_by_restart(2, 4, 4, true) == false;
}

