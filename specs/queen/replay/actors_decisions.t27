// SPDX-License-Identifier: Apache-2.0
; specs/queen/replay/actors_decisions.t27 -- the actors card's logged answers, as asserts
; GENERATED from a decision log. Do not edit by hand: regenerate it (below). Source: the decision
; log of the seeded reviewer run (seed 7852: 45 arrivals an hour for 6 h, 180 s median review, 5%
; crashes, 2% stalls; slices off) in gHashTag/trios
; trios/agent-server/apps/server/tests/api/queen-actors-telemetry.test.ts, logged at trios commit
; 71b45642585abddcb7ad1b6391a82ac670363af0. It holds 54633 calls into queen/actors.wasm (sha256
; 7d5be60a4576700245154600bde5b9afbfeb0d07d3f86aa5c3d5c16973b0e304), compiled from queen/actors.t27
; (sha256 73c4135bfcb8442a96bfc64977048d75055bb55e5c3e04e49a20966dada4b722).
; Each assert is one distinct (fn, args) of those calls with the answer the wasm card gave: 472
; asserts over 25 functions. t27c test-report runs them on the reference path (gen, then zig) and
; t27b runs them on its native AArch64 JIT, so production's wasm, the reference and t27b give the
; same answer to every question production asked, or this module fails. Epic gHashTag/trios#1712.
; Regenerate: in trios/agent-server/apps/server,
;   QUEEN_DECISION_SPEC_OUT=<t27 checkout> QUEEN_DECISION_SPEC_FROM=<trios commit>
;   bun test tests/api/queen-actors-telemetry.test.ts -t 'replays to the same'
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenReplayActorsDecisions;

use queen::actors::pid_of;
use queen::actors::slot_of;
use queen::actors::next_gen;
