; --- 0. Widths -----------------------------------------------------------------------------------------

/// A board's age counters count seconds in a u16 and stop at this value. The card's largest bound on
/// an age is FILE_WAIT_MAX_SECONDS (7200), so a stopped counter still reads as past every bound.
pub const HW_SECONDS_MAX : u16 = 65535;

/// What a board's input path does to a time in seconds: keep it, or stop it at HW_SECONDS_MAX.
pub fn hw_saturate_seconds(seconds: u32) -> u16 {
    if (seconds > 65535) { return HW_SECONDS_MAX; }
    return seconds as u16;
}

; --- 1. Identity ---------------------------------------------------------------------------------------

pub const HW_NO_PID : u64 = 0;

/// Domain: every slot and generation of 32 bits. The card's two refusals of a slot past 32 bits and
/// of a generation past 32 bits are the parameter types.
pub fn hw_pid_of(slot: u32, gen: u32) -> u64 {
    if (slot == 0) { return HW_NO_PID; }
    return ((slot as u64) << 32) | (gen as u64);
}

pub fn hw_slot_of(pid: u64) -> u32 {
    return (pid >> 32) as u32;
}

pub fn hw_gen_of(pid: u64) -> u32 {
    return pid as u32;
}

pub fn hw_next_gen(gen: u32) -> u32 {
    return gen +% 1;
}

/// Unchanged: a pid is compared whole, all 64 bits.
pub fn hw_reaches(addressed: u64, live: u64) -> bool {
    if (addressed == HW_NO_PID) { return false; }
    return addressed == live;
}

; --- 2. Mailbox and control lane -----------------------------------------------------------------------

pub const HW_D_QUEUED : u8 = 0;
pub const HW_D_DROPPED_DEAD : u8 = 1;
pub const HW_D_DROPPED_FULL : u8 = 2;
pub const HW_D_COALESCED : u8 = 3;
pub const HW_MAILBOX_CAP : u16 = 256;

/// A queue length and a cap fit a u16: the card's cap is 256.
pub fn hw_deliver(target_reached: bool, queued: u16, cap: u16) -> u8 {
    if (target_reached == false) { return HW_D_DROPPED_DEAD; }
    if (queued >= cap) { return HW_D_DROPPED_FULL; }
    return HW_D_QUEUED;
}

pub fn hw_ordered(same_sender: bool, same_receiver: bool) -> bool {
    return same_sender && same_receiver;
}

/// The model mailbox: 8 one-byte tags in a u64, the oldest in the low byte, tag 0 an empty slot. A
/// slot index is a u8; HW_NO_MATCH is the index past the last slot.
pub const HW_MBOX_SLOTS : u8 = 8;
pub const HW_NO_MATCH : u8 = 8;

/// Domain of `tag` everywhere below: a byte. The card refuses a tag past 255; a board's tag field
/// cannot hold one.
pub fn hw_mbox_tag(box: u64, i: u8) -> u8 {
    if (i >= HW_MBOX_SLOTS) { return 0; }
    return ((box >> ((i as u64) << 3)) & 255) as u8;
}

/// The first empty slot, slot by slot: the card's loop with its 8 trips written out.
pub fn hw_mbox_len(box: u64) -> u8 {
    if ((box & 255) == 0) { return 0; }
    if (((box >> 8) & 255) == 0) { return 1; }
    if (((box >> 16) & 255) == 0) { return 2; }
    if (((box >> 24) & 255) == 0) { return 3; }
    if (((box >> 32) & 255) == 0) { return 4; }
    if (((box >> 40) & 255) == 0) { return 5; }
    if (((box >> 48) & 255) == 0) { return 6; }
    if ((box >> 56) == 0) { return 7; }
    return HW_MBOX_SLOTS;
}

pub fn hw_mbox_push(box: u64, tag: u8) -> u64 {
    var n : u8 = hw_mbox_len(box);
    if (n == HW_MBOX_SLOTS) { return box; }
    return box | ((tag as u64) << ((n as u64) << 3));
}

/// The oldest slot holding `want`, or HW_NO_MATCH: the card's loop with its 8 trips written out. An
/// empty slot ends the search before its tag is compared, so `want` 0 never matches.
pub fn hw_mbox_find(box: u64, want: u8) -> u8 {
    var w : u64 = want as u64;
    var t0 : u64 = box & 255;
    var t1 : u64 = (box >> 8) & 255;
    var t2 : u64 = (box >> 16) & 255;
    var t3 : u64 = (box >> 24) & 255;
    var t4 : u64 = (box >> 32) & 255;
    var t5 : u64 = (box >> 40) & 255;
    var t6 : u64 = (box >> 48) & 255;
    var t7 : u64 = box >> 56;
    if (t0 == 0) { return HW_NO_MATCH; }
    if (t0 == w) { return 0; }
    if (t1 == 0) { return HW_NO_MATCH; }
    if (t1 == w) { return 1; }
    if (t2 == 0) { return HW_NO_MATCH; }
    if (t2 == w) { return 2; }
    if (t3 == 0) { return HW_NO_MATCH; }
    if (t3 == w) { return 3; }
    if (t4 == 0) { return HW_NO_MATCH; }
    if (t4 == w) { return 4; }
    if (t5 == 0) { return HW_NO_MATCH; }
    if (t5 == w) { return 5; }
    if (t6 == 0) { return HW_NO_MATCH; }
    if (t6 == w) { return 6; }
    if (t7 == 0) { return HW_NO_MATCH; }
    if (t7 == w) { return 7; }
    return HW_NO_MATCH;
}

/// The bytes below slot i, as a mask: a table of nine constants, not a shift by a value.
pub fn hw_low_bytes(i: u8) -> u64 {
    if (i == 0) { return 0; }
    if (i == 1) { return 255; }
    if (i == 2) { return 65535; }
    if (i == 3) { return 16777215; }
    if (i == 4) { return 4294967295; }
    if (i == 5) { return 1099511627775; }
    if (i == 6) { return 281474976710655; }
    if (i == 7) { return 72057594037927935; }
    return 18446744073709551615;
}

/// Take slot i out and close the gap. Each byte of the answer is the box's own byte below slot i and
/// the next byte up from slot i on: one 2-way choice a bit, where the card shifts by a value twice.
/// Slot 7 needs no case of its own: the byte above it is the 0 that `box >> 8` brings in.
pub fn hw_mbox_remove(box: u64, i: u8) -> u64 {
    if (i >= HW_MBOX_SLOTS) { return box; }
    var keep : u64 = hw_low_bytes(i);
    return (box & keep) | ((box >> 8) & (~keep));
}

/// The card's mbox_remove(box, mbox_find(box, want)) in one pass: the scan that finds the oldest match
/// builds the mask of the bytes below it as it goes, so the slot index is never encoded and decoded
/// again (measured: 113 LUT against 213 for the two functions composed).
pub fn hw_receive(box: u64, want: u8) -> u64 {
    var w : u64 = want as u64;
    var t0 : u64 = box & 255;
    var t1 : u64 = (box >> 8) & 255;
    var t2 : u64 = (box >> 16) & 255;
    var t3 : u64 = (box >> 24) & 255;
    var t4 : u64 = (box >> 32) & 255;
    var t5 : u64 = (box >> 40) & 255;
    var t6 : u64 = (box >> 48) & 255;
    var t7 : u64 = box >> 56;
    var keep : u64 = 0;
    if (t0 == 0) { return box; }
    if (t0 != w) {
        keep = 255;
        if (t1 == 0) { return box; }
        if (t1 != w) {
            keep = 65535;
            if (t2 == 0) { return box; }
            if (t2 != w) {
                keep = 16777215;
                if (t3 == 0) { return box; }
                if (t3 != w) {
                    keep = 4294967295;
                    if (t4 == 0) { return box; }
                    if (t4 != w) {
                        keep = 1099511627775;
                        if (t5 == 0) { return box; }
                        if (t5 != w) {
                            keep = 281474976710655;
                            if (t6 == 0) { return box; }
                            if (t6 != w) {
                                keep = 72057594037927935;
                                if (t7 == 0) { return box; }
                                if (t7 != w) { return box; }
                            }
                        }
                    }
                }
            }
        }
    }
    return (box & keep) | ((box >> 8) & (~keep));
}

pub const HW_RCV_MATCH : u8 = 0;
pub const HW_RCV_WAIT : u8 = 1;
pub const HW_RCV_TIMEOUT : u8 = 2;
pub const HW_AFTER_INFINITY : u32 = 4294967295;

/// Unchanged: milliseconds stay u32, since AFTER_INFINITY is 2^32 - 1.
pub fn hw_receive_outcome(found: bool, waited_ms: u32, after_ms: u32) -> u8 {
    if (found) { return HW_RCV_MATCH; }
    if (after_ms == HW_AFTER_INFINITY) { return HW_RCV_WAIT; }
    if (waited_ms >= after_ms) { return HW_RCV_TIMEOUT; }
    return HW_RCV_WAIT;
}

pub const HW_LANE_DATA : u8 = 0;
pub const HW_LANE_CONTROL : u8 = 1;
pub const HW_LANE_NONE : u8 = 2;

pub fn hw_deliver_control(target_reached: bool, kind_pending: bool) -> u8 {
    if (target_reached == false) { return HW_D_DROPPED_DEAD; }
    if (kind_pending) { return HW_D_COALESCED; }
    return HW_D_QUEUED;
}

pub fn hw_is_dead_letter(outcome: u8) -> bool {
    if (outcome == HW_D_DROPPED_DEAD) { return true; }
    return outcome == HW_D_DROPPED_FULL;
}

pub fn hw_next_lane(control_pending: bool, data_pending: bool) -> u8 {
    if (control_pending) { return HW_LANE_CONTROL; }
    if (data_pending) { return HW_LANE_DATA; }
    return HW_LANE_NONE;
}

/// The control lane: bit k for tag k, tags 1..63. Bit 0 is no kind.
pub const HW_CTL_TAGS : u8 = 64;
pub const HW_TAG_BITS : u64 = 0xFFFFFFFFFFFFFFFE;

/// Bit k of a u64. Domain: k below 64, as the card's `bit`; past it, 0.
pub fn hw_bit(k: u8) -> u64 {
    if (k >= 64) { return 0; }
    var one : u64 = 1;
    return one << k;
}

pub fn hw_ctl_pending(lane: u64, tag: u8) -> bool {
    if (tag >= HW_CTL_TAGS) { return false; }
    return ((lane >> tag) & 1) == 1;
}

pub fn hw_ctl_post(lane: u64, tag: u8) -> u64 {
    if (tag == 0) { return lane; }
    if (tag >= HW_CTL_TAGS) { return lane; }
    return lane | hw_bit(tag);
}

/// The lowest pending tag: count the trailing zeros of the lane without bit 0, by halves, where the
/// card asks the 63 tags one by one. 0 when nothing is pending.
pub fn hw_ctl_next(lane: u64) -> u8 {
    var x : u64 = lane & HW_TAG_BITS;
    if (x == 0) { return 0; }
    var t : u8 = 0;
    if ((x & 4294967295) == 0) { t = t + 32; x = x >> 32; }
    if ((x & 65535) == 0) { t = t + 16; x = x >> 16; }
    if ((x & 255) == 0) { t = t + 8; x = x >> 8; }
    if ((x & 15) == 0) { t = t + 4; x = x >> 4; }
    if ((x & 3) == 0) { t = t + 2; x = x >> 2; }
    if ((x & 1) == 0) { t = t + 1; }
    return t;
}

/// The lowest set bit of x alone (x & -x); 0 for 0.
pub fn hw_lowest_one(x: u64) -> u64 {
    return x & ((~x) +% 1);
}

/// The lowest pending tag leaves the lane: the card's `lane - bit(ctl_next(lane))`, which clears the
/// lowest set bit of the lane above bit 0.
pub fn hw_ctl_take(lane: u64) -> u64 {
    return lane ^ hw_lowest_one(lane & HW_TAG_BITS);
}

pub const HW_CALL_PENDING : u8 = 0;
pub const HW_CALL_REPLY : u8 = 1;
pub const HW_CALL_DOWN : u8 = 2;
pub const HW_CALL_TIMEOUT : u8 = 3;
pub const HW_CALL_CYCLE : u8 = 4;
pub const HW_CALL_TOO_DEEP : u8 = 5;

pub fn hw_call_outcome(reply_queued: bool, down_queued: bool, waited_ms: u32, after_ms: u32) -> u8 {
    if (reply_queued) { return HW_CALL_REPLY; }
    if (down_queued) { return HW_CALL_DOWN; }
    if (hw_receive_outcome(false, waited_ms, after_ms) == HW_RCV_TIMEOUT) { return HW_CALL_TIMEOUT; }
    return HW_CALL_PENDING;
}

pub fn hw_live_alias(alias: u64, outcome: u8) -> u64 {
    if (outcome == HW_CALL_PENDING) { return alias; }
    return HW_NO_PID;
}

/// A slot on a call chain is a section 1 slot, 32 bits. The model tracks slots 0..63.
pub const HW_CHAIN_SLOTS : u32 = 64;
pub const HW_CALL_MAX_DEPTH : u8 = 8;

pub fn hw_chain_has(chain: u64, slot: u32) -> bool {
    if (slot >= HW_CHAIN_SLOTS) { return false; }
    return ((chain >> slot) & 1) == 1;
}

pub fn hw_chain_add(chain: u64, slot: u32) -> u64 {
    if (slot >= HW_CHAIN_SLOTS) { return chain; }
    return chain | hw_bit(slot as u8);
}

/// A depth is a count of callers: a u8. A chain refuses its ninth caller, so no real depth nears 255.
pub fn hw_call_admit(chain: u64, depth: u8, callee_slot: u32) -> u8 {
    if (hw_chain_has(chain, callee_slot)) { return HW_CALL_CYCLE; }
    if (depth > HW_CALL_MAX_DEPTH) { return HW_CALL_TOO_DEEP; }
    return HW_CALL_PENDING;
}

; --- 3. Exit signals and links; 4. Monitors ------------------------------------------------------------

pub const HW_X_NORMAL : u8 = 0;
pub const HW_X_SHUTDOWN : u8 = 1;
pub const HW_X_KILL : u8 = 2;
pub const HW_X_KILLED : u8 = 3;
pub const HW_X_CRASH : u8 = 4;
pub const HW_X_NOPROC : u8 = 5;
pub const HW_X_NOCONNECTION : u8 = 6;
pub const HW_X_NONE : u8 = 99;
pub const HW_ACT_IGNORE : u8 = 0;
pub const HW_ACT_DIE : u8 = 1;
pub const HW_ACT_MESSAGE : u8 = 2;

pub fn hw_on_exit_signal(reason: u8, trapping: bool) -> u8 {
    if (reason == HW_X_KILL) { return HW_ACT_DIE; }
    if (trapping) { return HW_ACT_MESSAGE; }
    if (reason == HW_X_NORMAL) { return HW_ACT_IGNORE; }
    return HW_ACT_DIE;
}

pub fn hw_death_reason(signal: u8) -> u8 {
    if (signal == HW_X_KILL) { return HW_X_KILLED; }
    return signal;
}

/// A count of links is a u8; the answer is one wider, so the 256th link is still counted.
pub fn hw_links_after_link(already_linked: bool, links: u8) -> u16 {
    if (already_linked) { return links as u16; }
    return (links as u16) + 1;
}

pub fn hw_attach_answer(target_alive: bool) -> u8 {
    if (target_alive) { return HW_X_NONE; }
    return HW_X_NOPROC;
}

pub fn hw_monitors_after_monitor(monitors: u8) -> u16 {
    return (monitors as u16) + 1;
}

pub fn hw_down_left_after_demonitor(flush: bool, down_queued: bool) -> bool {
    if (flush) { return false; }
    return down_queued;
}

; --- 5. Supervisors ------------------------------------------------------------------------------------

pub const HW_RESTART_PERMANENT : u8 = 0;
pub const HW_RESTART_TRANSIENT : u8 = 1;
pub const HW_RESTART_TEMPORARY : u8 = 2;
pub const HW_STRAT_ONE_FOR_ONE : u8 = 0;
pub const HW_STRAT_ONE_FOR_ALL : u8 = 1;
pub const HW_STRAT_REST_FOR_ONE : u8 = 2;
pub const HW_SUP_NOTHING : u8 = 0;
pub const HW_SUP_RESTART : u8 = 1;
pub const HW_SUP_GIVE_UP : u8 = 2;

pub fn hw_should_restart(rtype: u8, reason: u8) -> bool {
    if (rtype == HW_RESTART_PERMANENT) { return true; }
    if (rtype == HW_RESTART_TEMPORARY) { return false; }
    if (reason == HW_X_NORMAL) { return false; }
    if (reason == HW_X_SHUTDOWN) { return false; }
    return true;
}

/// A child's index in start order is a u8: a board's supervisor has at most 255 children.
pub fn hw_affected(strategy: u8, failed: u8, child: u8) -> bool {
    if (strategy == HW_STRAT_ONE_FOR_ALL) { return true; }
    if (strategy == HW_STRAT_REST_FOR_ONE) { return child >= failed; }
    return child == failed;
}

pub fn hw_stopped_by_restart(strategy: u8, failed: u8, child: u8, failed_restarts: bool) -> bool {
    if (child == failed) { return false; }
    if (failed_restarts == false) { return false; }
    return hw_affected(strategy, failed, child);
}

pub fn hw_restarted(strategy: u8, failed: u8, child: u8, child_rtype: u8, failed_restarts: bool) -> bool {
    if (failed_restarts == false) { return false; }
    if (hw_affected(strategy, failed, child) == false) { return false; }
    return child_rtype != HW_RESTART_TEMPORARY;
}

pub fn hw_stop_rank(i: u8, count: u8) -> u8 {
    if (i >= count) { return count; }
    return count - 1 - i;
}

pub fn hw_in_period(age_seconds: u16, period_seconds: u16) -> bool {
    return age_seconds < period_seconds;
}

pub fn hw_intensity_exceeded(restarts_in_period: u8, max_restarts: u8) -> bool {
    return restarts_in_period > max_restarts;
}

/// The card asks intensity_exceeded(earlier + 1, max). For integers earlier + 1 > max is earlier >= max,
/// which needs no adder and cannot overflow.
pub fn hw_on_child_exit(rtype: u8, reason: u8, earlier_restarts: u8, max_restarts: u8) -> u8 {
    if (hw_should_restart(rtype, reason) == false) { return HW_SUP_NOTHING; }
    if (earlier_restarts >= max_restarts) { return HW_SUP_GIVE_UP; }
    return HW_SUP_RESTART;
}

pub const HW_BACKOFF_BASE_SECONDS : u16 = 10;
pub const HW_BACKOFF_CAP_SECONDS : u16 = 300;
pub const HW_STABLE_SECONDS : u16 = 600;
pub const HW_UNSTABLE_GIVE_UP : u8 = 6;

pub fn hw_unstable_streak(streak: u8, ran_seconds: u16) -> u16 {
    if (ran_seconds >= HW_STABLE_SECONDS) { return 0; }
    return (streak as u16) + 1;
}

/// The card doubles in a loop that runs `streak` times. Closed form: BASE doubled streak - 1 times,
/// and the cap from the first streak whose doubling passes it. With BASE 10 and CAP 300 that is
/// streak 6 (320 > 300); the invariant backoff_table_matches_its_constants pins it.
pub fn hw_backoff_seconds(streak: u8) -> u16 {
    if (streak == 0) { return 0; }
    if (streak == 1) { return HW_BACKOFF_BASE_SECONDS; }
    if (streak == 2) { return HW_BACKOFF_BASE_SECONDS << 1; }
    if (streak == 3) { return HW_BACKOFF_BASE_SECONDS << 2; }
    if (streak == 4) { return HW_BACKOFF_BASE_SECONDS << 3; }
    if (streak == 5) { return HW_BACKOFF_BASE_SECONDS << 4; }
    return HW_BACKOFF_CAP_SECONDS;
}

pub fn hw_with_backoff(decision: u8, streak: u8) -> u8 {
    if (decision != HW_SUP_RESTART) { return decision; }
    if (streak > HW_UNSTABLE_GIVE_UP) { return HW_SUP_GIVE_UP; }
    return HW_SUP_RESTART;
}

/// Jitter. The card's seed is a u64 reduced mod 2^32 before anything else, so a u32 seed loses
/// nothing. PHI_HASH = floor(2^32 / phi) = 0x9E3779B9, and seed * PHI_HASH mod 2^32 is written in its
/// canonical signed digits: 2^31 + 2^29 - 2^25 + 2^22 - 2^19 - 2^15 - 2^11 + 2^9 - 2^6 - 2^3 + 1,
/// eleven shifted terms where the plain binary form has twenty.
pub const HW_PHI_HASH : u32 = 2654435769;

pub fn hw_seed_hash(seed: u32) -> u16 {
    var p : u32 = seed;
    p = p -% (seed << 3);
    p = p -% (seed << 6);
    p = p +% (seed << 9);
    p = p -% (seed << 11);
    p = p -% (seed << 15);
    p = p -% (seed << 19);
    p = p +% (seed << 22);
    p = p -% (seed << 25);
    p = p +% (seed << 29);
    p = p +% (seed << 31);
    return (p >> 16) as u16;
}

/// The card's spread, wait * JITTER_PERCENT / 100, is floor(wait / 5). For every u16 wait that is
/// floor(wait * 52429 / 2^18), and 52429 = 4 * 3 * 17 * 257 + 1, so four adds and no divider.
pub fn hw_fifth(wait: u16) -> u16 {
    var x : u32 = wait as u32;
    var x3 : u32 = (x << 1) + x;
    var x51 : u32 = (x3 << 4) + x3;
    var x13107 : u32 = (x51 << 8) + x51;
    return (((x13107 << 2) + x) >> 18) as u16;
}

/// One step of restoring division: bring in the next bit of the dividend, subtract the divisor if it
/// fits. One subtractor: bit 16 of (t + 2^16 - d) says whether t >= d. Domain: r < d, b <= 1.
pub fn hw_mod_step(r: u16, b: u16, d: u16) -> u16 {
    var t : u32 = ((r as u32) << 1) | (b as u32);
    var s : u32 = (t | 65536) - (d as u32);
    if ((s >> 16) == 1) { return (s & 65535) as u16; }
    return t as u16;
}

/// h % d, exact, for d of 1 and up: 16 steps, the dividend's bits from the top.
pub fn hw_mod16(h: u16, d: u16) -> u16 {
    var r : u16 = 0;
    var i : u8 = 0;
    while (i < 16) {
        r = hw_mod_step(r, (h >> (15 - i)) & 1, d);
        i = i + 1;
    }
    return r;
}

/// The card's jittered_seconds for every u16 wait (the card's waits are its backoff, at most 300).
pub fn hw_jittered_seconds(wait: u16, seed: u32) -> u16 {
    return wait - hw_mod16(hw_seed_hash(seed), hw_fifth(wait) + 1);
}

/// One step of the serial hash: seed * PHI_HASH mod 2^32 by Horner's rule from the seed's top bit.
pub fn hw_hash_step(acc: u32, seed_bit: bool) -> u32 {
    if (seed_bit) { return (acc << 1) +% HW_PHI_HASH; }
    return acc << 1;
}

/// The jitter as the engine computes it, one step a clock: 32 hash steps from the seed's top bit, then
/// 16 division steps over the hash's top 16 bits. The engine's jitter unit (section 12) runs exactly
/// these steps, so this is its answer after 48 cycles.
pub fn hw_jittered_seconds_serial(wait: u16, seed: u32) -> u16 {
    var acc : u32 = 0;
    var i : u8 = 0;
    while (i < 32) {
        acc = hw_hash_step(acc, ((seed >> (31 - i)) & 1) == 1);
        i = i + 1;
    }
    var d : u16 = hw_fifth(wait) + 1;
    var r : u16 = 0;
    var j : u8 = 0;
    while (j < 16) {
        r = hw_mod_step(r, ((acc >> (31 - j)) & 1) as u16, d);
        j = j + 1;
    }
    return wait - r;
}

pub const HW_SHUTDOWN_BRUTAL : u32 = 0;
pub const HW_SHUTDOWN_INFINITY : u32 = 4294967295;

pub fn hw_stop_signal(waited_ms: u32, timeout_ms: u32) -> u8 {
    if (timeout_ms == HW_SHUTDOWN_BRUTAL) { return HW_X_KILL; }
    if (waited_ms == 0) { return HW_X_SHUTDOWN; }
    if (timeout_ms == HW_SHUTDOWN_INFINITY) { return HW_X_NONE; }
    if (waited_ms >= timeout_ms) { return HW_X_KILL; }
    return HW_X_NONE;
}

pub const HW_AUTO_NEVER : u8 = 0;
pub const HW_AUTO_ANY_SIGNIFICANT : u8 = 1;
pub const HW_AUTO_ALL_SIGNIFICANT : u8 = 2;
/// A literal, not `= HW_X_SHUTDOWN`: gen-verilog drops a constant defined by another constant as if it
/// were a type alias (#8340), and every function that reads it then fails synthesis. The invariant pins it.
pub const HW_AUTO_SHUTDOWN_REASON : u8 = 1;
pub const HW_GIVE_UP_REASON : u8 = 1;

pub fn hw_child_spec_valid(rtype: u8, significant: bool, auto_mode: u8) -> bool {
    if (auto_mode > HW_AUTO_ALL_SIGNIFICANT) { return false; }
    if (significant == false) { return true; }
    if (rtype == HW_RESTART_PERMANENT) { return false; }
    return auto_mode != HW_AUTO_NEVER;
}

pub fn hw_auto_shutdown_after_exit(mode: u8, significant: bool, rtype: u8, reason: u8, by_supervisor: bool, significant_left: u8) -> bool {
    if (by_supervisor) { return false; }
    if (significant == false) { return false; }
    if (hw_should_restart(rtype, reason)) { return false; }
    if (mode == HW_AUTO_ANY_SIGNIFICANT) { return true; }
    if (mode == HW_AUTO_ALL_SIGNIFICANT) { return significant_left == 0; }
    return false;
}

pub fn hw_auto_shutdown_sticks(sup_rtype: u8) -> bool {
    return hw_should_restart(sup_rtype, HW_AUTO_SHUTDOWN_REASON) == false;
}

pub const HW_START_OK : u8 = 0;
pub const HW_START_MAX_CHILDREN : u8 = 1;

/// The sum is taken in a u16 local, not in a comparison: gen-verilog drops a widening cast (#8341), and
/// a Verilog comparison sizes `live + stopping` to its 8-bit operands, so 200 + 100 would read as 44.
pub fn hw_start_answer(live: u8, stopping: u8, max_children: u8) -> u8 {
    var held : u16 = (live as u16) + (stopping as u16);
    if (held >= (max_children as u16)) { return HW_START_MAX_CHILDREN; }
    return HW_START_OK;
}

/// Domain: a child that is not restarted leaves at least one child counted (children >= 1), as in the
/// card, where 0 - 1 is an overflow.
pub fn hw_children_after_exit(children: u8, child_restarted: bool) -> u8 {
    if (child_restarted) { return children; }
    return children - 1;
}

; --- 6. The Queen's tree -------------------------------------------------------------------------------

pub const HW_QK_INTAKE : u8 = 0;
pub const HW_QK_RECONCILER : u8 = 1;
pub const HW_QK_DOMAIN_SUP : u8 = 2;
pub const HW_QK_AGENT : u8 = 3;
pub const HW_QK_NONE : u8 = 99;
pub const HW_WORKER_SHUTDOWN_MS : u32 = 5000;
pub const HW_AGENT_SHUTDOWN_MS : u32 = 30000;

pub fn hw_root_children(domain_count: u8) -> u16 {
    return (domain_count as u16) + 2;
}

pub fn hw_root_child_kind(i: u8, domain_count: u8) -> u8 {
    if (i == 0) { return HW_QK_INTAKE; }
    if (i == 1) { return HW_QK_RECONCILER; }
    if ((i as u16) < hw_root_children(domain_count)) { return HW_QK_DOMAIN_SUP; }
    return HW_QK_NONE;
}

pub fn hw_queen_restart_type(kind: u8) -> u8 {
    if (kind == HW_QK_AGENT) { return HW_RESTART_TRANSIENT; }
    return HW_RESTART_PERMANENT;
}

pub fn hw_queen_shutdown_ms(kind: u8) -> u32 {
    if (kind == HW_QK_DOMAIN_SUP) { return HW_SHUTDOWN_INFINITY; }
    if (kind == HW_QK_AGENT) { return HW_AGENT_SHUTDOWN_MS; }
    return HW_WORKER_SHUTDOWN_MS;
}

/// ttl * 1000 as shifts: 1000 = 1024 - 16 - 8. A u16 ttl keeps the product below 2^26.
pub fn hw_stops_inside_the_lease(shutdown_ms: u32, ttl_seconds: u16) -> bool {
    var t : u32 = ttl_seconds as u32;
    return shutdown_ms < (t << 10) - (t << 4) - (t << 3);
}

pub const HW_M_TASK_OFFER : u8 = 1;
pub const HW_M_CANCEL : u8 = 2;
pub const HW_M_HEARTBEAT_DUE : u8 = 3;

pub fn hw_lane_of(tag: u8) -> u8 {
    if (tag == HW_M_CANCEL) { return HW_LANE_CONTROL; }
    if (tag == HW_M_HEARTBEAT_DUE) { return HW_LANE_CONTROL; }
    return HW_LANE_DATA;
}

pub const HW_TURN_MAX_SECONDS : u16 = 3600;

pub fn hw_hung_turn_signal(turn_age_seconds: u16) -> u8 {
    return hw_turn_signal(turn_age_seconds, HW_TURN_MAX_SECONDS);
}

pub fn hw_turn_signal(turn_age_seconds: u16, max_seconds: u16) -> u8 {
    var bound : u16 = max_seconds;
    if (bound == 0) { bound = HW_TURN_MAX_SECONDS; }
    if (turn_age_seconds >= bound) { return HW_X_KILL; }
    return HW_X_NONE;
}

pub fn hw_reclaim_wait_seconds(down_reason: u8, since_renewal: u16, ttl_seconds: u16) -> u16 {
    if (since_renewal >= ttl_seconds) { return 0; }
    if (down_reason == HW_X_NONE) { return ttl_seconds - since_renewal; }
    if (down_reason == HW_X_NOCONNECTION) { return ttl_seconds - since_renewal; }
    return 0;
}

; --- 8. Preemption -------------------------------------------------------------------------------------

pub const HW_SLICE_TURNS : u8 = 64;
pub const HW_SLICE_MICROS : u16 = 5000;
pub const HW_ISO_LOOP : u8 = 0;
pub const HW_ISO_THREAD : u8 = 1;
pub const HW_ISO_PROCESS : u8 = 2;
pub const HW_KILL_ABANDONS : u8 = 0;
pub const HW_KILL_STOPS : u8 = 1;

/// A turn count is a u8 and microseconds a u16; both are counters that may stop at their top, since
/// the card compares each against a bound below it (64 turns, 5000 us).
pub fn hw_slice_spent(turns: u8, micros: u16) -> bool {
    if (turns >= HW_SLICE_TURNS) { return true; }
    return micros >= HW_SLICE_MICROS;
}

pub fn hw_turn_isolation(cpu_bound: bool, runs_foreign_code: bool, must_stop: bool) -> u8 {
    if (runs_foreign_code) { return HW_ISO_PROCESS; }
    if (must_stop) { return HW_ISO_PROCESS; }
    if (cpu_bound) { return HW_ISO_THREAD; }
    return HW_ISO_LOOP;
}

pub fn hw_kill_effect(isolation: u8) -> u8 {
    if (isolation == HW_ISO_PROCESS) { return HW_KILL_STOPS; }
    return HW_KILL_ABANDONS;
}

pub fn hw_holds_after_kill(isolation: u8, work_ended: bool) -> bool {
    if (hw_kill_effect(isolation) == HW_KILL_STOPS) { return false; }
    return work_ended == false;
}

; --- 9. Nodes ------------------------------------------------------------------------------------------

pub const HW_LOCAL_SLOT_MASK : u32 = 1048575;
pub const HW_MAX_NODE : u16 = 4095;
pub const HW_NODE_TTL_SECONDS : u16 = 20;

/// Domain: a node id of 16 bits and a local slot of 32, so the card's two refusals (node past 4095,
/// local slot past 2^20 - 1) stay, and a generation of 32 bits.
pub fn hw_node_pid(node: u16, local: u32, gen: u32) -> u64 {
    if (node > HW_MAX_NODE) { return HW_NO_PID; }
    if (local == 0) { return HW_NO_PID; }
    if (local > HW_LOCAL_SLOT_MASK) { return HW_NO_PID; }
    return hw_pid_of(((node as u32) << 20) | local, gen);
}

pub fn hw_node_of(pid: u64) -> u16 {
    return (pid >> 52) as u16;
}

pub fn hw_local_of(pid: u64) -> u32 {
    return ((pid >> 32) as u32) & HW_LOCAL_SLOT_MASK;
}

/// Where a send goes: the 12-bit node field against the board's own id, no lookup.
pub fn hw_is_remote(pid: u64, self_node: u16) -> bool {
    if (pid == HW_NO_PID) { return false; }
    return hw_node_of(pid) != self_node;
}

pub fn hw_node_up(seconds_since_heartbeat: u16) -> bool {
    return seconds_since_heartbeat < HW_NODE_TTL_SECONDS;
}

pub fn hw_send_remote(target_node_up: bool) -> u8 {
    if (target_node_up) { return HW_D_QUEUED; }
    return HW_D_DROPPED_DEAD;
}

pub fn hw_remote_down(target_node_up: bool, pid_ended: bool, reason: u8) -> u8 {
    if (target_node_up == false) { return HW_X_NOCONNECTION; }
    if (pid_ended) { return reason; }
    return HW_X_NONE;
}

/// Free room is a count of local slots, which section 9 bounds by 2^20; a u32 holds it. A node id is a
/// u16, as in hw_node_pid.
pub fn hw_place_before(free_a: u32, node_a: u16, free_b: u32, node_b: u16) -> bool {
    if (free_a != free_b) { return free_a > free_b; }
    return node_a < node_b;
}

; --- 10. File owners -----------------------------------------------------------------------------------

pub const HW_FILE_SLOT_BASE : u32 = 1024;
/// FILE_OWNER_SLOTS - 1: the card's `% 65536` is a mask.
pub const HW_FILE_OWNER_MASK : u64 = 65535;
pub const HW_EDIT_WHOLE : u8 = 0;
pub const HW_EDIT_LINES : u8 = 1;
pub const HW_EDIT_APPEND : u8 = 2;
pub const HW_FA_ADMIT : u8 = 0;
pub const HW_FA_QUEUE : u8 = 1;
pub const HW_FA_REFUSE : u8 = 2;
pub const HW_FILE_WAIT_MAX_SECONDS : u16 = 7200;
/// control.t27 TASK_LEASE_TTL_SECONDS, a literal in the card's edit_still_holds as well.
pub const HW_TASK_LEASE_TTL_SECONDS : u16 = 180;

pub fn hw_file_owner_slot(path_hash: u64) -> u32 {
    return HW_FILE_SLOT_BASE + ((path_hash & HW_FILE_OWNER_MASK) as u32);
}

/// Unchanged: line numbers stay u32; nothing in the card bounds a file's length.
pub fn hw_edits_meet(a_kind: u8, a_start: u32, a_end: u32, b_kind: u8, b_start: u32, b_end: u32) -> bool {
    if (a_kind == HW_EDIT_APPEND && b_kind == HW_EDIT_APPEND) { return false; }
    if (a_kind != HW_EDIT_LINES) { return true; }
    if (b_kind != HW_EDIT_LINES) { return true; }
    if (a_start >= a_end) { return true; }
    if (b_start >= b_end) { return true; }
    return a_start <= b_end && b_start <= a_end;
}

pub fn hw_file_admit(meets_running: bool, meets_queued: bool, queue: u64, waited_seconds: u16) -> u8 {
    if (waited_seconds >= HW_FILE_WAIT_MAX_SECONDS) { return HW_FA_REFUSE; }
    if (meets_running == false && meets_queued == false) { return HW_FA_ADMIT; }
    if (hw_mbox_len(queue) >= HW_MBOX_SLOTS) { return HW_FA_REFUSE; }
    return HW_FA_QUEUE;
}

pub fn hw_refusal_gives_up(waited_seconds: u16) -> bool {
    return waited_seconds >= HW_FILE_WAIT_MAX_SECONDS;
}

pub fn hw_takes_a_lane(answer: u8) -> bool {
    return answer == HW_FA_ADMIT;
}

pub fn hw_edit_still_holds(finished: bool, holds_files_now: bool, seconds_since_renewal: u16) -> bool {
    if (finished) { return holds_files_now; }
    return seconds_since_renewal < HW_TASK_LEASE_TTL_SECONDS;
}

; --- 11. Every HW_ constant is the card's ---------------------------------------------------------------

invariant every_identity_and_mailbox_constant_is_the_cards {
    assert HW_NO_PID == NO_PID and GEN_MASK == 4294967295;
    assert HW_D_QUEUED == D_QUEUED and HW_D_DROPPED_DEAD == D_DROPPED_DEAD and HW_D_DROPPED_FULL == D_DROPPED_FULL and HW_D_COALESCED == D_COALESCED;
    assert HW_MAILBOX_CAP == MAILBOX_CAP;
    assert HW_MBOX_SLOTS == MBOX_SLOTS and HW_NO_MATCH == NO_MATCH and SLOT_BITS == 8 and TAG_MASK == 255;
    assert HW_RCV_MATCH == RCV_MATCH and HW_RCV_WAIT == RCV_WAIT and HW_RCV_TIMEOUT == RCV_TIMEOUT and HW_AFTER_INFINITY == AFTER_INFINITY;
    assert HW_LANE_DATA == LANE_DATA and HW_LANE_CONTROL == LANE_CONTROL and HW_LANE_NONE == LANE_NONE;
    assert HW_CTL_TAGS == CTL_TAGS and HW_TAG_BITS == 18446744073709551615 - 1;
    assert HW_CALL_PENDING == CALL_PENDING and HW_CALL_REPLY == CALL_REPLY and HW_CALL_DOWN == CALL_DOWN and HW_CALL_TIMEOUT == CALL_TIMEOUT and HW_CALL_CYCLE == CALL_CYCLE and HW_CALL_TOO_DEEP == CALL_TOO_DEEP;
    assert HW_CHAIN_SLOTS == CHAIN_SLOTS and HW_CALL_MAX_DEPTH == CALL_MAX_DEPTH;
}

invariant every_signal_and_supervisor_constant_is_the_cards {
    assert HW_X_NORMAL == X_NORMAL and HW_X_SHUTDOWN == X_SHUTDOWN and HW_X_KILL == X_KILL and HW_X_KILLED == X_KILLED;
    assert HW_X_CRASH == X_CRASH and HW_X_NOPROC == X_NOPROC and HW_X_NOCONNECTION == X_NOCONNECTION and HW_X_NONE == X_NONE;
    assert HW_ACT_IGNORE == ACT_IGNORE and HW_ACT_DIE == ACT_DIE and HW_ACT_MESSAGE == ACT_MESSAGE;
    assert HW_RESTART_PERMANENT == RESTART_PERMANENT and HW_RESTART_TRANSIENT == RESTART_TRANSIENT and HW_RESTART_TEMPORARY == RESTART_TEMPORARY;
    assert HW_STRAT_ONE_FOR_ONE == STRAT_ONE_FOR_ONE and HW_STRAT_ONE_FOR_ALL == STRAT_ONE_FOR_ALL and HW_STRAT_REST_FOR_ONE == STRAT_REST_FOR_ONE;
    assert HW_SUP_NOTHING == SUP_NOTHING and HW_SUP_RESTART == SUP_RESTART and HW_SUP_GIVE_UP == SUP_GIVE_UP and HW_GIVE_UP_REASON == GIVE_UP_REASON;
    assert HW_BACKOFF_BASE_SECONDS == BACKOFF_BASE_SECONDS and HW_BACKOFF_CAP_SECONDS == BACKOFF_CAP_SECONDS;
    assert HW_STABLE_SECONDS == STABLE_SECONDS and HW_UNSTABLE_GIVE_UP == UNSTABLE_GIVE_UP;
    assert HW_PHI_HASH == PHI_HASH and JITTER_PERCENT == 20;
    assert HW_SHUTDOWN_BRUTAL == SHUTDOWN_BRUTAL and HW_SHUTDOWN_INFINITY == SHUTDOWN_INFINITY;
    assert HW_AUTO_NEVER == AUTO_NEVER and HW_AUTO_ANY_SIGNIFICANT == AUTO_ANY_SIGNIFICANT and HW_AUTO_ALL_SIGNIFICANT == AUTO_ALL_SIGNIFICANT and HW_AUTO_SHUTDOWN_REASON == AUTO_SHUTDOWN_REASON;
    assert HW_START_OK == START_OK and HW_START_MAX_CHILDREN == START_MAX_CHILDREN;
}

invariant every_tree_node_and_file_constant_is_the_cards {
    assert HW_QK_INTAKE == QK_INTAKE and HW_QK_RECONCILER == QK_RECONCILER and HW_QK_DOMAIN_SUP == QK_DOMAIN_SUP and HW_QK_AGENT == QK_AGENT and HW_QK_NONE == QK_NONE;
    assert HW_WORKER_SHUTDOWN_MS == WORKER_SHUTDOWN_MS and HW_AGENT_SHUTDOWN_MS == AGENT_SHUTDOWN_MS;
    assert HW_M_TASK_OFFER == M_TASK_OFFER and HW_M_CANCEL == M_CANCEL and HW_M_HEARTBEAT_DUE == M_HEARTBEAT_DUE;
    assert HW_TURN_MAX_SECONDS == TURN_MAX_SECONDS and HW_SLICE_TURNS == SLICE_TURNS and HW_SLICE_MICROS == SLICE_MICROS;
    assert HW_ISO_LOOP == ISO_LOOP and HW_ISO_THREAD == ISO_THREAD and HW_ISO_PROCESS == ISO_PROCESS;
    assert HW_KILL_ABANDONS == KILL_ABANDONS and HW_KILL_STOPS == KILL_STOPS;
    assert NODE_BITS == 12 and LOCAL_SLOT_BITS == 20 and HW_LOCAL_SLOT_MASK == LOCAL_SLOT_MASK and HW_MAX_NODE == MAX_NODE;
    assert HW_NODE_TTL_SECONDS == NODE_TTL_SECONDS;
    assert HW_FILE_SLOT_BASE == FILE_SLOT_BASE and HW_FILE_OWNER_MASK + 1 == FILE_OWNER_SLOTS;
    assert HW_EDIT_WHOLE == EDIT_WHOLE and HW_EDIT_LINES == EDIT_LINES and HW_EDIT_APPEND == EDIT_APPEND;
    assert HW_FA_ADMIT == FA_ADMIT and HW_FA_QUEUE == FA_QUEUE and HW_FA_REFUSE == FA_REFUSE;
    assert HW_FILE_WAIT_MAX_SECONDS == FILE_WAIT_MAX_SECONDS;
}

/// Saturating u16 ages decide as the card's u32 ones only while every bound is below the top.
invariant every_age_bound_fits_a_saturating_u16 {
    assert FILE_WAIT_MAX_SECONDS < 65535 and TURN_MAX_SECONDS < 65535 and STABLE_SECONDS < 65535;
    assert NODE_TTL_SECONDS < 65535 and NODE_HEARTBEAT_SECONDS < NODE_TTL_SECONDS and SLICE_MICROS < 65535 and SLICE_TURNS < 255;
    assert HW_TASK_LEASE_TTL_SECONDS == 180 and HW_SECONDS_MAX == 65535;
}

/// hw_backoff_seconds is a table only while BASE doubled four times stays under CAP and doubled five
/// times reaches it; the card's loop makes the same cut.
invariant backoff_table_matches_its_constants {
    assert (HW_BACKOFF_BASE_SECONDS << 4) < HW_BACKOFF_CAP_SECONDS;
    assert (HW_BACKOFF_BASE_SECONDS << 5) >= HW_BACKOFF_CAP_SECONDS;
    assert HW_UNSTABLE_GIVE_UP == 6;
}

; --- 12. One decision engine ---------------------------------------------------------------------------
; `fn on_clock` is the module's hardware boundary: its parameters become input ports and the `var`s
; below become registered outputs (t27c gen-verilog, #1764). Each cycle the operation code `op` picks one
; decision; its answer lands in the register of its width, and the other registers keep theirs. One
; copy of each decision exists, so the engine is time-multiplexed: an actor record read from block RAM
; is decided one operation a cycle, and many engines side by side decide many actors.
; Operands: a, b are u64 (a pid, a mailbox, a lane, a chain, a hash); c, d are u32 (a slot, a
; generation, milliseconds, a line number, free room); e, f are u16 (seconds, a node id, a wait; their
; low byte where a third or fourth byte is needed); g, h are bytes (a tag, a code, a count); k0, k1, k2 are
; the flags. Each HW_OP_ constant names its operands in that order.
; The jitter unit runs beside the decisions: HW_OP_JITTER loads a wait (e) and a seed (c), and 48 cycles
; later jit_out holds the card's jittered second and jit_busy falls. It runs the steps of
; hw_jittered_seconds_serial, one a cycle: a 32-bit adder and a 17-bit subtractor where the one-shot form
; needs ten adders and sixteen subtractors.
; Every `var` is read before it is written in a cycle and written once per path, so the test semantics
; (statements in order) and the hardware's (all registers update at the clock edge) agree. The flags are
; three bool ports, not bits of a byte unpacked into locals: a `var` inside `on_clock` does not lower to
; Verilog that yosys accepts (#8346).

/// Wide answers (eng_wide, u64).
pub const HW_OP_PID_OF : u8 = 1;            // c slot, d gen
pub const HW_OP_MBOX_PUSH : u8 = 2;         // a box, g tag
pub const HW_OP_MBOX_REMOVE : u8 = 3;       // a box, g slot index
pub const HW_OP_RECEIVE : u8 = 4;           // a box, g wanted tag
pub const HW_OP_CTL_POST : u8 = 5;          // a lane, g tag
pub const HW_OP_CTL_TAKE : u8 = 6;          // a lane
pub const HW_OP_LIVE_ALIAS : u8 = 7;        // a alias, g outcome
pub const HW_OP_CHAIN_ADD : u8 = 8;         // a chain, c slot
pub const HW_OP_NODE_PID : u8 = 9;          // e node, c local slot, d gen
/// Word answers (eng_word, u32).
pub const HW_OP_SLOT_OF : u8 = 10;          // a pid
pub const HW_OP_GEN_OF : u8 = 11;           // a pid
pub const HW_OP_NEXT_GEN : u8 = 12;         // c gen
pub const HW_OP_QUEEN_SHUTDOWN_MS : u8 = 13; // g kind
pub const HW_OP_LOCAL_OF : u8 = 14;         // a pid
pub const HW_OP_FILE_OWNER_SLOT : u8 = 15;  // a path hash
/// Half answers (eng_half, u16).
pub const HW_OP_LINKS_AFTER_LINK : u8 = 16; // k0 already linked, g links
pub const HW_OP_MONITORS_AFTER_MONITOR : u8 = 17; // g monitors
pub const HW_OP_UNSTABLE_STREAK : u8 = 18;  // g streak, e ran seconds
pub const HW_OP_BACKOFF_SECONDS : u8 = 19;  // g streak
pub const HW_OP_ROOT_CHILDREN : u8 = 20;    // g domain count
pub const HW_OP_RECLAIM_WAIT_SECONDS : u8 = 21; // g down reason, e since renewal, f ttl
pub const HW_OP_NODE_OF : u8 = 22;          // a pid
/// Byte answers (eng_byte, u8; a bool is 0 or 1).
pub const HW_OP_REACHES : u8 = 23;          // a addressed, b live
pub const HW_OP_DELIVER : u8 = 24;          // k0 reached, e queued, f cap
pub const HW_OP_ORDERED : u8 = 25;          // k0 same sender, k1 same receiver
pub const HW_OP_MBOX_TAG : u8 = 26;         // a box, g slot index
pub const HW_OP_MBOX_LEN : u8 = 27;         // a box
pub const HW_OP_MBOX_FIND : u8 = 28;        // a box, g wanted tag
pub const HW_OP_RECEIVE_OUTCOME : u8 = 29;  // k0 found, c waited ms, d after ms
pub const HW_OP_DELIVER_CONTROL : u8 = 30;  // k0 reached, k1 kind pending
pub const HW_OP_IS_DEAD_LETTER : u8 = 31;   // g outcome
pub const HW_OP_NEXT_LANE : u8 = 32;        // k0 control pending, k1 data pending
pub const HW_OP_CTL_PENDING : u8 = 33;      // a lane, g tag
pub const HW_OP_CTL_NEXT : u8 = 34;         // a lane
pub const HW_OP_CALL_OUTCOME : u8 = 35;     // k0 reply queued, k1 down queued, c waited ms, d after ms
pub const HW_OP_CHAIN_HAS : u8 = 36;        // a chain, c slot
pub const HW_OP_CALL_ADMIT : u8 = 37;       // a chain, g depth, c callee slot
pub const HW_OP_ON_EXIT_SIGNAL : u8 = 38;   // g reason, k0 trapping
pub const HW_OP_DEATH_REASON : u8 = 39;     // g signal
pub const HW_OP_ATTACH_ANSWER : u8 = 40;    // k0 target alive
pub const HW_OP_DOWN_LEFT_AFTER_DEMONITOR : u8 = 41; // k0 flush, k1 down queued
pub const HW_OP_SHOULD_RESTART : u8 = 42;   // g restart type, h reason
pub const HW_OP_AFFECTED : u8 = 43;         // g strategy, h failed, e child
pub const HW_OP_STOPPED_BY_RESTART : u8 = 44; // g strategy, h failed, e child, k0 failed restarts
pub const HW_OP_RESTARTED : u8 = 45;        // g strategy, h failed, e child, f child type, k0 failed restarts
pub const HW_OP_STOP_RANK : u8 = 46;        // g index, h count
pub const HW_OP_IN_PERIOD : u8 = 47;        // e age, f period
pub const HW_OP_INTENSITY_EXCEEDED : u8 = 48; // g restarts, h max
pub const HW_OP_ON_CHILD_EXIT : u8 = 49;    // g restart type, h reason, e earlier, f max
pub const HW_OP_WITH_BACKOFF : u8 = 50;     // g decision, h streak
pub const HW_OP_STOP_SIGNAL : u8 = 51;      // c waited ms, d timeout ms
pub const HW_OP_CHILD_SPEC_VALID : u8 = 52; // g restart type, k0 significant, h mode
pub const HW_OP_AUTO_SHUTDOWN_AFTER_EXIT : u8 = 53; // g mode, k0 significant, h type, e reason, k1 by supervisor, f left
pub const HW_OP_AUTO_SHUTDOWN_STICKS : u8 = 54; // g restart type
pub const HW_OP_START_ANSWER : u8 = 55;     // g live, h stopping, e max
pub const HW_OP_CHILDREN_AFTER_EXIT : u8 = 56; // g children, k0 restarted
pub const HW_OP_ROOT_CHILD_KIND : u8 = 57;  // g index, h domain count
pub const HW_OP_QUEEN_RESTART_TYPE : u8 = 58; // g kind
pub const HW_OP_STOPS_INSIDE_THE_LEASE : u8 = 59; // c shutdown ms, e ttl
pub const HW_OP_LANE_OF : u8 = 60;          // g tag
pub const HW_OP_HUNG_TURN_SIGNAL : u8 = 61; // e turn age
pub const HW_OP_TURN_SIGNAL : u8 = 62;      // e turn age, f bound
pub const HW_OP_SLICE_SPENT : u8 = 63;      // g turns, e micros
pub const HW_OP_TURN_ISOLATION : u8 = 64;   // k0 cpu bound, k1 foreign code, k2 must stop
pub const HW_OP_KILL_EFFECT : u8 = 65;      // g isolation
pub const HW_OP_HOLDS_AFTER_KILL : u8 = 66; // g isolation, k0 work ended
pub const HW_OP_IS_REMOTE : u8 = 67;        // a pid, e own node
pub const HW_OP_NODE_UP : u8 = 68;          // e seconds since heartbeat
pub const HW_OP_SEND_REMOTE : u8 = 69;      // k0 node up
pub const HW_OP_REMOTE_DOWN : u8 = 70;      // k0 node up, k1 pid ended, g reason
pub const HW_OP_PLACE_BEFORE : u8 = 71;     // c free a, e node a, d free b, f node b
pub const HW_OP_EDITS_MEET : u8 = 72;       // g a kind, c a start, d a end, h b kind, a b start, b b end
pub const HW_OP_FILE_ADMIT : u8 = 73;       // k0 meets running, k1 meets queued, a queue, e waited
pub const HW_OP_REFUSAL_GIVES_UP : u8 = 74; // e waited
pub const HW_OP_TAKES_A_LANE : u8 = 75;     // g answer
pub const HW_OP_EDIT_STILL_HOLDS : u8 = 76; // k0 finished, k1 holds files now, e seconds since renewal
/// The jitter unit.
pub const HW_OP_JITTER : u8 = 77;           // e wait, c seed
pub const HW_JITTER_CYCLES : u8 = 48;

var eng_wide : u64 = 0;
var eng_word : u32 = 0;
var eng_half : u16 = 0;
var eng_byte : u8 = 0;
var jit_busy : bool = false;
var jit_step : u8 = 0;
var jit_acc : u32 = 0;
var jit_seed : u32 = 0;
var jit_rem : u16 = 0;
var jit_div : u16 = 0;
var jit_wait : u16 = 0;
var jit_out : u16 = 0;

/// A bool as the byte register holds it.
pub fn hw_byte_of(x: bool) -> u8 {
    if (x) { return 1; }
    return 0;
}

fn on_clock(op: u8, a: u64, b: u64, c: u32, d: u32, e: u16, f: u16, g: u8, h: u8, k0: bool, k1: bool, k2: bool) {
    // the jitter unit: one of its 48 steps a cycle while busy
    if (jit_busy) {
        if (jit_step < 32) {
            jit_acc = hw_hash_step(jit_acc, (jit_seed >> 31) == 1);
            jit_seed = jit_seed << 1;
        } else if (jit_step < 47) {
            jit_rem = hw_mod_step(jit_rem, (jit_acc >> 31) as u16, jit_div);
            jit_acc = jit_acc << 1;
        } else {
            jit_out = jit_wait - hw_mod_step(jit_rem, (jit_acc >> 31) as u16, jit_div);
            jit_busy = false;
        }
        jit_step = jit_step + 1;
    }
    if (op == HW_OP_JITTER) {
        jit_busy = true;
        jit_step = 0;
        jit_acc = 0;
        jit_seed = c;
        jit_rem = 0;
        jit_div = hw_fifth(e) + 1;
        jit_wait = e;
    }
    // one decision a cycle, into the register of its width
    if (op == HW_OP_PID_OF) { eng_wide = hw_pid_of(c, d); }
    else if (op == HW_OP_MBOX_PUSH) { eng_wide = hw_mbox_push(a, g); }
    else if (op == HW_OP_MBOX_REMOVE) { eng_wide = hw_mbox_remove(a, g); }
    else if (op == HW_OP_RECEIVE) { eng_wide = hw_receive(a, g); }
    else if (op == HW_OP_CTL_POST) { eng_wide = hw_ctl_post(a, g); }
    else if (op == HW_OP_CTL_TAKE) { eng_wide = hw_ctl_take(a); }
    else if (op == HW_OP_LIVE_ALIAS) { eng_wide = hw_live_alias(a, g); }
    else if (op == HW_OP_CHAIN_ADD) { eng_wide = hw_chain_add(a, c); }
    else if (op == HW_OP_NODE_PID) { eng_wide = hw_node_pid(e, c, d); }
    if (op == HW_OP_SLOT_OF) { eng_word = hw_slot_of(a); }
    else if (op == HW_OP_GEN_OF) { eng_word = hw_gen_of(a); }
    else if (op == HW_OP_NEXT_GEN) { eng_word = hw_next_gen(c); }
    else if (op == HW_OP_QUEEN_SHUTDOWN_MS) { eng_word = hw_queen_shutdown_ms(g); }
    else if (op == HW_OP_LOCAL_OF) { eng_word = hw_local_of(a); }
    else if (op == HW_OP_FILE_OWNER_SLOT) { eng_word = hw_file_owner_slot(a); }
    if (op == HW_OP_LINKS_AFTER_LINK) { eng_half = hw_links_after_link(k0, g); }
    else if (op == HW_OP_MONITORS_AFTER_MONITOR) { eng_half = hw_monitors_after_monitor(g); }
    else if (op == HW_OP_UNSTABLE_STREAK) { eng_half = hw_unstable_streak(g, e); }
    else if (op == HW_OP_BACKOFF_SECONDS) { eng_half = hw_backoff_seconds(g); }
    else if (op == HW_OP_ROOT_CHILDREN) { eng_half = hw_root_children(g); }
    else if (op == HW_OP_RECLAIM_WAIT_SECONDS) { eng_half = hw_reclaim_wait_seconds(g, e, f); }
    else if (op == HW_OP_NODE_OF) { eng_half = hw_node_of(a); }
    if (op == HW_OP_REACHES) { eng_byte = hw_byte_of(hw_reaches(a, b)); }
    else if (op == HW_OP_DELIVER) { eng_byte = hw_deliver(k0, e, f); }
    else if (op == HW_OP_ORDERED) { eng_byte = hw_byte_of(hw_ordered(k0, k1)); }
    else if (op == HW_OP_MBOX_TAG) { eng_byte = hw_mbox_tag(a, g); }
    else if (op == HW_OP_MBOX_LEN) { eng_byte = hw_mbox_len(a); }
    else if (op == HW_OP_MBOX_FIND) { eng_byte = hw_mbox_find(a, g); }
    else if (op == HW_OP_RECEIVE_OUTCOME) { eng_byte = hw_receive_outcome(k0, c, d); }
    else if (op == HW_OP_DELIVER_CONTROL) { eng_byte = hw_deliver_control(k0, k1); }
    else if (op == HW_OP_IS_DEAD_LETTER) { eng_byte = hw_byte_of(hw_is_dead_letter(g)); }
    else if (op == HW_OP_NEXT_LANE) { eng_byte = hw_next_lane(k0, k1); }
    else if (op == HW_OP_CTL_PENDING) { eng_byte = hw_byte_of(hw_ctl_pending(a, g)); }
    else if (op == HW_OP_CTL_NEXT) { eng_byte = hw_ctl_next(a); }
    else if (op == HW_OP_CALL_OUTCOME) { eng_byte = hw_call_outcome(k0, k1, c, d); }
    else if (op == HW_OP_CHAIN_HAS) { eng_byte = hw_byte_of(hw_chain_has(a, c)); }
    else if (op == HW_OP_CALL_ADMIT) { eng_byte = hw_call_admit(a, g, c); }
    else if (op == HW_OP_ON_EXIT_SIGNAL) { eng_byte = hw_on_exit_signal(g, k0); }
    else if (op == HW_OP_DEATH_REASON) { eng_byte = hw_death_reason(g); }
    else if (op == HW_OP_ATTACH_ANSWER) { eng_byte = hw_attach_answer(k0); }
    else if (op == HW_OP_DOWN_LEFT_AFTER_DEMONITOR) { eng_byte = hw_byte_of(hw_down_left_after_demonitor(k0, k1)); }
    else if (op == HW_OP_SHOULD_RESTART) { eng_byte = hw_byte_of(hw_should_restart(g, h)); }
    else if (op == HW_OP_AFFECTED) { eng_byte = hw_byte_of(hw_affected(g, h, e as u8)); }
    else if (op == HW_OP_STOPPED_BY_RESTART) { eng_byte = hw_byte_of(hw_stopped_by_restart(g, h, e as u8, k0)); }
    else if (op == HW_OP_RESTARTED) { eng_byte = hw_byte_of(hw_restarted(g, h, e as u8, f as u8, k0)); }
    else if (op == HW_OP_STOP_RANK) { eng_byte = hw_stop_rank(g, h); }
    else if (op == HW_OP_IN_PERIOD) { eng_byte = hw_byte_of(hw_in_period(e, f)); }
    else if (op == HW_OP_INTENSITY_EXCEEDED) { eng_byte = hw_byte_of(hw_intensity_exceeded(g, h)); }
    else if (op == HW_OP_ON_CHILD_EXIT) { eng_byte = hw_on_child_exit(g, h, e as u8, f as u8); }
    else if (op == HW_OP_WITH_BACKOFF) { eng_byte = hw_with_backoff(g, h); }
    else if (op == HW_OP_STOP_SIGNAL) { eng_byte = hw_stop_signal(c, d); }
    else if (op == HW_OP_CHILD_SPEC_VALID) { eng_byte = hw_byte_of(hw_child_spec_valid(g, k0, h)); }
    else if (op == HW_OP_AUTO_SHUTDOWN_AFTER_EXIT) { eng_byte = hw_byte_of(hw_auto_shutdown_after_exit(g, k0, h, e as u8, k1, f as u8)); }
    else if (op == HW_OP_AUTO_SHUTDOWN_STICKS) { eng_byte = hw_byte_of(hw_auto_shutdown_sticks(g)); }
    else if (op == HW_OP_START_ANSWER) { eng_byte = hw_start_answer(g, h, e as u8); }
    else if (op == HW_OP_CHILDREN_AFTER_EXIT) { eng_byte = hw_children_after_exit(g, k0); }
    else if (op == HW_OP_ROOT_CHILD_KIND) { eng_byte = hw_root_child_kind(g, h); }
    else if (op == HW_OP_QUEEN_RESTART_TYPE) { eng_byte = hw_queen_restart_type(g); }
    else if (op == HW_OP_STOPS_INSIDE_THE_LEASE) { eng_byte = hw_byte_of(hw_stops_inside_the_lease(c, e)); }
    else if (op == HW_OP_LANE_OF) { eng_byte = hw_lane_of(g); }
    else if (op == HW_OP_HUNG_TURN_SIGNAL) { eng_byte = hw_hung_turn_signal(e); }
    else if (op == HW_OP_TURN_SIGNAL) { eng_byte = hw_turn_signal(e, f); }
    else if (op == HW_OP_SLICE_SPENT) { eng_byte = hw_byte_of(hw_slice_spent(g, e)); }
    else if (op == HW_OP_TURN_ISOLATION) { eng_byte = hw_turn_isolation(k0, k1, k2); }
    else if (op == HW_OP_KILL_EFFECT) { eng_byte = hw_kill_effect(g); }
    else if (op == HW_OP_HOLDS_AFTER_KILL) { eng_byte = hw_byte_of(hw_holds_after_kill(g, k0)); }
    else if (op == HW_OP_IS_REMOTE) { eng_byte = hw_byte_of(hw_is_remote(a, e)); }
    else if (op == HW_OP_NODE_UP) { eng_byte = hw_byte_of(hw_node_up(e)); }
    else if (op == HW_OP_SEND_REMOTE) { eng_byte = hw_send_remote(k0); }
    else if (op == HW_OP_REMOTE_DOWN) { eng_byte = hw_remote_down(k0, k1, g); }
    else if (op == HW_OP_PLACE_BEFORE) { eng_byte = hw_byte_of(hw_place_before(c, e, d, f)); }
    else if (op == HW_OP_EDITS_MEET) { eng_byte = hw_byte_of(hw_edits_meet(g, c, d, h, a as u32, b as u32)); }
    else if (op == HW_OP_FILE_ADMIT) { eng_byte = hw_file_admit(k0, k1, a, e); }
    else if (op == HW_OP_REFUSAL_GIVES_UP) { eng_byte = hw_byte_of(hw_refusal_gives_up(e)); }
    else if (op == HW_OP_TAKES_A_LANE) { eng_byte = hw_byte_of(hw_takes_a_lane(g)); }
    else if (op == HW_OP_EDIT_STILL_HOLDS) { eng_byte = hw_byte_of(hw_edit_still_holds(k0, k1, e)); }
}

; --- Tests: each hw_ function against the card ---------------------------------------------------------

test identity_is_bit_exact {
    // every pid field edge, then 4096 pseudo-random pids (a 64-bit LCG)
    assert hw_pid_of(0, 3) == pid_of(0, 3);
    assert hw_pid_of(1, 0) == pid_of(1, 0);
    assert hw_pid_of(4294967295, 4294967295) == pid_of(4294967295, 4294967295);
    assert hw_next_gen(4294967295) == next_gen(4294967295);
    var x : u64 = 1;
    var k : u32 = 0;
    while (k < 4096) {
        var s : u64 = x >> 32;
        var g : u64 = x & 4294967295;
        assert hw_pid_of(s as u32, g as u32) == pid_of(s, g);
        assert hw_slot_of(x) == slot_of(x);
        assert hw_gen_of(x) == gen_of(x);
        assert hw_next_gen(g as u32) == next_gen(g);
        assert hw_reaches(x, x) == reaches(x, x);
        assert hw_reaches(x, x ^ 1) == reaches(x, x ^ 1);
        assert hw_reaches(0, x) == reaches(0, x);
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        k = k + 1;
    }
}

test the_mailbox_model_is_bit_exact {
    // every box whose 8 slots hold a tag of 0, 1 or 2 (3^8 = 6561 boxes, every gap shape), each slot
    // index 0..9, each wanted tag 0..3 and 255, and each pushed tag 0..3 and 255
    var n : u64 = 0;
    while (n < 6561) {
        var box : u64 = 0;
        var rest : u64 = n;
        var slot : u64 = 0;
        while (slot < 8) {
            box = box | ((rest % 3) << (slot * 8));
            rest = rest / 3;
            slot = slot + 1;
        }
        assert hw_mbox_len(box) == mbox_len(box);
        var i : u64 = 0;
        while (i < 10) {
            assert hw_mbox_tag(box, i as u8) == mbox_tag(box, i);
            assert hw_mbox_remove(box, i as u8) == mbox_remove(box, i);
            i = i + 1;
        }
        var w : u64 = 0;
        while (w < 4) {
            assert hw_mbox_find(box, w as u8) == mbox_find(box, w);
            assert hw_receive(box, w as u8) == receive(box, w);
            assert hw_mbox_push(box, w as u8) == mbox_push(box, w);
            w = w + 1;
        }
        assert hw_mbox_find(box, 255) == mbox_find(box, 255);
        assert hw_mbox_push(box, 255) == mbox_push(box, 255);
        n = n + 1;
    }
    // 4096 pseudo-random boxes, raw and with random slots emptied, against every slot and a random tag
    var x : u64 = 7;
    var k : u32 = 0;
    while (k < 4096) {
        var holes : u64 = (x >> 7) & (x >> 13) & 72340172838076673;
        // a local, not x & ~(holes * 255): the Zig backend drops those parentheses (#8343)
        var hole_bytes : u64 = holes * 255;
        var b : u64 = x & ~hole_bytes;
        var t : u64 = (x >> 40) & 255;
        assert hw_mbox_len(b) == mbox_len(b);
        assert hw_mbox_find(b, t as u8) == mbox_find(b, t);
        assert hw_receive(b, t as u8) == receive(b, t);
        assert hw_mbox_push(b, t as u8) == mbox_push(b, t);
        assert hw_mbox_find(x, t as u8) == mbox_find(x, t);
        var j : u64 = 0;
        while (j < 9) {
            assert hw_mbox_remove(b, j as u8) == mbox_remove(b, j);
            assert hw_mbox_tag(x, j as u8) == mbox_tag(x, j);
            j = j + 1;
        }
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        k = k + 1;
    }
    // every slot index a u8 can hold: past the last slot the box is unchanged and no tag is read
    var big : u32 = 8;
    while (big < 256) {
        assert hw_mbox_remove(x, big as u8) == mbox_remove(x, big as u64);
        assert hw_mbox_tag(x, big as u8) == mbox_tag(x, big as u64);
        big = big + 1;
    }
}

test delivery_and_lanes_are_bit_exact {
    // every queue length and cap of 0..1023, both ways of reaching, then the u16 edges
    var q : u32 = 0;
    while (q < 1024) {
        var c : u32 = 0;
        while (c < 1024) {
            assert hw_deliver(true, q as u16, c as u16) == deliver(true, q, c);
            assert hw_deliver(false, q as u16, c as u16) == deliver(false, q, c);
            c = c + 1;
        }
        q = q + 1;
    }
    assert hw_deliver(true, 65535, 65535) == deliver(true, 65535, 65535);
    assert hw_deliver(true, 65534, 65535) == deliver(true, 65534, 65535);
    assert hw_deliver(true, 65535, 256) == deliver(true, 65535, 256);
    // every outcome byte, and every pair of flags
    var o : u32 = 0;
    while (o < 256) {
        assert hw_is_dead_letter(o as u8) == is_dead_letter(o as u8);
        o = o + 1;
    }
    var f : u32 = 0;
    while (f < 4) {
        var a : bool = (f & 1) == 1;
        var b : bool = (f & 2) == 2;
        assert hw_ordered(a, b) == ordered(a, b);
        assert hw_deliver_control(a, b) == deliver_control(a, b);
        assert hw_next_lane(a, b) == next_lane(a, b);
        f = f + 1;
    }
    // receive_outcome: milliseconds are unchanged u32; edges and a sweep
    var w : u32 = 0;
    while (w < 2048) {
        assert hw_receive_outcome(false, w, 1000) == receive_outcome(false, w, 1000);
        assert hw_receive_outcome(true, w, 1000) == receive_outcome(true, w, 1000);
        assert hw_receive_outcome(false, 1000, w) == receive_outcome(false, 1000, w);
        w = w + 1;
    }
    assert hw_receive_outcome(false, 4294967295, 4294967295) == receive_outcome(false, 4294967295, 4294967295);
    assert hw_receive_outcome(false, 4294967295, 4294967294) == receive_outcome(false, 4294967295, 4294967294);
    assert hw_receive_outcome(false, 0, 0) == receive_outcome(false, 0, 0);
}

test the_control_lane_is_bit_exact {
    // every lane with one bit or two bits set (64 + 2016), the empty and the full lane, 4096
    // pseudo-random lanes; each against every tag 0..255
    var one : u64 = 1;
    var i : u64 = 0;
    while (i < 64) {
        assert hw_bit(i as u8) == bit(i);
        var j : u64 = i;
        while (j < 64) {
            var lane : u64 = (one << i) | (one << j);
            assert hw_ctl_next(lane) == ctl_next(lane);
            assert hw_ctl_take(lane) == ctl_take(lane);
            j = j + 1;
        }
        i = i + 1;
    }
    var x : u64 = 11;
    var k : u32 = 0;
    while (k < 4098) {
        var l : u64 = x;
        if (k == 4096) { l = 0; }
        if (k == 4097) { l = 18446744073709551615; }
        // a sparse lane too: random lanes almost always hold tag 1
        var sparse : u64 = l & (l >> 9) & (l >> 23);
        assert hw_ctl_next(l) == ctl_next(l);
        assert hw_ctl_take(l) == ctl_take(l);
        assert hw_ctl_next(sparse) == ctl_next(sparse);
        assert hw_ctl_take(sparse) == ctl_take(sparse);
        var t : u32 = (k * 7) & 255;
        assert hw_ctl_pending(l, t as u8) == ctl_pending(l, t);
        assert hw_ctl_post(sparse, t as u8) == ctl_post(sparse, t);
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        k = k + 1;
    }
    var tag : u32 = 0;
    while (tag < 256) {
        assert hw_ctl_pending(x, tag as u8) == ctl_pending(x, tag);
        assert hw_ctl_post(0, tag as u8) == ctl_post(0, tag);
        assert hw_ctl_post(x, tag as u8) == ctl_post(x, tag);
        tag = tag + 1;
    }
}

test calls_and_chains_are_bit_exact {
    var f : u32 = 0;
    while (f < 4) {
        var a : bool = (f & 1) == 1;
        var b : bool = (f & 2) == 2;
        var w : u32 = 0;
        while (w < 1100) {
            assert hw_call_outcome(a, b, w, 1000) == call_outcome(a, b, w, 1000);
            assert hw_call_outcome(a, b, 1000, w) == call_outcome(a, b, 1000, w);
            w = w + 1;
        }
        assert hw_call_outcome(a, b, 4294967294, 4294967295) == call_outcome(a, b, 4294967294, 4294967295);
        assert hw_call_outcome(a, b, 4294967295, 4294967294) == call_outcome(a, b, 4294967295, 4294967294);
        f = f + 1;
    }
    var o : u32 = 0;
    while (o < 256) {
        assert hw_live_alias(123456789, o as u8) == live_alias(123456789, o as u8);
        o = o + 1;
    }
    // chains: 2048 pseudo-random chains against every slot 0..127, the u32 top, and depths 0..255
    var x : u64 = 3;
    var k : u32 = 0;
    while (k < 2048) {
        var s : u32 = 0;
        while (s < 128) {
            assert hw_chain_has(x, s) == chain_has(x, s);
            assert hw_chain_add(x, s) == chain_add(x, s);
            assert hw_call_admit(x, (k & 255) as u8, s) == call_admit(x, k & 255, s);
            s = s + 1;
        }
        assert hw_chain_has(x, 4294967295) == chain_has(x, 4294967295);
        assert hw_chain_add(x, 4294967295) == chain_add(x, 4294967295);
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        k = k + 1;
    }
}

test signals_links_and_monitors_are_bit_exact {
    var r : u32 = 0;
    while (r < 256) {
        assert hw_on_exit_signal(r as u8, false) == on_exit_signal(r as u8, false);
        assert hw_on_exit_signal(r as u8, true) == on_exit_signal(r as u8, true);
        assert hw_death_reason(r as u8) == death_reason(r as u8);
        assert hw_links_after_link(false, r as u8) == links_after_link(false, r);
        assert hw_links_after_link(true, r as u8) == links_after_link(true, r);
        assert hw_monitors_after_monitor(r as u8) == monitors_after_monitor(r);
        r = r + 1;
    }
    assert hw_attach_answer(true) == attach_answer(true);
    assert hw_attach_answer(false) == attach_answer(false);
    var f : u32 = 0;
    while (f < 4) {
        var a : bool = (f & 1) == 1;
        var b : bool = (f & 2) == 2;
        assert hw_down_left_after_demonitor(a, b) == down_left_after_demonitor(a, b);
        f = f + 1;
    }
}

test supervisor_rules_are_bit_exact {
    // every restart type and reason byte
    var t : u32 = 0;
    while (t < 256) {
        var r : u32 = 0;
        while (r < 256) {
            assert hw_should_restart(t as u8, r as u8) == should_restart(t as u8, r as u8);
            r = r + 1;
        }
        assert hw_auto_shutdown_sticks(t as u8) == auto_shutdown_sticks(t as u8);
        t = t + 1;
    }
    // every strategy 0..3 and every failed and child index 0..255
    var s : u32 = 0;
    while (s < 4) {
        var fl : u32 = 0;
        while (fl < 256) {
            var c : u32 = 0;
            while (c < 256) {
                assert hw_affected(s as u8, fl as u8, c as u8) == affected(s as u8, fl, c);
                assert hw_stopped_by_restart(s as u8, fl as u8, c as u8, true) == stopped_by_restart(s as u8, fl, c, true);
                assert hw_stopped_by_restart(s as u8, fl as u8, c as u8, false) == stopped_by_restart(s as u8, fl, c, false);
                assert hw_restarted(s as u8, fl as u8, c as u8, (c & 3) as u8, true) == restarted(s as u8, fl, c, (c & 3) as u8, true);
                assert hw_restarted(s as u8, fl as u8, c as u8, (fl & 3) as u8, false) == restarted(s as u8, fl, c, (fl & 3) as u8, false);
                c = c + 1;
            }
            fl = fl + 1;
        }
        s = s + 1;
    }
    // every pair of u8 counts: stop rank, intensity, start answer
    var a : u32 = 0;
    while (a < 256) {
        var b : u32 = 0;
        while (b < 256) {
            assert hw_stop_rank(a as u8, b as u8) == stop_rank(a, b);
            assert hw_intensity_exceeded(a as u8, b as u8) == intensity_exceeded(a, b);
            assert hw_start_answer(a as u8, b as u8, 4) == start_answer(a, b, 4);
            assert hw_start_answer(a as u8, 0, b as u8) == start_answer(a, 0, b);
            assert hw_start_answer(255, a as u8, b as u8) == start_answer(255, a, b);
            b = b + 1;
        }
        a = a + 1;
    }
    // on_child_exit: restart types 0..3 and 255, reasons 0..7, 99 and 255, every earlier and max
    var rt : u32 = 0;
    while (rt < 5) {
        var rty : u32 = rt;
        if (rt == 4) { rty = 255; }
        var rs : u32 = 0;
        while (rs < 10) {
            var rea : u32 = rs;
            if (rs == 8) { rea = 99; }
            if (rs == 9) { rea = 255; }
            var e : u32 = 0;
            while (e < 256) {
                var m : u32 = 0;
                while (m < 256) {
                    assert hw_on_child_exit(rty as u8, rea as u8, e as u8, m as u8) == on_child_exit(rty as u8, rea as u8, e, m);
                    m = m + 1;
                }
                e = e + 1;
            }
            rs = rs + 1;
        }
        rt = rt + 1;
    }
    // children_after_exit over its domain: a restarted child from 0, any other from 1
    var ch : u32 = 0;
    while (ch < 256) {
        assert hw_children_after_exit(ch as u8, true) == children_after_exit(ch, true);
        if (ch >= 1) {
            assert hw_children_after_exit(ch as u8, false) == children_after_exit(ch, false);
        }
        ch = ch + 1;
    }
}

test significance_and_shutdowns_are_bit_exact {
    // every restart type and mode byte, both significances
    var rt : u32 = 0;
    while (rt < 256) {
        var md : u32 = 0;
        while (md < 256) {
            assert hw_child_spec_valid(rt as u8, true, md as u8) == child_spec_valid(rt as u8, true, md as u8);
            assert hw_child_spec_valid(rt as u8, false, md as u8) == child_spec_valid(rt as u8, false, md as u8);
            md = md + 1;
        }
        rt = rt + 1;
    }
    // auto_shutdown_after_exit: modes 0..3, both flags each, types 0..3, reasons 0..7 and 99, left 0..3
    var mode : u32 = 0;
    while (mode < 4) {
        var fl : u32 = 0;
        while (fl < 4) {
            var sig : bool = (fl & 1) == 1;
            var bys : bool = (fl & 2) == 2;
            var ty : u32 = 0;
            while (ty < 4) {
                var re : u32 = 0;
                while (re < 9) {
                    var rea : u32 = re;
                    if (re == 8) { rea = 99; }
                    var left : u32 = 0;
                    while (left < 4) {
                        assert hw_auto_shutdown_after_exit(mode as u8, sig, ty as u8, rea as u8, bys, left as u8) == auto_shutdown_after_exit(mode as u8, sig, ty as u8, rea as u8, bys, left);
                        left = left + 1;
                    }
                    re = re + 1;
                }
                ty = ty + 1;
            }
            fl = fl + 1;
        }
        mode = mode + 1;
    }
    // stop_signal: milliseconds unchanged u32; a sweep and the sentinels
    var w : u32 = 0;
    while (w < 6000) {
        assert hw_stop_signal(w, 5000) == stop_signal(w, 5000);
        assert hw_stop_signal(w, 0) == stop_signal(w, 0);
        assert hw_stop_signal(w, 4294967295) == stop_signal(w, 4294967295);
        assert hw_stop_signal(5000, w) == stop_signal(5000, w);
        w = w + 1;
    }
    assert hw_stop_signal(4294967295, 4294967295) == stop_signal(4294967295, 4294967295);
    assert hw_stop_signal(4294967295, 4294967294) == stop_signal(4294967295, 4294967294);
}

test backoff_is_a_closed_form_table {
    // every u8 streak, and the card's loop past the u8 range
    var s : u32 = 0;
    while (s < 256) {
        assert hw_backoff_seconds(s as u8) == backoff_seconds(s);
        var d : u32 = 0;
        while (d < 256) {
            assert hw_with_backoff(d as u8, s as u8) == with_backoff(d as u8, s);
            d = d + 1;
        }
        var ran : u32 = 0;
        while (ran < 1300) {
            assert hw_unstable_streak(s as u8, ran as u16) == unstable_streak(s, ran);
            ran = ran + 1;
        }
        assert hw_unstable_streak(s as u8, 65535) == unstable_streak(s, 65535);
        s = s + 1;
    }
    assert backoff_seconds(4294967295) == hw_backoff_seconds(255);
}

test jitter_is_bit_exact {
    // the hash takes every one of its 2^16 values: seed v * 2^16 * PHI_HASH^-1 hashes to v
    // (340573321 * 2654435769 = 1 mod 2^32); each against every backoff wait and the u16 top
    var v : u64 = 0;
    while (v < 65536) {
        var seed : u64 = ((v << 16) * 340573321) & 4294967295;
        assert seed_hash(seed) == v;
        assert hw_seed_hash(seed as u32) == seed_hash(seed);
        var streak : u32 = 0;
        while (streak < 7) {
            var wait : u32 = backoff_seconds(streak);
            assert hw_jittered_seconds(wait as u16, seed as u32) == jittered_seconds(wait, seed);
            streak = streak + 1;
        }
        assert hw_jittered_seconds(65535, seed as u32) == jittered_seconds(65535, seed);
        assert hw_jittered_seconds(511, seed as u32) == jittered_seconds(511, seed);
        v = v + 1;
    }
    // every u16 wait: the spread, and the jitter for 8 seeds, one of them past 32 bits
    var w : u32 = 0;
    while (w < 65536) {
        assert (hw_fifth(w as u16) as u32) == (w * 20) / 100;
        assert hw_jittered_seconds(w as u16, 1) == jittered_seconds(w, 1);
        assert hw_jittered_seconds(w as u16, 61) == jittered_seconds(w, 61);
        assert hw_jittered_seconds(w as u16, 4294967295) == jittered_seconds(w, 4294967295);
        assert hw_jittered_seconds(w as u16, 0) == jittered_seconds(w, 4294967296);
        assert hw_jittered_seconds(w as u16, w * 7919) == jittered_seconds(w, (w * 7919) as u64);
        w = w + 1;
    }
    // the division unit alone: every dividend against each divisor the backoff waits give, and the
    // largest divisor a u16 wait gives (65535 / 5 + 1)
    var h : u32 = 0;
    while (h < 65536) {
        assert hw_mod16(h as u16, 1) == ((h % 1) as u16);
        assert hw_mod16(h as u16, 3) == ((h % 3) as u16);
        assert hw_mod16(h as u16, 5) == ((h % 5) as u16);
        assert hw_mod16(h as u16, 9) == ((h % 9) as u16);
        assert hw_mod16(h as u16, 17) == ((h % 17) as u16);
        assert hw_mod16(h as u16, 33) == ((h % 33) as u16);
        assert hw_mod16(h as u16, 61) == ((h % 61) as u16);
        assert hw_mod16(h as u16, 13108) == ((h % 13108) as u16);
        h = h + 1;
    }
    // the card's own pinned seconds
    assert hw_jittered_seconds(300, 1) == 240;
    assert hw_jittered_seconds(300, 61) == 292;
}

test the_serial_jitter_is_the_cards_second {
    // 48 steps, the engine's schedule, against the card: every backoff wait for 4096 pseudo-random
    // seeds, and the card's pinned seconds
    var x : u64 = 5;
    var k : u32 = 0;
    while (k < 4096) {
        var seed : u32 = (x >> 17) as u32;
        var streak : u32 = 0;
        while (streak < 7) {
            var wait : u32 = backoff_seconds(streak);
            assert hw_jittered_seconds_serial(wait as u16, seed) == jittered_seconds(wait, seed as u64);
            streak = streak + 1;
        }
        assert hw_jittered_seconds_serial((x & 65535) as u16, seed) == jittered_seconds((x & 65535) as u32, seed as u64);
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        k = k + 1;
    }
    assert hw_jittered_seconds_serial(300, 1) == 240;
    assert hw_jittered_seconds_serial(300, 61) == 292;
    assert hw_jittered_seconds_serial(0, 7) == 0;
}

test the_queens_tree_and_turns_are_bit_exact {
    var a : u32 = 0;
    while (a < 256) {
        assert hw_root_children(a as u8) == root_children(a);
        assert hw_queen_restart_type(a as u8) == queen_restart_type(a as u8);
        assert hw_queen_shutdown_ms(a as u8) == queen_shutdown_ms(a as u8);
        assert hw_lane_of(a as u8) == lane_of(a);
        assert hw_kill_effect(a as u8) == kill_effect(a as u8);
        assert hw_holds_after_kill(a as u8, true) == holds_after_kill(a as u8, true);
        assert hw_holds_after_kill(a as u8, false) == holds_after_kill(a as u8, false);
        var b : u32 = 0;
        while (b < 256) {
            assert hw_root_child_kind(a as u8, b as u8) == root_child_kind(a, b);
            b = b + 1;
        }
        a = a + 1;
    }
    // every u16 turn age against the default bound, the reviewer's and the edges
    var age : u32 = 0;
    while (age < 65536) {
        assert hw_hung_turn_signal(age as u16) == hung_turn_signal(age);
        assert hw_turn_signal(age as u16, 0) == turn_signal(age, 0);
        assert hw_turn_signal(age as u16, 300) == turn_signal(age, 300);
        assert hw_turn_signal(age as u16, 65535) == turn_signal(age, 65535);
        assert hw_turn_signal(300, age as u16) == turn_signal(300, age);
        assert hw_node_up(age as u16) == node_up(age);
        assert hw_refusal_gives_up(age as u16) == refusal_gives_up(age);
        assert hw_edit_still_holds(false, true, age as u16) == edit_still_holds(false, true, age);
        assert hw_stops_inside_the_lease(30000, age as u16) == stops_inside_the_lease(30000, age);
        assert hw_stops_inside_the_lease(age * 1000, 180) == stops_inside_the_lease(age * 1000, 180);
        assert hw_stops_inside_the_lease((age * 1000) + 999, age as u16) == stops_inside_the_lease((age * 1000) + 999, age);
        age = age + 1;
    }
    // reclaim: every reason byte, renewals and ttls of 0..255 and the u16 top
    var re : u32 = 0;
    while (re < 256) {
        var since : u32 = 0;
        while (since < 256) {
            assert hw_reclaim_wait_seconds(re as u8, since as u16, 180) == reclaim_wait_seconds(re as u8, since, 180);
            assert hw_reclaim_wait_seconds(re as u8, 30, since as u16) == reclaim_wait_seconds(re as u8, 30, since);
            assert hw_reclaim_wait_seconds(re as u8, since as u16, 65535) == reclaim_wait_seconds(re as u8, since, 65535);
            since = since + 1;
        }
        re = re + 1;
    }
    // slices: every turn count, microseconds 0..65535 in steps of 7 and the edges
    var tn : u32 = 0;
    while (tn < 256) {
        var us : u32 = 0;
        while (us < 65536) {
            assert hw_slice_spent(tn as u8, us as u16) == slice_spent(tn, us);
            us = us + 7;
        }
        assert hw_slice_spent(tn as u8, 4999) == slice_spent(tn, 4999);
        assert hw_slice_spent(tn as u8, 5000) == slice_spent(tn, 5000);
        tn = tn + 1;
    }
    var f : u32 = 0;
    while (f < 8) {
        assert hw_turn_isolation((f & 1) == 1, (f & 2) == 2, (f & 4) == 4) == turn_isolation((f & 1) == 1, (f & 2) == 2, (f & 4) == 4);
        f = f + 1;
    }
}

test nodes_are_bit_exact {
    // every node id 0..4099 with local slot edges and generations, then 4096 pseudo-random pids
    var n : u32 = 0;
    while (n < 4100) {
        assert hw_node_pid(n as u16, 1, 7) == node_pid(n, 1, 7);
        assert hw_node_pid(n as u16, 0, 7) == node_pid(n, 0, 7);
        assert hw_node_pid(n as u16, 1048575, 4294967295) == node_pid(n, 1048575, 4294967295);
        assert hw_node_pid(n as u16, 1048576, 1) == node_pid(n, 1048576, 1);
        assert hw_is_remote(hw_node_pid(n as u16, 5, 7), 3) == is_remote(node_pid(n, 5, 7), 3);
        assert hw_is_remote(node_pid(3, 5, 7), n as u16) == is_remote(node_pid(3, 5, 7), n);
        n = n + 1;
    }
    assert hw_node_pid(65535, 5, 7) == node_pid(65535, 5, 7);
    assert hw_node_pid(3, 4294967295, 7) == node_pid(3, 4294967295, 7);
    var x : u64 = 9;
    var k : u32 = 0;
    while (k < 4096) {
        assert hw_node_of(x) == node_of(x);
        assert hw_local_of(x) == local_of(x);
        assert hw_is_remote(x, (x >> 52) as u16) == is_remote(x, x >> 52);
        assert hw_is_remote(x, ((x >> 52) + 1) as u16) == is_remote(x, (x >> 52) + 1);
        assert hw_node_pid(((x >> 20) & 4095) as u16, (x & 1048575) as u32, (x >> 32) as u32) == node_pid((x >> 20) & 4095, x & 1048575, x >> 32);
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        k = k + 1;
    }
    assert hw_is_remote(0, 4) == is_remote(0, 4);
    // node liveness, the sender's half, the monitor's half
    var f : u32 = 0;
    while (f < 4) {
        var up : bool = (f & 1) == 1;
        var ended : bool = (f & 2) == 2;
        assert hw_send_remote(up) == send_remote(up);
        var r : u32 = 0;
        while (r < 256) {
            assert hw_remote_down(up, ended, r as u8) == remote_down(up, ended, r as u8);
            r = r + 1;
        }
        f = f + 1;
    }
    // placement: free room 0..63 squared, node ids 0..7 squared, and the top
    var fa : u32 = 0;
    while (fa < 64) {
        var fb : u32 = 0;
        while (fb < 64) {
            var na : u32 = 0;
            while (na < 8) {
                var nb : u32 = 0;
                while (nb < 8) {
                    assert hw_place_before(fa, na as u16, fb, nb as u16) == place_before(fa, na, fb, nb);
                    nb = nb + 1;
                }
                na = na + 1;
            }
            fb = fb + 1;
        }
        fa = fa + 1;
    }
    assert hw_place_before(1048575, 4095, 1048575, 4094) == place_before(1048575, 4095, 1048575, 4094);
    assert hw_place_before(4294967295, 0, 4294967294, 0) == place_before(4294967295, 0, 4294967294, 0);
}

test file_owners_are_bit_exact {
    var x : u64 = 13;
    var k : u32 = 0;
    while (k < 4096) {
        assert hw_file_owner_slot(x) == file_owner_slot(x);
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        k = k + 1;
    }
    assert hw_file_owner_slot(0) == file_owner_slot(0);
    assert hw_file_owner_slot(18446744073709551615) == file_owner_slot(18446744073709551615);
    // edits: kinds 0..3 on both sides, every range with ends in 0..11 on both sides
    var ak : u32 = 0;
    while (ak < 4) {
        var bk : u32 = 0;
        while (bk < 4) {
            var sa : u32 = 0;
            while (sa < 12) {
                var ae : u32 = 0;
                while (ae < 12) {
                    var bs : u32 = 0;
                    while (bs < 12) {
                        var be : u32 = 0;
                        while (be < 12) {
                            assert hw_edits_meet(ak as u8, sa, ae, bk as u8, bs, be) == edits_meet(ak as u8, sa, ae, bk as u8, bs, be);
                            be = be + 1;
                        }
                        bs = bs + 1;
                    }
                    ae = ae + 1;
                }
                sa = sa + 1;
            }
            bk = bk + 1;
        }
        ak = ak + 1;
    }
    assert hw_edits_meet(1, 0, 10, 1, 20, 4294967295) == edits_meet(1, 0, 10, 1, 20, 4294967295);
    assert hw_edits_meet(1, 4294967294, 4294967295, 1, 0, 4294967294) == edits_meet(1, 4294967294, 4294967295, 1, 0, 4294967294);
    // the owner's answer: every queue of the mailbox test's shapes, waits around the bound
    var q : u64 = 0;
    while (q < 6561) {
        var box : u64 = 0;
        var rest : u64 = q;
        var slot : u64 = 0;
        while (slot < 8) {
            box = box | ((rest % 3) << (slot * 8));
            rest = rest / 3;
            slot = slot + 1;
        }
        var f : u32 = 0;
        while (f < 4) {
            var run : bool = (f & 1) == 1;
            var qd : bool = (f & 2) == 2;
            assert hw_file_admit(run, qd, box, 0) == file_admit(run, qd, box, 0);
            assert hw_file_admit(run, qd, box, 7199) == file_admit(run, qd, box, 7199);
            assert hw_file_admit(run, qd, box, 7200) == file_admit(run, qd, box, 7200);
            f = f + 1;
        }
        q = q + 1;
    }
    var a : u32 = 0;
    while (a < 256) {
        assert hw_takes_a_lane(a as u8) == takes_a_lane(a as u8);
        a = a + 1;
    }
    assert hw_edit_still_holds(true, true, 65535) == edit_still_holds(true, true, 4000000000);
    assert hw_edit_still_holds(true, false, 0) == edit_still_holds(true, false, 0);
}

test a_saturated_age_decides_as_the_true_one {
    // a board passes hw_saturate_seconds(age); past 65535 every decision is the card's on the true age
    var ages : u64 = 65530;
    while (ages < 4294967296) {
        var t : u32 = ages as u32;
        var s : u16 = hw_saturate_seconds(t);
        assert hw_in_period(s, 300) == in_period(t, 300);
        assert hw_in_period(s, 65535) == in_period(t, 65535);
        assert hw_turn_signal(s, 0) == turn_signal(t, 0);
        assert hw_turn_signal(s, 65535) == turn_signal(t, 65535);
        assert hw_node_up(s) == node_up(t);
        assert hw_unstable_streak(3, s) == unstable_streak(3, t);
        assert hw_reclaim_wait_seconds(HW_X_NONE, s, 180) == reclaim_wait_seconds(X_NONE, t, 180);
        assert hw_refusal_gives_up(s) == refusal_gives_up(t);
        assert hw_edit_still_holds(false, true, s) == edit_still_holds(false, true, t);
        assert hw_file_admit(true, false, 0, s) == file_admit(true, false, 0, t);
        assert hw_slice_spent(0, s) == slice_spent(0, t);
        ages = (ages * 3) / 2 + 1;
    }
    assert hw_saturate_seconds(65535) == 65535;
    assert hw_saturate_seconds(65536) == 65535;
    assert hw_saturate_seconds(7200) == 7200;
}

test the_engine_decides_as_the_card {
    // 1024 operand sets from a 64-bit LCG, half of them small (codes 0..7, seconds 0..1023) and half
    // of the boxes and lanes sparse; every operation on each, its register against the card
    // (every var is declared before the loop, so the test also lowers to a Verilog testbench)
    var x : u64 = 21;
    var n : u32 = 0;
    var y : u64 = 0;
    var a : u64 = 0;
    var b : u64 = 0;
    var c : u32 = 0;
    var d : u32 = 0;
    var e : u16 = 0;
    var f : u16 = 0;
    var g : u8 = 0;
    var h : u8 = 0;
    var k0 : bool = false;
    var k1 : bool = false;
    var k2 : bool = false;
    while (n < 1024) {
        y = (x *% 6364136223846793005) +% 1442695040888963407;
        a = x;
        if ((n & 1) == 1) { a = x & (x >> 9) & (x >> 23); }
        b = y;
        if ((n & 6) == 0) { b = a; }
        c = y as u32;
        d = (y >> 32) as u32;
        e = ((y >> 13) & 65535) as u16;
        f = ((y >> 29) & 65535) as u16;
        g = ((x >> 40) & 255) as u8;
        h = ((x >> 48) & 255) as u8;
        if ((n & 2) == 2) {
            c = c & 1023;
            d = d & 1023;
            e = e & 1023;
            f = f & 1023;
            g = g & 7;
            h = h & 7;
        }
        k0 = ((n >> 2) & 1) == 1;
        k1 = ((n >> 3) & 1) == 1;
        k2 = ((n >> 4) & 1) == 1;
        on_clock(HW_OP_PID_OF, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_wide == pid_of(c, d);
        on_clock(HW_OP_MBOX_PUSH, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_wide == mbox_push(a, g);
        on_clock(HW_OP_MBOX_REMOVE, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_wide == mbox_remove(a, g);
        on_clock(HW_OP_RECEIVE, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_wide == receive(a, g);
        on_clock(HW_OP_CTL_POST, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_wide == ctl_post(a, g);
        on_clock(HW_OP_CTL_TAKE, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_wide == ctl_take(a);
        on_clock(HW_OP_LIVE_ALIAS, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_wide == live_alias(a, g);
        on_clock(HW_OP_CHAIN_ADD, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_wide == chain_add(a, c);
        on_clock(HW_OP_NODE_PID, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_wide == node_pid(e, c, d);
        on_clock(HW_OP_SLOT_OF, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_word == slot_of(a);
        on_clock(HW_OP_GEN_OF, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_word == gen_of(a);
        on_clock(HW_OP_NEXT_GEN, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_word == next_gen(c);
        on_clock(HW_OP_QUEEN_SHUTDOWN_MS, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_word == queen_shutdown_ms(g);
        on_clock(HW_OP_LOCAL_OF, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_word == local_of(a);
        on_clock(HW_OP_FILE_OWNER_SLOT, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_word == file_owner_slot(a);
        on_clock(HW_OP_LINKS_AFTER_LINK, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_half == links_after_link(k0, g);
        on_clock(HW_OP_MONITORS_AFTER_MONITOR, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_half == monitors_after_monitor(g);
        on_clock(HW_OP_UNSTABLE_STREAK, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_half == unstable_streak(g, e);
        on_clock(HW_OP_BACKOFF_SECONDS, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_half == backoff_seconds(g);
        on_clock(HW_OP_ROOT_CHILDREN, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_half == root_children(g);
        on_clock(HW_OP_RECLAIM_WAIT_SECONDS, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_half == reclaim_wait_seconds(g, e, f);
        on_clock(HW_OP_NODE_OF, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_half == node_of(a);
        on_clock(HW_OP_REACHES, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(reaches(a, b));
        on_clock(HW_OP_DELIVER, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == deliver(k0, e, f);
        on_clock(HW_OP_ORDERED, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(ordered(k0, k1));
        on_clock(HW_OP_MBOX_TAG, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == mbox_tag(a, g);
        on_clock(HW_OP_MBOX_LEN, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == mbox_len(a);
        on_clock(HW_OP_MBOX_FIND, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == mbox_find(a, g);
        on_clock(HW_OP_RECEIVE_OUTCOME, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == receive_outcome(k0, c, d);
        on_clock(HW_OP_DELIVER_CONTROL, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == deliver_control(k0, k1);
        on_clock(HW_OP_IS_DEAD_LETTER, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(is_dead_letter(g));
        on_clock(HW_OP_NEXT_LANE, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == next_lane(k0, k1);
        on_clock(HW_OP_CTL_PENDING, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(ctl_pending(a, g));
        on_clock(HW_OP_CTL_NEXT, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == ctl_next(a);
        on_clock(HW_OP_CALL_OUTCOME, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == call_outcome(k0, k1, c, d);
        on_clock(HW_OP_CHAIN_HAS, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(chain_has(a, c));
        on_clock(HW_OP_CALL_ADMIT, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == call_admit(a, g, c);
        on_clock(HW_OP_ON_EXIT_SIGNAL, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == on_exit_signal(g, k0);
        on_clock(HW_OP_DEATH_REASON, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == death_reason(g);
        on_clock(HW_OP_ATTACH_ANSWER, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == attach_answer(k0);
        on_clock(HW_OP_DOWN_LEFT_AFTER_DEMONITOR, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(down_left_after_demonitor(k0, k1));
        on_clock(HW_OP_SHOULD_RESTART, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(should_restart(g, h));
        on_clock(HW_OP_AFFECTED, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(affected(g, h, e & 255));
        on_clock(HW_OP_STOPPED_BY_RESTART, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(stopped_by_restart(g, h, e & 255, k0));
        on_clock(HW_OP_RESTARTED, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(restarted(g, h, e & 255, f as u8, k0));
        on_clock(HW_OP_STOP_RANK, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == stop_rank(g, h);
        on_clock(HW_OP_IN_PERIOD, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(in_period(e, f));
        on_clock(HW_OP_INTENSITY_EXCEEDED, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(intensity_exceeded(g, h));
        on_clock(HW_OP_ON_CHILD_EXIT, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == on_child_exit(g, h, e & 255, f & 255);
        on_clock(HW_OP_WITH_BACKOFF, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == with_backoff(g, h);
        on_clock(HW_OP_STOP_SIGNAL, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == stop_signal(c, d);
        on_clock(HW_OP_CHILD_SPEC_VALID, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(child_spec_valid(g, k0, h));
        on_clock(HW_OP_AUTO_SHUTDOWN_AFTER_EXIT, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(auto_shutdown_after_exit(g, k0, h, e as u8, k1, f & 255));
        on_clock(HW_OP_AUTO_SHUTDOWN_STICKS, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(auto_shutdown_sticks(g));
        on_clock(HW_OP_START_ANSWER, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == start_answer(g, h, e & 255);
        // children_after_exit's domain: a child that is not restarted leaves one counted
        if (g >= 1 or k0) {
            on_clock(HW_OP_CHILDREN_AFTER_EXIT, a, b, c, d, e, f, g, h, k0, k1, k2);
            assert eng_byte == children_after_exit(g, k0);
        }
        on_clock(HW_OP_ROOT_CHILD_KIND, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == root_child_kind(g, h);
        on_clock(HW_OP_QUEEN_RESTART_TYPE, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == queen_restart_type(g);
        on_clock(HW_OP_STOPS_INSIDE_THE_LEASE, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(stops_inside_the_lease(c, e));
        on_clock(HW_OP_LANE_OF, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == lane_of(g);
        on_clock(HW_OP_HUNG_TURN_SIGNAL, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hung_turn_signal(e);
        on_clock(HW_OP_TURN_SIGNAL, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == turn_signal(e, f);
        on_clock(HW_OP_SLICE_SPENT, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(slice_spent(g, e));
        on_clock(HW_OP_TURN_ISOLATION, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == turn_isolation(k0, k1, k2);
        on_clock(HW_OP_KILL_EFFECT, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == kill_effect(g);
        on_clock(HW_OP_HOLDS_AFTER_KILL, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(holds_after_kill(g, k0));
        on_clock(HW_OP_IS_REMOTE, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(is_remote(a, e));
        on_clock(HW_OP_NODE_UP, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(node_up(e));
        on_clock(HW_OP_SEND_REMOTE, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == send_remote(k0);
        on_clock(HW_OP_REMOTE_DOWN, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == remote_down(k0, k1, g);
        on_clock(HW_OP_PLACE_BEFORE, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(place_before(c, e, d, f));
        on_clock(HW_OP_EDITS_MEET, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(edits_meet(g, c, d, h, a as u32, b as u32));
        on_clock(HW_OP_FILE_ADMIT, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == file_admit(k0, k1, a, e);
        on_clock(HW_OP_REFUSAL_GIVES_UP, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(refusal_gives_up(e));
        on_clock(HW_OP_TAKES_A_LANE, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(takes_a_lane(g));
        on_clock(HW_OP_EDIT_STILL_HOLDS, a, b, c, d, e, f, g, h, k0, k1, k2);
        assert eng_byte == hw_byte_of(edit_still_holds(k0, k1, e));
        x = y;
        n = n + 1;
    }
    // an operation code that names no decision changes no register
    a = eng_wide;
    g = eng_byte;
    on_clock(0, 1, 2, 3, 4, 5, 6, 7, 8, false, false, false);
    on_clock(200, 1, 2, 3, 4, 5, 6, 7, 8, false, false, false);
    assert eng_wide == a;
    assert eng_byte == g;
    assert jit_busy == false;
}

test the_jitter_unit_gives_the_cards_second_after_48_cycles {
    // 512 waits and seeds: half from the backoff table, half any u16 wait. A decision runs in each of
    // the 48 cycles and does not disturb the unit.
    var x : u64 = 17;
    var n : u32 = 0;
    var seed : u32 = 0;
    var wait : u16 = 0;
    var cycle : u8 = 0;
    var i : u8 = 0;
    while (n < 512) {
        seed = (x >> 13) as u32;
        wait = hw_backoff_seconds((n & 7) as u8);
        if ((n & 8) == 8) { wait = ((x >> 45) & 65535) as u16; }
        on_clock(HW_OP_JITTER, 0, 0, seed, 0, wait, 0, 0, 0, false, false, false);
        assert jit_busy == true;
        cycle = 1;
        while (cycle < HW_JITTER_CYCLES) {
            on_clock(HW_OP_MBOX_LEN, x, 0, 0, 0, 0, 0, 0, 0, false, false, false);
            assert jit_busy == true;
            assert eng_byte == mbox_len(x);
            cycle = cycle + 1;
        }
        on_clock(0, 0, 0, 0, 0, 0, 0, 0, 0, false, false, false);
        assert jit_busy == false;
        assert jit_out == jittered_seconds(wait, seed);
        // an idle cycle keeps the answer
        on_clock(0, 0, 0, 0, 0, 0, 0, 0, 0, false, false, false);
        assert jit_out == jittered_seconds(wait, seed);
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        n = n + 1;
    }
    // a second start mid-run restarts the unit; the card's pinned seconds come out of it
    on_clock(HW_OP_JITTER, 0, 0, 61, 0, 300, 0, 0, 0, false, false, false);
    i = 0;
    while (i < 20) {
        on_clock(0, 0, 0, 0, 0, 0, 0, 0, 0, false, false, false);
        i = i + 1;
    }
    on_clock(HW_OP_JITTER, 0, 0, 1, 0, 300, 0, 0, 0, false, false, false);
    i = 0;
    while (i < HW_JITTER_CYCLES) {
        on_clock(0, 0, 0, 0, 0, 0, 0, 0, 0, false, false, false);
        i = i + 1;
    }
    assert jit_busy == false;
    assert jit_out == 240;
    on_clock(HW_OP_JITTER, 0, 0, 61, 0, 300, 0, 0, 0, false, false, false);
    i = 0;
    while (i < HW_JITTER_CYCLES) {
        on_clock(0, 0, 0, 0, 0, 0, 0, 0, 0, false, false, false);
        i = i + 1;
    }
    assert jit_out == 292;
}
