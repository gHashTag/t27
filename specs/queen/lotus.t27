// SPDX-License-Identifier: Apache-2.0
; t27 queen, Lotus: the orchestration policy the Queen runs every tick.
; ----
; Lotus decides, per tick, whether the swarm proceeds, retries, or is stuck.
; It keeps to pure functions: every decision takes its inputs as arguments
; and returns a value a test can check with concrete values, so t27b has a
; reference to compare against.

module QueenLotus;

; Verdicts a tick can return.
pub const LOTUS_OK : i64 = 0;
pub const LOTUS_DONE : i64 = 1;
pub const LOTUS_RETRY : i64 = 2;
pub const LOTUS_STUCK : i64 = 3;

; Parameter deltas a worker may request.
pub const DELTA_SET : i64 = 1;
pub const DELTA_ADD : i64 = 2;

; Failure-review verdicts.
pub const FAILURE_CONTINUE : i64 = 0;
pub const FAILURE_WATCH : i64 = 1;
pub const FAILURE_ESCALATE : i64 = 2;

; Swarm bounds and limits.
pub const MIN_WORKERS : i64 = 2;
pub const MAX_WORKERS : i64 = 12;
pub const STUCK_TICKS_LIMIT : i64 = 50;
pub const POLICY_MIN : i64 = -1000;
pub const POLICY_MAX : i64 = 1000;
pub const POLICY_RESOURCE_MAX : i64 = 64;

; Parameters a worker may tune: set a policy value outright, or add to it.
pub struct Plan {
    delta_type: i64,
    target_resource: i64,
    target_value: i64,
}

; The result of one orchestration round.
pub struct PhaseOutput {
    success: bool,
    value: i64,
}

; A friendly constructor for Plan.
pub fn make_plan(delta_type: i64, target_resource: i64, target_value: i64) -> Plan {
    return Plan{.delta_type = delta_type, .target_resource = target_resource, .target_value = target_value};
}

; Absolute value of an i64.
pub fn abs_i64(v: i64) -> i64 {
    if (v < 0) {
        return 0 - v;
    }
    return v;
}

; Clamp v into [lo, hi].
pub fn clamp_i64(v: i64, lo: i64, hi: i64) -> i64 {
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
}

; A plan is valid when its delta type is known and its resource
; targets a policy slot in [1, POLICY_RESOURCE_MAX].
pub fn plan_is_valid(plan: Plan) -> bool {
    if (plan.delta_type == DELTA_SET) {
        if (plan.target_resource >= 1 and plan.target_resource <= POLICY_RESOURCE_MAX) {
            return true;
        }
        return false;
    }
    if (plan.delta_type == DELTA_ADD) {
        if (plan.target_resource >= 1 and plan.target_resource <= POLICY_RESOURCE_MAX) {
            return true;
        }
        return false;
    }
    return false;
}

; Apply a plan to a policy value and return the new value.
; An invalid plan leaves the current value unchanged.
pub fn set_parameter(current: i64, plan: Plan) -> i64 {
    if (plan_is_valid(plan) == false) {
        return current;
    }
    var next : i64 = current;
    if (plan.delta_type == DELTA_SET) {
        next = plan.target_value;
    }
    if (plan.delta_type == DELTA_ADD) {
        next = current + plan.target_value;
    }
    return clamp_i64(next, POLICY_MIN, POLICY_MAX);
}

; Spawn gate: a spawn is allowed inside the worker bounds.
pub fn lotus_spawn(workers: i64) -> bool {
    if (workers < MIN_WORKERS) {
        return false;
    }
    if (workers > MAX_WORKERS) {
        return false;
    }
    return true;
}

; Scale up toward MAX_WORKERS as load rises.
pub fn scale_up_resources(current: i64, load: i64) -> i64 {
    var step : i64 = 0;
    if (load > 80) {
        step = 2;
    }
    if (load > 60 and step == 0) {
        step = 1;
    }
    return clamp_i64(current + step, MIN_WORKERS, MAX_WORKERS);
}

; Scale down toward MIN_WORKERS as load falls.
pub fn scale_down_resources(current: i64, load: i64) -> i64 {
    var step : i64 = 0;
    if (load < 20) {
        step = 2;
    }
    if (load < 40 and step == 0) {
        step = 1;
    }
    return clamp_i64(current - step, MIN_WORKERS, MAX_WORKERS);
}

; One orchestration round: run the given number of phases, each worth
; four units of progress, and report success with the value reached.
pub fn orchestrate(phases: i64) -> PhaseOutput {
    var done : i64 = 0;
    var value : i64 = 0;
    while (done < phases) {
        value = value + 4;
        done = done + 1;
    }
    var ok : bool = false;
    if (done == phases) {
        ok = true;
    }
    return PhaseOutput{.success = ok, .value = value};
}

; Gate review: many holds stick the round, a few ask for a retry.
pub fn review_gate(holds: i64, failed: i64) -> i64 {
    if (holds > 3) {
        return LOTUS_STUCK;
    }
    if (holds > 0 or failed > 0) {
        return LOTUS_RETRY;
    }
    return LOTUS_OK;
}

; Bee review: the roster matches, falls short, or overflows.
pub fn review_bees(active: i64, wanted: i64) -> i64 {
    if (active == wanted) {
        return LOTUS_OK;
    }
    if (active < wanted) {
        return LOTUS_RETRY;
    }
    return LOTUS_STUCK;
}

; Hold review: the gate is clear when nothing is held, or when the
; closed count is past recovery.
pub fn review_holds(open: i64, closed: i64) -> bool {
    if (open == 0) {
        return true;
    }
    if (closed > 3) {
        return true;
    }
    return false;
}

; Failure review: escalate above 40 percent of a real sample,
; watch above 10 percent, continue otherwise. Samples under 5
; runs are too small to judge, so they continue.
pub fn review_failures(failed: i64, total: i64) -> i64 {
    if (total < 5) {
        return FAILURE_CONTINUE;
    }
    if (failed * 100 > total * 40) {
        return FAILURE_ESCALATE;
    }
    if (failed * 100 > total * 10) {
        return FAILURE_WATCH;
    }
    return FAILURE_CONTINUE;
}

; A round stuck for STUCK_TICKS_LIMIT ticks escalates.
pub fn escalate_stuck(stuck: i64) -> bool {
    if (stuck >= STUCK_TICKS_LIMIT) {
        return true;
    }
    return false;
}

; Absorb experience from finished cases, saturating at 255.
pub fn absorb_experience(cases: i64, learned: i64) -> i64 {
    return clamp_i64(cases + learned, 0, 255);
}

; Record a wave of completions against the backlog, floored at zero.
pub fn record_wave(backlog: i64, done: i64) -> i64 {
    if (done >= backlog) {
        return 0;
    }
    return backlog - done;
}

; One scheduler tick: done, retrying, or stuck.
pub fn lotus_tick(completed: i64, total: i64) -> i64 {
    if (completed == total) {
        return LOTUS_DONE;
    }
    if (completed > total) {
        return LOTUS_STUCK;
    }
    return LOTUS_RETRY;
}

; Reset the policy state to its seed, clamped into a byte.
pub fn reset_state(seed: i64) -> i64 {
    return clamp_i64(seed, 0, 255);
}

test clamp_and_abs {
    assert clamp_i64(150, 0, 100) == 100;
    assert clamp_i64(-5, 0, 100) == 0;
    assert clamp_i64(37, 0, 100) == 37;
    assert abs_i64(-9) == 9;
    assert abs_i64(9) == 9;
}

test spawn_gate {
    assert lotus_spawn(4) == true;
    assert lotus_spawn(1) == false;
    assert lotus_spawn(13) == false;
}

test plan_validation {
    assert plan_is_valid(make_plan(DELTA_SET, 5, 42)) == true;
    assert plan_is_valid(make_plan(DELTA_ADD, 64, 1)) == true;
    assert plan_is_valid(make_plan(7, 5, 42)) == false;
    assert plan_is_valid(make_plan(DELTA_SET, 0, 42)) == false;
    assert plan_is_valid(make_plan(DELTA_ADD, 65, 42)) == false;
}

test set_parameter_set_and_add {
    assert set_parameter(0, make_plan(DELTA_SET, 5, 42)) == 42;
    assert set_parameter(40, make_plan(DELTA_ADD, 5, 2)) == 42;
    assert set_parameter(5000, make_plan(DELTA_SET, 5, 9000)) == 1000;
    assert set_parameter(7, make_plan(7, 5, 42)) == 7;
}

test scaling {
    assert scale_up_resources(10, 90) == 12;
    assert scale_up_resources(10, 70) == 11;
    assert scale_up_resources(10, 50) == 10;
    assert scale_up_resources(11, 90) == 12;
    assert scale_down_resources(10, 10) == 8;
    assert scale_down_resources(10, 30) == 9;
    assert scale_down_resources(10, 50) == 10;
    assert scale_down_resources(3, 10) == 2;
}

test orchestrate_round {
    var out : PhaseOutput = orchestrate(4);
    assert out.success == true;
    assert out.value == 16;
    assert orchestrate(0).value == 0;
    assert orchestrate(0).success == true;
    assert orchestrate(2).value == 8;
}

test gate_review {
    assert review_gate(0, 0) == LOTUS_OK;
    assert review_gate(1, 0) == LOTUS_RETRY;
    assert review_gate(2, 1) == LOTUS_RETRY;
    assert review_gate(4, 0) == LOTUS_STUCK;
}

test bee_review {
    assert review_bees(5, 5) == LOTUS_OK;
    assert review_bees(4, 5) == LOTUS_RETRY;
    assert review_bees(6, 5) == LOTUS_STUCK;
}

test holds_review {
    assert review_holds(0, 0) == true;
    assert review_holds(2, 4) == true;
    assert review_holds(2, 1) == false;
}

test failure_review {
    assert review_failures(3, 5) == FAILURE_ESCALATE;
    assert review_failures(1, 5) == FAILURE_WATCH;
    assert review_failures(0, 5) == FAILURE_CONTINUE;
    assert review_failures(4, 4) == FAILURE_CONTINUE;
    assert review_failures(2, 10) == FAILURE_WATCH;
}

test stuck_escalation {
    assert escalate_stuck(50) == true;
    assert escalate_stuck(49) == false;
    assert escalate_stuck(51) == true;
}

test experience_and_waves {
    assert absorb_experience(250, 10) == 255;
    assert absorb_experience(200, 20) == 220;
    assert record_wave(10, 4) == 6;
    assert record_wave(10, 10) == 0;
    assert record_wave(10, 12) == 0;
}

test tick_states {
    assert lotus_tick(5, 5) == LOTUS_DONE;
    assert lotus_tick(3, 5) == LOTUS_RETRY;
    assert lotus_tick(6, 5) == LOTUS_STUCK;
}

test reset_seeds_policy {
    assert reset_state(9) == 9;
    assert reset_state(300) == 255;
}
