; --- 1. The input ----------------------------------------------------------------------------------

pub const VIEW_ACTORS : u32 = 8;
pub const VIEW_EVENTS : u32 = 32;
pub const VIEW_FEED : u32 = 8;

/// "No row", "no lane" and "no event": one past the last index of their table.
pub const NO_ROW : u32 = 8;
pub const NO_LANE : u32 = 8;
pub const NO_EVENT : u32 = 32;

/// The reason an exit of a class stands for, for actors.t27's restart rules: the class keeps every
/// answer should_restart gives (tested below). REASON_CLASSES, "no class", stands for a crash.
pub fn class_reason(rc: u8) -> u8 {
    if (rc == RC_NORMAL) { return X_NORMAL; }
    if (rc == RC_SHUTDOWN) { return X_SHUTDOWN; }
    return X_CRASH;
}

/// One u64 names a task: tasks.t27's kind (bits 60..61), the caller's repository index (bits
/// 48..59) and the issue number or job id (bits 0..47). 0 is no task. Strings stay the caller's,
/// as tasks.t27 says of repository and text.
pub const NO_TASK_KEY : u64 = 0;
pub const KEY_NUM_MASK : u64 = 281474976710655;
pub const KEY_REPO_MASK : u64 = 4095;

pub fn task_key(kind: u8, repo: u32, num: u64) -> u64 {
    if (num == 0) { return NO_TASK_KEY; }
    if (num > KEY_NUM_MASK) { return NO_TASK_KEY; }
    if (kind >= TASK_KINDS) { return NO_TASK_KEY; }
    if ((repo as u64) > KEY_REPO_MASK) { return NO_TASK_KEY; }
    return ((kind as u64) << 60) | ((repo as u64) << 48) | num;
}

pub fn key_kind(key: u64) -> u8 {
    return (key >> 60) as u8;
}

pub fn key_repo(key: u64) -> u32 {
    return ((key >> 48) & KEY_REPO_MASK) as u32;
}

pub fn key_num(key: u64) -> u64 {
    return key & KEY_NUM_MASK;
}

/// A message event: a deliver written one by one or a pair's count.
pub fn is_message(kind: u8) -> bool {
    return kind == EV_ACTOR_DELIVER or kind == EV_ACTOR_DELIVERS;
}

/// A message event the view accepts: drops are among the sends, no mailbox was deeper than its cap,
/// and its message numbers do not end before they start.
pub fn message_valid(count: u32, dropped: u32, depth: u32, first: u64, last: u64) -> bool {
    if (dropped > count) { return false; }
    if (depth > MAILBOX_CAP) { return false; }
    return first <= last;
}

/// What actor_events.t27 promises a reader of one pair: a message event earlier on the bus has
/// lower message numbers than a later one, so the bus keeps the pair's FIFO order, counted or not.
pub fn bus_keeps_fifo(a_seq: u64, a_last: u64, b_seq: u64, b_first: u64) -> bool {
    if (a_seq >= b_seq) { return true; }
    return a_last < b_first;
}

; --- 2. Lanes: the supervision tree, parent first, children by slot ------------------------------

/// The rows that carry a lane: the supervisors, which report a period (OTP's MaxT is at least one
/// second); a worker reports none.
pub fn is_supervisor(period: u32) -> bool {
    return period > 0;
}

/// The row of a slot, or NO_ROW. A row is found by slot, not by pid: a restart keeps the slot and
/// takes the next generation, so a message to an older incarnation still finds its actor's row.
pub fn row_of_slot(pids: [8]u64, slot: u64) -> u32 {
    if (slot == 0) { return NO_ROW; }
    var i : u32 = 0;
    while (i < VIEW_ACTORS) {
        if (pids[i] != NO_PID and slot_of(pids[i]) == slot) { return i; }
        i = i + 1;
    }
    return NO_ROW;
}

pub fn parent_row(pids: [8]u64, parents: [8]u64, i: u32) -> u32 {
    if (i >= VIEW_ACTORS) { return NO_ROW; }
    if (parents[i] == NO_PID) { return NO_ROW; }
    return row_of_slot(pids, slot_of(parents[i]));
}

/// Ancestors above a row. The walk is bounded by the table, so a cycle cannot hang the board.
pub fn depth_of(pids: [8]u64, parents: [8]u64, i: u32) -> u32 {
    var d : u32 = 0;
    var r : u32 = parent_row(pids, parents, i);
    while (r != NO_ROW and d < VIEW_ACTORS) {
        d = d + 1;
        r = parent_row(pids, parents, r);
    }
    return d;
}

/// The row's ancestor at depth `d` (0 is the top), the row itself at its own depth, NO_ROW below.
pub fn ancestor_at(pids: [8]u64, parents: [8]u64, i: u32, d: u32) -> u32 {
    let own : u32 = depth_of(pids, parents, i);
    if (d > own) { return NO_ROW; }
    var r : u32 = i;
    var up : u32 = own - d;
    while (up > 0) {
        r = parent_row(pids, parents, r);
        up = up - 1;
    }
    return r;
}

/// Depth first, parent before children, siblings by slot: `a` comes first when it is an ancestor
/// of `b`, or when at the first depth where their ancestors differ, a's ancestor has the lower slot.
/// It reads only pids and parents, so the order of the rows in the table changes nothing.
pub fn layout_before(pids: [8]u64, parents: [8]u64, a: u32, b: u32) -> bool {
    if (a == b) { return false; }
    let da : u32 = depth_of(pids, parents, a);
    let db : u32 = depth_of(pids, parents, b);
    var k : u32 = 0;
    while (k <= da and k <= db) {
        let xa : u32 = ancestor_at(pids, parents, a, k);
        let xb : u32 = ancestor_at(pids, parents, b, k);
        if (xa != xb) { return slot_of(pids[xa]) < slot_of(pids[xb]); }
        k = k + 1;
    }
    return da < db;
}

/// The row an actor is drawn on: how many actors come before it.
pub fn layout_row(pids: [8]u64, parents: [8]u64, i: u32) -> u32 {
    if (i >= VIEW_ACTORS) { return NO_ROW; }
    if (pids[i] == NO_PID) { return NO_ROW; }
    var n : u32 = 0;
    var j : u32 = 0;
    while (j < VIEW_ACTORS) {
        if (pids[j] != NO_PID and layout_before(pids, parents, j, i)) { n = n + 1; }
        j = j + 1;
    }
    return n;
}

/// The supervisor whose lane holds a row: the row itself when it supervises, else its nearest
/// supervising ancestor. NO_ROW for an empty row or an orphan whose parent is not in the table.
pub fn lane_head(pids: [8]u64, parents: [8]u64, periods: [8]u32, i: u32) -> u32 {
    if (i >= VIEW_ACTORS) { return NO_ROW; }
    if (pids[i] == NO_PID) { return NO_ROW; }
    var r : u32 = i;
    var steps : u32 = 0;
    while (r != NO_ROW and steps <= VIEW_ACTORS) {
        if (is_supervisor(periods[r])) { return r; }
        r = parent_row(pids, parents, r);
        steps = steps + 1;
    }
    return NO_ROW;
}

/// One lane per supervisor, numbered in layout order, so the root's lane is lane 0.
pub fn lane_index(pids: [8]u64, parents: [8]u64, periods: [8]u32, i: u32) -> u32 {
    let h : u32 = lane_head(pids, parents, periods, i);
    if (h == NO_ROW) { return NO_LANE; }
    var n : u32 = 0;
    var j : u32 = 0;
    while (j < VIEW_ACTORS) {
        if (pids[j] != NO_PID and is_supervisor(periods[j]) and layout_before(pids, parents, j, h)) { n = n + 1; }
        j = j + 1;
    }
    return n;
}

pub fn lane_count(pids: [8]u64, periods: [8]u32) -> u32 {
    var n : u32 = 0;
    var j : u32 = 0;
    while (j < VIEW_ACTORS) {
        if (pids[j] != NO_PID and is_supervisor(periods[j])) { n = n + 1; }
        j = j + 1;
    }
    return n;
}

/// The lane of whatever incarnation of an actor a pid names.
pub fn lane_of_pid(pids: [8]u64, parents: [8]u64, periods: [8]u32, pid: u64) -> u32 {
    return lane_index(pids, parents, periods, row_of_slot(pids, slot_of(pid)));
}

/// The pid of the supervisor whose lane holds the actor a pid names, or NO_PID.
pub fn lane_sup_of_pid(pids: [8]u64, parents: [8]u64, periods: [8]u32, pid: u64) -> u64 {
    let h : u32 = lane_head(pids, parents, periods, row_of_slot(pids, slot_of(pid)));
    if (h == NO_ROW) { return NO_PID; }
    return pids[h];
}

; --- 3. The actor chip -----------------------------------------------------------------------------
; The chip prints its pid as slot_of(pid) "." gen_of(pid), and its kind. The rest is below.

pub const VS_RUNNING : u8 = 0;
pub const VS_RESTARTING : u8 = 1;
pub const VS_DEAD : u8 = 2;
pub const VS_NAMES : [3]str = ["running", "restarting", "dead"];
pub const ACTOR_KIND_NAMES : [4]str = ["intake", "reconciler", "domain", "agent"];

/// The latest spawn, restart or exit of a slot at or before `now`, or NO_EVENT. A spawn or restart
/// names the new incarnation in to_pid; an exit names the one that ended in from_pid.
pub fn last_lifecycle(ev_seq: [32]u64, ev_kind: [32]u8, ev_from: [32]u64, ev_to: [32]u64, slot: u64, now: u64) -> u32 {
    var best : u32 = NO_EVENT;
    var best_seq : u64 = 0;
    var i : u32 = 0;
    while (i < VIEW_EVENTS) {
        let k : u8 = ev_kind[i];
        var hit : bool = false;
        if ((k == EV_ACTOR_SPAWN or k == EV_ACTOR_RESTART) and slot_of(ev_to[i]) == slot) { hit = true; }
        if (k == EV_ACTOR_EXIT and slot_of(ev_from[i]) == slot) { hit = true; }
        if (hit and ev_seq[i] <= now and ev_seq[i] > best_seq) {
            best = i;
            best_seq = ev_seq[i];
        }
        i = i + 1;
    }
    return best;
}

/// What the supervisor does about an exit, as actors.t27 decides it: the child's restart type, the
/// class's reason, and the restarts the supervisor already made in its period.
pub fn exit_decision(kind: u8, rc: u8, used: u32, max_restarts: u32) -> u8 {
    return on_child_exit(queen_restart_type(kind), class_reason(rc), used, max_restarts);
}

/// Running, unless the latest lifecycle event is an exit: then restarting while the supervisor is
/// going to bring it back, dead when it is not (nothing to restart, or the supervisor gave up).
pub fn chip_state(last_kind: u8, kind: u8, rc: u8, used: u32, max_restarts: u32) -> u8 {
    if (last_kind != EV_ACTOR_EXIT) { return VS_RUNNING; }
    if (exit_decision(kind, rc, used, max_restarts) == SUP_RESTART) { return VS_RESTARTING; }
    return VS_DEAD;
}

/// Restarts a supervisor made that still count at `now`: restart events under its slot, at or
/// before `now_seq`, younger than the period (actors.t27 in_period). A child's chip shows this count
/// for its supervisor, against the max_restarts per period_seconds the supervisor reported: the
/// budget is the supervisor's, shared by its children, as in OTP. A restart's restart_count is this
/// count at its own seq.
pub fn restarts_used(ev_seq: [32]u64, ev_at_ms: [32]u32, ev_kind: [32]u8, ev_parent: [32]u64, sup_pid: u64, now_seq: u64, now_ms: u32, period: u32) -> u32 {
    if (sup_pid == NO_PID) { return 0; }
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < VIEW_EVENTS) {
        if (ev_kind[i] == EV_ACTOR_RESTART and ev_seq[i] <= now_seq and ev_at_ms[i] <= now_ms and slot_of(ev_parent[i]) == slot_of(sup_pid)) {
            if (in_period((now_ms - ev_at_ms[i]) / 1000, period)) { n = n + 1; }
        }
        i = i + 1;
    }
    return n;
}

/// A chip's state at `now`, from the table and the events: chip_state over its last lifecycle event
/// and its supervisor's budget at that exit.
pub fn actor_state(pids: [8]u64, parents: [8]u64, kinds: [8]u8, maxes: [8]u32, periods: [8]u32, ev_seq: [32]u64, ev_at_ms: [32]u32, ev_kind: [32]u8, ev_from: [32]u64, ev_to: [32]u64, ev_parent: [32]u64, ev_class: [32]u8, row: u32, now: u64) -> u8 {
    if (row >= VIEW_ACTORS) { return VS_DEAD; }
    let li : u32 = last_lifecycle(ev_seq, ev_kind, ev_from, ev_to, slot_of(pids[row]), now);
    if (li == NO_EVENT) { return VS_RUNNING; }
    let sup : u32 = parent_row(pids, parents, row);
    var sup_pid : u64 = NO_PID;
    var max_r : u32 = 0;
    var period : u32 = 0;
    if (sup != NO_ROW) {
        sup_pid = pids[sup];
        max_r = maxes[sup];
        period = periods[sup];
    }
    let used : u32 = restarts_used(ev_seq, ev_at_ms, ev_kind, ev_parent, sup_pid, ev_seq[li], ev_at_ms[li], period);
    return chip_state(ev_kind[li], kinds[row], ev_class[li], used, max_r);
}

/// The mailbox gauge: the receiver's mailbox right after the latest message event to that exact
/// incarnation at or before `now` (a deliver's depth, a count's max_depth). A restart starts empty.
pub fn mailbox_depth(ev_seq: [32]u64, ev_kind: [32]u8, ev_to: [32]u64, ev_depth: [32]u32, pid: u64, now: u64) -> u32 {
    var d : u32 = 0;
    var best_seq : u64 = 0;
    var i : u32 = 0;
    while (i < VIEW_EVENTS) {
        if (pid != NO_PID and is_message(ev_kind[i]) and ev_to[i] == pid and ev_seq[i] <= now and ev_seq[i] > best_seq) {
            d = ev_depth[i];
            best_seq = ev_seq[i];
        }
        i = i + 1;
    }
    return d;
}

pub fn mailbox_dropped(ev_seq: [32]u64, ev_kind: [32]u8, ev_to: [32]u64, ev_dropped: [32]u32, pid: u64, now: u64) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < VIEW_EVENTS) {
        if (pid != NO_PID and is_message(ev_kind[i]) and ev_to[i] == pid and ev_seq[i] <= now) { n = n + ev_dropped[i]; }
        i = i + 1;
    }
    return n;
}

/// An edge's weight: every message on one (from, to) pair at or before `now`, drops included.
pub fn edge_weight(ev_seq: [32]u64, ev_kind: [32]u8, ev_from: [32]u64, ev_to: [32]u64, ev_count: [32]u32, from: u64, to: u64, now: u64) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < VIEW_EVENTS) {
        if (from != NO_PID and is_message(ev_kind[i]) and ev_from[i] == from and ev_to[i] == to and ev_seq[i] <= now) { n = n + ev_count[i]; }
        i = i + 1;
    }
    return n;
}

/// The verdict actors.t27's deliver() gives the next message to the chip's pid: only a running
/// incarnation is reached, and the gauge is the queue it would join.
pub fn next_verdict(state: u8, depth: u32) -> u8 {
    return deliver(state == VS_RUNNING, depth, MAILBOX_CAP);
}

; --- 4. Cards ----------------------------------------------------------------------------------------

/// The state of a task at `now`, from the tasks route's rows: the latest row for the key at or
/// before `now`, or TASK_STATES when the route has said nothing yet.
pub fn feed_state(fd_seq: [8]u64, fd_key: [8]u64, fd_state: [8]u8, key: u64, now: u64) -> u8 {
    var s : u8 = TASK_STATES;
    var best_seq : u64 = 0;
    var i : u32 = 0;
    while (i < VIEW_FEED) {
        if (key != NO_TASK_KEY and fd_key[i] == key and fd_seq[i] <= now and fd_seq[i] >= best_seq) {
            s = fd_state[i];
            best_seq = fd_seq[i];
        }
        i = i + 1;
    }
    return s;
}

/// A card's column is its task's A2A state, as tasks.t27 maps it. 0 (A2A's unspecified) while the
/// tasks route does not know the task yet.
pub const COLUMN_UNKNOWN : u8 = 0;

pub fn card_column(state: u8) -> u8 {
    if (state >= TASK_STATES) { return COLUMN_UNKNOWN; }
    return a2a_state(state);
}

/// The latest deliver that carried the task at or before `now`, or NO_EVENT (no card yet). Its
/// receiver is where the task is: the card sits in that actor's lane (lane_of_pid of its to_pid).
pub fn card_last_deliver(ev_seq: [32]u64, ev_kind: [32]u8, ev_task: [32]u64, key: u64, now: u64) -> u32 {
    var best : u32 = NO_EVENT;
    var best_seq : u64 = 0;
    var i : u32 = 0;
    while (i < VIEW_EVENTS) {
        if (key != NO_TASK_KEY and ev_kind[i] == EV_ACTOR_DELIVER and ev_task[i] == key and ev_seq[i] <= now and ev_seq[i] > best_seq) {
            best = i;
            best_seq = ev_seq[i];
        }
        i = i + 1;
    }
    return best;
}

; --- 5. The card's timeline --------------------------------------------------------------------------

/// The card an event belongs to: the task a deliver, an exit or a DOWN names (actor_events.t27: an
/// exit and its DOWNs name the task of the turn they cut). A spawn, a restart or a count: none.
pub fn event_card(kind: u8, task: u64) -> u64 {
    if (kind == EV_ACTOR_DELIVER or kind == EV_ACTOR_EXIT or kind == EV_ACTOR_DOWN) { return task; }
    return NO_TASK_KEY;
}

/// Whether the incarnation a message was addressed to had exited before it arrived.
pub fn exited_before(ev_seq: [32]u64, ev_kind: [32]u8, ev_from: [32]u64, pid: u64, seq: u64) -> bool {
    var i : u32 = 0;
    while (i < VIEW_EVENTS) {
        if (pid != NO_PID and ev_kind[i] == EV_ACTOR_EXIT and ev_from[i] == pid and ev_seq[i] < seq) { return true; }
        i = i + 1;
    }
    return false;
}

/// A timeline entry's verdict, as actors.t27's deliver() gives it: the mailbox before the message
/// is its depth after it, less the message itself when it was queued. A message to an incarnation
/// that has exited is dropped dead (a restart is a new pid). It agrees with the runtime's dropped
/// flag (actor_events.t27 is_dropped; tested below). An event that is no deliver has none.
pub const NO_VERDICT : u8 = 9;

pub fn entry_verdict(exited: bool, dropped: u32, depth: u32) -> u8 {
    var before : u32 = depth;
    if (dropped == 0 and depth > 0) { before = depth - 1; }
    return deliver(exited == false, before, MAILBOX_CAP);
}

/// The order actors.t27 guarantees: one sender, one receiver, by pid. A restarted receiver is a new
/// pid and so a new pair.
pub fn order_guaranteed(a_from: u64, a_to: u64, b_from: u64, b_to: u64) -> bool {
    return ordered(a_from == b_from, a_to == b_to);
}

/// A card's timeline is its events by the actors stream's seq: the bus keeps every pair's FIFO order
/// (bus_keeps_fifo), and between two pairs, where actors.t27 promises nothing, it shows the order
/// the runtime wrote. The board joins as a chain only the entries order_guaranteed links.
pub fn timeline_pos(ev_seq: [32]u64, ev_card: [32]u64, i: u32) -> u32 {
    if (i >= VIEW_EVENTS) { return NO_EVENT; }
    if (ev_card[i] == NO_TASK_KEY) { return NO_EVENT; }
    var n : u32 = 0;
    var j : u32 = 0;
    while (j < VIEW_EVENTS) {
        if (ev_card[j] == ev_card[i] and ev_seq[j] < ev_seq[i]) { n = n + 1; }
        j = j + 1;
    }
    return n;
}

; --- 6. The filter -----------------------------------------------------------------------------------

/// An actor kind mask (a bit per QK_ code, 0 = any) and a supervisor (NO_PID = any; else the lane
/// whose supervisor that is). The root's QK_NONE has no bit, so a kind filter leaves it out.
pub fn actor_matches(actor_kind_mask: u32, sup_pid: u64, kind: u8, lane_sup: u64) -> bool {
    if (actor_kind_mask != 0) {
        if (kind >= 32) { return false; }
        if ((actor_kind_mask & (1 << kind)) == 0) { return false; }
    }
    if (sup_pid != NO_PID and slot_of(lane_sup) != slot_of(sup_pid)) { return false; }
    return true;
}

/// tasks.t27's task_matches, and the receiving actor's kind and lane.
pub fn card_matches(kind_mask: u32, state_mask: u32, actor_kind_mask: u32, sup_pid: u64, task_kind: u8, task_state: u8, actor_kind: u8, lane_sup: u64) -> bool {
    if (task_matches(kind_mask, state_mask, task_kind, task_state) == false) { return false; }
    return actor_matches(actor_kind_mask, sup_pid, actor_kind, lane_sup);
}

; --- 7. The fixed trace ------------------------------------------------------------------------------
; Seven actors: root 1.0, intake 2.0 and two domain supervisors 3.0 and 6.0 under it; agents 4.0 and
; 9.x under domain 3.0, agent 7.0 under domain 6.0. The rows are deliberately out of layout order.
; A burst of 300 messages fills agent 7.0's mailbox (44 dropped). Agent 9 crashes on job 77 (seq 7),
; its supervisor restarts it one_for_one as 9.1 (seq 9), and a late message to 9.0 is dropped dead.
; Issue 8615 goes submitted -> working -> completed on agent 4.0, which then retires between turns.
; The review offered to the full agent 7.0 is dropped. Message numbers run 1..321 in send order.
; Pids: 1.0 = 4294967296, 2.0 = 8589934592, 3.0 = 12884901888, 4.0 = 17179869184,
; 6.0 = 25769803776, 7.0 = 30064771072, 9.0 = 38654705664, 9.1 = 38654705665.
; Task keys: issue 8615 in repo 0 = 8615; job 77 in repo 0 = 2305843009213694029;
; review 1744 in repo 1 = 1153202979583559376.

pub const TR_PID : [8]u64 = [38654705665, 4294967296, 25769803776, 0, 17179869184, 12884901888, 8589934592, 30064771072];
pub const TR_PARENT : [8]u64 = [12884901888, 0, 4294967296, 0, 12884901888, 4294967296, 4294967296, 25769803776];
pub const TR_KIND : [8]u8 = [3, 99, 2, 99, 3, 2, 0, 3];
pub const TR_MAX : [8]u32 = [0, 2, 3, 0, 0, 3, 0, 0];
pub const TR_PERIOD : [8]u32 = [0, 900, 300, 0, 0, 300, 0, 0];
pub const TR_SLOT : [8]u64 = [9, 1, 6, 0, 4, 3, 2, 7];
pub const TR_GEN : [8]u64 = [1, 0, 0, 0, 0, 0, 0, 0];

; The same tree with its rows reversed.
pub const TP_PID : [8]u64 = [30064771072, 8589934592, 12884901888, 17179869184, 0, 25769803776, 4294967296, 38654705665];
