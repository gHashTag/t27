// SPDX-License-Identifier: Apache-2.0
; specs/physics/xc7_primitives.t27 -- the 7-series device primitives a t27 design instantiates, declared once
; (gHashTag/t27#8826). Each is an extern module in the form specs/tri/t27b/verilog_plan.t27 reads:
; - a fn with an empty body, whose parameters are the primitive's inputs and Verilog parameters (by type);
; - a struct, whose fields are the output ports a design may read.
; A design brings them in with `use physics::xc7_primitives;` and binds an instance to a module-level const; `t27b
; verilog` writes the instance, and synthesis maps it to the die's cell (STARTUPE2, BUFG, BSCANE2). Only the
; ports these designs use are declared: an input left out takes the primitive's default, an output left out
; is left unconnected. The reference never calls one (Zig analyses a declaration only when a test reaches it).
; Also here, the reader's side of BSCANE2's JTAG_CHAIN: the JTAG instruction that selects each USER chain on
; a 7-series die (a 6-bit IR: USER1 0x02, USER2 0x03, USER3 0x22, USER4 0x23; anything else here is BYPASS),
; as specs/port/tools/jtag/read_verdict.t27's USER_OPCODE table has them.
; phi^2 + 1/phi^2 = 3 | TRINITY

module FpgaXc7Primitives;

/// The outputs of STARTUPE2 a design reads: the configuration clock.
pub struct Startupe2Out { CFGMCLK: bool }

/// STARTUPE2: the configuration logic, here for its CFGMCLK (65 MHz nominal, measured 67.20 to 70.77 MHz on
/// the bench dice).
pub fn STARTUPE2(PROG_USR: str, SIM_CCLK_FREQ: f64, CLK: bool, GSR: bool, GTS: bool, KEYCLEARB: bool, PACK: bool, USRCCLKO: bool, USRCCLKTS: bool, USRDONEO: bool, USRDONETS: bool) -> Startupe2Out {}

/// One period of CFGMCLK at the fastest rate measured on the bench dice, in picoseconds: 70.77 MHz (T495; the
/// three dice measured 67.20, 68.49 and 70.77 MHz), 10^12 / 70,770,000 = 14130.28 ps, rounded down so that a
/// clock declared from it is checked at that rate or a little above. A design declares a clock it derives from
/// CFGMCLK as a multiple of this (specs/tri/t27b/verilog_plan.t27, clock declarations, #8839).
pub const CFGMCLK_TICK_PS : u64 = 14130;

/// The output of BUFG.
pub struct BufgOut { O: bool }

/// BUFG: a global clock buffer.
pub fn BUFG(I: bool) -> BufgOut {}

/// The outputs of BSCANE2 a design reads.
pub struct Bscane2Out { CAPTURE: bool, DRCK: bool, SEL: bool, SHIFT: bool, TCK: bool, TDI: bool }

/// BSCANE2: the JTAG USER chain JTAG_CHAIN (1 to 4); `keep` keeps the cell through synthesis; TDO is its one
/// input.
pub fn BSCANE2(JTAG_CHAIN: comptime_int, keep: bool, TDO: bool) -> Bscane2Out {}

/// The output of IBUFDS.
pub struct IbufdsOut { O: bool }

/// IBUFDS: a differential input buffer (the AX7203's 200 MHz oscillator on R4/T4).
pub fn IBUFDS(I: bool, IB: bool) -> IbufdsOut {}

/// The outputs of PLLE2_ADV a design reads.
pub struct Plle2AdvOut { CLKFBOUT: bool, CLKOUT0: bool, CLKOUT1: bool, LOCKED: bool }

/// PLLE2_ADV: a phase-locked loop with two outputs; CLKFBIN takes its own CLKFBOUT. The dynamic
/// reconfiguration port is left out (DCLK, DEN and DWE tied low).
pub fn PLLE2_ADV(CLKIN1_PERIOD: f64, CLKFBOUT_MULT: comptime_int, DIVCLK_DIVIDE: comptime_int, CLKOUT0_DIVIDE: comptime_int, CLKOUT1_DIVIDE: comptime_int, CLKOUT1_PHASE: f64, CLKIN1: bool, CLKIN2: bool, CLKINSEL: bool, CLKFBIN: bool, PWRDWN: bool, RST: bool, DCLK: bool, DEN: bool, DWE: bool) -> Plle2AdvOut {}

/// The output of ODDR.
pub struct OddrOut { Q: bool }

/// ODDR: an output register for both edges of C (D1 on the rising edge, D2 on the falling edge).
pub fn ODDR(C: bool, CE: bool, D1: bool, D2: bool, R: bool, S: bool) -> OddrOut {}

/// The BYPASS instruction: all ones in the 6-bit IR.
pub const IR_BYPASS : u8 = 63;

/// The JTAG instruction that selects BSCANE2 chain `chain`; IR_BYPASS for a chain there is none of.
pub fn user_ir(chain: u8) -> u8 {
    if (chain == 1) { return 2; }
    if (chain == 2) { return 3; }
    if (chain == 3) { return 34; }
    if (chain == 4) { return 35; }
    return IR_BYPASS;
}

test the_cfgmclk_tick_is_the_fastest_measured_rate_rounded_down {
    // the measured rates, in Hz, and one second in picoseconds
    var fastest : u64 = 70770000;
    var slowest : u64 = 67200000;
    var second_ps : u64 = 1000000000000;
    // 14130 ps is at most one period of the fastest die, and 14131 ps is more than one
    assert CFGMCLK_TICK_PS * fastest <= second_ps;
    assert (CFGMCLK_TICK_PS + 1) * fastest > second_ps;
    // so every die runs a clock declared from it at its declared rate or slower, never faster
    assert CFGMCLK_TICK_PS * slowest < second_ps;
}

test the_user_chains_have_their_instructions {
    assert_eq(user_ir(1), 2);
    assert_eq(user_ir(2), 3);
    assert_eq(user_ir(3), 34);
    assert_eq(user_ir(4), 35);
    assert_eq(user_ir(0), IR_BYPASS);
    assert_eq(user_ir(5), IR_BYPASS);
}
