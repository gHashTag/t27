// Traffic animator spec - reproduces keyword escaping bug
pub fn create_packet_color(type: u32, red: u8, green: u8, blue: u8) -> u32 {
    // The parameter 'type' is a Rust keyword and should be escaped as r#type
    // in generated Rust code
    let color: u32 = ((type as u32) & 0xFF) << 24;
    let rgb: u32 = ((red as u32) << 16) | ((green as u32) << 8) | (blue as u32);
    color | rgb
}

// test: packet color creation
test test_create_packet_color {
    // Test with different byte positions
    assert create_packet_color(0x12, 0x34, 0x56, 0x78) == 0x12345678;
    assert create_packet_color(0xFF, 0x00, 0xAA, 0xBB) == 0xFF00AABB;
    assert create_packet_color(0x01, 0x02, 0x03, 0x04) == 0x01020304;
}