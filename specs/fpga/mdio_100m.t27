// SPDX-License-Identifier: Apache-2.0
module Mdio100m;
// specs/fpga/mdio_100m.t27 -- E2e of the Ethernet job link (#8770, part of #8327): the PHY reset
// hold and the MDIO writes that bring the AX7203's KSZ9031 up at 100 Mb/s.
//
// Why 100 Mb/s: EthRx, TrinetNode and EthReply together do not close 125 MHz in the open flow
// (best 119.77 MHz), so the bench runs the link at 100 Mb/s, where RXC is 25 MHz. The PHY
// advertises 1000BASE-T after reset; this module stops that and restarts auto-negotiation.
//
// Runs on the board's free-running 200 MHz oscillator (5 ns a clock), from configuration:
//   0 .. T_HOLD        phy_rst_n low: the PHYs are held in reset for 2^22 clocks (21 ms)
//   T_HOLD             phy_rst_n goes high
//   T_START            2^19 clocks (2.6 ms) later; the 16 MDIO frames start on the next clock
// Frames: IEEE 802.3 Clause 22 writes, MSB first, 64 bits each: 32 preamble ones, ST 01,
// OP 01 (write), PHYAD, REGAD, TA 10, 16 data bits. Frames 0..7 write reg 9 (1000BASE-T
// control) = 0x0000 to PHY addresses 0..7; frames 8..15 write reg 0 = 0x1200 (auto-negotiation
// enable and restart) to the same addresses. Address 0 is the KSZ9031 broadcast address; each
// PHY on the AX7203 has its own MDIO pair, and the board's address straps are not documented,
// so all eight addresses get the writes.
// MDC is clk / 100 (2 MHz): a bit takes 100 clocks; MDIO changes at div 0 while MDC is low,
// MDC rises at div 25 (the PHY samples there) and falls at div 75. MDIO is only driven, never
// read. After the last frame done is 1 and MDIO idles high.
// Timing at 200 MHz: the start (go, t == T_START), the bit-end event (st99) and its two
// conditions (lastb, lastf) are registered a clock early, so no 32-bit compare drives the
// enables of the 64-bit frame registers; the next frame is computed at div 1.
//
// Reference frames were computed independently (Python) before this spec was written:
//   frame 0  0xFFFFFFFF50260000   frame 1  0xFFFFFFFF50A60000   frame 7  0xFFFFFFFF53A60000
//   frame 8  0xFFFFFFFF50021200   frame 15 0xFFFFFFFF53821200
//   the low 32 bits of the 16 frames add up to 21965606912.
//
// Sequential (test) and nonblocking (hardware) semantics agree: every var is assigned at
// most once on each path, and no var is read after it was written in the same call.
// phi^2 + 1/phi^2 = 3 | TRINITY

const T_HOLD : u32 = 4194304
const T_START : u32 = 4718592
const T_END : u32 = 4718593
const WRITE_BITS : u64 = 1342308352
const REG9 : u64 = 2359296
const REG0_DATA : u64 = 4608
const DIV_END : u8 = 98

var t : u32 = 0
var phy_rst_n : u8 = 0
var go : u8 = 0
var run : u8 = 0
var done : u8 = 0
var div : u8 = 0
var bitn : u8 = 0
var fr : u8 = 0
var sh : u64 = 0
var nf : u64 = 0
var st99 : u8 = 0
var lastb : u8 = 0
var lastf : u8 = 0
var mdc : u8 = 0
var mdio : u8 = 1

// Frame f, 64 bits, sent most significant bit first.
fn frame(f: u8) -> u64 {
    var ones : u64 = 4294967295;
    var ad : u64 = ((f & 7) as u64) << 23;
    if ((f & 8) == 8) {
        return (ones << 32) | WRITE_BITS | ad | REG0_DATA;
    }
    return (ones << 32) | WRITE_BITS | ad | REG9;
}

fn hit32(a: u32, b: u32) -> u8 {
    if (a == b) { return 1; }
    return 0;
}

fn hit(a: u8, b: u8) -> u8 {
    if (a == b) { return 1; }
    return 0;
}

// st99, lastb and lastf hold the previous clock's (div == 98), (bitn == 63) and (fr == 15).
// bitn and fr change only on the bit-end clock, which leaves lastb and lastf as they were.
fn on_clock() {
    if (t == T_HOLD) {
        phy_rst_n = 1;
    }
    if (go == 1) {
        st99 = 0;
        lastb = hit(bitn, 63);
        lastf = hit(fr, 15);
        run = 1;
        fr = 0;
        bitn = 0;
        div = 0;
        sh = frame(0);
    } else {
        if (run == 1) {
            if (st99 == 1) {
                st99 = 0;
                div = 0;
                if (lastb == 1) {
                    bitn = 0;
                    if (lastf == 1) {
                        run = 0;
                        done = 1;
                        mdio = 1;
                    } else {
                        fr = fr + 1;
                        sh = nf;
                    }
                } else {
                    bitn = bitn + 1;
                    sh = (sh << 1) | 1;
                }
            } else {
                st99 = hit(div, DIV_END);
                lastb = hit(bitn, 63);
                lastf = hit(fr, 15);
                if (div == 0) {
                    mdio = (sh >> 63) as u8;
                }
                if (div == 1) {
                    nf = frame(fr + 1);
                }
                if (div == 25) {
                    mdc = 1;
                }
                if (div == 75) {
                    mdc = 0;
                }
                div = div + 1;
            }
        }
    }
    go = hit32(t, T_START);
    if (t != T_END) {
        t = t + 1;
    }
}

// ---------------------------------------------------------------------------

invariant the_writes_start_after_the_reset_hold {
    assert(T_START > T_HOLD);
    assert_eq(T_END, T_START + 1);
}

test the_frames_are_the_reference_clause_22_writes {
    assert_eq(frame(0), 18446744070759251968);
    assert_eq(frame(1), 18446744070767640576);
    assert_eq(frame(7), 18446744070817972224);
    assert_eq(frame(8), 18446744070756897280);
    assert_eq(frame(15), 18446744070815617536);
}

test the_phys_leave_reset_after_the_hold_and_mdio_stays_idle {
    t = T_HOLD - 1; phy_rst_n = 0; run = 0; done = 0; mdc = 0; mdio = 1;
    on_clock();
    assert_eq(phy_rst_n, 0);
    on_clock();
    assert_eq(phy_rst_n, 1);
    on_clock();
    assert_eq(mdc, 0);
    assert_eq(mdio, 1);
    assert_eq(run, 0);
}

// Read MDIO the way the PHY does, on each rising edge of MDC, and rebuild the 16 frames.
test the_phy_reads_sixteen_frames_on_the_rising_edges_of_mdc {
    t = T_START - 1; go = 0; run = 0; done = 0; div = 0; bitn = 0; fr = 0; mdc = 0; mdio = 1;
    st99 = 0; lastb = 0; lastf = 0;
    var k : u32 = 0;
    var prev : u8 = 0;
    var acc : u64 = 0;
    var nbits : u32 = 0;
    var nframes : u32 = 0;
    var lows : u64 = 0;
    var bad : u32 = 0;
    while (k < 110000) {
        on_clock();
        if (mdc == 1) {
            if (prev == 0) {
                acc = (acc << 1) | (mdio as u64);
                nbits = nbits + 1;
                if (nbits == 64) {
                    if (nframes == 0) { if (acc != 18446744070759251968) { bad = bad + 1; } }
                    if (nframes == 1) { if (acc != 18446744070767640576) { bad = bad + 1; } }
                    if (nframes == 7) { if (acc != 18446744070817972224) { bad = bad + 1; } }
                    if (nframes == 8) { if (acc != 18446744070756897280) { bad = bad + 1; } }
                    if (nframes == 15) { if (acc != 18446744070815617536) { bad = bad + 1; } }
                    lows = lows + (acc & 4294967295);
                    nframes = nframes + 1;
                    nbits = 0;
                    acc = 0;
                }
            }
        }
        prev = mdc;
        k = k + 1;
    }
    assert_eq(nframes, 16);
    assert_eq(nbits, 0);
    assert_eq(bad, 0);
    assert_eq(lows, 21965606912);
    assert_eq(done, 1);
    assert_eq(run, 0);
    assert_eq(mdio, 1);
    assert_eq(mdc, 0);
}
