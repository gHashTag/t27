    // === Integer format helpers ===

    pub fn hw_int4() -> HwType {
        return HwType{
            .tag = 24,
            .width = 4,
            .is_signed_flag = true,
            .is_clock_flag = false,
            .is_reset_flag = false,
            .elem_tag = 0,
            .vec_len = 0,
            .field_count = 0,
        };
    }

    pub fn hw_int8() -> HwType {
        return HwType{
            .tag = 25,
            .width = 8,
            .is_signed_flag = true,
            .is_clock_flag = false,
            .is_reset_flag = false,
            .elem_tag = 0,
            .vec_len = 0,
            .field_count = 0,
        };
    }

    // === Quantization format helpers ===

    pub fn hw_nf4() -> HwType {
        return HwType{
