            .elem_tag = 0,
            .vec_len = 0,
            .field_count = 0,
        };
    }

    pub fn hw_ternary() -> HwType {
        return HwType{
            .tag = 28,
            .width = 2,
            .is_signed_flag = true,
            .is_clock_flag = false,
            .is_reset_flag = false,
            .elem_tag = 0,
            .vec_len = 0,
            .field_count = 0,
        };
