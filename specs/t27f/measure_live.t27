// SPDX-License-Identifier: Apache-2.0
// specs/t27f/measure_live.t27 -- the LAW of the M3 measurement: a recorded log replayed at 60 fps
// with 0 dropped frames over a 3600-frame window, judged from per-frame rows (M3 of T27F Live).
// Issue gHashTag/t27#10262 (epic #10266). Design: docs/nona-02-organism/t27f/genui-research.md,
// section 5.5, row M3.
//
// WHY A LAW AND NOT PROSE. The M3 row's done-when is one sentence -- "the page replays a recorded
// log at 60 fps with 0 dropped frames over 60 s in a headless browser on the lab" -- and prose
// refuses nothing: a harness that renders 59 s of frames, drops three and reports green satisfies
// every word of it loosely read. This card makes the sentence executable: the frame clock, the
// drop rule, the per-frame record, the percentile and the verdict are functions with tests, and
// the future browser harness implements THIS and nothing else. The card extends live_mode.t27's
// measurement discipline -- the same budgets, the same lab-only rule, the same record-refuses-
// to-lie posture -- from the event clock to the browser frame clock, and takes live_mode's
// constants by import, never by copy: a budget forked into two cards is two budgets.
//
// WHY THIS CLOCK. The display, not the painter, owns time. A frame is DUE at every tick of the
// 60 Hz schedule: tick k fires at due_at_us(k) = (k-1) * 16667 us -- 16.667 ms, the 60 fps period
// carried in whole microseconds (a millisecond clock cannot hold it; live_mode's FRAME_MS windows
// are the EVENT accounting grid, a different ruler, and this card asserts the two distinct). The
// frame's timestamp is when its paint COMPLETED -- never when it started, never when it was
// scheduled. The drop rule is one comparison: a frame is DROPPED when its completion misses the
// NEXT due tick, completed_at > deadline_us(k) = k * FRAME_PERIOD_US. The tick instant itself is
// not a miss (completion exactly at the tick still made the frame); one microsecond past it is.
// Drops do not cascade and the clock does not wait: a late paint does not move tick k+1, and a
// paint the browser never ran is recorded honestly as never-completed (completed_at == 0), which
// is a dropped frame of the second kind. The window is 60 s of display time: WINDOW_FRAMES ==
// FPS * WINDOW_SECONDS == 3600 ticks, spanning 60,001,200 us -- 1.2 ms past the nominal minute,
// the stated cost of carrying 16.667 ms in whole microseconds. The ticks are the clock; there is
// no wall timer beside them (live_mode's refusal, restated: this card has no wall clock).
//
// WHY THE GATE IS THREE AND ZERO IS ONE OF THEM. The M3 criterion says "0 dropped frames", and
// this card takes the zero literally: frames_dropped == 0 is a gate, not a quota. A single 40 ms
// hiccup in an otherwise perfect minute passes BOTH percentile budgets -- p50 10 ms, p99 10 ms --
// and still FAILS, because a dropped frame IS the miss; no percentile over the survivors may
// average it away. The percentiles are the second and third gates (p50 <= 50 ms, p99 <= 150 ms,
// live_mode's budgets by value, imported and asserted, over the whole window), reported so a
// near-miss names its margin; the zero is the gate that decides. The two budget gates cannot bind
// on a clean window -- 0 drops pins every latency inside one 16,667 us period, under both -- so
// they bind on failing ones, bounding how far the late tail ran before the zero gate closed it.
//
// WHY THE RECORD IS PER-FRAME. An aggregate can lie; a column of 3600 rows cannot. One row per
// due tick: (due_tick, completed_at, dropped) -- and the dropped flag is COMPUTED by this law
// from the first two columns, never taken from the harness, so a row cannot claim on-time that
// its own timestamp refutes. The verdict re-derives everything from the columns: it recounts the
// drops, re-sorts the latencies, and refuses a record whose columns contradict the row law.
// The aggregate (frames_total, frames_dropped, p50, p99) is always COMPUTED from the rows, never
// stored -- a stored aggregate can disagree with its rows, a computed one cannot.
//
// WHY PARTIAL AND REFUSED ARE NOT FAIL. A window shorter than 3600 frames did not run the
// experiment the M3 row states; its verdict is PARTIAL, never PASS, however green its rows --
// 3599 perfect frames prove 59.98 seconds, and the claim is a minute. A record whose rows
// contradict the row law (a skipped tick, a painted-before-due timestamp, a timestamp past the
// guard) is not a measurement at all: VERDICT_REFUSED, never PASS, never FAIL -- FAIL would
// concede the run happened. And a missing row cannot be stepped over: the report must carry the
// skipped tick's row (completed_at == 0, the honest never-painted marker) or the next append is
// refused -- a measurement without the recorded per-frame rows is not a pass.
//
// WHY NEAREST-RANK. The percentiles are the nearest-rank method in integer math: the value at
// rank ceil(p * n / 100) of the sorted latencies, no interpolation. Nearest-rank answers the
// sentence a frame budget needs -- "p percent of frames completed at or under this value" -- as
// a count of frames, and on the 3600-frame window (where p * n is an exact multiple of 100 for
// p in {50, 99}) it sits ONE rank below live_mode's floor-percentile would; the difference is
// owned here, and each card's fixtures pin its own method. The latencies are measured in
// microseconds and the budgets in milliseconds: the gate compares p50_us <= P50_BUDGET_US and
// p99_us <= P99_BUDGET_US exactly, and the ms columns (p50_ms, p99_ms) are the report's rounding,
// never the gate's input.
//
// NOT CLAIMED: the browser harness itself is the CONSUMER of this law, not part of it -- the
// loader page that produces the completion timestamps is Trinity's repo (at most 40 lines, per
// #10262), and no JavaScript, no requestAnimationFrame and no headless browser live here. No
// browser run has happened: LAB_RUN_DONE -- live_mode's flag of record, shared on purpose, since
// a real lab run flips it in the PR that carries one -- is false and asserted, so no number in
// this file is a measurement and none may be quoted as one; every latency in the tests is a
// hand-computed fixture. hud.t27 (the scene the replay paints) and the recorded log's format are
// other cards' subjects; this law judges the measurement of their frames, not their pixels. The
// 60 fps schedule is modeled, not owned: this card has no wall clock and no timer, and due_at_us
// is arithmetic over the display's tick schedule, which the lab harness implements. No
// reconnection, no authentication, no compression; nothing here renders, decodes or streams.
// phi^2 + 1/phi^2 = 3 | TRINITY

module measure_live;

use t27f::live_mode::P50_BUDGET_MS;
use t27f::live_mode::P99_BUDGET_MS;
use t27f::live_mode::MEASURED_ON;
use t27f::live_mode::MEASURE_HARNESS;
use t27f::live_mode::HAS_LOCAL_MEASURE;
use t27f::live_mode::LAB_RUN_DONE;
use t27f::live_mode::COALESCE_MS;
use t27f::live_mode::sort_u32;

// ---- the frame clock ----------------------------------------------------------------------------------

/// The display's cadence: 60 frames per second, the M3 row's "60 fps".
pub const FPS : u32 = 60;

/// The window is 60 s of display time -- 3600 due ticks, the M3 row's "over 60 s". The identity
/// WINDOW_FRAMES == FPS * WINDOW_SECONDS is the whole claim: 3600 is not a round number, it is
/// one minute of a 60 Hz clock.
pub const WINDOW_SECONDS : u32 = 60;
pub const WINDOW_FRAMES : u32 = 3600;

/// The period of one due tick: 16.667 ms, the 60 fps period carried in whole microseconds --
/// ceiling(1,000,000 / 60). A millisecond grid cannot hold it (16 or 17, both wrong by half a
/// frame), and rounding DOWN would fire ticks early, before the display has them; rounding up
/// lands the window 1,200 us past the nominal minute, asserted below as the ceiling's cost.
pub const FRAME_PERIOD_US : u32 = 16667;

/// The window's span in us: 3600 ticks of 16,667 us. Asserted equal to the product, so the
/// "60 s" of the M3 row is this number and not a wall timer beside it.
pub const WINDOW_US : u32 = 60001200;

/// A completion timestamp past twice the window is not a late frame, it is a lost run: the
/// record refuses it rather than file a grotesque number under a 60 s claim. Every honest late
/// frame sits between its deadline and this guard; the drop rule measures the first, the guard
/// bounds the second.
pub const LATE_GUARD_US : u32 = 120002400;

/// The instant tick k is due: tick 1 at window start (0), tick 3600 at 59,984,533 us.
pub fn due_at_us(k: u32) -> u32 {
    return (k - 1) * FRAME_PERIOD_US;
}

/// The deadline tick k must beat: the NEXT due tick. A paint completing after it missed the
/// schedule, whatever it painted. Tick 3600's deadline is the window end itself.
pub fn deadline_us(k: u32) -> u32 {
    return k * FRAME_PERIOD_US;
}

// ---- the budgets: live_mode's, by value, asserted, never forked ----------------------------------------

/// The M4 budgets applied to the frame clock: p50 under 50 ms, p99 under 150 ms (live_mode's
/// P50_BUDGET_MS / P99_BUDGET_MS, imported above). The gate compares these microsecond forms
/// exactly; the ms constants are the value live_mode states, and the assert pins the two cards
/// to one budget. The M3 gate adds the one the M4 row does not state: frames_dropped == 0.
pub const P50_BUDGET_US : u32 = 50000;
pub const P99_BUDGET_US : u32 = 150000;

// ---- result codes --------------------------------------------------------------------------------------

pub const FRAME_OK : u8 = 0;
pub const E_WINDOW_FULL : u8 = 1;          // the window already holds its 3600 rows: refused
pub const E_SEQUENCE : u8 = 2;             // not the next due tick: a skipped or repeated row
pub const E_TIMESTAMP : u8 = 3;            // a completion timestamp that lies about time
pub const FRAME_CODE_NAMES : [4]str = ["ok", "window-full", "sequence", "timestamp"];

/// What the law says about one row's completion. FRAME_ON_TIME: painted by the deadline.
/// DROPPED_LATE: painted, but past the next due tick. DROPPED_NEVER: no completion at all
/// (completed_at == 0) -- the honest marker for a tick the browser never painted.
pub const FRAME_ON_TIME : u8 = 0;
pub const DROPPED_LATE : u8 = 1;
pub const DROPPED_NEVER : u8 = 2;

/// The verdict over a whole window. PASS: 3600 rows, 0 dropped, both percentile budgets met.
/// FAIL: the window ran and broke a gate. PARTIAL: fewer than 3600 clean rows -- the experiment
/// the M3 row states did not run, so a pass is not on the table. REFUSED: the record's columns
/// contradict the row law -- not a measurement, not even a failed one.
pub const VERDICT_PASS : u8 = 0;
pub const VERDICT_FAIL : u8 = 1;
pub const VERDICT_PARTIAL : u8 = 2;
pub const VERDICT_REFUSED : u8 = 3;
pub const VERDICT_NAMES : [4]str = ["pass", "fail", "partial", "refused"];

// ---- the record: one row per due tick ------------------------------------------------------------------

/// The measurement record over one window. Flat columns indexed by row, as live_mode's
/// MeasureRecord is: due_tick is the 1-based frame number the row answers (row i holds tick
/// i + 1 or the record is invalid), completed_at is the paint's completion in us since window
/// start (0 = never completed), dropped is the law's classification COMPUTED at write time.
/// The aggregates never read the dropped column -- they recompute it from the timestamps -- so
/// the column is the lab report's convenience, not the verdict's input.
pub struct FrameRecord {
    count : u32,                           // rows recorded so far, at most WINDOW_FRAMES
    due_tick : [3600]u32,
    completed_at : [3600]u32,
    dropped : [3600]u8,
}

/// Zero the record for one window. The only way a record begins; a record is per-window and
/// nothing carries over between windows.
pub fn frame_reset(rec: *FrameRecord) -> u8 {
    rec.count = 0;
    var i : u32 = 0;
    while (i < WINDOW_FRAMES) {
        rec.due_tick[i as usize] = 0;
        rec.completed_at[i as usize] = 0;
        rec.dropped[i as usize] = FRAME_ON_TIME;
        i = i + 1;
    }
    return FRAME_OK;
}

/// The law of one row. The record accepts exactly the next due tick (a report that skips a tick
/// is refused at the gap -- it must carry the skipped tick's row, even if that row is a
/// never-completed marker), refuses a completion before the frame was due (a paint cannot end
/// before its frame exists) and a completion past the guard (a lost run, not a late frame).
/// The dropped flag is computed here, from the timestamp, by frame_classify -- never taken from
/// the caller. A refusal writes nothing.
pub fn frame_record(rec: *FrameRecord, due_tick: u32, completed_at: u32) -> u8 {
    if (rec.count >= WINDOW_FRAMES) { return E_WINDOW_FULL; }
    if (due_tick != rec.count + 1) { return E_SEQUENCE; }
    if (completed_at > LATE_GUARD_US) { return E_TIMESTAMP; }
    if (completed_at != 0 and completed_at < due_at_us(due_tick)) { return E_TIMESTAMP; }
    rec.due_tick[rec.count as usize] = due_tick;
    rec.completed_at[rec.count as usize] = completed_at;
    rec.dropped[rec.count as usize] = frame_classify(due_tick, completed_at);
    rec.count = rec.count + 1;
    return FRAME_OK;
}

/// The drop rule, the whole of it. No completion (0) is a drop of the second kind. A completion
/// at exactly the deadline made the frame (the tick had not passed); one microsecond later it
/// did not. Nothing else moves the answer: not the neighbours, not the percentile, not intent.
pub fn frame_classify(due_tick: u32, completed_at: u32) -> u8 {
    if (completed_at == 0) { return DROPPED_NEVER; }
    if (completed_at > deadline_us(due_tick)) { return DROPPED_LATE; }
    return FRAME_ON_TIME;
}

/// One frame's paint latency in us: completion minus the instant the frame was due. Meaningful
/// only when completed_at != 0 -- a never-completed frame has no latency, and the percentiles
/// never see one.
pub fn frame_latency_us(due_tick: u32, completed_at: u32) -> u32 {
    return completed_at - due_at_us(due_tick);
}

// ---- the aggregate: always computed, never stored -------------------------------------------------------

/// frames_total: the rows the window recorded. 3600 or the window is PARTIAL, whatever the rows
/// say.
pub fn frames_total(rec: *FrameRecord) -> u32 {
    return rec.count;
}

/// frames_dropped, recounted from the timestamps by the law -- never summed from the stored
/// flags, so a corrupted flag column cannot change the verdict. Counts both kinds: painted too
/// late and never painted.
pub fn frames_dropped(rec: *FrameRecord) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < rec.count) {
        if (frame_classify(rec.due_tick[i as usize], rec.completed_at[i as usize]) != FRAME_ON_TIME) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// The completed frames' latencies, in row order, into out (capacity cap); returns how many.
/// A never-completed frame contributes no latency -- there is nothing to percentile -- but it
/// stays in frames_dropped, where the zero gate reads it.
pub fn completed_latencies(rec: *FrameRecord, out: []u32, cap: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < rec.count) {
        const c = rec.completed_at[i as usize];
        if (c != 0) {
            if (n >= cap) { return n; }
            out[n as usize] = frame_latency_us(rec.due_tick[i as usize], c);
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// ---- the percentiles: nearest-rank, integer math --------------------------------------------------------

/// The 1-based nearest rank of percentile p (0..100) over n values: ceil(p * n / 100), in integer
/// math ((n * p + 99) / 100, truncated), clamped into 1..n so p = 0 is the smallest and p = 100
/// the largest. Over the 3600-frame window this lands on ranks 1800 and 3564 for p = 50 and 99.
pub fn nearest_rank(n: u32, p: u32) -> u32 {
    var r = @divTrunc(n * p + 99, 100);
    if (r == 0) { r = 1; }
    if (r > n) { r = n; }
    return r;
}

/// The p-th percentile of the first n entries of a, ascending, NEAREST-RANK: the value at rank
/// nearest_rank(n, p), no interpolation. Sorts a in place (the caller's copy; the record's
/// columns are never sorted). An empty array has no percentile and returns 0 rather than invent
/// one.
pub fn percentile_nearest_rank(a: []u32, n: u32, p: u32) -> u32 {
    if (n == 0) { return 0; }
    sort_u32(a, n);
    return a[(nearest_rank(n, p) - 1) as usize];
}

/// p50 over the window's completed latencies, in us. The gate's exact instrument.
pub fn p50_us(rec: *FrameRecord) -> u32 {
    var buf : [3600]u32 = [0] ** 3600;
    const n = completed_latencies(rec, buf[0..WINDOW_FRAMES], WINDOW_FRAMES);
    return percentile_nearest_rank(buf[0..n], n, 50);
}

/// p99 over the window's completed latencies, in us. The gate's exact instrument.
pub fn p99_us(rec: *FrameRecord) -> u32 {
    var buf : [3600]u32 = [0] ** 3600;
    const n = completed_latencies(rec, buf[0..WINDOW_FRAMES], WINDOW_FRAMES);
    return percentile_nearest_rank(buf[0..n], n, 99);
}

/// The report's ms columns -- the us gate, rounded for the lab report. Never the gate's input:
/// a p99 of 150,400 us is over the budget in us and reads 150 here, which is why the gate
/// compares us.
pub fn p50_ms(rec: *FrameRecord) -> u32 {
    return @divTrunc(p50_us(rec), 1000);
}

pub fn p99_ms(rec: *FrameRecord) -> u32 {
    return @divTrunc(p99_us(rec), 1000);
}

// ---- the verdict ---------------------------------------------------------------------------------------

/// The M3 gate over one window, in the order the questions are honest:
///   1. every row must satisfy the row law (right tick, honest timestamp) -- else REFUSED,
///      before anything else: a corrupted record is not a measurement, not even a failed one;
///   2. the window must be complete (3600 rows) -- else PARTIAL, never PASS, however green;
///   3. the zero gate: frames_dropped == 0, recounted from the timestamps -- else FAIL. A
///      dropped frame IS the miss; no percentile over the survivors answers for it;
///   4. the budget gates: p50_us <= P50_BUDGET_US and p99_us <= P99_BUDGET_US -- else FAIL.
/// Only a complete, clean, drop-free window inside both budgets is VERDICT_PASS.
pub fn window_verdict(rec: *FrameRecord) -> u8 {
    var i : u32 = 0;
    while (i < rec.count) {
        const t = rec.due_tick[i as usize];
        if (t != i + 1) { return VERDICT_REFUSED; }
        const c = rec.completed_at[i as usize];
        if (c > LATE_GUARD_US) { return VERDICT_REFUSED; }
        if (c != 0 and c < due_at_us(t)) { return VERDICT_REFUSED; }
        i = i + 1;
    }
    if (rec.count != WINDOW_FRAMES) { return VERDICT_PARTIAL; }
    if (frames_dropped(rec) != 0) { return VERDICT_FAIL; }
    if (p50_us(rec) > P50_BUDGET_US) { return VERDICT_FAIL; }
    if (p99_us(rec) > P99_BUDGET_US) { return VERDICT_FAIL; }
    return VERDICT_PASS;
}

// ---- the fixture the tests replay ----------------------------------------------------------------------

/// Record n frames of a run where every paint completes paint_us after its due tick --
/// deterministic in (n, paint_us) alone, the recorded-log stand-in. Returns the first refusal,
/// FRAME_OK when all n rows landed. The hiccup tests build on it by recording the hiccup tick
/// themselves.
pub fn record_perfect_frames(rec: *FrameRecord, n: u32, paint_us: u32) -> u8 {
    var k : u32 = 1;
    var last : u8 = FRAME_OK;
    while (k <= n) {
        last = frame_record(rec, k, due_at_us(k) + paint_us);
        if (last != FRAME_OK) { break; }
        k = k + 1;
    }
    return last;
}

// ---- helpers ---------------------------------------------------------------------------------------------

/// v mod 100 by subtraction, for the permutation fixture (37 and 100 share no factor, so
/// rem100(i * 37) + 1 visits every value 1..100 exactly once).
fn rem100(v: u32) -> u32 {
    var r = v;
    while (r >= 100) { r = r - 100; }
    return r;
}

// ---- tests ---------------------------------------------------------------------------------------------

test "the clock, the window and the budgets are the stated law" {
    // the 60 s identity: 3600 is one minute of a 60 Hz display, not a round number
    assert(FPS == 60);
    assert(WINDOW_SECONDS == 60);
    assert(WINDOW_FRAMES == FPS * WINDOW_SECONDS);
    assert(WINDOW_FRAMES == 3600);
    // the period: 16.667 ms in whole microseconds -- the ceiling of 1,000,000 / 60; the floor
    // (16,666) would fire ticks before the display has them
    assert(FRAME_PERIOD_US == 16667);
    var floor_period : u32 = @divTrunc(1000000, FPS);
    assert(floor_period == 16666);
    var ceil_period : u32 = @divTrunc(1000000 + FPS - 1, FPS);
    assert(ceil_period == FRAME_PERIOD_US);
    // the span: 3600 ticks land 1,200 us past the nominal minute -- the ceiling's stated cost,
    // not a second clock
    assert(WINDOW_US == WINDOW_FRAMES * FRAME_PERIOD_US);
    assert(WINDOW_US == 60001200);
    var slack : u32 = WINDOW_US - 60000000;
    assert(slack == 1200);
    // the tick schedule: tick 1 due at the window's first instant, tick 3600 due 16,667 us
    // before the window ends; every deadline is the NEXT tick, and the last deadline is the
    // window end itself
    assert(due_at_us(1) == 0);
    assert(due_at_us(2) == 16667);
    assert(due_at_us(1800) == 29983933);
    assert(due_at_us(3600) == 59984533);
    assert(deadline_us(1) == 16667);
    assert(deadline_us(2) == 33334);
    assert(deadline_us(1800) == 30000600);
    assert(deadline_us(WINDOW_FRAMES) == WINDOW_US);
    // this clock is the display's, not live_mode's wire window: 16,667 us is not 16 ms
    assert(FRAME_PERIOD_US != COALESCE_MS * 1000);
    // the budgets are live_mode's by value, imported, never forked
    assert(P50_BUDGET_MS == 50);
    assert(P99_BUDGET_MS == 150);
    assert(P50_BUDGET_US == P50_BUDGET_MS * 1000);
    assert(P99_BUDGET_US == P99_BUDGET_MS * 1000);
    assert(P50_BUDGET_US == 50000);
    assert(P99_BUDGET_US == 150000);
    assert(P50_BUDGET_US < P99_BUDGET_US);
    // the lab-only rule, the live_mode pattern: stated, imported, and false until a run exists
    assert(MEASURED_ON == "railway-lab");
    assert(MEASURE_HARNESS == "headless browser vs t27-mcp --watch");
    assert(HAS_LOCAL_MEASURE == false);
    assert(LAB_RUN_DONE == false);         // no browser run yet; flips only in the PR that has one
    // the guard: twice the window, and it fits the u32 the timestamps travel in
    assert(LATE_GUARD_US == 2 * WINDOW_US);
    assert(LATE_GUARD_US == 120002400);
    assert(LATE_GUARD_US < 4294967295);
    // the codes name their card and do not collide
    assert(FRAME_OK == 0);
    assert(E_WINDOW_FULL == 1);
    assert(E_SEQUENCE == 2);
    assert(E_TIMESTAMP == 3);
    assert(FRAME_CODE_NAMES.len == 4);
    assert(FRAME_ON_TIME == 0);
    assert(DROPPED_LATE == 1);
    assert(DROPPED_NEVER == 2);
    assert(VERDICT_PASS == 0);
    assert(VERDICT_FAIL == 1);
    assert(VERDICT_PARTIAL == 2);
    assert(VERDICT_REFUSED == 3);
    assert(VERDICT_NAMES.len == 4);
}

test "a perfect window of 3600 ten-millisecond frames passes with 0 dropped" {
    var rec : FrameRecord = undefined;
    assert(frame_reset(&rec) == FRAME_OK);
    assert(record_perfect_frames(&rec, WINDOW_FRAMES, 10000) == FRAME_OK);
    // the window is complete and clean
    assert(frames_total(&rec) == 3600);
    assert(frames_dropped(&rec) == 0);
    // every row is the law's, letter by letter: right tick, completion one paint after due,
    // classified on time
    var i : u32 = 0;
    while (i < WINDOW_FRAMES) {
        assert(rec.due_tick[i as usize] == i + 1);
        assert(rec.completed_at[i as usize] == due_at_us(i + 1) + 10000);
        assert(rec.dropped[i as usize] == FRAME_ON_TIME);
        i = i + 1;
    }
    // the aggregate over the completed frames: every latency is 10 ms, so both percentiles are
    assert(p50_us(&rec) == 10000);
    assert(p99_us(&rec) == 10000);
    assert(p50_ms(&rec) == 10);
    assert(p99_ms(&rec) == 10);
    // the verdict the M3 row means: 3600 frames, 0 dropped, both budgets met -- PASS
    assert(window_verdict(&rec) == VERDICT_PASS);
}

test "one 40 ms hiccup drops its frame and fails the gate while both percentiles still pass" {
    var rec : FrameRecord = undefined;
    assert(frame_reset(&rec) == FRAME_OK);
    // the same perfect minute, except tick 1800's paint takes 40 ms instead of 10
    var k : u32 = 1;
    while (k <= WINDOW_FRAMES) {
        var c = due_at_us(k) + 10000;
        if (k == 1800) { c = due_at_us(k) + 40000; }
        assert(frame_record(&rec, k, c) == FRAME_OK);
        k = k + 1;
    }
    // the hiccup's arithmetic: 30,023,933 us completed against a 30,000,600 us deadline -- past
    // the NEXT due tick, whatever it painted
    assert(rec.completed_at[1799] == 30023933);
    var dl : u32 = deadline_us(1800);
    assert(dl == 30000600);
    assert(rec.completed_at[1799] > dl);
    assert(rec.dropped[1799] == DROPPED_LATE);
    // the clock did not move for the painter: tick 1801 is still due on schedule and still on
    // time -- drops do not cascade
    assert(rec.due_tick[1800] == 1801);
    assert(rec.dropped[1800] == FRAME_ON_TIME);
    // the window ran complete: 3600 frames, exactly one of them dropped
    assert(frames_total(&rec) == 3600);
    assert(frames_dropped(&rec) == 1);
    // BOTH percentile budgets pass -- 3599 ten-millisecond frames bury one 40 ms outlier
    assert(p50_us(&rec) == 10000);
    assert(p99_us(&rec) == 10000);
    assert(p50_us(&rec) <= P50_BUDGET_US);
    assert(p99_us(&rec) <= P99_BUDGET_US);
    // and the verdict is FAIL. THE LAW'S DECISION, stated: a dropped frame IS the miss. The M3
    // criterion says 0 dropped frames, and no percentile over the survivors may average the one
    // frame the viewer lost back into a pass.
    assert(window_verdict(&rec) == VERDICT_FAIL);
}

test "the drop rule is the deadline, exactly, and a never-painted tick is a drop" {
    var rec : FrameRecord = undefined;
    assert(frame_reset(&rec) == FRAME_OK);
    // completion exactly AT the deadline made the frame: the next tick had not passed
    assert(frame_record(&rec, 1, deadline_us(1)) == FRAME_OK);
    assert(rec.dropped[0] == FRAME_ON_TIME);
    // one microsecond past it, and the frame missed the schedule
    assert(frame_record(&rec, 2, deadline_us(2) + 1) == FRAME_OK);
    assert(rec.dropped[1] == DROPPED_LATE);
    // no completion at all: the honest marker for a tick the browser never painted, recorded
    // without complaint and counted as a drop
    assert(frame_record(&rec, 3, 0) == FRAME_OK);
    assert(rec.dropped[2] == DROPPED_NEVER);
    // the rule, directly, at the edges
    assert(frame_classify(1, 0) == DROPPED_NEVER);
    assert(frame_classify(1, 1) == FRAME_ON_TIME);
    assert(frame_classify(1, deadline_us(1)) == FRAME_ON_TIME);
    assert(frame_classify(1, deadline_us(1) + 1) == DROPPED_LATE);
    assert(frame_classify(3600, WINDOW_US) == FRAME_ON_TIME);
    assert(frame_classify(3600, WINDOW_US + 1) == DROPPED_LATE);
    // a late frame's latency is measured from its own due tick, however late it ran
    assert(frame_latency_us(2, rec.completed_at[1]) == 16668);
    // the stored flags agree with the law's recount: two drops, one late and one never
    assert(frames_dropped(&rec) == 2);
    // three rows of a 3600-frame window: clean prefix, incomplete window -- PARTIAL, never PASS
    assert(window_verdict(&rec) == VERDICT_PARTIAL);
}

test "the nearest-rank percentiles match hand-computed fixtures" {
    // the ranks first: ceil(p * n / 100) in integer math, at the edges and on the window itself
    assert(nearest_rank(1, 99) == 1);
    assert(nearest_rank(2, 50) == 1);      // an even pair: the LOWER -- no interpolation
    assert(nearest_rank(2, 99) == 2);
    assert(nearest_rank(3, 50) == 2);
    assert(nearest_rank(3, 99) == 3);
    assert(nearest_rank(4, 50) == 2);      // odd/even differ: 4 values rank 2, 3 values rank 2
    assert(nearest_rank(4, 99) == 4);
    assert(nearest_rank(5, 50) == 3);
    assert(nearest_rank(5, 99) == 5);
    assert(nearest_rank(100, 50) == 50);
    assert(nearest_rank(100, 99) == 99);
    assert(nearest_rank(3600, 1) == 36);
    assert(nearest_rank(3600, 50) == 1800);
    assert(nearest_rank(3600, 99) == 3564);
    assert(nearest_rank(3600, 100) == 3600);
    assert(nearest_rank(3600, 0) == 1);    // p = 0 clamps to the smallest
    // odd count: {10, 20, 30} -- p50 is the middle, p99 the max
    var odd : [3]u32 = [30, 10, 20];
    assert(percentile_nearest_rank(odd[0..3], 3, 50) == 20);
    assert(percentile_nearest_rank(odd[0..3], 3, 99) == 30);
    assert(percentile_nearest_rank(odd[0..3], 3, 0) == 10);
    assert(percentile_nearest_rank(odd[0..3], 3, 100) == 30);
    // even count: {10, 20, 30, 40} -- p50 is 20, the second of four, NOT an averaged 25
    var even : [4]u32 = [40, 10, 30, 20];
    assert(percentile_nearest_rank(even[0..4], 4, 50) == 20);
    assert(percentile_nearest_rank(even[0..4], 4, 99) == 40);
    // one value: every percentile of one frame is that frame
    var one : [1]u32 = [7];
    assert(percentile_nearest_rank(one[0..1], 1, 50) == 7);
    assert(percentile_nearest_rank(one[0..1], 1, 99) == 7);
    // five values, shuffled in: p50 the median, p99 the max
    var five : [5]u32 = [50, 10, 40, 20, 30];
    assert(percentile_nearest_rank(five[0..5], 5, 50) == 30);
    assert(percentile_nearest_rank(five[0..5], 5, 99) == 50);
    // a hundred-value permutation (37 and 100 share no factor), sorted in place by the first
    // call: p50 is 50, p99 is 99, p1 is 1, and the sort is ascending afterwards
    var hundred : [100]u32 = [0] ** 100;
    var i : u32 = 0;
    while (i < 100) {
        hundred[i as usize] = rem100(i * 37) + 1;
        i = i + 1;
    }
    assert(percentile_nearest_rank(hundred[0..100], 100, 50) == 50);
    assert(percentile_nearest_rank(hundred[0..100], 100, 99) == 99);
    assert(percentile_nearest_rank(hundred[0..100], 100, 1) == 1);
    assert(hundred[0] == 1);
    assert(hundred[99] == 100);
    // empty: no percentile exists, and 0 is returned rather than invented
    var none : [1]u32 = [0];
    assert(percentile_nearest_rank(none[0..0], 0, 50) == 0);
    // and over a RECORD: three completed frames of 9, 12 and 16 ms plus one never painted --
    // the percentiles run over the three completions only, in sorted order 9, 12, 16. The
    // latencies sit inside one period each: a frame finishing after its deadline is a dropped
    // frame by the rule above, so every on-time latency is at most 16,667 us.
    var rec : FrameRecord = undefined;
    assert(frame_reset(&rec) == FRAME_OK);
    assert(frame_record(&rec, 1, 9000) == FRAME_OK);          // latency 9,000 us
    assert(frame_record(&rec, 2, 16667 + 12000) == FRAME_OK); // latency 12,000 us
    assert(frame_record(&rec, 3, 33334 + 16000) == FRAME_OK); // latency 16,000 us
    assert(frame_record(&rec, 4, 0) == FRAME_OK);             // never painted: no latency
    var lat : [4]u32 = [0] ** 4;
    assert(completed_latencies(&rec, lat[0..4], 4) == 3);
    assert(p50_us(&rec) == 12000);
    assert(p99_us(&rec) == 16000);
    assert(p50_ms(&rec) == 12);
    assert(p99_ms(&rec) == 16);
    assert(frames_dropped(&rec) == 1);     // the never-painted tick stays a drop
}

test "a short window is PARTIAL, never a pass, however green its rows" {
    // an empty record ran nothing
    var rec : FrameRecord = undefined;
    assert(frame_reset(&rec) == FRAME_OK);
    assert(window_verdict(&rec) == VERDICT_PARTIAL);
    assert(window_verdict(&rec) != VERDICT_PASS);
    // 3599 perfect frames: 0 dropped, both budgets met, every row green -- and the verdict is
    // still not a pass. The M3 claim is a minute of frames; 3599 prove 59.98 seconds.
    assert(record_perfect_frames(&rec, WINDOW_FRAMES - 1, 10000) == FRAME_OK);
    assert(frames_total(&rec) == 3599);
    assert(frames_dropped(&rec) == 0);
    assert(p50_us(&rec) == 10000);
    assert(p99_us(&rec) == 10000);
    assert(p50_us(&rec) <= P50_BUDGET_US);
    assert(p99_us(&rec) <= P99_BUDGET_US);
    assert(window_verdict(&rec) == VERDICT_PARTIAL);
    assert(window_verdict(&rec) != VERDICT_PASS);
    // the 3600th row completes the experiment, and the same green window becomes a pass
    assert(frame_record(&rec, WINDOW_FRAMES, due_at_us(WINDOW_FRAMES) + 10000) == FRAME_OK);
    assert(frames_total(&rec) == 3600);
    assert(window_verdict(&rec) == VERDICT_PASS);
}

test "a skipped tick cannot be stepped over, and the window refuses overflow" {
    var rec : FrameRecord = undefined;
    assert(frame_reset(&rec) == FRAME_OK);
    assert(record_perfect_frames(&rec, 1799, 10000) == FRAME_OK);
    // the report claims tick 1801 while 1800 is due: refused at the gap, nothing written
    assert(frame_record(&rec, 1801, due_at_us(1801) + 10000) == E_SEQUENCE);
    assert(frames_total(&rec) == 1799);
    // the honest path: tick 1800's own row, a never-completed marker, because the browser
    // painted nothing for it -- the row EXISTS, which is the point
    assert(frame_record(&rec, 1800, 0) == FRAME_OK);
    assert(rec.dropped[1799] == DROPPED_NEVER);
    // and now 1801 is accepted, and a repeat of it is not
    assert(frame_record(&rec, 1801, due_at_us(1801) + 10000) == FRAME_OK);
    assert(frame_record(&rec, 1801, due_at_us(1801) + 10000) == E_SEQUENCE);
    assert(frames_total(&rec) == 1801);
    // complete the window with tick 1800 missing its frame forever: the run FAILS the zero
    // gate -- one never-painted frame is a dropped frame
    var k : u32 = 1802;
    while (k <= WINDOW_FRAMES) {
        assert(frame_record(&rec, k, due_at_us(k) + 10000) == FRAME_OK);
        k = k + 1;
    }
    assert(frames_total(&rec) == 3600);
    assert(frames_dropped(&rec) == 1);
    assert(window_verdict(&rec) == VERDICT_FAIL);
    // the window holds exactly 3600 rows; a 3601st is refused, never wrapped
    assert(frame_record(&rec, 3601, due_at_us(3601) + 10000) == E_WINDOW_FULL);
    assert(frames_total(&rec) == 3600);
}

test "a record that lies about time is refused, at write and at verdict" {
    var rec : FrameRecord = undefined;
    assert(frame_reset(&rec) == FRAME_OK);
    assert(frame_record(&rec, 1, 8000) == FRAME_OK);
    // a completion before the frame was due -- a paint cannot end before its frame exists
    assert(frame_record(&rec, 2, 1) == E_TIMESTAMP);
    assert(frames_total(&rec) == 1);
    // a completion past the guard: not a late frame, a lost run
    assert(frame_record(&rec, 2, LATE_GUARD_US + 1) == E_TIMESTAMP);
    assert(frames_total(&rec) == 1);
    assert(frame_record(&rec, 2, LATE_GUARD_US) == FRAME_OK);  // at the guard is the edge: taken
    // the verdict re-derives everything from the columns, so an ASSEMBLED record (a lab report
    // read back) is judged by the same law its writes were
    var bad : FrameRecord = undefined;
    assert(frame_reset(&bad) == FRAME_OK);
    // completions are ABSOLUTE instants, not latencies: tick 1 is due at 0, tick 2 at 16,667
    assert(frame_record(&bad, 1, 8000) == FRAME_OK);
    assert(frame_record(&bad, 2, 40667) == FRAME_OK);
    // a hole: row 2 claims tick 3 while the row law says row 2 is tick 2
    bad.due_tick[1] = 3;
    assert(window_verdict(&bad) == VERDICT_REFUSED);
    assert(window_verdict(&bad) != VERDICT_PASS);
    // the same two rows, honest: a clean prefix of a 3600-frame window is PARTIAL, not refused
    bad.due_tick[1] = 2;
    assert(window_verdict(&bad) == VERDICT_PARTIAL);
    // a lying timestamp assembled in: row 2 painted before tick 2 was due, nonzero
    bad.completed_at[1] = 100;
    assert(window_verdict(&bad) == VERDICT_REFUSED);
    // and a timestamp past the guard, assembled in: a lost run, refused
    bad.completed_at[1] = LATE_GUARD_US + 1;
    assert(window_verdict(&bad) == VERDICT_REFUSED);
    // the stored dropped flag cannot save a late frame: the aggregate recomputes from the
    // timestamps and never reads the flag column
    var lie : FrameRecord = undefined;
    assert(frame_reset(&lie) == FRAME_OK);
    assert(frame_record(&lie, 1, deadline_us(1) + 5000) == FRAME_OK);
    assert(lie.dropped[0] == DROPPED_LATE);
    lie.dropped[0] = FRAME_ON_TIME;        // the report's flag now claims on-time
    assert(frames_dropped(&lie) == 1);     // the law disagrees, from the timestamp alone
}

// ---- invariants -----------------------------------------------------------------------------------------

invariant the_window_is_sixty_display_seconds {
    assert(FPS == 60);
    assert(WINDOW_SECONDS == 60);
    assert(WINDOW_FRAMES == FPS * WINDOW_SECONDS);
    assert(WINDOW_FRAMES == 3600);
    assert(FRAME_PERIOD_US == 16667);
    assert(WINDOW_US == WINDOW_FRAMES * FRAME_PERIOD_US);
    assert(WINDOW_US == 60001200);
    assert(LATE_GUARD_US == 2 * WINDOW_US);
    assert(LATE_GUARD_US < 4294967295);
    assert(P50_BUDGET_US == P50_BUDGET_MS * 1000);
    assert(P99_BUDGET_US == P99_BUDGET_MS * 1000);
    assert(P50_BUDGET_US < P99_BUDGET_US);
    assert(FRAME_PERIOD_US != COALESCE_MS * 1000);   // the display's tick is not the wire window
    assert(MEASURED_ON == "railway-lab");
    assert(MEASURE_HARNESS == "headless browser vs t27-mcp --watch");
    assert(HAS_LOCAL_MEASURE == false);
    assert(LAB_RUN_DONE == false);         // no browser run yet; flips only in the PR that has one
}

invariant the_codes_and_the_record_name_their_card {
    assert(FRAME_OK == 0);
    assert(E_WINDOW_FULL != E_SEQUENCE);
    assert(E_SEQUENCE != E_TIMESTAMP);
    assert(E_TIMESTAMP != E_WINDOW_FULL);
    assert(FRAME_ON_TIME == 0);
    assert(DROPPED_LATE == 1);
    assert(DROPPED_NEVER == 2);
    assert(DROPPED_LATE != DROPPED_NEVER);
    assert(VERDICT_PASS == 0);
    assert(VERDICT_FAIL == 1);
    assert(VERDICT_PARTIAL == 2);
    assert(VERDICT_REFUSED == 3);
    assert(FRAME_CODE_NAMES.len == 4);
    assert(VERDICT_NAMES.len == 4);
}
