// SPDX-License-Identifier: Apache-2.0
// specs/numeric/formats.t27
// Format Conversion Utilities - GF16, f32, ternary encoding
// phi^2 + 1/phi^2 = 3 | TRINITY

module Formats {
    // ========================================================================
    // IMPORTS - Reference existing specs, DO NOT DUPLICATE
    // ========================================================================
    use base::types;
    use numeric::gf16;

    // ========================================================================
    // 1. GF16 Bit Layout Constants
    // ========================================================================
    //
    // GF16 bit layout (as specified in whitepaper):
    //   [S(1) E(6) M(9)] = [15:15][14:9][8:0]
    //
    // - Sign: bit 15 (0x8000)
    // - Exponent: bits 14-9 (0x7E00), bias = 31
    // - Mantissa: bits 8-0 (0x01FF)
    //
    // Range: 2^-31 to 2^32
    // ========================================================================

    pub const SignMask : u16 = 0x8000;
    pub const ExpMask : u16 = 0x7E00;
    pub const MantMask : u16 = 0x01FF;

    pub const ExpShift : u5 = 9;
    pub const SignShift : u4 = 15;
    pub const Bias : i32 = 31;

    pub const ExpMax : u16 = 63;
    pub const ExpMin : u16 = 0;

    // ========================================================================
    // 2. GF16 -> f32 (decode)
    // ========================================================================
    //
    // Converts GF16 encoding to IEEE 754 binary32 floating point.
    // Handles signed zero, denormals, normals, infinities, and NaN.
    // ========================================================================

    // gf16_to_f32(x: u16) -> gf16
    // Decode GF16 to f32
    //
    // Algorithm:
    //   1. Extract sign (bit 15)
    //   2. Extract exponent (bits 14-9) and mantissa (bits 8-0)
    //   3. Handle special cases:
    //      - e=0, m=0: signed zero
    //      - e=0, m!=0: denormal (subnormal)
    //      - e=ExpMax, m=0: +/- infinity
    //      - e=ExpMax, m!=0: NaN
    //   4. Normal case:
    //      value = (-1)^s * (1 + m/2^9) * 2^(e - Bias)
    //
    // Complexity: O(1)
    pub fn gf16_to_f32(x: u16) -> gf16 {
    // Extract sign, exponent, mantissa
    const sign_bit = x & SignMask;
    const exponent = (x & ExpMask) >> ExpShift;
    const mantissa = x & MantMask;
    
    // Handle special cases
    if (exponent == ExpMin) {
        if (mantissa == 0) {
            // Signed zero
            return if (sign_bit != 0) gf16.from_f64(-0.0) else gf16.from_f64(0.0);
        } else {
            // Denormal (subnormal)
            const m = @intToFloat(f32, mantissa) / 512.0;  // 2^9
            const value = m * std.math.pow(f32, 2.0, @intToFloat(f32, exponent - Bias + 1));
            return if (sign_bit != 0) gf16.from_f64(-value) else gf16.from_f64(value);
        }
    } else if (exponent == ExpMax) {
        if (mantissa == 0) {
            // Infinity
            return if (sign_bit != 0) gf16.from_f64(-std.math.inf(f32)) else gf16.from_f64(std.math.inf(f32));
        } else {
            // NaN
            return gf16.from_f64(std.math.nan(f32));
        }
    } else {
        // Normal number
        const m = 1.0 + @intToFloat(f32, mantissa) / 512.0;  // 1 + m/2^9
        const value = m * std.math.pow(f32, 2.0, @intToFloat(f32, exponent - Bias));
        return if (sign_bit != 0) gf16.from_f64(-value) else gf16.from_f64(value);
    }
}

    // ========================================================================
    // 3. f32 -> GF16 (encode, round-to-nearest)
    // ========================================================================
    //
    // Converts IEEE 754 binary32 floating point to GF16 encoding.
    // Handles signed zero, special cases, overflow, and underflow.
    //
    // Algorithm:
    //   1. Handle signed zero explicitly (sign bit preserved)
    //   2. Handle special cases (Inf, NaN)
    //   3. Get exponent and mantissa via frexp: abs = m * 2^e, m in [0.5, 1]
    //   4. Normalize: want 1.x * 2^(E - Bias), frexp gives m in [0.5, 1]
    //   5. Mantissa: (m - 1.0) * 2^9, round to nearest
    //   6. Check underflow/overflow
    //
    // Complexity: O(1)
    pub fn f32_to_gf16(a: f32) -> u16 {
    // Handle signed zero explicitly
    if (a == 0.0) {
        return 0;  // Positive zero
    } else if (a == -0.0) {
        return 0x8000;  // Negative zero
    }
    
    // Handle special cases
    if (std.math.isInf(a)) {
        return if (a > 0.0) 0x7E00 else 0xFE00;  // +/- infinity
    } else if (std.math.isNan(a)) {
        return 0x7F01;  // NaN
    }
    
    // Get exponent and mantissa via frexp: abs = m * 2^e, m in [0.5, 1]
    var m: f32 = undefined;
    var e: i32 = undefined;
    _ = std.math.frexp(a, &m, &e);
    
    // Normalize: want 1.x * 2^(E - Bias), frexp gives m in [0.5, 1]
    // Adjust exponent bias and check for overflow/underflow
    const adjusted_exponent = e - Bias;
    
    if (adjusted_exponent <= ExpMin) {
        // Underflow - return zero
        return 0;
    } else if (adjusted_exponent >= ExpMax) {
        // Overflow - return infinity
        return 0x7E00;
    }
    
    // Mantissa: (m - 1.0) * 2^9, round to nearest
    const normalized_mantissa = (m - 1.0) * 512.0;  // 2^9
    const rounded_mantissa = @floatToInt(u16, @round(normalized_mantissa));
    
    // Pack into GF16 format
    var result: u16 = @intCast(u16, adjusted_exponent) << ExpShift;
    result |= rounded_mantissa & MantMask;
    
    // Set sign bit if negative
    if (a < 0.0) {
        result |= SignMask;
    }
    
    return result;
}

    // ========================================================================
    // 4. Ternary Quantization
    // ========================================================================
    //
    // Ternary quantization: maps f32 to ternary {-1, 0, +1}
    // Threshold: |w| > 0.5 -> +/-1, else -> 0
    //
    // WHY: Enables efficient ternary representation of continuous values
    // Useful for VSA (Vector Symbolic Architecture) operations
    // ========================================================================

    // f32_to_ternary(x: f32) -> Trit
    // Quantize f32 to ternary {-1, 0, +1}
    //
    // Algorithm:
    //   - If x > 0.5: return +1
    //   - If x < -0.5: return -1
    //   - Otherwise: return 0
    //
    // Complexity: O(1)
    pub fn f32_to_ternary(x: f32) -> Trit {
    // If x > 0.5: return +1
    if (x > 0.5) {
        return .pos;
    }
    
    // If x < -0.5: return -1
    if (x < -0.5) {
        return .neg;
    }
    
    // Otherwise: return 0
    return .zero;
}

    // ternary_to_f32(t: Trit) -> gf16
    // Convert ternary to f32
    //
    // Mapping: -1 -> -1.0, 0 -> 0.0, +1 -> 1.0
    // Complexity: O(1)
    pub fn ternary_to_f32(t: Trit) -> gf16 {
    // Mapping: -1 -> -1.0, 0 -> 0.0, +1 -> 1.0
    return switch (t) {
        .neg => gf16.from_f64(-1.0),
        .zero => gf16.from_f64(0.0),
        .pos => gf16.from_f64(1.0),
    };
}

    // ========================================================================
    // 5. Format Enum
    // ========================================================================

    pub const Format = enum(u8) {
        fp32,
        fp16,
        bf16,
        gf16,
        ternary,
    };

    // format_bytes(fmt: Format) -> usize
    // Returns byte size for each format
    //
    // Complexity: O(1)
    pub fn format_bytes(fmt: Format) -> usize {
    return switch (fmt) {
        .fp32 => 4,   // 32-bit floating point = 4 bytes
        .fp16 => 2,   // 16-bit floating point = 2 bytes
        .bf16 => 2,   // bfloat16 = 2 bytes
        .gf16 => 2,   // 16-bit GF16 format = 2 bytes
        .ternary => 1, // Ternary = 1 byte (can store multiple trits)
    };
}

    // ========================================================================
    // 6. Quantization Utility
    // ========================================================================

    // quantize_value(x: f32, fmt: Format) -> gf16
    // Quantize f32 to target format
    //
    // Complexity: O(1)
    pub fn quantize_value(x: f32, fmt: Format) -> gf16 {
    return switch (fmt) {
        .fp32 => gf16.from_f64(x),  // Quantizing to fp32 preserves value
        .fp16 => gf16.from_f64(x),  // Convert to f16 then to gf16 (simplified)
        .bf16 => gf16.from_f64(x),  // Convert to bf16 then to gf16 (simplified)
        .gf16 => f32_to_gf16(x),   // Direct encoding to GF16
        .ternary => ternary_to_f32(f32_to_ternary(x)),  // Quantize to ternary then convert back
    };
}

    // ========================================================================
    // TDD - Tests
    // ========================================================================

    test gf16_to_f32_zero_positive {
        // Verify: zero encodes to zero
        const x : u16 = 0;
        const result = gf16_to_f32(x);
        assert(gf16.to_f64(result) == 0.0);
    }

    test gf16_to_f32_zero_negative {
        // Verify: negative zero encodes to -0
        const x : u16 = 0x8000;
        const result = gf16_to_f32(x);
        assert(gf16.to_f64(result) == -0.0);
    }

    test gf16_to_f32_denormal {
        // Verify: denormal value decodes to small positive
        const x : u16 = 0x0080;
        const result = gf16_to_f32(x);
        const val = gf16.to_f64(result);
        assert(val > 0.0 and val < 1.0);
    }

    test gf16_to_f32_normal_one {
        // Verify: 1.0 encodes correctly
        const x : u16 = 0x3C00;
        const result = gf16_to_f32(x);
        const decoded = gf16.to_f64(result);
        assert(decoded == 1.0);
    }

    test gf16_to_f32_positive_inf {
        // Verify: positive infinity encodes correctly
        const x : u16 = 0x7E00;
        const result = gf16_to_f32(x);
        const decoded = gf16.to_f64(result);
        assert(decoded == std.math.inf(f32));
    }

    test gf16_to_f32_negative_inf {
        // Verify: negative infinity encodes correctly
        const x : u16 = 0xFE00;
        const result = gf16_to_f32(x);
        const decoded = gf16.to_f64(result);
        assert(decoded == -std.math.inf(f32));
    }

    test gf16_to_f32_nan {
        // Verify: NaN encodes to NaN
        const x : u16 = 0x7F01;
        const result = gf16_to_f32(x);
        assert(result != result);  // NaN check
    }

    test f32_to_gf16_zero_positive {
        // Verify: +0 encodes to 0
        const a : f32 = 0.0;
        const result = f32_to_gf16(a);
        assert(result == 0);
    }

    test f32_to_gf16_zero_negative {
        // Verify: -0 encodes to 0x8000
        const a : f32 = -0.0;
        const result = f32_to_gf16(a);
        assert(result == 0x8000);
    }

    test f32_to_gf16_one {
        // Verify: 1.0 encodes and roundtrips correctly
        const a : f32 = 1.0;
        const encoded = f32_to_gf16(a);
        const decoded = gf16_to_f32(encoded);
        const recovered = gf16.to_f64(decoded);
        assert(recovered >= 0.99 and recovered <= 1.01);
    }

    test f32_to_gf16_inf_positive {
        // Verify: +Inf encodes to 0x7E00
        const a : f32 = std.math.inf(f32);
        const result = f32_to_gf16(a);
        assert(result == 0x7E00);
    }

    test f32_to_gf16_inf_negative {
        // Verify: -Inf encodes to 0xFE00
        const a : f32 = -std.math.inf(f32);
        const result = f32_to_gf16(a);
        assert(result == 0xFE00);
    }

    test f32_to_gf16_nan {
        // Verify: NaN encodes to 0x7F01
        const a : f32 = std.math.nan(f32);
        const result = f32_to_gf16(a);
        assert(result == 0x7F01);
    }

    test f32_to_ternary_positive {
        // Verify: 1.0 quantizes to pos
        const a : f32 = 1.0;
        const result = f32_to_ternary(a);
        assert(result == .pos);
    }

    test f32_to_ternary_zero {
        // Verify: 0.0 quantizes to zero
        const a : f32 = 0.0;
        const result = f32_to_ternary(a);
        assert(result == .zero);
    }

    test f32_to_ternary_negative {
        // Verify: -1.0 quantizes to neg
        const a : f32 = -1.0;
        const result = f32_to_ternary(a);
        assert(result == .neg);
    }

    test f32_to_ternary_threshold {
        // Verify: 0.6 quantizes to pos (above 0.5 threshold)
        const a : f32 = 0.6;
        const result = f32_to_ternary(a);
        assert(result == .pos);
    }

    test f32_to_ternary_negative_threshold {
        // Verify: -0.6 quantizes to neg (below -0.5 threshold)
        const a : f32 = -0.6;
        const result = f32_to_ternary(a);
        assert(result == .neg);
    }

    test ternary_to_f32_positive {
        // Verify: pos maps to 1.0
        const t : Trit = .pos;
        const result = ternary_to_f32(t);
        const result_val = gf16.to_f64(result);
        assert(result_val == 1.0);
    }

    test ternary_to_f32_zero {
        // Verify: zero maps to 0.0
        const t : Trit = .zero;
        const result = ternary_to_f32(t);
        const result_val = gf16.to_f64(result);
        assert(result_val == 0.0);
    }

    test ternary_to_f32_negative {
        // Verify: neg maps to -1.0
        const t : Trit = .neg;
        const result = ternary_to_f32(t);
        const result_val = gf16.to_f64(result);
        assert(result_val == -1.0);
    }

    test format_bytes_fp32 {
        // Verify: fp32 is 4 bytes
        const result = format_bytes(.fp32);
        assert(result == 4);
    }

    test format_bytes_fp16 {
        // Verify: fp16 is 2 bytes
        const result = format_bytes(.fp16);
        assert(result == 2);
    }

    test format_bytes_ternary {
        // Verify: ternary is 1 byte
        const result = format_bytes(.ternary);
        assert(result == 1);
    }

    test quantize_value_fp32 {
        // Verify: quantizing to fp32 preserves value
        const x : f32 = 1.5;
        const result = quantize_value(x, .fp32);
        const result_val = gf16.to_f64(result);
        assert(result_val >= 1.49 and result_val <= 1.51);
    }

    test quantize_value_ternary {
        // Verify: quantizing to ternary gives +1
        const x : f32 = 1.5;
        const result = quantize_value(x, .ternary);
        const expected = ternary_to_f32(.pos);
        assert(result == expected);
    }

    test gf16_to_f32_normal_small {
        // Verify: small normal value decodes correctly
        const x : u16 = 0x3C01;  // Small normal
        const result = gf16_to_f32(x);
        const val = gf16.to_f64(result);
        assert(val > 0.0 and val < 2.0);
    }

    test f32_to_gf16_small_value {
        // Verify: small value encodes correctly
        const a : f32 = 0.1;
        const encoded = f32_to_gf16(a);
        const decoded = gf16_to_f32(encoded);
        const recovered = gf16.to_f64(decoded);
        assert(recovered >= 0.09 and recovered <= 0.11);
    }

    test f32_to_ternary_edge_cases {
        // Verify: edge cases around threshold boundaries
        const a1 : f32 = 0.5;   // At positive threshold
        const a2 : f32 = -0.5;  // At negative threshold
        const r1 = f32_to_ternary(a1);
        const r2 = f32_to_ternary(a2);
        assert(r1 == .pos);  // 0.5 should be positive
        assert(r2 == .neg);  // -0.5 should be negative
    }

    test ternary_to_f32_roundtrip {
        // Verify: ternary conversion is reversible
        const test_values = [3]Trit{ .neg, .zero, .pos };
        for (0..3) |i| {
            const t = test_values[i];
            const f = ternary_to_f32(t);
            const t_back = f32_to_ternary(gf16.to_f64(f));
            assert(t_back == t);
        }
    }

    test format_bytes_all_formats {
        // Verify: all format byte sizes are correct
        assert(format_bytes(.fp32) == 4);
        assert(format_bytes(.fp16) == 2);
        assert(format_bytes(.bf16) == 2);
        assert(format_bytes(.gf16) == 2);
        assert(format_bytes(.ternary) == 1);
    }

    test quantize_value_all_formats {
        // Verify: quantization works for all formats
        const test_value : f32 = 3.14;
        
        // fp32 should preserve value closely
        const fp32_result = quantize_value(test_value, .fp32);
        const fp32_val = gf16.to_f64(fp32_result);
        assert(std.math.approxEqAbs(f64, fp32_val, test_value, 0.01));
        
        // ternary should quantize to nearest
        const ternary_result = quantize_value(test_value, .ternary);
        const ternary_val = gf16.to_f64(ternary_result);
        assert(ternary_val == 1.0 or ternary_val == 0.0 or ternary_val == -1.0);
    }

    // ========================================================================
    // TDD - Invariants
    // ========================================================================

    invariant gf16_to_f32_preserves_zero {
        // Zero should decode to zero
        assert(gf16.to_f64(gf16_to_f32(0)) == 0.0);
        assert(gf16.to_f64(gf16_to_f32(0x8000)) == -0.0);
    }

    invariant gf16_to_f32_preserves_infinity {
        // Infinity should decode to infinity
        assert(gf16.to_f64(gf16_to_f32(0x7E00)) == std.math.inf(f32));
        assert(gf16.to_f64(gf16_to_f32(0xFE00)) == -std.math.inf(f32));
    }

    invariant f32_to_gf16_roundtrip_loss {
        // Roundtrip should be within tolerance for normal values
        const original = gf16.from_f64(1.5);
        const encoded = f32_to_gf16(gf16.to_f64(original));
        const decoded = gf16_to_f32(encoded);
        const error = gf16.abs(gf16.sub(original, decoded));
        assert(gf16.to_f64(error) < gf16.from_f64(0.01));
    }

    invariant ternary_quantization_symmetric {
        // Quantization threshold is symmetric
        const p = f32_to_ternary(0.5);
        const n = f32_to_ternary(-0.5);
        const p_decoded = ternary_to_f32(p);
        const n_decoded = ternary_to_f32(n);
        assert(gf16.to_f64(p_decoded) == -gf16.to_f64(n_decoded));
    }

    invariant ternary_to_f32_is_inverse {
        // ternary_to_f32 is inverse of f32_to_ternary
        const values = [5]f32{ -1.0, -0.5, 0.0, 0.5, 1.0 };
        for i in 0..5 {
            const v = values[i];
            const t = f32_to_ternary(v);
            const recovered = ternary_to_f32(t);
            const diff = gf16.abs(gf16.sub(v, recovered));
            assert(gf16.eq(v, recovered) or (gf16.to_f64(diff) < gf16.from_f64(0.01)));
        }
    }

    invariant format_bytes_positive {
        // All format byte sizes should be positive
        assert(format_bytes(.fp32) > 0);
        assert(format_bytes(.fp16) > 0);
        assert(format_bytes(.ternary) > 0);
    }

    // ========================================================================
    // TDD - Benchmarks
    // ========================================================================

    bench gf16_to_f32_latency {
        // Measure: cycles for gf16_to_f32 conversion
        // Target: < 50 cycles (simple bit extraction + lookup)
        @setEvalBranchQuota(10000);
        var result : gf16;
        const test_value: u16 = 0x3C00;
        for _ in 0..1000 {
            result = gf16_to_f32(test_value);
        }
        _ = result;
    }

    bench f32_to_gf16_latency {
        // Measure: cycles for f32_to_gf16 conversion
        // Target: < 100 cycles (frexp + bit packing)
        @setEvalBranchQuota(10000);
        var result : u16;
        const test_value: f32 = 1.5;
        for _ in 0..1000 {
            result = f32_to_gf16(test_value);
        }
        _ = result;
    }

    bench f32_to_ternary_latency {
        // Measure: cycles for f32_to_ternary conversion
        // Target: < 10 cycles (single comparison)
        @setEvalBranchQuota(10000);
        var result : Trit;
        const test_value: f32 = 0.75;
        for _ in 0..1000 {
            result = f32_to_ternary(test_value);
        }
        _ = result;
    }

    bench ternary_to_f32_latency {
        // Measure: cycles for ternary_to_f32 conversion
        // Target: < 10 cycles (simple switch)
        @setEvalBranchQuota(10000);
        var result : gf16;
        const test_trit: Trit = .pos;
        for _ in 0..1000 {
            result = ternary_to_f32(test_trit);
        }
        _ = result;
    }
}
