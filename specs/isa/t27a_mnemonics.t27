// SPDX-License-Identifier: Apache-2.0
; specs/isa/t27a_mnemonics.t27 -- T27a mnemonics table for assembler/disassembler round-trip
; Maps table index to opcode byte and back, so both read the same table (gHashTag/t27#6488).
; Provides strict decoding that rejects undefined bytes, unlike decode_opcode which maps them to NOP.
; ASCII only (L3).

; phi^2 + 1/phi^2 = 3 | TRINITY

module T27aMnemonics;

use isa::ternary_encoding;

; --- Table index to opcode mapping ----------------------------------------------

; Gives the opcode byte of table index 0..46 in the order of OPCODE_VALUES, and 256 for any other index.
pub fn opcode_at(i: u32) -> u32 {
    if (i == 0) { return 0; }
    if (i == 1) { return 2; }
    if (i == 2) { return 3; }
    if (i == 3) { return 4; }
    if (i == 4) { return 5; }
    if (i == 5) { return 15; }
    if (i == 6) { return 16; }
    if (i == 7) { return 17; }
    if (i == 8) { return 18; }
    if (i == 9) { return 19; }
    if (i == 10) { return 20; }
    if (i == 11) { return 21; }
    if (i == 12) { return 22; }
    if (i == 13) { return 23; }
    if (i == 14) { return 24; }
    if (i == 15) { return 25; }
    if (i == 16) { return 26; }
    if (i == 17) { return 27; }
    if (i == 18) { return 28; }
    if (i == 19) { return 29; }
    if (i == 20) { return 32; }
    if (i == 21) { return 33; }
    if (i == 22) { return 34; }
    if (i == 23) { return 35; }
    if (i == 24) { return 36; }
    if (i == 25) { return 37; }
    if (i == 26) { return 64; }
    if (i == 27) { return 65; }
    if (i == 28) { return 66; }
    if (i == 29) { return 67; }
    if (i == 30) { return 68; }
    if (i == 31) { return 69; }
    if (i == 32) { return 75; }
    if (i == 33) { return 77; }
    if (i == 34) { return 96; }
    if (i == 35) { return 97; }
    if (i == 36) { return 98; }
    if (i == 37) { return 99; }
    if (i == 38) { return 128; }
    if (i == 39) { return 129; }
    if (i == 40) { return 130; }
    if (i == 41) { return 131; }
    if (i == 42) { return 132; }
    if (i == 43) { return 133; }
    if (i == 44) { return 134; }
    if (i == 45) { return 135; }
    if (i == 46) { return 136; }
    return 256;
}

; --- Opcode to table index mapping ----------------------------------------------

; Inverse of opcode_at, gives the table index for a valid opcode and 47 for an undefined byte.
pub fn index_of(op: u32) -> u32 {
    if (op == 0) { return 0; }
    if (op == 2) { return 1; }
    if (op == 3) { return 2; }
    if (op == 4) { return 3; }
    if (op == 5) { return 4; }
    if (op == 15) { return 5; }
    if (op == 16) { return 6; }
    if (op == 17) { return 7; }
    if (op == 18) { return 8; }
    if (op == 19) { return 9; }
    if (op == 20) { return 10; }
    if (op == 21) { return 11; }
    if (op == 22) { return 12; }
    if (op == 23) { return 13; }
    if (op == 24) { return 14; }
    if (op == 25) { return 15; }
    if (op == 26) { return 16; }
    if (op == 27) { return 17; }
    if (op == 28) { return 18; }
    if (op == 29) { return 19; }
    if (op == 32) { return 20; }
    if (op == 33) { return 21; }
    if (op == 34) { return 22; }
    if (op == 35) { return 23; }
    if (op == 36) { return 24; }
    if (op == 37) { return 25; }
    if (op == 64) { return 26; }
    if (op == 65) { return 27; }
    if (op == 66) { return 28; }
    if (op == 67) { return 29; }
    if (op == 68) { return 30; }
    if (op == 69) { return 31; }
    if (op == 75) { return 32; }
    if (op == 77) { return 33; }
    if (op == 96) { return 34; }
    if (op == 97) { return 35; }
    if (op == 98) { return 36; }
    if (op == 99) { return 37; }
    if (op == 128) { return 38; }
    if (op == 129) { return 39; }
    if (op == 130) { return 40; }
    if (op == 131) { return 41; }
    if (op == 132) { return 42; }
    if (op == 133) { return 43; }
    if (op == 134) { return 44; }
    if (op == 135) { return 45; }
    if (op == 136) { return 46; }
    return 47;
}

; --- Strict decoding --------------------------------------------------------------

; Returns the byte for a defined opcode and 256 (invalid) otherwise.
; Unlike decode_opcode which maps undefined bytes to NOP, this rejects them.
pub fn strict_decode(byte: u32) -> u32 {
    if (byte == 0) { return 0; }
    if (byte == 2) { return 2; }
    if (byte == 3) { return 3; }
    if (byte == 4) { return 4; }
    if (byte == 5) { return 5; }
    if (byte == 15) { return 15; }
    if (byte == 16) { return 16; }
    if (byte == 17) { return 17; }
    if (byte == 18) { return 18; }
    if (byte == 19) { return 19; }
    if (byte == 20) { return 20; }
    if (byte == 21) { return 21; }
    if (byte == 22) { return 22; }
    if (byte == 23) { return 23; }
    if (byte == 24) { return 24; }
    if (byte == 25) { return 25; }
    if (byte == 26) { return 26; }
    if (byte == 27) { return 27; }
    if (byte == 28) { return 28; }
    if (byte == 29) { return 29; }
    if (byte == 32) { return 32; }
    if (byte == 33) { return 33; }
    if (byte == 34) { return 34; }
    if (byte == 35) { return 35; }
    if (byte == 36) { return 36; }
    if (byte == 37) { return 37; }
    if (byte == 64) { return 64; }
    if (byte == 65) { return 65; }
    if (byte == 66) { return 66; }
    if (byte == 67) { return 67; }
    if (byte == 68) { return 68; }
    if (byte == 69) { return 69; }
    if (byte == 75) { return 75; }
    if (byte == 77) { return 77; }
    if (byte == 96) { return 96; }
    if (byte == 97) { return 97; }
    if (byte == 98) { return 98; }
    if (byte == 99) { return 99; }
    if (byte == 128) { return 128; }
    if (byte == 129) { return 129; }
    if (byte == 130) { return 130; }
    if (byte == 131) { return 131; }
    if (byte == 132) { return 132; }
    if (byte == 133) { return 133; }
    if (byte == 134) { return 134; }
    if (byte == 135) { return 135; }
    if (byte == 136) { return 136; }
    return 256;
}

; --- Tests ----------------------------------------------------------------------

test index_of_opcode_at_round_trip {
    var i : u32 = 0;
    while (i < 47) {
        assert index_of(opcode_at(i)) == i;
        i = i + 1;
    }
}

test exactly_47_defined_bytes {
    var b : u32 = 0;
    var defined : u32 = 0;
    while (b < 256) {
        if (strict_decode(b) != 256) { defined = defined + 1; }
        b = b + 1;
    }
    assert defined == 47;
}

test exactly_209_rejected_bytes {
    var b : u32 = 0;
    var rejected : u32 = 0;
    while (b < 256) {
        if (strict_decode(b) == 256) { rejected = rejected + 1; }
        b = b + 1;
    }
    assert rejected == 209;
}

test strict_decode_vs_decode_opcode_control {
    assert decode_opcode(1) == OP_NOP;
    assert strict_decode(1) == 256;
}