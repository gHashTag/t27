// Multipath router spec - reproduces dead-code elision bug
pub fn select_path_index(paths: [u32; 4]) -> u32 {
    // This variable might trigger dead-code elision that drops the name
    // leaving just "let mut;" which is invalid syntax
    let mut index: u32 = 0;
    if paths[0] > 0 {
        index = paths[0];
    } else if paths[1] > 0 {
        index = paths[1];
    }
    // index is always used in return, but let's make the compiler think it might not be
    // in some code path to trigger the bug
    return index;
}

// test: select_path_index function
test test_select_path_index {
    // Test with paths[0] > 0: should return paths[0]
    var paths1: [u32; 4] = [5, 0, 0, 0];
    assert select_path_index(paths1) == 5;
    
    // Test with only paths[1] > 0: should return paths[1]
    var paths2: [u32; 4] = [0, 10, 0, 0];
    assert select_path_index(paths2) == 10;
    
    // Test with both paths[0] and paths[1] zero: should return 0
    var paths3: [u32; 4] = [0, 0, 0, 0];
    assert select_path_index(paths3) == 0;
}