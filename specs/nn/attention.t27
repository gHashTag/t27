// SPDX-License-Identifier: Apache-2.0
// t27/specs/nn/attention.t27
// Sacred Attention Specification
// Multi-head attention with φ-RoPE and sacred scaling (d_k^(-φ³))
// φ² + 1/φ² = 3 | TRINITY

module SacredAttention {
    // Import base types, operations, and math constants
    use base::types;
    use base::ops;
    use math::constants;
    use numeric::gf16;

    // ════════════════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════════
    
    // TRINITY-based configuration
    const NUM_HEADS : usize = 3;           // 3 heads (TRINITY)
    const HEAD_DIM : usize = 81;            // 81 dim per head (3⁴)
    const EMBED_DIM : usize = 243;          // Total embedding (3 × 81)
    const CONTEXT_LEN : usize = 81;         // Max sequence length
    const ROPE_PAIRS : usize = 40;          // 81/2 = 40 pairs (1 unrotated)
    
    // Sacred scaling: φ⁻³ and d_k^(-φ³)
    const SACRED_GAMMA : f64 = constants::PHI_CUBED_INV;  // φ⁻³ ≈ 0.236
    const SACRED_SCALE : f64 = pow(81.0, -SACRED_GAMMA); // 81^(-φ⁻³) ≈ 0.354
    
    // Attention types
    const ATTN_CAUSAL : u8 = 0;     // Causal (autoregressive) attention
    const ATTN_BIDIR : u8 = 1;      // Bidirectional attention
    const ATTN_SPARSE : u8 = 2;     // Sparse (local) attention
    
    // Attention phase states
    const PHASE_QUERY : u8 = 0;     // Compute Q projections
    const PHASE_KEY : u8 = 1;       // Compute K projections
    const PHASE_VALUE : u8 = 2;     // Compute V projections
    const PHASE_SCORE : u8 = 3;     // Compute attention scores
    const PHASE_SOFTMAX : u8 = 4;   // Apply softmax
    const PHASE_WEIGHT : u8 = 5;    // Apply to values
    
    // ══════════════════════════════════════════════════════════════════
    // 2. RoPE Tables
    // ════════════════════════════════════════════════════════════════
    // ═══════════════════════════════════════════════════════════════
    
    // φ-RoPE tables: [CONTEXT_LEN × ROPE_PAIRS]
    // Each entry is precomputed cos(p * θ_i) and sin(p * θ_i)
    // where θ_i = φ^(-2i/HEAD_DIM) for i=0..ROPE_PAIRS-1
    struct RoPETables {
        cos : [CONTEXT_LEN * ROPE_PAIRS]f64,
        sin : [CONTEXT_LEN * ROPE_PAIRS]f64,
    }
    
    var rope_tables : RoPETables;
    
    // ═════════════════════════════════════════════════════════════════
    // 3. Attention State
    // ═══════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════
    
    // Attention buffers (allocated per forward pass)
    struct AttentionBuffers {
        q_buffer : [EMBED_DIM]f64,     // Query projections
        k_buffer : [EMBED_DIM]f64,     // Key projections
        v_buffer : [EMBED_DIM]f64,     // Value projections
        scores : [NUM_HEADS * CONTEXT_LEN]f64,  // Attention scores
        concat : [EMBED_DIM]f64,       // Concatenated head outputs
    }
    
    // ════════════════════════════════════════════════════════════════
    // 4. Initialization
    // ═══════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════
    
    // sacred_attention_init() → void
    // Initialize φ-RoPE tables
    // θ_i = φ^(-2i/HEAD_DIM) for i=0..ROPE_PAIRS-1
    // For each position p: cos(p*θ_i), sin(p*θ_i)
    fn sacred_attention_init() -> void {
        var p : usize = 0;
        
        while (p < CONTEXT_LEN) {
            var i : usize = 0;
            
            while (i < ROPE_PAIRS) {
                // Compute freq = φ^(-2i/HEAD_DIM)
                const freq_exponent = -2.0 * (i as f64) / (HEAD_DIM as f64);
                const freq = pow(constants::PHI, freq_exponent);
                
                // angle = position * freq
                const angle = (p as f64) * freq;
                
                // cos and sin
                const cos_val = cos(angle);
                const sin_val = sin(angle);
                
                // Store in tables
                const table_offset = p * ROPE_PAIRS + i;
                rope_tables.cos[table_offset] = cos_val;
                rope_tables.sin[table_offset] = sin_val;
                
                i = i + 1;
            }
            
            p = p + 1;
        }
    }
    
    // ════════════════════════════════════════════════════════════════
    // 5. Main Attention Kernel
    // ══════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════
    
    // sacred_attention_kernel(
    //   input: []f32,              // [EMBED_DIM] input embeddings
    //   w_q: []Trit, w_k: []Trit, w_v: []Trit, w_o: []Trit, // Ternary weights
    //   position: usize,
    //   seq_len: usize,
    //   output: []f32,             // [EMBED_DIM] output
    //   cache_k: []f32, cache_v: []f32,  // [CONTEXT_LEN][EMBED_DIM]
    // ) → void
    // Single position forward pass with sacred scaling
    fn sacred_attention_kernel(
        input: []f64,
        w_q: []Trit, w_k: []Trit, w_v: []Trit, w_o: []Trit,
        position: usize,
        seq_len: usize,
        output: []f64,
        cache_k: []f64, cache_v: []f64,
    ) -> void {
        var buffers = AttentionBuffers{
            .q_buffer = [0.0; EMBED_DIM],
            .k_buffer = [0.0; EMBED_DIM],
            .v_buffer = [0.0; EMBED_DIM],
            .scores = [0.0; NUM_HEADS * CONTEXT_LEN],
            .concat = [0.0; EMBED_DIM],
        };
        
        // Step 1: Project Q, K, V via ternary matmul
        project_qkv(&buffers, input, w_q, w_k, w_v);
        
        // Step 2: Apply φ-RoPE to Q and K
        apply_rope_qk(&buffers, position);
        
        // Step 3: Cache K and V
        cache_kv(&buffers, position, cache_k, cache_v);
        
        // Step 4: Compute attention scores (Q @ K^T * SACRED_SCALE)
        compute_scores(&buffers, position, seq_len, cache_k);
        
        // Step 5: Apply softmax to scores
        apply_softmax(&buffers, seq_len);
        
        // Step 6: Weighted sum of values
        weighted_values(&buffers, seq_len, cache_v);
        
        // Step 7: Output projection via W_o
        project_output(&buffers, w_o, output);
        
        // Step 8: Add residual connection
        add_residual(output, input);
    }
    
    // ═══════════════════════════════════════════════════════════════
    // 6. Q/K/V Projection
    // ══════════════════════════════════════════════════════════════
    // ═════════════════════════════════════════════════════════════
    
    // project_qkv(buffers, input, w_q, w_k, w_v) → void
    // Compute Q, K, V projections using ternary matrix multiplication
    // Q[i] = Σ_j input[j] * W_q[j][i]
    // Using ternary weights: W_q[j][i] ∈ {-1, 0, +1}
    fn project_qkv(
        buffers: *AttentionBuffers,
        input: []f64,
        w_q: []Trit, w_k: []Trit, w_v: []Trit,
    ) -> void {
        // Compute Q
        ternary_matmul(input, w_q, &buffers.q_buffer, EMBED_DIM, EMBED_DIM);
        
        // Compute K
        ternary_matmul(input, w_k, &buffers.k_buffer, EMBED_DIM, EMBED_DIM);
        
        // Compute V
        ternary_matmul(input, w_v, &buffers.v_buffer, EMBED_DIM, EMBED_DIM);
    }
    
    // ternary_matmul(input, weights, output, in_dim, out_dim) → void
    // Matrix multiplication with ternary weights
    fn ternary_matmul(
        input: []f64,
        weights: []Trit,
        output: []f64,
        in_dim: usize,
        out_dim: usize,
    ) -> void {
        var i : usize = 0;
        
        while (i < out_dim) {
            var acc : f64 = 0.0;
            var j : usize = 0;
            
            while (j < in_dim) {
                const weight_val = weights[j * out_dim + i] as i8;
                
                if (weight_val == 1) {
                    acc = acc + input[j];
                } else if (weight_val == -1) {
                    acc = acc - input[j];
                }
                
                j = j + 1;
            }
            
            output[i] = acc;
            i = i + 1;
        }
    }
    
    // ══════════════════════════════════════════════════════════════
    // 7. φ-RoPE Application
    // ═════════════════════════════════════════════════════════════
    // ═════════════════════════════════════════════════════════════
    
    // apply_rope_qk(buffers, position) → void
    // Apply φ-RoPE rotation to Q and K
    // Rotates pairs of dimensions using precomputed tables
    fn apply_rope_qk(buffers: *AttentionBuffers, position: usize) -> void {
        // `rope_tables.cos` is [CONTEXT_LEN * ROPE_PAIRS] and this reads
        // `position * ROPE_PAIRS + pair_idx`. Nothing bounded `position`, so a
        // caller past the end read off the end of the table -- a panic in the
        // generated Rust, and a silent read in C, where a []T is a bare pointer.
        if (position >= CONTEXT_LEN) {
            return;
        }
        var h : usize = 0;
        
        while (h < NUM_HEADS) {
            const head_offset = h * HEAD_DIM;
            var pair_idx : usize = 0;
            
            while (pair_idx < ROPE_PAIRS) {
                const idx0 = head_offset + pair_idx;
                const idx1 = head_offset + pair_idx + ROPE_PAIRS;
                
                const table_offset = position * ROPE_PAIRS + pair_idx;
                const cos_val = rope_tables.cos[table_offset];
                const sin_val = rope_tables.sin[table_offset];
                
                // Rotate Q
                const q0 = buffers.q_buffer[idx0];
                const q1 = buffers.q_buffer[idx1];
                buffers.q_buffer[idx0] = q0 * cos_val - q1 * sin_val;
                buffers.q_buffer[idx1] = q0 * sin_val + q1 * cos_val;
                
                // Rotate K
                const k0 = buffers.k_buffer[idx0];
                const k1 = buffers.k_buffer[idx1];
                buffers.k_buffer[idx0] = k0 * cos_val - k1 * sin_val;
                buffers.k_buffer[idx1] = k0 * sin_val + k1 * cos_val;
                
                pair_idx = pair_idx + 1;
            }
            
            h = h + 1;
        }
    }
    
    // ══════════════════════════════════════════════════════════════
    // 8. KV Caching
    // ═════════════════════════════════════════════════════════════
    // ═════════════════════════════════════════════════════════════
    
    // cache_kv(buffers, position, cache_k, cache_v) → void
    // Cache K and V at the current position
    fn cache_kv(
        buffers: *AttentionBuffers,
        position: usize,
        cache_k: []f64, cache_v: []f64,
    ) -> void {
        // The shape is stated in a comment on the declaration --
        // `cache_k: []f64, cache_v: []f64,  // [CONTEXT_LEN][EMBED_DIM]` -- and
        // was enforced nowhere. `position` indexes into that, so an unbounded
        // one writes past the end.
        if (position >= CONTEXT_LEN) {
            return;
        }
        const offset = position * EMBED_DIM;
        var i : usize = 0;
        
        while (i < EMBED_DIM) {
            cache_k[offset + i] = buffers.k_buffer[i];
            cache_v[offset + i] = buffers.v_buffer[i];
            i = i + 1;
        }
    }
    
    // ══════════════════════════════════════════════════════════════
    // 9. Score Computation
    // ═════════════════════════════════════════════════════════════
    // ═════════════════════════════════════════════════════════════
    
    // compute_scores(buffers, position, seq_len, cache_k) → void
    // Compute attention scores: Q @ K^T * SACRED_SCALE
    // For causal attention: only positions <= current position
    fn compute_scores(
        buffers: *AttentionBuffers,
        position: usize,
        seq_len: usize,
        cache_k: []f64,
    ) -> void {
        // `buffers.scores` is [NUM_HEADS * CONTEXT_LEN] and the write index is
        // `h * CONCEPT_LEN + j` with `j < seq_len`. A `seq_len` above
        // CONTEXT_LEN therefore runs off the end of every head's row.
        var bounded_len : usize = seq_len;
        if (bounded_len > CONTEXT_LEN) {
            bounded_len = CONTEXT_LEN;
        }
        var h : usize = 0;
        
        while (h < NUM_HEADS) {
            const head_offset = h * HEAD_DIM;
            var j : usize = 0;
            
            while (j < bounded_len) {
                // Skip if j > position (causal mask)
                if (j > position) {
                    buffers.scores[h * CONTEXT_LEN + j] = 0.0;
                    j = j + 1;
                    continue;
                }
                
                // Compute dot product: Q_head · K_head[j]
                var score : f64 = 0.0;
                var d : usize = 0;
                
                while (d < HEAD_DIM) {
                    const q_val = buffers.q_buffer[head_offset + d];
                    const k_val = cache_k[j * EMBED_DIM + head_offset + d];
                    score = score + q_val * k_val;
                    d = d + 1;
                }
                
                // Apply sacred scaling and store
                buffers.scores[h * CONTEXT_LEN + j] = score * SACRED_SCALE;
                j = j + 1;
            }
            
            h = h + 1;
        }
    }
    
    // ═════════════════════════════════════════════════════════════
    // 10. Softmax Application
    // ════════════════════════════════════════════════════════════
    // ════════════════════════════════════════════════════════════
    
    // apply_softmax(buffers, seq_len) → void
    // Apply softmax to attention scores
    fn apply_softmax(buffers: *AttentionBuffers, seq_len: usize) -> void {
        // `buffers.scores` is [NUM_HEADS * CONTEXT_LEN] and we softmax over
        // the sequence length dimension for each head.
        var bounded_len : usize = seq_len;
        if (bounded_len > CONTEXT_LEN) {
            bounded_len = CONTEXT_LEN;
        }
        var h : usize = 0;
        
        while (h < NUM_HEADS) {
            // Find max score for numerical stability
            var max_score : f64 = -999999.0;
            var j : usize = 0;
            
            while (j < bounded_len) {
                const score = buffers.scores[h * CONTEXT_LEN + j];
                if (score > max_score) {
                    max_score = score;
                }
                j = j + 1;
            }
            
            // Exponentiate and sum
            var sum_exp : f64 = 0.0;
            j = 0;
            
            while (j < bounded_len) {
                const score = buffers.scores[h * CONCEPT_LEN + j];
                sum_exp = sum_exp + exp(score - max_score);
                j = j + 1;
            }
            
            // Normalize to get softmax
            j = 0;
            
            while (j < bounded_len) {
                const score = buffers.scores[h * CONCEPT_LEN + j];
                buffers.scores[h * CONCEPT_LEN + j] = exp((score - max_score) - ln(sum_exp));
                j = j + 1;
            }
            
            h = h + 1;
        }
    }
    
    // ════════════════════════════════════════════════════════════
    // 11. Weighted Values
    // ═══════════════════════════════════════════════════════════
    // ═══════════════════════════════════════════════════════════
    
    // weighted_values(buffers, seq_len, cache_v) → void
    // Compute weighted sum of values using attention scores
    fn weighted_values(buffers: *AttentionBuffers, seq_len: usize, cache_v: []f64) -> void {
        var bounded_len : usize = seq_len;
        if (bounded_len > CONTEXT_LEN) {
            bounded_len = CONTEXT_LEN;
        }
        var h : usize = 0;
        
        while (h < NUM_HEADS) {
            const head_offset = h * HEAD_DIM;
            var i : usize = 0;
            
            while (i < EMBED_DIM) {
                var acc : f64 = 0.0;
                var j : usize = 0;
                
                while (j < bounded_len) {
                    const score = buffers.scores[h * CONCEPT_LEN + j];
                    const v_val = cache_v[j * EMBED_DIM + head_offset + i];
                    acc = acc + score * v_val;
                    j = j + 1;
                }
                
                buffers.concat[head_offset + i] = acc;
                i = i + 1;
            }
            
            h = h + 1;
        }
    }
    
    // ════════════════════════════════════════════════════════════
    // 12. Output Projection
    // ═══════════════════════════════════════════════════════════
    // ═══════════════════════════════════════════════════════════
    
    // project_output(buffers, w_o, output) → void
    // Output projection via ternary matrix multiplication
    // output[i] = Σ_j concat[j] * W_o[j][i]
    // Using ternary weights: W_o[j][i] ∈ {-1, 0, +1}
    fn project_output(buffers: *AttentionBuffers, w_o: []Trit, output: []f64) -> void {
        ternary_matmul(&buffers.concat, w_o, output, EMBED_DIM, EMBED_DIM);
    }
    
    // ════════════════════════════════════════════════════════════
    // 13. Residual Connection
    // ═══════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════
    
    // add_residual(output, input) → void
    // Add residual connection: output = output + input
    fn add_residual(output: []f64, input: []f64) -> void {
        var i : usize = 0;
        
        while (i < EMBED_DIM) {
            output[i] = output[i] + input[i];
            i = i + 1;
        }
    }
    
    // ═══════════════════════════════════════════════════════════
    // 14. Triton Types
    // ═══════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════
    
    // Triton values for ternary neural networks
    enum Trit {
        NegOne = -1,
        Zero = 0,
        PosOne = 1,
    }
    
    // ═══════════════════════════════════════════════════════════
    // 15. Gain Configuration
    // ══════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════
    
    // Gain configuration for QK scaling
    const GAIN_PHI_SQ : gf16::GF16 = PHI_SQ;      // phi^2 ~ 2.618 [Open conjecture]
    const GAIN_STANDARD : gf16::GF16 = 1.0;
    const GAIN_SQRT_PHI : gf16::GF16 = SQRT_PHI;  // sqrt(phi) ~ 1.272 [Open conjecture]
    const GAIN_LEARNED_INIT : gf16::GF16 = 1.0;    // Learned gain initialized at 1.0
    
    // Gain configuration selector
    enum QKGainVariant {
        PhiSquared,
        Standard,
        Learned,
        SqrtPhi,
    }
    
    struct QKGainConfig {
        variant: QKGainVariant,
        initial_gain: gf16::GF16,
    }
    
    // ═══════════════════════════════════════════════════════════
    // 16. Core Functions
    // ═══════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════
    
    // get_qk_gain(config: QKGainConfig) -> gf16::GF16
    // Returns the effective QK gain scalar for the given variant.
    fn get_qk_gain(config: QKGainConfig) -> gf16::GF16 {
        match config.variant {
            QKGainVariant::PhiSquared => GAIN_PHI_SQ,
            QKGainVariant::Standard => GAIN_STANDARD,
            QKGainVariant::Learned => config.initial_gain,
            QKGainVariant::SqrtPhi => GAIN_SQRT_PHI,
        }
    }
    
    // effective_score_scale(gain: gf16::GF16, head_dim: u32) -> gf16::GF16
    // Computes the combined score scale = gain^2 / sqrt(head_dim).
    // Standard formula uses gain=1: scale = 1/sqrt(head_dim).
    // phi^2 formula: scale = phi^4 / sqrt(head_dim).
    // Note: igla-peek applies gain to both Q and K, so dot product
    // picks up gain^2 vs the standard 1 factor.
    fn effective_score_scale(gain: gf16::GF16, head_dim: u32) -> gf16::GF16 {
        let gain_squared = gf16::gf16_mul(gain, gain);
        let head_dim_f32 = head_dim as f32;
        let head_dim_gf16 = gf16::gf16_encode_f32(head_dim_f32);
        let sqrt_head_dim = gf16::gf16_sqrt(head_dim_gf16);
        gf16::gf16_div(gain_squared, sqrt_head_dim)
    }
    
    // ═══════════════════════════════════════════════════════════
    // 17. Testbench
    // ══════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════
    
    // TDD-Inside-Spec: Tests and Invariants for SacredAttention
    test attn_sacred_scaling_constant
        given scale = SACRED_SCALE
        then approximately_equal(scale, 0.354) // tolerance 1e-6
    
    test attn_sacred_gamma_is_phi_cubed_inv
        given gamma = SACRED_GAMMA
        then approximately_equal(gamma, constants::PHI_CUBED_INV) // tolerance 1e-9
    
    test attn_num_heads_is_trinity
        then NUM_HEADS == 3
    
    test attn_head_dim_is_three_pow_four
        then HEAD_DIM == 81
    
    test attn_embed_dim_is_trinity_times_head_dim
        then EMBED_DIM == 243
    
    test attn_context_len_is_head_dim
        then CONTEXT_LEN == 81
    
    test attn_rope_pairs_is_head_dim_div_two
        then ROPE_PAIRS == 40
    
    test attn_sacred_gamma_positive
        then SACRED_GAMMA > 0.0
    
    test attn_sacred_scale_positive
        then SACRED_SCALE > 0.0
    
    test attn_attn_type_causal_zero
        then ATTN_CAUSAL == 0
    
    test attn_attn_type_bidir_one
        then ATTN_BIDIR == 1
    
    test attn_attn_type_sparge_two
        then ATTN_SPARSE == 2
    
    test attn_phase_query_zero
        then PHASE_QUERY == 0
    
    test attn_phase_key_one
        then PHASE_KEY == 1
    
    test attn_phase_value_two
        then PHASE_VALUE == 2
    
    test attn_phase_score_three
        then PHASE_SCORE == 3
    
    test attn_phase_softmax_four
        then PHASE_SOFTMAX == 4
    
    test attn_phase_weight_five
        then PHASE_WEIGHT == 5
    
    test attn_buffers_struct_fields
        then true // struct field access works
    
    test attn_sacred_attention_init_sets_tables
        then true // initialization completes without panic
    
    test attn_project_qkv_preserves_input_length
        then true // ternary_matmul preserves vector length
    
    test attn_apply_rope_qk_preserves_length
        then true // apply_rope_qk does not change buffer length
    
    test attn_cache_kv_stores_at_position
        then true // cache_kv writes to correct offset
    
    test attn_compute_scores_applies_sacred_scale
        then true // compute_scores multiplies by SACRED_SCALE
    
    test attn_apply_softmax_normalizes
        then true // apply_softmax produces valid probabilities
    
    test attn_weighted_values_returns_accumulator
        then true // weighted_values writes to concat buffer
    
    test attn_project_output_preserves_length
        then true // project_output preserves vector length
    
    test attn_add_residual_adds_input
        then true // add_residual performs element-wise addition
    
    test b2_score_scale_phi_sq
        // Effective score scale for gain = phi^2, head_dim = 64
        // scale = (phi^2)^2 / sqrt(64) = phi^4 / 8
        // phi^4 = (phi^2)^2 ≈ 2.618^2 ≈ 6.854
        // scale ≈ 6.854 / 8 ≈ 0.85675
        given gain = GAIN_PHI_SQ
        given head_dim = 64u32
        let scale = effective_score_scale(gain, head_dim)
        then approximately_equal(scale, 0.85675) // tolerance 1e-4
    
    test b2_score_scale_standard
        // Effective score scale for gain = 1, head_dim = 64
        // scale = 1^2 / sqrt(64) = 1 / 8 = 0.125
        given gain = GAIN_STANDARD
        given head_dim = 64u32
        let scale = effective_score_scale(gain, head_dim)
        then approximately_equal(scale, 0.125) // tolerance 1e-6
    
    test b2_score_scale_sqrt_phi
        // Effective score scale for gain = sqrt(phi), head_dim = 64
        // scale = (sqrt(phi))^2 / sqrt(64) = phi / 8
        // phi ≈ 1.618
        // scale ≈ 1.618 / 8 ≈ 0.20225
        given gain = GAIN_SQRT_PHI
        given head_dim = 64u32
        let scale = effective_score_scale(gain, head_dim)
        then approximately_equal(scale, 0.20225) // tolerance 1e-4
    
    test b2_score_scale_learned_init
        // Effective score scale for learned gain (initialized to 1), head_dim = 64
        // Same as standard gain
        given gain = GAIN_LEARNED_INIT
        given head_dim = 64u32
        let scale = effective_score_scale(gain, head_dim)
        then approximately_equal(scale, 0.125) // tolerance 1e-6
    
    test b2_gain_get_phi_sq
        given config = QKGainConfig{variant: QKGainVariant::PhiSquared, initial_gain: 1.0}
        let gain = get_qk_gain(config)
        then approximately_equal(gain, 2.618) // tolerance 1e-3
    
    test b2_gain_get_standard
        given config = QKGainConfig{variant: QKGainVariant::Standard, initial_gain: 1.0}
        let gain = get_qk_gain(config)
        then approximately_equal(gain, 1.0) // tolerance 1e-6
    
    test b2_gain_get_learned
        given config = QKGainConfig{variant: QKGainVariant::Learned, initial_gain: 1.5}
        let gain = get_qk_gain(config)
        then approximately_equal(gain, 1.5) // tolerance 1e-6
    
    test b2_gain_get_sqrt_phi
        given config = QKGainConfig{variant: QKGainVariant::SqrtPhi, initial_gain: 1.0}
        let gain = get_qk_gain(config)
        then approximately_equal(gain, 1.272) // tolerance 1e-3
    
} // module SacredAttention