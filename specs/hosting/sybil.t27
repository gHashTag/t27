// SPDX-License-Identifier: Apache-2.0
; specs/hosting/sybil.t27 -- why one person with many keys on many networks earns nothing for wrong
; answers: the anchored quorum, canaries, probation, a credit cap per key per epoch, and the optional
; attestation that raises the cap; and the seeded simulation that measures it
; gHashTag/trios#1761 (slice 1b of gHashTag/trios#1756), lane B, the owner's decision for the sybil gap
; (2026-10-10, translated): spreading replicas over networks stays as it is, but it is not the defense;
; the defense makes a sybil earn nothing.
; --
; The attack. proof.t27 believes a job when k = REPLICAS_K keys report one output hash, and its own
; header names the ceiling: k keys can be one person. placement.t27 keeps two strangers on one network
; off one job, so an attacker rents M networks, holds M keys, and has every key report the same wrong
; hash. Two of its keys on one job are a quorum; one of its keys and one honest host are a tiebreak
; that its next key may win; and the honest host on the losing side is struck for dissent.
; --
; The defense, five rules, each a function below:
; 1. The anchored quorum. A public job is believed only through an anchor: the owner's or a trusted
;    host's replica (host.t27 tiers), or a known answer. The votes that match the anchor are the
;    group that can agree; a public majority against the anchor never agrees, it is unresolved. A
;    public host may not take the replica slot an anchor needs (public_may_take).
; 2. Canaries. A share CANARY_PERMILLE of the leases a public host gets carries a known answer: a lab
;    row, or a result an anchored quorum already agreed. The Queen draws the share from a source the
;    host cannot see (the runtime: its own CSPRNG; the simulation: a stream of the seed no attacker
;    reads). A wrong answer to a canary is slashed and struck at once, with no quorum to wait for.
; 3. Probation. A new key earns nothing until PROBATION_JOBS of its votes were on the agreeing side.
; 4. A cap. A key earns at most epoch_cap mTRI per epoch (the epoch is statement.t27's).
; 5. Attestation raises the cap: the owner's allowlist marks the key, or a signed attestation for it
;    verifies (a Telegram login proof through the project's main bot, or a GitHub account at least
;    GITHUB_AGE_MIN_DAYS old). This slice models the flag only; no Telegram or GitHub call exists.
; --
; The slash. A disagreeing receipt is slashed: the key forfeits what it earned this epoch, up to its
; cap (verified/payout.t27 slash_taken, with the cap as the bond). Forfeited credit is not moved to
; any other key: credit is non-transferable (payout.t27 CREDIT_TRANSFERABLE false), and a slash only
; burns credit that was never settled. A strike is credit.t27's, and host.t27 suspends a key at
; STRIKES_MAX.
; --
; The simulation (section 7). H honest public hosts, two anchor hosts (one owner-tier, one
; trusted-tier) and an attacker with M keys, each key on its own network, so placement's spread rule
; never separates them. Every attacker key answers the same wrong hash on every job it holds. The run
; is SIM_EPOCHS epochs of SIM_JOBS_PER_EPOCH jobs, replicas placed one at a time from the seed, every
; vote judged by the rules above (or, with the anchor and canaries off, by proof.t27 job_verdict
; alone, which is slice 1). It reports the attacker's credit, the honest hosts' credit, and how many
; wrong results were agreed. Measured expectation, asserted below: with the anchor and canaries on the
; attacker earns 0 mTRI and no wrong result is agreed, for M = 1, 2, 5 and 20; with both off it earns
; more than 0 once it holds two keys. One key alone never forms a quorum (one replica per host), so
; for M = 1 the attacker earns 0 either way, and the test says so rather than hide it.
; --
; Not here: who decides the job's answer (proof.t27), the payment kinds and the epoch statement
; (statement.t27), the rows and the HTTP (gHashTag/trios). The honest ceiling: an attacker that
; answers correctly is doing the work, and is paid for it like anyone else, inside its cap; two of its
; keys may then both hold replicas of one known-answer job and run it once. The cap bounds that.
; --
; TODO(network MVP hardening lane, gHashTag/t27, 2026-10-11): that lane adds to network/mvp.t27 a
; trusted N/F/M configuration with one vote per operator. When it is on master, the anchors here (the
; owner's and trusted hosts) and their votes are to be read from it, one vote per operator, and this
; card imports it instead of growing its own; until then it defines only the anchor it needs.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module HostingSybil;

use hosting::host::TIER_OWNER;
use hosting::host::TIER_TRUSTED;
use hosting::host::TIER_PUBLIC;
use hosting::host::STRIKES_MAX;
use hosting::host::suspended;
use hosting::proof::REPLICAS_K;
use hosting::proof::REPLICAS_MAX;
use hosting::proof::JV_PENDING;
use hosting::proof::JV_AGREED;
use hosting::proof::JV_TIEBREAK;
use hosting::proof::JV_UNRESOLVED;
use hosting::proof::TOP_GROUP;
use hosting::proof::SIDE_AGREED;
use hosting::proof::SIDE_DISSENT;
use hosting::proof::SIDE_NONE;
use hosting::proof::job_verdict;
use hosting::proof::side_of;
use hosting::credit::credit_mtri;
use hosting::credit::strike_due;
use hosting::credit::BALANCE_MAX;
use verified::payout::slash_taken;
use trinet::node-work-credit::REWARD_PER_JOB_MTRI;
use queen::simulation::sim_roll;
use queen::simulation::run_seed;
use queen::simulation::pick_between;

; --- 1. The anchored quorum ---------------------------------------------------------------------------

/// Whether a host of this tier anchors a public job: the owner's machines and the people he names.
pub fn anchors(tier: u8) -> bool {
    return tier <= TIER_TRUSTED;
}

/// One anchor per public job: a replica from an anchoring tier, or the job's known answer.
pub const ANCHOR_SLOTS : u32 = 1;

/// The replicas a job runs at first. A known answer is the anchor, so it takes one replica slot.
pub fn replicas_wanted(known_answer: bool) -> u32 {
    if (known_answer) { return REPLICAS_K - ANCHOR_SLOTS; }
    return REPLICAS_K;
}

/// Whether a public host may take one more replica of a job: always with the anchor rule off, and
/// for a job with a known answer; otherwise while public hosts hold fewer than REPLICAS_K -
/// ANCHOR_SLOTS of its replicas. Every other replica of it, a tiebreak included, is an anchor's: when
/// the anchor and a public host disagree, a second anchor decides, never a second public key.
pub fn public_may_take(anchor_on: bool, known_answer: bool, public_in: u32) -> bool {
    if (anchor_on == false) { return true; }
    if (known_answer) { return true; }
    return public_in + ANCHOR_SLOTS < REPLICAS_K;
}

/// The state of an anchored job. anchor_present: the job has a known answer, or an anchoring host has
/// voted. anchor_group: the largest group of equal votes that holds the known answer or an anchoring
/// host's vote, the known answer counted as one vote.
/// replicas: the receipts that are votes. wanted: the replicas the job runs now. exhausted: as in
/// proof.t27 job_verdict. Only the anchor's group can agree; a group the anchor is not in is never
/// believed, however large, and the job waits for its anchor rather than break a tie without one.
pub fn anchored_verdict(anchor_present: bool, anchor_group: u32, replicas: u32, wanted: u32, exhausted: bool) -> u8 {
    if (anchor_present and anchor_group >= REPLICAS_K) { return JV_AGREED; }
    if (exhausted) { return JV_UNRESOLVED; }
    if (replicas < wanted) { return JV_PENDING; }
    if (anchor_present == false) { return JV_PENDING; }
    if (wanted < REPLICAS_MAX) { return JV_TIEBREAK; }
    return JV_UNRESOLVED;
}

; --- 2. Canaries -------------------------------------------------------------------------------------

/// One public lease in ten is a canary. The draw is in [0, PERMILLE).
pub const PERMILLE : u32 = 1000;
pub const CANARY_PERMILLE : u32 = 100;

/// Whether this lease is a canary, from a draw the host cannot see.
pub fn canary_due(draw: u32, rate_permille: u32) -> bool {
    return (draw % PERMILLE) < rate_permille;
}

/// A vote that does not match a known answer: slashed and struck at once.
pub fn canary_wrong(known_answer: bool, matches: bool) -> bool {
    return known_answer and matches == false;
}

; --- 3. Probation ------------------------------------------------------------------------------------

/// A new key earns nothing until this many of its votes were on the agreeing side.
pub const PROBATION_JOBS : u32 = 10;

pub fn on_probation(agreed_before: u32) -> bool {
    return agreed_before < PROBATION_JOBS;
}

; --- 4. The cap, and 5. attestation -------------------------------------------------------------------

/// mTRI per key per epoch. At credit.t27's rate (1 mTRI per job) a public key earns for at most 24
/// jobs an epoch; an attested one for 96; a trusted host for 384; the owner's machines are not capped.
/// The numbers are the owner's to change; the rule is that the cap only grows with trust.
pub const CAP_PUBLIC_MTRI : u64 = 24;
pub const CAP_ATTESTED_MTRI : u64 = 96;
pub const CAP_TRUSTED_MTRI : u64 = 384;

pub fn epoch_cap(tier: u8, attested_key: bool) -> u64 {
    if (tier == TIER_OWNER) { return BALANCE_MAX; }
    if (tier == TIER_TRUSTED) { return CAP_TRUSTED_MTRI; }
    if (attested_key) { return CAP_ATTESTED_MTRI; }
    return CAP_PUBLIC_MTRI;
}

/// What a credit adds this epoch: all of it, or what the cap leaves.
pub fn credit_capped(earned_this_epoch: u64, credit: u64, cap: u64) -> u64 {
    if (earned_this_epoch >= cap) { return 0; }
    if (credit > cap - earned_this_epoch) { return cap - earned_this_epoch; }
    return credit;
}

/// Attestation kinds a signed attestation may carry.
pub const ATTEST_NONE : u8 = 0;
pub const ATTEST_TELEGRAM : u8 = 1;
pub const ATTEST_GITHUB_AGE : u8 = 2;
pub const ATTEST_KINDS : u8 = 3;
/// A GitHub account this old, in days, attests.
pub const GITHUB_AGE_MIN_DAYS : u32 = 365;

/// Whether a key is attested: the owner's allowlist marks it, or a signed attestation for it
/// verifies and says enough. A claim no signature backs is not an attestation.
pub fn attested(owner_marked: bool, kind: u8, signature_ok: bool, github_age_days: u32) -> bool {
    if (owner_marked) { return true; }
    if (signature_ok == false) { return false; }
    if (kind == ATTEST_TELEGRAM) { return true; }
    if (kind == ATTEST_GITHUB_AGE) { return github_age_days >= GITHUB_AGE_MIN_DAYS; }
    return false;
}

; --- 6. One vote's credit, slash and strike -------------------------------------------------------------

/// The mTRI one vote earns: credit.t27's credit on the agreeing side, nothing on probation, and never
/// past the key's cap for the epoch.
pub fn vote_credit(side: u8, already_credited: bool, agreed_before: u32, earned_this_epoch: u64, cap: u64) -> u64 {
    let base : u64 = credit_mtri(side, false, already_credited);
    if (on_probation(agreed_before)) { return 0; }
    return credit_capped(earned_this_epoch, base, cap);
}

/// Whether one vote is slashed: a wrong canary, or a vote against an agreed result. Once per job.
pub fn slash_due(wrong_canary: bool, side: u8, already_slashed: bool) -> bool {
    if (already_slashed) { return false; }
    if (wrong_canary) { return true; }
    return strike_due(false, side, false);
}

/// Whether one vote is struck: credit.t27's strike, or a wrong canary. Once per job.
pub fn struck(wrong_canary: bool, side: u8, already_struck: bool) -> bool {
    if (already_struck) { return false; }
    if (wrong_canary) { return true; }
    return strike_due(false, side, false);
}

/// What a slash forfeits: what the key earned this epoch, up to its cap (the bond).
pub fn slash_mtri(earned_this_epoch: u64, cap: u64) -> u64 {
    return slash_taken(cap, earned_this_epoch);
}

; --- 7. The seeded simulation ---------------------------------------------------------------------------

/// The world: two anchor hosts (key 0 owner-tier, key 1 trusted-tier), SIM_HONEST honest public
/// hosts, then the attacker's keys. Every key is on its own network.
pub const SIM_ANCHOR_HOSTS : u32 = 2;
pub const SIM_HONEST : u32 = 8;
pub const SIM_KEYS_MAX : u32 = 32;
pub const SIM_ATTACKERS_MAX : u32 = 22;
pub const SIM_EPOCHS : u32 = 4;
pub const SIM_JOBS_PER_EPOCH : u32 = 60;
pub const SIM_SEEDS : u32 = 8;
pub const SIM_BASE_SEED : u32 = 1761;

/// Streams of the seed, apart from the Queen gate's and the network MVP's.
pub const SYB_STREAM_CANARY : u32 = 40;
pub const SYB_STREAM_PLACE : u32 = 41;

/// The two answers: the true output hash, and the one wrong hash every attacker key reports.
pub const ANSWER_TRUE : u32 = 0;
pub const ANSWER_WRONG : u32 = 1;

/// Which rules a run applies, one bit each. Strikes and suspension are slice 1's and always apply.
pub const D_ANCHOR : u32 = 1;
pub const D_CANARY : u32 = 2;
pub const D_PROBATION : u32 = 4;
pub const D_CAP : u32 = 8;
pub const D_SLASH : u32 = 16;
/// All five rules.
pub const D_ALL : u32 = 31;
/// The negative control: the anchor and canaries off, probation, the cap and the slash on.
pub const D_NO_ANCHOR_NO_CANARY : u32 = 28;
/// Slice 1 as merged: plain k-of-n agreement, credit.t27's credit and its strikes.
pub const D_SLICE1 : u32 = 0;

pub fn defended(set: u32, rule: u32) -> bool {
    return (set & rule) != 0;
}

pub fn sim_tier(k: u32) -> u8 {
    if (k == 0) { return TIER_OWNER; }
    if (k < SIM_ANCHOR_HOSTS) { return TIER_TRUSTED; }
    return TIER_PUBLIC;
}

pub fn sim_attacker(k: u32) -> bool {
    return k >= SIM_ANCHOR_HOSTS + SIM_HONEST;
}

pub fn sim_answer(k: u32) -> u32 {
    if (sim_attacker(k)) { return ANSWER_WRONG; }
    return ANSWER_TRUE;
}

/// What sybil_run reports.
pub const SR_ATTACKER_MTRI : u8 = 0;
pub const SR_HONEST_MTRI : u8 = 1;
pub const SR_WRONG_AGREED : u8 = 2;
pub const SR_ATTACKERS_SUSPENDED : u8 = 3;
pub const SR_HONEST_SUSPENDED : u8 = 4;
pub const SR_JOBS_AGREED : u8 = 5;
pub const SR_ANCHOR_REPLICAS : u8 = 6;
pub const SR_CANARIES : u8 = 7;
pub const SR_ATTACKER_REPLICAS : u8 = 8;
pub const SR_KINDS : u8 = 9;

/// One run under `seed` with `attackers` attacker keys (at most SIM_ATTACKERS_MAX) and the rules
/// `defenses` names, answering `what`.
pub fn sybil_run(seed: u32, attackers: u32, defenses: u32, what: u8) -> u64 {
    var m : u32 = attackers;
    if (m > SIM_ATTACKERS_MAX) { m = SIM_ATTACKERS_MAX; }
    let keys : u32 = SIM_ANCHOR_HOSTS + SIM_HONEST + m;
    let anchor_on : bool = defended(defenses, D_ANCHOR);
    var agreed : [32]u32 = [0] ** 32;
    var strikes : [32]u32 = [0] ** 32;
    var earned : [32]u64 = [0] ** 32;
    var total : [32]u64 = [0] ** 32;
    var on_job : [32]bool = [false] ** 32;
    var holder : [4]u32 = [0] ** 4;
    var wrong_agreed : u64 = 0;
    var jobs_agreed : u64 = 0;
    var anchor_replicas : u64 = 0;
    var canaries : u64 = 0;
    var attacker_replicas : u64 = 0;
    let jobs : u32 = SIM_EPOCHS * SIM_JOBS_PER_EPOCH;
    var j : u32 = 0;
    while (j < jobs) {
        if ((j % SIM_JOBS_PER_EPOCH) == 0) {
            var e : u32 = 0;
            while (e < SIM_KEYS_MAX) {
                earned[e] = 0;
                e = e + 1;
            }
        }
        var c : u32 = 0;
        while (c < SIM_KEYS_MAX) {
            on_job[c] = false;
            c = c + 1;
        }
        let draw : u32 = pick_between(sim_roll(seed, SYB_STREAM_CANARY, j), 0, PERMILLE - 1);
        let known : bool = defended(defenses, D_CANARY) and canary_due(draw, CANARY_PERMILLE);
        if (known) { canaries = canaries + 1; }
        let anchored : bool = known or anchor_on;
        var wanted : u32 = replicas_wanted(known);
        var placed : u32 = 0;
        var anchors_in : u32 = 0;
        var public_in : u32 = 0;
        var n_true : u32 = 0;
        var n_wrong : u32 = 0;
        var exhausted : bool = false;
        var verdict : u8 = JV_PENDING;
        var round : u32 = 0;
        var open : bool = true;
        while (open and round < 8) {
            while (placed < wanted and exhausted == false and placed < 4) {
                let want_anchor : bool = public_may_take(anchor_on, known, public_in) == false;
                // the candidates: anchor hosts for an anchor's slot, public hosts otherwise, and the
                // anchor hosts again when no public host is left
                var lo : u32 = SIM_ANCHOR_HOSTS;
                var hi : u32 = keys;
                if (want_anchor) {
                    lo = 0;
                    hi = SIM_ANCHOR_HOSTS;
                }
                var count : u32 = 0;
                var k : u32 = lo;
                while (k < hi) {
                    if (on_job[k] == false and suspended(strikes[k]) == false) { count = count + 1; }
                    k = k + 1;
                }
                if (count == 0 and want_anchor == false) {
                    lo = 0;
                    hi = SIM_ANCHOR_HOSTS;
                    k = 0;
                    while (k < hi) {
                        if (on_job[k] == false and suspended(strikes[k]) == false) { count = count + 1; }
                        k = k + 1;
                    }
                }
                if (count == 0) {
                    exhausted = true;
                } else {
                    let pick : u32 = pick_between(sim_roll(seed, SYB_STREAM_PLACE, (j * 8) + placed), 0, count - 1);
                    var seen : u32 = 0;
                    var chosen : u32 = lo;
                    var w : u32 = lo;
                    while (w < hi) {
                        if (on_job[w] == false and suspended(strikes[w]) == false) {
                            if (seen == pick) { chosen = w; }
                            seen = seen + 1;
                        }
                        w = w + 1;
                    }
                    on_job[chosen] = true;
                    holder[placed] = chosen;
                    placed = placed + 1;
                    if (anchors(sim_tier(chosen))) {
                        anchors_in = anchors_in + 1;
                        anchor_replicas = anchor_replicas + 1;
                    } else {
                        public_in = public_in + 1;
                    }
                    if (sim_attacker(chosen)) { attacker_replicas = attacker_replicas + 1; }
                    if (sim_answer(chosen) == ANSWER_TRUE) {
                        n_true = n_true + 1;
                    } else {
                        n_wrong = n_wrong + 1;
                    }
                }
            }
            if (anchored) {
                // anchor hosts answer truly, so the anchor's group is the true answer's
                var group : u32 = n_true;
                if (known) { group = group + 1; }
                verdict = anchored_verdict(known or anchors_in > 0, group, placed, wanted, exhausted);
            } else {
                var top : u32 = n_true;
                var second : u32 = n_wrong;
                if (n_wrong > n_true) {
                    top = n_wrong;
                    second = n_true;
                }
                verdict = job_verdict(placed, top, second, wanted, exhausted);
            }
            if (verdict == JV_TIEBREAK) {
                wanted = wanted + 1;
            } else {
                if (verdict != JV_PENDING) { open = false; }
                if (verdict == JV_PENDING and exhausted) { open = false; }
            }
            round = round + 1;
        }
        // the answer the job agreed on: the anchor's, or the larger group's
        var winner : u32 = ANSWER_TRUE;
        if (anchored == false and n_wrong > n_true) { winner = ANSWER_WRONG; }
        if (verdict == JV_AGREED) {
            jobs_agreed = jobs_agreed + 1;
            if (winner == ANSWER_WRONG) { wrong_agreed = wrong_agreed + 1; }
        }
        var r : u32 = 0;
        while (r < placed) {
            let h : u32 = holder[r];
            let mine : u32 = sim_answer(h);
            var group_of : u32 = TOP_GROUP + 1;
            if (mine == winner) { group_of = TOP_GROUP; }
            let side : u8 = side_of(verdict, group_of);
            let wrong_canary : bool = canary_wrong(known, mine == ANSWER_TRUE);
            var cap : u64 = BALANCE_MAX;
            if (defended(defenses, D_CAP)) { cap = epoch_cap(sim_tier(h), false); }
            var before : u32 = PROBATION_JOBS;
            if (defended(defenses, D_PROBATION)) { before = agreed[h]; }
            let paid : u64 = vote_credit(side, false, before, earned[h], cap);
            earned[h] = earned[h] + paid;
            total[h] = total[h] + paid;
            if (side == SIDE_AGREED) { agreed[h] = agreed[h] + 1; }
            if (struck(wrong_canary, side, false)) { strikes[h] = strikes[h] + 1; }
            if (defended(defenses, D_SLASH) and slash_due(wrong_canary, side, false)) {
                let taken : u64 = slash_mtri(earned[h], cap);
                earned[h] = earned[h] - taken;
                total[h] = total[h] - taken;
            }
            r = r + 1;
        }
        j = j + 1;
    }
    var attacker_mtri : u64 = 0;
    var honest_mtri : u64 = 0;
    var attackers_out : u64 = 0;
    var honest_out : u64 = 0;
    var q : u32 = SIM_ANCHOR_HOSTS;
    while (q < keys) {
        if (sim_attacker(q)) {
            attacker_mtri = attacker_mtri + total[q];
            if (suspended(strikes[q])) { attackers_out = attackers_out + 1; }
        } else {
            honest_mtri = honest_mtri + total[q];
            if (suspended(strikes[q])) { honest_out = honest_out + 1; }
        }
        q = q + 1;
    }
    if (what == SR_ATTACKER_MTRI) { return attacker_mtri; }
    if (what == SR_HONEST_MTRI) { return honest_mtri; }
    if (what == SR_WRONG_AGREED) { return wrong_agreed; }
    if (what == SR_ATTACKERS_SUSPENDED) { return attackers_out; }
    if (what == SR_HONEST_SUSPENDED) { return honest_out; }
    if (what == SR_JOBS_AGREED) { return jobs_agreed; }
    if (what == SR_ANCHOR_REPLICAS) { return anchor_replicas; }
    if (what == SR_CANARIES) { return canaries; }
    if (what == SR_ATTACKER_REPLICAS) { return attacker_replicas; }
    return 0;
}

/// The sum of `what` over SIM_SEEDS seeds (queen/simulation.t27 run_seed from SIM_BASE_SEED).
pub fn sybil_total(attackers: u32, defenses: u32, what: u8) -> u64 {
    var sum : u64 = 0;
    var i : u32 = 0;
    while (i < SIM_SEEDS) {
        sum = sum + sybil_run(run_seed(SIM_BASE_SEED, i), attackers, defenses, what);
        i = i + 1;
    }
    return sum;
}

/// The expectation over the seeds, in thousandths.
pub fn sybil_mean_milli(attackers: u32, defenses: u32, what: u8) -> u64 {
    return (sybil_total(attackers, defenses, what) * 1000) / (SIM_SEEDS as u64);
}

; --- tests --------------------------------------------------------------------------------------------

test a_public_majority_never_outvotes_the_anchor {
    // the anchor and one public vote agree: believed
    assert anchored_verdict(true, 2, 2, 2, false) == JV_AGREED;
    // two public keys agree against the anchor: never believed, at most unresolved
    assert anchored_verdict(true, 1, 3, 3, false) == JV_UNRESOLVED;
    assert anchored_verdict(true, 1, 2, 2, false) == JV_TIEBREAK;
    // public votes alone, however many agree, wait for their anchor
    assert anchored_verdict(false, 0, 2, 2, false) == JV_PENDING;
    assert anchored_verdict(false, 0, 3, 3, false) == JV_PENDING;
    assert anchored_verdict(false, 0, 2, 2, true) == JV_UNRESOLVED;
    // where plain agreement would have believed the two
    assert job_verdict(2, 2, 0, 2, false) == JV_AGREED;
}

test a_public_host_never_takes_the_anchors_slot {
    assert public_may_take(true, false, 0) == true;
    assert public_may_take(true, false, 1) == false;
    assert public_may_take(true, false, 2) == false;
    // a known answer is the anchor: every slot is open
    assert public_may_take(true, true, 1) == true;
    assert public_may_take(true, true, 2) == true;
    // with the rule off, as in slice 1
    assert public_may_take(false, false, 1) == true;
    assert replicas_wanted(false) == REPLICAS_K;
    assert replicas_wanted(true) == REPLICAS_K - 1;
    assert anchors(TIER_OWNER) == true;
    assert anchors(TIER_TRUSTED) == true;
    assert anchors(TIER_PUBLIC) == false;
}

test a_known_answer_job_agrees_with_one_matching_replica {
    // known answer plus one matching vote
    assert anchored_verdict(true, 2, 1, 1, false) == JV_AGREED;
    // one wrong vote: one more replica
    assert anchored_verdict(true, 1, 1, 1, false) == JV_TIEBREAK;
    // three wrong votes: unresolved, and each was already slashed as a wrong canary
    assert anchored_verdict(true, 1, 3, 3, false) == JV_UNRESOLVED;
}

test a_wrong_canary_is_slashed_and_struck {
    assert canary_due(0, CANARY_PERMILLE) == true;
    assert canary_due(99, CANARY_PERMILLE) == true;
    assert canary_due(100, CANARY_PERMILLE) == false;
    assert canary_due(999, CANARY_PERMILLE) == false;
    assert canary_due(1099, CANARY_PERMILLE) == true;
    assert canary_due(5, 0) == false;
    assert canary_wrong(true, false) == true;
    assert canary_wrong(true, true) == false;
    assert canary_wrong(false, false) == false;
    // slashed and struck with no quorum at all
    assert slash_due(true, SIDE_NONE, false) == true;
    assert struck(true, SIDE_NONE, false) == true;
    assert slash_due(true, SIDE_NONE, true) == false;
    assert struck(true, SIDE_NONE, true) == false;
}

test a_new_key_earns_nothing_on_probation {
    assert on_probation(0) == true;
    assert on_probation(PROBATION_JOBS - 1) == true;
    assert on_probation(PROBATION_JOBS) == false;
    assert vote_credit(SIDE_AGREED, false, PROBATION_JOBS - 1, 0, CAP_PUBLIC_MTRI) == 0;
    assert vote_credit(SIDE_AGREED, false, PROBATION_JOBS, 0, CAP_PUBLIC_MTRI) == REWARD_PER_JOB_MTRI;
    // the dissenting side earns nothing after probation either
    assert vote_credit(SIDE_DISSENT, false, PROBATION_JOBS, 0, CAP_PUBLIC_MTRI) == 0;
    assert vote_credit(SIDE_AGREED, true, PROBATION_JOBS, 0, CAP_PUBLIC_MTRI) == 0;
}

test a_key_is_capped_per_epoch_and_attestation_raises_the_cap {
    assert credit_capped(0, 1, 24) == 1;
    assert credit_capped(23, 1, 24) == 1;
    assert credit_capped(24, 1, 24) == 0;
    assert credit_capped(23, 5, 24) == 1;
    assert credit_capped(30, 1, 24) == 0;
    assert vote_credit(SIDE_AGREED, false, PROBATION_JOBS, CAP_PUBLIC_MTRI, CAP_PUBLIC_MTRI) == 0;
    assert epoch_cap(TIER_PUBLIC, false) == CAP_PUBLIC_MTRI;
    assert epoch_cap(TIER_PUBLIC, true) == CAP_ATTESTED_MTRI;
    assert epoch_cap(TIER_TRUSTED, false) == CAP_TRUSTED_MTRI;
    assert epoch_cap(TIER_OWNER, false) == BALANCE_MAX;
    assert attested(true, ATTEST_NONE, false, 0) == true;
    assert attested(false, ATTEST_TELEGRAM, true, 0) == true;
    assert attested(false, ATTEST_TELEGRAM, false, 0) == false;
    assert attested(false, ATTEST_GITHUB_AGE, true, GITHUB_AGE_MIN_DAYS) == true;
    assert attested(false, ATTEST_GITHUB_AGE, true, GITHUB_AGE_MIN_DAYS - 1) == false;
    assert attested(false, ATTEST_NONE, true, 9999) == false;
    assert attested(false, ATTEST_KINDS, true, 9999) == false;
}

test a_slash_forfeits_this_epochs_credit_and_nothing_more {
    assert slash_mtri(10, CAP_PUBLIC_MTRI) == 10;
    assert slash_mtri(0, CAP_PUBLIC_MTRI) == 0;
    assert slash_mtri(500, CAP_TRUSTED_MTRI) == CAP_TRUSTED_MTRI;
    // a vote against an agreed result is slashed and struck; an agreeing or unjudged one is not
    assert slash_due(false, SIDE_DISSENT, false) == true;
    assert slash_due(false, SIDE_AGREED, false) == false;
    assert slash_due(false, SIDE_NONE, false) == false;
    assert struck(false, SIDE_DISSENT, false) == true;
    assert struck(false, SIDE_AGREED, false) == false;
}

test the_sybil_earns_nothing_with_the_anchor_and_canaries {
    assert sybil_total(1, D_ALL, SR_ATTACKER_MTRI) == 0;
    assert sybil_total(2, D_ALL, SR_ATTACKER_MTRI) == 0;
    assert sybil_total(5, D_ALL, SR_ATTACKER_MTRI) == 0;
    assert sybil_total(20, D_ALL, SR_ATTACKER_MTRI) == 0;
    // and no wrong result is ever believed
    assert sybil_total(2, D_ALL, SR_WRONG_AGREED) == 0;
    assert sybil_total(5, D_ALL, SR_WRONG_AGREED) == 0;
    assert sybil_total(20, D_ALL, SR_WRONG_AGREED) == 0;
    // the attacker did hold replicas, and the honest hosts were paid
    assert sybil_total(20, D_ALL, SR_ATTACKER_REPLICAS) > 0;
    assert sybil_total(20, D_ALL, SR_HONEST_MTRI) > 0;
    assert sybil_total(1, D_ALL, SR_HONEST_MTRI) > 0;
}

test without_the_anchor_and_canaries_the_sybil_is_paid {
    assert sybil_total(20, D_NO_ANCHOR_NO_CANARY, SR_ATTACKER_MTRI) > 0;
    // wrong results are believed from two keys up
    assert sybil_total(2, D_NO_ANCHOR_NO_CANARY, SR_WRONG_AGREED) > 0;
    assert sybil_total(5, D_NO_ANCHOR_NO_CANARY, SR_WRONG_AGREED) > 0;
    assert sybil_total(20, D_NO_ANCHOR_NO_CANARY, SR_WRONG_AGREED) > 0;
    // one key never forms a quorum alone: placement gives it one replica per job
    assert sybil_total(1, D_NO_ANCHOR_NO_CANARY, SR_ATTACKER_MTRI) == 0;
    assert sybil_total(1, D_NO_ANCHOR_NO_CANARY, SR_WRONG_AGREED) == 0;
}

test slice_one_pays_the_sybil_from_two_keys {
    assert sybil_total(2, D_SLICE1, SR_ATTACKER_MTRI) > 0;
    assert sybil_total(5, D_SLICE1, SR_ATTACKER_MTRI) > 0;
    assert sybil_total(20, D_SLICE1, SR_ATTACKER_MTRI) > 0;
    assert sybil_total(1, D_SLICE1, SR_ATTACKER_MTRI) == 0;
}

test canaries_alone_cut_the_sybils_pay {
    assert sybil_total(20, D_NO_ANCHOR_NO_CANARY + D_CANARY, SR_ATTACKER_MTRI) < sybil_total(20, D_NO_ANCHOR_NO_CANARY, SR_ATTACKER_MTRI);
    assert sybil_total(20, D_NO_ANCHOR_NO_CANARY + D_CANARY, SR_WRONG_AGREED) < sybil_total(20, D_NO_ANCHOR_NO_CANARY, SR_WRONG_AGREED);
}

test canaries_come_at_the_spec_rate_and_spare_the_anchor {
    // 8 seeds x 240 jobs, one in ten a canary: 192 expected, inside four standard deviations
    assert sybil_total(5, D_ALL, SR_CANARIES) >= 140;
    assert sybil_total(5, D_ALL, SR_CANARIES) <= 244;
    assert sybil_total(5, D_ALL - D_CANARY, SR_CANARIES) == 0;
    // a canary job needs no anchor replica
    assert sybil_total(5, D_ALL, SR_ANCHOR_REPLICAS) < sybil_total(5, D_ALL - D_CANARY, SR_ANCHOR_REPLICAS);
}

test the_same_seed_gives_the_same_run {
    assert sybil_run(7, 5, D_ALL, SR_HONEST_MTRI) == sybil_run(7, 5, D_ALL, SR_HONEST_MTRI);
    assert sybil_run(7, 20, D_SLICE1, SR_ATTACKER_MTRI) == sybil_run(7, 20, D_SLICE1, SR_ATTACKER_MTRI);
    assert sybil_run(7, 99, D_SLICE1, SR_JOBS_AGREED) == sybil_run(7, SIM_ATTACKERS_MAX, D_SLICE1, SR_JOBS_AGREED);
    assert defended(D_ALL, D_ANCHOR) == true;
    assert defended(D_NO_ANCHOR_NO_CANARY, D_ANCHOR) == false;
    assert defended(D_NO_ANCHOR_NO_CANARY, D_CANARY) == false;
    assert defended(D_NO_ANCHOR_NO_CANARY, D_PROBATION) == true;
}

/// The defense needs an anchor tier, a known-answer share and a probation that ends.
invariant the_defense_is_configured {
    assert ANCHOR_SLOTS == 1;
    assert REPLICAS_K > ANCHOR_SLOTS;
    assert CANARY_PERMILLE > 0 and CANARY_PERMILLE < PERMILLE;
    assert PROBATION_JOBS > 0;
    assert STRIKES_MAX > 0;
}
/// The cap only grows with trust.
invariant the_cap_grows_with_trust {
    assert CAP_PUBLIC_MTRI > 0;
    assert CAP_ATTESTED_MTRI > CAP_PUBLIC_MTRI;
    assert CAP_TRUSTED_MTRI > CAP_ATTESTED_MTRI;
    assert BALANCE_MAX > CAP_TRUSTED_MTRI;
}
/// The simulated world fits its arrays, and the rule bits are five.
invariant the_world_fits {
    assert SIM_ANCHOR_HOSTS + SIM_HONEST + SIM_ATTACKERS_MAX <= SIM_KEYS_MAX;
    assert REPLICAS_MAX < 4;
    assert SR_KINDS == 9;
    assert D_ALL == D_ANCHOR + D_CANARY + D_PROBATION + D_CAP + D_SLASH;
    assert D_NO_ANCHOR_NO_CANARY == D_PROBATION + D_CAP + D_SLASH;
}
