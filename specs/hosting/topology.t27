    Edge { .from = S_WOODY_TURBOBABY_BOT, .to = S_WOODY_POSTGRES, .basis = DEP_BY_STORE },
    Edge { .from = S_WOODY_WOODY_WEED_BOT, .to = S_WOODY_BUCKET, .basis = DEP_BY_STORE },
    Edge { .from = S_WOODY_WOODY_WEED_BOT, .to = S_WOODY_POSTGRES, .basis = DEP_BY_STORE },
];
; ==== END GENERATED ====

; --- Judgments the manifest cannot hold ----------------------------------------------------------
; Each is a list of rows by index. A test below checks every entry against the generated rows.

; The stop of 2026-10-10 about 16:15Z, on the owner's approval (#8675, comment "Stopped on the owner's
; approval"). `railway down` removed each active deployment; config, variables and volumes stay.
