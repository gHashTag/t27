; --- Rules: the rows -----------------------------------------------------------------------------

pub fn is_stopped(i: u32) -> bool {
    var k : u32 = 0;
    while (k < STOPPED_COUNT) {
        if (STOPPED[k] == i) { return true; }
        k = k + 1;
    }
    return false;
}

pub fn pii_of(i: u32) -> u8 {
    var k : u32 = 0;
    while (k < PERSONAL_DATA_COUNT) {
        if (PERSONAL_DATA[k] == i) { return PII_YES; }
        k = k + 1;
    }
    k = 0;
    while (k < PERSONAL_DATA_UNKNOWN_COUNT) {
        if (PERSONAL_DATA_UNKNOWN[k] == i) { return PII_UNKNOWN; }
        k = k + 1;
    }
    return PII_NO;
}

pub fn holds_pii(i: u32) -> bool {
    return pii_of(i) != PII_NO;
}

pub fn is_checkable(i: u32) -> bool {
    var k : u32 = 0;
    while (k < CHECKABLE_COUNT) {
        if (CHECKABLE[k] == i) { return true; }
        k = k + 1;
    }
    return false;
}

pub fn is_store(i: u32) -> bool {
    return SERVICES[i].engine != ENGINE_NONE;
}

/// What a restore deploys: a row with a working deployment that was not stopped.
pub fn restores(i: u32) -> bool {
    return SERVICES[i].deploy == DEP_ACTIVE and is_stopped(i) == false;
}

/// The code exists only inside Railway: a rebuild has nothing to build from.
pub fn is_source_missing(i: u32) -> bool {
    return SERVICES[i].found == FOUND_MISSING;
}

pub fn rebuilds_from_git(i: u32) -> bool {
    let src : u8 = SERVICES[i].src;
    if (src == SRC_REPO or src == SRC_TEMPLATE) { return true; }
    return src == SRC_UPLOAD and SERVICES[i].found == FOUND_IN_GIT;
}

pub fn has_domain(i: u32) -> bool {
    return SERVICES[i].custom_domains + SERVICES[i].railway_domains > 0;
}

pub fn data_volumes_of(i: u32) -> u32 {
    var n : u32 = 0;
    var v : u32 = 0;
    while (v < VOLUME_COUNT) {
        if (VOLUMES[v].service == i and VOLUMES[v].class == VOL_DATA) { n = n + 1; }
        v = v + 1;
    }
    return n;
}

pub fn is_stateful(i: u32) -> bool {
    return data_volumes_of(i) > 0;
}

pub fn holds_pii_at_rest(i: u32) -> bool {
    return is_stateful(i) and holds_pii(i);
}

; --- Rules: dependencies -------------------------------------------------------------------------

pub fn edge_count() -> u32 {
    return NAME_EDGE_COUNT + CODE_EDGE_COUNT;
}

pub fn edge_from(e: u32) -> u32 {
    if (e < NAME_EDGE_COUNT) { return NAME_EDGES[e].from; }
    return CODE_EDGES[e - NAME_EDGE_COUNT].from;
}

pub fn edge_to(e: u32) -> u32 {
    if (e < NAME_EDGE_COUNT) { return NAME_EDGES[e].to; }
    return CODE_EDGES[e - NAME_EDGE_COUNT].to;
}

pub fn edge_basis(e: u32) -> u8 {
    if (e < NAME_EDGE_COUNT) { return NAME_EDGES[e].basis; }
    return CODE_EDGES[e - NAME_EDGE_COUNT].basis;
}

pub fn depends_on(s: u32, t: u32) -> bool {
    var e : u32 = 0;
    while (e < edge_count()) {
        if (edge_from(e) == s and edge_to(e) == t) { return true; }
        e = e + 1;
    }
    return false;
}

/// An edge between two rows a restore deploys.
pub fn live_edge(e: u32) -> bool {
    return restores(edge_from(e)) and restores(edge_to(e));
}

/// Live edges into a row: how many restored rows wait for it.
pub fn inbound_edges(t: u32) -> u32 {
    var n : u32 = 0;
    var e : u32 = 0;
    while (e < edge_count()) {
        if (edge_to(e) == t and live_edge(e)) { n = n + 1; }
        e = e + 1;
    }
    return n;
}

/// Personal data at rest anywhere downstream: a path of one or more edges (stopped rows included,
/// since their config keeps the credentials) ends at a stateful row that holds personal data.
pub fn reaches_pii_at_rest(i: u32) -> bool {
    var r : [64]bool = [false] ** 64;
    var changed : bool = true;
    var round : u32 = 0;
    while (changed and round <= SERVICE_COUNT) {
        changed = false;
        var e : u32 = 0;
        while (e < edge_count()) {
            let s : u32 = edge_from(e);
            let t : u32 = edge_to(e);
            if (r[s] == false and (holds_pii_at_rest(t) or r[t])) {
                r[s] = true;
                changed = true;
            }
            e = e + 1;
        }
        round = round + 1;
    }
    return r[i];
}

; --- Rules: the restore order --------------------------------------------------------------------

/// A worker or a cron: it runs on a schedule, or nothing calls it and it has no domain, so it only
/// pulls work. A store is neither. (The parameter is `exposed`, not `domain`: gen-zig compares any
/// `domain == false` as a string once a struct has a str field of that name, see #8704.)
pub fn worker_rule(store: bool, scheduled: bool, exposed: bool, inbound: u32) -> bool {
    if (store) { return false; }
    if (scheduled) { return true; }
    return exposed == false and inbound == 0;
}

pub fn is_worker(i: u32) -> bool {
    return worker_rule(is_store(i), SERVICES[i].scheduled, has_domain(i), inbound_edges(i));
}

pub fn phase_of(i: u32) -> u32 {
    if (is_store(i)) { return PHASE_STORE; }
    if (is_worker(i)) { return PHASE_WORKER; }
    return PHASE_SERVICE;
}

/// The longest chain of live dependencies inside a row's phase. A cycle never settles, so the
/// relaxation stops after SERVICE_COUNT rounds and has_cycle reports it.
pub fn depth_of(i: u32) -> u32 {
    var ph : [64]u32 = [0] ** 64;
    var j : u32 = 0;
    while (j < SERVICE_COUNT) {
        ph[j] = phase_of(j);
        j = j + 1;
    }
    var d : [64]u32 = [0] ** 64;
    var changed : bool = true;
    var round : u32 = 0;
    while (changed and round <= SERVICE_COUNT) {
        changed = false;
        var e : u32 = 0;
        while (e < edge_count()) {
            let s : u32 = edge_from(e);
            let t : u32 = edge_to(e);
            if (live_edge(e) and ph[s] == ph[t] and d[t] + 1 > d[s]) {
                d[s] = d[t] + 1;
                changed = true;
            }
            e = e + 1;
        }
        round = round + 1;
    }
    return d[i];
}

pub fn has_cycle() -> bool {
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (depth_of(i) >= SERVICE_COUNT) { return true; }
        i = i + 1;
    }
    return false;
}

/// The sort key: phase, then depth, then row. Rows < MAX_SERVICES and depths < 64 keep it exact.
pub fn restore_key(i: u32) -> u32 {
    return phase_of(i) * 4096 + depth_of(i) * 64 + i;
}

pub fn restore_count() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (restores(i)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The row restored k-th, or NO_SERVICE past the end.
pub fn restore_at(k: u32) -> u32 {
    var key : [64]u32 = [0] ** 64;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (restores(i)) { key[i] = restore_key(i); }
        i = i + 1;
    }
    i = 0;
    while (i < SERVICE_COUNT) {
        if (restores(i)) {
            var before : u32 = 0;
            var j : u32 = 0;
            while (j < SERVICE_COUNT) {
                if (restores(j) and key[j] < key[i]) { before = before + 1; }
                j = j + 1;
            }
            if (before == k) { return i; }
        }
        i = i + 1;
    }
    return NO_SERVICE;
}

; --- Rules: tiers --------------------------------------------------------------------------------

pub fn tier_rule(stateful: bool, reaches_pii: bool, secrets: bool, pii: bool, checkable: bool) -> u8 {
    if (stateful or reaches_pii) { return TIER_OWNER; }
    if (secrets == false and pii == false and checkable) { return TIER_PUBLIC; }
    return TIER_TRUSTED;
}

pub fn tier_of(i: u32) -> u8 {
    return tier_rule(is_stateful(i), reaches_pii_at_rest(i), SERVICES[i].has_vars, holds_pii(i), is_checkable(i));
}

/// Whether a host of tier `host` may run row i.
pub fn may_run_on(i: u32, host: u8) -> bool {
    return tier_of(i) >= host;
}

; --- Rules: totals -------------------------------------------------------------------------------

pub fn total_cost_cents() -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        c = c + SERVICES[i].cost_cents;
        i = i + 1;
    }
    return c;
}

pub fn restored_cost_cents() -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (restores(i)) { c = c + SERVICES[i].cost_cents; }
        i = i + 1;
    }
    return c;
}

pub fn stopped_cost_cents() -> u32 {
    var c : u32 = 0;
    var k : u32 = 0;
    while (k < STOPPED_COUNT) {
        c = c + SERVICES[STOPPED[k]].cost_cents;
        k = k + 1;
    }
    return c;
}

/// Restored rows of a tier, and what they cost per 30 days.
pub fn tier_count(t: u8) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (restores(i) and tier_of(i) == t) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn tier_cost_cents(t: u8) -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (restores(i) and tier_of(i) == t) { c = c + SERVICES[i].cost_cents; }
        i = i + 1;
    }
    return c;
}

pub fn volume_count(class: u8) -> u32 {
    var n : u32 = 0;
    var v : u32 = 0;
    while (v < VOLUME_COUNT) {
        if (VOLUMES[v].class == class) { n = n + 1; }
        v = v + 1;
    }
    return n;
}

pub fn volume_used_mb(class: u8) -> u32 {
    var m : u32 = 0;
    var v : u32 = 0;
    while (v < VOLUME_COUNT) {
        if (VOLUMES[v].class == class) { m = m + VOLUMES[v].used_mb; }
        v = v + 1;
    }
    return m;
}

pub fn count_source_missing() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (is_source_missing(i)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn count_with_secrets() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (SERVICES[i].has_vars) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn count_stateful() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (is_stateful(i)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn count_stores() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (is_store(i)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

; --- The restore order, pinned ---------------------------------------------------------------------
; An independent re-implementation of the rules above, run over the same rows (scratch, not kept),
; computed this order. The test the_restore_order holds restore_at to it, so a change in the rows or
; the rules that moves the order shows up in review as a change of this list.
pub const RESTORE_COUNT : u32 = 44;
pub const RESTORE_ORDER : [44]u32 = [
    S_999_BUCKET,
    S_999_PGVECTOR,
    S_999_POSTGRES,
    S_999_POSTGRES_NFRQ,
    S_999_REDIS,
