// SPDX-License-Identifier: Apache-2.0
; specs/hosting/topology.t27 -- what runs where: every service of the Railway deployment, and the rules
; for restoring it and for moving it off a provider
; The owner, 2026-10-10 (translated): move everything into one repository, gHashTag/trios, managed
; through .t27. Issue #8699. This is phase 2, item 7 of the disaster-recovery epic #8675, and the
; topology card that slice 2 of gHashTag/trios#1756 asks for. It is the source of truth for the
; deployment: a restore plan for a new account and the trios deploy definitions are generated from
; it, never the other way round.
; --
; Where the rows come from. The GENERATED block below is written by gen_topology.py from the
; secret-free inventory of 2026-10-10 (14 Railway projects, 59 services, 26 volumes). Both files are
; kept together off GitHub, because the step reads variable NAMES to infer dependencies and to decide
; has_vars. No name and no value is written here. The block's header carries both files' sha256.
; Everything outside the block is hand-written: the vocabularies, the judgments the manifest cannot
; hold (each entry with its reason, each checked against the rows by a test), and the rules.
; --
; What a row records, and how the step reads the manifest:
; - key: <project>/<service>. Two projects are both named igla-judge, so each of them carries its id's
;   first 8 hex digits. Rows are sorted by key, and S_<KEY> is a row's index.
; - The source. For a repo or a template it is repo, path (the root directory), branch and the
;   deployed commit. For an image it is the image and its digest. For a `railway up` upload it is the
;   digest of the image Railway built from the folder, plus the folder's place in git when the
;   inventory found it (found = FOUND_IN_GIT). A commit is pinned only when the finding names one
;   first. "Older than X", "the PR branch before X" and "same as" are not pins.
; - build: the builder of a service Railway builds. For an image or a function Railway pulls the
;   image and ignores its builder setting, so the step records BUILD_NONE.
; - port is 0 throughout. The manifest records no port. Railway injects PORT, and a domain's target
;   port was not inventoried.
; - start is the start-command override, or "" for the image's or the Dockerfile's own. The seven
;   overrides refer to variables as `$NAME`, the way Railway's minio, Redis and Inngest templates set
;   them; no value is in them. A function's inline source is not copied here; the recovered copy is
;   kept beside the manifest.
; - domain lists the custom domains. A railway.app hostname is only counted: a new account cannot
;   claim it again, and several of them front admin surfaces (minio consoles, the browser pod).
; - has_vars is true when the service has any variable names at all. It is the "holds secrets" bit,
;   and it is deliberately coarse: a service whose only variable is PORT counts.
; - cost_cents is the inventory's 30-day run-rate estimate, from the last 7 days of usage priced at
;   the bill's unit rates.
; - deploy is the state at the manifest's time. The stop of about 16:15Z that day came after it, so
;   STOPPED below holds it.
; - Dependency edges, from variable names only. Values were never read, so an edge says the names
;   point there, not that a value does:
;   - DEP_BY_NAME: the name spells a sibling service, or a source-read alias of one;
;   - DEP_BY_STORE: a store connection name, in a project with one store of that engine;
;   - DEP_STORE_CANDIDATE: the same, in a project with several, so there is an edge to each;
;   - DEP_BY_CODE: hand-written in CODE_EDGES below, with the source file it was read in.
;   Stores are never sources, because their variables are their own connection strings. Only edges
;   inside one project are inferred.
; --
; The rules:
; - A data store is a row whose engine is Postgres, Redis or minio. A service is stateful when a DATA
;   volume is attached to it. A CACHE or MODEL volume is refilled from git or a model hub, so it
;   leaves a service stateless.
; - The restore order: data stores first, then the services, then the workers and crons. Inside a
;   phase, a service follows everything it depends on, and ties go by row. Only what is deployed and
;   not stopped is restored. The rest is recreated as config, or not at all.
; - Tiers, by gHashTag/trios#1756:
;   - owner: any workload;
;   - trusted: named people, stateless services, secrets scoped to the service;
;   - public: anyone, but only stateless, secret-free, PII-free work that is a deterministic job,
;     because only such a job's result can be checked by agreement.
;   A service that is stateful, or that can reach personal data at rest through its dependencies
;   (any path of edges), is owner-only. Personal data that only passes through, such as a voice note
;   being transcribed, still allows trusted, as #1756 itself proposes for gigaam and parakeet.
;   UNKNOWN personal data counts as personal data.
; --
; What the rules compute today (each figure is held by a test below):
; - 44 of 59 rows are restored: 9 stores, then 30 services, then 5 workers and crons. 10 rows are
;   stopped, and 5 failed, crashed or never deployed.
; - Tiers of the 44: 25 owner-only ($608.48 per 30 days), 19 trusted ($651.73), 0 public. The one
;   public row is a finished nextpnr job with no deployment.
; - The 30-day run-rate is $1,455.63: $1,260.21 restored, $190.57 stopped.
; - 3 services exist only inside Railway, 16 DATA volumes hold 39,578 MB, and 48 rows hold secrets.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module HostingTopology;

; --- Vocabularies -------------------------------------------------------------------------------

/// Where a service's code comes from.
pub const SRC_NONE : u8 = 0;
pub const SRC_REPO : u8 = 1;
pub const SRC_TEMPLATE : u8 = 2;
pub const SRC_IMAGE : u8 = 3;
pub const SRC_UPLOAD : u8 = 4;
pub const SRC_FUNCTION : u8 = 5;

/// What the inventory's source search found for an upload or a function. FOUND_NA: the source is the
/// manifest's own (a repo, a template or an image).
pub const FOUND_NA : u8 = 0;
pub const FOUND_IN_GIT : u8 = 1;
pub const FOUND_MISSING : u8 = 2;
pub const FOUND_NOTHING_TO_LOSE : u8 = 3;
pub const FOUND_FUNCTION : u8 = 4;

/// Whether the code's repository is public, private, or there is no repository.
pub const CODE_NONE : u8 = 0;
pub const CODE_PUBLIC : u8 = 1;
pub const CODE_PRIVATE : u8 = 2;

pub const BUILD_NONE : u8 = 0;
pub const BUILD_DOCKERFILE : u8 = 1;
pub const BUILD_NIXPACKS : u8 = 2;
pub const BUILD_RAILPACK : u8 = 3;

/// The deployment state at the manifest's time.
pub const DEP_NONE : u8 = 0;
pub const DEP_ACTIVE : u8 = 1;
pub const DEP_CRASHED : u8 = 2;
pub const DEP_FAILED : u8 = 3;

pub const ENGINE_NONE : u8 = 0;
pub const ENGINE_POSTGRES : u8 = 1;
pub const ENGINE_REDIS : u8 = 2;
pub const ENGINE_MINIO : u8 = 3;

/// A volume's class: DATA must survive, CACHE is refilled from git, MODEL from a model hub.
pub const VOL_DATA : u8 = 1;
pub const VOL_CACHE : u8 = 2;
pub const VOL_MODEL : u8 = 3;

/// How an edge is known.
pub const DEP_BY_NAME : u8 = 1;
pub const DEP_BY_STORE : u8 = 2;
pub const DEP_STORE_CANDIDATE : u8 = 3;
pub const DEP_BY_CODE : u8 = 4;

pub const PII_NO : u8 = 0;
pub const PII_YES : u8 = 1;
pub const PII_UNKNOWN : u8 = 2;

/// Host tiers, widest trust first. A service of tier t may run on a host of tier h when t >= h.
pub const TIER_OWNER : u8 = 0;
pub const TIER_TRUSTED : u8 = 1;
pub const TIER_PUBLIC : u8 = 2;

pub const PHASE_STORE : u32 = 0;
pub const PHASE_SERVICE : u32 = 1;
pub const PHASE_WORKER : u32 = 2;

/// Row capacity of the rules' working arrays; a volume with no service names NO_SERVICE.
pub const MAX_SERVICES : u32 = 64;
pub const NO_SERVICE : u32 = 255;

pub struct Service {
    key: str,
    project: str,
    name: str,
    src: u8,
    repo: str,
    path: str,
    branch: str,
    commit: str,
    image: str,
    digest: str,
    code: u8,
    found: u8,
    build: u8,
    dockerfile: str,
    config: str,
    start: str,
    port: u32,
    healthcheck: str,
    cron: str,
    scheduled: bool,
    region: str,
    deploy: u8,
    engine: u8,
    domain: str,
    custom_domains: u32,
    railway_domains: u32,
    has_vars: bool,
    cost_cents: u32,
}

pub struct Volume {
    service: u32,
    project: str,
    mount: str,
    class: u8,
    size_mb: u32,
    used_mb: u32,
}

pub struct Edge {
    from: u32,
    to: u32,
    basis: u8,
}

