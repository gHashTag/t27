    S_999_TRIOS_BEE_RUNNER_1,
    S_999_TRIOS_BEE_RUNNER_2,
    S_IGLA_JUDGE_1A315000_LOOP,
];

invariant the_rows_fit_the_working_arrays { SERVICE_COUNT <= MAX_SERVICES }
invariant no_service_is_a_row { NO_SERVICE >= MAX_SERVICES }
invariant the_restore_order_fits { RESTORE_COUNT <= SERVICE_COUNT }

; --- Tests -----------------------------------------------------------------------------------------

; The generated rows hold together: the inventory's counts, each key opens with its project, and
; the step's normalisations held on every row.
test the_rows_are_the_inventory {
    assert SERVICE_COUNT == 59;
    assert VOLUME_COUNT == 26;
    assert NAME_EDGE_COUNT == 63;
    assert edge_count() == 72;
    assert PREVIOUS_PERIOD_CENTS == 69907;
    assert SERVICES[S_999_POSTGRES].key == "999/Postgres";
    assert SERVICES[S_999_INNGEST_INNGEST].name == "inngest/inngest";
    assert SERVICES[S_TRIOS_RAILWAY_TRIOS_RAILWAY].key == "trios-railway/trios-railway";
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        let s : Service = SERVICES[i];
        var c : usize = 0;
        while (c < s.project.len) {
            assert s.key[c] == s.project[c];
            c = c + 1;
        }
        assert s.key[s.project.len] == '/';
        assert s.key.len == s.project.len + 1 + s.name.len;
        assert s.port == 0;
        assert s.scheduled == (s.cron.len > 0);
        let pulled : bool = s.src == SRC_IMAGE or s.src == SRC_FUNCTION or s.src == SRC_NONE;
        assert pulled == (s.build == BUILD_NONE);
        if (s.src == SRC_REPO or s.src == SRC_TEMPLATE) { assert s.commit.len == 40; }
        if (s.src == SRC_IMAGE) {
            assert s.image.len > 0;
            assert s.digest.len == 71;
            assert s.digest[6] == ':';
        }
        assert s.custom_domains == 0 or s.domain.len > 0;
        i = i + 1;
    }
}

; Every hand-written judgment names a real row, once.
test every_judgment_names_a_real_row {
    var k : u32 = 0;
    while (k < STOPPED_COUNT) {
        assert STOPPED[k] < SERVICE_COUNT;
        var j : u32 = k + 1;
        while (j < STOPPED_COUNT) { assert STOPPED[j] != STOPPED[k]; j = j + 1; }
        k = k + 1;
    }
    k = 0;
    while (k < PERSONAL_DATA_COUNT) {
        assert PERSONAL_DATA[k] < SERVICE_COUNT;
        var j : u32 = k + 1;
        while (j < PERSONAL_DATA_COUNT) { assert PERSONAL_DATA[j] != PERSONAL_DATA[k]; j = j + 1; }
        var u : u32 = 0;
        while (u < PERSONAL_DATA_UNKNOWN_COUNT) { assert PERSONAL_DATA_UNKNOWN[u] != PERSONAL_DATA[k]; u = u + 1; }
        k = k + 1;
    }
    k = 0;
    while (k < PERSONAL_DATA_UNKNOWN_COUNT) {
        assert PERSONAL_DATA_UNKNOWN[k] < SERVICE_COUNT;
        k = k + 1;
    }
    k = 0;
    while (k < CHECKABLE_COUNT) {
        assert CHECKABLE[k] < SERVICE_COUNT;
        k = k + 1;
    }
    k = 0;
    while (k < CODE_EDGE_COUNT) {
        assert CODE_EDGES[k].from < SERVICE_COUNT and CODE_EDGES[k].to < SERVICE_COUNT;
        assert CODE_EDGES[k].basis == DEP_BY_CODE;
        k = k + 1;
    }
    assert SERVICES[STOPPED[0]].key == "999/voice-clone-qwen";
    assert SERVICES[STOPPED[9]].key == "999/trios-railway";
    assert pii_of(S_999_POSTGRES) == PII_YES;
    assert pii_of(S_999_SKILLS_SITE) == PII_UNKNOWN;
    assert pii_of(S_999_CHECK_RUNNER) == PII_NO;
    assert holds_pii(S_999_SKILLS_SITE);
    assert is_checkable(S_DAYO64_XCHECK_BUILD);
    assert is_checkable(S_999_WHISPER) == false;
}

; The ten services stopped on 2026-10-10 were running, held no data, and cost $190.57 per 30 days.
test the_stop_of_2026_10_10 {
    var k : u32 = 0;
    while (k < STOPPED_COUNT) {
        let i : u32 = STOPPED[k];
        assert is_stopped(i);
        assert SERVICES[i].deploy == DEP_ACTIVE;
        assert restores(i) == false;
        assert is_stateful(i) == false;
        k = k + 1;
    }
    assert is_stopped(S_999_VOICE_CLONE) == false;
    assert stopped_cost_cents() == 19057;
}

; skills-site, jobsearch-cron and project-brain exist only inside Railway. All three still run, so
; their running files must be copied out before a restore can rebuild them.
test three_services_exist_only_inside_railway {
    assert count_source_missing() == 3;
    assert is_source_missing(S_999_SKILLS_SITE);
    assert is_source_missing(S_999_JOBSEARCH_CRON);
    assert is_source_missing(S_PROJECT_BRAIN_PROJECT_BRAIN);
    assert restores(S_999_SKILLS_SITE) and restores(S_999_JOBSEARCH_CRON) and restores(S_PROJECT_BRAIN_PROJECT_BRAIN);
    assert rebuilds_from_git(S_999_SKILLS_SITE) == false;
    assert rebuilds_from_git(S_PROJECT_BRAIN_PROJECT_BRAIN) == false;
    // A function's code is inline in Railway, a finished job has nothing to lose: neither is missing.
    assert is_source_missing(S_999_CRM_DOOR_ONCE) == false;
    assert is_source_missing(S_DAYO64_XCHECK_BUILD) == false;
    // An upload found in git rebuilds from it; an image is pulled.
    assert rebuilds_from_git(S_999_BROWSER_POD);
    assert SERVICES[S_999_BROWSER_POD].code == CODE_PRIVATE;
    assert rebuilds_from_git(S_999_BUCKET);
    assert rebuilds_from_git(S_999_POSTGRES) == false;
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (rebuilds_from_git(i)) { n = n + 1; }
        i = i + 1;
    }
    assert n == 36;
}

; Nine stores, fifteen stateful services, and the volume classes of the inventory.
test stores_volumes_and_state {
    assert count_stores() == 9;
    assert count_stateful() == 15;
    assert volume_count(VOL_DATA) == 16;
    assert volume_used_mb(VOL_DATA) == 39578;
    assert volume_count(VOL_CACHE) == 8;
    assert volume_used_mb(VOL_CACHE) == 150900;
    assert volume_count(VOL_MODEL) == 2;
    assert volume_used_mb(VOL_MODEL) == 10904;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        if (is_store(i)) { assert is_stateful(i); }
        i = i + 1;
    }
    // A CACHE or MODEL volume leaves a service stateless.
    assert data_volumes_of(S_999_POSTGRES) == 1;
    assert data_volumes_of(S_999_TRIOS_AGENT_SERVER) == 0;
    assert is_stateful(S_999_TRIOS_AGENT_SERVER) == false;
    assert holds_pii_at_rest(S_999_POSTGRES);
    assert holds_pii_at_rest(S_999_WHISPER) == false;
    assert has_domain(S_999_BUCKET);
    assert has_domain(S_999_WHISPER) == false;
    assert is_stateful(S_999_WHISPER) == false;
    assert is_stateful(S_999_BROWSER_POD);
    // The unattached old copy of woody's Postgres is DATA with no service.
    var unattached : u32 = 0;
    var v : u32 = 0;
    while (v < VOLUME_COUNT) {
        if (VOLUMES[v].service == NO_SERVICE) {
            unattached = unattached + 1;
            assert VOLUMES[v].class == VOL_DATA;
        } else {
            assert VOLUMES[v].service < SERVICE_COUNT;
        }
        v = v + 1;
    }
    assert unattached == 1;
}

; Edges stay inside a project, never start at a store, never loop on themselves.
test dependencies {
    var e : u32 = 0;
    while (e < edge_count()) {
        let s : u32 = edge_from(e);
        let t : u32 = edge_to(e);
        assert s != t;
        assert is_store(s) == false;
        assert SERVICES[s].project == SERVICES[t].project;
        assert edge_basis(e) >= DEP_BY_NAME and edge_basis(e) <= DEP_BY_CODE;
        e = e + 1;
    }
    assert depends_on(S_999_VIBEE_RENDER, S_999_GIGAAM);
    assert depends_on(S_999_VIBEE_RENDER, S_999_VOICE_CLONE);
    assert depends_on(S_999_SUPABASE_STORAGE, S_999_POSTGREST);
    assert depends_on(S_999_999_MULTIBOTS_TELEGRAF, S_999_REDIS);
    assert depends_on(S_999_ZEP, S_999_ZEP_NLP);
    assert depends_on(S_999_WHISPER, S_999_VIBEE_RENDER) == false;
    assert inbound_edges(S_999_WHISPER) == 2;
    assert inbound_edges(S_999_ZEP_NLP) == 0;
    // render still names zep, but zep is stopped: the edge is config, not something to wait for.
    assert depends_on(S_999_VIBEE_RENDER, S_999_ZEP);
    assert inbound_edges(S_999_ZEP) == 0;
}

; The two decision rules on their own, over the cases the rows do not happen to contain.
test the_worker_and_tier_rules {
    assert worker_rule(true, true, false, 0) == false;
    assert worker_rule(false, true, true, 3);
    assert worker_rule(false, false, false, 0);
    assert worker_rule(false, false, true, 0) == false;
    assert worker_rule(false, false, false, 1) == false;
    assert tier_rule(true, false, false, false, true) == TIER_OWNER;
    assert tier_rule(false, true, false, false, true) == TIER_OWNER;
    assert tier_rule(false, false, false, false, true) == TIER_PUBLIC;
    assert tier_rule(false, false, true, false, true) == TIER_TRUSTED;
    assert tier_rule(false, false, false, true, true) == TIER_TRUSTED;
    assert tier_rule(false, false, false, false, false) == TIER_TRUSTED;
    assert tier_rule(false, false, true, true, false) == TIER_TRUSTED;
}

; Stores first, then services, then workers and crons; every live dependency before its dependent.
test the_restore_order {
    assert restore_count() == RESTORE_COUNT;
    assert has_cycle() == false;
    var k : u32 = 0;
    var last : u32 = 0;
    while (k < RESTORE_COUNT) {
        let i : u32 = restore_at(k);
        assert i == RESTORE_ORDER[k];
        assert restores(i);
        assert phase_of(i) >= last;
        last = phase_of(i);
        if (k < 9) { assert is_store(i); }
        k = k + 1;
    }
    assert restore_at(RESTORE_COUNT) == NO_SERVICE;
    var e : u32 = 0;
    while (e < edge_count()) {
        if (live_edge(e)) { assert restore_key(edge_to(e)) < restore_key(edge_from(e)); }
        e = e + 1;
    }
    assert is_worker(S_999_QUEEN_WATCH);
    assert is_worker(S_999_TRIOS_BEE_RUNNER_1);
    assert is_worker(S_999_MOUTH) == false;
    assert depth_of(S_999_VIBEE_RENDER) == 3;
}

; Tiers by gHashTag/trios#1756, and which host may run what.
test tiers {
    assert tier_count(TIER_OWNER) == 25;
    assert tier_cost_cents(TIER_OWNER) == 60848;
    assert tier_count(TIER_TRUSTED) == 19;
    assert tier_cost_cents(TIER_TRUSTED) == 65173;
    assert tier_count(TIER_PUBLIC) == 0;
    assert tier_cost_cents(TIER_PUBLIC) == 0;
    // The one public row is a finished deterministic job with no deployment.
    assert tier_of(S_DAYO64_XCHECK_BUILD) == TIER_PUBLIC;
    assert restores(S_DAYO64_XCHECK_BUILD) == false;
    // Secret-free, PII-free and stateless is not enough: a long-running service stays trusted.
    assert SERVICES[S_TRIOS_RAILWAY_TRIOS_RAILWAY].has_vars == false;
    assert tier_of(S_TRIOS_RAILWAY_TRIOS_RAILWAY) == TIER_TRUSTED;
    // A lab is a checkable job, but as deployed it holds secrets. The corpus-shard job of #1756 is
    // the same work with the host's own key instead, and that job is public.
    assert tier_of(S_T27B_LAB_T27B_LAB) == TIER_TRUSTED;
    // #1756's own slice-2 candidates: voice passes through, nothing is kept.
    assert tier_of(S_999_GIGAAM) == TIER_TRUSTED;
    assert tier_of(S_999_PARAKEET) == TIER_TRUSTED;
    // Stateful, or a path to personal data at rest.
    assert tier_of(S_999_BROWSER_POD) == TIER_OWNER;
    assert reaches_pii_at_rest(S_999_VIBEE_RENDER);
    assert tier_of(S_999_VIBEE_RENDER) == TIER_OWNER;
    assert reaches_pii_at_rest(S_999_SUPABASE_GATEWAY);
    assert reaches_pii_at_rest(S_999_TRIOS_BEE_RUNNER_1);
    assert reaches_pii_at_rest(S_999_WHISPER) == false;
    assert may_run_on(S_DAYO64_XCHECK_BUILD, TIER_PUBLIC);
    assert may_run_on(S_999_GIGAAM, TIER_TRUSTED);
    assert may_run_on(S_999_GIGAAM, TIER_PUBLIC) == false;
    assert may_run_on(S_999_POSTGRES, TIER_TRUSTED) == false;
    var i : u32 = 0;
    while (i < SERVICE_COUNT) {
        assert may_run_on(i, TIER_OWNER);
        if (tier_of(i) == TIER_PUBLIC) {
            assert is_stateful(i) == false and SERVICES[i].has_vars == false and holds_pii(i) == false;
        }
        if (tier_of(i) == TIER_OWNER) { assert is_stateful(i) or reaches_pii_at_rest(i); }
        i = i + 1;
    }
}

; The 30-day run-rate: $1,455.63 in all, $1,260.21 of it restored, $190.57 stopped.
test totals {
    assert total_cost_cents() == 145563;
    assert restored_cost_cents() == 126021;
    assert stopped_cost_cents() == 19057;
    assert tier_cost_cents(TIER_OWNER) + tier_cost_cents(TIER_TRUSTED) + tier_cost_cents(TIER_PUBLIC) == restored_cost_cents();
    assert tier_count(TIER_OWNER) + tier_count(TIER_TRUSTED) + tier_count(TIER_PUBLIC) == restore_count();
    // What is neither restored nor stopped: failed, crashed or never deployed.
    assert total_cost_cents() - restored_cost_cents() - stopped_cost_cents() == 485;
    assert count_with_secrets() == 48;
}
