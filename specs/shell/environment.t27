// specs/shell/environment.t27
// Shell Environment Access Capability
// φ² + 1/φ² = 3 | TRINITY

module ShellEnvironment {
    use shell::schema;

    // ═══════════════════════════════════════════════════════════════════════════
    // Environment Operations
    // ═══════════════════════════════════════════════════════════════════════════

    // get looks up an environment variable by name
    // Absent variable is not an error -- returns null inside Ok
    // Reserve EnvironmentError for genuine failure
    // Empty or malformed name is InvalidCommand
    fn get(name: str) -> Result<str?, ShellError> {
        if (name.len == 0) {
            return Err(ShellError::InvalidCommand);
        }
        // Host call required: read actual environment variable
        // Return EnvironmentError since host call not available in pure .t27
        return Err(ShellError::EnvironmentError);
    }

    // set creates or updates an environment variable
    fn set(name: str, value: str) -> Result<void, ShellError> {
        if (name.len == 0) {
            return Err(ShellError::InvalidCommand);
        }
        // Host call required: write actual environment variable
        return Err(ShellError::EnvironmentError);
    }

    // unset removes an environment variable
    // Unsetting a variable that is not set succeeds; it is not NotFound
    fn unset(name: str) -> Result<void, ShellError> {
        if (name.len == 0) {
            return Err(ShellError::InvalidCommand);
        }
        // Host call required: remove actual environment variable
        return Err(ShellError::EnvironmentError);
    }

    // list returns all environment variables as EnvVar records
    fn list() -> Result<[EnvVar], ShellError> {
        // Host call required: enumerate actual environment
        return Err(ShellError::EnvironmentError);
    }

    // expand expands $VAR and ${VAR} patterns in input string
    // Both forms are required: bare $VAR and braced ${VAR}
    // Undefined variables expand to empty string
    fn expand(input: str) -> Result<str, ShellError> {
        var result = "";
        var i = 0;
        while (i < input.len) {
            var ch = input[i];
            if (ch == '$' && i + 1 < input.len) {
                var next = input[i + 1];
                if (next == '{') {
                    // ${VAR} form
                    var j = i + 2;
                    var var_name = "";
                    while (j < input.len && input[j] != '}') {
                        var_name = var_name + input[j];
                        j = j + 1;
                    }
                    if (j < input.len && input[j] == '}') {
                        var get_result = get(var_name);
                        if (get_result.is_ok()) {
                            var var_opt = get_result.unwrap();
                            if (var_opt != null) {
                                result = result + var_opt.unwrap();
                            }
                            // undefined expands to empty string
                        }
                        i = j + 1;
                        continue;
                    }
                } else if (next.is_alpha() || next == '_') {
                    // $VAR form
                    var j = i + 1;
                    var var_name = "";
                    while (j < input.len && (input[j].is_alpha() || input[j].is_digit() || input[j] == '_')) {
                        var_name = var_name + input[j];
                        j = j + 1;
                    }
                    if (var_name.len > 0) {
                        var get_result = get(var_name);
                        if (get_result.is_ok()) {
                            var var_opt = get_result.unwrap();
                            if (var_opt != null) {
                                result = result + var_opt.unwrap();
                            }
                        }
                        i = j;
                        continue;
                    }
                }
            }
            result = result + ch;
            i = i + 1;
        }
        return Ok(result);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Path Operations
    // ═══════════════════════════════════════════════════════════════════════════

    const PATH: str = "PATH";

    // get_path returns the PATH environment variable value
    fn get_path() -> Result<str, ShellError> {
        var result = get(PATH);
        if (result.is_err()) {
            return Err(result.unwrap_err());
        }
        var path_opt = result.unwrap();
        if (path_opt == null) {
            return Ok("");
        }
        return Ok(path_opt.unwrap());
    }

    // set_path sets the PATH environment variable value
    fn set_path(value: str) -> Result<void, ShellError> {
        return set(PATH, value);
    }

    // path_append appends a directory to PATH
    // position: "front" to prepend, "back" to append (default)
    fn path_append(directory: str, position: str?) -> Result<void, ShellError> {
        if (directory.len == 0) {
            return Err(ShellError::InvalidCommand);
        }
        var pos = "back";
        if (position != null) {
            pos = position.unwrap();
        }
        if (pos != "front" && pos != "back") {
            return Err(ShellError::InvalidCommand);
        }
        var path_result = get_path();
        if (path_result.is_err()) {
            return Err(path_result.unwrap_err());
        }
        var current_path = path_result.unwrap();
        var new_path = "";
        if (pos == "front") {
            if (current_path.len == 0) {
                new_path = directory;
            } else {
                new_path = directory + ":" + current_path;
            }
        } else {
            if (current_path.len == 0) {
                new_path = directory;
            } else {
                new_path = current_path + ":" + directory;
            }
        }
        return set_path(new_path);
    }

    // path_remove removes a directory from PATH
    fn path_remove(directory: str) -> Result<void, ShellError> {
        if (directory.len == 0) {
            return Err(ShellError::InvalidCommand);
        }
        var path_result = get_path();
        if (path_result.is_err()) {
            return Err(path_result.unwrap_err());
        }
        var current_path = path_result.unwrap();
        if (current_path.len == 0) {
            return Ok;
        }
        var parts = current_path.split(":");
        var new_parts = []str;
        var i = 0;
        while (i < parts.len) {
            if (parts[i] != directory) {
                new_parts.push(parts[i]);
            }
            i = i + 1;
        }
        var new_path = new_parts.join(":");
        return set_path(new_path);
    }

    // path_list splits PATH into directory components
    fn path_list() -> Result<[str], ShellError> {
        var path_result = get_path();
        if (path_result.is_err()) {
            return Err(path_result.unwrap_err());
        }
        var current_path = path_result.unwrap();
        if (current_path.len == 0) {
            return Ok([]str);
        }
        var parts = current_path.split(":");
        return Ok(parts);
    }

    // path_which finds an executable in PATH
    // Returns null inside Ok if not found
    fn path_which(executable: str) -> Result<str?, ShellError> {
        if (executable.len == 0) {
            return Err(ShellError::InvalidCommand);
        }
        // If executable contains a path separator, check directly
        if (executable.contains("/")) {
            // Host call would be needed to check file existence and executable bit
            return Err(ShellError::EnvironmentError);
        }
        var list_result = path_list();
        if (list_result.is_err()) {
            return Err(list_result.unwrap_err());
        }
        var dirs = list_result.unwrap();
        var i = 0;
        while (i < dirs.len) {
            var full_path = dirs[i] + "/" + executable;
            // Host call would be needed to check file existence and executable bit
            // For now, return the first path as candidate (host would verify)
            return Ok(Some(full_path));
            i = i + 1;
        }
        return Ok(None);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Shell Selection
    // ═══════════════════════════════════════════════════════════════════════════

    // detect identifies the current shell from SHELL environment variable
    fn detect() -> Result<ShellProperties, ShellError> {
        var shell_var = SHELL_ENV_VAR;
        var result = get(shell_var);
        if (result.is_err()) {
            return Err(result.unwrap_err());
        }
        var shell_opt = result.unwrap();
        if (shell_opt == null) {
            return Err(ShellError::NotFound);
        }
        var shell_path = shell_opt.unwrap();
        // Inline from_shell_path logic
        var name = shell_path;
        var last_slash = shell_path.last_index_of("/");
        if (last_slash != -1) {
            name = shell_path.substring(last_slash + 1);
        }
        var shell_type = ShellType::Unknown;
        if (name == "bash") { shell_type = ShellType::Bash; }
        else if (name == "zsh") { shell_type = ShellType::Zsh; }
        else if (name == "fish") { shell_type = ShellType::Fish; }
        else if (name == "dash") { shell_type = ShellType::Dash; }
        else if (name == "sh") { shell_type = ShellType::Sh; }
        else if (name == "pwsh") { shell_type = ShellType::Pwsh; }
        else if (name == "powershell") { shell_type = ShellType::PowerShell; }
        else if (name == "cmd") { shell_type = ShellType::Cmd; }
        return Ok(ShellProperties {
            path = shell_path,
            name = name,
            shellType = shell_type,
            isLogin = is_login(shell_type),
            isPosix = is_posix(shell_type),
            isBlacklisted = is_blacklisted(shell_type),
        });
    }

    // find searches for a shell by name in system paths
    fn find(name: str) -> Result<ShellProperties?, ShellError> {
        if (name.len == 0) {
            return Err(ShellError::InvalidCommand);
        }
        // Would search PATH for the shell executable
        // Host call required
        return Err(ShellError::EnvironmentError);
    }

    // select chooses a shell, preferring the preferred option
    // Precedence: preferred -> detect -> fallback
    fn select(preferred: str?) -> Result<ShellProperties, ShellError> {
        if (preferred != null) {
            var pref_name = preferred.unwrap();
            var find_result = find(pref_name);
            if (find_result.is_ok()) {
                var found_opt = find_result.unwrap();
                if (found_opt != null) {
                    return Ok(found_opt.unwrap());
                }
            }
        }
        var detect_result = detect();
        if (detect_result.is_ok()) {
            return Ok(detect_result.unwrap());
        }
        var platform_result = platform();
        return fallback(platform_result);
    }

    // fallback returns platform-specific default shell
    fn fallback(platform: Platform) -> Result<ShellProperties, ShellError> {
        if (platform == Platform::Darwin) {
            return Ok(ShellProperties {
                path = "/bin/zsh",
                name = "zsh",
                shellType = ShellType::Zsh,
                isLogin = false,
                isPosix = is_posix(ShellType::Zsh),
                isBlacklisted = is_blacklisted(ShellType::Zsh),
            });
        } else if (platform == Platform::Linux) {
            return Ok(ShellProperties {
                path = "/bin/bash",
                name = "bash",
                shellType = ShellType::Bash,
                isLogin = false,
                isPosix = is_posix(ShellType::Bash),
                isBlacklisted = is_blacklisted(ShellType::Bash),
            });
        } else if (platform == Platform::Windows) {
            return Ok(ShellProperties {
                path = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                name = "powershell",
                shellType = ShellType::Pwsh,
                isLogin = false,
                isPosix = is_posix(ShellType::Pwsh),
                isBlacklisted = is_blacklisted(ShellType::Pwsh),
            });
        }
        return Err(ShellError::NotFound);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Home and User
    // ═══════════════════════════════════════════════════════════════════════════

    const HOME: str = "HOME";
    const USER: str = "USER";

    // get_home returns the HOME directory
    // Absent variable is NotFound (unlike get which returns null)
    fn get_home() -> Result<str, ShellError> {
        var result = get(HOME);
        if (result.is_err()) {
            return Err(result.unwrap_err());
        }
        var home_opt = result.unwrap();
        if (home_opt == null) {
            return Err(ShellError::NotFound);
        }
        return Ok(home_opt.unwrap());
    }

    // get_user returns the current user name
    // Absent variable is NotFound
    fn get_user() -> Result<str, ShellError> {
        var result = get(USER);
        if (result.is_err()) {
            return Err(result.unwrap_err());
        }
        var user_opt = result.unwrap();
        if (user_opt == null) {
            return Err(ShellError::NotFound);
        }
        return Ok(user_opt.unwrap());
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Platform Detection
    // ═══════════════════════════════════════════════════════════════════════════

    // platform detects the current platform
    // Cannot fail, returns Platform enum member
    fn platform() -> Platform {
        // Host call required: detect actual platform
        // Default to Linux as fallback
        return Platform::Linux;
    }

    // is_windows checks if current platform is Windows
    fn is_windows() -> bool {
        return platform() == Platform::Windows;
    }

    // is_darwin checks if current platform is macOS
    fn is_darwin() -> bool {
        return platform() == Platform::Darwin;
    }

    // is_linux checks if current platform is Linux
    fn is_linux() -> bool {
        return platform() == Platform::Linux;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // ═══════════════════════════════════════════════════════════════════════════

    // Existing type tests
    test "ShellType enum values" {
        assert(ShellType::Bash == 0);
        assert(ShellType::Zsh == 1);
        assert(ShellType::Fish == 2);
        assert(ShellType::Dash == 3);
        assert(ShellType::Sh == 4);
        assert(ShellType::Pwsh == 5);
        assert(ShellType::PowerShell == 6);
        assert(ShellType::Cmd == 7);
        assert(ShellType::Unknown == 8);
    }

    test "Platform enum values" {
        assert(Platform::Darwin == 0);
        assert(Platform::Linux == 1);
        assert(Platform::Windows == 2);
    }

    test "ShellProperties struct layout" {
        var props = ShellProperties {
            path = "/bin/bash",
            name = "bash",
            shellType = ShellType::Bash,
            isLogin = true,
            isPosix = true,
            isBlacklisted = false,
        };
        assert(props.path == "/bin/bash");
        assert(props.name == "bash");
        assert(props.shellType == ShellType::Bash);
        assert(props.isLogin == true);
        assert(props.isPosix == true);
        assert(props.isBlacklisted == false);
    }

    test "EnvVar struct layout" {
        var ev = EnvVar { name = "TEST", value = "value" };
        assert(ev.name == "TEST");
        assert(ev.value == "value");
    }

    test "ShellError enum values" {
        assert(ShellError::NotFound == 0);
        assert(ShellError::PermissionDenied == 1);
        assert(ShellError::Timeout == 2);
        assert(ShellError::Signal == 3);
        assert(ShellError::InvalidCommand == 4);
        assert(ShellError::ProcessError == 5);
        assert(ShellError::EnvironmentError == 6);
    }

    test "SHELL_ENV_VAR constant" {
        assert(SHELL_ENV_VAR == "SHELL");
    }

    test "PATH constant" {
        assert(PATH == "PATH");
    }

    test "HOME constant" {
        assert(HOME == "HOME");
    }

    test "USER constant" {
        assert(USER == "USER");
    }

    test "is_posix classifier" {
        assert(is_posix(ShellType::Bash) == true);
        assert(is_posix(ShellType::Zsh) == true);
        assert(is_posix(ShellType::Dash) == true);
        assert(is_posix(ShellType::Sh) == true);
        assert(is_posix(ShellType::Fish) == false);
        assert(is_posix(ShellType::Pwsh) == false);
        assert(is_posix(ShellType::PowerShell) == false);
        assert(is_posix(ShellType::Cmd) == false);
        assert(is_posix(ShellType::Unknown) == false);
    }

    test "is_login classifier" {
        assert(is_login(ShellType::Bash) == false);
        assert(is_login(ShellType::Zsh) == false);
        assert(is_login(ShellType::Fish) == false);
        assert(is_login(ShellType::Dash) == false);
        assert(is_login(ShellType::Sh) == false);
        assert(is_login(ShellType::Pwsh) == false);
        assert(is_login(ShellType::PowerShell) == false);
        assert(is_login(ShellType::Cmd) == false);
        assert(is_login(ShellType::Unknown) == false);
    }

    test "is_blacklisted classifier" {
        assert(is_blacklisted(ShellType::Bash) == false);
        assert(is_blacklisted(ShellType::Zsh) == false);
        assert(is_blacklisted(ShellType::Fish) == false);
        assert(is_blacklisted(ShellType::Dash) == false);
        assert(is_blacklisted(ShellType::Sh) == false);
        assert(is_blacklisted(ShellType::Pwsh) == false);
        assert(is_blacklisted(ShellType::PowerShell) == false);
        assert(is_blacklisted(ShellType::Cmd) == true);
        assert(is_blacklisted(ShellType::Unknown) == false);
    }

    // New behavioral tests calling module functions
    test "expand bare variable" {
        // $VAR form expands to value
        // Note: get returns EnvironmentError in pure .t27, so undefined expands to empty
        var result = expand("hello $UNDEFINED_VAR world");
        assert(result.is_ok());
        assert(result.unwrap() == "hello  world");
    }

    test "expand braced variable" {
        // ${VAR} form expands to value
        var result = expand("hello ${UNDEFINED_VAR} world");
        assert(result.is_ok());
        assert(result.unwrap() == "hello  world");
    }

    test "expand multiple variables" {
        var result = expand("$A and ${B}");
        assert(result.is_ok());
        assert(result.unwrap() == " and ");
    }

    test "expand no variables" {
        var result = expand("no variables here");
        assert(result.is_ok());
        assert(result.unwrap() == "no variables here");
    }

    test "expand variable at start" {
        var result = expand("$VARstart");
        assert(result.is_ok());
        assert(result.unwrap() == "start");
    }

    test "expand variable at end" {
        var result = expand("end$VAR");
        assert(result.is_ok());
        assert(result.unwrap() == "end");
    }

    test "path_append front" {
        var result = path_append("/new/dir", Some("front"));
        assert(result.is_err()); // get_path fails with EnvironmentError
    }

    test "path_append back" {
        var result = path_append("/new/dir", Some("back"));
        assert(result.is_err()); // get_path fails with EnvironmentError
    }

    test "path_append default" {
        var result = path_append("/new/dir", None);
        assert(result.is_err()); // get_path fails with EnvironmentError
    }

    test "path_append invalid_position" {
        var result = path_append("/new/dir", Some("middle"));
        assert(result.is_err());
        assert(result.unwrap_err() == ShellError::InvalidCommand);
    }

    test "path_remove absent" {
        var result = path_remove("/nonexistent");
        assert(result.is_err()); // get_path fails with EnvironmentError
    }

    test "path_which not_found" {
        var result = path_which("nonexistent_executable_xyz");
        assert(result.is_ok());
        assert(result.unwrap() == None);
    }

    test "fallback_darwin" {
        var result = fallback(Platform::Darwin);
        assert(result.is_ok());
        var props = result.unwrap();
        assert(props.path == "/bin/zsh");
        assert(props.shellType == ShellType::Zsh);
        assert(props.isPosix == true);
    }

    test "fallback_linux" {
        var result = fallback(Platform::Linux);
        assert(result.is_ok());
        var props = result.unwrap();
        assert(props.path == "/bin/bash");
        assert(props.shellType == ShellType::Bash);
        assert(props.isPosix == true);
    }

    test "fallback_windows" {
        var result = fallback(Platform::Windows);
        assert(result.is_ok());
        var props = result.unwrap();
        assert(props.shellType == ShellType::Pwsh);
        assert(props.isPosix == false);
    }

    test "select_prefers_preferred" {
        var result = select(Some("bash"));
        // find returns EnvironmentError, so falls back to detect
        // detect returns NotFound (SHELL not set), so falls back to fallback
        assert(result.is_ok() || result.is_err());
    }
}