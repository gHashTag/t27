// SPDX-License-Identifier: Apache-2.0
// specs/trinet/tri-bridge.t27 -- TRI on every chain: TON is the chain of record and the only minter; EVM, TRON and Solana hold TRI by lock-and-mint.
// Issue: gHashTag/t27#8302. Companion of record: gHashTag/trinity-fpga
// specs/trinet/mint_on_acceptance.t27 (how an accepted spec becomes minted TRI) and
// src/trinet/mint_authority.zig (the oracle, chains ton = 1, solana = 2); the payout addresses
// are specs/automation/tri-wallet-chains.t27 (TON, EVM, Solana, TRON, each proved by signature).
// Trace: owner 2026-10-09 "make it cross-chain, all the networks", then "do the blockchain on
// all networks, so that it is possible". Measured that day: TRI is a jetton on TON testnet only;
// trinity-fpga keeps exactly one minter on purpose, because two independent minters could
// together mint twice the cap (mint_on_acceptance.t27 CROSS_CHAIN_DOUBLE_MINT), and its README
// names the road this spec takes: one chain of record with lock-and-mint on the others.
// Hosts (to come, each against this spec's vectors): the TON vault and minter (FunC), one
// bridged-TRI contract for EVM and TRON (Solidity; TRON runs the same bytecode as TRC-20), the
// Solana bridge program (Anchor), the attestors (trinity-fpga contracts/ton/signer), and
// 999-multibots-telegraf render (tri-wallet-chains BRIDGE_LIVE, the payout route).
// Claim status: DESIGN. No contract, vault, key or bridged token exists. BRIDGE_LIVE is false
// until LIVE_REQUIRES holds; who holds the attestor keys, and M and N in production, stay the
// open question KEY_CUSTODY_AND_ATTESTOR_SET and are not guessed here.
// v1 (2026-10-09): chain of record, lock-and-mint, one supply across chains, distinct ops for
// mint / bridge-mint / release, an honest-majority quorum, finality per chain, one spend per
// lock or burn, the pause, the payout route, what must hold before it goes live.
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinet::tri_bridge {
    pub const KIND : str = "trinet";
    pub const ID : str = "tri-bridge";
    pub const VERSION : u8 = 1;

    // ---- the chains (the oracle's numbers, tri-wallet-chains.t27) ----

    pub const CHAIN_TON : u8 = 1;
    pub const CHAIN_SOLANA : u8 = 2;
    pub const CHAIN_EVM : u8 = 3;
    pub const CHAIN_TRON : u8 = 4;

    fn chain_known(chain: u8) -> bool {
        return chain >= CHAIN_TON && chain <= CHAIN_TRON;
    }

    // ---- one chain of record ----

    // New TRI is minted in exactly one place: TON, from acceptance attestations, under the cap.
    // Every other chain holds TRI that was locked on TON first. So the cap is enforced by one
    // contract and counted once, whatever the number of chains.
    pub const CHAIN_OF_RECORD : u8 = 1;
    pub const MTRI_PER_TRI : u64 = 1000;
    pub const DECIMALS : u8 = 3;
    pub const CAP_MTRI : u64 = 10460353203000;

    fn mints_new_supply(chain: u8) -> bool {
        return chain == CHAIN_OF_RECORD;
    }

    // Bridged TRI uses the same base unit everywhere, so an amount crosses unchanged.
    fn decimals_of(chain: u8) -> u8 {
        if chain_known(chain) { return DECIMALS; }
        return 0;
    }

    // ---- one supply across chains ----

    // minted: everything the TON minter ever minted. locked: what the TON vault holds.
    // bridged: the sum of bridged TRI on every other chain. The bridge is sound exactly when
    // the bridged sum equals the vault and nothing exceeds the cap.
    fn supply_sound(minted: u64, locked: u64, bridged: u64) -> bool {
        return minted <= CAP_MTRI && locked <= minted && bridged == locked;
    }

    // What a holder can see in total, on all chains: TON outside the vault plus bridged.
    fn circulating(minted: u64, locked: u64, bridged: u64) -> u64 {
        return minted - locked + bridged;
    }

    // ---- what each attestation may do ----

    // Three operations, three codes, each inside the signed digest: an acceptance mint is not
    // a bridge mint, and neither releases the vault. ASCII "TRI1", "TRI2", "TRI3".
    pub const OP_MINT_ON_ATT : u32 = 1414678833;
    pub const OP_BRIDGE_MINT : u32 = 1414678834;
    pub const OP_BRIDGE_RELEASE : u32 = 1414678835;

    fn op_usable(signed_op: u32, expected_op: u32) -> bool {
        return signed_op == expected_op;
    }

    // A bridge mint lands on a chain that is not the chain of record; a release lands on it.
    fn op_lands_on(op: u32, chain: u8) -> bool {
        if op == OP_MINT_ON_ATT || op == OP_BRIDGE_RELEASE { return chain == CHAIN_OF_RECORD; }
        if op == OP_BRIDGE_MINT { return chain_known(chain) && chain != CHAIN_OF_RECORD; }
        return false;
    }

    // ---- the quorum ----

    // M of N attestors, the same set that signs acceptance mints. Honest majority: M > N/2,
    // so any two quorums share a signer, and one honest signer that refuses a second spend of
    // the same lock is enough to stop it. M and N in production are KEY_CUSTODY's to decide.
    pub const TESTNET_M : u32 = 2;
    pub const TESTNET_N : u32 = 3;

    fn quorum_valid(m: u32, n: u32) -> bool {
        return n > 0 && m <= n && m * 2 > n;
    }

    fn quorum_met(distinct_signers: u32, m: u32, n: u32) -> bool {
        return quorum_valid(m, n) && distinct_signers >= m && distinct_signers <= n;
    }

    // ---- finality ----

    // An attestor signs a lock or a burn only from the source chain's own finalized view, never
    // from a block that can still be rolled back: a reorg after a bridge mint would leave TRI
    // minted against a lock that no longer exists. Blocks past the event, at least:
    // TON a masterchain block; TRON 19 (solidified); Solana 32 (finalized); EVM the chain's
    // `finalized` tag -- 64 is Ethereum's two epochs, a floor for chains without that tag.
    fn final_blocks(chain: u8) -> u32 {
        if chain == CHAIN_TON { return 1; }
        if chain == CHAIN_TRON { return 19; }
        if chain == CHAIN_SOLANA { return 32; }
        if chain == CHAIN_EVM { return 64; }
        return 0;
    }

    fn may_attest(chain: u8, confirmations: u32) -> bool {
        return chain_known(chain) && confirmations >= final_blocks(chain);
    }

    // ---- one spend per lock and per burn ----

    // A bridge mint names the TON lock it answers; the destination contract records it and
    // refuses it a second time. A release names the burn; the vault does the same.
    fn may_bridge_mint(op: u32, chain: u8, quorum: bool, lock_spent: bool, paused: bool) -> bool {
        return op_usable(op, OP_BRIDGE_MINT) && op_lands_on(op, chain) && quorum
            && !lock_spent && !paused;
    }

    fn may_release(op: u32, quorum: bool, burn_spent: bool, burn_final: bool, paused: bool) -> bool {
        return op_usable(op, OP_BRIDGE_RELEASE) && quorum && !burn_spent && burn_final && !paused;
    }

    // A bridge mint never exceeds the lock it answers.
    fn bridge_amount_ok(amount: u64, locked_by_this_lock: u64) -> bool {
        return amount > 0 && amount <= locked_by_this_lock;
    }

    // ---- the pause ----

    // The quorum can pause minting and releasing on every chain at once; a pause never blocks
    // a holder from burning (their TRI then waits, counted, for the release).
    pub const PAUSE_BLOCKS_BURN : bool = false;

    fn may_burn(paused: bool, amount: u64) -> bool {
        return amount > 0 && (!paused || !PAUSE_BLOCKS_BURN);
    }

    // ---- the payout route ----

    // TRI earned for accepted work is paid where the person bound a wallet. On TON the minter
    // mints to them. On any other chain the minter mints into the vault and the bridge mints
    // the same amount to their bound address: still one minter, still one supply.
    pub const ROUTE_DIRECT : u8 = 1;
    pub const ROUTE_VAULT_THEN_BRIDGE : u8 = 2;

    fn payout_route(chain: u8) -> u8 {
        if chain == CHAIN_OF_RECORD { return ROUTE_DIRECT; }
        if chain_known(chain) { return ROUTE_VAULT_THEN_BRIDGE; }
        return 0;
    }

    // ---- live ----

    // The bridge goes live, and tri-wallet-chains' BRIDGE_LIVE turns true, only when all of
    // these hold: the contracts are audited, deployed and their addresses recorded, and the
    // attestor keys have named holders with M and N set (KEY_CUSTODY_AND_ATTESTOR_SET).
    pub const BRIDGE_LIVE : bool = false;

    fn may_go_live(audited: bool, deployed: bool, keys_held: bool, m: u32, n: u32) -> bool {
        return audited && deployed && keys_held && quorum_valid(m, n);
    }

    // ---- tests ----

    test "TON is the chain of record and the only place new TRI is minted" {
        assert(CHAIN_OF_RECORD == CHAIN_TON);
        assert(mints_new_supply(CHAIN_TON));
        assert(!mints_new_supply(CHAIN_EVM));
        assert(!mints_new_supply(CHAIN_SOLANA));
        assert(!mints_new_supply(CHAIN_TRON));
        assert(chain_known(4));
        assert(!chain_known(0));
        assert(!chain_known(5));
    }

    test "one base unit on every chain, so an amount crosses unchanged" {
        assert(MTRI_PER_TRI == 1000);
        assert(decimals_of(CHAIN_TON) == 3);
        assert(decimals_of(CHAIN_EVM) == 3);
        assert(decimals_of(CHAIN_SOLANA) == 3);
        assert(decimals_of(CHAIN_TRON) == 3);
        assert(decimals_of(9) == 0);
    }

    test "the bridged sum equals the vault and the cap is counted once" {
        assert(CAP_MTRI == 10460353203000);
        assert(supply_sound(1000, 400, 400));
        assert(supply_sound(0, 0, 0));
        assert(supply_sound(CAP_MTRI, CAP_MTRI, CAP_MTRI));
        assert(!supply_sound(1000, 400, 401));
        assert(!supply_sound(1000, 400, 399));
        assert(!supply_sound(1000, 1001, 1001));
        assert(!supply_sound(CAP_MTRI + 1, 0, 0));
        assert(circulating(1000, 400, 400) == 1000);
        assert(circulating(1000, 0, 0) == 1000);
    }

    test "a mint, a bridge mint and a release are three operations no attestation crosses" {
        assert(OP_MINT_ON_ATT == 1414678833);
        assert(OP_BRIDGE_MINT == OP_MINT_ON_ATT + 1);
        assert(OP_BRIDGE_RELEASE == OP_MINT_ON_ATT + 2);
        assert(op_usable(OP_BRIDGE_MINT, OP_BRIDGE_MINT));
        assert(!op_usable(OP_MINT_ON_ATT, OP_BRIDGE_MINT));
        assert(!op_usable(OP_BRIDGE_MINT, OP_BRIDGE_RELEASE));
        assert(op_lands_on(OP_MINT_ON_ATT, CHAIN_TON));
        assert(!op_lands_on(OP_MINT_ON_ATT, CHAIN_EVM));
        assert(op_lands_on(OP_BRIDGE_MINT, CHAIN_EVM));
        assert(op_lands_on(OP_BRIDGE_MINT, CHAIN_SOLANA));
        assert(op_lands_on(OP_BRIDGE_MINT, CHAIN_TRON));
        assert(!op_lands_on(OP_BRIDGE_MINT, CHAIN_TON));
        assert(!op_lands_on(OP_BRIDGE_MINT, 7));
        assert(op_lands_on(OP_BRIDGE_RELEASE, CHAIN_TON));
        assert(!op_lands_on(OP_BRIDGE_RELEASE, CHAIN_TRON));
        assert(!op_lands_on(0, CHAIN_TON));
    }

    test "the quorum is an honest majority, so two quorums always share a signer" {
        assert(quorum_valid(TESTNET_M, TESTNET_N));
        assert(quorum_valid(3, 5));
        assert(quorum_valid(1, 1));
        assert(!quorum_valid(1, 2));
        assert(!quorum_valid(2, 4));
        assert(!quorum_valid(4, 3));
        assert(!quorum_valid(0, 0));
        assert(quorum_met(2, 2, 3));
        assert(quorum_met(3, 2, 3));
        assert(!quorum_met(1, 2, 3));
        assert(!quorum_met(4, 2, 3));
        assert(!quorum_met(2, 1, 2));
    }

    test "an attestor signs only from the source chain's finalized view" {
        assert(final_blocks(CHAIN_TON) == 1);
        assert(final_blocks(CHAIN_TRON) == 19);
        assert(final_blocks(CHAIN_SOLANA) == 32);
        assert(final_blocks(CHAIN_EVM) == 64);
        assert(final_blocks(0) == 0);
        assert(may_attest(CHAIN_TRON, 19));
        assert(!may_attest(CHAIN_TRON, 18));
        assert(may_attest(CHAIN_EVM, 64));
        assert(!may_attest(CHAIN_EVM, 63));
        assert(!may_attest(CHAIN_TON, 0));
        assert(!may_attest(0, 1000));
    }

    test "a lock mints once on one chain, a burn releases once" {
        assert(may_bridge_mint(OP_BRIDGE_MINT, CHAIN_EVM, true, false, false));
        assert(!may_bridge_mint(OP_BRIDGE_MINT, CHAIN_EVM, true, true, false));
        assert(!may_bridge_mint(OP_BRIDGE_MINT, CHAIN_EVM, false, false, false));
        assert(!may_bridge_mint(OP_BRIDGE_MINT, CHAIN_TON, true, false, false));
        assert(!may_bridge_mint(OP_MINT_ON_ATT, CHAIN_EVM, true, false, false));
        assert(!may_bridge_mint(OP_BRIDGE_MINT, CHAIN_EVM, true, false, true));
        assert(may_release(OP_BRIDGE_RELEASE, true, false, true, false));
        assert(!may_release(OP_BRIDGE_RELEASE, true, true, true, false));
        assert(!may_release(OP_BRIDGE_RELEASE, true, false, false, false));
        assert(!may_release(OP_BRIDGE_RELEASE, false, false, true, false));
        assert(!may_release(OP_BRIDGE_MINT, true, false, true, false));
        assert(!may_release(OP_BRIDGE_RELEASE, true, false, true, true));
        assert(bridge_amount_ok(400, 400));
        assert(bridge_amount_ok(1, 400));
        assert(!bridge_amount_ok(401, 400));
        assert(!bridge_amount_ok(0, 400));
    }

    test "a pause stops minting and releasing, never a holder's burn" {
        assert(!PAUSE_BLOCKS_BURN);
        assert(!may_bridge_mint(OP_BRIDGE_MINT, CHAIN_TRON, true, false, true));
        assert(!may_release(OP_BRIDGE_RELEASE, true, false, true, true));
        assert(may_burn(false, 5));
        assert(may_burn(true, 5));
        assert(!may_burn(true, 0));
        assert(!may_burn(false, 0));
    }

    test "a payout on another chain is a vault mint and a bridge mint, never a second minter" {
        assert(payout_route(CHAIN_TON) == ROUTE_DIRECT);
        assert(payout_route(CHAIN_EVM) == ROUTE_VAULT_THEN_BRIDGE);
        assert(payout_route(CHAIN_SOLANA) == ROUTE_VAULT_THEN_BRIDGE);
        assert(payout_route(CHAIN_TRON) == ROUTE_VAULT_THEN_BRIDGE);
        assert(payout_route(0) == 0);
    }

    test "the bridge is not live until audited, deployed and its keys have holders" {
        assert(!BRIDGE_LIVE);
        assert(may_go_live(true, true, true, 2, 3));
        assert(!may_go_live(false, true, true, 2, 3));
        assert(!may_go_live(true, false, true, 2, 3));
        assert(!may_go_live(true, true, false, 2, 3));
        assert(!may_go_live(true, true, true, 1, 2));
    }

    test "VERSION says what the header's last note says" {
        assert(VERSION == 1);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
