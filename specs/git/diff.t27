    // ════════════════════════════════════════════════════════════════════
    // Diff Statistics
    // ════════════════════════════════════════════════════════════════════

    // stats returns line change statistics
    fn stats(cwd: str, ref: str) -> Result<[Stat], GitError> {
        // Implementation: Run git diff --numstat ref
    }

    // stats_cached returns staged change statistics
    fn stats_cached(cwd: str, ref: str?) -> Result<[Stat], GitError> {
        // Implementation: Run git diff --cached --numstat [ref]
    }

    // stats_summary returns summary statistics
    struct StatsSummary {
        files_changed: u32,
        additions: u32,
        deletions: u32,
    }

    fn stats_summary(cwd: str, ref: str) -> Result<StatsSummary, GitError> {
        // Implementation: Calculate totals from stats output
    }

    // ════════════════════════════════════════════════════════════════════
    // Diff Analysis
    // ════════════════════════════════════════════════════════════════════

    // get_files_changed returns list of changed files
    fn get_files_changed(items: [Item]) -> [str] {
        var result = [];
        for (item in items) {
            result.push(item.file);
        }
        return result;
    }

    // count_files_by_status counts files by status
    fn count_files_by_status(items: [Item]) -> (added: u32, deleted: u32, modified: u32) {
        var added = 0u32;
        var deleted = 0u32;
        var modified = 0u32;
        
        for (item in items) {
            if (item.status == Kind::Added) {
                added += 1;
            } else if (item.status == Kind::Deleted) {
                deleted += 1;
            } else if (item.status == Kind::Modified) {
                modified += 1;
            }
        }
        
        return (added, deleted, modified);
    }

    // find_changes_in_path filters changes by path prefix
    fn find_changes_in_path(items: [Item], path: str) -> [Item] {
        var result = [];
        for (item in items) {
            if (item.file.starts_with(path)) {
                result.push(item);
            }
        }
        return result;
    }

    // find_changes_in_patterns filters changes by multiple patterns
    fn find_changes_in_patterns(items: [Item], patterns: [str]) -> [Item] {
        var result = [];
        
        for (item in items) {
            for (pattern in patterns) {
                if (item.file.contains(pattern)) {
                    result.push(item);
                    break; // Add item once if it matches any pattern
                }
            }
        }
        
        return result;
    }

    // has_changes_in_path checks if there are changes in a path
    fn has_changes_in_path(items: [Item], path: str) -> bool {
        for (item in items) {
            if (item.file.starts_with(path)) {
                return true;
            }
        }
        return false;
    }

    // ════════════════════════════════════════════════════════════════════
    // Hunk Operations
    // ════════════════════════════════════════════════════════════════════

    // Hunk represents a single diff hunk
    struct Hunk {
        file: str,
        old_start: u32,
        old_count: u32,
        new_start: u32,
        new_count: u32,
        header: str,
    }

    // parse_hunks parses hunks from diff text
    fn parse_hunks(diff_text: str) -> Result<[Hunk], GitError> {
        var lines = diff_text.split('\n');
        var hunks = [];
        var current_file = "";
        
        for (line in lines) {
            if (line.starts_with('diff --git ')) {
                // Extract filename from diff --git a/file b/file
                var parts = line.split(' ');
                if (parts.len >= 4) {
                    current_file = parts[2].substring(2); // Remove 'a/' prefix
                }
            } else if (line.starts_with('@@')) {
                // Parse hunk header: @@ -old_start,old_count +new_start,new_count @@
                var hunk_header = line;
                var hunk = Hunk {
                    file = current_file,
                    old_start = 0u32,
                    old_count = 0u32,
                    new_start = 0u32,
                    new_count = 0u32,
                    header = hunk_header,
                };
                
                // Extract line numbers using regex-like parsing
                var old_part = "";
                var new_part = "";
                var in_old = false;
                var in_new = false;
                var i = 3; // Skip '@@ '
                
                while (i < hunk_header.len && hunk_header[i] != ' ') {
                    if (hunk_header[i] == '-') {
                        in_old = true;
                        in_new = false;
                    } else if (hunk_header[i] == '+') {
                        in_old = false;
                        in_new = true;
                    } else if (hunk_header[i] >= '0' && hunk_header[i] <= '9') {
                        if (in_old) {
                            old_part += hunk_header[i];
                        } else if (in_new) {
                            new_part += hunk_header[i];
                        }
                    }
                    i += 1;
                }
                
                if (old_part != "") {
                    hunk.old_start = old_part.parse(u32).unwrap_or(0u32);
                    // Look for comma to get count
                    var comma_pos = old_part.find(',');
                    if (comma_pos != -1) {
                        hunk.old_count = old_part.substring(comma_pos + 1).parse(u32).unwrap_or(0u32);
                    }
                }
                
                if (new_part != "") {
                    hunk.new_start = new_part.parse(u32).unwrap_or(0u32);
                    // Look for comma to get count  
                    var comma_pos = new_part.find(',');
                    if (comma_pos != -1) {
                        hunk.new_count = new_part.substring(comma_pos + 1).parse(u32).unwrap_or(0u32);
                    }
                }
                
                hunks.push(hunk);
            }
        }
        
        return Ok(hunks);
    }

    // count_hunks counts the number of hunks in a diff
    fn count_hunks(diff_text: str) -> u32 {
        var count = 0u32;
        var lines = diff_text.split('\n');
        
        for (line in lines) {
            if (line.starts_with('@@')) {
                count += 1;
            }
        }
        
        return count;
    }

    // ════════════════════════════════════════════════════════════════════
    // Tests
    // ════════════════════════════════════════════════════════════════════

    test "stat_creation" {
        var stat = Stat {
            file = "src/main.t27",
            additions = 10,
            deletions = 5,
        };
        assert(stat.file == "src/main.t27");
        assert(stat.additions == 10);
        assert(stat.deletions == 5);
    }

    test "stats_summary_creation" {
        var summary = StatsSummary {
            files_changed = 3,
            additions = 42,
            deletions = 17,
        };
        assert(summary.files_changed == 3);
        assert(summary.additions == 42);
        assert(summary.deletions == 17);
    }

    test "get_files_changed_extracts_paths" {
        var items = [
            Item { file = "src/a.t27", code = "M", status = Kind::Modified },
            Item { file = "src/b.t27", code = "A", status = Kind::Added },
        ];
        var files = get_files_changed(items);
        assert(files.len == 2);
        assert(files.contains("src/a.t27"));
        assert(files.contains("src/b.t27"));
    }

    test "count_files_by_status" {
        var items = [
            Item { file = "a.t27", code = "A", status = Kind::Added },
            Item { file = "b.t27", code = "M", status = Kind::Modified },
            Item { file = "c.t27", code = "D", status = Kind::Deleted },
            Item { file = "d.t27", code = "??", status = Kind::Added },
        ];
        var counts = count_files_by_status(items);
        assert(counts.added == 2);
        assert(counts.deleted == 1);
        assert(counts.modified == 1);
    }

    test "find_changes_in_path_filters_correctly" {
        var items = [
            Item { file = "src/a.t27", code = "M", status = Kind::Modified },
            Item { file = "test/b.t27", code = "A", status = Kind::Added },
            Item { file = "src/c.t27", code = "D", status = Kind::Deleted },
        ];
        var src_changes = find_changes_in_path(items, "src/");
        assert(src_changes.len == 2);
        assert(src_changes[0].file == "src/a.t27");
        assert(src_changes[1].file == "src/c.t27");
    }

    test "find_changes_in_path_no_match" {
        var items = [
            Item { file = "src/a.t27", code = "M", status = Kind::Modified },
        ];
        var test_changes = find_changes_in_path(items, "test/");
        assert(test_changes.len == 0);
    }

    test "has_changes_in_path_true" {
        var items = [
            Item { file = "src/a.t27", code = "M", status = Kind::Modified },
        ];
        assert(has_changes_in_path(items, "src/"));
    }

    test "has_changes_in_path_false" {
        var items = [
            Item { file = "src/a.t27", code = "M", status = Kind::Modified },
        ];
        assert(!has_changes_in_path(items, "test/"));
    }

    test "find_changes_in_patterns_matches_multiple" {
        var items = [
            Item { file = "src/main.t27", code = "M", status = Kind::Modified },
            Item { file = "test/helper.t27", code = "A", status = Kind::Added },
            Item { file = "docs/readme.md", code = "M", status = Kind::Modified },
        ];
        var patterns = ["src", "docs"];
        var changes = find_changes_in_patterns(items, patterns);
        assert(changes.len == 2);
        assert(changes[0].file == "src/main.t27");
        assert(changes[1].file == "docs/readme.md");
    }

    test "find_changes_in_patterns_single_pattern" {
        var items = [
            Item { file = "src/main.t27", code = "M", status = Kind::Modified },
            Item { file = "src/utils.t27", code = "A", status = Kind::Added },
            Item { file = "test/main.t27", code = "M", status = Kind::Modified },
        ];
        var changes = find_changes_in_patterns(items, ["main"]);
        assert(changes.len == 2);
        assert(changes[0].file == "src/main.t27");
        assert(changes[1].file == "test/main.t27");
    }

    test "parse_hunks_basic" {
        var diff_text = 
            "diff --git a/src/test.t27 b/src/test.t27\n" ++
            "index abc123..def456 100644\n" ++
            "--- a/src/test.t27\n" ++
            "+++ b/src/test.t27\n" ++
            "@@ -10,5 +10,7 @@ function test\n" ++
            "    old code\n" ++
            "+    new code\n" ++
            "+    more new code\n" ++
            "@@ -20,3 +22,4 @@ another function\n" ++
            "    old line\n" ++
            "+    added line\n" ++
            "\n";
        var result = parse_hunks(diff_text);
        assert(result.is_ok());
        var hunks = result.unwrap();
        assert(hunks.len == 2);
        assert(hunks[0].file == "src/test.t27");
        assert(hunks[0].old_start == 10);
        assert(hunks[0].old_count == 5);
        assert(hunks[0].new_start == 10);
        assert(hunks[0].new_count == 7);
        assert(hunks[1].file == "src/test.t27");
        assert(hunks[1].old_start == 20);
        assert(hunks[1].old_count == 3);
        assert(hunks[1].new_start == 22);
        assert(hunks[1].new_count == 4);
    }

    test "count_hunks_basic" {
        var diff_text = 
            "diff --git a/file1.t27 b/file1.t27\n" ++
            "@@ -1,3 +1,3 @@\n" ++
            "line1\n" ++
            "line2\n" ++
            "line3\n" ++
            "diff --git a/file2.t27 b/file2.t27\n" ++
            "@@ -1,1 +1,1 @@\n" ++
            "single line\n" ++
            "diff --git a/file3.t27 b/file3.t27\n" ++
            "@@ -5,10 +5,15 @@\n" ++
            "many lines\n" ++
            "changed\n";
        var count = count_hunks(diff_text);
        assert(count == 3);
    }

    test "count_hunks_no_hunks" {
        var diff_text = 
            "diff --git a/file1.t27 b/file1.t27\n" ++
            "index 123..456\n" ++
            "--- a/file1.t27\n" ++
            "+++ b/file1.t27\n" ++
            "no hunks here\n";
        var count = count_hunks(diff_text);
        assert(count == 0);
    }

    test "hunk_creation" {
        var hunk = Hunk {
            file = "src/test.t27",
            old_start = 10,
            old_count = 5,
            new_start = 10,
            new_count = 7,
            header = "@@ -10,5 +10,7 @@ function test",
        };
        assert(hunk.file == "src/test.t27");
        assert(hunk.old_start == 10);
        assert(hunk.new_count == 7);
    }

    test "stats_summary_calculates_totals" {
        var stats = [
            Stat { file = "a.t27", additions = 10, deletions = 5 },
            Stat { file = "b.t27", additions = 20, deletions = 15 },
            Stat { file = "c.t27", additions = 5, deletions = 0 },
        ];
        var summary = StatsSummary {
            files_changed = 3,
            additions = 35,
            deletions = 20,
        };
        assert(summary.files_changed == 3);
        assert(summary.additions == 35);
        assert(summary.deletions == 20);
    }
}
