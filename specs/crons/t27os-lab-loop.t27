// specs/crons/t27os-lab-loop.t27 -- the T27 OS lab loop: every 15 minutes the executor
// in Trinity-S-AI-DNA/t27os (.github/workflows/lab.yml) checks out t27 master, builds t27c,
// runs the core spec set's test-reports, renders the 900-frame export schedule through
// frame_render + ffmpeg, and publishes a challenge-bound receipt plus queen-live.mp4 into
// t27os runs/. The contract is t27os specs/os/lab.t27 (surface) and t27 specs/t27os/labs.t27
// (the lab actor law); the migration from Railway is t27#11781; the settle bridge that turns
// verified receipts into mTRI is t27#11789.
// Self-critical state, 2026-10-23: five challenge-verified receipts; the first receipt
// reproduced by the requester (the two-verification bar of a useful run); ffmpeg 6.1.1 on the
// runner; the mp4 proof in run 39970371982's log (sha256 2a00668d..., 328428 bytes).

module cron_t27os_lab_loop;

use t27os::keysync::contains;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/t27os/lab";
pub const NAME : str = "T27 OS lab loop";
pub const HOST : str = "github-actions";
pub const REPO : str = "t27os";
pub const SERVICE : str = ".github/workflows/lab.yml";
pub const SUMMARY_EN : str = "Every 15 minutes: build t27c from master, test-report the core spec set, render the 900-frame export schedule, encode queen-live.mp4, publish the challenge-bound receipt into t27os runs/.";
pub const SCHEDULE : str = "*/15 * * * *";
pub const TZ : str = "UTC";
pub const RUNS : [1]str = ["t27os-lab-loop"];
pub const RUNS_NOTE : str = "the loop is its own skill: the lab contract is t27os specs/os/lab.t27, the actor law is t27 specs/t27os/labs.t27";
pub const ENABLED : bool = true;
pub const NOTE : str = "replaced the Railway lab drive-in (t27#11781); receipts are challenge-bound; the settle bridge to mTRI is t27#11789";
pub const ON_FAILURE : str = "issue";
pub const CONTROL : str = "github-actions-dispatch";

// the cadence the owner set: a full pass every quarter hour, day and night
pub const SCHEDULE_MINUTES : u32 = 15;

test the_loop_runs_every_quarter_hour_and_is_enabled {
    assert SCHEDULE_MINUTES == 15;
    assert ENABLED;
    assert HOST == "github-actions";
}

// --- the encoder step lab.yml runs (t27os#10) ------------------------------------------------
// Hand-written workflow YAML is refused by the language rule, so the step's source lives here and
// TRI CLAW copies ENCODER_STEP_YAML verbatim over the "check the encoder plumbing" step of SERVICE
// (the pattern of specs/tools/t27o/install.t27 WORKFLOW_YAML). Evidence for the change: run
// 39980640303 died on `xz: (stdin): File format not recognized` -- the step piped the
// johnvansickle.com static download straight into tar on EVERY dispatch, m6 or not, and a CDN
// hiccup killed the run before the receipt (5 failures + 4 cancellations in 15:13-15:43Z on
// 2026-10-23). The distro ffmpeg (6.1.1) encoded the first receipt of the day.
// The law of the step, each part checked by encoder_step_ok:
//   1. M6 only: nothing is fetched unless the dispatch asked for the encode (m6 = "true");
//   2. distro first: the runner's ffmpeg, then apt, and only then the static build;
//   3. the static build is downloaded to a file with retries, never piped into tar, and a failed
//      fetch or unpack is reported in /tmp/ffmpeg.txt, never fatal -- the step cannot kill the run.

pub const ENCODER_STEP_YAML : str = "      - name: check the encoder plumbing (M6 only -- distro ffmpeg first, static build as fallback)\n        shell: bash\n        run: |\n          M6=\"${{ inputs.m6 }}\"\n          if ! command -v ffmpeg >/dev/null 2>&1 && [ \"$M6\" = \"true\" ]; then\n            sudo apt-get install -y -qq ffmpeg || echo \"apt ffmpeg failed\"\n          fi\n          if ! command -v ffmpeg >/dev/null 2>&1 && [ \"$M6\" = \"true\" ]; then\n            if curl -fsSL --retry 3 -o /tmp/ffmpeg.tar.xz https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp; then\n              FFMPEG_DIR=$(ls -d /tmp/ffmpeg-*static | head -1)\n              export PATH=\"$FFMPEG_DIR:$PATH\"\n              echo \"$FFMPEG_DIR\" >> \"$GITHUB_PATH\"\n            else\n              echo \"static ffmpeg fetch failed\"\n            fi\n          fi\n          if command -v ffmpeg >/dev/null 2>&1; then\n            ffmpeg -version | head -1 | tee /tmp/ffmpeg.txt\n          else\n            echo \"ffmpeg absent (m6=$M6)\" | tee /tmp/ffmpeg.txt\n          fi\n";

// The step as lab.yml ran it on 2026-10-23 (t27os master 234d76e, lines 99-111): the negative control.
pub const ENCODER_STEP_YAML_OLD : str = "      - name: check the encoder plumbing (M6 -- export_video encodes on the lab)\n        shell: bash\n        run: |\n          curl -fsSL https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz | tar -xJ -C /tmp\n          echo \"/tmp/ffmpeg-\"*\"-static\" | xargs -I{} sh -c 'echo \"{}\"' > /dev/null\n          FFMPEG_DIR=$(ls -d /tmp/ffmpeg-*static | head -1)\n          export PATH=\"$FFMPEG_DIR:$PATH\"\n          echo \"$FFMPEG_DIR\" >> \"$GITHUB_PATH\"\n          if command -v ffmpeg >/dev/null 2>&1; then\n            ffmpeg -version | head -1 | tee /tmp/ffmpeg.txt\n          else\n            echo \"ffmpeg absent\" | tee /tmp/ffmpeg.txt\n          fi\n";

// The markers encoder_step_ok looks for. DISTRO_THEN_STATIC pins the order by adjacency: the apt
// fallback closes and the static branch opens right after it.
pub const ENC_M6_ONLY : str = "&& [ \"$M6\" = \"true\" ]; then";
pub const ENC_DISTRO_THEN_STATIC : str = "sudo apt-get install -y -qq ffmpeg || echo \"apt ffmpeg failed\"\n          fi\n          if ! command -v ffmpeg";
pub const ENC_FETCH_TO_FILE : str = "curl -fsSL --retry 3 -o /tmp/ffmpeg.tar.xz ";
pub const ENC_PIPE_INTO_TAR : str = "| tar";
pub const ENC_NONFATAL : str = "else\n              echo \"static ffmpeg fetch failed\"";

// encoder_step_ok(y): does the step y keep the three rules above.
pub fn encoder_step_ok(y: []const u8) -> bool {
    return contains(y, ENC_M6_ONLY) and contains(y, ENC_DISTRO_THEN_STATIC)
        and contains(y, ENC_FETCH_TO_FILE) and !contains(y, ENC_PIPE_INTO_TAR)
        and contains(y, ENC_NONFATAL);
}

test the_encoder_step_keeps_the_three_rules {
    assert encoder_step_ok(ENCODER_STEP_YAML);
}

// negative control: the step that lost the receipts on 2026-10-23 is refused
test the_step_that_lost_the_receipts_is_refused {
    assert !encoder_step_ok(ENCODER_STEP_YAML_OLD);
    assert contains(ENCODER_STEP_YAML_OLD, ENC_PIPE_INTO_TAR);
    assert !contains(ENCODER_STEP_YAML_OLD, ENC_M6_ONLY);
}

// negative control: each rule alone is load-bearing -- the step with its M6 guard, its distro
// branch or its fetch-to-file swapped for the old shape is refused
test each_rule_is_load_bearing {
    assert !encoder_step_ok(ENC_DISTRO_THEN_STATIC);
    assert !encoder_step_ok(ENC_M6_ONLY);
    assert !encoder_step_ok("");
    assert contains(ENCODER_STEP_YAML, "if: ") == false;
    assert contains(ENCODER_STEP_YAML, "johnvansickle.com");
}

// --- the verdict step lab.yml runs (t27os#9) ------------------------------------------------
// The "test-report every named spec" step ends each report with `then :; fi`, so a FAIL, a
// BLOCKED spec, a vacuous test or a dropped spec still leaves the run green: the 15:34Z
// receipt of 2026-10-23 carried identity.t27 blocked=1 and the 15:53Z one silently omitted
// identity.t27 (4 asked, 3 reported), both on green runs. The law of a receipt is
// receipt_verdict in specs/t27os/labs.t27 (t27#11875); this is the step that enforces it.
// TRI CLAW inserts VERDICT_STEP_YAML verbatim AFTER the "publish the receipt" step of SERVICE,
// so the red receipt is still published (the evidence survives) and the run then goes red.
// The law of the step, each part checked by verdict_step_ok:
//   1. it counts the specs it was asked for and refuses an empty ask (a schedule run with an
//      empty inputs.specs verified nothing, t27os#11);
//   2. it refuses a receipt that reports fewer or more specs than were asked;
//   3. it refuses any line with FAIL, vacuous or blocked above zero, NA counts, or zero tests.

pub const VERDICT_STEP_YAML : str = "      - name: verdict -- the run fails when the receipt drops, blocks, fails or vacates a spec (t27os#9)\n        shell: bash\n        run: |\n          asked=$(echo ${{ inputs.specs }} | wc -w)\n          got=$(wc -l < /tmp/out/summary.txt)\n          bad=$(grep -cE 'FAIL=[1-9]|vacuous=[1-9]|blocked=[1-9]|=NA|tests=0[|]' /tmp/out/summary.txt || true)\n          echo \"asked=$asked reported=$got bad=$bad\"\n          if [ \"$asked\" -eq 0 ] || [ \"$got\" -ne \"$asked\" ] || [ \"$bad\" -ne 0 ]; then\n            exit 1\n          fi\n";

// the report line of the step that is on lab.yml today: every exit code is swallowed
pub const TEST_REPORT_LINE_OLD : str = "            if ./target/release/t27c test-report \"$spec\" > /tmp/out/report_$i.txt 2>&1; then :; fi\n";

pub const VER_COUNTS_ASK : str = "asked=$(echo ${{ inputs.specs }} | wc -w)";
pub const VER_EMPTY_ASK : str = "[ \"$asked\" -eq 0 ]";
pub const VER_DROPPED : str = "[ \"$got\" -ne \"$asked\" ]";
pub const VER_RED_MARKS : str = "'FAIL=[1-9]|vacuous=[1-9]|blocked=[1-9]|=NA|tests=0[|]'";
pub const VER_EXIT : str = "exit 1";

// verdict_step_ok(y): does the step y keep the three rules above.
pub fn verdict_step_ok(y: []const u8) -> bool {
    return contains(y, VER_COUNTS_ASK) and contains(y, VER_EMPTY_ASK)
        and contains(y, VER_DROPPED) and contains(y, VER_RED_MARKS)
        and contains(y, VER_EXIT);
}

test the_verdict_step_keeps_the_three_rules {
    assert verdict_step_ok(VERDICT_STEP_YAML);
    assert contains(VERDICT_STEP_YAML, "/tmp/out/summary.txt");
}

// negative control: the lab.yml of today has no verdict -- its report line exits nowhere
test the_step_that_swallowed_the_reds_is_refused {
    assert !verdict_step_ok(TEST_REPORT_LINE_OLD);
    assert contains(TEST_REPORT_LINE_OLD, "then :; fi");
    assert !contains(TEST_REPORT_LINE_OLD, VER_EXIT);
}

// negative control: each rule alone is load-bearing
test each_verdict_rule_is_load_bearing {
    assert !verdict_step_ok(VER_COUNTS_ASK);
    assert !verdict_step_ok(VER_RED_MARKS);
    assert !verdict_step_ok(VER_DROPPED);
    assert !verdict_step_ok("");
    assert contains(VERDICT_STEP_YAML, "if: ") == false;
}
