// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-trios-cycle.t27 -- cron launchd/trios/trios-cycle
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/trios/trios-cycle).
; The schedule was read from ~/Library/LaunchAgents/ai.t27.trios-cycle.plist on 2026-10-04.
; A launchd job runs on the owner's Mac: the Queen serves this card tick-only and never dispatches it.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_trios_cycle;

pub const KIND : str = "cron";
pub const ID : str = "launchd/trios/trios-cycle";
pub const NAME : str = "trios cycle";
pub const HOST : str = "launchd";
pub const REPO : str = "trios";
pub const SERVICE : str = "ai.t27.trios-cycle";
pub const SUMMARY_EN : str = "Runs `tri cycle` in BrowserOS/trios every 15 minutes.";
pub const INTERVAL_MS : u32 = 900000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";

; The card held to the schema of specs/crons/README.md: ID is <host>/<repo>/<slug>; HOST,
; ON_FAILURE and CONTROL come from fixed vocabularies; RUNS, the control link, is empty unless
; the source evidently invokes a skill, and RUNS_NOTE then says why.
test id_is_host_repo_and_slug {
    // HOST is one of the five hosts the README names.
    assert HOST == "github-actions" or HOST == "inngest" or HOST == "railway-cron" or HOST == "timer" or HOST == "launchd";
    // ID opens with HOST, a `/`, REPO and a `/`.
    var i : usize = 0;
    while (i < HOST.len) {
        assert ID[i] == HOST[i];
        i = i + 1;
    }
    assert ID[HOST.len] == '/';
    var r : usize = 0;
    while (r < REPO.len) {
        assert ID[HOST.len + 1 + r] == REPO[r];
        r = r + 1;
    }
    assert ID[HOST.len + 1 + REPO.len] == '/';
    // The slug after it is one path segment, not empty.
    assert ID.len > HOST.len + REPO.len + 2;
    var s : usize = HOST.len + REPO.len + 2;
    while (s < ID.len) {
        assert ID[s] != '/' and ID[s] != ' ';
        s = s + 1;
    }
}
test vocabularies_and_the_control_link {
    assert KIND == "cron";
    assert ON_FAILURE == "issue" or ON_FAILURE == "log" or ON_FAILURE == "unknown";
    assert CONTROL == "github-actions-dispatch" or CONTROL == "railway-dashboard" or CONTROL == "inngest-dashboard" or CONTROL == "code-only";
    // An empty RUNS carries its reason in RUNS_NOTE.
    assert RUNS.len > 0 or RUNS_NOTE.len > 0;
}
test a_launchd_card_is_tick_only {
    // Nothing outside the Mac can start it, so CONTROL is code-only (README, HOST launchd).
    assert CONTROL == "code-only";
    // SERVICE is the launchd Label `ai.t27.<x>`, and ID is `launchd/<repo>/<x>`.
    const LABEL : str = "ai.t27.";
    var p : usize = 0;
    while (p < LABEL.len) {
        assert SERVICE[p] == LABEL[p];
        p = p + 1;
    }
    const at : usize = HOST.len + REPO.len + 2;
    assert ID.len - at == SERVICE.len - LABEL.len;
    var k : usize = 0;
    while (k < ID.len - at) {
        assert ID[at + k] == SERVICE[LABEL.len + k];
        k = k + 1;
    }
    // StartInterval N seconds is INTERVAL_MS = N*1000.
    assert INTERVAL_MS % 1000 == 0;
}
