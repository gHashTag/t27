// SPDX-License-Identifier: Apache-2.0
; specs/crons/railway-jobsearch-cron.t27 -- cron railway-cron/999/jobsearch-cron
; Source of truth for the job card on t27.ai (#/crons?cron=railway-cron/999/jobsearch-cron).
; The schedule lives in the Railway dashboard of project 999 and is not in any checkout.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_railway_jobsearch_cron;

pub const KIND : str = "cron";
pub const ID : str = "railway-cron/999/jobsearch-cron";
pub const NAME : str = "jobsearch-cron";
pub const HOST : str = "railway-cron";
pub const REPO : str = "railway";
pub const SERVICE : str = "jobsearch-cron";
pub const SUMMARY_EN : str = "The scheduled job-search service of the Railway project, reachable at cron.t27.ai.";
; No expression is readable from a checkout; the dashboard holds it.
pub const SCHEDULE : str = "";
pub const SCHEDULE_NOTE : str = "configured in the Railway dashboard (project 999); not readable from the checkout";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const NOTE : str = "The schedule is configured in the Railway dashboard for project 999 and is not readable from the checkout; the probe below is what this catalog can verify.";
pub const ON_FAILURE : str = "unknown";
pub const CONTROL : str = "railway-dashboard";

; The card held to the schema of specs/crons/README.md: ID is <host>/<repo>/<slug>; HOST,
; ON_FAILURE and CONTROL come from fixed vocabularies; RUNS, the control link, is empty unless
; the source evidently invokes a skill, and RUNS_NOTE then says why.
test id_is_host_repo_and_slug {
    // HOST is one of the five hosts the README names.
    assert HOST == "github-actions" or HOST == "inngest" or HOST == "railway-cron" or HOST == "timer" or HOST == "launchd";
    // ID opens with HOST and a `/`, then two path segments, neither empty. The middle one is
    // not REPO on this card (#7911): only the shape is checked here.
    var i : usize = 0;
    while (i < HOST.len) {
        assert ID[i] == HOST[i];
        i = i + 1;
    }
    assert ID[HOST.len] == '/';
    var slashes : u32 = 0;
    var s : usize = HOST.len + 1;
    while (s < ID.len) {
        if (ID[s] == '/') {
            slashes = slashes + 1;
            assert ID[s - 1] != '/';
        }
        assert ID[s] != ' ';
        s = s + 1;
    }
    assert slashes == 1;
    assert ID[ID.len - 1] != '/';
}
test vocabularies_and_the_control_link {
    assert KIND == "cron";
    assert ON_FAILURE == "issue" or ON_FAILURE == "log" or ON_FAILURE == "unknown";
    assert CONTROL == "github-actions-dispatch" or CONTROL == "railway-dashboard" or CONTROL == "inngest-dashboard" or CONTROL == "code-only";
    // An empty RUNS carries its reason in RUNS_NOTE.
    assert RUNS.len > 0 or RUNS_NOTE.len > 0;
}
test a_dashboard_schedule_says_where_it_is {
    // SCHEDULE is `""` when only a dashboard holds it, and SCHEDULE_NOTE then says so.
    assert SCHEDULE.len == 0;
    assert SCHEDULE_NOTE.len > 0;
    assert CONTROL == "railway-dashboard";
}
