// SPDX-License-Identifier: Apache-2.0
; specs/verified/seal_identity.t27 -- what a seal must record so reuse.t27 can answer REUSE, and when a
; silicon run stands as the verdict part. Epic gHashTag/t27#8095, step 1 (seal v2), issue #8096.
; --
; What already exists and is NOT restated here:
; - specs/verified/reuse.t27: the five parts (spec, closure, toolchain, config, verdict), PART_MISSING
;   fails closed, reuse_decision() and the hardware triad HW_UNPROVEN / HW_VERIFIED / HW_BLOCKED.
; - specs/verified/frontier.t27: the walk of reuse_decision() over the `use` graph.
; - specs/verified/run_record.t27 and independence.t27: whether a silicon run is complete and at which
;   independence a verdict record may cite it (indep_citable_at).
; --
; Why this file. A seal today (`t27c seal --save`) records spec_hash, gen_hash_{c,rust,verilog,zig},
; tests and built_by (t27c-bootstrap@<version>+<commit>): two of the five parts. With closure and config
; missing, reuse_decision() answers REBUILD_MISSING for every seal, so nothing can be reused. Seal v2
; records, beside today's fields:
;   closure    the spec_hash of every seal in the `use` closure, in a fixed order (hashed by the
;              existing sha256 tooling; this file compares, it hashes nothing);
;   toolchain  judged by OUTPUT, not by producer. Part one: the four generated outputs the current
;              t27c emits for the spec (gen_hash_zig/verilog/c/rust, typecheck refusal included) equal
;              the ones the seal recorded -- a test verdict is a fact about the generated code, so a
;              compiler change that leaves this spec's code byte-identical leaves its verdict standing.
;              Part two: the tools that turned that code into the verdict, recorded and equal: the test
;              runner (sha256 of bootstrap/src/test_report.rs) and zig; for a silicon verdict also
;              yosys, nextpnr-xilinx, the prjxray database and the chipdb. Measured 2026-10-09: 23 of
;              263 master commits in 48 h touched the t27c source, so keying on the compiler source (or
;              on built_by's commit, which every merge changes) would void every verdict every two hours;
;   config     SEAL_CONFIG for a software seal (the four gens and zig tests); for a silicon verdict
;              also the part, the pnr seed and the chipdb;
;   silicon    optional: a run reference (the run record a verdict may cite) and the independence it
;              reached.
; --
; The silicon rule. A hardware verdict stands as the verdict part only when every one of these holds:
; the seal names a run, the run is citable (run_record.t27), the run was made with this seal's own
; spec, toolchain and config (a run of another version proves nothing about this one), and the run
; reached at least SILICON_REQUIRED_LEVEL. Anything less leaves the hardware step UNPROVEN, and an
; UNPROVEN step never counts as PASS (reuse.t27, Hardware). R3-3 (#7669) is the first run that meets
; it: ternary_link on three distinct dies, INDEP_DIES.
; --
; The measure. reused_permille(reused, total) is the line CI prints, so a faster build is a number,
; not a claim.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedSealIdentity;

use verified::reuse;
use verified::independence;

/// The independence a silicon run must reach before its verdict is reused: three distinct dies. A
/// one-die PASS might be a lucky board or a bench quirk (die B found a per-die constant die A hid).
pub const SILICON_REQUIRED_LEVEL : u8 = 1;

/// The configuration a software seal is minted under: all four gens, tests run by zig.
pub const SEAL_CONFIG : str = "gen=c,rust,verilog,zig;tests=zig";

/// One recorded part against the current state. Not recorded is MISSING, never SAME.
pub fn recorded_part(recorded: bool, equal: bool) -> u8 {
    if (recorded == false) { return PART_MISSING; }
    if (equal) { return PART_SAME; }
    return PART_DIFF;
}

/// The toolchain part: the generated outputs, then the tools that turned them into the verdict. Any of
/// them unrecorded is MISSING; otherwise any of them changed is DIFF.
pub fn toolchain_part(output_recorded: bool, output_equal: bool, tools_recorded: bool, tools_equal: bool) -> u8 {
    if (output_recorded == false) { return PART_MISSING; }
    if (tools_recorded == false) { return PART_MISSING; }
    if (output_equal == false) { return PART_DIFF; }
    if (tools_equal == false) { return PART_DIFF; }
    return PART_SAME;
}

/// The hardware step of a sealed artifact, from its silicon run reference.
pub fn silicon_state(has_run: bool, run_citable: bool, same_spec: bool, same_toolchain: bool, same_config: bool, run_level: u8) -> u8 {
    if (has_run == false) { return HW_UNPROVEN; }
    if (run_citable == false) { return HW_UNPROVEN; }
    if (same_spec == false) { return HW_UNPROVEN; }
    if (same_toolchain == false) { return HW_UNPROVEN; }
    if (same_config == false) { return HW_UNPROVEN; }
    if (indep_citable_at(run_level, SILICON_REQUIRED_LEVEL) == false) { return HW_UNPROVEN; }
    return HW_VERIFIED;
}

/// The tests part of a verdict: the recorded tests passed, none was forced, and at least one check ran --
/// a test or an invariant. "0 failed" of nothing is not a pass: a spec with no test, no invariant and no
/// bench breaks L4, and frontier reused two such specs as verified (#8354).
pub fn checks_pass(failed_zero: bool, forced: bool, tests_total: u32, invariants: u32) -> bool {
    if (failed_zero == false) { return false; }
    if (forced) { return false; }
    return tests_total + invariants > 0;
}

/// The re-mint: `t27c frontier --reseal` seals again every spec remint_wants() names, and keeps the new
/// seal only when remint_keeps() allows it; otherwise the old seal is written back. A stale part (spec,
/// closure, toolchain, config, verdict) is cured by sealing again. MISSING is not: no seal, or an import
/// with none, needs the spec itself fixed -- on 2026-10-10, 391 of 524 unsealed specs did not compile.
pub fn remint_wants(decision: u8) -> bool {
    if (decision == REUSE) { return false; }
    return decision != REBUILD_MISSING;
}

/// A re-mint shares one zig cache and wipes it after every REMINT_CACHE_EVERY specs. A cold cache
/// rebuilds zig's std for each spec (about 20 s each, measured 2026-10-10); a cache never wiped filled
/// the disk during the second re-mint. 25 kept both in bounds over 1203 specs.
pub const REMINT_CACHE_EVERY : u32 = 25;

/// The seal schema that records closure, toolchain and config, so frontier can reuse it.
pub const SEAL_SCHEMA : u32 = 2;

/// Keep a new seal only when it is a v2 record whose checks ran and passed. A blocked spec records no
/// failed count, so failed_zero is false and it is never kept. The hand filter of the second re-mint
/// demanded tests > 0 and dropped 15 invariant-only specs (#8386); checks_pass counts invariants.
/// And only in a file that is the spec's own: two specs can derive one seal file name (parent dir and
/// module), and `seal --save` then overwrites the other spec's seal. The first full run hit 5 such files
/// on 2026-10-10; that file is written back, never kept and never deleted.
pub fn remint_keeps(schema: u32, failed_zero: bool, forced: bool, tests_total: u32, invariants: u32, file_is_its_own: bool) -> bool {
    if (file_is_its_own == false) { return false; }
    if (schema != SEAL_SCHEMA) { return false; }
    return checks_pass(failed_zero, forced, tests_total, invariants);
}

/// May `seal --save` record a spec as blocked over a seal that recorded it passing? Not without --force: the
/// spec compiled and passed before and does not compile now. That is a regression, and resealing it writes
/// the regression into the record as truth. `tri seals drift --fix` did exactly that to two specs on
/// 2026-10-10 (#8552), and only a person diffing every changed seal caught it.
pub fn blocked_reseal_allowed(old_passed: bool, force: bool) -> bool {
    if (force) { return true; }
    return old_passed == false;
}

/// The verdict part: the recorded tests passed, and, when the artifact needs silicon, its hardware
/// step is VERIFIED.
pub fn verdict_pass(tests_pass: bool, needs_silicon: bool, hw: u8) -> bool {
    if (tests_pass == false) { return false; }
    if (needs_silicon == false) { return true; }
    return hw == HW_VERIFIED;
}

/// The seal v2 decision: reuse.t27's rule with the verdict part above.
pub fn seal_decision(spec: u8, closure: u8, toolchain: u8, config: u8, tests_pass: bool, needs_silicon: bool, hw: u8) -> u8 {
    return reuse_decision(spec, closure, toolchain, config, verdict_pass(tests_pass, needs_silicon, hw));
}

/// One node of the frontier walk: the closure part comes from the imports' decisions (reuse.t27
/// closure_part), the rest as in seal_decision. frontier.t27 is the walk; until gen-rust lowers a
/// read-only slice (#8102), the caller walks the `use` graph and feeds each node here.
pub fn node_decision(spec: u8, any_import_rebuilt: bool, any_import_missing: bool, toolchain: u8, config: u8, tests_pass: bool, needs_silicon: bool, hw: u8) -> u8 {
    return seal_decision(spec, closure_part(any_import_rebuilt, any_import_missing), toolchain, config, tests_pass, needs_silicon, hw);
}

/// The share of artifacts reused, in permille, rounded half up. Nothing to judge is 0, not 1000.
pub fn reused_permille(reused: u32, total: u32) -> u32 {
    if (total == 0) { return 0; }
    if (reused >= total) { return 1000; }
    return (reused * 1000 + total / 2) / total;
}

test a_seal_from_today_is_rebuilt_once {
    // spec and toolchain recorded and unchanged, closure and config never recorded
    assert seal_decision(PART_SAME, PART_MISSING, PART_SAME, PART_MISSING, true, false, HW_UNPROVEN) == REBUILD_MISSING;
    assert recorded_part(false, true) == PART_MISSING;
}

test a_v2_software_seal_with_nothing_changed_is_reused {
    assert seal_decision(PART_SAME, PART_SAME, PART_SAME, PART_SAME, true, false, HW_UNPROVEN) == REUSE;
    // failing tests are never reused
    assert seal_decision(PART_SAME, PART_SAME, PART_SAME, PART_SAME, false, false, HW_UNPROVEN) == REBUILD_VERDICT;
}

test the_first_differing_part_is_the_reason {
    assert seal_decision(PART_DIFF, PART_MISSING, PART_DIFF, PART_SAME, true, false, HW_UNPROVEN) == REBUILD_SPEC;
    assert seal_decision(PART_SAME, PART_DIFF, PART_SAME, PART_SAME, true, false, HW_UNPROVEN) == REBUILD_CLOSURE;
    assert seal_decision(PART_SAME, PART_SAME, PART_DIFF, PART_SAME, true, false, HW_UNPROVEN) == REBUILD_TOOLCHAIN;
    assert seal_decision(PART_SAME, PART_SAME, PART_SAME, PART_DIFF, true, false, HW_UNPROVEN) == REBUILD_CONFIG;
}

test the_toolchain_part_covers_the_backend_tools {
    assert toolchain_part(true, true, true, true) == PART_SAME;
    // a compiler change that alters this spec's generated code, or a new test runner or zig
    assert toolchain_part(true, false, true, true) == PART_DIFF;
    assert toolchain_part(true, true, true, false) == PART_DIFF;
    // a seal that never recorded its tools, or its outputs, cannot be judged
    assert toolchain_part(true, true, false, true) == PART_MISSING;
    assert toolchain_part(false, true, true, true) == PART_MISSING;
}

test ternary_link_with_the_r33_run_is_reused {
    // R3-3: citable, three distinct dies, made with this seal's spec, t27c 0.5.1 and config
    var hw : u8 = silicon_state(true, true, true, true, true, INDEP_DIES);
    assert hw == HW_VERIFIED;
    assert seal_decision(PART_SAME, PART_SAME, PART_SAME, PART_SAME, true, true, hw) == REUSE;
    // a higher independence is enough too
    assert silicon_state(true, true, true, true, true, INDEP_OPERATORS) == HW_VERIFIED;
}

test a_run_that_does_not_prove_this_seal_leaves_the_step_unproven {
    // no run, a run that is not citable, a one-die run
    assert silicon_state(false, true, true, true, true, INDEP_DIES) == HW_UNPROVEN;
    assert silicon_state(true, false, true, true, true, INDEP_DIES) == HW_UNPROVEN;
    assert silicon_state(true, true, true, true, true, INDEP_NONE) == HW_UNPROVEN;
    // a run of another spec version, toolchain (the R3-3 receipts made by t27c 0.5.0) or config
    assert silicon_state(true, true, false, true, true, INDEP_DIES) == HW_UNPROVEN;
    assert silicon_state(true, true, true, false, true, INDEP_DIES) == HW_UNPROVEN;
    assert silicon_state(true, true, true, true, false, INDEP_DIES) == HW_UNPROVEN;
    // and an unproven hardware step is never a PASS, even with green tests
    assert seal_decision(PART_SAME, PART_SAME, PART_SAME, PART_SAME, true, true, HW_UNPROVEN) == REBUILD_VERDICT;
    assert seal_decision(PART_SAME, PART_SAME, PART_SAME, PART_SAME, true, true, HW_BLOCKED) == REBUILD_VERDICT;
}

test a_changed_spec_is_rebuilt_even_with_a_cited_run {
    var hw : u8 = silicon_state(true, true, true, true, true, INDEP_DIES);
    assert seal_decision(PART_DIFF, PART_SAME, PART_SAME, PART_SAME, true, true, hw) == REBUILD_SPEC;
}

test a_node_follows_its_imports {
    assert node_decision(PART_SAME, false, false, PART_SAME, PART_SAME, true, false, HW_UNPROVEN) == REUSE;
    // an import that was rebuilt rebuilds its importer; an import nobody could judge is missing
    assert node_decision(PART_SAME, true, false, PART_SAME, PART_SAME, true, false, HW_UNPROVEN) == REBUILD_CLOSURE;
    assert node_decision(PART_SAME, false, true, PART_SAME, PART_SAME, true, false, HW_UNPROVEN) == REBUILD_MISSING;
    assert node_decision(PART_SAME, true, true, PART_SAME, PART_SAME, true, false, HW_UNPROVEN) == REBUILD_MISSING;
    // the node's own spec is judged before its closure
    assert node_decision(PART_DIFF, true, false, PART_SAME, PART_SAME, true, false, HW_UNPROVEN) == REBUILD_SPEC;
}

test checks_pass_needs_at_least_one_check {
    assert checks_pass(true, false, 5, 0) == true;
    // a data spec whose invariants are proved at comptime is checked
    assert checks_pass(true, false, 0, 2) == true;
    // nothing ran: never a pass (specs/lsp/language.t27, specs/numeric/formats_catalog.t27)
    assert checks_pass(true, false, 0, 0) == false;
    assert checks_pass(false, false, 5, 1) == false;
    assert checks_pass(true, true, 5, 1) == false;
}

test remint_wants_only_a_stale_part {
    assert remint_wants(REUSE) == false;
    assert remint_wants(REBUILD_MISSING) == false;
    assert remint_wants(REBUILD_SPEC) == true;
    assert remint_wants(REBUILD_CLOSURE) == true;
    assert remint_wants(REBUILD_TOOLCHAIN) == true;
    assert remint_wants(REBUILD_CONFIG) == true;
    assert remint_wants(REBUILD_VERDICT) == true;
}

test remint_keeps_a_v2_seal_whose_checks_ran {
    assert remint_keeps(2, true, false, 6, 0, true) == true;
    // invariant-only: the 15 specs the hand filter dropped (#8386)
    assert remint_keeps(2, true, false, 0, 1, true) == true;
    // blocked: the seal records no failed count
    assert remint_keeps(2, false, false, 0, 0, true) == false;
    // nothing ran, a failing test, a forced seal, an old schema
    assert remint_keeps(2, true, false, 0, 0, true) == false;
    assert remint_keeps(2, false, false, 6, 1, true) == false;
    assert remint_keeps(2, true, true, 6, 1, true) == false;
    assert remint_keeps(1, true, false, 6, 0, true) == false;
    assert remint_keeps(3, true, false, 6, 0, true) == false;
    // a seal file another spec owns (a name collision) is never kept, however good the seal
    assert remint_keeps(2, true, false, 6, 1, false) == false;
}

test blocked_reseal_allowed_refuses_a_regression {
    // passed before, blocked now: a regression, refused
    assert blocked_reseal_allowed(true, false) == false;
    // blocked before and blocked now, or never sealed: the record stays true
    assert blocked_reseal_allowed(false, false) == true;
    // on purpose, with the failure on the record
    assert blocked_reseal_allowed(true, true) == true;
}

test the_reused_share_is_a_number {
    assert reused_permille(0, 0) == 0;
    assert reused_permille(0, 7) == 0;
    assert reused_permille(3, 4) == 750;
    assert reused_permille(1, 3) == 333;
    assert reused_permille(2, 3) == 667;
    assert reused_permille(5, 5) == 1000;
    assert reused_permille(9, 5) == 1000;
}

invariant a_remint_cache_is_shared_and_bounded {
    assert REMINT_CACHE_EVERY > 1 and REMINT_CACHE_EVERY <= 100;
}

invariant the_silicon_bar_is_three_distinct_dies {
    assert SILICON_REQUIRED_LEVEL == INDEP_DIES;
    assert SILICON_REQUIRED_LEVEL > INDEP_NONE;
}
