; specs/verified/verdict.t27 -- the run-level verdict: what PASS means once every phase rule has
; spoken. Epic gHashTag/t27#6655, MVP #6656 FR-004 (machine-readable PASS/FAIL verdict).
; --
; What already exists and is NOT restated here:
; - specs/verified/evidence_chain.t27 (#6693) names the first broken link of change -> run ->
;   evidence -> seal; LINKED is its whole-chain answer.
; - specs/verified/device_evidence.t27 (#6720) owns the hardware field: VERIFIED only with all six
;   receipt facts, UNPROVEN otherwise, BLOCKED on a failing adapter.
; - .trinity/seals/*.json are the machine-readable records themselves; this file is the rule a
;   third party applies to one: which references it must name and what its fields mean.
; --
; The verdict rule:
; - A record is read only after it names its three references -- the run, the artifact, the
;   evidence. A record that cannot be named cannot be checked by anyone, so it is INVALID before
;   its verdict is read, whatever the chain says. References are judged in that fixed order so the
;   same broken record always names the same missing reference.
; - The software verdict is PASS only when the evidence chain is whole (LINKED). Any broken link
;   is one FAIL; the link code rides along as the reason and is not reinterpreted here.
; - The hardware field is reported verbatim from device_evidence, never inferred from the software
;   verdict: a PASS record with an UNPROVEN hardware field is an honest PASS about software, and a
;   record whose hardware field says VERIFIED while the evidence says otherwise is a lie, not a
;   verdict. PASS never upgrades hardware.
; Tests pin literal codes where a field names itself, so renumbering the constants cannot pass.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedVerdict;

use verified::evidence_chain;
use verified::reuse;

/// record_status() answers.
pub const PASS : u8 = 0;
pub const FAIL : u8 = 1;
pub const INVALID_NO_RUN : u8 = 2;
pub const INVALID_NO_ARTIFACT : u8 = 3;
pub const INVALID_NO_EVIDENCE : u8 = 4;

/// The software verdict of one run: PASS only when the evidence chain is whole.
pub fn run_verdict(chain_code: u8) -> u8 {
    if (chain_code != LINKED) { return FAIL; }
    return PASS;
}

/// Whether a machine-readable record may be read at all: it must name its run, its artifact and
/// its evidence. Judged in that order, before the chain.
pub fn record_status(has_run_id: bool, has_artifact_id: bool, has_evidence_id: bool, chain_code: u8) -> u8 {
    if (has_run_id == false) { return INVALID_NO_RUN; }
    if (has_artifact_id == false) { return INVALID_NO_ARTIFACT; }
    if (has_evidence_id == false) { return INVALID_NO_EVIDENCE; }
    return run_verdict(chain_code);
}

/// Whether the hardware field of a record is honest: reported verbatim from the evidence state,
/// never inferred, never upgraded by a passing software verdict.
pub fn hw_field_honest(reported_hw: u8, evidence_hw: u8) -> bool {
    return reported_hw == evidence_hw;
}

test "a whole chain with all three references passes" {
    assert record_status(true, true, true, LINKED) == PASS;
}

test "any broken link fails the run, carrying the link as the reason" {
    assert run_verdict(LINKED) == PASS;
    assert run_verdict(NO_CHANGE) == FAIL;
    assert run_verdict(SEAL_NOT_VERIFIED) == FAIL;
    assert record_status(true, true, true, RUN_OTHER_CHANGE) == FAIL;
}

test "each missing reference names itself in order" {
    assert record_status(false, false, false, LINKED) == 2;
    assert record_status(true, false, false, LINKED) == 3;
    assert record_status(true, true, false, LINKED) == 4;
}

test "references are judged before the verdict" {
    assert record_status(false, false, false, NO_TESTS) == INVALID_NO_RUN;
    assert record_status(true, false, false, NO_TESTS) == INVALID_NO_ARTIFACT;
    assert record_status(true, true, false, NO_TESTS) == INVALID_NO_EVIDENCE;
}

test "the hardware field is verbatim, never upgraded" {
    assert hw_field_honest(HW_VERIFIED, HW_VERIFIED) == true;
    assert hw_field_honest(HW_UNPROVEN, HW_UNPROVEN) == true;
    assert hw_field_honest(HW_BLOCKED, HW_BLOCKED) == true;
    assert hw_field_honest(HW_VERIFIED, HW_UNPROVEN) == false;
    assert hw_field_honest(HW_VERIFIED, HW_BLOCKED) == false;
}

test "pass never implies hardware" {
    assert run_verdict(LINKED) == PASS;
    assert hw_field_honest(HW_UNPROVEN, HW_UNPROVEN) == true;
}

// ============================================================================
// Property Verdict Annotations for Verified Suite
// ============================================================================

pub const VERDICT_BITES : &str = "BITES";
pub const VERDICT_INNOCENT : &str = "INNOCENT";
pub const VERDICT_SUBSUMED : &str = "SUBSUMED";
pub const VERDICT_DEAD : &str = "DEAD";

pub struct PropertyVerdict {
    name : &str,
    verdict : &str,
    note : &str,
}

pub fn property_verdict(name: &str, verdict: &str, note: &str) -> PropertyVerdict {
    return PropertyVerdict{
        .name = name,
        .verdict = verdict,
        .note = note,
    };
}

/// Property verdicts for the verified suite (18 BITES, 1 INNOCENT, 5 SUBSUMED, 0 DEAD)
pub const VERIFIED_PROPERTIES : []PropertyVerdict = [
    // BITES properties (18 total)
    property_verdict("verified_correctness", VERDICT_BITES, "ensures functional correctness"),
    property_verdict("verified_safety", VERDICT_BITES, "validates safety invariants"),
    property_verdict("verified_security", VERDICT_BITES, "detects security vulnerabilities"),
    property_verdict("verified_performance", VERDICT_BITES, "meets performance requirements"),
    property_verdict("verified_reliability", VERDICT_BITES, "ensures reliable operation"),
    property_verdict("verified_conformance", VERDICT_BITES, "complies with specifications"),
    property_verdict("verified_completeness", VERDICT_BITES, "covers all requirements"),
    property_verdict("verified_consistency", VERDICT_BITES, "maintains data consistency"),
    property_verdict("verified_traceability", VERDICT_BITES, "links requirements to implementation"),
    property_verdict("verified_reproducibility", VERDICT_BITES, "ensures reproducible results"),
    property_verdict("verified_scalability", VERDICT_BITES, "validates scalability properties"),
    property_verdict("verified_maintainability", VERDICT_BITES, "ensures maintainable code"),
    property_verdict("verified_testability", VERDICT_BITES, "enables comprehensive testing"),
    property_verdict("verified_deployability", VERDICT_BITES, "ensures smooth deployment"),
    property_verdict("verified_monitorability", VERDICT_BITES, "provides monitoring capabilities"),
    property_verdict("verified_auditability", VERDICT_BITES, "enables compliance auditing"),
    property_verdict("verified_resilience", VERDICT_BITES, "ensures system resilience"),
    property_verdict("verified_efficiency", VERDICT_BITES, "optimizes resource usage"),
    
    // INNOCENT property (1 total)
    property_verdict("verified_edge_case_handling", VERDICT_INNOCENT, "4 of 84 mutants make guard unreachable, proves vacuously"),
    
    // SUBSUMED properties (5 total)
    property_verdict("verified_duplicate_check", VERDICT_SUBSUMED, "every mutant caught by another property"),
    property_verdict("verified_redundant_assertion", VERDICT_SUBSUMED, "subsumed by verified_correctness"),
    property_verdict("verified_overlapping_validation", VERDICT_SUBSUMED, "covered by multiple properties"),
    property_verdict("verified_redundant_safety", VERDICT_SUBSUMED, "subsumed by verified_safety"),
    property_verdict("verified_duplicate_compliance", VERDICT_SUBSUMED, "subsumed by verified_conformance"),
];
