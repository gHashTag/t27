/// Compute SHA256 hash of bytes and return as hex string
pub fn hash_bytes(data: []u8) -> str {
    // Use the existing SHA256 implementation from tri/crypto/sha256
    let hash_bytes = tri::crypto::sha256::hash(data);
    let hex_chars = []u8;
    for i in 0..32 {
        let high = (hash_bytes[i] as usize) / 16;
        let low = (hash_bytes[i] as usize) % 16;
        hex_chars.push(hex_char(high));
        hex_chars.push(hex_char(low));
    }
    return string_from_bytes(hex_chars);
}

/// Convert a number to a hex character
pub fn hex_char(n: usize) -> u8 {
    if n >= 10 {
        return ((n + 87) as u8); // 'a' - 'f'
    }
    return ((n + 48) as u8); // '0' - '9'
}

/// Convert bytes to string
pub fn string_from_bytes(bytes: []u8) -> str {
    // In a real implementation, this would convert bytes to string
