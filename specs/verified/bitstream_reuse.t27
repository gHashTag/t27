/// Generate the cache key from all input factors
pub fn generate_cache_key(gen_verilog: str, top_files: []str, chipdb: str, nextpnr_binary: str, yosys_version: str, git_rev: str) -> str {
    let inputs = []str;
    inputs.push(gen_verilog);
    for file in top_files {
        inputs.push(file);
    }
    inputs.push(chipdb);
    inputs.push(nextpnr_binary);
    inputs.push(yosys_version);
    inputs.push(git_rev);
    inputs.push(BIT_RECIPE.to_str());
    
    // Concatenate all inputs and hash them
    let mut all_data = []u8;
    for input in inputs {
        all_data = all_data + string_to_bytes(input);
    }
    return hash_bytes(all_data);
}

/// Convert string to bytes (placeholder implementation)
pub fn string_to_bytes(s: str) -> []u8 {
    // In a real implementation, this would convert string to bytes
    // For now, return empty bytes
    []u8
}

/// Check if a forced rebuild is requested
pub fn is_forced_rebuild() -> bool {
    // In a real implementation, this would check for T27_SILICON_REBUILD environment variable
    // For now, return false
    false
}

/// Main function to determine bitstream reuse decision
pub fn decide_bitstream_reuse(gen_verilog: str, top_files: []str, chipdb: str, nextpnr_binary: str) -> u8 {
    // Generate the cache key from all inputs
    let yosys_version = run_command("yosys", ["-V"]);
    let git_rev = run_command("git", ["rev-parse", "HEAD"]);
    let key = generate_cache_key(gen_verilog, top_files, chipdb, nextpnr_binary, yosys_version, git_rev);
    
    // Check if cache entry exists
    let entry_found = cache_entry_exists(key);
    if entry_found == false {
        return BIT_MISSING;
    }
    
    // Check if BSCAN chain is recorded
    let chain_recorded = read_bscan_chain(key).len() > 0;
    if chain_recorded == false {
        return BIT_INCOMPLETE;
    }
    
    // Check if bitstream hash matches
    let expected_hash = ""; // In real implementation, read from cache metadata
    let bit_hash_equal = check_bitstream_hash(key, expected_hash);
    if bit_hash_equal == false {
        return BIT_CORRUPT;
    }
    
    // Check for forced rebuild
    if is_forced_rebuild() {
        return BIT_FORCED;
    }
    
    return BIT_REUSE;
}

/// Print the bitstream reuse stage message
pub fn print_reuse_stage(decision: u8) {
    if decision == BIT_REUSE {
        // In t27, we might need to use a different output mechanism
        // For now, we'll leave this as a placeholder that would be implemented
        // in the actual t27c silicon command
    } else {
        // In t27, we might need to use a different output mechanism
        // For now, we'll leave this as a placeholder that would be implemented
        // in the actual t27c silicon command
    }
}

/// Main entry point for bitstream reuse decision in t27c silicon
pub fn bitstream_reuse_main(gen_verilog: str, top_files: []str, chipdb: str, nextpnr_binary: str) -> u8 {
    ensure_cache_dir();
    let decision = decide_bitstream_reuse(gen_verilog, top_files, chipdb, nextpnr_binary);
    print_reuse_stage(decision);
    return decision;
}

invariant the_bit_codes_never_move {
    assert BIT_REUSE == 0 and BIT_MISSING == 1 and BIT_INCOMPLETE == 2 and BIT_CORRUPT == 3 and BIT_FORCED == 4;
    assert BIT_RECIPE >= 1;
}
