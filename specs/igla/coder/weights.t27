    then bank.data.len() == 0

invariant int4_dequantize_bank_depth_matches_input
    forall codes : []i8, depth : u32, width : u32
    depth * width == codes.len()
    ==>
    int4_dequantize_bank(codes, depth, width).depth == depth

invariant int4_dequantize_bank_shape_matches
    forall codes : []i8, depth : u32, width : u32
    depth * width == codes.len()
    ==>
    int4_dequantize_bank(codes, depth, width).data.len() == codes.len()

test int4_dequantize_bank_all_zeros
    given codes = [0:i8, 0:i8, 0:i8]
