invariant ternary_gemm_invalid_weight_code_zero
    forall a : []i8
    len(a) == 4 ==>
    let w = [TernaryWeight { code: 3 }, TernaryWeight { code: 3 }, TernaryWeight { code: 3 }, TernaryWeight { code: 3 }]
