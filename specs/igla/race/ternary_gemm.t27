    given a = [cast_i8(1), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0), cast_i8(0)]
