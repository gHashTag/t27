invariant ternary_gemm_2x2_all_ones_weights_sum
    forall a : []i8
    len(a) == 4 ==>
    let w = [TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }]
    let out = ternary_gemm_2x2(a, w)
    out[0] == a[0] + a[1] && out[1] == a[0] + a[1] && out[2] == a[2] + a[3] && out[3] == a[2] + a[3]

