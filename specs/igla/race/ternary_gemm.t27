    then out[0] == 3 && out[1] == 3 && out[2] == 0 && out[3] == 0

invariant ternary_gemm_2x2_single_plus_weight_broadcast_inv:
    forall a : i8
    let w = [TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }]
    let out = ternary_gemm_2x2([a, cast_i8(0), cast_i8(0), cast_i8(0)], w)
    out[0] == a && out[1] == a

