test rtl_emit_vhdl_assignment_operator
    given mod = RtlModule {
        name: "vhdl_assign",
        inputs: [],
        outputs: [Signal { name: "y", width: 1, signed: false }],
        wires: [],
        assigns: [Assignment { lhs: "y", rhs: "1", op: 0 }],
        instances: [],
        sacred_chain: []
    }
    when v = emit_vhdl(mod)
    then contains_substring(v, "<=")

test rtl_generate_sacred_module_structure
    given op = 0
    given config = RtlGenConfig { target_lang: TARGET_LANG_VERILOG, enforce_r_si_1: true, wallace_tree: false, pipeline_stages: 0 }
    when mod = generate_sacred_module(op, config)
    then mod.inputs.len() == 1 && mod.outputs.len() == 1 && mod.wires.len() == 1 && mod.assigns.len() == 1
    && is_r_si_1_compliant(mod) == true

test rtl_generate_wallace_tree_single_bit
    given a = [1]
