// Benchmarks
// ============================================================================

    invariant rtl_phi_identity:
    1.618 * 1.618 + 1.0 / (1.618 * 1.618) > 2.99 && 1.618 * 1.618 + 1.0 / (1.618 * 1.618) < 3.01
bench emit_verilog_1k_assigns
    given module = mock_module(1000)
    measure emit_verilog(module)
    target latency_ms < 50.0

test rtl_r_si_1_exactly_one_mul_violation
    given mod = RtlModule {
        name: "violator",
        inputs: [Signal { name: "a", width: 1, signed: false }],
        outputs: [Signal { name: "b", width: 1, signed: false }],
        wires: [],
        assigns: [Assignment { lhs: "b", rhs: "a * a", op: 0 }],
        instances: [],
        sacred_chain: []
    }
    when ok = is_r_si_1_compliant(mod)
    then ok == false

