    when r = ternary_mac(acc, a, w)
    then r == 0

test ternary_decode_zero_weight
    given w = TernaryWeight { code: 0 }
    when d = ternary_decode(w)
    then d == 0

test ternary_dot_empty_arrays
    given a = []i8{}
    given w = []TernaryWeight{}
    when r = ternary_dot(a, w, 0, 0)
    then r == 0

