invariant ternary_mul_bounded_by_activation:
    forall a : i8, w : TernaryWeight
    ternary_mul(a, w) == 0 || ternary_mul(a, w) == a || ternary_mul(a, w) == -a

invariant ternary_mac_is_acc_plus_mul:
