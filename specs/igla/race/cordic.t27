    iters >= 8 && iters <= 16 ==>
    let (s1, c1) = cordic_sin_cos(angle, iters)
    let (s2, c2) = cordic_sin_cos(-angle, iters)
    s2[0] > -s1[0] - 0.02 && s2[0] < -s1[0] + 0.02 && c2[0] > c1[0] - 0.02 && c2[0] < c1[0] + 0.02

