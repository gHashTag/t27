test bram_weights_flatten_addr_first_element
    given bank = WeightBank { depth: 2, width: 2, data: [1, 2, 3, 4] }
    when idx = flatten_addr(bank, WeightAddr { row: 0, col: 0 })
    then idx == 0

test bram_weights_load_row_last
    given bank = WeightBank { depth: 2, width: 2, data: [10, 20, 30, 40] }
    when row = load_row(bank, 1, 0)
    then len(row) == 2 && row[0] == 30 && row[1] == 40

test bram_weights_write_weight_zero_addr
    given bank = WeightBank { depth: 2, width: 2, data: [1, 2, 3, 4] }
    given addr = WeightAddr { row: 0, col: 0 }
    when new_bank = write_weight(bank, addr, 99)
    when v = read_weight(new_bank, addr)
    then v == 99

test bram_weights_flatten_addr_zero_zero
    given bank = WeightBank { depth: 3, width: 3, data: [1, 2, 3, 4, 5, 6, 7, 8, 9] }
    when idx = flatten_addr(bank, WeightAddr { row: 0, col: 0 })
