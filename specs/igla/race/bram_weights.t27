test bram_weights_flatten_addr_max_row_col
    given bank = WeightBank { depth: 3, width: 3, data: [1, 2, 3, 4, 5, 6, 7, 8, 9] }
    when idx = flatten_addr(bank, WeightAddr { row: 2, col: 2 })
