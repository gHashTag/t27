invariant adder_tree_2_antisymmetric:
    forall a : i32
    adder_tree_2(a, -a) == 0

invariant adder_tree_2_commutative:
    forall a : i32, b : i32
    adder_tree_2(a, b) == adder_tree_2(b, a)

invariant adder_tree_4_associative:
    forall a : i32, b : i32, c : i32, d : i32
    adder_tree_4(a, b, c, d) == adder_tree_4(c, d, a, b)

test adder_tree_8_descending_values
    given v = Vec8 { v0: 8, v1: 7, v2: 6, v3: 5, v4: 4, v5: 3, v6: 2, v7: 1 }
    when sum = adder_tree_8(v)
    then sum == 36

