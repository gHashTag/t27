    a.len() == 1 && a[0] == 0 ==> cordic_top_batch(a) == 0

invariant cordic_top_outputs_bounded_q14
    forall clk : bool, rst_n : bool, angle : i16
    rst_n == true ==>
    cordic_top(clk, rst_n, angle, true).0 >= -16384
    && cordic_top(clk, rst_n, angle, true).0 <= 16384
    && cordic_top(clk, rst_n, angle, true).1 >= -16384
    && cordic_top(clk, rst_n, angle, true).1 <= 16384

invariant cordic_top_batch_len_nonnegative_squared
    forall angles : []i16
    cordic_top_batch(angles) * cordic_top_batch(angles) >= 0

