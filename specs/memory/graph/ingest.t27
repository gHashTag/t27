// SPDX-License-Identifier: Apache-2.0
; Epic #7828, slice 4 (#8425), executable restoration #8752.
; Pure extraction policy: it emits an effect request but never calls an LLM.
; Plaintext disclosure needs explicit consent for the selected trust domain.
; Slices 1-3 own scope, retention and fact validity; their rules are called here.
; Outcome is one u64 so state, emission, commit and refusal cannot drift apart.

module MemoryGraphIngest;

use memory::graph::scope;
use memory::graph::temporal;
use memory::graph::types;

pub const STATE_RECEIVED : u8 = 1;
pub const STATE_ADMITTED : u8 = 2;
pub const STATE_EXTRACTING : u8 = 3;
pub const STATE_COMMITTED : u8 = 4;
pub const STATE_REJECTED : u8 = 5;
pub const EVENT_ADMIT : u8 = 1;
pub const EVENT_EMIT : u8 = 2;
pub const EVENT_RESULT : u8 = 3;
pub const EVENT_FAIL : u8 = 4;
pub const EVENT_ABORT : u8 = 5;
pub const REASON_NONE : u8 = 0;
pub const REASON_SCOPE : u8 = 1;
pub const REASON_TEMPORAL : u8 = 2;
pub const REASON_FORMAT : u8 = 3;
pub const REASON_EFFECT : u8 = 4;
pub const REASON_STATE : u8 = 5;
pub const REASON_CONSENT : u8 = 6;
pub const REASON_DOMAIN : u8 = 7;
pub const REASON_SETTLED : u8 = 8;
pub const DOMAIN_UNKNOWN : u8 = 0;
pub const DOMAIN_PRIVATE : u8 = 1;
pub const DOMAIN_PUBLIC : u8 = 2;
pub const CONSENT_MISSING : u8 = 0;
pub const CONSENT_PRIVATE : u8 = 1;
pub const CONSENT_DENIED : u8 = 2;
pub const CONSENT_PUBLIC : u8 = 3;
pub const CONSENT_BOTH : u8 = 4;
pub const MAX_ATTEMPTS : u8 = 3;

; Bits 0..7: state; 8: emitted; 9: committed; 10: requires_plaintext;
; 16..23: reason; 24..31: trust domain; 32..39: attempts already emitted.
pub const EFFECT_BIT : u64 = 256;
pub const COMMIT_BIT : u64 = 512;
pub const PLAINTEXT_BIT : u64 = 1024;

pub fn is_state(state: u8) -> bool {
    return state >= STATE_RECEIVED && state <= STATE_REJECTED;
}

pub fn is_event(event: u8) -> bool {
    return event >= EVENT_ADMIT && event <= EVENT_ABORT;
}

pub fn is_allowed(reason: u8) -> bool { return reason == REASON_NONE; }

pub fn refusal(reason: u8) -> u8 {
    if (reason >= REASON_SCOPE && reason <= REASON_SETTLED) { return reason; }
    return REASON_STATE;
}

pub fn is_domain(domain: u8) -> bool {
    return domain == DOMAIN_PRIVATE || domain == DOMAIN_PUBLIC;
}

pub fn consent_covers(domain: u8, consent: u8) -> bool {
    if (!is_domain(domain)) { return false; }
    if (consent == CONSENT_BOTH) { return true; }
    if (domain == DOMAIN_PRIVATE) { return consent == CONSENT_PRIVATE; }
    return consent == CONSENT_PUBLIC;
}

pub fn disclosure_status(domain: u8, consent: u8) -> u8 {
    if (!is_domain(domain)) { return REASON_DOMAIN; }
    if (!consent_covers(domain, consent)) { return REASON_CONSENT; }
    return REASON_NONE;
}

; The first refusal wins. No second copy of the owner/user/thread rule.
pub fn admission(p_kind: u8, p_owner: u64, p_user: u64, p_thread: u64,
                 r_owner: u64, r_user: u64, r_thread: u64,
                 created_at: u64, expired_at: u64, as_of: u64,
                 ttl: u64, now: u64, domain: u8, consent: u8) -> u8 {
    if (!scope::may_write(p_kind, p_owner, p_user, p_thread, r_owner, r_user, r_thread)) {
        return REASON_SCOPE;
    }
    if (!temporal::known_as_of(created_at, expired_at, as_of)) { return REASON_TEMPORAL; }
    if (scope::raw_expired(created_at, ttl, now)) { return REASON_TEMPORAL; }
    return disclosure_status(domain, consent);
}

; Extraction results do not exist before the effect: validate them before commit.
pub fn result_status(group: u64, source: u64, source_group: u64,
                     target: u64, target_group: u64, valid_at: u64,
                     invalid_at: u64, created_at: u64, expired_at: u64) -> u8 {
    if (!types::fact_endpoints_ok(group, source, source_group, target, target_group)) {
        return REASON_FORMAT;
    }
    if (!types::fact_well_formed(valid_at, invalid_at, created_at, expired_at)) {
        return REASON_FORMAT;
    }
    return REASON_NONE;
}

pub fn outcome(state: u8, emitted: bool, committed: bool, reason: u8,
               domain: u8, attempts: u8) -> u64 {
    var value: u64 = state as u64;
    if (emitted) { value = value | EFFECT_BIT | PLAINTEXT_BIT | ((domain as u64) << 24); }
    if (committed) { value = value | COMMIT_BIT; }
    return value | ((reason as u64) << 16) | ((attempts as u64) << 32);
}

pub fn state_of(value: u64) -> u8 { return (value & 255) as u8; }
pub fn emitted(value: u64) -> bool { return (value & EFFECT_BIT) != 0; }
pub fn committed(value: u64) -> bool { return (value & COMMIT_BIT) != 0; }
pub fn requires_plaintext(value: u64) -> bool { return (value & PLAINTEXT_BIT) != 0; }
pub fn reason_of(value: u64) -> u8 { return ((value >> 16) & 255) as u8; }
pub fn domain_of(value: u64) -> u8 { return ((value >> 24) & 255) as u8; }
pub fn attempts_of(value: u64) -> u8 { return ((value >> 32) & 255) as u8; }

; Caller supplies a fresh admission status at ADMIT, EMIT and RESULT, and the
; extraction result's status at RESULT. An earlier admission is not authority
; for a later disclosure or write. Attempts count actual emitted requests.
pub fn step(state: u8, event: u8, gate: u8, result: u8, attempts: u8,
            domain: u8, consent: u8) -> u64 {
    if (state == STATE_COMMITTED || state == STATE_REJECTED) {
        if (event == EVENT_RESULT) {
            return outcome(state, false, false, REASON_SETTLED, DOMAIN_UNKNOWN, attempts);
        }
        return outcome(state, false, false, REASON_STATE, DOMAIN_UNKNOWN, attempts);
    }
    if (!is_state(state) || !is_event(event) || attempts > MAX_ATTEMPTS) {
        return outcome(STATE_REJECTED, false, false, REASON_STATE, DOMAIN_UNKNOWN, attempts);
    }
    if (state == STATE_EXTRACTING && attempts == 0) {
        return outcome(STATE_REJECTED, false, false, REASON_STATE, DOMAIN_UNKNOWN, attempts);
    }
    if (event == EVENT_ABORT) {
        return outcome(STATE_REJECTED, false, false, REASON_EFFECT, DOMAIN_UNKNOWN, attempts);
    }
    if (state == STATE_RECEIVED && event == EVENT_ADMIT) {
        if (!is_allowed(gate)) {
            return outcome(STATE_REJECTED, false, false, refusal(gate), DOMAIN_UNKNOWN, attempts);
        }
        return outcome(STATE_ADMITTED, false, false, REASON_NONE, DOMAIN_UNKNOWN, attempts);
    }
    if (state == STATE_ADMITTED && event == EVENT_EMIT) {
        if (!is_allowed(gate)) {
            return outcome(STATE_REJECTED, false, false, refusal(gate), DOMAIN_UNKNOWN, attempts);
        }
        let disclosure: u8 = disclosure_status(domain, consent);
        if (!is_allowed(disclosure)) {
            return outcome(STATE_REJECTED, false, false, disclosure, DOMAIN_UNKNOWN, attempts);
        }
        if (attempts >= MAX_ATTEMPTS) {
            return outcome(STATE_REJECTED, false, false, REASON_EFFECT, DOMAIN_UNKNOWN, attempts);
        }
        return outcome(STATE_EXTRACTING, true, false, REASON_NONE, domain, attempts + 1);
    }
    if (state == STATE_EXTRACTING && event == EVENT_RESULT) {
        if (!is_allowed(gate)) {
            return outcome(STATE_REJECTED, false, false, refusal(gate), DOMAIN_UNKNOWN, attempts);
        }
        if (!is_allowed(result)) {
            return outcome(STATE_REJECTED, false, false, refusal(result), DOMAIN_UNKNOWN, attempts);
        }
        return outcome(STATE_COMMITTED, false, true, REASON_NONE, DOMAIN_UNKNOWN, attempts);
    }
    if (state == STATE_EXTRACTING && event == EVENT_FAIL) {
        if (attempts < MAX_ATTEMPTS) {
            return outcome(STATE_RECEIVED, false, false, REASON_EFFECT, DOMAIN_UNKNOWN, attempts);
        }
        return outcome(STATE_REJECTED, false, false, REASON_EFFECT, DOMAIN_UNKNOWN, attempts);
    }
    return outcome(STATE_REJECTED, false, false, REASON_STATE, DOMAIN_UNKNOWN, attempts);
}

fn same_thread_admission(domain: u8, consent: u8) -> u8 {
    return admission(scope::PRINCIPAL_AGENT, 1, 2, 3, 1, 2, 3,
                     100, 0, 100, scope::RAW_TTL_DEFAULT, 100, domain, consent);
}

fn good_result() -> u8 { return result_status(7, 11, 7, 12, 7, 100, 0, 100, 0); }

test ingest_valid_path_emits_then_commits_once {
    let gate: u8 = same_thread_admission(DOMAIN_PRIVATE, CONSENT_PRIVATE);
    let a: u64 = step(STATE_RECEIVED, EVENT_ADMIT, gate, REASON_NONE, 0, DOMAIN_PRIVATE, CONSENT_PRIVATE);
    assert state_of(a) == STATE_ADMITTED;
    assert !emitted(a) && !committed(a);
    let e: u64 = step(state_of(a), EVENT_EMIT, gate, REASON_NONE, attempts_of(a), DOMAIN_PRIVATE, CONSENT_PRIVATE);
    assert state_of(e) == STATE_EXTRACTING;
    assert emitted(e) && requires_plaintext(e);
    assert domain_of(e) == DOMAIN_PRIVATE;
    assert attempts_of(e) == 1;
    let c: u64 = step(state_of(e), EVENT_RESULT, gate, good_result(), attempts_of(e), DOMAIN_PRIVATE, CONSENT_PRIVATE);
    assert state_of(c) == STATE_COMMITTED && committed(c);
    assert !emitted(c) && !requires_plaintext(c) && domain_of(c) == DOMAIN_UNKNOWN;
    let again: u64 = step(state_of(c), EVENT_RESULT, gate, good_result(), attempts_of(c), DOMAIN_PRIVATE, CONSENT_PRIVATE);
    assert state_of(again) == STATE_COMMITTED && !committed(again);
    assert reason_of(again) == REASON_SETTLED;
}

test ingest_scope_and_temporal_refusals_are_distinct {
    let foreign: u8 = admission(scope::PRINCIPAL_AGENT, 1, 2, 3, 9, 2, 3,
                               100, 0, 100, scope::RAW_TTL_DEFAULT, 100, DOMAIN_PRIVATE, CONSENT_PRIVATE);
    assert foreign == REASON_SCOPE;
    let rejected: u64 = step(STATE_RECEIVED, EVENT_ADMIT, foreign, 0, 0, DOMAIN_PRIVATE, CONSENT_PRIVATE);
    assert state_of(rejected) == STATE_REJECTED && !emitted(rejected);
    assert reason_of(rejected) == REASON_SCOPE;
    assert admission(scope::PRINCIPAL_PERSON, 1, 2, 3, 1, 2, 3, 100, 0, 100, scope::RAW_TTL_DEFAULT, 100, 1, 1) == REASON_SCOPE;
    assert admission(scope::PRINCIPAL_AGENT, 1, 2, 3, 1, 2, 4, 100, 0, 100, scope::RAW_TTL_DEFAULT, 100, 1, 1) == REASON_SCOPE;
    assert admission(scope::PRINCIPAL_AGENT, 1, 2, 3, 1, 2, 3, 101, 0, 100, scope::RAW_TTL_DEFAULT, 100, 1, 1) == REASON_TEMPORAL;
    assert admission(scope::PRINCIPAL_AGENT, 1, 2, 3, 1, 2, 3, 100, 101, 101, scope::RAW_TTL_DEFAULT, 101, 1, 1) == REASON_TEMPORAL;
    assert admission(scope::PRINCIPAL_AGENT, 1, 2, 3, 1, 2, 3, 100, 0, 100, 86400, 86500, 1, 1) == REASON_TEMPORAL;
    assert admission(scope::PRINCIPAL_AGENT, 1, 2, 3, 1, 2, 3, 100, 0, 100, 0, 100, 1, 1) == REASON_TEMPORAL;
}

test ingest_disclosure_refuses_missing_denied_and_unknown_codes {
    assert same_thread_admission(DOMAIN_PRIVATE, CONSENT_MISSING) == REASON_CONSENT;
    assert same_thread_admission(DOMAIN_PRIVATE, CONSENT_DENIED) == REASON_CONSENT;
    assert same_thread_admission(DOMAIN_PRIVATE, CONSENT_PUBLIC) == REASON_CONSENT;
    assert same_thread_admission(DOMAIN_UNKNOWN, CONSENT_BOTH) == REASON_DOMAIN;
    let missing: u64 = step(STATE_ADMITTED, EVENT_EMIT, REASON_NONE, 0, 0, DOMAIN_PRIVATE, CONSENT_MISSING);
    assert state_of(missing) == STATE_REJECTED && !emitted(missing);
    assert reason_of(missing) == REASON_CONSENT;
    assert !requires_plaintext(missing) && domain_of(missing) == DOMAIN_UNKNOWN;
}

test ingest_emission_rereads_admission_after_it_changed {
    let admitted: u64 = step(STATE_RECEIVED, EVENT_ADMIT, REASON_NONE, 0, 0, 1, 1);
    assert state_of(admitted) == STATE_ADMITTED;
    let denied: u64 = step(state_of(admitted), EVENT_EMIT, REASON_SCOPE, 0, 0, 1, 1);
    assert state_of(denied) == STATE_REJECTED && !emitted(denied);
    assert reason_of(denied) == REASON_SCOPE;
    let withdrawn: u64 = step(STATE_EXTRACTING, EVENT_RESULT, REASON_CONSENT, good_result(), 1, 1, 2);
    assert state_of(withdrawn) == STATE_REJECTED && !committed(withdrawn);
    assert reason_of(withdrawn) == REASON_CONSENT;
}

test ingest_results_use_real_endpoint_and_time_policies {
    assert good_result() == REASON_NONE;
    assert result_status(7, 11, 7, 12, 8, 100, 0, 100, 0) == REASON_FORMAT;
    assert result_status(7, 11, 7, 11, 7, 100, 0, 100, 0) == REASON_FORMAT;
    assert result_status(7, 11, 7, 12, 7, 100, 99, 100, 0) == REASON_FORMAT;
    let bad: u8 = result_status(7, 11, 7, 12, 7, 100, 0, 0, 0);
    let rejected: u64 = step(STATE_EXTRACTING, EVENT_RESULT, REASON_NONE, bad, 1, 1, 1);
    assert state_of(rejected) == STATE_REJECTED && !committed(rejected);
    assert reason_of(rejected) == REASON_FORMAT;
}

test ingest_retry_reenters_received_and_withdrawal_stops_disclosure {
    let e: u64 = step(STATE_ADMITTED, EVENT_EMIT, REASON_NONE, 0, 0, 1, 1);
    let retry: u64 = step(state_of(e), EVENT_FAIL, 0, 0, attempts_of(e), 1, 1);
    assert state_of(retry) == STATE_RECEIVED && !emitted(retry);
    assert attempts_of(retry) == 1;
    let gate: u8 = same_thread_admission(DOMAIN_PRIVATE, CONSENT_DENIED);
    let stopped: u64 = step(state_of(retry), EVENT_ADMIT, gate, 0, attempts_of(retry), 1, 2);
    assert state_of(stopped) == STATE_REJECTED && reason_of(stopped) == REASON_CONSENT;
    assert !emitted(stopped) && !committed(stopped);
}

test ingest_attempt_cap_and_abort_settle_without_an_effect {
    let exhausted: u64 = step(STATE_EXTRACTING, EVENT_FAIL, 0, 0, MAX_ATTEMPTS, 1, 1);
    assert state_of(exhausted) == STATE_REJECTED && reason_of(exhausted) == REASON_EFFECT;
    let extra: u64 = step(STATE_ADMITTED, EVENT_EMIT, 0, 0, MAX_ATTEMPTS, 1, 1);
    assert !emitted(extra) && attempts_of(extra) == MAX_ATTEMPTS;
    assert reason_of(extra) == REASON_EFFECT;
    let aborted: u64 = step(STATE_RECEIVED, EVENT_ABORT, 0, 0, 0, 1, 1);
    assert state_of(aborted) == STATE_REJECTED && !committed(aborted);
}

test ingest_failed_effects_retry_through_admission_until_the_cap {
    var state: u8 = STATE_RECEIVED;
    var attempts: u8 = 0;
    while (attempts < MAX_ATTEMPTS) {
        let admitted: u64 = step(state, EVENT_ADMIT, same_thread_admission(1, 1), 0, attempts, 1, 1);
        assert state_of(admitted) == STATE_ADMITTED;
        let request: u64 = step(state_of(admitted), EVENT_EMIT, same_thread_admission(1, 1), 0, attempts, 1, 1);
        assert emitted(request) && !committed(request);
        attempts = attempts_of(request);
        let failed: u64 = step(state_of(request), EVENT_FAIL, 0, 0, attempts, 1, 1);
        assert !emitted(failed) && !committed(failed) && reason_of(failed) == REASON_EFFECT;
        state = state_of(failed);
        if (attempts < MAX_ATTEMPTS) { assert state == STATE_RECEIVED; }
        else { assert state == STATE_REJECTED; }
    }
    assert attempts == MAX_ATTEMPTS && state == STATE_REJECTED;
}

test ingest_invalid_codes_and_unknown_reasons_fail_closed {
    assert !is_allowed(255);
    let unknown: u64 = step(255, EVENT_ADMIT, 0, 0, 0, 1, 1);
    assert state_of(unknown) == STATE_REJECTED && reason_of(unknown) == REASON_STATE;
    let event: u64 = step(STATE_RECEIVED, 255, 0, 0, 0, 1, 1);
    assert !emitted(event) && !committed(event) && reason_of(event) == REASON_STATE;
    let gate: u64 = step(STATE_RECEIVED, EVENT_ADMIT, 255, 0, 0, 1, 1);
    assert state_of(gate) == STATE_REJECTED && reason_of(gate) == REASON_STATE;
    let result: u64 = step(STATE_EXTRACTING, EVENT_RESULT, 0, 255, 1, 1, 1);
    assert !committed(result) && reason_of(result) == REASON_STATE;
    let corrupted: u64 = step(STATE_EXTRACTING, EVENT_RESULT, 0, 0, 0, 1, 1);
    assert !committed(corrupted) && reason_of(corrupted) == REASON_STATE;
}

test ingest_settled_states_absorb_every_event_including_invalid_ones {
    var state: u8 = STATE_COMMITTED;
    while (state <= STATE_REJECTED) {
        var event: u8 = 0;
        while (event < 8) {
            let value: u64 = step(state, event, 0, 0, 1, 1, 1);
            assert state_of(value) == state;
            assert !emitted(value) && !committed(value);
            if (event == EVENT_RESULT) { assert reason_of(value) == REASON_SETTLED; }
            else { assert reason_of(value) == REASON_STATE; }
            event = event + 1;
        }
        state = state + 1;
    }
}

test ingest_exhaustive_state_event_pairs_have_one_emit_and_one_commit {
    var emit_count: u32 = 0;
    var commit_count: u32 = 0;
    var state: u8 = 0;
    while (state < 8) {
        var event: u8 = 0;
        while (event < 8) {
            let value: u64 = step(state, event, 0, 0, 1, DOMAIN_PRIVATE, CONSENT_PRIVATE);
            assert is_state(state_of(value));
            assert emitted(value) == (state == STATE_ADMITTED && event == EVENT_EMIT);
            assert committed(value) == (state == STATE_EXTRACTING && event == EVENT_RESULT);
            assert requires_plaintext(value) == emitted(value);
            if (emitted(value)) {
                emit_count = emit_count + 1;
                assert domain_of(value) == DOMAIN_PRIVATE;
            } else { assert domain_of(value) == DOMAIN_UNKNOWN; }
            if (committed(value)) { commit_count = commit_count + 1; }
            event = event + 1;
        }
        state = state + 1;
    }
    assert emit_count == 1;
    assert commit_count == 1;
}

test ingest_exhaustive_domain_consent_pairs_emit_iff_explicitly_covered {
    var domain: u8 = 0;
    while (domain < 5) {
        var consent: u8 = 0;
        while (consent < 7) {
            let gate: u8 = same_thread_admission(domain, consent);
            let value: u64 = step(STATE_ADMITTED, EVENT_EMIT, gate, 0, 0, domain, consent);
            let expected: bool = (domain == DOMAIN_PRIVATE && (consent == CONSENT_PRIVATE || consent == CONSENT_BOTH))
                              || (domain == DOMAIN_PUBLIC && (consent == CONSENT_PUBLIC || consent == CONSENT_BOTH));
            assert emitted(value) == expected;
            assert requires_plaintext(value) == expected;
            assert !committed(value);
            if (expected) { assert domain_of(value) == domain; }
            else { assert domain_of(value) == DOMAIN_UNKNOWN; }
            consent = consent + 1;
        }
        domain = domain + 1;
    }
}
