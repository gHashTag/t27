; specs/memory/graph/ingest.t27 -- how an episode becomes entities and facts, and every way that can refuse
; Epic #7828, slice 4. Slices 1-3 already landed: types.t27, temporal.t27, scope.t27, crypt.t27.

module MemoryGraphIngest;

; Import dependencies
import MemoryGraphTypes;
import MemoryGraphScope;
import MemoryGraphTemporal;
import MemoryGraphCrypt;

; State codes
pub const STATE_RECEIVED : u8 = 1;
pub const STATE_ADMITTED : u8 = 2;
pub const STATE_EXTRACTING : u8 = 3;
pub const STATE_COMMITTED : u8 = 4;
pub const STATE_REJECTED : u8 = 5;

; Event codes
pub const EVENT_ADMIT : u8 = 1;
pub const EVENT_EMIT : u8 = 2;
pub const EVENT_RESULT : u8 = 3;
pub const EVENT_FAIL : u8 = 4;
pub const EVENT_ABORT : u8 = 5;

; Reason codes
pub const REASON_NONE : u8 = 0;
pub const REASON_SCOPE : u8 = 1;
pub const REASON_TEMPORAL : u8 = 2;
pub const REASON_FORMAT : u8 = 3;
pub const REASON_EFFECT : u8 = 4;
pub const REASON_STATE : u8 = 5;

; Trust domain codes
pub const DOMAIN_UNKNOWN : u8 = 0;
pub const DOMAIN_PRIVATE : u8 = 1;
pub const DOMAIN_PUBLIC : u8 = 2;

; Consent codes
pub const CONSENT_MISSING : u8 = 0;
pub const CONSENT_GRANTED : u8 = 1;
pub const CONSENT_DENIED : u8 = 2;

; Admission verdict codes
pub const VERDICT_ALLOWED : u8 = 1;
pub const VERDICT_DENIED : u8 = 8;

; Outcome codes
pub const OUTCOME_SETTLED : u8 = 1;
pub const OUTCOME_STATE : u8 = 2;

; Transition result structure
pub struct TransitionResult {
    next_state: u8,
    emitted: bool,
    committed: bool,
    reason: u8,
    outcome: u8
}

; Episode structure
pub struct Episode {
    id: u64,
    group_id: u64,
    principal: u64,
    owner: u64,
    thread: u64,
    valid_at: u64,
    created_at: u64,
    content_hash: u64,
    plaintext_consent: u8,
    trust_domain: u8,
    attempts: u8,
    state: u8,
    reason: u8
}

; Test episode creator
fn create_test_episode() -> Episode {
    return Episode {
        id: 1,
        group_id: 1,
        principal: 1,
        owner: 1,
        thread: 1,
        valid_at: 1000,
        created_at: 1000,
        content_hash: 0x12345678,
        plaintext_consent: CONSENT_GRANTED,
        trust_domain: DOMAIN_PRIVATE,
        attempts: 1,
        state: STATE_RECEIVED,
        reason: REASON_NONE
    }
}

; Admission gate function
fn admission_gate(episode: Episode) -> (u8, u8) {
    ; Check scope policy
    var may_write = scope::may_write(episode.principal, episode.group_id);
    if (!may_write) {
        return (VERDICT_DENIED, REASON_SCOPE);
    }
    
    ; Check temporal policy
    var known_as_of = temporal::known_as_of(episode.valid_at);
    if (!known_as_of) {
        return (VERDICT_DENIED, REASON_TEMPORAL);
    }
    
    var raw_expired = scope::raw_expired(episode.created_at);
    if (raw_expired) {
        return (VERDICT_DENIED, REASON_TEMPORAL);
    }
    
    ; Check fact well-formedness
    var endpoints_ok = types::fact_endpoints_ok(episode.id, episode.owner, episode.thread);
    if (!endpoints_ok) {
        return (VERDICT_DENIED, REASON_FORMAT);
    }
    
    var well_formed = types::fact_well_formed(episode.id);
    if (!well_formed) {
        return (VERDICT_DENIED, REASON_FORMAT);
    }
    
    return (VERDICT_ALLOWED, REASON_NONE);
}

; Main transition function
fn transition(state: u8, event: u8, verdict: u8, attempts: u8, consent: u8, domain: u8) -> TransitionResult {
    var result = TransitionResult {
        next_state: state,
        emitted: false,
        committed: false,
        reason: REASON_NONE,
        outcome: OUTCOME_STATE
    };
    
    ; Handle absorbing states
    if (state == STATE_COMMITTED || state == STATE_REJECTED) {
        if (event == EVENT_RESULT) {
            result.outcome = OUTCOME_SETTLED;
        } else {
            result.outcome = OUTCOME_STATE;
        }
        return result;
    }
    
    ; Handle unknown states
    if (state != STATE_RECEIVED && state != STATE_ADMITTED && state != STATE_EXTRACTING) {
        result.next_state = STATE_REJECTED;
        result.reason = REASON_STATE;
        result.outcome = OUTCOME_STATE;
        return result;
    }
    
    ; Handle unknown events
    if (event != EVENT_ADMIT && event != EVENT_EMIT && event != EVENT_RESULT && event != EVENT_FAIL && event != EVENT_ABORT) {
        result.next_state = STATE_REJECTED;
        result.reason = REASON_STATE;
        result.outcome = OUTCOME_STATE;
        return result;
    }
    
    ; State machine transitions
    if (state == STATE_RECEIVED) {
        if (event == EVENT_ADMIT) {
            var episode = create_test_episode();
            var admission_result = admission_gate(episode);
            
            if (admission_result.0 == VERDICT_ALLOWED) {
                result.next_state = STATE_ADMITTED;
                result.reason = REASON_NONE;
            } else {
                result.next_state = STATE_REJECTED;
                result.reason = admission_result.1;
            }
        } else if (event == EVENT_ABORT) {
            result.next_state = STATE_REJECTED;
            result.reason = REASON_STATE;
        }
    } else if (state == STATE_ADMITTED) {
        if (event == EVENT_EMIT) {
            ; Re-check admission verdict
            var episode = create_test_episode();
            var admission_result = admission_gate(episode);
            
            if (admission_result.0 == VERDICT_ALLOWED && consent == CONSENT_GRANTED && domain != DOMAIN_UNKNOWN) {
                result.emitted = true;
                result.next_state = STATE_EXTRACTING;
                result.reason = REASON_NONE;
            } else {
                result.next_state = STATE_REJECTED;
                result.reason = REASON_SCOPE;
            }
        } else if (event == EVENT_ABORT) {
            result.next_state = STATE_REJECTED;
            result.reason = REASON_STATE;
        }
    } else if (state == STATE_EXTRACTING) {
        if (event == EVENT_RESULT) {
            result.next_state = STATE_COMMITTED;
            result.committed = true;
            result.reason = REASON_NONE;
        } else if (event == EVENT_FAIL) {
            if (attempts < 3) {
                result.next_state = STATE_RECEIVED;
                result.reason = REASON_EFFECT;
            } else {
                result.next_state = STATE_REJECTED;
                result.reason = REASON_EFFECT;
            }
        } else if (event == EVENT_ABORT) {
            result.next_state = STATE_REJECTED;
            result.reason = REASON_STATE;
        }
    }
    
    return result;
}

; Test functions
fn test_state_machine() -> bool {
    ; Test valid path: RECEIVED -> ADMITTED -> EXTRACTING -> COMMITTED
    var result1 = transition(STATE_RECEIVED, EVENT_ADMIT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result1.next_state == STATE_ADMITTED;
    
    var result2 = transition(STATE_ADMITTED, EVENT_EMIT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result2.next_state == STATE_EXTRACTING;
    assert result2.emitted == true;
    
    var result3 = transition(STATE_EXTRACTING, EVENT_RESULT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result3.next_state == STATE_COMMITTED;
    assert result3.committed == true;
    
    return true;
}

fn test_foreign_scope() -> bool {
    ; Test foreign scope rejection
    var result = transition(STATE_RECEIVED, EVENT_ADMIT, VERDICT_DENIED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result.next_state == STATE_REJECTED;
    assert result.reason == REASON_SCOPE;
    
    return true;
}

fn test_missing_consent() -> bool {
    ; Test missing consent rejection
    var result = transition(STATE_ADMITTED, EVENT_EMIT, VERDICT_ALLOWED, 1, CONSENT_MISSING, DOMAIN_PRIVATE);
    assert result.next_state == STATE_REJECTED;
    assert result.reason == REASON_SCOPE;
    
    return true;
}

fn test_denied_consent() -> bool {
    ; Test denied consent rejection
    var result = transition(STATE_ADMITTED, EVENT_EMIT, VERDICT_ALLOWED, 1, CONSENT_DENIED, DOMAIN_PRIVATE);
    assert result.next_state == STATE_REJECTED;
    assert result.reason == REASON_SCOPE;
    
    return true;
}

fn test_invalid_domain() -> bool {
    ; Test invalid domain rejection
    var result = transition(STATE_ADMITTED, EVENT_EMIT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_UNKNOWN);
    assert result.next_state == STATE_REJECTED;
    assert result.reason == REASON_SCOPE;
    
    return true;
}

fn test_retry_logic() -> bool {
    ; Test retry logic: FAIL with attempts remaining returns to RECEIVED
    var result1 = transition(STATE_EXTRACTING, EVENT_FAIL, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result1.next_state == STATE_RECEIVED;
    assert result1.reason == REASON_EFFECT;
    
    ; Test exhausted attempts: FAIL with no attempts remaining goes to REJECTED
    var result2 = transition(STATE_EXTRACTING, EVENT_FAIL, VERDICT_ALLOWED, 3, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result2.next_state == STATE_REJECTED;
    assert result2.reason == REASON_EFFECT;
    
    return true;
}

fn test_absorbing_states() -> bool {
    ; Test COMMITTED is absorbing
    var result1 = transition(STATE_COMMITTED, EVENT_RESULT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result1.next_state == STATE_COMMITTED;
    assert result1.committed == false; ; No new commit on repeated RESULT
    assert result1.outcome == OUTCOME_SETTLED;
    
    var result2 = transition(STATE_COMMITTED, EVENT_ADMIT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result2.next_state == STATE_COMMITTED;
    assert result2.outcome == OUTCOME_STATE;
    
    ; Test REJECTED is absorbing
    var result3 = transition(STATE_REJECTED, EVENT_RESULT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result3.next_state == STATE_REJECTED;
    assert result3.outcome == OUTCOME_SETTLED;
    
    return true;
}

fn test_unknown_states_events() -> bool {
    ; Test unknown state
    var result1 = transition(99, EVENT_ADMIT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result1.next_state == STATE_REJECTED;
    assert result1.reason == REASON_STATE;
    
    ; Test unknown event
    var result2 = transition(STATE_RECEIVED, 99, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result2.next_state == STATE_REJECTED;
    assert result2.reason == REASON_STATE;
    
    return true;
}

fn test_emit_rechecks_admission() -> bool {
    ; Test EMIT re-checks admission verdict
    var result = transition(STATE_ADMITTED, EVENT_EMIT, VERDICT_DENIED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result.next_state == STATE_REJECTED;
    assert result.reason == REASON_SCOPE;
    
    return true;
}

fn test_effect_fields() -> bool {
    ; Test that emitted effect carries required fields
    var result = transition(STATE_ADMITTED, EVENT_EMIT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result.emitted == true;
    
    ; Non-emitted step carries neither field
    var result2 = transition(STATE_RECEIVED, EVENT_ADMIT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    assert result2.emitted == false;
    
    return true;
}

fn test_exhaustive_checks() -> bool {
    ; Test state machine exhaustively
    var test_states = [STATE_RECEIVED, STATE_ADMITTED, STATE_EXTRACTING, STATE_COMMITTED, STATE_REJECTED, 99, 100];
    var test_events = [EVENT_ADMIT, EVENT_EMIT, EVENT_RESULT, EVENT_FAIL, EVENT_ABORT, 99, 100];
    var effect_emitted = false;
    var episode_committed = false;
    
    for (var i = 0; i < test_states.length; i++) {
        for (var j = 0; j < test_events.length; j++) {
            var state = test_states[i];
            var event = test_events[j];
            
            var result = transition(state, event, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
            
            ; Count effect emissions and commits
            if (result.emitted) {
                assert !effect_emitted; ; Only one should emit effect
                effect_emitted = true;
            }
            
            if (result.committed) {
                assert !episode_committed; ; Only one should commit
                episode_committed = true;
            }
        }
    }
    
    assert effect_emitted;
    assert episode_committed;
    
    return true;
}

fn test_trust_domain_consent_exhaustive() -> bool {
    var test_domains = [DOMAIN_UNKNOWN, DOMAIN_PRIVATE, DOMAIN_PUBLIC, 99, 100];
    var test_consents = [CONSENT_MISSING, CONSENT_GRANTED, CONSENT_DENIED, 99, 100];
    
    for (var i = 0; i < test_domains.length; i++) {
        for (var j = 0; j < test_consents.length; j++) {
            var domain = test_domains[i];
            var consent = test_consents[j];
            
            ; Determine if effect should be emitted
            var should_emit = false;
            if (domain == DOMAIN_PRIVATE && consent == CONSENT_GRANTED) {
                should_emit = true;
            }
            if (domain == DOMAIN_PUBLIC && consent == CONSENT_GRANTED) {
                should_emit = true;
            }
            
            var result = transition(STATE_RECEIVED, EVENT_EMIT, VERDICT_ALLOWED, 1, consent, domain);
            
            ; Test effect emission matches expectation
            if (should_emit) {
                assert result.emitted;
            } else {
                assert !result.emitted;
            }
        }
    }
    
    return true;
}

; Test negative controls - these should fail
fn test_negative_control_wrong_outcome() -> bool {
    ; This test should fail because we expect a different outcome
    var result = transition(STATE_RECEIVED, EVENT_ADMIT, VERDICT_ALLOWED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    ; We expect ADMITTED, but let's assert something wrong to test the negative control
    assert result.next_state == STATE_REJECTED;
    return false;
}

fn test_negative_control_widened_transition() -> bool {
    ; This test should fail because we're allowing a transition that should be rejected
    var result = transition(STATE_RECEIVED, EVENT_EMIT, VERDICT_DENIED, 1, CONSENT_GRANTED, DOMAIN_PRIVATE);
    ; We expect rejection, but let's assert success to test the negative control
    assert result.emitted;
    return false;
}

; Main test runner
fn run_tests() -> bool {
    var success = true
    
    if (!test_state_machine()) {
        success = false
    }
    
    if (!test_foreign_scope()) {
        success = false
    }
    
    if (!test_missing_consent()) {
        success = false
    }
    
    if (!test_denied_consent()) {
        success = false
    }
    
    if (!test_invalid_domain()) {
        success = false
    }
    
    if (!test_retry_logic()) {
        success = false
    }
    
    if (!test_absorbing_states()) {
        success = false
    }
    
    if (!test_unknown_states_events()) {
        success = false
    }
    
    if (!test_emit_rechecks_admission()) {
        success = false
    }
    
    if (!test_effect_fields()) {
        success = false
    }
    
    if (!test_exhaustive_checks()) {
        success = false
    }
    
    if (!test_trust_domain_consent_exhaustive()) {
        success = false
    }
    
    ; Negative controls should fail
    if (test_negative_control_wrong_outcome()) {
        success = false
    }
    
    if (test_negative_control_widened_transition()) {
        success = false
    }
    
    return success
}