// SPDX-License-Identifier: Apache-2.0
// specs/memory/tmem/session.t27 -- durable session/checkpoint record layout and rules for provenance, atomic writes, recovery, and retention
// Versioned serialization, atomic writes, recovery after interruption, stale/invalid records, retention and source/compiler ancestry for Trinity Memory sessions.
// adapts: DNA-style records with extended provenance for durable sessions and checkpoints.
// phi^2 + 1/phi^2 = 3 | TRINITY
module TrinityMemorySession {
    // adapts: magic <- specs/organism/dna.tri::DnaRecord.magic
    // adapts: payload_sha256 <- specs/organism/dna.tri::DnaRecord.payload_sha256
    // adapts: payload_len <- specs/organism/dna.tri::DnaRecord.payload_len
    // adapts: timestamp_epoch <- specs/organism/dna.tri::DnaRecord.timestamp_epoch
    // adapts: sequence <- specs/organism/mozg.tri::MozgState.cycle
    // adapts: spec_hash <- .trinity/seals/tmem_TrinityMemoryTypes.json::spec_hash
    // adapts: compiler_rev <- .trinity/seals/tmem_TrinityMemoryTypes.json::sealed_by
    // adapts: RING_BLOB_MAX_SIZE <- specs/organism/dna.tri::RING_BLOB_MAX_SIZE
    // adapts: TMS_CRC32_* <- specs/memory/tmem/types.t27::TMS_CRC32_*
    // adapts: TMS_ERR_* <- specs/memory/tmem/types.t27::TMS_ERR_*
    // adapts: save/load/listSessions <- src/tri-api/session_store.zig
    // adapts: CheckpointEntry.index/createBeforeWrite/restoreLatest <- src/tri-api/checkpoint.zig
    // adapts: session_id <- new (S08)

    // 1. Record header layout (little-endian, fixed offsets, multiple of 8 bytes)
    pub const TMS_SESSION_MAGIC: u32 = 0x53534D54; // ASCII "TMSS"
    pub const TMS_SESSION_VERSION: u32 = 1;
    pub const TMS_SESSION_KIND_OPEN: u32 = 0;
    pub const TMS_SESSION_KIND_CHECKPOINT: u32 = 1;
    pub const TMS_SESSION_KIND_CLOSE: u32 = 2;
    pub const TMS_SESSION_KIND_COUNT: u32 = 3;
    
    // Field offsets (bytes from start of header)
    pub const TMS_SESSION_MAGIC_OFFSET: u32 = 0;
    pub const TMS_SESSION_VERSION_OFFSET: u32 = 4;
    pub const TMS_SESSION_KIND_OFFSET: u32 = 8;
    pub const TMS_SESSION_SESSION_ID_OFFSET: u32 = 12;
    pub const TMS_SESSION_SEQUENCE_OFFSET: u32 = 28;
    pub const TMS_SESSION_ACTION_COUNT_OFFSET: u32 = 36;
    pub const TMS_SESSION_TIMESTAMP_OFFSET: u32 = 44;
    pub const TMS_SESSION_SPEC_HASH_OFFSET: u32 = 52;
    pub const TMS_SESSION_COMPILER_REV_OFFSET: u32 = 84;
    pub const TMS_SESSION_PARENT_SHA256_OFFSET: u32 = 104;
    pub const TMS_SESSION_PAYLOAD_LEN_OFFSET: u32 = 136;
    pub const TMS_SESSION_PAYLOAD_SHA256_OFFSET: u32 = 140;
    pub const TMS_SESSION_CRC_OFFSET: u32 = 172;
    
    // Field byte lengths
    pub const TMS_SESSION_MAGIC_BYTES: u32 = 4;
    pub const TMS_SESSION_VERSION_BYTES: u32 = 4;
    pub const TMS_SESSION_KIND_BYTES: u32 = 4;
    pub const TMS_SESSION_SESSION_ID_BYTES: u32 = 16;
    pub const TMS_SESSION_SEQUENCE_BYTES: u32 = 8;
    pub const TMS_SESSION_ACTION_COUNT_BYTES: u32 = 8;
    pub const TMS_SESSION_TIMESTAMP_BYTES: u32 = 8;
    pub const TMS_SESSION_SPEC_HASH_BYTES: u32 = 32;
    pub const TMS_SESSION_COMPILER_REV_BYTES: u32 = 20;
    pub const TMS_SESSION_PARENT_SHA256_BYTES: u32 = 32;
    pub const TMS_SESSION_PAYLOAD_LEN_BYTES: u32 = 4;
    pub const TMS_SESSION_PAYLOAD_SHA256_BYTES: u32 = 32;
    pub const TMS_SESSION_CRC_BYTES: u32 = 4;
    
    // Header size and payload limits
    pub const TMS_SESSION_HEADER_BYTES: u32 = 176;
    pub const TMS_SESSION_CRC_COVERED_BYTES: u32 = 172;
    pub const TMS_SESSION_MAX_PAYLOAD_BYTES: u32 = 1048576; // RING_BLOB_MAX_SIZE from dna.tri
    
    // 2. Status codes
    pub const TMS_SESSION_OK: i32 = 0;
    pub const TMS_SESSION_ERR_TRUNCATED: i32 = -1;
    pub const TMS_SESSION_ERR_MAGIC: i32 = -2;
    pub const TMS_SESSION_ERR_VERSION: i32 = -3;
    pub const TMS_SESSION_ERR_KIND: i32 = -4;
    pub const TMS_SESSION_ERR_CRC: i32 = -5;
    pub const TMS_SESSION_ERR_ANCESTRY: i32 = -6;
    pub const TMS_SESSION_ERR_STALE: i32 = -7;
    pub const TMS_SESSION_ERR_CHAIN: i32 = -8;
    pub const TMS_SESSION_ERR_REPLAY: i32 = -9;
    pub const TMS_SESSION_ERR_PAYLOAD: i32 = -10;
    
    // 3. Record state machine for atomic writes
    pub const TMS_SESSION_WRITE_STAGED: u32 = 0;
    pub const TMS_SESSION_WRITE_SYNCED: u32 = 1;
    pub const TMS_SESSION_WRITE_PUBLISHED: u32 = 2;
    pub const TMS_SESSION_WRITE_FAILED: u32 = 3;
    
    // 4. Field classification for privacy and evidence
    pub const TMS_SESSION_FIELD_MAGIC: u32 = 0;
    pub const TMS_SESSION_FIELD_VERSION: u32 = 1;
    pub const TMS_SESSION_FIELD_KIND: u32 = 2;
    pub const TMS_SESSION_FIELD_SESSION_ID: u32 = 3;
    pub const TMS_SESSION_FIELD_SEQUENCE: u32 = 4;
    pub const TMS_SESSION_FIELD_ACTION_COUNT: u32 = 5;
    pub const TMS_SESSION_FIELD_TIMESTAMP: u32 = 6;
    pub const TMS_SESSION_FIELD_SPEC_HASH: u32 = 7;
    pub const TMS_SESSION_FIELD_COMPILER_REV: u32 = 8;
    pub const TMS_SESSION_FIELD_PARENT_SHA256: u32 = 9;
    pub const TMS_SESSION_FIELD_PAYLOAD_LEN: u32 = 10;
    pub const TMS_SESSION_FIELD_PAYLOAD_SHA256: u32 = 11;
    pub const TMS_SESSION_FIELD_PAYLOAD: u32 = 12;
    pub const TMS_SESSION_FIELD_CRC: u32 = 13;
    
    pub const TMS_SESSION_CLASS_PRIVATE: u32 = 0;
    pub const TMS_SESSION_CLASS_EVIDENCE: u32 = 1;
    
    // 5. Retention policy constants
    pub const TMS_SESSION_RETAIN_MIN: u32 = 3;
    pub const TMS_SESSION_RETAIN_DEFAULT: u32 = 27;
    
    // 6. Reference functions
    
    // Header validation with precedence: truncated -> magic -> version -> kind -> CRC
    pub fn tms_session_header_status(length: u64, magic_ok: u32, version: u32, kind: u32, crc_ok: u32) -> i32 {
        if (length < TMS_SESSION_HEADER_BYTES) {
            return TMS_SESSION_ERR_TRUNCATED;
        }
        if (magic_ok == 0) {
            return TMS_SESSION_ERR_MAGIC;
        }
        if (version != TMS_SESSION_VERSION) {
            return TMS_SESSION_ERR_VERSION;
        }
        if (kind >= TMS_SESSION_KIND_COUNT) {
            return TMS_SESSION_ERR_KIND;
        }
        if (crc_ok == 0) {
            return TMS_SESSION_ERR_CRC;
        }
        return TMS_SESSION_OK;
    }
    
    // Ancestry validation: spec hash and compiler revision must match
    pub fn tms_session_ancestry_status(spec_hash_match: u32, compiler_rev_match: u32) -> i32 {
        if (spec_hash_match == 0 || compiler_rev_match == 0) {
            return TMS_SESSION_ERR_ANCESTRY;
        }
        return TMS_SESSION_OK;
    }
    
    // Chain validation: sequence increments by 1, action_count grows by at most 1, parent digest matches
    pub fn tms_session_chain_status(prev_sequence: u64, sequence: u64, prev_action_count: u64, action_count: u64, parent_match: u32) -> i32 {
        if (sequence != prev_sequence + 1) {
            return TMS_SESSION_ERR_STALE;
        }
        if (parent_match == 0) {
            return TMS_SESSION_ERR_CHAIN;
        }
        if (action_count < prev_action_count) {
            return TMS_SESSION_ERR_REPLAY;
        }
        if (action_count > prev_action_count + 1) {
            return TMS_SESSION_ERR_REPLAY;
        }
        return TMS_SESSION_OK;
    }
    
    // Recovery: pick the newest validated record, 0 if none valid
    pub fn tms_session_recover_pick(seq_a: u64, valid_a: u32, seq_b: u64, valid_b: u32) -> u64 {
        if (valid_a != 0 && valid_b != 0) {
            if (seq_a >= seq_b) {
                return seq_a;
            } else {
                return seq_b;
            }
        } else if (valid_a != 0) {
            return seq_a;
        } else if (valid_b != 0) {
            return seq_b;
        } else {
            return 0;
        }
    }
    
    // Write state machine: published only by renaming synced file
    pub fn tms_session_write_next(state: u32, step_ok: u32) -> u32 {
        if (state == TMS_SESSION_WRITE_STAGED) {
            if (step_ok != 0) {
                return TMS_SESSION_WRITE_SYNCED;
            } else {
                return TMS_SESSION_WRITE_FAILED;
            }
        } else if (state == TMS_SESSION_WRITE_SYNCED) {
            if (step_ok != 0) {
                return TMS_SESSION_WRITE_PUBLISHED;
            } else {
                return TMS_SESSION_WRITE_FAILED;
            }
        }
        return state; // No transition from PUBLISHED or FAILED
    }
    
    // Retention policy: OPEN always kept, checkpoints kept if among newest 'retain'
    pub fn tms_session_retain_keep(kind: u32, sequence: u64, newest: u64, retain: u32) -> u32 {
        if (kind == TMS_SESSION_KIND_OPEN) {
            return 1; // OPEN always kept
        }
        if (newest - sequence < retain) {
            return 1; // Among the newest 'retain' checkpoints
        }
        return 0; // Drop older checkpoints
    }
    
    // Field classification: session_id and payload are private, others are evidence
    pub fn tms_session_field_class(field: u32) -> u32 {
        if (field == TMS_SESSION_FIELD_SESSION_ID || field == TMS_SESSION_FIELD_PAYLOAD) {
            return TMS_SESSION_CLASS_PRIVATE;
        }
        return TMS_SESSION_CLASS_EVIDENCE;
    }
    
    // 7. Invariant blocks (must be constant expressions)
    invariant TMS_SESSION_MAGIC_OFFSET == 0;
    invariant TMS_SESSION_VERSION_OFFSET == 4;
    invariant TMS_SESSION_KIND_OFFSET == 8;
    invariant TMS_SESSION_SESSION_ID_OFFSET == 12;
    invariant TMS_SESSION_SEQUENCE_OFFSET == 28;
    invariant TMS_SESSION_ACTION_COUNT_OFFSET == 36;
    invariant TMS_SESSION_TIMESTAMP_OFFSET == 44;
    invariant TMS_SESSION_SPEC_HASH_OFFSET == 52;
    invariant TMS_SESSION_COMPILER_REV_OFFSET == 84;
    invariant TMS_SESSION_PARENT_SHA256_OFFSET == 104;
    invariant TMS_SESSION_PAYLOAD_LEN_OFFSET == 136;
    invariant TMS_SESSION_PAYLOAD_SHA256_OFFSET == 140;
    invariant TMS_SESSION_CRC_OFFSET == 172;
    
    invariant TMS_SESSION_CRC_COVERED_BYTES == 172;
    invariant TMS_SESSION_HEADER_BYTES == 176;
    invariant TMS_SESSION_HEADER_BYTES == 22 * 8; // Multiple of 8 bytes
    invariant TMS_SESSION_MAX_PAYLOAD_BYTES == 1048576;
    
    // 8. Test blocks
    
    test "valid header" {
        var status: i32 = tms_session_header_status(176, 1, 1, 0, 1);
        assert status == TMS_SESSION_OK;
    }
    
    test "truncated header" {
        var status: i32 = tms_session_header_status(100, 1, 1, 0, 1);
        assert status == TMS_SESSION_ERR_TRUNCATED;
    }
    
    test "bad magic" {
        var status: i32 = tms_session_header_status(176, 0, 1, 0, 1);
        assert status == TMS_SESSION_ERR_MAGIC;
    }
    
    test "wrong version" {
        var status: i32 = tms_session_header_status(176, 1, 2, 0, 1);
        assert status == TMS_SESSION_ERR_VERSION;
    }
    
    test "unknown kind" {
        var status: i32 = tms_session_header_status(176, 1, 1, 5, 1);
        assert status == TMS_SESSION_ERR_KIND;
    }
    
    test "CRC mismatch" {
        var status: i32 = tms_session_header_status(176, 1, 1, 0, 0);
        assert status == TMS_SESSION_ERR_CRC;
    }
    
    test "ancestry mismatch" {
        var status: i32 = tms_session_ancestry_status(0, 1);
        assert status == TMS_SESSION_ERR_ANCESTRY;
        var status2: i32 = tms_session_ancestry_status(1, 0);
        assert status2 == TMS_SESSION_ERR_ANCESTRY;
    }
    
    test "chain OK" {
        var status: i32 = tms_session_chain_status(5, 6, 10, 11, 1);
        assert status == TMS_SESSION_OK;
    }
    
    test "stale sequence" {
        var status: i32 = tms_session_chain_status(5, 7, 10, 11, 1);
        assert status == TMS_SESSION_ERR_STALE;
    }
    
    test "parent mismatch" {
        var status: i32 = tms_session_chain_status(5, 6, 10, 11, 0);
        assert status == TMS_SESSION_ERR_CHAIN;
    }
    
    test "replay action count" {
        var status: i32 = tms_session_chain_status(5, 6, 10, 13, 1);
        assert status == TMS_SESSION_ERR_REPLAY;
        var status2: i32 = tms_session_chain_status(5, 6, 10, 9, 1);
        assert status2 == TMS_SESSION_ERR_REPLAY;
    }
    
    test "recover pick newest" {
        var result: u64 = tms_session_recover_pick(6, 1, 5, 1);
        assert result == 6;
    }
    
    test "recover pick only valid" {
        var result: u64 = tms_session_recover_pick(0, 0, 5, 1);
        assert result == 5;
        var result2: u64 = tms_session_recover_pick(6, 1, 0, 0);
        assert result2 == 6;
    }
    
    test "recover none valid" {
        var result: u64 = tms_session_recover_pick(0, 0, 0, 0);
        assert result == 0;
    }
    
    test "write state progression" {
        var state: u32 = tms_session_write_next(TMS_SESSION_WRITE_STAGED, 1);
        assert state == TMS_SESSION_WRITE_SYNCED;
        var state2: u32 = tms_session_write_next(TMS_SESSION_WRITE_SYNCED, 1);
        assert state2 == TMS_SESSION_WRITE_PUBLISHED;
    }
    
    test "write state failure" {
        var state: u32 = tms_session_write_next(TMS_SESSION_WRITE_STAGED, 0);
        assert state == TMS_SESSION_WRITE_FAILED;
    }
    
    test "retain open always" {
        var keep: u32 = tms_session_retain_keep(TMS_SESSION_KIND_OPEN, 0, 10, 5);
        assert keep == 1;
    }
    
    test "retain recent checkpoint" {
        var keep: u32 = tms_session_retain_keep(TMS_SESSION_KIND_CHECKPOINT, 5, 10, 5);
        assert keep == 1;
    }
    
    test "retain old checkpoint" {
        var keep: u32 = tms_session_retain_keep(TMS_SESSION_KIND_CHECKPOINT, 2, 10, 5);
        assert keep == 0;
    }
    
    test "field classification private" {
        var class: u32 = tms_session_field_class(TMS_SESSION_FIELD_SESSION_ID);
        assert class == TMS_SESSION_CLASS_PRIVATE;
        var class2: u32 = tms_session_field_class(TMS_SESSION_FIELD_PAYLOAD);
        assert class2 == TMS_SESSION_CLASS_PRIVATE;
    }
    
    test "field classification evidence" {
        var class: u32 = tms_session_field_class(TMS_SESSION_FIELD_MAGIC);
        assert class == TMS_SESSION_CLASS_EVIDENCE;
        var class2: u32 = tms_session_field_class(TMS_SESSION_FIELD_SEQUENCE);
        assert class2 == TMS_SESSION_CLASS_EVIDENCE;
        var class3: u32 = tms_session_field_class(TMS_SESSION_FIELD_CRC);
        assert class3 == TMS_SESSION_CLASS_EVIDENCE;
    }
}