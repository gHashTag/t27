; phi^2 + 1/phi^2 = 3 | TRINITY

module system_unified_agent_operations;

pub const KIND : str = "system";
pub const ID : str = "system/unified-agent-operations";
pub const VERSION : str = "v1";
pub const TITLE : str = "Unified Agent Operations - Trinity System Architecture";
pub const SUMMARY_EN : str = "Comprehensive specification of Trinity repositories architecture, contracts between parts, gates for changes, and budgets for runs";

// Four layers of the Trinity system architecture
pub const LAYERS : [4]str = [
    "application-layer",    // User-facing interfaces and applications
    "control-layer",        // Queen, Bees, Inngest orchestration and scheduling
    "runtime-layer",        // Edge compute, VM execution, and runtime services
    "infrastructure-layer"  // Hardware, silicon, and foundational infrastructure
];

// Subsystems within each layer
pub const SUBSYSTEMS : [12]str = [
    "skills",              // Application layer: Skill definitions and execution
    "crons",               // Control layer: Scheduled operations and automation
    "agents",              // Control layer: Autonomous agents and decision-making
    "tools",               // Control layer: Tool registry and capability management
    "runtime",             // Runtime layer: VM instances and execution environments
    "memory",              // Runtime layer: Data storage and retrieval systems
    "network",             // Runtime layer: Communication and transport protocols
    "compute",             // Runtime layer: Resource allocation and scheduling
    "hardware",            // Infrastructure layer: Physical devices and silicon
    "storage",             // Infrastructure layer: Persistent data storage
    "security",            // Infrastructure layer: Authentication and authorization
    "monitoring"           // Infrastructure layer: Observability and health monitoring
];

// Required fields for cron cards (based on existing cron specifications)
pub const CRON_CARD_REQUIRED_FIELDS : [9]str = [
    "KIND",                // Always "cron"
    "ID",                  // Unique identifier: "host/repo/name"
    "NAME",                // Display name for the cron job
    "HOST",                // Hosting platform (e.g., "inngest")
    "REPO",                // Repository name
    "SCHEDULE",            // Cron schedule expression
    "TZ",                  // Timezone for schedule execution
    "ENABLED",             // Whether the cron is active
    "CONTROL"             // Control system identifier
];

// HITL (Human-in-the-Loop) model configuration
pub const HITL_MODEL : str = "staged-review";
pub const HITL_THRESHOLDS : [3]u16 = [25, 50, 75];  // Confidence thresholds for human intervention
pub const HITL_ESCALATION : u16 = 30;               // Minutes before automatic escalation

// Budget limits for system operations
pub const BUDGETS : [6]u16 = [
    15,   // Skills: Maximum execution time in minutes
    5,    // Crons: Maximum execution time in minutes  
    120,  // Training: Maximum time in minutes
    256,  // Memory: Maximum MB per operation
    1024, // Storage: Maximum MB per dataset
    24    // Monitoring: Hours of data retention
];

// Secret rules and security constraints
pub const SECRET_RULES : [5]str = [
    "no-plaintext-credentials",  // Credentials must be encrypted at rest
    "zero-trust-communications", // All communications require authentication
    "immutable-audit-logs",     // Audit logs cannot be modified after creation
    "encrypted-backups",        // All backups must be encrypted
    "regular-rotation"           // Secrets and keys must be rotated quarterly
];

