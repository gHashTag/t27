; specs/trinity/capabilities/test.brain.t27 -- capability trinity/test.brain: The brain-region unit, integration and stress tests and the five steps that run them
; One card of the Trinity project manifest (specs/trinity/README.md, gHashTag/t27#3563 = S01 of
; gHashTag/trinity#988). tools/trinity_manifest.py check holds every card to the inventory of the
; consumer tree that specs/trinity/project.t27 pins: the targets it owns exist in build.zig and belong
; to no other card, the paths it names are tracked, the dialect matches the spec it cites and a
; measured claim names its command and its source. The consumer vendors a byte-identical copy and
; generates its manifest from these files (S12). ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_capability_test_brain;

pub const KIND : str = "capability";
pub const ID : str = "trinity/test.brain";
pub const TITLE : str = "The brain-region unit, integration and stress tests and the five steps that run them (test-basal-ganglia, test-reticular-formation, test-locus-coeruleus, test-brain, test-brain-stress)";
; Who owns the implementation this card describes.
pub const OWNER_REPO : str = "gHashTag/trinity";
; executable | declared | adapter | external | deprecated | out-of-scope | research | catalog-only
pub const DISPOSITION : str = "executable";
; headless | web | native | fpga | training | network | research; a target installed by
; zig build -Dci=true is headless, a target guarded by !ci_mode is not.
pub const PROFILE : str = "headless";
; The canonical spec: a path in this repository, trinity:<path> for a spec authored in the
; consumer, <repo>:<path> elsewhere, "" while none exists. Never a mirrored copy.
pub const CANONICAL_SPEC : str = "";
pub const DIALECT : str = "none";
; Implementation and generated paths of the pinned tree (trinity: prefix), checked to exist.
pub const IMPLEMENTATION : [2]str = ["trinity:build.zig", "trinity:src/brain"];
pub const GENERATED : [0]str = [];
; zig | c | rust | verilog | wasm | ts | swift | python | none; only executable, adapter and research cards claim one.
pub const BACKEND : str = "zig";
; build.zig targets this card owns: exe:<name>, lib:<name>, test:<root path>, step:<name>; patterns allowed.
pub const TARGETS : [6]str = ["step:test-basal-ganglia", "step:test-reticular-formation", "step:test-locus-coeruleus", "step:test-brain", "step:test-brain-stress", "test:src/brain/*"];
; The command whose success is the acceptance of this capability; "" when nothing is claimed.
pub const ACCEPTANCE : str = "zig build test-basal-ganglia test-reticular-formation test-locus-coeruleus test-brain test-brain-stress -Dci=true";
; measured | declared | specified | external | not-claimed, as docs/system/project.md defines them.
pub const EVIDENCE : str = "measured";
pub const EVIDENCE_SOURCE : str = "https://github.com/gHashTag/trinity/actions/runs/37184075728 -- S3AI Brain CI on push at 291ac8b24, the pinned revision, on ubuntu-latest with zig 0.15.2: each of the five steps ran as its own zig build <step> -Dci=true --summary all and ended with exit 0 and every test passed (basal-ganglia 51/51, reticular-formation 48/48, locus-coeruleus 52/52, test-brain 151/151 over two test binaries, test-brain-stress 261/261). The single command above, with all five steps at once, was not run.";
; The work package of gHashTag/trinity#988 that owns this capability's contract.
pub const WORK_PACKAGE : str = "S03";
pub const NOTE : str = "gHashTag/trinity#517 deleted these steps from build.zig while brain-ci.yml kept calling them; gHashTag/trinity#1333 restores the ones that compile. They reach 6 of the 43 files of src/brain that build.zig did not reach at 976df517; the other 37 stay with research.unreferenced-sources.";
pub const ENABLED : bool = true;

test card_is_bound_to_its_package {
    assert KIND == "capability";
    assert ID == "trinity/test.brain";
    assert WORK_PACKAGE == "S03";
    assert ENABLED == true;
}
