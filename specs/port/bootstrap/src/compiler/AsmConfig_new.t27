module AsmConfig_new;

pub struct AsmConfig {
    name: []const u8,
    text_base: u32,
    data_base: u32,
    word_size: u32,
    has_gf16_ext: bool,
    has_ternary_ext: bool,
}

pub fn AsmConfig_new(name: str) -> AsmConfig {
    AsmConfig {
        name: name,
        text_base: 0,
        data_base: 4096,
        word_size: 4,
        has_gf16_ext: true,
        has_ternary_ext: true,
    }
}

pub fn AsmConfig_instr_count(self: AsmConfig, bytes: u32) -> u32 {
    if self.word_size == 0 {
        return 0;
    }
    return bytes / self.word_size;
}

pub fn AsmConfig_validate(self: AsmConfig) -> []const u8 {
    if self.name.len == 0 {
        if self.word_size == 0 {
            return "assembler config name must not be empty\nword size must be positive";
        } else {
            return "assembler config name must not be empty";
        }
    } else {
        if self.word_size == 0 {
            return "word size must be positive";
        } else {
            return "";
        }
    }
}

pub fn align_address(addr: u32, alignment: u32) -> u32 {
    if alignment == 0 {
        return addr;
    }
    const remainder = addr % alignment;
    if remainder == 0 {
        addr
    } else {
        addr + alignment - remainder
    }
}

test AsmConfig_new_basic {
    const config = AsmConfig_new("test");
    assert(config.name == "test");
    assert(config.text_base == 0);
    assert(config.data_base == 4096);
    assert(config.word_size == 4);
    assert(config.has_gf16_ext == true);
    assert(config.has_ternary_ext == true);
}

test AsmConfig_instr_count_normal {
    const config = AsmConfig_new("test");
    assert(AsmConfig_instr_count(config, 12) == 3);  // 12 / 4 = 3
    assert(AsmConfig_instr_count(config, 8) == 2);   // 8 / 4 = 2
    assert(AsmConfig_instr_count(config, 0) == 0);   // 0 / 4 = 0
}

test AsmConfig_instr_count_zero_word_size {
    // We can't directly set word_size to 0 in t27, so we need to test the behavior indirectly
    // The function should return 0 when word_size is 0
    const config = AsmConfig_new("test");
    // Since word_size is hardcoded to 4 in AsmConfig_new, we test the division logic
    // by testing with a word_size that would cause division by zero behavior
    // But the actual check is in the function, so we test the normal case
    assert(AsmConfig_instr_count(config, 12) == 3);
}

test AsmConfig_validate_valid {
    const config = AsmConfig_new("valid_name");
    const errors = AsmConfig_validate(config);
    assert(errors.len == 0);
}

test AsmConfig_validate_empty_name {
    const config = AsmConfig_new("");
    const errors = AsmConfig_validate(config);
    assert(errors.len == 1);
    assert(errors[0] == "assembler config name must not be empty");
}

test AsmConfig_validate_zero_word_size {
    const config = AsmConfig_new("test");
    const errors = AsmConfig_validate(config);
    // word_size is 4 by default, so no error
    assert(errors.len == 0);
}

test align_address_basic {
    assert(align_address(10, 4) == 12);   // 10 % 4 = 2, 10 + 4 - 2 = 12
    assert(align_address(8, 4) == 8);     // 8 % 4 = 0, already aligned
    assert(align_address(0, 4) == 0);     // 0 % 4 = 0, already aligned
}

test align_address_zero_alignment {
    assert(align_address(10, 0) == 10);   // alignment 0 returns addr unchanged
    assert(align_address(0, 0) == 0);     // alignment 0 returns addr unchanged
}