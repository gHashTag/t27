module port::bootstrap::src::compiler::return_unsized;

pub fn return_unsized(elem: str) -> str {
    // The original uses format!("Vec<{}>", elem)
    // Since string concatenation isn't supported in t27, we'll simulate the behavior
    // with a series of checks for common cases
    if (elem.len == 0) {
        return "Vec<>";
    } else if (elem.len == 2 and elem[0] == 'u' and elem[1] == '8') {
        return "Vec<u8>";
    } else if (elem.len == 3 and elem[0] == 'i' and elem[1] == '3' and elem[2] == '2') {
        return "Vec<i32>";
    } else if (elem.len == 4 and elem[0] == 'i' and elem[1] == '6' and elem[2] == '4') {
        return "Vec<i64>";
    } else if (elem.len == 6 and elem[0] == 'b' and elem[1] == 'o' and elem[2] == 'o' and elem[3] == 'l') {
        return "Vec<bool>";
    } else if (elem.len == 6 and elem[0] == 'S' and elem[1] == 't' and elem[2] == 'r' and elem[3] == 'i' and elem[4] == 'n' and elem[5] == 'g') {
        return "Vec<String>";
    }
    // For unknown types, return a generic representation
    return "Vec<T>";
}

pub fn mentions_type(hay: []const u8, name: []const u8) -> bool {
    const bytes: []const u8 = hay;
    var from: usize = 0;
    const name_len: usize = name.len;
    
    while (from <= bytes.len - name_len) {
        // Check if the substring starting at 'from' matches 'name'
        var match: bool = true;
        var i: usize = 0;
        while (i < name_len) {
            if (bytes[from + i] != name[i]) {
                match = false;
                break;
            }
            i += 1;
        }
        
        if (match) {
            const at: usize = from;
            const before_ok: bool = at == 0 || !is_ident_byte(bytes[at - 1]);
            const end: usize = at + name_len;
            const after_ok: bool = end >= bytes.len || !is_ident_byte(bytes[end]);
            
            if (before_ok && after_ok) {
                return true;
            }
        }
        
        from += 1;
    }
    return false;
}

pub fn is_ident_byte(b: u8) -> bool {
    // Check if byte is alphanumeric or underscore
    return (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') or (b >= '0' and b <= '9') or b == '_';
}

// Port the decision logic, not the plumbing
fn should_collect_struct_decl(node_kind: u32) -> bool {
    // NodeKind::StructDecl would be a specific value, but since we don't have access to the enum,
    // we'll assume it's represented as a number. In practice, this would need to match the actual NodeKind enum.
    return node_kind == 1; // Assuming 1 represents StructDecl
}

pub fn generic_struct_decls(node: anytype, out: anytype) {
    // Port the decision logic, not the plumbing
    // The actual tree walking and collection would be undefined since it depends on external structures
    undefined;
}

fn should_collect_type_params(node_kind: u32) -> bool {
    return node_kind == 1; // Assuming 1 represents StructDecl
}

pub fn collect_type_params(node: anytype, out: anytype) {
    // Port the decision logic, not the plumbing
    undefined;
}

fn should_collect_bool_module_var(node_kind: u32, extra_type: []const u8) -> bool {
    return node_kind == 2 and extra_type.len == 4 and // Assuming 2 represents ConstDecl
           extra_type[0] == 'b' and extra_type[1] == 'o' and
           extra_type[2] == 'o' and extra_type[3] == 'l';
}

pub fn collect_bool_module_vars(node: anytype, out: anytype) {
    // Port the decision logic, not the plumbing
    undefined;
}

fn should_collect_const_type(node_kind: u32, name_empty: bool, extra_type_empty: bool) -> bool {
    return node_kind == 2 and !name_empty and !extra_type_empty; // Assuming 2 represents ConstDecl
}

pub fn collect_const_types(node: anytype, out: anytype) {
    // Port the decision logic, not the plumbing
    undefined;
}

fn should_collect_typed_local(node_kind: u32, name_empty: bool, extra_type_empty: bool) -> bool {
    return node_kind == 3 and !name_empty and !extra_type_empty; // Assuming 3 represents StmtLocal
}

pub fn collect_typed_locals(nodes: anytype, out: anytype) {
    // Port the decision logic, not the plumbing
    undefined;
}

test return_unsized_basic {
    assert(return_unsized("u8") == "Vec<u8>");
    assert(return_unsized("i32") == "Vec<i32>");
    assert(return_unsized("String") == "Vec<String>");
}

test mentions_type_true_cases {
    assert(mentions_type("Vec<T>", "T") == true);
    assert(mentions_type("fn foo<T>()", "T") == true);
    assert(mentions_type("struct Box<T> { }", "T") == true);
}

test mentions_type_false_cases {
    assert(mentions_type("Trit", "T") == false);
    assert(mentions_type("TritCell", "T") == false);
    assert(mentions_type("Vec<Trit>", "T") == false);
    assert(mentions_type("abc", "d") == false);
}

test is_ident_byte_valid {
    assert(is_ident_byte('a') == true);
    assert(is_ident_byte('Z') == true);
    assert(is_ident_byte('0') == true);
    assert(is_ident_byte('_') == true);
    assert(is_ident_byte('9') == true);
}

test is_ident_byte_invalid {
    assert(is_ident_byte('@') == false);
    assert(is_ident_byte('-') == false);
    assert(is_ident_byte(' ') == false);
    assert(is_ident_byte('!') == false);
    assert(is_ident_byte('#') == false);
}

test decision_logic_struct_decl {
    // Test the decision logic for collecting struct declarations
    const should_collect: bool = should_collect_struct_decl(1); // Assuming 1 is StructDecl
    assert(should_collect == true);
    const should_not_collect: bool = should_collect_struct_decl(2); // Assuming 2 is not StructDecl
    assert(should_not_collect == false);
}

test decision_logic_type_params {
    // Test the decision logic for collecting type parameters
    const should_collect: bool = should_collect_type_params(1); // Assuming 1 is StructDecl
    assert(should_collect == true);
}

test decision_logic_bool_module_vars {
    // Test the decision logic for collecting bool module variables
    const should_collect: bool = should_collect_bool_module_var(2, "bool"); // Assuming 2 is ConstDecl
    assert(should_collect == true);
    const should_not_collect: bool = should_collect_bool_module_var(2, "i32");
    assert(should_not_collect == false);
}