// Rust lines 29689-29691: a zero depth is the fixed "formal config depth must
// be positive" error, on its own.
test HirFormalConfig_validate_flags_zero_depth {
    const config: HirFormalConfig = HirFormalConfig_new("name", "module", "clk", "rst");
    const broken: HirFormalConfig = HirFormalConfig_with_depth(config, 0);
    const verdict: HirFormalConfigVerdict = HirFormalConfig_validate(broken);
    assert(verdict.error_count == 1);
    assert(!verdict.name_error);
    assert(!verdict.module_name_error);
    assert(!verdict.clock_error);
    assert(verdict.depth_error);
    assert(!verdict.timeout_error);
}

