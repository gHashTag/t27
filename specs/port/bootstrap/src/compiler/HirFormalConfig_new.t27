// Rust lines 29679-29695: every check fires at once - five entries, name
// first, timeout_cycles last.
test HirFormalConfig_validate_flags_all_five {
    const config: HirFormalConfig = HirFormalConfig_new("", "", "", "");
    const broken: HirFormalConfig = HirFormalConfig_with_depth(HirFormalConfig_with_timeout(config, 0), 0);
    const verdict: HirFormalConfigVerdict = HirFormalConfig_validate(broken);
    assert(verdict.error_count == 5);
    assert(verdict.name_error);
    assert(verdict.module_name_error);
    assert(verdict.clock_error);
    assert(verdict.depth_error);
    assert(verdict.timeout_error);
}

// Rust lines 29701-29713: every input lands in its field, the kind is
// Immediate, and an immediate assertion has no clock or reset.
test HirFormalAssert_immediate_sets_all_fields {
    const formal: HirFormalAssert = HirFormalAssert_immediate("fifo_no_overflow", "count < depth", HwAssertSeverity::Error, "the FIFO never overflows");
    assert(formal.name == "fifo_no_overflow");
    assert(formal.kind == HwAssertKind::Immediate);
    assert(formal.severity == HwAssertSeverity::Error);
    assert(formal.condition == "count < depth");
    assert(formal.clock == "");
    assert(formal.reset == "");
    assert(formal.description == "the FIFO never overflows");
}

// Rust lines 29718-29731: every input lands in its field, the kind is
// Concurrent, and the severity defaults to Error.
test HirFormalAssert_concurrent_sets_all_fields {
    const formal: HirFormalAssert = HirFormalAssert_concurrent("req_grants", "req |-> gnt", "clk", "rst_n", "a request grants within one cycle");
    assert(formal.name == "req_grants");
    assert(formal.kind == HwAssertKind::Concurrent);
    assert(formal.severity == HwAssertSeverity::Error);
    assert(formal.condition == "req |-> gnt");
    assert(formal.clock == "clk");
    assert(formal.reset == "rst_n");
    assert(formal.description == "a request grants within one cycle");
}

