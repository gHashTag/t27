module port::bootstrap::src::compiler::AsmRelocEntry_new;

pub enum AsmSectionKind {
    Text,
    Data,
    Bss,
    Rodata,
}

pub enum AsmRelocKind {
    Abs32,
    Rel21,
    Gf16Label,
}

pub struct AsmRelocEntry {
    pub offset: u32,
    pub kind: AsmRelocKind,
    pub symbol: str,
    pub addend: u32,
}

pub struct AsmSymbol {
    pub name: str,
    pub address: u32,
    pub size: u32,
    pub section: AsmSectionKind,
    pub is_global: bool,
}

pub struct AsmSection {
    pub name: str,
    pub kind: AsmSectionKind,
    pub base_address: u32,
    pub size: u32,
}

pub fn AsmRelocEntry_new(offset: u32, kind: AsmRelocKind, symbol: str, addend: u32) -> AsmRelocEntry {
    return AsmRelocEntry {
        offset: offset,
        kind: kind,
        symbol: symbol,
        addend: addend,
    };
}

pub fn AsmSymbol_new(name: str, address: u32, section: AsmSectionKind, is_global: bool) -> AsmSymbol {
    return AsmSymbol {
        name: name,
        address: address,
        size: 0,
        section: section,
        is_global: is_global,
    };
}

pub fn AsmSymbol_validate(self: AsmSymbol) -> []str {
    if self.name.len == 0 {
        return "symbol name must not be empty";
    }
    return "";
}

pub fn AsmSection_text(base: u32) -> AsmSection {
    return AsmSection {
        name: ".text",
        kind: AsmSectionKind::Text,
        base_address: base,
        size: 0,
    };
}

pub fn AsmSection_data(base: u32) -> AsmSection {
    return AsmSection {
        name: ".data",
        kind: AsmSectionKind::Data,
        base_address: base,
        size: 0,
    };
}

pub fn AsmSection_bss(base: u32) -> AsmSection {
    return AsmSection {
        name: ".bss",
        kind: AsmSectionKind::Bss,
        base_address: base,
        size: 0,
    };
}

pub fn AsmSection_rodata(base: u32) -> AsmSection {
    return AsmSection {
        name: ".rodata",
        kind: AsmSectionKind::Rodata,
        base_address: base,
        size: 0,
    };
}

pub fn AsmSection_end(self: AsmSection) -> u32 {
    return self.base_address + self.size
}

test AsmRelocEntry_new_basic {
    const entry = AsmRelocEntry_new(100, AsmRelocKind::Abs32, "main", 0);
    assert(entry.offset == 100);
    assert(entry.kind == AsmRelocKind::Abs32);
    assert(entry.symbol == "main");
    assert(entry.addend == 0);
}

test AsmRelocEntry_new_with_addend {
    const entry = AsmRelocEntry_new(200, AsmRelocKind::Rel21, "func", 4);
    assert(entry.offset == 200);
    assert(entry.kind == AsmRelocKind::Rel21);
    assert(entry.symbol == "func");
    assert(entry.addend == 4);
}

test AsmSymbol_new_basic {
    const symbol = AsmSymbol_new("test_symbol", 0x1000, AsmSectionKind::Text, false);
    assert(symbol.name == "test_symbol");
    assert(symbol.address == 0x1000);
    assert(symbol.size == 0);
    assert(symbol.section == AsmSectionKind::Text);
    assert(symbol.is_global == false);
}

test AsmSymbol_new_global {
    const symbol = AsmSymbol_new("global_var", 0x2000, AsmSectionKind::Data, true);
    assert(symbol.name == "global_var");
    assert(symbol.address == 0x2000);
    assert(symbol.size == 0);
    assert(symbol.section == AsmSectionKind::Data);
    assert(symbol.is_global == true);
}

test AsmSymbol_validate_valid {
    const symbol = AsmSymbol_new("valid_symbol", 0x1000, AsmSectionKind::Text, false);
    const errors = AsmSymbol_validate(symbol);
    assert(errors.len == 0);
}

test AsmSymbol_validate_empty_name {
    const symbol = AsmSymbol_new("", 0x1000, AsmSectionKind::Text, false);
    const errors = AsmSymbol_validate(symbol);
    assert(errors.len == 1);
    assert(errors[0] == "symbol name must not be empty");
}

test AsmSection_text_creation {
    const section = AsmSection_text(0x1000);
    assert(section.name == ".text");
    assert(section.kind == AsmSectionKind::Text);
    assert(section.base_address == 0x1000);
    assert(section.size == 0);
}

test AsmSection_end_calculation {
    const section = AsmSection {
        name: ".data",
        kind: AsmSectionKind::Data,
        base_address: 0x1000,
        size: 0x100,
    };
    const end = AsmSection_end(section);
    assert(end == 0x1100);
}

test AsmSection_end_zero_size {
    const section = AsmSection {
        name: ".bss",
        kind: AsmSectionKind::Bss,
        base_address: 0x2000,
        size: 0,
    };
    const end = AsmSection_end(section);
    assert(end == 0x2000);
}