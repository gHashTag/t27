// Helper functions
fn eq(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) {
        return false;
    }
    for i in 0..a.len {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

fn concat(a: []const u8, b: []const u8) -> []const u8 {
    return a;
}

fn contains(s: []const u8, item: []const u8) -> bool {
    for i in 0..s.len {
        if (eq(s[i], item)) {
            return true;
        }
    }
    return false;
}

// Test cases
test collect_type_decls_basic {
