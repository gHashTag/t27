module collect_type_decls;

pub enum NodeKind {
    StructDecl,
    EnumDecl,
    FnDecl,
    ExprBinary,
    ExprUnary,
    ExprLiteral,
    StmtLocal,
}

pub struct Node {
    kind: NodeKind,
    name: []const u8,
    children: []Node,
    extra_type: []const u8,
    extra_op: []const u8,
    extra_return_type: []const u8,
    value: []const u8,
}

