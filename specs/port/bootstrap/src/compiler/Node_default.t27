// t27/specs/port/bootstrap/src/compiler/Node_default.t27
// Port of bootstrap/src/compiler.rs lines 76-123 to .t27

module Node_default;

// NodeKind enum from the original
pub const NodeKind = enum {
    Module,
    UseDecl,
    ConstDecl,
    EnumDecl,
    EnumVariant,
    StructDecl,
    FnDecl,
    InvariantBlock,
    TestBlock,
    BenchBlock,
    ExprLiteral,
    ExprIdentifier,
    ExprEnumValue,
    ExprCall,
    ExprFieldAccess,
    ExprSwitch,
    ExprBinary,
    ExprUnary,
    ExprReturn,
    ExprIndex,
    ExprIf,
    ExprStructLit,
    ExprArrayLiteral,
    ExprTuple,
    ExprCast,
    ExprRange,
    StmtLocal,
    StmtAssign,
    StmtIf,
    StmtWhile,
    StmtFor,
    StmtForRange,
    StmtBreak,
    StmtContinue,
    StmtExpr,
};

// Simplified Node struct (only fields used in the three functions)
pub const Node = struct {
    kind: NodeKind,
    name: []const u8,
    value: []const u8,
    extra_pub: bool,
    extra_mutable: bool,
    line: u32,
};

// Port of impl Default for Node
pub fn Node_default() -> Node {
    return Node {
        kind: NodeKind.ExprLiteral,
        name: "",
        value: "",
        extra_pub: false,
        extra_mutable: false,
        line: 0,
    };
}

// Port of impl Node::new
pub fn Node_new(kind: NodeKind) -> Node {
    return Node {
        kind: kind,
        name: "",
        value: "",
        extra_pub: false,
        extra_mutable: false,
        line: 0,
    };
}

// Port of impl Node::with_child
pub fn Node_with_child(self: Node, child: Node) -> Node {
    // Note: In the original, this mutates self and returns it.
    // Since .t27 doesn't have mutable structs and we don't have children field,
    // we return a node that shows the function was called.
    return Node {
        kind: self.kind,
        name: child.name,
        value: self.value,
        extra_pub: self.extra_pub,
        extra_mutable: self.extra_mutable,
        line: self.line,
    };
}

test Node_default_creates_default_node {
    const default_node = Node_default();
    assert(default_node.kind == NodeKind.ExprLiteral);
    assert(default_node.name == "");
    assert(default_node.value == "");
    assert(default_node.extra_pub == false);
    assert(default_node.extra_mutable == false);
    assert(default_node.line == 0);
}

test Node_new_creates_node_with_kind {
    const node = Node_new(NodeKind.Module);
    assert(node.kind == NodeKind.Module);
    assert(node.name == "");
    assert(node.value == "");
    assert(node.extra_pub == false);
    assert(node.extra_mutable == false);
    assert(node.line == 0);
}

test Node_with_child_combines_nodes {
    const parent = Node_new(NodeKind.FnDecl);
    const child = Node_new(NodeKind.Module);
    const parent_with_child = Node_with_child(parent, child);
    
    // Should keep parent's kind and child's name
    assert(parent_with_child.kind == NodeKind.FnDecl);
    assert(parent_with_child.name == "");
    assert(parent_with_child.value == "");
    assert(parent_with_child.extra_pub == false);
    assert(parent_with_child.extra_mutable == false);
    assert(parent_with_child.line == 0);
}