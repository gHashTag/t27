//! BitNet HLS interrupt-controller emitter (Wave 36f, R-BN-6).
//!
//! Exposes a single emitter:
//!
//!   * `interrupt_controller` -- async completion signalling for the
//!     host CPU. Three interrupt sources (inference_done, dma_done,
//!     error) latch into a 3-bit sticky `irq_status` register. The
//!     final `irq_out` is the logical OR of `irq_status & irq_enable`.
//!     `status_read` clears the latch (read-to-clear semantics) so the
//!     host can acknowledge the IRQ from inside the ISR.
//!
//!     The clear and the three sources are one non-blocking assignment:
//!     the read-to-clear is applied to the *previous* value and this
//!     cycle's sources are ORed on top. Emitting them as four separate
//!     non-blocking assignments in the same `always` block resolves
//!     last-write-wins, which discards any event arriving in the same
//!     cycle as `status_read` -- a lost interrupt on every reachable
//!     state, not just an occasional race (see #1967).
//!
//! Port summary:
//!
//! | Group              | Signals                                     |
//! |--------------------|---------------------------------------------|
//! | Clock / reset      | clk, rst_n                                  |
//! | Interrupt sources  | inference_done, dma_done, error             |
//! | Mask               | irq_enable[2:0]                             |
//! | Status (RW1C-ish)  | irq_status[2:0], status_read                |
//! | Output             | irq_out                                     |
//!
//! Algorithm ported from `gHashTag/vibee-lang`
//! `src/vibeec/verilog_codegen.zig` lines 1550-1590
//! (`writeInterruptController`). Original author: Dmitrii Vasilev.
//!
//! Constitutional notes:
//!   L2: lives only under `bootstrap/`; emitter is a pure additive
//!       string builder; no edits under `gen/`, `coq/`, `trios-coq/`,
//!       `proofs/`, `specs/`, `conformance/`, `architecture/`,
//!       `rings/`, or root `Cargo.toml`.
//!   L3: ASCII source, English doc-comments only.
//!   L5: numeric kernel untouched -- this emitter is a control-plane
//!       signal aggregator; it does not redefine any constant inside
//!       the trinity invariant `phi^2 + 1/phi^2 = 3`.
//!   L7: no `*.sh` invoked.

/// Default identifier for the interrupt-controller module.
pub const DEFAULT_INTERRUPT_CONTROLLER_NAME: []const u8 = "interrupt_controller";

pub fn is_valid_verilog_ident(s: []const u8) -> bool {
    if (s.len == 0) {
        return false;
    }
    
    const first_char = s[0];
    if (!(first_char >= 'a' and first_char <= 'z') and 
        !(first_char >= 'A' and first_char <= 'Z') and 
        first_char != '_') {
        return false;
    }
    
    var i: usize = 1;
    while (i < s.len) {
        const c = s[i];
        if (!(c >= 'a' and c <= 'z') and 
            !(c >= 'A' and c <= 'Z') and 
            !(c >= '0' and c <= '9') and 
            c != '_') {
            return false;
        }
        i += 1;
    }
    
    return true;
}

pub fn resolve_ident(candidate: []const u8, default: []const u8) -> []const u8 {
    if (is_valid_verilog_ident(candidate)) {
        return candidate;
    } else {
        return default;
    }
}

/// Build the `interrupt_controller` SystemVerilog module text.
///
/// Parameters:
///   * `module_name` -- Verilog identifier; falls back to
///     `interrupt_controller` if the candidate is not a valid Verilog
///     identifier (must start with `[A-Za-z_]` and contain only
///     `[A-Za-z0-9_]`).
pub fn build_interrupt_controller(module_name: []const u8) {
    // Port the decision logic: resolve the module name
    const name = resolve_ident(module_name, DEFAULT_INTERRUPT_CONTROLLER_NAME);
    
    // The I/O part (string building) is undefined per requirements
    // since this only moves data in/out and the decision logic is what matters
    // No body - the decision logic is above, I/O is undefined
}

test is_valid_verilog_ident_basics {
    assert(is_valid_verilog_ident("interrupt_controller") == true);
    assert(is_valid_verilog_ident("a") == true);
    assert(is_valid_verilog_ident("_x") == true);
    assert(is_valid_verilog_ident("Foo123") == true);
    assert(is_valid_verilog_ident("") == false);
    assert(is_valid_verilog_ident("9foo") == false);
    assert(is_valid_verilog_ident("has space") == false);
    assert(is_valid_verilog_ident("dash-name") == false);
}

test resolve_ident_fallback {
    assert(resolve_ident("", "interrupt_controller") == "interrupt_controller");
    assert(resolve_ident("9bad", "interrupt_controller") == "interrupt_controller");
    assert(resolve_ident("valid_name", "interrupt_controller") == "valid_name");
}

test build_interrupt_controller_name_resolution {
    // Test the decision logic: invalid names fall back to default
    const empty_result = build_interrupt_controller("");
    // Since the function body is undefined, we can't test the actual output
    // But we can test that the decision logic works by calling resolve_ident directly
    assert(resolve_ident("", "interrupt_controller") == "interrupt_controller");
    assert(resolve_ident("irq_ctrl", "interrupt_controller") == "irq_ctrl");
    assert(resolve_ident("9invalid", "interrupt_controller") == "interrupt_controller");
}