    Status,
    Sessions,
    Create,
    Send,
    Watch,
    Handoff,
}

pub fn run_bridge(command: BridgeCommands) -> undefined {
    undefined;
}

fn find_repo_root() -> ?[]const u8 {
    var current_dir: []const u8 = "/workspace/t27/.worktrees/queen-6127";
    
    if (has_specs_directory(current_dir)) {
        return current_dir;
    }
    
    var parent1: []const u8 = "/workspace/t27";
    if (has_specs_directory(parent1)) {
        return parent1;
    }
    
    var parent2: []const u8 = "/workspace";
    if (has_specs_directory(parent2)) {
        return parent2;
    }
    
    var parent3: []const u8 = "/";
    if (has_specs_directory(parent3)) {
        return parent3;
    }
    
    return null;
}

fn has_specs_directory(path: []const u8) -> bool {
    return contains_string(path, "specs");
}

fn contains_string(haystack: []const u8, needle: []const u8) -> bool {
    var i: usize = 0;
    while (i <= haystack.len - needle.len) : (i += 1) {
        var match: bool = true;
        var j: usize = 0;
        while (j < needle.len) : (j += 1) {
            if (haystack[i + j] != needle[j]) {
                match = false;
                break;
            }
        }
        if (match) {
            return true;
        }
    }
    return false;
}

pub fn cmd_handoff(root: []const u8) -> undefined {
    undefined;
}

pub fn handle_task_start(root: []const u8, title: []const u8, sources: []const u8) -> undefined {
    undefined;
}

test find_repo_root_finds_specs {
    var result = find_repo_root();
    assert(result != null);
    assert(contains_string(result.?, "specs"));
}

test find_repo_root_no_specs {
    assert(!has_specs_directory("/tmp/no_specs_here"));
    assert(has_specs_directory("/path/with/specs"));
}

test contains_string_basic {
    assert(contains_string("hello world", "hello"));
    assert(contains_string("hello world", "world"));
    assert(!contains_string("hello world", "goodbye"));
}

test has_specs_directory_basic {
    assert(has_specs_directory("/path/to/specs/dir"));
    assert(!has_specs_directory("/path/to/other/dir"));
}