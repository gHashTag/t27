    const variables = null; // Use null instead of array
    const response_status_success = true;
    const response_status = 200;
    const response_body = "Success";
    
    const result = set_service_variables(service_id, variables, railway_token, response_status_success, response_status, response_body);
    assert(result == 0); // Success
}

test delete_service_success {
    // Test successful service deletion
    const service_id = "service-123";
    const railway_token = "token-456";
    const response_status_success = true;
    const response_status = 200;
    const response_body = "Success";
    
    const result = delete_railway_service(service_id, railway_token, response_status_success, response_status, response_body);
    assert(result == 0); // Success
}