// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/vivado/gf16_add.t27
// 16-bit floating-point adder port from Verilog
// Implements IEEE-like half-precision with custom NaN/infinity handling
// Generated from fpga/vivado/gf16_add.v
// phi^2 + 1/phi^2 = 3 | TRINITY

module gf16_add {

    // === Constants ===
    
    pub const BIAS : u32 = 31;
    pub const EXP_MAX : u32 = 63;
    
    // === Floating-point format ===
    // Bit layout: [15:sign] [14:9:exponent] [8:0:mantissa]
    
    pub struct Fp16 {
        sign : bool,
        exponent : u32,
        mantissa : u32,
    }
    
    // === Helper functions ===
    
    fn extract_bits(value: u32, start: u32, width: u32) -> u32 {
        return (value >> start) & ((1 << width) - 1);
    }
    
    fn fp16_to_value(fp: Fp16) -> u32 {
        var sign_val : u32 = 0;
        if (fp.sign) {
            sign_val = 32768;
        }
        return sign_val + fp.exponent * 512 + fp.mantissa;
    }
    
    fn value_to_fp16(value: u32) -> Fp16 {
        return Fp16{
            .sign = (value >> 15) != 0,
            .exponent = extract_bits(value, 9, 6),
            .mantissa = extract_bits(value, 0, 9),
        };
    }
    
    fn is_zero(exp: u32, mant: u32) -> bool {
        return exp == 0 and mant == 0;
    }
    
    fn is_special(exp: u32) -> bool {
        return exp == EXP_MAX;
    }
    
    fn is_inf(exp: u32, mant: u32) -> bool {
        return is_special(exp) and mant == 0;
    }
    
    fn is_nan(exp: u32, mant: u32) -> bool {
        return is_special(exp) and mant != 0;
    }
    
    fn a_larger(exp_a: u32, mant_a: u32, exp_b: u32, mant_b: u32) -> bool {
        return exp_a > exp_b or (exp_a == exp_b and mant_a >= mant_b);
    }
    
    fn shift_mantissa(mant: u32, shift: u32) -> u32 {
        if (shift == 0) {
            return mant;
        } else if (shift == 1) {
            return (mant / 2) & 2047;
        } else if (shift == 2) {
            return (mant / 4) & 1023;
        } else if (shift == 3) {
            return (mant / 8) & 511;
        } else if (shift == 4) {
            return (mant / 16) & 255;
        } else if (shift == 5) {
            return (mant / 32) & 127;
        } else if (shift == 6) {
            return (mant / 64) & 63;
        } else if (shift == 7) {
            return (mant / 128) & 31;
        } else if (shift == 8) {
            return (mant / 256) & 15;
        } else if (shift == 9) {
            return (mant / 512) & 7;
        } else if (shift == 10) {
            return (mant / 1024) & 3;
        } else {
            return 0;
        }
    }
    
    fn add_mantissas(big_mant: u32, small_mant: u32, same_sign: bool) -> (u32, bool) {
        var big_with_implicit : u32 = 1024 + big_mant;
        var small_with_implicit : u32 = 1024 + small_mant;
        
        if (same_sign) {
            return (big_with_implicit + small_with_implicit, false);
        } else {
            var diff : u32 = big_with_implicit - small_with_implicit;
            return (diff, diff == 0);
        }
    }
    
    fn normalize_mantissa(sum_m: u32) -> (u32, u32, bool, bool, bool) {
        if (sum_m >= 2048) {
            // Bit 11 is set - need to normalize right by 1
            return (sum_m / 2, 1, sum_m % 2, false, false);
        } else if (sum_m >= 1024) {
            // Bit 10 is set - already normalized
            return (sum_m, 0, sum_m % 2, false, false);
        } else {
            // Need to normalize left
            const temp : u32 = sum_m;
            var norm : u32 = 0;
            const shift_count : u32 = 0;
            
            if (temp >= 512) {
                norm = temp;
            } else if (temp >= 256) {
                norm = temp * 2;
            } else if (temp >= 128) {
                norm = temp * 4;
            } else if (temp >= 64) {
                norm = temp * 8;
            } else if (temp >= 32) {
                norm = temp * 16;
            } else if (temp >= 16) {
                norm = temp * 32;
            } else if (temp >= 8) {
                norm = temp * 64;
            } else if (temp >= 4) {
                norm = temp * 128;
            } else if (temp >= 2) {
                norm = temp * 256;
            } else {
                norm = temp * 512;
            }
            
            return (norm, 0, 0, false, false);
        }
    }
    
    fn round_mantissa(norm: u32, g_bit: bool, r_bit: bool, s_bit: bool) -> u32 {
        if (g_bit and (r_bit or s_bit)) {
            return norm + 1;
        }
        return norm;
    }
    
    fn format_result(sign: bool, exp: u32, mant: u32) -> u32 {
        if (exp >= 64) {
            // Exponent overflow - return infinity with appropriate sign
            var infinity_val : u32 = 0;
            if (sign) {
                infinity_val = 0xFE00;
            } else {
                infinity_val = 0x7E00;
            }
            return infinity_val;
        } else if (exp >= EXP_MAX) {
            // Exponent at max - return infinity with appropriate sign
            var infinity_val : u32 = 0;
            if (sign) {
                infinity_val = 0xFE00;
            } else {
                infinity_val = 0x7E00;
            }
            return infinity_val;
        } else {
            // Normal number
            var sign_val : u32 = 0;
            if (sign) {
                sign_val = 32768;
            }
            return sign_val + exp * 512 + mant;
        }
    }
    
    // === Main addition function ===
    
    pub fn add_fp16(a: u32, b: u32) -> u32 {
        // Extract components
        var sign_a : bool = (a >> 15) != 0;
        var exp_a : u32 = extract_bits(a, 9, 6);
        var mant_a : u32 = extract_bits(a, 0, 9);
        var sign_b : bool = (b >> 15) != 0;
        var exp_b : u32 = extract_bits(b, 9, 6);
        var mant_b : u32 = extract_bits(b, 0, 9);
        
        // Check for special cases
        if (is_nan(exp_a, mant_a) or is_nan(exp_b, mant_b)) {
            return 0xFE01; // NaN
        }
        
        if (is_inf(exp_a, mant_a) and is_inf(exp_b, mant_b) and sign_a != sign_b) {
            return 0xFE01; // NaN (inf - inf)
        }
        
        if (is_inf(exp_a, mant_a)) {
            var infinity_val : u32 = 0;
            if (sign_a) {
                infinity_val = 0xFE00;
            } else {
                infinity_val = 0x7E00;
            }
            return infinity_val; // Infinity
        }
        
        if (is_inf(exp_b, mant_b)) {
            var infinity_val : u32 = 0;
            if (sign_b) {
                infinity_val = 0xFE00;
            } else {
                infinity_val = 0x7E00;
            }
            return infinity_val; // Infinity
        }
        
        if (is_zero(exp_a, mant_a) and is_zero(exp_b, mant_b)) {
            return 0x0000; // 0 + 0 = 0
        }
        
        if (is_zero(exp_a, mant_a)) {
            return b; // 0 + x = x
        }
        
        if (is_zero(exp_b, mant_a)) {
            return a; // x + 0 = x
        }
        
        // Determine which number has larger exponent
        var a_is_larger : bool = a_larger(exp_a, mant_a, exp_b, mant_b);
        var big_exp : u32 = 0;
        var big_mant : u32 = 0;
        var big_sign : bool = false;
        var small_mant : u32 = 0;
        var small_sign : bool = false;
        
        if (a_is_larger) {
            big_exp = exp_a;
            big_mant = mant_a;
            big_sign = sign_a;
            small_mant = mant_b;
            small_sign = sign_b;
        } else {
            big_exp = exp_b;
            big_mant = mant_b;
            big_sign = sign_b;
            small_mant = mant_a;
            small_sign = sign_a;
        }
        
        // Calculate shift amount
        var shift_amount : u32 = 0;
        if (a_is_larger) {
            shift_amount = big_exp - exp_b;
        } else {
            shift_amount = big_exp - exp_a;
        }
        var shifted_small_mant : u32 = shift_mantissa(small_mant, shift_amount);
        
        // Add mantissas
        var (sum_m, cancel) = add_mantissas(big_mant, shifted_small_mant, big_sign == small_sign);
        
        if (cancel) {
            return 0x0000; // Cancellation occurred (x + (-x) = 0)
        }
        
        // Normalize the result
        var (norm, exp_adjust, g_bit, r_bit, s_bit) = normalize_mantissa(sum_m);
        var result_exp : u32 = big_exp + exp_adjust;
        var result_sign : bool = big_sign;
        
        // Round the mantissa
        var rounded : u32 = round_mantissa(norm, g_bit, r_bit, s_bit);
        
        // Handle rounding overflow
        if (rounded < norm) {
            result_exp = result_exp + 1;
            var final_mant : u32 = 0;
            return format_result(result_sign, result_exp, final_mant);
        } else {
            var final_mant : u32 = norm & 0x1FF;
            return format_result(result_sign, result_exp, final_mant);
        }
    }
    
    // === Tests ===
    
    test nan_propagation
        given a = 0xFE01, b = 0x3C00
        then add_fp16(a, b) == 0xFE01  // NaN + anything = NaN
    
    test inf_nan_propagation
        given a = 0x7E00, b = 0xFE01
        then add_fp16(a, b) == 0xFE01  // Inf + NaN = NaN
    
    test inf_inf_opposite_signs
        given a = 0x7E00, b = 0xFE00
        then add_fp16(a, b) == 0xFE01  // +Inf + -Inf = NaN
    
    test inf_positive
        given a = 0x7E00, b = 0x3C00
        then add_fp16(a, b) == 0x7E00  // +Inf + finite = +Inf
    
    test inf_negative
        given a = 0xFE00, b = 0x3C00
        then add_fp16(a, b) == 0xFE00  // -Inf + finite = -Inf
    
    test zero_zero
        given a = 0x0000, b = 0x0000
        then add_fp16(a, b) == 0x0000  // 0 + 0 = 0
    
    test zero_positive
        given a = 0x0000, b = 0x3C00
        then add_fp16(a, b) == 0x3C00  // 0 + x = x
    
    test zero_negative
        given a = 0x0000, b = 0xBC00
        then add_fp16(a, b) == 0xBC00  // 0 + (-x) = -x
    
    test simple_addition
        given a = 0x3C00, b = 0x3C00
        then add_fp16(a, b) == 0x4000  // 1.0 + 1.0 = 2.0
    
    test addition_with_different_exponents
        given a = 0x3C00, b = 0x3E00
        then add_fp16(a, b) == 0x4000  // 1.0 + 1.5 = 2.5 (normalized)
    
    test subtraction_same_magnitude
        given a = 0x4000, b = 0xC000
        then add_fp16(a, b) == 0x0000  // 2.0 + (-2.0) = 0.0 (cancellation)
    
    test normalization_shift
        given a = 0x3D00, b = 0x3D00
        then add_fp16(a, b) == 0x4200  // 1.5 + 1.5 = 3.0 (normalized)
    
    test exponent_overflow
        given a = 0x7BFF, b = 0x7BFF
        then add_fp16(a, b) == 0x7E00  // Large + Large = Inf
    
    test small_numbers
        given a = 0x0001, b = 0x0001
        then add_fp16(a, b) == 0x0002  // Very small + Very small
    
    test mixed_signs
        given a = 0x4000, b = 0xBC00
        then add_fp16(a, b) == 0x0000  // 2.0 + (-2.0) = 0.0
    
    test different_magnitudes
        given a = 0x4000, b = 0x3C00
        then add_fp16(a, b) == 0x4000  // 2.0 + 1.0 = 2.0 (2.0 dominates)
}

// phi^2 + 1/phi^2 = 3 | TRINITY