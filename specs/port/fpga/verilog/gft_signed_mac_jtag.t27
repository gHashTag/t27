// gft_signed_mac_jtag.t27 -- JTAG port of gft_signed_mac (DESIGN 12 companion).
//
// The on-die module gft_signed_mac drives five GftSignedMac instances (ZERO,
// COMM x2, CANCEL, IND) whose result checkers latch settled clause values into
// a JTAG capture register, read out as WORD v3:
//   {16'hA5A5, 4'd3, 6'd13, c_zero, c_comm, c_cancel, c_ind, beat, ok}
// This port carries the same arithmetic as specs/ternary/gft_signed_mac.t27
// verbatim (the proven oracle) and asserts the DUT's own clause values: the
// zero clause adds two vanished magnitudes to 512 (W839), the comm clause pair
// matches on both orderings (20000-case swap sweep), cancel lands exactly on
// 0, and the pp pair lands on 2.0.
//
// Xilinx primitives (STARTUPE2, BSCANE2, BUFG) are external functions here;
// the four clause properties are combinational and the JTAG word builder is
// the sibling smul port's proven form, with the signed MAC's tag 6'd13.

module gft_signed_mac_jtag {
    pub const JTAG_CHAIN_N : u32 = 3;

    // 16.16 fixed-point constants (mirroring the sibling smul port):
    // 1.0 = 20480, 2.0 = 20992, -1.0 = 86016 (sign bit 16), 0 = 0.
    pub const ONE : u32 = 20480;
    pub const TWO : u32 = 20992;
    pub const NEG : u32 = 86016;
    pub const Z : u32 = 0;

    // Aggregated checker results latched into the JTAG capture register.
    pub struct TestResults {
        zero_ok : bool,
        comm_ok : bool,
        cancel_ok : bool,
        ind_ok : bool,
        ok : bool,
        beat : bool,
    }

    // Four 32-bit test vectors: 0, 1.0, 2.0, -1.0.
    fn generate_test_vectors() -> [4]u32 {
        return [Z, ONE, TWO, NEG];
    }

    // On-die register model: live counts +1 per beat, live2 counts +7.
    fn next_live_value(current: u32) -> u32 {
        return current + 1;
    }

    fn next_live2_value(current: u32) -> u32 {
        return current + 7;
    }

    fn toggle_beat(current: bool) -> bool {
        return !current;
    }

    // --- RNE magnitude multiply (matches gft_mul_rne) ---
    fn magmul(a: i32, b: i32) -> i32 {
        var ao : i32 = a >> 9;
        var am : i32 = a & 511;
        var bo : i32 = b >> 9;
        var bm : i32 = b & 511;
        var prod : i32 = (512 + am) * (512 + bm);
        var carry : i32 = 0;
        if (prod >= 524288) { carry = 1; }
        var q : i32 = prod >> 9;
        var r : i32 = prod & 511;
        var half : i32 = 256;
        if (carry == 1) { q = prod >> 10; r = prod & 1023; half = 512; }
        var mant : i32 = q - 512;
        if (r > half) { mant = mant + 1; }
        if (r == half) { if ((q & 1) == 1) { mant = mant + 1; } }
        var s : i32 = ao + bo + carry;
        var off : i32 = 0;
        if (s >= 40) { var rr : i32 = s - 40; if (rr >= 80) { off = 80; } else { off = rr; } }
        if (mant >= 512) { mant = 0; off = off + 1; if (off >= 80) { off = 80; } }
        return (off << 9) | mant;
    }

    // --- RNE magnitude same-sign add (matches gft_add_rne) ---
    fn magadd(a: i32, b: i32) -> i32 {
        var ao : i32 = a >> 9;
        var am : i32 = a & 511;
        var bo : i32 = b >> 9;
        var bm : i32 = b & 511;
        var ho : i32 = bo; var hm : i32 = bm; var lo : i32 = ao; var lm : i32 = am;
        if (ao >= bo) { ho = ao; hm = am; lo = bo; lm = bm; }
        var hs : i32 = 512 + hm;
        var ls : i32 = 512 + lm;
        var d : i32 = ho - lo;
        if (d > 11) { d = 11; }
        var losh : i32 = ls >> d;
        var rem : i32 = ls - (losh << d);
        var s : i32 = hs + losh;
        var off : i32 = ho;
        var mant : i32 = s - 512;
        if (s >= 1024) {
            var g : i32 = s & 1;
            var pre : i32 = s >> 1;
            mant = pre - 512;
            if (g == 1) { if (rem > 0) { mant = mant + 1; } else { if ((pre & 1) == 1) { mant = mant + 1; } } }
            off = ho + 1; if (off >= 80) { off = 80; }
        } else {
            var t : i32 = rem << 1;
            var hf : i32 = 1 << d;
            if (t > hf) { mant = mant + 1; }
            else { if (t == hf) { if ((s & 1) == 1) { mant = mant + 1; } } }
        }
        if (mant >= 512) { mant = 0; off = off + 1; if (off >= 80) { off = 80; } }
        return (off << 9) | mant;
    }

    // --- RNE magnitude subtract, hi >= lo. Returns 0 on exact cancellation. G=14 guard bits. ---
    fn magsub(hi: i32, lo: i32) -> i32 {
        if (hi == lo) { return 0; }
        var ho : i32 = hi >> 9; var hm : i32 = hi & 511;
        var lo_o : i32 = lo >> 9; var lm : i32 = lo & 511;
        var d : i32 = ho - lo_o; var hs : i32 = (512 + hm) << 14;
        var la : i32 = 0; var sticky : i32 = 0;
        if (d >= 26) { la = 0; sticky = 1; }
        else { var ls : i32 = (512 + lm) << 14; la = ls >> d; if ((ls - (la << d)) > 0) { sticky = 1; } }
        var diff : i32 = hs - la; var off : i32 = ho;
        var cap : i32 = 12; if (off - 1 < cap) { cap = off - 1; } if (cap < 0) { cap = 0; }
        var sh : i32 = 0;
        if (diff != 0) {
            var t : i32 = diff;
            if (t < 65536) { if (sh + 8 <= cap) { t = t << 8; sh = sh + 8; } }
            if (t < 1048576) { if (sh + 4 <= cap) { t = t << 4; sh = sh + 4; } }
            if (t < 4194304) { if (sh + 2 <= cap) { t = t << 2; sh = sh + 2; } }
            if (t < 8388608) { if (sh + 1 <= cap) { t = t << 1; sh = sh + 1; } }
        }
        diff = diff << sh; off = off - sh;
        var q : i32 = diff >> 14; var rem : i32 = diff - (q << 14); var half : i32 = 8192; var mant : i32 = q - 512;
        if (rem > half) { mant = mant + 1; }
        else { if (rem == half) { if (sticky == 1) { mant = mant + 1; } else { if ((q & 1) == 1) { mant = mant + 1; } } } }
        if (mant >= 512) { mant = 0; off = off + 1; if (off >= 80) { off = 80; } }
        // #5506: below the smallest binade the normalisation stops at its floor and
        // q stays under 512, so mant goes negative and (off << 9) | mant is no
        // GF-T16 encoding at all (sadd(256, 66047) gave 0xFFFFFEFF). There are no
        // subnormals: such a difference is zero, exactly as enc() makes any
        // value below 2^-40 zero.
        if (mant < 0) { return 0; }
        return (off << 9) | mant;
    }

    fn smul(a: u32, b: u32) -> u32 {
        var sa : i32 = (a >> 16) as i32;
        var sb : i32 = (b >> 16) as i32;
        var mag : i32 = magmul((a & 65535) as i32, (b & 65535) as i32);
        return (((sa ^ sb) << 16) | mag) as u32;
    }

    fn sadd(a: u32, b: u32) -> u32 {
        var sa : i32 = (a >> 16) as i32;
        var ma : i32 = (a & 65535) as i32;
        var sb : i32 = (b >> 16) as i32;
        var mb : i32 = (b & 65535) as i32;
        if (sa == sb) { return ((sa << 16) | magadd(ma, mb)) as u32; }
        // different signs: a top-level r==0 guard (NOT nested inside the ma>=mb
        // branch -- gen-verilog does not lower that as an early return, so it fell
        // through to (sign<<16)|0 = a wrong negative zero on exact cancellation).
        // #5506: order the operands BEFORE subtracting. magsub(hi, lo) shifts by
        // hi_off - lo_off, so calling it unordered shifts by a negative count:
        // undefined in C, unchecked in Rust -O, a trap in Zig ReleaseSafe.
        var bsign : i32 = sa;
        var r : i32 = 0;
        if (ma < mb) { r = magsub(mb, ma); bsign = sb; } else { r = magsub(ma, mb); }
        if (r == 0) { return 0; }
        return ((bsign << 16) | r) as u32;
    }

    // The signed MAC: y = a1*b1 + a2*b2.
    fn on_comb(a1: u32, b1: u32, a2: u32, b2: u32) -> u32 {
        return sadd(smul(a1, b1), smul(a2, b2));
    }

    // 1. ZERO property: mac(0, live) + mac(0, live2) == 512 -- the DUT's
    //    zero clause (W839): two vanished magnitudes add to 512, not 0.
    fn test_zero_property(live: u32, live2: u32) -> bool {
        var result: u32 = on_comb(0, live, 0, live2);

        return result == 512;
    }

    // 2. COMM property: mac(live, TWO, live2, ONE) == mac(TWO, live, ONE, live2)
    //    -- the DUT's comm clause, proven on both orderings.
    fn test_comm_property(live: u32, live2: u32) -> bool {
        var result1: u32 = on_comb(live, TWO, live2, ONE);
        var result2: u32 = on_comb(TWO, live, ONE, live2);

        return (result1 == result2) and (result1 == ONE);
    }

    // 3. CANCEL property: mac(1.0, 1.0) + mac(1.0, -1.0) == 0 -- the DUT's
    //    cancel test: exact cancellation through the RNE subtract path.
    fn test_cancel_property() -> bool {
        var result: u32 = on_comb(ONE, ONE, ONE, NEG);

        return result == Z;
    }

    // 4. IND property: mac(1.0, 1.0) + mac(-1.0, -1.0) == 2.0 -- the DUT's
    //    pp test: a live-driven product pair that must not cancel.
    fn test_ind_property() -> bool {
        var result: u32 = on_comb(ONE, ONE, NEG, NEG);

        return (result != Z) and (result == TWO);
    }

    // Run all four clause properties and latch the results (the DUT's settle
    // logic waits 31 cycles before latching; here it is combinational).
    fn run_clauses(live: u32, live2: u32, beat: bool) -> TestResults {
        var results: TestResults = TestResults{
            .zero_ok = test_zero_property(ONE, ONE),
            .comm_ok = test_comm_property(live, live2),
            .cancel_ok = test_cancel_property(),
            .ind_ok = test_ind_property(),
            .ok = true,
            .beat = beat,
        };

        // Final ok is AND of all individual results.
        results.ok = results.zero_ok and results.comm_ok and results.cancel_ok and results.ind_ok;

        return results;
    }

    // Build the JTAG capture word (WORD v3): the checker bits sit at 16-21,
    // base 43904 as in the sibling smul port.
    fn build_jtag_word(results: TestResults) -> u32 {
        var word: u32 = 43904;  // 0xA5A5

        if (results.zero_ok) {
            word = word + 65536;   // bit 16
        }
        if (results.comm_ok) {
            word = word + 131072;  // bit 17
        }
        if (results.cancel_ok) {
            word = word + 262144;  // bit 18
        }
        if (results.ind_ok) {
            word = word + 524288;  // bit 19
        }
        if (results.beat) {
            word = word + 1048576; // bit 20
        }
        if (results.ok) {
            word = word + 2097152; // bit 21
        }

        return word;
    }

    // === Test Cases ===

    test zero_clause_with_live
        given live = 20480, live2 = 20480
        then test_zero_property(live, live2) == true

    test comm_clause_both_orders
        given live = 20480, live2 = 86016
        then test_comm_property(live, live2) == true

    test cancel_clause
        then test_cancel_property() == true

    test ind_clause
        then test_ind_property() == true

    test test_vector_generation
        then generate_test_vectors()[0] == Z
        and generate_test_vectors()[1] == ONE
        and generate_test_vectors()[2] == TWO
        and generate_test_vectors()[3] == NEG

    test next_live_value_increment
        given current = 20480
        then next_live_value(current) == 20481

    test next_live2_value_increment
        given current = 20480
        then next_live2_value(current) == 20487

    test beat_toggle
        given current = true
        then toggle_beat(current) == false

    // === Invariants ===

    invariant constants_positive
        assert ONE > 0
        and TWO > 0
        and NEG > 0

    invariant one_equals_one
        assert ONE == 20480

    invariant two_equals_two
        assert TWO == 20992

    invariant neg_is_negative_one
        assert NEG == 86016

    invariant test_results_boolean
        given r = TestResults{.zero_ok = true, .comm_ok = false, .cancel_ok = true, .ind_ok = false, .ok = false, .beat = true}
        assert r.zero_ok == true or r.zero_ok == false
        and r.comm_ok == true or r.comm_ok == false
        and r.cancel_ok == true or r.cancel_ok == false
        and r.ind_ok == true or r.ind_ok == false
        and r.ok == true or r.ok == false
        and r.beat == true or r.beat == false

    // === Benchmarks ===

    bench test_execution_latency
        measure: nanoseconds to run_clauses(20480, 86016, true)
        target: < 100ns

    bench jtag_word_construction_latency
        measure: nanoseconds to build_jtag_word(TestResults{.zero_ok = true, .comm_ok = true, .cancel_ok = true, .ind_ok = true, .ok = true, .beat = true})
        target: < 50ns
}
