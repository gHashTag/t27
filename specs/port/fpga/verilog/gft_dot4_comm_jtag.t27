// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/verilog/gft_dot4_comm_jtag.t27
// GFT Dot4 Commutativity JTAG Test Wrapper
// Tests arithmetic commutativity of GftSignedDot4 with operand sweep
// Ported from gHashTag/t27#5305
// phi^2 + 1/phi^2 = 3 | TRINITY

module gft_dot4_comm_jtag {

    // === Module parameters ===

    pub const JTAG_CHAIN_N : u32 = 3;

    // === Clock and reset constants ===

    pub const SLOWCLK_DIVIDER_WIDTH : u32 = 5;
    pub const RESET_COUNTER_WIDTH : u32 = 4;
    pub const RESET_DONE_VALUE : u32 = 15; // 4'hF

    // === Sweep constants ===

    pub const PRE_COUNTER_WIDTH : u32 = 8;
    pub const K_COUNTER_WIDTH : u32 = 16;
    pub const K_MAX_VALUE : u32 = 65535; // 16'hFFFF
    pub const AGE_COUNTER_WIDTH : u32 = 4;
    pub const AGE_MAX_VALUE : u32 = 15; // 4'hF
    pub const SETTLE_COUNTER_WIDTH : u32 = 5;
    pub const SETTLE_DONE_VALUE : u32 = 31; // 5'h1F

    // === Operand field constants ===

    pub const OFFSET_BASE : u32 = 35;
    pub const SIGN_BIT_A : u32 = 15;
    pub const SIGN_BIT_B : u32 = 14;
    pub const OFFSET_A_LO : u32 = 10;
    pub const OFFSET_A_HI : u32 = 13;
    pub const OFFSET_B_LO : u32 = 6;
    pub const OFFSET_B_HI : u32 = 9;
    pub const MANTISSA_A_LO : u32 = 0;
    pub const MANTISSA_A_HI : u32 = 8;
    pub const MANTISSA_B_LO : u32 = 0;
    pub const MANTISSA_B_HI : u32 = 5;
    pub const MANTISSA_B_ROT_HI : u32 = 6;
    pub const MANTISSA_B_ROT_LO : u32 = 8;

    // === Clause constants ===

    pub const CLAUSE_IMMEDIATE : u32 = 0;
    pub const CLAUSE_SETTLED : u32 = 1;
    pub const CLAUSE_SWEPT : u32 = 2;
    pub const CLAUSE_INDEPENDENT : u32 = 3;

    // === JTAG constants ===

    pub const JTAG_WORD_MAGIC : u32 = 4294445460; // 16'hA5A5
    pub const JTAG_VERSION : u32 = 3;
    pub const JTAG_ID : u32 = 11;
    pub const JTAG_DATA_INIT : u32 = 4280568524; // 32'hA5A532FC

    // === Data structures ===

    pub struct Operand {
        sign : bool,
        offset : u32,
        mantissa : u32,
        full_value : u32,
    }

    pub struct SweepState {
        pre : u32,
        k : u32,
        swept : bool,
        beat : bool,
        age : u32,
    }

    pub struct ClauseResults {
        c_imm : bool,
        c_settled : bool,
        c_swept : bool,
        c_ind : bool,
        ok : bool,
    }

    // === Clock and reset functions ===

    fn slowclk_divider_value(dv: u32) -> bool {
        return (dv >> (SLOWCLK_DIVIDER_WIDTH - 1)) & 1 == 1;
    }

    fn reset_counter_done(rstc: u32) -> bool {
        return rstc == RESET_DONE_VALUE;
    }

    fn reset_counter_next(rstc: u32) -> u32 {
        if (rstc != RESET_DONE_VALUE) {
            return rstc + 1;
        }
        return rstc;
    }

    // === Sweep state functions ===

    fn sweep_state_next(state: SweepState, rst_n: bool) -> SweepState {
        var next_state = state;
        
        if (rst_n) {
            next_state.pre = state.pre + 1;
            
            if (state.pre == (1 << PRE_COUNTER_WIDTH) - 1) {
                next_state.age = 0;
                next_state.beat = !state.beat;
                
                if (state.k == K_MAX_VALUE) {
                    next_state.swept = true;
                } else {
                    next_state.k = state.k + 1;
                }
            } else if (state.age != AGE_MAX_VALUE) {
                next_state.age = state.age + 1;
            }
        }
        
        return next_state;
    }

    // === Operand generation functions ===

    fn extract_operand_a(k: u32) -> Operand {
        var sign = (k >> SIGN_BIT_A) & 1 == 1;
        var offset_bits = (k >> OFFSET_A_LO) & 0x7; // 3 bits
        var offset = OFFSET_BASE + offset_bits;
        var mantissa = k & ((1 << (MANTISSA_A_HI - MANTISSA_A_LO + 1)) - 1);
        var full_value = (0 << 16) | (sign as u32) << 8 | offset << 1 | mantissa;
        
        return Operand{
            .sign = sign,
            .offset = offset,
            .mantissa = mantissa,
            .full_value = full_value,
        };
    }

    fn extract_operand_b(k: u32) -> Operand {
        var sign = (k >> SIGN_BIT_B) & 1 == 1;
        var offset_bits = (k >> OFFSET_B_LO) & 0x7; // 3 bits
        var offset = OFFSET_BASE + offset_bits;
        
        // Rotate mantissa: bits 5:0 + bits 8:6
        var mantissa_lo = k & 0x3F; // bits 5:0
        var mantissa_hi = (k >> MANTISSA_B_ROT_LO) & 0x7; // bits 8:6
        var mantissa = (mantissa_hi << 6) | mantissa_lo;
        
        var full_value = (0 << 16) | (sign as u32) << 8 | offset << 1 | mantissa;
        
        return Operand{
            .sign = sign,
            .offset = offset,
            .mantissa = mantissa,
            .full_value = full_value,
        };
    }

    fn live_operand_next(live: u32, pre: u32) -> u32 {
        if (pre == (1 << PRE_COUNTER_WIDTH) - 1) {
            return live + 1;
        }
        return live;
    }

    // === Commutativity checking ===

    fn check_commutativity(result_ab: u32, result_ba: u32) -> bool {
        return result_ab == result_ba;
    }

    // === Clause evaluation functions ===

    fn evaluate_clauses(comm: bool, age: u32, r_ab: u32, swept: bool) -> ClauseResults {
        var clauses = ClauseResults{
            .c_imm = true,
            .c_settled = true,
            .c_swept = swept,
            .c_ind = r_ab != 0,
            .ok = false,
        };
        
        if (!comm) {
            clauses.c_imm = false;
        }
        
        if (!comm && age >= 8) {
            clauses.c_settled = false;
        }
        
        clauses.ok = clauses.c_imm && clauses.c_settled && clauses.c_ind && clauses.c_swept;
        
        return clauses;
    }

    fn settle_counter_next(settle: u32, rst_n: bool) -> u32 {
        if (rst_n && settle != SETTLE_DONE_VALUE) {
            return settle + 1;
        }
        return settle;
    }

    fn update_clauses_from_settle(clauses: ClauseResults, comm: bool, age: u32, r_ab: u32, swept: bool) -> ClauseResults {
        var updated = clauses;
        
        if (comm) {
            updated.c_imm = true;
        } else {
            updated.c_imm = false;
        }
        
        if (!comm && age >= 8) {
            updated.c_settled = false;
        } else {
            updated.c_settled = true;
        }
        
        if (r_ab == 0) {
            updated.c_ind = false;
        } else {
            updated.c_ind = true;
        }
        
        updated.c_swept = swept;
        updated.ok = updated.c_imm && updated.c_settled && updated.c_ind && updated.c_swept;
        
        return updated;
    }

    // === JTAG functions ===

    fn jtag_capture_word(clauses: ClauseResults, beat: bool) -> u32 {
        return (JTAG_WORD_MAGIC << 16) | 
               (JTAG_VERSION << 12) | 
               (JTAG_ID << 6) | 
               (clauses.c_imm as u32) << 5 | 
               (clauses.c_settled as u32) << 4 | 
               (clauses.c_swept as u32) << 3 | 
               (clauses.c_ind as u32) << 2 | 
               (beat as u32) << 1 | 
               (clauses.ok as u32);
    }

    fn jtag_shift_register_next(sr: u32, tdi: bool, capture: bool, shift: bool) -> u32 {
        if (capture) {
            return jtag_capture_word(ClauseResults{
                .c_imm = true,
                .c_settled = true,
                .c_swept = false,
                .c_ind = true,
                .ok = false,
            }, false);
        } else if (shift) {
            var tdi_bit = if (tdi) 1 else 0;
            return (tdi_bit << 31) | (sr >> 1);
        }
        return sr;
    }

    fn jtag_tdo_output(sr: u32) -> bool {
        return (sr & 1) == 1;
    }

    // === Test functions ===

    test extract_operand_a_simple
        given k = 0x8000  // sign bit set, offset = 35, mantissa = 0
        then op = extract_operand_a(k)
        and op.sign == true
        and op.offset == 35
        and op.mantissa == 0
        and op.full_value == 0x008000

    test extract_operand_a_complex
        given k = 0x8234  // sign=1, offset=35+3=38, mantissa=0x134
        then op = extract_operand_a(k)
        and op.sign == true
        and op.offset == 38
        and op.mantissa == 0x134
        and op.full_value == 0x009234

    test extract_operand_b_rotation
        given k = 0x0045  // sign=0, offset=35+1=36, mantissa rotated: 0x05 + 0x1<<6 = 0x41
        then op = extract_operand_b(k)
        and op.sign == false
        and op.offset == 36
        and op.mantissa == 0x41
        and op.full_value == 0x002841

    test sweep_state_advance
        given state = SweepState{.pre=0xFF, .k=0x1234, .swept=false, .beat=true, .age=5}
        then next = sweep_state_next(state, true)
        and next.pre == 0
        and next.age == 0
        and next.beat == false
        and next.k == 0x1235
        and next.swept == false

    test sweep_state_wraparound
        given state = SweepState{.pre=0xFF, .k=K_MAX_VALUE, .swept=false, .beat=false, .age=3}
        then next = sweep_state_next(state, true)
        and next.k == K_MAX_VALUE
        and next.swept == true
        and next.beat == true

    test check_commutativity_true
        given r_ab = 0x12345678
        and r_ba = 0x12345678
        then check_commutativity(r_ab, r_ba) == true

    test check_commutativity_false
        given r_ab = 0x12345678
        and r_ba = 0x87654321
        then check_commutativity(r_ab, r_ba) == false

    test evaluate_clauses_all_pass
        given comm = true
        and age = 10
        and r_ab = 0x12345678
        and swept = true
        then clauses = evaluate_clauses(comm, age, r_ab, swept)
        and clauses.c_imm == true
        and clauses.c_settled == true
        and clauses.c_swept == true
        and clauses.c_ind == true
        and clauses.ok == true

    test evaluate_clauses_comm_fail
        given comm = false
        and age = 5
        and r_ab = 0x12345678
        and swept = true
        then clauses = evaluate_clauses(comm, age, r_ab, swept)
        and clauses.c_imm == false
        and clauses.c_settled == true
        and clauses.ok == false

    test evaluate_clauses_settled_fail
        given comm = false
        and age = 10
        and r_ab = 0x12345678
        and swept = true
        then clauses = evaluate_clauses(comm, age, r_ab, swept)
        and clauses.c_imm == false
        and clauses.c_settled == false
        and clauses.ok == false

    test evaluate_clauses_zero_result
        given comm = true
        and age = 5
        and r_ab = 0
        and swept = true
        then clauses = evaluate_clauses(comm, age, r_ab, swept)
        and clauses.c_ind == false
        and clauses.ok == false

    test jtag_capture_word_format
        given clauses = ClauseResults{.c_imm=true, .c_settled=true, .c_swept=true, .c_ind=true, .ok=true}
        and beat = false
        then word = jtag_capture_word(clauses, beat)
        and (word >> 16) == JTAG_WORD_MAGIC
        and ((word >> 12) & 0xF) == JTAG_VERSION
        and ((word >> 6) & 0x3F) == JTAG_ID
        and (word & 1) == 1  // ok bit

    test jtag_shift_register_capture
        given sr = JTAG_DATA_INIT
        and tdi = true
        and capture = true
        and shift = false
        then next = jtag_shift_register_next(sr, tdi, capture, shift)
        and next != sr

    test jtag_shift_register_shift
        given sr = 0x80000001
        and tdi = true
        and capture = false
        and shift = true
        then next = jtag_shift_register_next(sr, tdi, capture, shift)
        and next == 0xC0000000  // tdi=1 shifted in, original MSB becomes bit 30

    test jtag_tdo_output
        given sr = 0x00000001
        then jtag_tdo_output(sr) == true

    test jtag_tdo_output_zero
        given sr = 0x00000000
        then jtag_tdo_output(sr) == false

    test live_operand_increment
        given live = 20480
        and pre = 0xFF
        then next = live_operand_next(live, pre)
        and next == 20481

    test live_operand_no_change
        given live = 20480
        and pre = 0x7F
        then next = live_operand_next(live, pre)
        and next == 20480

    // === Invariants ===

    invariant operand_field_bounds
        given k = 0xFFFF
        then op_a = extract_operand_a(k)
        and op_b = extract_operand_b(k)
        and op_a.offset >= OFFSET_BASE
        and op_a.offset < OFFSET_BASE + 8
        and op_b.offset >= OFFSET_BASE
        and op_b.offset < OFFSET_BASE + 8
        and op_a.mantissa < 512
        and op_b.mantissa < 512

    invariant clause_consistency
        given clauses = evaluate_clauses(true, 10, 0x12345678, true)
        assert clauses.ok == (clauses.c_imm and clauses.c_settled and clauses.c_ind and clauses.c_swept)

    invariant jtag_word_format
        given word = jtag_capture_word(ClauseResults{.c_imm=true, .c_settled=true, .c_swept=true, .c_ind=true, .ok=true}, true)
        assert (word >> 16) == JTAG_WORD_MAGIC
        assert ((word >> 12) & 0xF) == JTAG_VERSION
        assert ((word >> 6) & 0x3F) == JTAG_ID
}