module gft_dot4_comm_jtag;

const JTAG_CHAIN_N: u32 = 3;
const DV_WIDTH: u32 = 5;
const DV_SLOWCLK_BIT: u32 = 4;
const RSTC_WIDTH: u32 = 4;
const RSTC_DONE: u4 = 0xF;
const PRE_WIDTH: u32 = 8;
const K_WIDTH: u32 = 16;
const AGE_WIDTH: u32 = 4;
const AGE_MAX: u4 = 0xF;
const AGE_SETTLED_THRESHOLD: u4 = 8;
const SETTLE_WIDTH: u32 = 5;
const SETTLE_MAX: u5 = 0x1F;
const OPA_WIDTH: u32 = 32;
const OPB_WIDTH: u32 = 32;
const RESULT_WIDTH: u32 = 32;
const SHIFT_REG_WIDTH: u32 = 32;
const SHIFT_REG_INIT: u32 = 0xA5A5_32FC;
const WORD_MAGIC: u16 = 0xA5A5;
const WORD_VERSION: u4 = 3;
const WORD_DESIGN: u6 = 11;

struct SweepState {
    pre: u8,
    k: u16,
    swept: bool,
    beat: bool,
    age: u4,
}

struct ClauseState {
    c_imm: bool,
    c_settled: bool,
    c_swept: bool,
    c_ind: bool,
}

struct JtagState {
    shift_reg: u32,
    sel: bool,
    capture: bool,
    shift: bool,
    tdi: bool,
}

struct ModuleState {
    dv: u5,
    rstc: u4,
    rst_n: bool,
    sweep: SweepState,
    clauses: ClauseState,
    settle_counter: u5,
    live: u32,
    jtag: JtagState,
    sig: bool,
    ok: bool,
    comm: bool,
    r_ab: u32,
    r_ba: u32,
    y_ab: bool,
    y_ba: bool,
}

fn initial_state() -> ModuleState {
    return ModuleState {
        dv: 0,
        rstc: 0,
        rst_n: false,
        sweep: SweepState {
            pre: 0,
            k: 0,
            swept: false,
            beat: false,
            age: 0,
        },
        clauses: ClauseState {
            c_imm: true,
            c_settled: true,
            c_swept: false,
            c_ind: true,
        },
        settle_counter: 0,
        live: 20480,
        jtag: JtagState {
            shift_reg: SHIFT_REG_INIT,
            sel: false,
            capture: false,
            shift: false,
            tdi: false,
        },
        sig: false,
        ok: false,
        comm: false,
        r_ab: 0,
        r_ba: 0,
        y_ab: false,
        y_ba: false,
    };
}

fn dv_next(dv: u5) -> u5 {
    return dv + 1;
}

fn slowclk_from_dv(dv: u5) -> bool {
    return (dv >> DV_SLOWCLK_BIT) & 1 == 1;
}

fn rstc_next(rstc: u4) -> u4 {
    if (rstc == RSTC_DONE) {
        return rstc;
    }
    return rstc + 1;
}

fn rst_n_from_rstc(rstc: u4) -> bool {
    return rstc == RSTC_DONE;
}

fn opA_from_k(k: u16) -> u32 {
    const sgnA: bool = (k >> 15) & 1 == 1;
    const offA: u7 = 35 + (u7)((k >> 10) & 0xF);
    const manA: u9 = u9(k & 0x1FF);
    return (u32(offA) << 9) | u32(manA) | (u32(sgnA) << 16);
}

fn opB_from_k(k: u16) -> u32 {
    const sgnB: bool = (k >> 14) & 1 == 1;
    const offB: u7 = 35 + (u7)((k >> 6) & 0xF);
    const manB: u9 = ((k & 0x3F) << 3) | ((k >> 6) & 0x7);
    return (u32(offB) << 9) | u32(manB) | (u32(sgnB) << 16);
}

fn sweep_next(sweep: SweepState, slowclk: bool, rst_n: bool) -> SweepState {
    if (!slowclk || !rst_n) {
        return sweep;
    }
    var next = sweep;
    next.pre = sweep.pre + 1;
    if (sweep.pre == 0) {
        next.age = 0;
        next.beat = !sweep.beat;
        if (sweep.k == 0xFFFF) {
            next.swept = true;
        } else {
            next.k = sweep.k + 1;
        }
    } else if (sweep.age != AGE_MAX) {
        next.age = sweep.age + 1;
    }
    return next;
}

fn live_next(live: u32, pre: u8) -> u32 {
    if (pre == 0) {
        return live + 1;
    }
    return live;
}

fn gft_signed_dot4_ab(opA: u32, opB: u32, live: u32, slowclk: bool, rst_n: bool) -> (bool, u32) {
    undefined;
}

fn gft_signed_dot4_ba(opA: u32, opB: u32, live: u32, slowclk: bool, rst_n: bool) -> (bool, u32) {
    undefined;
}

fn comm_check(r_ab: u32, r_ba: u32) -> bool {
    return r_ab == r_ba;
}

fn settle_counter_next(settle: u5, rst_n: bool) -> u5 {
    if (!rst_n) {
        return settle;
    }
    if (settle == SETTLE_MAX) {
        return settle;
    }
    return settle + 1;
}

fn clauses_next(clauses: ClauseState, settle: u5, comm: bool, age: u4, swept: bool, r_ab: u32) -> ClauseState {
    var next = clauses;
    if (settle == SETTLE_MAX) {
        if (!comm) {
            next.c_imm = false;
        }
        if (!comm && age >= AGE_SETTLED_THRESHOLD) {
            next.c_settled = false;
        }
        if (r_ab == 0) {
            next.c_ind = false;
        }
        next.c_swept = swept;
    }
    return next;
}

fn sig_from_clauses(clauses: ClauseState) -> bool {
    return clauses.c_imm & clauses.c_settled & clauses.c_ind & clauses.c_swept;
}

fn bscane2_simulate() -> (bool, bool, bool, bool, bool) {
    undefined;
}

fn jtag_next(jtag: JtagState, drck: bool, sel: bool, capture: bool, shift: bool, tdi: bool,
             c_imm: bool, c_settled: bool, c_swept: bool, c_ind: bool, beat: bool, ok: bool) -> (JtagState, bool) {
    var next = jtag;
    var tdo = false;
    if (drck && sel) {
        if (capture) {
            next.shift_reg = (u32(WORD_MAGIC) << 16) |
                             (u32(WORD_VERSION) << 12) |
                             (u32(WORD_DESIGN) << 6) |
                             (u32(c_imm) << 5) |
                             (u32(c_settled) << 4) |
                             (u32(c_swept) << 3) |
                             (u32(c_ind) << 2) |
                             (u32(beat) << 1) |
                             u32(ok);
        } else if (shift) {
            tdo = (next.shift_reg & 1) == 1;
            next.shift_reg = (u32(tdi) << 31) | (next.shift_reg >> 1);
        }
    }
    return (next, tdo);
}

fn step(state: ModuleState, drck: bool, sel: bool, capture: bool, shift: bool, tdi: bool) -> ModuleState {
    var next = state;
    next.dv = dv_next(state.dv);
    const slowclk = slowclk_from_dv(next.dv);
    next.rstc = rstc_next(state.rstc);
    next.rst_n = rst_n_from_rstc(next.rstc);
    next.sweep = sweep_next(state.sweep, slowclk, next.rst_n);
    next.live = live_next(state.live, state.sweep.pre);
    const opA = opA_from_k(state.sweep.k);
    const opB = opB_from_k(state.sweep.k);
    if (slowclk && next.rst_n) {
        (next.y_ab, next.r_ab) = gft_signed_dot4_ab(opA, opB, state.live, slowclk, next.rst_n);
        (next.y_ba, next.r_ba) = gft_signed_dot4_ba(opA, opB, state.live, slowclk, next.rst_n);
    }
    next.comm = comm_check(next.r_ab, next.r_ba);
    next.settle_counter = settle_counter_next(state.settle_counter, next.rst_n);
    next.clauses = clauses_next(state.clauses, state.settle_counter, next.comm, state.sweep.age, state.sweep.swept, next.r_ab);
    next.sig = sig_from_clauses(next.clauses);
    next.ok = next.sig;
    (next.jtag, _) = jtag_next(state.jtag, drck, sel, capture, shift, tdi,
                               next.clauses.c_imm, next.clauses.c_settled,
                               next.clauses.c_swept, next.clauses.c_ind,
                               next.sweep.beat, next.ok);
    return next;
}

fn tdo_from_state(state: ModuleState) -> bool {
    return (state.jtag.shift_reg & 1) == 1;
}

test opA_from_k_basic {
    const k: u16 = 0x8000;
    const opA = opA_from_k(k);
    assert((opA >> 16) & 1 == 1);
}

test opB_from_k_basic {
    const k: u16 = 0x4000;
    const opB = opB_from_k(k);
    assert((opB >> 16) & 1 == 1);
}

test sweep_pre_overflow {
    var sweep = SweepState { pre: 255, k: 0, swept: false, beat: false, age: 0 };
    sweep = sweep_next(sweep, true, true);
    assert(sweep.pre == 0);
    assert(sweep.k == 1);
    assert(sweep.age == 0);
    assert(sweep.beat == true);
}

test sweep_k_max {
    var sweep = SweepState { pre: 255, k: 0xFFFF, swept: false, beat: false, age: 0 };
    sweep = sweep_next(sweep, true, true);
    assert(sweep.swept == true);
    assert(sweep.k == 0xFFFF);
}

test settle_counter_saturates {
    var settle: u5 = SETTLE_MAX;
    settle = settle_counter_next(settle, true);
    assert(settle == SETTLE_MAX);
}

test clauses_c_imm_cleared {
    var clauses = ClauseState { c_imm: true, c_settled: true, c_swept: false, c_ind: true };
    clauses = clauses_next(clauses, SETTLE_MAX, false, 10, false, 123);
    assert(clauses.c_imm == false);
}

test clauses_c_settled_cleared {
    var clauses = ClauseState { c_imm: true, c_settled: true, c_swept: false, c_ind: true };
    clauses = clauses_next(clauses, SETTLE_MAX, false, 10, false, 123);
    assert(clauses.c_settled == false);
}

test clauses_c_settled_not_cleared_when_age_low {
    var clauses = ClauseState { c_imm: true, c_settled: true, c_swept: false, c_ind: true };
    clauses = clauses_next(clauses, SETTLE_MAX, false, 5, false, 123);
    assert(clauses.c_settled == true);
}

test clauses_c_ind_cleared {
    var clauses = ClauseState { c_imm: true, c_settled: true, c_swept: false, c_ind: true };
    clauses = clauses_next(clauses, SETTLE_MAX, true, 10, false, 0);
    assert(clauses.c_ind == false);
}

test clauses_c_swept_set {
    var clauses = ClauseState { c_imm: true, c_settled: true, c_swept: false, c_ind: true };
    clauses = clauses_next(clauses, SETTLE_MAX, true, 10, true, 123);
    assert(clauses.c_swept == true);
}

test sig_combines_all_clauses {
    const clauses = ClauseState { c_imm: true, c_settled: true, c_swept: true, c_ind: true };
    assert(sig_from_clauses(clauses) == true);
    const clauses2 = ClauseState { c_imm: false, c_settled: true, c_swept: true, c_ind: true };
    assert(sig_from_clauses(clauses2) == false);
}

test jtag_capture_loads_word {
    var jtag = JtagState { shift_reg: 0, sel: true, capture: true, shift: false, tdi: false };
    const (next_jtag, tdo) = jtag_next(jtag, true, true, true, false, false,
                                       true, true, true, true, false, true);
    assert((next_jtag.shift_reg >> 16) & 0xFFFF == WORD_MAGIC);
    assert((next_jtag.shift_reg >> 12) & 0xF == WORD_VERSION);
    assert((next_jtag.shift_reg >> 6) & 0x3F == WORD_DESIGN);
    assert((next_jtag.shift_reg >> 5) & 1 == 1);
    assert((next_jtag.shift_reg >> 4) & 1 == 1);
    assert((next_jtag.shift_reg >> 3) & 1 == 1);
    assert((next_jtag.shift_reg >> 2) & 1 == 1);
    assert((next_jtag.shift_reg >> 1) & 1 == 0);
    assert(next_jtag.shift_reg & 1 == 1);
}

test jtag_shift_outputs_lsb {
    var jtag = JtagState { shift_reg: 0b101, sel: true, capture: false, shift: true, tdi: false };
    const (next_jtag, tdo) = jtag_next(jtag, true, true, false, true, false,
                                       true, true, true, true, false, true);
    assert(tdo == true);
    assert(next_jtag.shift_reg == 0b010);
}

test jtag_shift_inputs_tdi {
    var jtag = JtagState { shift_reg: 0b101, sel: true, capture: false, shift: true, tdi: true };
    const (next_jtag, tdo) = jtag_next(jtag, true, true, false, true, true,
                                       true, true, true, true, false, true);
    assert(next_jtag.shift_reg == 0b1101);
}

invariant initial_state_valid {
    const state = initial_state();
    assert(state.dv == 0);
    assert(state.rstc == 0);
    assert(state.rst_n == false);
    assert(state.sweep.pre == 0);
    assert(state.sweep.k == 0);
    assert(state.sweep.swept == false);
    assert(state.clauses.c_imm == true);
    assert(state.clauses.c_settled == true);
    assert(state.clauses.c_ind == true);
    assert(state.live == 20480);
    assert(state.jtag.shift_reg == SHIFT_REG_INIT);
}