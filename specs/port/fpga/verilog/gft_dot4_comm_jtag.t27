// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/verilog/gft_dot4_comm_jtag.t27
// GFT Dot-4 Commutativity Test JTAG Wrapper
// Tests commutativity of GftSignedDot4 with operand-flipped instances
// Generated from gHashTag/t27#5305
// phi^2 + 1/phi^2 = 3 | TRINITY

module gft_dot4_comm_jtag {

    // === Module parameters ===

    pub const JTAG_CHAIN_N_DEFAULT : u32 = 3;

    // === JTAG shift register word format ===
    // {16'hA5A5, 4'd3, 6'd11, c_imm, c_settled, c_swept, c_ind, beat, ok}

    pub const JTAG_DATA_MASK : u32 = 0xFFFFFFFF;
    pub const JTAG_CONSTANT : u32 = 0xA5A532FC;
    pub const JTAG_IMM_SHIFT : u32 = 24;
    pub const JTAG_SETTLED_SHIFT : u32 = 23;
    pub const JTAG_SWEPT_SHIFT : u32 = 22;
    pub const JTAG_IND_SHIFT : u32 = 21;
    pub const JTAG_BEAT_SHIFT : u32 = 20;
    pub const JTAG_OK_SHIFT : u32 = 19;

    pub struct JtagWord {
        constant : u32,
        version : u32,
        reserved : u32,
        c_imm : bool,
        c_settled : bool,
        c_swept : bool,
        c_ind : bool,
        beat : bool,
        ok : bool,
    }

    // === Sweep state ===

    pub struct SweepState {
        pre : u8,
        k : u16,
        swept : bool,
        beat : bool,
        age : u4,
    }

    pub struct ResetState {
        counter : u4,
        reset_n : bool,
    }

    pub struct ClauseState {
        c_imm : bool,
        c_settled : bool,
        c_swept : bool,
        c_ind : bool,
        settle_counter : u5,
        sig : bool,
    }

    pub const SETTLE_COUNTER_MAX : u5 = 31;

    // === Constructor functions ===

    fn jtag_word(c_imm: bool, c_settled: bool, c_swept: bool, c_ind: bool, 
                 beat: bool, ok: bool) -> JtagWord {
        return JtagWord{
            .constant = 0xA5A5,
            .version = 3,
            .reserved = 11,
            .c_imm = c_imm,
            .c_settled = c_settled,
            .c_swept = c_swept,
            .c_ind = c_ind,
            .beat = beat,
            .ok = ok,
        };
    }

    fn sweep_state() -> SweepState {
        return SweepState{
            .pre = 0,
            .k = 0,
            .swept = false,
            .beat = false,
            .age = 0,
        };
    }

    fn reset_state() -> ResetState {
        return ResetState{
            .counter = 0,
            .reset_n = false,
        };
    }

    fn clause_state() -> ClauseState {
        return ClauseState{
            .c_imm = true,
            .c_settled = true,
            .c_swept = false,
            .c_ind = true,
            .settle_counter = 0,
            .sig = false,
        };
    }

    // === Clock and reset logic ===

    fn update_reset(state: ResetState, slowclk_rise: bool) -> ResetState {
        var next_state = state;
        if (slowclk_rise and state.counter != 15) {
            next_state.counter = state.counter + 1;
        }
        next_state.reset_n = (state.counter == 15);
        return next_state;
    }

    fn update_sweep(state: SweepState, slowclk_rise: bool) -> SweepState {
        var next_state = state;
        
        if (slowclk_rise) {
            next_state.pre = state.pre + 1;
            
            if (state.pre == 255) {
                next_state.age = 0;
                next_state.beat = !state.beat;
                
                if (state.k == 65535) {
                    next_state.swept = true;
                } else {
                    next_state.k = state.k + 1;
                }
            } else if (state.age != 15) {
                next_state.age = state.age + 1;
            }
        }
        
        return next_state;
    }

    // === Operand generation ===

    fn generate_operand_a(k: u16) -> u32 {
        var sgn = (k >> 15) & 1;
        var off = 35 + ((k >> 10) & 7);
        var man = k & 0x1FF;
        return (sgn << 31) | (off << 24) | man;
    }

    fn generate_operand_b(k: u16) -> u32 {
        var sgn = (k >> 14) & 1;
        var off = 35 + ((k >> 6) & 7);
        var man = ((k & 0x3F) << 3) | ((k >> 6) & 7);
        return (sgn << 31) | (off << 24) | man;
    }

    fn generate_live_operand(base: u32, increment: u32) -> u32 {
        return base + increment;
    }

    // === Commutativity testing ===

    fn check_commutativity(r_ab: u32, r_ba: u32) -> bool {
        return r_ab == r_ba;
    }

    fn update_clauses(state: ClauseState, comm: bool, r_ab: u32, age: u4, 
                     rst_n: bool, swept: bool) -> ClauseState {
        var next_state = state;
        
        if (rst_n and state.settle_counter != (SETTLE_COUNTER_MAX : u5)) {
            next_state.settle_counter = state.settle_counter + 1;
        }
        
        if (state.settle_counter == (SETTLE_COUNTER_MAX : u5)) {
            if (!comm) {
                next_state.c_imm = false;
            }
            if (!comm and age >= 8) {
                next_state.c_settled = false;
            }
            if (r_ab == 0) {
                next_state.c_ind = false;
            }
            next_state.c_swept = swept;
            next_state.sig = state.c_imm and state.c_settled and state.c_ind and swept;
        }
        
        return next_state;
    }

    fn jtag_capture_word(c_imm: bool, c_settled: bool, c_swept: bool, c_ind: bool,
                        beat: bool, ok: bool) -> u32 {
        var word = jtag_word(c_imm, c_settled, c_swept, c_ind, beat, ok);
        return (word.constant << 16) | (word.version << 12) | (word.reserved << 6) |
               ((if word.c_imm { 1 } else { 0 }) << JTAG_IMM_SHIFT) |
               ((if word.c_settled { 1 } else { 0 }) << JTAG_SETTLED_SHIFT) |
               ((if word.c_swept { 1 } else { 0 }) << JTAG_SWEPT_SHIFT) |
               ((if word.c_ind { 1 } else { 0 }) << JTAG_IND_SHIFT) |
               ((if word.beat { 1 } else { 0 }) << JTAG_BEAT_SHIFT) |
               ((if word.ok { 1 } else { 0 }) << JTAG_OK_SHIFT);
    }

    fn jtag_shift_word(word: u32, tdi: bool) -> u32 {
        return ((if tdi { 1 } else { 0 }) << 31) | (word >> 1);
    }

    fn jtag_tdo(word: u32) -> bool {
        return (word & 1) != 0;
    }

    // === Tests ===

    test jtag_word_format
        given word = jtag_word(true, false, true, false, true, false)
        then word.constant == 0xA5A5
        and word.version == 3
        and word.reserved == 11
        and word.c_imm == true
        and word.c_settled == false
        and word.c_swept == true
        and word.c_ind == false
        and word.beat == true
        and word.ok == false

    test jtag_capture_format
        given word = jtag_capture_word(true, false, true, false, true, false)
        then (word >> JTAG_IMM_SHIFT) & 1 == 1
        and (word >> JTAG_SETTLED_SHIFT) & 1 == 0
        and (word >> JTAG_SWEPT_SHIFT) & 1 == 1
        and (word >> JTAG_IND_SHIFT) & 1 == 0
        and (word >> JTAG_BEAT_SHIFT) & 1 == 1
        and (word >> JTAG_OK_SHIFT) & 1 == 0
        and (word & 0xFFFF) == 0xA5A5
        and ((word >> 12) & 15) == 3
        and ((word >> 6) & 63) == 11

    test jtag_shift_operation
        given word1 = 0x12345678
        and tdi = true
        then jtag_shift_word(word1, tdi) == 0x91A2B34
        and jtag_tdo(word1) == (0x78 & 1) != 0

    test operand_generation_a
        given k = 0b1000000000000001  // sgn=1, off=35+0=35, man=1
        then generate_operand_a(k) == 0b10000000001000100000000000000001
        // sgn=1 << 31, off=35 << 24, man=1

    test operand_generation_b
        given k = 0b0100000000000001  // sgn=0, off=35+0=35, man=0b000001000
        then generate_operand_b(k) == 0b00000000001000100000000100000000
        // sgn=0 << 31, off=35 << 24, man=0b000001000 << 0 = 0x0080

    test commutativity_check
        given r_ab = 0x12345678
        and r_ba = 0x12345678
        then check_commutativity(r_ab, r_ba) == true
        and check_commutativity(r_ab, r_ba + 1) == false

    test reset_state_update
        given state = reset_state()
        and slowclk_rise = true
        then update_reset(state, slowclk_rise).counter == 1
        and update_reset(state, slowclk_rise).reset_n == false
        and update_reset(state, false).counter == state.counter

    test sweep_state_update_increment
        given state = sweep_state()
        and slowclk_rise = true
        then update_sweep(state, slowclk_rise).pre == 1
        and update_sweep(state, slowclk_rise).k == 0
        and update_sweep(state, slowclk_rise).beat == true
        and update_sweep(state, slowclk_rise).age == 0

    test sweep_state_update_k_increment
        given state = SweepState{.pre = 255, .k = 100, .swept = false, .beat = false, .age = 0}
        and slowclk_rise = true
        then update_sweep(state, slowclk_rise).k == 101
        and update_sweep(state, slowclk_rise).beat == true
        and update_sweep(state, slowclk_rise).age == 0

    test sweep_state_update_swept
        given state = SweepState{.pre = 255, .k = 65535, .swept = false, .beat = false, .age = 0}
        and slowclk_rise = true
        then update_sweep(state, slowclk_rise).swept == true
        and update_sweep(state, slowclk_rise).k == 100  // wraps around

    test clause_update_no_change
        given state = clause_state()
        and comm = true
        and r_ab = 1
        and age = 10
        and rst_n = true
        and swept = true
        then update_clauses(state, comm, r_ab, age, rst_n, swept).c_imm == true
        and update_clauses(state, comm, r_ab, age, rst_n, swept).c_settled == true
        and update_clauses(state, comm, r_ab, age, rst_n, swept).c_swept == true
        and update_clauses(state, comm, r_ab, age, rst_n, swept).c_ind == true
        and update_clauses(state, comm, r_ab, age, rst_n, swept).sig == true

    test clause_update_imm_fail
        given state = clause_state()
        and comm = false
        and r_ab = 1
        and age = 5
        and rst_n = true
        and swept = true
        then update_clauses(state, comm, r_ab, age, rst_n, swept).c_imm == false
        and update_clauses(state, comm, r_ab, age, rst_n, swept).c_settled == true  // age < 8

    test clause_update_settled_fail
        given state = clause_state()
        and comm = false
        and r_ab = 1
        and age = 10
        and rst_n = true
        and swept = true
        then update_clauses(state, comm, r_ab, age, rst_n, swept).c_imm == false
        and update_clauses(state, comm, r_ab, age, rst_n, swept).c_settled == false

    test clause_update_ind_fail
        given state = clause_state()
        and comm = true
        and r_ab = 0
        and age = 10
        and rst_n = true
        and swept = true
        then update_clauses(state, comm, r_ab, age, rst_n, swept).c_ind == false
        and update_clauses(state, comm, r_ab, age, rst_n, swept).sig == false

    // === Invariants ===

    invariant jtag_word_constants
        given word = jtag_word(true, true, true, true, true, true)
        assert word.constant == 0xA5A5
        and word.version == 3
        and word.reserved == 11

    invariant reset_state_progress
        given state = reset_state()
        assert state.counter <= 15
        and state.reset_n == (state.counter == 15)

    invariant sweep_state_bounds
        given state = sweep_state()
        assert state.pre <= 255
        and state.k <= 65535
        and state.age <= 15
        and state.swept == (state.k == 65535)

    invariant clause_state_values
        given state = clause_state()
        assert state.settle_counter <= 31
        and state.sig == (state.c_imm and state.c_settled and state.c_ind and state.c_swept)

    invariant operand_generation_range
        given k = 65535
        assert generate_operand_a(k) <= 0xFFFFFFFF
        and generate_operand_b(k) <= 0xFFFFFFFF
        and generate_operand_a(0) >= 0
        and generate_operand_b(0) >= 0

    // === Benchmarks ===

    bench commutativity_check_latency
        measure: nanoseconds to check_commutativity(0x12345678, 0x12345678)
        target: < 10ns

    bench operand_generation_latency
        measure: nanoseconds to generate_operand_a(0x1234)
        target: < 20ns

    bench clause_update_latency
        measure: nanoseconds to update_clauses(clause_state(), true, 1, 10, true, true)
        target: < 50ns
}