module gft_dup3_jtag;

const JTAG_CHAIN_N: u32 = 3;

const LIVE_SEED: u32 = 20480;   // 1.0
const LIVE2_SEED: u32 = 21504;  // 1.05
const LIVE_STRIDE: u32 = 1;
const LIVE2_STRIDE: u32 = 7;
const ONE_VAL: u32 = 20480;     // 1.0
const ZERO_VAL: u32 = 0;

// === JTAG Constants ===
const CAPTURE_HEADER: u32 = 0xA5A5;
const CAPTURE_FLAGS: u32 = 0x033F; // Will be overridden by status bits
const CAPTURE_TAIL: u32 = 0x000C;
const SR_INIT: u32 = 0xA5A5343C;   // Initial shift register value

// === State Structures ===
struct VerifyState {
    c_init: bool,
    c_self: bool,
    c_comm: bool,
    c_ind: bool
}

struct CounterState {
    pre: u32,
    beat: bool,
    live: u32,
    live2: u32
}

struct GftSmulState {
    ready: bool,
    result: u32
}

struct JtagState {
    shift_reg: u32,
    capture: bool,
    shift: bool,
    tdi: bool
}

struct ModuleState {
    verify: VerifyState,
    counters: CounterState,
    u_self_a: GftSmulState,
    u_self_b: GftSmulState,
    u_comm_a: GftSmulState,
    u_comm_b: GftSmulState,
    u_ind: GftSmulState,
    u_fold1: GftSmulState,
    u_fold2: GftSmulState,
    jtag: JtagState
}

// === Initial State ===
fn initial_verify() -> VerifyState {
    VerifyState{
        .c_init = true,
        .c_self = true,
        .c_comm = true,
        .c_ind = true,
    }
}

fn initial_counters() -> CounterState {
    CounterState{
        .pre = 0,
        .beat = false,
        .live = LIVE_SEED,
        .live2 = LIVE2_SEED,
    }
}

fn initial_gftsmul() -> GftSmulState {
    GftSmulState{
        .ready = false,
        .result = 0,
    }
}

fn initial_jtag() -> JtagState {
    JtagState{
        .shift_reg = SR_INIT,
        .capture = false,
        .shift = false,
        .tdi = false,
    }
}

fn initial_state() -> ModuleState {
    ModuleState{
        .verify = initial_verify(),
        .counters = initial_counters(),
        .u_self_a = initial_gftsmul(),
        .u_self_b = initial_gftsmul(),
        .u_comm_a = initial_gftsmul(),
        .u_comm_b = initial_gftsmul(),
        .u_ind = initial_gftsmul(),
        .u_fold1 = initial_gftsmul(),
        .u_fold2 = initial_gftsmul(),
        .jtag = initial_jtag(),
    }
}

// === GftSmul Simulation ===
// Simplified GftSmul model: result = a * b (in their fixed-point format)
// In reality, this is a complex multiplier, but for functional equivalence
// we only need to know if two instances produce the same result.
fn simulate_gftsmul(_clk: bool, _rst_n: bool, _en: bool, a: u32, b: u32) -> GftSmulState {
    // In the actual hardware, this is a pipelined multiplier with latency.
    // For functional checking of equivalence, we can use a combinatorial model.
    // The key point is that u_self_a and u_self_b should produce the same result
    // when given the same inputs, and u_comm_a and u_comm_b should produce
    // the same result when given swapped inputs.
    let product = a.wrapping_mul(b);
    // Note: The actual GftSmul has internal state and latency, but since we're
    // only checking equality of results from identical/swapped operations,
    // a combinatorial model suffices for equivalence checking.
    GftSmulState{
        .ready = true,  // Assume always ready for simplicity
        .result = product,
    }
}

// === Next State Logic ===
fn update_verify(state: ModuleState, rst_n: bool) -> VerifyState {
    VerifyState{
        .c_init = state.verify.c_init,  // Only changes via reset in Verilog? Actually, it's a register that's only set initially
        .c_self = state.verify.c_self,
        .c_comm = state.verify.c_comm,
        .c_ind = state.verify.c_ind,
    }
}

fn update_counters(state: ModuleState, rst_n: bool, slowclk: bool) -> CounterState {
    var new_pre = state.counters.pre;
    var new_beat = state.counters.beat;
    var new_live = state.counters.live;
    var new_live2 = state.counters.live2;
    
    if (rst_n) {
        if (slowclk) {
            new_pre = state.counters.pre + 1;
            if (state.counters.pre == 0) {  // Actually, pre == 24'd0 in Verilog, but we're simplifying
                new_beat = !state.counters.beat;
                new_live = state.counters.live + LIVE_STRIDE;
                new_live2 = state.counters.live2 + LIVE2_STRIDE;
            }
        }
    } else {
        new_pre = 0;
        new_beat = false;
        new_live = LIVE_SEED;
        new_live2 = LIVE2_SEED;
    }
    
    return CounterState{
        .pre = new_pre,
        .beat = new_beat,
        .live = new_live,
        .live2 = new_live2,
    }
}

fn update_gftsmul(state: GftSmulState, rst_n: bool, slowclk: bool, en: bool, a: u32, b: u32) -> GftSmulState {
    if (!rst_n) {
        return initial_gftsmul();
    }
    
    // In the actual hardware, GftSmul has internal state and latency.
    // For our purposes, we model it as a combinatorial function with a ready flag.
    // The ready flag would be true after some latency, but since we're only
    // checking equality of results at the same time, and all instances
    // experience the same clocking, we can set ready immediately.
    if (en) {
        let result = simulate_gftsmul(slowclk, rst_n, true, a, b);
        return result;
    } else {
        return state;  // Hold state when not enabled
    }
}

fn update_jtag(state: ModuleState, capture: bool, shift: bool, tdi: bool) -> JtagState {
    var new_sr = state.jtag.shift_reg;
    
    if (capture) {
        // Capture the current state into the shift register
        // Format: {16'hA5A5, 4'd3, 6'd16, c_init, c_self, c_comm, c_ind, beat, ok}
        let init_bit: u32 = if (state.verify.c_init) 1 else 0;
        let self_bit: u32 = if (state.verify.c_self) 1 else 0;
        let comm_bit: u32 = if (state.verify.c_comm) 1 else 0;
        let ind_bit: u32 = if (state.verify.c_ind) 1 else 0;
        let beat_bit: u32 = if (state.counters.beat) 1 else 0;
        let ok_bit: u32 = if (get_ok_signal(state)) 1 else 0;
        
        new_sr = (CAPTURE_HEADER << 16) | 
                 (0x3 << 12) | 
                 (0x10 << 6) |
                 (init_bit << 5) |
                 (self_bit << 4) |
                 (comm_bit << 3) |
                 (ind_bit << 2) |
                 (beat_bit << 1) |
                 (ok_bit << 0);
    } else if (shift) {
        // Shift in TDI
        let tdi_bit: u32 = if (tdi) 1 else 0;
        new_sr = (tdi_bit << 31) | (state.jtag.shift_reg >> 1);
    }
    
    return JtagState{
        .shift_reg = new_sr,
        .capture = capture,
        .shift = shift,
        .tdi = tdi,
    }
}

fn get_ok_signal(state: ModuleState) -> bool {
    // ok = sig, and sig is updated only when settle == 5'h1F
    // For simplicity in functional equivalence, we'll compute the raw ok value
    // as the AND of all status bits and their qualifiers.
    // In the actual hardware, sig is a delayed version, but for equivalence
    // checking of the status signals themselves, this should be fine.
    let init_ok = (state.u_ind.result == 0x5A5A1234);  // initprobe check
    let self_ok = (state.u_self_a.result == state.u_self_b.result);
    let comm_ok = (state.u_comm_a.result == state.u_comm_b.result);
    let ind_ok = check_ind_test(state);
    
    // In the actual hardware, c_init etc. are qualifiers that start as 1 and
    // can be cleared to 0. For equivalence checking, we want to know if
    // the underlying conditions are true.
    return init_ok && self_ok && comm_ok && ind_ok;
}

fn check_ind_test(state: ModuleState) -> bool {
    // ind_ok = (r_ind != 0) && (r_fold1 == 0) && (r_fold2 == ONE)
    let r_ind = state.u_ind.result;
    let r_fold1 = state.u_fold1.result;
    let r_fold2 = state.u_fold2.result;
    
    return (r_ind != 0) && (r_fold1 == 0) && (r_fold2 == ONE_VAL);
}

// === State Update ===
fn update_state(state: ModuleState) -> ModuleState {
    // Derived signals
    let rst_n = (state.counters.pre == 0xFFFFFF);  // Simplified: rst_n is true when not in reset
    // Actually, from Verilog: rst_n = (rstc == 4'hF), and rstc increments when rstc != 4'hF
    // We're simplifying the reset logic for functional equivalence
    
    let slowclk = false;  // We'll derive this from the pre counter - simplified
    // In actual hardware: slowclk is buffed version of dv[2], where dv increments every cfgmclk
    // and cfgmclk comes from STARTUPE2. We're simplifying to focus on the functional logic.
    
    // For proper timing, we need to model the clock division.
    // Let's model the dv counter and bufg as in the original.
    // But to keep it simple for functional equivalence, we'll assume
    // slowclk ticks when pre wraps around.
    
    // Actually, let's properly model the clock generation:
    // dv: 3-bit counter that increments every cfgmclk
    // slowclk = buf(g) of dv[2]
    // pre: 24-bit counter that increments every slowclk
    // 
    // Since we don't have cfgmclk modeled, we'll approximate:
    // Assume that cfgmclk is fast enough that we can model slowclk as
    // ticking periodically. For functional equivalence of the counters
    // and comparisons, the exact timing doesn't matter as long as
    // the sequence of states is correct.
    
    // We'll model slowclk as ticking every 8th cycle (since dv is 3-bit,
    // and buf(g) of dv[2] means slowclk ticks when dv[2] changes from 0 to 1
    // or 1 to 0? Actually, buf(g) just buffers, so slowclk = dv[2])
    // 
    // Given the complexity and that we're focused on functional equivalence
    // of the multiplier results and comparisons, we'll simplify by making
    // slowclk a boolean that we toggle appropriately.
    //
    // For now, let's use a simple approach: slowclk ticks when pre == 0
    // (which happens every 2^24 cycles of slowclk, but we're not modeling
    // the actual frequency ratio).
    //
    // Actually, looking at the Verilog:
    //   always @(posedge slowclk) begin
    //       pre <= pre + 24'd1;
    //       if (pre == 24'd0) begin
    //           beat  <= ~beat;
    //           live  <= live  + 32'd1;
    //           live2 <= live2 + 32'd7;
    //       end
    //   end
    //
    // So pre increments on every slowclk, and when pre wraps (after 2^24 slowclk cycles),
    // we update beat, live, live2.
    //
    // For functional equivalence, we don't need to model the exact 2^24 divider;
    // we just need to ensure that live and live2 are updated periodically
    // and that the updates happen in lockstep.
    //
    // We'll model a "beat" signal that ticks when we want to update the counters.
    // Let's say we update counters every N cycles for some N.
    // To keep it simple, we'll update on every call to update_state for now,
    // but that would make the counters increment too fast.
    //
    // Given the complexity and that the key property being checked is
    // the equivalence of the multipliers (which depends on the values of live
    // and live2 at the time of multiplication), we need to ensure that
    // the multipliers see the same live/live2 values that they would in hardware.
    //
    // Since all u_* instances are clocked by the same slowclk, and we're
    // only checking equality of results, we can assume that if we update
    // the counters at the same rate for all instances, the equivalence
    // property will hold.
    //
    // For simplicity in this functional model, we'll update the counters
    // on every update_state call, and assume that the GftSmul instances
    // are also updated every call (which corresponds to every slowclk cycle).
    // This should preserve the equivalence relationships.
    //
    // If we wanted to be more precise, we would need to model the dv counter
    // and the bufg, but that would significantly increase complexity.
    // Given that the equivalence checking is the goal, and the counters
    // are just providing changing inputs to the multipliers, a simplified
    // model should suffice as long as the inputs change in a way that
    // allows the equivalence properties to be checked.
    
    let slowclk = true;  // Simplified: assume every update is a slowclk cycle
    
    // Update counters
    let new_counters = update_counters(state, rst_n, slowclk);
    
    // Update GftSmul instances
    let new_u_self_a = update_gftsmul(
        state.u_self_a, rst_n, slowclk, true,
        state.counters.live, TWO_VAL);  // TWO_VAL = 2 * ONE_VAL
    
    let new_u_self_b = update_gftsmul(
        state.u_self_b, rst_n, slowclk, true,
        state.counters.live, TWO_VAL);
    
    let new_u_comm_a = update_gftsmul(
        state.u_comm_a, rst_n, slowclk, true,
        state.counters.live, TWO_VAL);
    
    let new_u_comm_b = update_gftsmul(
        state.u_comm_b, rst_n, slowclk, true,
        TWO_VAL, state.counters.live);
    
    let new_u_ind = update_gftsmul(
        state.u_ind, rst_n, slowclk, true,
        state.counters.live, state.counters.live2);
    
    let new_u_fold1 = update_gftsmul(
        state.u_fold1, rst_n, slowclk, true,
        ZERO_VAL, state.counters.live);
    
    let new_u_fold2 = update_gftsmul(
        state.u_fold2, rst_n, slowclk, true,
        ONE_VAL, ONE_VAL);
    
    // Update verification flags (these are registers that only change via reset)
    let new_verify = update_verify(state, rst_n);
    
    // Update JTAG
    let new_jtag = update_jtag(
        state, 
        false,  // capture - we don't have capture signal in this simplified model
        false,  // shift
        false); // tdi
    
    return ModuleState{
        .verify = new_verify,
        .counters = new_counters,
        .u_self_a = new_u_self_a,
        .u_self_b = new_u_self_b,
        .u_comm_a = new_u_comm_a,
        .u_comm_b = new_u_comm_b,
        .u_ind = new_u_ind,
        .u_fold1 = new_u_fold1,
        .u_fold2 = new_u_fold2,
        .jtag = new_jtag,
    };
}

// === JTAG Interface (for testbench) ===
fn tick_jtag(state: ModuleState, capture: bool, shift: bool, tdi: bool) -> ModuleState {
    // Derived signals (same as in update_state)
    let rst_n = true;  // Simplified
    let slowclk = true;  // Simplified
    
    // Update counters (would normally happen on slowclk, but JTAG is async)
    // For simplicity, we'll not update counters during JTAG operations
    // in this functional model, as JTAG is used for reading status, not
    // for changing the functional behavior.
    let new_counters = state.counters;
    
    // Update GftSmul instances (hold state during JTAG)
    let new_u_self_a = state.u_self_a;
    let new_u_self_b = state.u_self_b;
    let new_u_comm_a = state.u_comm_a;
    let new_u_comm_b = state.u_comm_b;
    let new_u_ind = state.u_ind;
    let new_u_fold1 = state.u_fold1;
    let new_u_fold2 = state.u_fold2;
    
    // Update verification flags
    let new_verify = state.verify;
    
    // Update JTAG
    let new_jtag = update_jtag(state, capture, shift, tdi);
    
    return ModuleState{
        .verify = new_verify,
        .counters = new_counters,
        .u_self_a = new_u_self_a,
        .u_self_b = new_u_self_b,
        .u_comm_a = new_u_comm_a,
        .u_comm_b = new_u_comm_b,
        .u_ind = new_u_ind,
        .u_fold1 = new_u_fold1,
        .u_fold2 = new_u_fold2,
        .jtag = new_jtag,
    };
}

// === Helper Functions ===
fn get_rst_n(state: ModuleState) -> bool {
    // Simplified: always out of reset for functional equivalence
    return true;
}

fn get_slowclk(state: ModuleState) -> bool {
    // Simplified: assume we're always on a slowclk edge for updates
    return true;
}

const TWO_VAL: u32 = 2 * ONE_VAL;  // 2.0 in their format

// === Test Functions ===
fn test_initial_state() {
    let state = initial_state();
    // Check that initial state matches expectations
    assert(state.verify.c_init == true);
    assert(state.verify.c_self == true);
    assert(state.verify.c_comm == true);
    assert(state.verify.c_ind == true);
    assert(state.counters.beat == false);
    assert(state.counters.live == LIVE_SEED);
    assert(state.counters.live2 == LIVE2_SEED);
    // Check JTAG init value
    assert(state.jtag.shift_reg == SR_INIT);
}

fn test_counters_increment() {
    let mut state = initial_state();
    // Simulate a few counter updates
    for _i in 0..10 {
        state = update_state(state);
    }
    // After 10 updates, live should have increased by 10*LIVE_STRIDE
    // live2 should have increased by 10*LIVE2_STRIDE
    // (This is simplified since we're updating every cycle)
    assert(state.counters.live == LIVE_SEED + 10);
    assert(state.counters.live2 == LIVE2_SEED + 10 * 7);  // LIVE2_STRIDE = 7
}

fn test_self_equivalence() {
    let mut state = initial_state();
    // Run for a few cycles
    for _i in 0..5 {
        state = update_state(state);
    }
    // u_self_a and u_self_b should have the same result
    // (since they have the same inputs)
    assert(state.u_self_a.result == state.u_self_b.result);
}

fn test_comm_equivalence() {
    let mut state = initial_state();
    // Run for a few cycles
    for _i in 0..5 {
        state = update_state(state);
    }
    // u_comm_a and u_comm_b should have the same result
    // (since they have swapped inputs but multiplication is commutative)
    assert(state.u_comm_a.result == state.u_comm_b.result);
}

fn test_ind_liveness() {
    let mut state = initial_state();
    // Run for a few cycles so that live and live2 are non-zero
    for _i in 0..5 {
        state = update_state(state);
    }
    // After a few cycles, live and live2 should be non-zero
    // so u_ind.result should be non-zero (assuming inputs are non-zero)
    assert(state.u_ind.result != 0);
    // Also check foldable instances
    assert(state.u_fold1.result == 0);  // ZERO_VAL * anything = 0
    assert(state.u_fold2.result == ONE_VAL * ONE_VAL);  // Should be ONE_VAL^2
}

// Note: The actual ind_ok check is more complex and depends on the
// settle counter in the hardware. We're testing the basic liveness
// property here.

invariant ind_test_consistent {
    let state = initial_state();
    // This invariant would be checked by the compiler on the initial state
    // In practice, we'd want to check it after some state updates,
    // but for now we test it explicitly in test_ind_liveness.
    true
}

// === Test Block ===
test init {
    test_initial_state();
}

test counters {
    test_counters_increment();
}

test self_eq {
    test_self_equivalence();
}

test comm_eq {
    test_comm_equivalence();
}

test ind_liveness {
    test_ind_liveness();
}
}