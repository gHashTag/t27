module gft_dup_jtag {
    const JTAG_CHAIN_N: u32 = 3;
    const TWO: u32 = 20992;
    const INITPROBE_VALUE: u32 = 0x5A5A1234;

    struct GftDupJtagState {
        rstc: u32,
        pre: u32,
        beat: bool,
        live: u32,
        settle: u32,
        c_init: bool,
        c_self: bool,
        c_comm: bool,
        c_ind: bool,
        sig: bool
    }

    fn next_state(s: GftDupJtagState) -> GftDupJtagState {
        let rst_n = (s.rstc == 0xF);

        // Update rstc: increments until 0xF, then stays
        let rstc_update = if (s.rstc != 0xF) { s.rstc + 1 } else { s.rstc };

        // Update pre, beat, live: reset when !rst_n
        let pre_update = if (rst_n) { (s.pre + 1) & 0xFFFFFF } else { 0 };
        let beat_update = if (rst_n && s.pre == 0xFFFFFF) { !s.beat } else { if (!rst_n) { false } else { s.beat } };
        let live_update = if (rst_n && s.pre == 0xFFFFFF) { s.live + 1 } else { if (!rst_n) { 20480 } else { s.live } };

        // Update settle: increments when rst_n and settle != 31
        let settle_update = if (rst_n && s.settle != 31) { s.settle + 1 } else { s.settle };

        // Update c_* and sig: when settle == 31 (regardless of rst_n)
        let mut c_init_update = s.c_init;
        let mut c_self_update = s.c_self;
        let mut c_comm_update = s.c_comm;
        let mut c_ind_update = s.c_ind;
        let mut sig_update = s.sig;

        if (s.settle == 31) {
            let r_self_a = s.live * TWO;
            let r_self_b = s.live * TWO;
            let r_comm_a = s.live * TWO;
            let r_comm_b = TWO * s.live;
            let r_ind = s.live * s.live;

            let init_ok = true;
            let self_ok = (r_self_a == r_self_b);
            let comm_ok = (r_comm_a == r_comm_b);
            let ind_ok = (r_ind != 0);

            c_init_update = if !init_ok { false } else { s.c_init };
            c_self_update = if !self_ok { false } else { s.c_self };
            c_comm_update = if !comm_ok { false } else { s.c_comm };
            c_ind_update = if !ind_ok { false } else { s.c_ind };
            sig_update = s.c_init & s.c_self & s.c_comm & s.c_ind & init_ok & self_ok & comm_ok & ind_ok;
        }

        return GftDupJtagState {
            rstc: rstc_update,
            pre: pre_update,
            beat: beat_update,
            live: live_update,
            settle: settle_update,
            c_init: c_init_update,
            c_self: c_self_update,
            c_comm: c_comm_update,
            c_ind: c_ind_update,
            sig: sig_update
        };
    }

    test next_state_initial {
        let s0 = GftDupJtagState {
            rstc: 0,
            pre: 0,
            beat: false,
            live: 20480,
            settle: 0,
            c_init: true,
            c_self: true,
            c_comm: true,
            c_ind: true,
            sig: false
        };
        let s1 = next_state(s0);
        // After one slowclk, rstc increments to 1 (still not 15), so rst_n=false -> pre, beat, live reset to 0, false, 20480? 
        // But note: pre is reset to 0 because rst_n=false, beat reset to false, live reset to 20480.
        // settle does not increment because rst_n=false.
        assert(s1.rstc == 1);
        assert(s1.pre == 0);        // reset because !rst_n
        assert(s1.beat == false);   // reset because !rst_n
        assert(s1.live == 20480);   // reset because !rst_n
        assert(s1.settle == 0);     // no increment because !rst_n
        assert(s1.c_init == true);
        assert(s1.c_self == true);
        assert(s1.c_comm == true);
        assert(s1.c_ind == true);
        assert(s1.sig == false);
    }

    test next_state_after_reset_release {
        // First, advance rstc to 15 so that rst_n becomes true.
        // We'll advance 15 steps from rstc=0.
        let mut s = GftDupJtagState {
            rstc: 0,
            pre: 0,
            beat: false,
            live: 20480,
            settle: 0,
            c_init: true,
            c_self: true,
            c_comm: true,
            c_ind: true,
            sig: false
        };
        let mut i = 0;
        while (i < 15) {
            s = next_state(s);
            i = i + 1;
        }
        // Now s should have rstc=15, rst_n=true.
        // pre, beat, live have been reset during the reset period and then started counting?
        // Actually, during reset (rst_n=false), pre is held at 0, beat at 0, live at 20480.
        // When rst_n becomes true (at the step when rstc goes from 14 to 15), we start counting.
        // Let's check: at the step when rstc=14 (rst_n=false), we compute next state:
        //   rstc_update = 15
        //   pre_update = 0 (because rst_n=false) -> so pre stays 0
        //   beat_update = false (because rst_n=false)
        //   live_update = 20480 (because rst_n=false)
        //   settle_update = if (rst_n && settle !=31) -> false because rst_n=false -> settle stays same.
        // So after 15 steps, we have:
        //   rstc=15, pre=0, beat=false, live=20480, settle=0 (because settle never incremented during reset).
        assert(s.rstc == 0xF);
        assert(s.pre == 0);
        assert(s.beat == false);
        assert(s.live == 20480);
        assert(s.settle == 0);
        assert(s.c_init == true);
        assert(s.c_self == true);
        assert(s.c_comm == true);
        assert(s.c_ind == true);
        assert(s.sig == false);

        // Now, one more step: rst_n=true, so we start counting.
        let s2 = next_state(s);
        // rstc stays at 15 (because it's already max)
        // pre increments to 1
        // beat remains false (because pre didn't wrap)
        // live remains 20480
        // settle increments to 1 (because rst_n=true and settle was 0)
        assert(s2.rstc == 0xF);
        assert(s2.pre == 1);
        assert(s2.beat == false);
        assert(s2.live == 20480);
        assert(s2.settle == 1);
        // c_* and sig unchanged because settle !=31
        assert(s2.c_init == true);
        assert(s2.c_self == true);
        assert(s2.c_comm == true);
        assert(s2.c_ind == true);
        assert(s2.sig == false);
    }

    test next_state_settle_31 {
        // We'll start from a state where rst_n is true and settle=30.
        let s0 = GftDupJtagState {
            rstc: 0xF,   // rst_n=true
            pre: 0,
            beat: false,
            live: 20480,
            settle: 30,
            c_init: true,
            c_self: true,
            c_comm: true,
            c_ind: true,
            sig: false
        };
        let s1 = next_state(s0);
        // settle should increment to 31
        assert(s1.settle == 31);
        // pre increments to 1
        assert(s1.pre == 1);
        // beat and live unchanged
        assert(s1.beat == false);
        assert(s1.live == 20480);
        // c_* and sig should still be the old values because we update them only when the *current* state's settle==31
        // In this step, the current state's settle is 30, so we don't update c_* and sig.
        assert(s1.c_init == true);
        assert(s1.c_self == true);
        assert(s1.c_comm == true);
        assert(s1.c_ind == true);
        assert(s1.sig == false);

        // Now, next step: settle is 31 in the current state (s1), so we update c_* and sig.
        let s2 = next_state(s1);
        // settle stays at 31 (because it's max)
        assert(s2.settle == 31);
        // pre increments to 2
        assert(s2.pre == 2);
        // beat and live unchanged
        assert(s2.beat == false);
        assert(s2.live == 20480);
        // Now we update c_* and sig based on the current state's (s1) values.
        // In s1: live=20480, so:
        //   r_self_a = 20480 * TWO, r_self_b = same -> self_ok=true
        //   r_comm_a = 20480 * TWO, r_comm_b = TWO * 20480 -> comm_ok=true
        //   r_ind = 20480 * 20480 -> not zero -> ind_ok=true
        //   init_ok=true
        //   c_* in s1 are all true -> so we keep them true.
        //   sig = true & true & true & true & true & true & true & true = true
        assert(s2.c_init == true);
        assert(s2.c_self == true);
        assert(s2.c_comm == true);
        assert(s2.c_ind == true);
        assert(s2.sig == true);
    }

    test next_state_live_increment {
        // We want to test when pre wraps from 0xFFFFFF to 0.
        // We'll set up a state with rst_n=true, pre=0xFFFFFF, and then tick.
        let s0 = GftDupJtagState {
            rstc: 0xF,   // rst_n=true
            pre: 0xFFFFFF,
            beat: false,
            live: 20480,
            settle: 0,
            c_init: true,
            c_self: true,
            c_comm: true,
            c_ind: true,
            sig: false
        };
        let s1 = next_state(s0);
        // pre wraps to 0
        assert(s1.pre == 0);
        // beat toggles to true
        assert(s1.beat == true);
        // live increments to 20481
        assert(s1.live == 20481);
        // settle increments to 1 (because rst_n=true and settle was 0)
        assert(s1.settle == 1);
        // c_* and sig unchanged because settle !=31
        assert(s1.c_init == true);
        assert(s1.c_self == true);
        assert(s1.c_comm == true);
        assert(s1.c_ind == true);
        assert(s1.sig == false);
    }
}