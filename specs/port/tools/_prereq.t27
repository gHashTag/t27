// specs/port/tools/_prereq.t27
// Port of tools/_prereq.py to T27
// φ² + 1/φ² = 3 | TRINITY

module Prereq;
    use std::os;
    use std::process;
    use std::fs;
    use std::path;

    // ═══════════════════════════════════════════════════════════════════════════
    // 1. Function: _who
    // ═══════════════════════════════════════════════════════════════════════════

    // _who() → str
    // Returns the program name from argv[0] or "verifier" as fallback
    fn _who() -> str {
        if (os.args.len > 0) {
            return path.basename(os.args[0]);
        }
        return "verifier";
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 2. Function: skip
    // ══════════════════════════════════════════════════════════════════════════

    // skip(msg: str) → void
    // Handles skip condition: environment incomplete
    // Exits with 0 normally, or 2 if --require flag is present
    fn skip(msg: str) -> void {
        if (os.args.contains("--require")) {
            println!("FAIL {}: {}", _who(), msg);
            println!("  --require was given, so a missing prerequisite is a failure, not a skip.");
            println!("  The CI job builds t27c and the runner ships the toolchain; if one is");
            println!("  absent the environment is broken and this check did not run.");
            println!("  Exit 2 = could not run, not a check that ran and said no.");
            process.exit(2);
        }
        println!("SKIP {}: {}", _who(), msg);
        process.exit(0);
    }

    // ════════════════════════════════════════════════════════════════════════════
    // 3. Function: broken
    // ══════════════════════════════════════════════════════════════════════════

    // broken(msg: str) → void
    // Handles broken condition: product failed or tracked file missing
    // Always exits with 1
    fn broken(msg: str) -> void {
        println!("FAIL {}: {}", _who(), msg);
        println!("  This is not a missing tool. Nothing was compared, and the reason is");
        println!("  the thing under test -- a compiler that would not emit, or a spec");
        println!("  this repository tracks and no longer has.");
        process.exit(1);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 4. Function: plant
    // ══════════════════════════════════════════════════════════════════════════

    // plant(script: str, dest_tools: str) → []str
    // Copy `script` into `dest_tools`, together with what it imports.
    fn plant(script: str, dest_tools: str) -> []str {
        use std::regex;
        
        let src = path.script.to_string();  // TODO: Fix this - need to resolve script path
        let here = path.dirname(src);
        let dest = path.dest_tools.to_string();  // TODO: Fix this
        
        // Create destination directory if it doesn't exist
        fs.create_dir_all(dest, 0o755).expect("Failed to create destination directory");
        
        let mut seen: []str = [];
        let mut queue: []str = [src];
        
        while (queue.len > 0) {
            let f = queue.pop().expect("Queue should not be empty");
            let fname = path.basename(f);
            
            if (seen.contains(fname) || !fs.is_file(f)) {
                continue;
            }
            
            seen.push(fname);
            fs.copy(f, path.join(dest, fname)).expect("Failed to copy file");
            
            let text = fs.read_to_string(f).expect("Failed to read file");
            let import_regex = regex::Regex::new(r"^\s*(?:from|import)\s+([A-Za-z_][A-Za-z0-9_]*)").expect("Failed to create regex");
            
            for cap in import_regex.captures_iter(&text) {
                let name = cap.get(1).unwrap().as_str();
                let sib = path.join(here, name + ".py");
                if (fs.is_file(sib) && !seen.contains(path.basename(sib))) {
                    queue.push(sib);
                }
            }
        }
        
        seen.sort();
        return seen;
    }

