module corpus_figures;

pub fn t27c() -> string {
    return "t27c"
}

test "t27c" {
    assert t27c() == "t27c"
}

pub fn instrument() -> string {
    return "instrument"
}

test "instrument" {
    assert instrument() == "instrument"
}

pub fn uncap_flag() -> string {
    return "--uncap"
}

test "uncap_flag" {
    assert uncap_flag() == "--uncap"
}

pub fn derive() -> array<map<string, json>> {
    let results: array<map<string, json>> = []
    for entry in os.walk("corpus") {
        let root = entry.0
        let dirs = entry.1
        let files = entry.2
        for f in files {
            if f.ends_with(".t27") {
                let path = os.path.join(root, f)
                let rel = os.path.relpath(path, "corpus")
                let stem = rel[0:rel.len() - 4]
                let cmd = [t27c(), "parse", "--json", path]
                let stdout = os.tempfile()
                let stderr = os.tempfile()
                let code = @subprocessRun(cmd, 30, stdout, stderr)
                if code == 0 {
                    let output = os.read_all(stdout)
                    let parsed = json.parse(output)
                    let obj: map<string, json> = {}
                    obj["stem"] = json.string(stem)
                    obj["parse"] = parsed
                    results.push(obj)
                } else {
                    let err = os.read_all(stderr)
                    let obj: map<string, json> = {}
                    obj["stem"] = json.string(stem)
                    obj["parse"] = json.null()
                    obj["error"] = json.string(err)
                    results.push(obj)
                }
                os.close(stdout)
                os.close(stderr)
            }
        }
    }
    return results
}

test "derive" {
    let res = derive()
    assert res.len() >= 0
}

pub fn read_pin() -> map<string, json> {
    let path = "tools/corpus_pin.json"
    if !os.path.exists(path) {
        return {}
    }
    let fh = os.open(path, os.O_RDONLY, 0)
    let content = os.read_all(fh)
    os.close(fh)
    let parsed = json.parse(content)
    return parsed
}

test "read_pin" {
    let pin = read_pin()
    assert pin != null
}

pub fn write_pin(inst: string, rows: array<map<string, json>>) -> i32 {
    let obj: map<string, json> = {}
    obj["instrument"] = json.string(inst)
    obj["rows"] = json.array(rows)
    let content = json.stringify(obj, true)
    let path = "tools/corpus_pin.json"
    let fh = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    os.write_all(fh, content)
    os.close(fh)
    return 0
}

test "write_pin" {
    let rows: array<map<string, json>> = []
    let obj: map<string, json> = {}
    obj["stem"] = json.string("test")
    obj["parse"] = json.null()
    rows.push(obj)
    assert write_pin("test-inst", rows) == 0
    let pin = read_pin()
    assert pin["instrument"] == json.string("test-inst")
}

pub fn self_check() -> i32 {
    let rows = derive()
    let pin = read_pin()
    if pin == null || pin.len() == 0 {
        return 1
    }
    let pin_inst = pin["instrument"]
    let pin_rows = pin["rows"]
    if pin_inst == json.string(instrument()) && pin_rows == json.array(rows) {
        return 0
    }
    return 1
}

test "self_check" {
    let result = self_check()
    assert result == 0 || result == 1
}

pub fn main() -> i32 {
    let args = os.args()
    if args.len() < 2 {
        let prog = args[0]
        print("Usage: " + prog + " {derive|pin|check}")
        return 2
    }
    let cmd = args[1]
    if cmd == "derive" {
        let rows = derive()
        for row in rows {
            let stem = row["stem"]
            let parse = row["parse"]
            print(stem + ": " + json.stringify(parse, false))
        }
        return 0
    } else if cmd == "pin" {
        let rows = derive()
        return write_pin(instrument(), rows)
    } else if cmd == "check" {
        return self_check()
    } else {
        let prog = args[0]
        print("Usage: " + prog + " {derive|pin|check}")
        return 2
    }
}

test "main_usage" {
    // Main is tested via integration, just ensure it compiles
    assert true
}