// SPDX-License-Identifier: Apache-2.0
; specs/port/tools/corpus_figures.t27 -- Port of tools/corpus_figures.py to T27
; Measures figures in the GENERATED C, pinned with their instrument | φ² + 1/φ² = 3 | TRINITY

module CorpusFigures;

    // Constants
    const ROOT : str = ".";
    const PIN : str = "tools/corpus_figures_pin.txt";
    const DIAG_REGEX : str = "^\\S+:(\\d+):\\d+: error: (.*)$";
    const CLASSES : [7]str = [
        "expected expression",
        "cannot use '__auto_type' with initializer list in C", 
        "use of undeclared identifier 'POS'",
        "use of undeclared identifier 'NEG'",
        "call to undeclared function 'len'",
        "redefinition of",
        "incompatible integer to pointer conversion initializing",
    ];

    // t27c() -> str
    // Returns path to t27c binary
    fn t27c() -> str {
        // Try relative paths first
        for rel in ["target/release/t27c", "bootstrap/target/release/t27c"] {
            let p = os.path.join(ROOT, rel);
            if os.path.isfile(p) and os.access(p, os.X_OK) {
                return p;
            }
        }
        // Try environment variable
        let env = os.environ.get("TRI_T27C", "");
        if env and os.access(env, os.X_OK) {
            return env;
        }
        // Error if not found
        print("corpus_figures: t27c not built. Exit 2 = COULD NOT RUN.");
        sys.exit(2);
    }

    // instrument() -> str
    // Returns compiler version string
    fn instrument() -> str {
        let v = @subprocessRun(["cc", "--version"], 10); // 10 second timeout
        if v.returncode != 0 {
            print("corpus_figures: no cc. Exit 2 = COULD NOT RUN.");
            sys.exit(2);
        }
        let first = if v.stdout.strip() != "" {
            v.stdout.strip().splitlines()[0]
        } else {
            "unknown cc"
        };
        return if first.len() > 72 { first[0..72] } else { first };
    }

    // uncap_flag() -> str
    // Returns appropriate compiler flag to remove error cap
    fn uncap_flag() -> str {
        let v = @subprocessRun(["cc", "--version"], 10).stdout;
        return if v.lower().contains("clang") {
            "-ferror-limit=0"
        } else {
            "-fmax-errors=0"
        };
    }

    // derive()
    // Generates corpus figures by compiling specs
    fn derive() {
        let binary = t27c();
        let flag = uncap_flag();
        
        // Find all .t27 files in specs directory
        let specs = [];
        for r, _, fs in os.walk(os.path.join(ROOT, "specs")) {
            for f in fs {
                if f.endswith(".t27") {
                    specs.append(os.path.join(r, f));
                }
            }
        }
        
        if specs.len() == 0 {
            print("corpus_figures: no specs. Exit 2.");
            sys.exit(2);
        }
        
        let units = 0;
        let generated = 0;
        let clean = 0;
        let errors = 0;
        let cls_d = collections.Counter();
        let cls_l = collections.defaultdict(set);
        
        with tempfile.TemporaryDirectory() as d {
            for s in specs {
                units += 1;
                let h = os.path.join(d, os.path.relpath(s, ROOT).replace("/", "_") + ".h");
                with open(h, "w") as fh {
                    @subprocessRun([binary, "gen-c", s], 30, stdout=fh, stderr=subprocess.DEVNULL);
                }
                if os.path.getsize(h) == 0 {
                    continue;
                }
                generated += 1;
                
                let r = @subprocessRun(
                    ["cc", "-std=c11", flag, "-fsyntax-only", "-x", "c", h],
                    60, // 60 second timeout
                );
                let text = r.stdout + r.stderr;
                let found = 0;
                
                for m in DIAG_REGEX.finditer(text) {
                    found += 1;
                    let msg = m.group(2);
                    for c in CLASSES {
                        if msg.startswith(c) {
                            cls_d[c] += 1;
                            cls_l[c].add((h, m.group(1)));
                            break;
                        }
                    }
                }
                errors += found;
                if found == 0 {
                    clean += 1;
                }
            }
        }
        
        let rows = [
            ("specs seen", "units", units),
            ("specs that generate", "units", generated),
            ("translation units compiling clean", "units", clean),
            ("total errors", "errors", errors),
        ];
        
        for c in CLASSES {
            rows.append((f"class: {c}", "errors", cls_d[c]));
            rows.append((f"class: {c}", "lines", cls_l[c].len()));
        }
        
        return rows;
    }

    // read_pin() -> (str, list)
    // Reads the pin file, returns instrument and rows
    fn read_pin() -> (str, list) {
        if not os.path.exists(PIN) {
            return "", [];
        }
        let inst = "";
        let rows = [];
        
        for line in open(PIN, encoding="utf-8") {
            if line.startswith("# instrument:") {
                inst = line.split(":", 1)[1].strip();
            }
            line = line.split("#", 1)[0].strip();
            if not line {
                continue;
            }
            let parts = line.rsplit("|", 2);
            let name = parts[0].strip();
            let unit = parts[1].strip();
            let val = int(parts[2]);
            rows.append((name, unit, val));
        }
        
        return inst, rows;
    }

    // write_pin(inst: str, rows: list)
    // Writes the pin file
    fn write_pin(inst: str, rows: list) {
        with open(PIN, "w", encoding="utf-8") as fh {
            fh.write("# Figures measured in the GENERATED C, with the instrument that\n");
            fh.write("# produced them. A number from this side quoted without saying so is\n");
            fh.write("# how `len(x)` came to be published as 142 -- a diagnostic count --\n");
            fh.write("# inside a sentence about the specs. See tools/corpus_figures.py.\n");
            fh.write("#\n");
            fh.write(f"# instrument: {inst}\n");
            fh.write("# name | unit | value\n");
            
            for name, unit, val in rows {
                fh.write(f"{name} | {unit} | {val}\n");
            }
        }
    }

    // self_check() -> int
    // Runs self-check tests, returns 0 if pass, 2 if fail
    fn self_check() -> int {
        let ok = true;
        let flag = uncap_flag();
        
        with tempfile.TemporaryDirectory() as d {
            // Test 1: Planted error must be counted
            let bad = os.path.join(d, "bad.h");
            open(bad, "w").write("int f(void){ return undefined_zzz; }\n");
            let r = @subprocessRun(["cc", "-std=c11", flag, "-fsyntax-only", "-x", "c", bad],
                               30);
            let n = DIAG_REGEX.findall(r.stdout + r.stderr).len();
            print(f"  planted 1 error -> counted {n} {'PASS' if n >= 1 else 'FAIL'}");
            ok &= n >= 1;
            
            // Test 2: Two diagnostics on one line must count as one line
            let two = os.path.join(d, "two.h");
            open(two, "w").write("int g(void){ return aaa_undef + bbb_undef; }\n");
let r2 = @subprocessRun(["cc", "-std=c11", flag, "-fsyntax-only", "-x", "c", two],
                                30);
            let ms = DIAG_REGEX.finditer(r2.stdout + r2.stderr);
            let lines_seen = {m.group(1) for m in ms}.len();
            print(f"  2 errors on 1 line -> {ms.len()} errors, {lines_seen} line "
                  f"({'PASS' if ms.len() >= 2 and lines_seen == 1 else 'FAIL'})");
            ok &= ms.len() >= 2 and lines_seen == 1;
            
            // Test 3: Clean file must not count any errors
            let good = os.path.join(d, "good.h");
            open(good, "w").write("int f(void){ return 0; }\n");
            let r = @subprocessRun(["cc", "-std=c11", flag, "-fsyntax-only", "-x", "c", good],
                               30);
            let n = DIAG_REGEX.findall(r.stdout + r.stderr).len();
            print(f"  clean file      -> counted {n} {'PASS' if n == 0 else 'FAIL'}");
            ok &= n == 0;
            
            print(f"  uncap flag for this vendor -> {flag}");
        }
        
        return 0 if ok else 2;
    }

    // main() -> int
    // Main function with argument parsing
    fn main() -> int {
        if "--self-check" in sys.argv {
            return self_check();
        }
        
        let inst = instrument();
        let rows = derive();
        
        if "--bless" in sys.argv {
            write_pin(inst, rows);
            print(f"pinned {rows.len()} figures, instrument: {inst}");
            return 0;
        }
        
        let pin_inst, pin_rows = read_pin();
        print(f"instrument now: {inst}");
        
        if pin_inst and pin_inst != inst {
            print(f"instrument pinned: {pin_inst}");
            print("\nCANNOT TELL. The pin was taken with a different compiler, and the same");
            print("command gives 20 diagnostics on one and 50 on another for the same input.");
            print("A comparison across instruments is a machine report wearing a drift's clothes.");
            return 3;
        }
        
        let pinned = {(n, u): v for n, u, v in pin_rows};
        let drift = 0;
        print(f"\n{'figure':52} {'unit':7} {'pinned':>8} {'now':>8}");
        
        for name, unit, val in rows {
            let p = pinned.get((name, unit));
            let mark = "" if p == val else "  DRIFT";
            if p != val {
                drift += 1;
            }
            print(f"{name[:52]:52} {unit:7} {('-' if p is None else p):>8} {val:8}{mark}");
        }
        
        if drift {
            print(f"\n{drift} figure(s) drifted under the SAME instrument. Say which and why,");
            print("then `--bless`. A corpus figure that moves silently is how a class");
            print("gets re-counted three passes running without anyone noticing.");
        }
        
        return 1 if drift else 0;
    }

    // Tests
    test "t27c returns valid path" {
        let path = t27c();
        assert path.len() > 0;
        assert os.path.isfile(path);
    }

    test "instrument returns compiler version" {
        let version = instrument();
        assert version.len() > 0;
        assert "gcc" in version or "clang" in version;
    }

    test "uncap_flag returns appropriate flag" {
        let flag = uncap_flag();
        assert flag == "-ferror-limit=0" or flag == "-fmax-errors=0";
    }

    test "read_pin handles missing file" {
        let inst, rows = read_pin();
        assert inst == "";
        assert rows.len() == 0;
    }

    test "write_pin creates file" {
        let test_inst = "test compiler";
        let test_rows = [("test figure", "units", 42)];
        write_pin(test_inst, test_rows);
        assert os.path.exists(PIN);
        // Clean up
        os.remove(PIN);
    }

    test "self_check returns valid exit code" {
        let result = self_check();
        assert result == 0 or result == 2;
    }

    test "derive returns list of figures" {
        let rows = derive();
        assert rows.len() >= 4; // At least the 4 basic rows
        // Check that we have the expected basic rows
        let has_specs_seen = false;
        let has_total_errors = false;
        for row in rows {
            let name = row[0];
            if name == "specs seen" {
                has_specs_seen = true;
                assert row[1] == "units";
                assert row[2] >= 0;
            } else if name == "total errors" {
                has_total_errors = true;
                assert row[1] == "errors";
                assert row[2] >= 0;
            }
        }
        assert has_specs_seen;
        assert has_total_errors;
    }

    test "main handles self-check flag" {
        let old_argv = sys.argv;
        sys.argv = ["corpus_figures.py", "--self-check"];
        let result = main();
        sys.argv = old_argv;
        assert result == 0 or result == 2;
    }