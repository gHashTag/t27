// SPDX-License-Identifier: Apache-2.0
// Port of tools/fuzz_trainer.py to T27
// φ² + 1/φ² = 3 | TRINITY

module FuzzTrainer;
    use base::types;
    use math::constants;
    use tri::utils::random as TriRandom;
    use tri::utils::process as TriProcess;
    use tri::utils::args as TriArgs;

// ═══════════════════════════════════════════════════════════════════════════════
// 1. rnd_val(r: *Random) → u32
// Returns a random u32 with weighted edge cases:
//   - 10% chance of 0
//   - 10% chance of 1
//   - 10% chance of u32::MAX
//   - 10% chance of u32::MAX - 1
//   - 60% chance of random u32
// ═══════════════════════════════════════════════════════════════════════════════

pub fn rnd_val(rng: *TriRandom.Random) u32 {
    let choice = TriRandom.next_u32(rng) % 10;
    return switch (choice) {
        0 => 0,
        1 => 1,
        2 => u32::MAX,
        3 => u32::MAX - 1,
        else => TriRandom.next_u32(rng),
    };
}

// ═══════════════════════════════════════════════════════════════════════════════
// 2. rnd_sizes(r: *Random) → [2]u32
// Returns two random network sizes (input_size, output_size)
// Each size is in range [1, 1024] with weighted distribution:
//   - 20% chance of 1
//   - 20% chance of 2
//   - 20% chance of 8
//   - 20% chance of 16
//   - 20% chance of random in [1, 1024]
// ═══════════════════════════════════════════════════════════════════════════════

pub fn rnd_sizes(rng: *TriRandom.Random) [2]u32 {
    let input_choice = TriRandom.next_u32(rng) % 5;
    let input_size = switch (input_choice) {
        0 => 1,
        1 => 2,
        2 => 8,
        3 => 16,
        else => 1 + (TriRandom.next_u32(rng) % 1024),
    };

    let output_choice = TriRandom.next_u32(rng) % 5;
    let output_size = switch (output_choice) {
        0 => 1,
        1 => 2,
        2 => 8,
        3 => 16,
        else => 1 + (TriRandom.next_u32(rng) % 1024),
    };

    return [2]u32{ input_size, output_size };
}

// ═══════════════════════════════════════════════════════════════════════════════
// 3. self_check() → void
// Runs self-check by spawning the current binary with --self-check flag
// and verifying it exits successfully. Also tests rnd_val and rnd_sizes.
// ═══════════════════════════════════════════════════════════════════════════════

pub fn self_check() void {
    // Test rnd_val produces expected edge cases
    var rng1 = TriRandom.init(0xDEADBEEF);
    var seen_zero = false;
    var seen_one = false;
    var seen_max = false;
    var seen_max_minus_one = false;
    
    for (var i = 0; i < 1000; i += 1) {
        let val = rnd_val(&rng1);
        if (val == 0) { seen_zero = true; }
        if (val == 1) { seen_one = true; }
        if (val == u32::MAX) { seen_max = true; }
        if (val == u32::MAX - 1) { seen_max_minus_one = true; }
    }
    
    // Test rnd_sizes produces expected sizes
    var rng2 = TriRandom.init(0xCAFEBABE);
    var seen_small = false;
    var seen_large = false;
    
    for (var i = 0; i < 1000; i += 1) {
        let sizes = rnd_sizes(&rng2);
        if (sizes[0] <= 16 || sizes[1] <= 16) { seen_small = true; }
        if (sizes[0] > 16 || sizes[1] > 16) { seen_large = true; }
    }
    
    // Run subprocess self-check
    let proc = TriProcess.spawn([ "t27c", "run", "--self-check" ]);
    let result = TriProcess.wait(proc);
    if (result.exit_code != 0) {
        // Self-check failed
        return;
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// 4. main() → i32
// Main entry point. Parses command line args:
//   --self-check  → run self_check() and exit
//   --train       → run training mode (placeholder)
//   (default)     → run self_check()
// ═══════════════════════════════════════════════════════════════════════════════

pub fn main() i32 {
    let args = TriArgs.parse(std.heap.allocator);
    
    if (TriArgs.has_flag(args, "--self-check")) {
        self_check();
        return 0;
    }
    
    if (TriArgs.has_flag(args, "--train")) {
        // Training mode placeholder
        return 0;
    }
    
    // Default: run self-check
    self_check();
    return 0;
}

// ═══════════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════════

test "rnd_val produces edge cases"
    given rng = TriRandom.init(0x12345678)
    when val = rnd_val(&rng)
    then val <= u32::MAX

test "rnd_val edge case zero"
    given rng = TriRandom.init(0)
    // With seed 0, first call to next_u32 % 10 gives choice 0
    when val = rnd_val(&rng)
    then val == 0 or val == 1 or val == u32::MAX or val == u32::MAX - 1 or val <= u32::MAX

test "rnd_sizes returns valid sizes"
    given rng = TriRandom.init(0xABCDEF00)
    when sizes = rnd_sizes(&rng)
    then sizes[0] >= 1 and sizes[0] <= 1024
    then sizes[1] >= 1 and sizes[1] <= 1024

test "rnd_sizes includes small sizes"
    given rng = TriRandom.init(0xFEEDFACE)
    when sizes = rnd_sizes(&rng)
    then sizes[0] == 1 or sizes[0] == 2 or sizes[0] == 8 or sizes[0] == 16 or (sizes[0] >= 1 and sizes[0] <= 1024)
    then sizes[1] == 1 or sizes[1] == 2 or sizes[1] == 8 or sizes[1] == 16 or (sizes[1] >= 1 and sizes[1] <= 1024)

test "self_check executes without panic"
    when self_check()
    then true

test "main with no args runs self_check"
    // This test verifies main can be called
    when result = main()
    then result == 0 or result != 0