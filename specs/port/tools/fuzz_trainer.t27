// Tests for each function
test "rnd_val returns values in expected ranges" {
    var result = rnd_val(42);
    // Basic test - result should be a finite number
    assert(result == result);  // Not NaN
}

test "rnd_sizes returns valid layer sizes" {
    var sizes = rnd_sizes(42);
    
    // Should have at least 3 elements (input, hidden, output)
    // Check first 3 elements exist by accessing them
    var first = sizes[0];
    var second = sizes[1];
    var third = sizes[2];
    
    assert(first > 0);  // input layer
    assert(second > 0);  // hidden layer  
    assert(third > 0);   // output layer
}

test "self_check returns 0 for success" {
