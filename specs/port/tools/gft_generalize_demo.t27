// SPDX-License-Identifier: Apache-2.0
// specs/port/tools/gft_generalize_demo.t27 -- Port of tools/gft_generalize_demo.py
// GF-T generalization demo: trains a 4-class quadrant classifier using GF-T16
// integer arithmetic (bit-exact to synthesized hardware) and evaluates on held-out data.

module gft_generalize_demo;

const BIAS : i32 = 40;

// ---------- GF-T16 primitives (bit-exact to gft_train_demo.py) ----------

fn magadd(a: i32, b: i32) -> i32 {
    var ao : i32 = a >> 9; var am : i32 = a & 511;
    var bo : i32 = b >> 9; var bm : i32 = b & 511;
    var ho : i32 = bo; var hm : i32 = bm; var lo : i32 = ao; var lm : i32 = am;
    if (ao >= bo) { ho = ao; hm = am; lo = bo; lm = bm; }
    var hs : i32 = 512 + hm; var ls : i32 = 512 + lm;
    var d : i32 = ho - lo; if (d > 11) { d = 11; }
    var losh : i32 = ls >> d; var rem : i32 = ls - (losh << d);
    var s : i32 = hs + losh; var off : i32 = ho; var mant : i32 = s - 512;
    if (s >= 1024) {
        var g : i32 = s & 1; var pre : i32 = s >> 1; mant = pre - 512;
        if (g == 1) { if (rem > 0) { mant = mant + 1; } else { if ((pre & 1) == 1) { mant = mant + 1; } } }
        off = ho + 1; if (off >= 80) { off = 80; }
    } else {
        var t : i32 = rem << 1; var hf : i32 = 1 << d;
        if (t > hf) { mant = mant + 1; } else { if (t == hf) { if ((s & 1) == 1) { mant = mant + 1; } } }
    }
    if (mant >= 512) { mant = 0; off = off + 1; if (off >= 80) { off = 80; } }
    return (off << 9) | mant;
}

fn magsub(hi: i32, lo: i32) -> i32 {
    if (hi == lo) { return 0; }
    var ho : i32 = hi >> 9; var hm : i32 = hi & 511;
    var lo_o : i32 = lo >> 9; var lm : i32 = lo & 511;
    var d : i32 = ho - lo_o; var hs : i32 = (512 + hm) << 14;
    var la : i32 = 0; var sticky : i32 = 0;
    if (d >= 26) { la = 0; sticky = 1; }
    else { var ls : i32 = (512 + lm) << 14; la = ls >> d; if ((ls - (la << d)) > 0) { sticky = 1; } }
    var diff : i32 = hs - la; var off : i32 = ho;
    var cap : i32 = 12; if (off - 1 < cap) { cap = off - 1; } if (cap < 0) { cap = 0; }
    var sh : i32 = 0;
    if (diff != 0) {
        var t : i32 = diff;
        if (t < 65536) { if (sh + 8 <= cap) { t = t << 8; sh = sh + 8; } }
        if (t < 1048576) { if (sh + 4 <= cap) { t = t << 4; sh = sh + 4; } }
        if (t < 4194304) { if (sh + 2 <= cap) { t = t << 2; sh = sh + 2; } }
        if (t < 8388608) { if (sh + 1 <= cap) { t = t << 1; sh = sh + 1; } }
    }
    diff = diff << sh; off = off - sh;
    var q : i32 = diff >> 14; var rem : i32 = diff - (q << 14); var half : i32 = 8192; var mant : i32 = q - 512;
    if (rem > half) { mant = mant + 1; }
    else { if (rem == half) { if (sticky == 1) { mant = mant + 1; } else { if ((q & 1) == 1) { mant = mant + 1; } } } }
    if (mant >= 512) { mant = 0; off = off + 1; if (off >= 80) { off = 80; } }
    return (off << 9) | mant;
}

fn sadd(a: u32, b: u32) -> u32 {
    if (a == 0) { return b; }
    if (b == 0) { return a; }
    var sa : i32 = (a >> 16) as i32; var ma : i32 = (a & 65535) as i32;
    var sb : i32 = (b >> 16) as i32; var mb : i32 = (b & 65535) as i32;
    if (sa == sb) { return ((sa << 16) | magadd(ma, mb)) as u32; }
    var bsign : i32 = sa;
    var r : i32 = magsub(ma, mb);
    if (ma < mb) { r = magsub(mb, ma); bsign = sb; }
    if (r == 0) { return 0; }
    return ((bsign << 16) | r) as u32;
}

fn neg(v: u32) -> u32 {
    if (v == 0) { return 0; }
    return v ^ 65536;
}

fn magmul(a16: i32, b16: i32) -> i32 {
    var ao : i32 = a16 >> 9; var am : i32 = a16 & 511;
    var bo : i32 = b16 >> 9; var bm : i32 = b16 & 511;
    var prod : i32 = (512 + am) * (512 + bm);
    var carry : i32 = 0; if (prod >= 524288) { carry = 1; }
    var q : i32 = prod >> 9; var r : i32 = prod & 511; var half : i32 = 256;
    if (carry == 1) { q = prod >> 10; r = prod & 1023; half = 512; }
    var mant : i32 = q - 512;
    if (r > half) { mant = mant + 1; }
    if (r == half) { if ((q & 1) == 1) { mant = mant + 1; } }
    var sm : i32 = ao + bo + carry;
    var out_off : i32 = 0;
    if (sm >= 40) { var res : i32 = sm - 40; if (res >= 80) { out_off = 80; } else { out_off = res; } }
    if (mant >= 512) { mant = 0; out_off = out_off + 1; if (out_off >= 80) { out_off = 80; } }
    return (out_off << 9) | mant;
}

fn smul(a: u32, b: u32) -> u32 {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var sgn : i32 = ((a >> 16) & 1) as i32;
    var sb : i32 = ((b >> 16) & 1) as i32;
    if (sgn != sb) { sgn = 1; } else { sgn = 0; }
    var mag : i32 = magmul((a & 65535) as i32, (b & 65535) as i32);
    if (mag == 0) { return 0; }
    return ((sgn << 16) | mag) as u32;
}

fn category(a: u32) -> u8 {
    if (a == 0) { return 1; }
    if ((a >> 16) == 1) { return 0; }
    return 2;
}

fn gt(a: u32, b: u32) -> u8 {
    var ca : u8 = category(a);
    var cb : u8 = category(b);
    if (ca != cb) { if (ca > cb) { return 1; } return 0; }
    var ma : u32 = a & 65535;
    var mb : u32 = b & 65535;
    if (ca == 2) { if (ma > mb) { return 1; } return 0; }
    if (ca == 0) { if (ma < mb) { return 1; } return 0; }
    return 0;
}

fn pow2_frac(f: i32) -> i32 {
    var p : i32 = 6;
    p = (((p * f) + 32768) >> 16) + 29;
    p = (((p * f) + 32768) >> 16) + 123;
    p = (((p * f) + 32768) >> 16) + 354;
    p = ((p * f) + 32768) >> 16;
    if (p > 511) { p = 511; }
    return p;
}

fn exp2(x: u32) -> u32 {
    if (x == 0) { return 20480; }
    var ng : i32 = 0;
    if ((x >> 16) == 1) { ng = 1; }
    var off_in : i32 = ((x >> 9) & 127) as i32;
    var mant_in : i32 = (x & 511) as i32;
    if (off_in >= 48) {
        if (ng == 1) { return 512; }
        return ((80 << 9) | 511) as u32;
    }
    var num : i32 = 512 + mant_in;
    var sh : i32 = off_in - 33;
    var mq : i32 = num;
    if (sh >= 0) { mq = num << sh; } else { mq = num >> (0 - sh); }
    var ki : i32 = mq >> 16;
    var ff : i32 = mq & 65535;
    var k : i32 = ki;
    var f : i32 = ff;
    if (ng == 1) {
        if (ff == 0) { k = 0 - ki; f = 0; }
        else { k = 0 - (ki + 1); f = 65536 - ff; }
    }
    var mant : i32 = pow2_frac(f);
    var off : i32 = k + 40;
    if (off < 1) { return 512; }
    if (off > 80) { return ((80 << 9) | 511) as u32; }
    return ((off << 9) | mant) as u32;
}

fn recip(x: u32) -> u32 {
    if (x == 0) { return ((80 << 9) | 511) as u32; }
    var s : i32 = 0;
    if ((x >> 16) == 1) { s = 1; }
    var o : i32 = ((x >> 9) & 127) as i32;
    var m : i32 = (x & 511) as i32;
    var den : i32 = 512 + m;
    var mp : i32 = (524288 + (den >> 1)) / den - 512;
    var off : i32 = 79 - o;
    if (mp >= 512) { mp = mp - 512; off = off + 1; }
    if (off < 1) { off = 1; mp = 0; }
    if (off > 80) { off = 80; mp = 511; }
    return ((s << 16) | (off << 9) | mp) as u32;
}

// Softmax: p_sel = 2^(l_sel - M) / sum_i 2^(l_i - M), M = max logit.
fn softmax(l0: u32, l1: u32, l2: u32, l3: u32, sel: u8) -> u32 {
    var mx : u32 = l0;
    if (gt(l1, mx) == 1) { mx = l1; }
    if (gt(l2, mx) == 1) { mx = l2; }
    if (gt(l3, mx) == 1) { mx = l3; }
    var e0 : u32 = exp2(sadd(l0, neg(mx)));
    var e1 : u32 = exp2(sadd(l1, neg(mx)));
    var e2 : u32 = exp2(sadd(l2, neg(mx)));
    var e3 : u32 = exp2(sadd(l3, neg(mx)));
    var ssum : u32 = sadd(sadd(e0, e1), sadd(e2, e3));
    var rr : u32 = recip(ssum);
    var esel : u32 = e0;
    if (sel == 1) { esel = e1; }
    if (sel == 2) { esel = e2; }
    if (sel == 3) { esel = e3; }
    return magmul((esel & 65535) as i32, (rr & 65535) as i32) as u32;
}

// ---------- Float <-> GF-T conversion ----------

// f2gft: float -> signed GF-T16 (u32). Matches Python f2gft exactly.
fn f2gft(x: f32) -> u32 {
    if (x == 0.0) { return 0; }
    var s : u32 = 0;
    if (x < 0.0) { s = 1; }
    var ax : f32 = @abs(x);
    var exp : i32 = @floor(@log2(ax)) as i32;
    var frac : f32 = ax / (2.0_f32.powi(exp as i32));
    var mant : i32 = @round((frac - 1.0) * 512.0) as i32;
    var off : i32 = exp + BIAS;
    if (mant == 512) { mant = 0; off = off + 1; }
    if (off < 1) { off = 1; mant = 0; }
    if (off > 80) { off = 80; mant = 511; }
    return (s << 16) | ((off as u32) << 9) | (mant as u32);
}

// gft_value: signed GF-T16 (u32) -> float. Matches Python gft_value exactly.
fn gft_value(u: u32) -> f32 {
    if (u == 0) { return 0.0; }
    var s : f32 = 1.0;
    if ((u >> 16) == 1) { s = -1.0; }
    var mag : i32 = (u & 65535) as i32;
    var mantissa : f32 = 1.0 + ((mag & 511) as f32) / 512.0;
    var exponent : i32 = (mag >> 9) - BIAS;
    return s * mantissa * (2.0_f32.powi(exponent));
}

// ---------- Quadrant classification ----------

// Returns quadrant: 0 (+,+), 1 (-,+), 2 (-,-), 3 (+,-)
fn quadrant(x0: f32, x1: f32) -> u8 {
    if (x0 >= 0.0 && x1 >= 0.0) { return 0; }
    if (x0 < 0.0 && x1 >= 0.0) { return 1; }
    if (x0 < 0.0 && x1 < 0.0) { return 2; }
    return 3;
}

// ---------- Simple PRNG (xorshift64*) for deterministic generation ----------

struct Rng {
    state: u64,
}

fn rng_new(seed: u64) -> Rng {
    return Rng { state: seed };
}

// xorshift64* - returns u64 in [0, 2^64)
fn rng_next(rng: *Rng) -> u64 {
    var x : u64 = rng.state;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    rng.state = x;
    return x * 2685821657736338717;
}

// uniform in [-1, 1) as f32
fn rng_uniform(rng: *Rng) -> f32 {
    var u : u64 = rng_next(rng);
    // Convert to [0, 1) then scale to [-1, 1)
    var f : f32 = (u as f32) / 18446744073709551616.0;
    return f * 2.0 - 1.0;
}

// ---------- Data generation ----------

// Generates n labeled points (x0, x1) -> quadrant label
// Returns array of (x0, x1, label) tuples encoded as flat array: [x0, x1, label, x0, x1, label, ...]
fn gen(n: u32, rng: *Rng) -> [f32] {
    var pts : [f32] = [];
    var count : u32 = 0;
    while (count < n) {
        var x0 : f32 = rng_uniform(rng);
        var x1 : f32 = rng_uniform(rng);
        // Avoid axis-boundary ambiguity
        if (@abs(x0) < 0.15 || @abs(x1) < 0.15) { continue; }
        var label : f32 = quadrant(x0, x1) as f32;
        pts.push(x0);
        pts.push(x1);
        pts.push(label);
        count = count + 1;
    }
    return pts;
}

// ---------- Forward pass ----------

// W: 4x2 weight matrix (flat: [w00, w01, w10, w11, w20, w21, w30, w31])
// x: [x0, x1] as GF-T16
// Returns logits [l0, l1, l2, l3] as GF-T16
fn forward(W: [u32], x: [u32]) -> [u32] {
    var out : [u32] = [];
    var c : u32 = 0;
    while (c < 4) {
        var acc : u32 = 0;
        var j : u32 = 0;
        while (j < 2) {
            var w_idx : u32 = c * 2 + j;
            acc = sadd(acc, smul(W[w_idx], x[j]));
            j = j + 1;
        }
        out.push(acc);
        c = c + 1;
    }
    return out;
}

// ---------- Accuracy ----------

// W: 4x2 weight matrix (flat)
// data: flat array [x0, x1, label, x0, x1, label, ...]
fn accuracy(W: [u32], data: [f32]) -> f32 {
    var ok : u32 = 0;
    var total : u32 = @len(data) / 3;
    var i : u32 = 0;
    while (i < total) {
        var x0 : f32 = data[i * 3];
        var x1 : f32 = data[i * 3 + 1];
        var t : u8 = data[i * 3 + 2] as u8;
        
        var xg : [u32] = [f2gft(x0), f2gft(x1)];
        var lg : [u32] = forward(W, xg);
        
        // Find argmax of logits using gft_value
        var best_c : u8 = 0;
        var best_val : f32 = gft_value(lg[0]);
        var c : u8 = 1;
        while (c < 4) {
            var v : f32 = gft_value(lg[c]);
            if (v > best_val) { best_val = v; best_c = c; }
            c = c + 1;
        }
        
        if (best_c == t) { ok = ok + 1; }
        i = i + 1;
    }
    return ok as f32 / total as f32;
}

// ---------- Main training loop ----------

fn main() -> i32 {
    var rng : Rng = rng_new(3201);
    
    // Generate train and test data
    var train : [f32] = gen(120, &rng);
    var test_data : [f32] = gen(60, &rng);
    
    // Initialize weights W[4][2] with random values in [-0.2, 0.2]
    var W : [u32] = [];
    var c : u32 = 0;
    while (c < 4) {
        var j : u32 = 0;
        while (j < 2) {
            // Deterministic pseudo-random for weights
            var w_rng : Rng = rng_new(3201 + c * 2 + j + 10000);
            var u : u64 = rng_next(&w_rng);
            var f : f32 = (u as f32) / 18446744073709551616.0;
            var w_val : f32 = f * 0.4 - 0.2;  // [-0.2, 0.2]
            W.push(f2gft(w_val));
            j = j + 1;
        }
        c = c + 1;
    }
    
    var eta_g : u32 = f2gft(0.2);
    
    // Initial accuracy
    var train_acc_0 : f32 = accuracy(W, train);
    var test_acc_0 : f32 = accuracy(W, test_data);
    
    // Training loop: 25 epochs
    var ep : u32 = 1;
    while (ep <= 25) {
        // Shuffle train data using epoch as seed
        var shuffle_rng : Rng = rng_new(ep as u64);
        // Fisher-Yates shuffle on the flat array (groups of 3)
        var n_pts : u32 = @len(train) / 3;
        var k : u32 = n_pts;
        while (k > 1) {
            k = k - 1;
            var u : u64 = rng_next(&shuffle_rng);
            var j : u32 = (u % (k + 1) as u64) as u32;
            if (j != k) {
                // Swap points j and k (3 elements each)
                var tmp0 : f32 = train[j * 3];
                var tmp1 : f32 = train[j * 3 + 1];
                var tmp2 : f32 = train[j * 3 + 2];
                train[j * 3] = train[k * 3];
                train[j * 3 + 1] = train[k * 3 + 1];
                train[j * 3 + 2] = train[k * 3 + 2];
                train[k * 3] = tmp0;
                train[k * 3 + 1] = tmp1;
                train[k * 3 + 2] = tmp2;
            }
        }
        
        // SGD on each training point
        var idx : u32 = 0;
        while (idx < n_pts) {
            var x0 : f32 = train[idx * 3];
            var x1 : f32 = train[idx * 3 + 1];
            var t : u8 = train[idx * 3 + 2] as u8;
            
            var xg : [u32] = [f2gft(x0), f2gft(x1)];
            var lg : [u32] = forward(W, xg);
            
            var c2 : u32 = 0;
            while (c2 < 4) {
                var pc : u32 = softmax(lg[0], lg[1], lg[2], lg[3], c2 as u8);
                var gc : u32 = pc;
                if (c2 == t as u32) {
                    gc = sadd(pc, neg(f2gft(1.0)));
                }
                
                var j : u32 = 0;
                while (j < 2) {
                    var w_idx : u32 = c2 * 2 + j;
                    var delta : u32 = smul(eta_g, smul(gc, xg[j]));
                    W[w_idx] = sadd(W[w_idx], neg(delta));
                    j = j + 1;
                }
                c2 = c2 + 1;
            }
            idx = idx + 1;
        }
        
        // Print every 5 epochs and first 2
        if (ep % 5 == 0 || ep <= 2) {
            var train_acc : f32 = accuracy(W, train);
            var test_acc : f32 = accuracy(W, test_data);
            // In real version would print, here we just compute
        }
        ep = ep + 1;
    }
    
    // Final test accuracy
    var final_test_acc : f32 = accuracy(W, test_data);
    
    // Return 0 for success
    return 0;
}

// ---------- Tests ----------

// Test quadrant function
test "quadrant_q0" {
    assert_eq(quadrant(1.0, 1.0), 0);
    assert_eq(quadrant(0.5, 0.0), 0);
    assert_eq(quadrant(0.0, 0.5), 0);
}

test "quadrant_q1" {
    assert_eq(quadrant(-1.0, 1.0), 1);
    assert_eq(quadrant(-0.5, 0.0), 1);
    assert_eq(quadrant(-0.1, 0.2), 1);
}

test "quadrant_q2" {
    assert_eq(quadrant(-1.0, -1.0), 2);
    assert_eq(quadrant(-0.5, -0.5), 2);
    assert_eq(quadrant(0.0, -0.5), 2);
}

test "quadrant_q3" {
    assert_eq(quadrant(1.0, -1.0), 3);
    assert_eq(quadrant(0.5, -0.5), 3);
    assert_eq(quadrant(0.2, 0.0), 3);
}

// Test gen function produces correct number of points
test "gen_count" {
    var rng : Rng = rng_new(42);
    var data : [f32] = gen(10, &rng);
    assert_eq(@len(data), 30);  // 10 points * 3 values each
}

// Test gen produces valid quadrants
test "gen_valid_labels" {
    var rng : Rng = rng_new(43);
    var data : [f32] = gen(20, &rng);
    var i : u32 = 0;
    var all_valid : bool = true;
    while (i < @len(data) / 3) {
        var x0 : f32 = data[i * 3];
        var x1 : f32 = data[i * 3 + 1];
        var label : u8 = data[i * 3 + 2] as u8;
        var expected : u8 = quadrant(x0, x1);
        if (label != expected) { all_valid = false; }
        // Check axis avoidance
        if (@abs(x0) < 0.15 || @abs(x1) < 0.15) { all_valid = false; }
        i = i + 1;
    }
    assert(all_valid);
}

// Test forward computes 4 logits
test "forward_output_len" {
    var W : [u32] = [20480, 0, 0, 20480, 86016, 0, 0, 86016];  // identity-ish
    var x : [u32] = [20480, 20480];  // [1.0, 1.0]
    var lg : [u32] = forward(W, x);
    assert_eq(@len(lg), 4);
}

// Test forward with zero weights produces zero logits
test "forward_zero_weights" {
    var W : [u32] = [0, 0, 0, 0, 0, 0, 0, 0];
    var x : [u32] = [20480, 19968];  // [1.0, 0.5]
    var lg : [u32] = forward(W, x);
    var all_zero : bool = true;
    var i : u32 = 0;
    while (i < 4) {
        if (lg[i] != 0) { all_zero = false; }
        i = i + 1;
    }
    assert(all_zero);
}

// Test accuracy with perfect predictions
test "accuracy_perfect" {
    // Weights that perfectly classify quadrants
    // W[0] = [large_pos, large_pos]  -> quadrant 0
    // W[1] = [large_neg, large_pos]  -> quadrant 1
    // W[2] = [large_neg, large_neg]  -> quadrant 2
    // W[3] = [large_pos, large_neg]  -> quadrant 3
    var large_pos : u32 = f2gft(10.0);
    var large_neg : u32 = f2gft(-10.0);
    var W : [u32] = [
        large_pos, large_pos,
        large_neg, large_pos,
        large_neg, large_neg,
        large_pos, large_neg
    ];
    
    var data : [f32] = [
        0.5, 0.5, 0.0,    // quadrant 0
        -0.5, 0.5, 1.0,   // quadrant 1
        -0.5, -0.5, 2.0,  // quadrant 2
        0.5, -0.5, 3.0,   // quadrant 3
    ];
    
    var acc : f32 = accuracy(W, data);
    assert_eq(acc, 1.0);
}

// Test accuracy with wrong predictions
test "accuracy_zero" {
    // Weights that always predict class 0
    var W : [u32] = [
        f2gft(10.0), f2gft(10.0),
        f2gft(-10.0), f2gft(-10.0),
        f2gft(-10.0), f2gft(-10.0),
        f2gft(-10.0), f2gft(-10.0)
    ];
    
    var data : [f32] = [
        -0.5, 0.5, 1.0,   // quadrant 1 (will be predicted as 0)
        -0.5, -0.5, 2.0,  // quadrant 2
        0.5, -0.5, 3.0,   // quadrant 3
    ];
    
    var acc : f32 = accuracy(W, data);
    assert_eq(acc, 0.0);
}

// Test f2gft roundtrip for known values
test "f2gft_known_values" {
    assert_eq(f2gft(0.0), 0);
    assert_eq(f2gft(1.0), 20480);   // offset 40, mantissa 0
    assert_eq(f2gft(-1.0), 86016);  // sign bit + offset 40
    assert_eq(f2gft(2.0), 20992);   // offset 41
    assert_eq(f2gft(0.5), 19968);   // offset 39
}

// Test gft_value roundtrip
test "gft_value_roundtrip" {
    var v1 : u32 = f2gft(1.0);
    var f1 : f32 = gft_value(v1);
    assert(@abs(f1 - 1.0) < 0.01);
    
    var v2 : u32 = f2gft(-2.5);
    var f2 : f32 = gft_value(v2);
    assert(@abs(f2 - (-2.5)) < 0.05);
}

// Test softmax uniform
test "softmax_uniform" {
    var p : u32 = softmax(20480, 20480, 20480, 20480, 0);
    // 0.25 in GF-T16: offset 38, mantissa 0 = 0x4c00 = 19456
    assert_eq(p, 19456);
}

// Test main runs without error
test "main_runs" {
    var result : i32 = main();
    assert_eq(result, 0);
}

endmodule