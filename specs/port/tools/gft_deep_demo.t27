// φ² + 1/φ² = 3 | TRINITY

module gft_deep_demo;
    use base::types;

// ReLU activation function: returns x if x > 0, else 0
// gft_relu.t27
pub fn relu(x: u32) -> u32 {
    if (x == 0) {
        return 0;
    }
    if ((x >> 16) == 1) {
        return 0;
    }
    return x;
}

// Exact ReLU gradient mask: 1.0 if x > 0 else 0
// Returns f2gft(1.0) for positive x, 0 otherwise
pub fn relu_grad(x: u32) -> u32 {
    if (x != 0 && (x >> 16) == 0) {
        // f2gft(1.0) = 0x00010000 (sign=0, offset=0, mantissa=1)
        return 0x00010000;
    }
    return 0;
}

// XOR label function: returns 0 if x0 and x1 have same sign, else 1
pub fn xor_label(x0: u32, x1: u32) -> u32 {
    if ((x0 >> 16) == (x1 >> 16)) {
        return 0;
    } else {
        return 1;
    }
}

// Generate training data for XOR problem
// n: number of samples to generate  
// rng: random number generator seed
// Returns array of ((x0, x1), label) pairs
pub fn gen(n: u32, rng: u32) -> u32 {
    // Generate simple test data for XOR problem
    // Each data point is ((x0_gft, x1_gft), label)
    // Using fixed values for reproducible testing
    if (n == 0) return 0;
    
    // Return a simple structure - in full implementation this would be a proper array
    // For now, return n as a placeholder indicating the requested size
    return n;
}

// Linear forward pass: computes W * x
// W: weights matrix [4][2]
// x: input vector [2] 
// Returns: output vector [4]
pub fn lin_fwd(W: [4][2]u32, x: [2]u32) -> [4]u32 {
    return [_dot(W[0], x, 0), _dot(W[1], x, 0), _dot(W[2], x, 0), _dot(W[3], x, 0)];
}

// Dot product helper: w · x + b
// w: weight vector
// x: input vector
// b: bias
// Returns: dot product result
pub fn _dot(w: [2]u32, x: [2]u32, b: u32) -> u32 {
    var acc : u32 = b;
    acc = sadd(acc, smul(w[0], x[0]));
    acc = sadd(acc, smul(w[1], x[1]));
    return acc;
}

// Deep network forward pass
// W1: first layer weights [H][2]
// b1: first layer biases [H]
// W2: second layer weights [4][H]
// b2: second layer biases [4]
// x: input vector [2]
// Returns: tuple of (hpre, h, logits)
const H = 6;
pub fn deep_fwd(W1: [H][2]u32, b1: [H]u32, W2: [4][H]u32, b2: [4]u32, x: [2]u32) -> ([H]u32, [H]u32, [4]u32) {
    var hpre : [H]u32;
    var h : [H]u32;
    var lg : [4]u32;
    
    // Compute pre-activation hidden layer
    var k : u32 = 0;
    while (k < H) : (k = k + 1) {
        hpre[k] = _dot(W1[k], x, b1[k]);
    }
    
    // Apply ReLU activation
    k = 0;
    while (k < H) : (k = k + 1) {
        h[k] = relu(hpre[k]);
    }
    
    // Compute output logits
    var c : u32 = 0;
    while (c < 4) : (c = c + 1) {
        lg[c] = _dot(W2[c], h, b2[c]);
    }
    
    return (hpre, h, lg);
}

// Deep network accuracy
// W1: first layer weights [H][2]
// b1: first layer biases [H]
// W2: second layer weights [4][H]
// b2: second layer biases [4]
// data: array of ((x0, x1), label) pairs
// Returns: accuracy as u32 (percentage * 100)
pub fn deep_acc(W1: [H][2]u32, b1: [H]u32, W2: [4][H]u32, b2: [4]u32, data: u32) -> u32 {
    // For now, return a placeholder
    // In full implementation, this would:
    // 1. Iterate through data points
    // 2. Run deep_fwd for each point
    // 3. Find argmax of logits using gft_value
    // 4. Compare with true labels
    // 5. Return accuracy * 100 as u32
    return 0;
}

// Test blocks for each function
test "relu_returns_zero_for_zero_input" {
    var x : u32 = 0;
    var result : u32 = relu(x);
    assert_eq(result, 0);
}

test "relu_returns_zero_for_negative_input" {
    var x : u32 = 0x80012345;  // negative number (sign bit set)
    var result : u32 = relu(x);
    assert_eq(result, 0);
}

test "relu_returns_input_for_positive_input" {
    var x : u32 = 0x00012345;  // positive number (sign bit not set)
    var result : u32 = relu(x);
    assert_eq(result, x);
}

test "relu_grad_returns_zero_for_zero" {
    var x : u32 = 0;
    var result : u32 = relu_grad(x);
    assert_eq(result, 0);
}

test "relu_grad_returns_zero_for_negative" {
    var x : u32 = 0x80012345;  // negative number
    var result : u32 = relu_grad(x);
    assert_eq(result, 0);
}

test "relu_grad_returns_one_for_positive" {
    var x : u32 = 0x00012345;  // positive number
    var result : u32 = relu_grad(x);
    assert_eq(result, 0x00010000);  // f2gft(1.0)
}

test "xor_label_returns_zero_for_same_signs_positive" {
    var x0 : u32 = 0x00012345;  // positive
    var x1 : u32 = 0x00067890;  // positive
    var result : u32 = xor_label(x0, x1);
    assert_eq(result, 0);
}

test "xor_label_returns_zero_for_same_signs_negative" {
    var x0 : u32 = 0x80012345;  // negative
    var x1 : u32 = 0x80067890;  // negative
    var result : u32 = xor_label(x0, x1);
    assert_eq(result, 0);
}

test "xor_label_returns_one_for_different_signs" {
    var x0 : u32 = 0x00012345;  // positive
    var x1 : u32 = 0x80067890;  // negative
    var result : u32 = xor_label(x0, x1);
    assert_eq(result, 1);
}

test "xor_label_returns_zero_for_same_sign_bits" {
    var x0 : u32 = 0x00012345;  // positive
    var x1 : u32 = 0x00067890;  // positive
    var result : u32 = xor_label(x0, x1);
    assert_eq(result, 0);
}

test "xor_label_returns_zero_for_both_negative" {
    var x0 : u32 = 0x80012345;  // negative
    var x1 : u32 = 0x80067890;  // negative
    var result : u32 = xor_label(x0, x1);
    assert_eq(result, 0);
}

test "gen_function_exists" {
    var n : u32 = 10;
    var rng : u32 = 3301;
    var result : u32 = gen(n, rng);
    assert_eq(result, n);
}

test "lin_fwd_computes_correct_output" {
    var W : [4][2]u32 = [[0x00010000, 0x00020000], [0x00030000, 0x00040000], [0x00050000, 0x00060000], [0x00070000, 0x00080000]];
    var x : [2]u32 = [0x00000001, 0x00000002];
    var result : [4]u32 = lin_fwd(W, x);
    assert_eq(result[0], _dot(W[0], x, 0));
    assert_eq(result[1], _dot(W[1], x, 0));
    assert_eq(result[2], _dot(W[2], x, 0));
    assert_eq(result[3], _dot(W[3], x, 0));
}

test "dot_product_computation" {
    var w : [2]u32 = [0x00010000, 0x00020000];
    var x : [2]u32 = [0x00000003, 0x00000004];
    var b : u32 = 0x00010000;
    var result : u32 = _dot(w, x, b);
    assert_eq(result, sadd(sadd(smul(w[0], x[0]), smul(w[1], x[1])), b));
}

test "deep_fwd_returns_correct_structure" {
    var W1 : [6][2]u32 = [[0x00010000, 0x00020000], [0x00030000, 0x00040000], [0x00050000, 0x00060000], [0x00070000, 0x00080000], [0x00090000, 0x000A0000], [0x000B0000, 0x000C0000]];
    var b1 : [6]u32 = [0x00010000, 0x00020000, 0x00030000, 0x00040000, 0x00050000, 0x00060000];
    var W2 : [4][6]u32 = [[0x00010000, 0x00020000, 0x00030000, 0x00040000, 0x00050000, 0x00060000], [0x00070000, 0x00080000, 0x00090000, 0x000A0000, 0x000B0000, 0x000C0000], [0x000D0000, 0x000E0000, 0x000F0000, 0x00100000, 0x00110000, 0x00120000], [0x00130000, 0x00140000, 0x00150000, 0x00160000, 0x00170000, 0x00180000]];
    var b2 : [4]u32 = [0x00010000, 0x00020000, 0x00030000, 0x00040000];
    var x : [2]u32 = [0x00000001, 0x00000002];
    var result : ([6]u32, [6]u32, [4]u32) = deep_fwd(W1, b1, W2, b2, x);
    assert_eq(result[0].length, 6);
    assert_eq(result[1].length, 6);
    assert_eq(result[2].length, 4);
}

test "deep_acc_returns_placeholder" {
    var W1 : [6][2]u32 = [[0x00010000, 0x00020000]];
    var b1 : [6]u32 = [0x00000000];
    var W2 : [4][6]u32 = [[0x00010000], [0x00020000], [0x00030000], [0x00040000]];
    var b2 : [4]u32 = [0x00000000, 0x00000000, 0x00000000, 0x00000000];
    var data : u32 = 0;
    var result : u32 = deep_acc(W1, b1, W2, b2, data);
    assert_eq(result, 0);
}

endmodule