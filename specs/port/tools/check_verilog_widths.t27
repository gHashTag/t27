// SPDX-License-Identifier: Apache-2.0
module check_verilog_widths {
    use tri::collections::map;

    const ABSURD_BITS: u32 = 1 << 20;
    const LEDGER_PATH: []const u8 = "specs/port/tools/verilog_width_baseline.txt";

    struct LedgerEntry {
        spec: str,
        widths: [str],
    }

    struct ScanResult {
        spec: str,
        absurd_widths: [u32],
        panicked: bool,
    }

    // Find the t27c executable in target/release or target/debug
    fn find_t27c() ?str {
        const paths = [&"target/release/t27c", &"target/debug/t27c"];
        var i: u32 = 0;
        while (i < @len(paths)) {
            if (@fileExists(paths[i])) {
                return paths[i];
            }
            i = i + 1;
        }
        return null;
    }

    // Scan a single spec file for absurd widths or panics
    fn scan_one(t27c: str, spec: str) ScanResult {
        _ = t27c;
        _ = spec;
        // In generated code, this would run: t27c gen-verilog <spec>
        // and parse output for widths >= ABSURD_BITS or panic markers
        return ScanResult{
            .spec = spec,
            .absurd_widths = .{},
            .panicked = false,
        };
    }

    // Load the ledger from the baseline file
    fn load_ledger() map<str, [str]> {
        var ledger = map::empty(str, [str]);

        const result = @readFile(LEDGER_PATH);
        if (result.error) {
            return ledger;
        }

        const content = result.content;
        if (@len(content) == 0) {
            return ledger;
        }

        var current_spec: ?str = null;
        var current_widths: [str] = .{};

        var lines = split_lines(content);
        var i: u32 = 0;
        while (i < @len(lines)) {
            const line = lines[i];
            const trimmed = strip(line);

            if (@len(trimmed) == 0) {
                // Empty line - commit current spec if any
                if (current_spec != null) {
                    map::insert(&ledger, current_spec.?, current_widths);
                    current_spec = null;
                    current_widths = .{};
                }
            } else if (current_spec == null) {
                // First non-empty line is the spec path
                current_spec = trimmed;
            } else {
                // Subsequent non-empty lines are widths
                current_widths = append(current_widths, trimmed);
            }

            i = i + 1;
        }

        // Commit last spec if file doesn't end with blank line
        if (current_spec != null) {
            map::insert(&ledger, current_spec.?, current_widths);
        }

        return ledger;
    }

    // Save the ledger to the baseline file
    fn save_ledger(ledger: map<str, [str]>) void {
        var output: str = "";
        var keys = map::keys(ledger);
        var i: u32 = 0;
        while (i < @len(keys)) {
            const spec = keys[i];
            output = output + spec + "\n";
            var widths = map::get(ledger, spec);
            if (widths != null) {
                var j: u32 = 0;
                while (j < @len(widths)) {
                    output = output + widths[j] + "\n";
                    j = j + 1;
                }
            }
            output = output + "\n";
            i = i + 1;
        }
        _ = @writeFile(LEDGER_PATH, output);
    }

    // Main run logic
    fn run(require: bool, update: bool) i32 {
        const t27c = find_t27c();
        if (t27c == null) {
            print("t27c not found in target/release or target/debug");
            return 1;
        }

        // In real implementation, would scan all spec files
        // For now, return success
        _ = require;
        _ = update;
        return 0;
    }

    // Self-check tests
    fn self_check() i32 {
        // Test find_t27c
        const t27c = find_t27c();
        if (t27c == null) {
            print("self-check: t27c not found (expected in dev env)");
            return 1;
        }

        // Test load_ledger returns empty map for missing file
        const ledger = load_ledger();
        _ = &ledger;

        // Test scan_one returns empty result
        const result = scan_one(t27c, "test.t27");
        _ = &result;

        print("self-check passed");
        return 0;
    }

    // Entry point
    pub fn main() i32 {
        if (@hasArg("--self-check")) {
            return self_check();
        }

        const require = @hasArg("--require");
        const update = @hasArg("--update-baseline");

        return run(require, update);
    }

    // Helper: split string by newlines
    fn split_lines(s: str) [str] {
        var result: [str] = .{};
        var start: u32 = 0;
        var i: u32 = 0;
        while (i < @len(s)) {
            if (s[i] == '\n') {
                result = append(result, s[start..i]);
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < @len(s)) {
            result = append(result, s[start..@len(s)]);
        }
        return result;
    }

    // Helper: strip whitespace from both ends
    fn strip(s: str) str {
        var start: u32 = 0;
        var end: u32 = @len(s);
        while (start < end && is_space(s[start])) {
            start = start + 1;
        }
        while (end > start && is_space(s[end - 1])) {
            end = end - 1;
        }
        return s[start..end];
    }

    fn is_space(c: u8) bool {
        return c == ' ' || c == '\t' || c == '\r' || c == '\n';
    }

    // Helper: append to array
    fn append[T](arr: [T], item: T) [T] {
        var new_arr: [@len(arr) + 1]T = undefined;
        var i: u32 = 0;
        while (i < @len(arr)) {
            new_arr[i] = arr[i];
            i = i + 1;
        }
        new_arr[@len(arr)] = item;
        return new_arr;
    }

    test "find_t27c_returns_path_or_null" {
        const t27c = find_t27c();
        _ = &t27c;
        // Either returns a path or null - both are valid
    }

    test "scan_one_returns_scan_result" {
        const t27c = find_t27c();
        if (t27c != null) {
            const result = scan_one(t27c, "specs/port/tools/check_verilog_widths.t27");
            _ = &result;
            assert(result.spec == "specs/port/tools/check_verilog_widths.t27");
            assert(!result.panicked);
        }
    }

    test "load_ledger_returns_map" {
        const ledger = load_ledger();
        _ = &ledger;
        // Should return a map (empty or populated)
    }

    test "save_ledger_writes_file" {
        var ledger = map::empty(str, [str]);
        map::insert(&ledger, "test.t27", .{"123", "456"});
        save_ledger(ledger);
        // If no panic, test passes
    }

    test "run_returns_exit_code" {
        const code = run(false, false);
        assert(code == 0 || code == 1);
    }

    test "self_check_returns_zero_on_success" {
        const code = self_check();
        _ = &code;
        // In test env, t27c might not exist, so accept 0 or 1
        assert(code == 0 || code == 1);
    }

    test "main_handles_self_check_flag" {
        @setArg("--self-check");
        const code = main();
        @clearArg("--self-check");
        assert(code == 0 || code == 1);
    }
}