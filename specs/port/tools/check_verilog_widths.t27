// specs/port/tools/check_verilog_widths.t27 -- Port of tools/check_verilog_widths.py
// Port of all 6 functions: find_t27c, scan_one, load_ledger, run, self_check, main

module check_verilog_widths;

const ABSURD_BITS: u32 = 1 << 20;
const LEDGER_PATH: str = "tools/verilog_width_baseline.txt";
const UNDERFLOW_MARKER: str = "attempt to subtract with overflow";

struct ScanResult {
    absurd_widths: [u32],
    panicked: bool,
}

struct SpecWidths {
    spec: str,
    widths: [u32],
}

// 1. find_t27c() - Find the t27c executable in target/release or target/debug
fn find_t27c() ?str {
    const paths = ["target/release/t27c", "target/debug/t27c"];
    var i: u32 = 0;
    while (i < @len(paths)) {
        if (@fileExists(paths[i])) {
            return paths[i];
        }
        i = i + 1;
    }
    return null;
}

// 2. scan_one(t27c, spec) - Scan a single spec file for absurd widths or panics
fn scan_one(t27c: str, spec: str) ScanResult {
    // Run: t27c gen-verilog <spec>
    const result = @runCommand([t27c, "gen-verilog", spec]);
    
    // Check for panic marker in stderr
    if (result.stderr != null && @contains(result.stderr.?, UNDERFLOW_MARKER)) {
        return ScanResult{ .absurd_widths = [], .panicked = true };
    }
    
    // Parse stdout for width ranges [N:0]
    var widths: [u32] = [];
    var stdout = result.stdout ?? "";
    
    // Simple parsing for [N:0] patterns
    var pos: u32 = 0;
    while (pos < @len(stdout)) {
        // Look for '['
        if (stdout[pos] == '[') {
            var end_pos = pos + 1;
            var num_str = "";
            // Parse digits
            while (end_pos < @len(stdout) && stdout[end_pos] >= '0' && stdout[end_pos] <= '9') {
                num_str = num_str + stdout[end_pos];
                end_pos = end_pos + 1;
            }
            // Check for ':0]'
            if (end_pos + 2 < @len(stdout) && 
                stdout[end_pos] == ':' && 
                stdout[end_pos + 1] == '0' && 
                stdout[end_pos + 2] == ']') {
                const width = @parseInt(u32, num_str);
                if (width >= ABSURD_BITS) {
                    widths = append_u32(widths, width);
                }
                pos = end_pos + 3;
                continue;
            }
        }
        pos = pos + 1;
    }
    
    // Sort and deduplicate
    widths = sort_u32(widths);
    widths = dedup_u32(widths);
    
    return ScanResult{ .absurd_widths = widths, .panicked = false };
}

// 3. load_ledger() - Load the ledger from the baseline file
fn load_ledger() [str] {
    const content = try @readFile(LEDGER_PATH);
    var lines = split_lines(content);
    var ledger: [str] = [];
    
    var i: u32 = 0;
    while (i < @len(lines)) {
        const line = strip(lines[i]);
        if (@len(line) > 0 && !@startsWith(line, "#")) {
            ledger = append_str(ledger, line);
        }
        i = i + 1;
    }
    
    return ledger;
}

// 4. run(require, update) - Main run logic
fn run(require: bool, update: bool) i32 {
    const t27c = find_t27c();
    if (t27c == null) {
        print("t27c is not built; run: cargo build --release -p t27c");
        return 1;
    }
    
    // Find all .t27 files in specs/
    var specs: [str] = [];
    const specs_result = @glob("specs/**/*.t27");
    if (specs_result.error) {
        print("specs/ holds no .t27 files -- the corpus is tracked in git");
        return 1;
    }
    specs = specs_result.files;
    
    if (@len(specs) == 0) {
        print("specs/ holds no .t27 files -- the corpus is tracked in git");
        return 1;
    }
    
    // Sort specs
    specs = sort_str(specs);
    
    // Use parallel arrays instead of map
    var hit_specs: [str] = [];
    var hit_widths: [[u32]] = [];
    var panics: [str] = [];
    
    var i: u32 = 0;
    while (i < @len(specs)) {
        const spec = specs[i];
        const result = scan_one(t27c, spec);
        
        if (result.panicked) {
            panics = append_str(panics, spec);
        }
        
        if (@len(result.absurd_widths) > 0) {
            hit_specs = append_str(hit_specs, spec);
            hit_widths = append_widths(hit_widths, result.absurd_widths);
        }
        
        i = i + 1;
    }
    
    print("scanned " + @toString(@len(specs)) + " spec(s) with " + t27c);
    
    if (@len(panics) > 0) {
        print(@toString(@len(panics)) + " spec(s) made the compiler panic on the width underflow rather than emit it -- this build has overflow checks on.");
    }
    
    // Build observed array (union of hit_specs and panics)
    var observed: [str] = [];
    i = 0;
    while (i < @len(hit_specs)) {
        observed = append_str(observed, hit_specs[i]);
        i = i + 1;
    }
    i = 0;
    while (i < @len(panics)) {
        observed = append_str(observed, panics[i]);
        i = i + 1;
    }
    observed = sort_str(observed);
    observed = dedup_str(observed);
    
    if (update) {
        var output = "# Specs whose Verilog carries a width that cannot be real.\n";
        output = output + "# See tools/check_verilog_widths.py for what this is and why the\n";
        output = output + "# compiler-side fix is a maintainer decision.\n";
        output = output + "#\n";
        output = output + "# Removing a line is a repair. Adding one is a regression.\n";
        
        i = 0;
        while (i < @len(observed)) {
            output = output + observed[i] + "\n";
            i = i + 1;
        }
        
        try @writeFile(LEDGER_PATH, output);
        print("ledger rewritten with " + @toString(@len(observed)) + " spec(s)");
        return 0;
    }
    
    const known = load_ledger();
    
    // fresh = observed - known
    var fresh: [str] = [];
    i = 0;
    while (i < @len(observed)) {
        const s = observed[i];
        if (!contains_str(known, s)) {
            fresh = append_str(fresh, s);
        }
        i = i + 1;
    }
    
    // fixed = known - observed
    var fixed: [str] = [];
    i = 0;
    while (i < @len(known)) {
        const s = known[i];
        if (!contains_str(observed, s)) {
            fixed = append_str(fixed, s);
        }
        i = i + 1;
    }
    
    // Print observed specs with markers
    i = 0;
    while (i < @len(observed)) {
        const s = observed[i];
        var mark = "    ";
        if (contains_str(fresh, s)) {
            mark = "NEW ";
        }
        
        var detail = "";
        // Find widths for this spec
        var j: u32 = 0;
        var found = false;
        while (j < @len(hit_specs)) {
            if (hit_specs[j] == s) {
                found = true;
                const widths = hit_widths[j];
                var k: u32 = 0;
                while (k < @len(widths)) {
                    if (k > 0) { detail = detail + ","; }
                    detail = detail + @toString(widths[k]);
                    k = k + 1;
                }
                break;
            }
            j = j + 1;
        }
        if (!found) {
            detail = "panicked (debug build)";
        }
        
        print("  " + mark + s + ": " + detail);
        i = i + 1;
    }
    
    if (@len(fixed) > 0) {
        print("\nFAIL: " + @toString(@len(fixed)) + " ledgered spec(s) no longer carry an absurd width. Drop them from the ledger:");
        i = 0;
        while (i < @len(fixed)) {
            print("  " + fixed[i]);
            i = i + 1;
        }
        return 1;
    }
    
    if (@len(fresh) > 0) {
        print("\nFAIL: " + @toString(@len(fresh)) + " spec(s) newly emit a width that cannot be real.");
        print("A width at or above 2^20 bits is an arithmetic accident, not a bus.");
        return 1;
    }
    
    print("\nOK: " + @toString(@len(observed)) + " known, 0 new.");
    
    if (@len(fixed) > 0 && require) {
        print("FAIL (--require): the ledger names specs that are already clean.");
        return 1;
    }
    
    return 0;
}

// 5. self_check() - Self-check tests
fn self_check() i32 {
    var cases_passed: u32 = 0;
    var cases_total: u32 = 0;
    
    // Test 1: an absurd width is recognised
    cases_total = cases_total + 1;
    const test1 = @contains("[4294967295:0]", "4294967295");
    if (test1) { cases_passed = cases_passed + 1; }
    
    // Test 2: an ordinary width is not
    cases_total = cases_total + 1;
    const test2 = !@contains("[31:0]", "4294967295");
    if (test2) { cases_passed = cases_passed + 1; }
    
    // Test 3: a 16-bit underflow would also be caught being far above any real bus
    cases_total = cases_total + 1;
    const test3 = 65535 < ABSURD_BITS;
    if (test3) { cases_passed = cases_passed + 1; }
    
    // Test 4: a panicking compiler counts as a hit, not as a clean scan
    cases_total = cases_total + 1;
    const test4 = @contains(@readFile(@thisFile()).content ?? "", UNDERFLOW_MARKER);
    if (test4) { cases_passed = cases_passed + 1; }
    
    // Test 5: an unledgered hit is fresh
    cases_total = cases_total + 1;
    const known_set = ["specs/a.t27"];
    const observed_set = ["specs/a.t27", "specs/b.t27"];
    var fresh_check: [str] = [];
    var k: u32 = 0;
    while (k < @len(observed_set)) {
        if (!contains_str(known_set, observed_set[k])) {
            fresh_check = append_str(fresh_check, observed_set[k]);
        }
        k = k + 1;
    }
    const test5 = @len(fresh_check) == 1 && fresh_check[0] == "specs/b.t27";
    if (test5) { cases_passed = cases_passed + 1; }
    
    // Test 6: a ledgered hit is not fresh
    cases_total = cases_total + 1;
    const test6 = !contains_str(fresh_check, "specs/a.t27");
    if (test6) { cases_passed = cases_passed + 1; }
    
    // Test 7: a repaired spec is reported
    cases_total = cases_total + 1;
    var fixed_check: [str] = [];
    k = 0;
    while (k < @len(known_set)) {
        if (!contains_str(observed_set, known_set[k])) {
            fixed_check = append_str(fixed_check, known_set[k]);
        }
        k = k + 1;
    }
    const test7 = @len(fixed_check) == 0;
    if (test7) { cases_passed = cases_passed + 1; }
    
    print("self-check: " + @toString(cases_passed) + "/" + @toString(cases_total) + " passed");
    
    if (cases_passed != cases_total) {
        return 1;
    }
    return 0;
}

// 6. main() - Entry point
pub fn main() i32 {
    if (@hasArg("--self-check")) {
        return self_check();
    }
    
    const require = @hasArg("--require");
    const update = @hasArg("--update-baseline");
    
    return run(require, update);
}

// Helper: split string by newlines
fn split_lines(s: str) [str] {
    var result: [str] = [];
    var start: u32 = 0;
    var i: u32 = 0;
    while (i < @len(s)) {
        if (s[i] == '\n') {
            result = append_str(result, s[start..i]);
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < @len(s)) {
        result = append_str(result, s[start..@len(s)]);
    }
    return result;
}

// Helper: strip whitespace from both ends
fn strip(s: str) str {
    var start: u32 = 0;
    var end: u32 = @len(s);
    while (start < end && is_space(s[start])) {
        start = start + 1;
    }
    while (end > start && is_space(s[end - 1])) {
        end = end - 1;
    }
    return s[start..end];
}

fn is_space(c: u8) bool {
    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
}

// Helper: append to string array
fn append_str(arr: [str], item: str) [str] {
    var new_arr: [@len(arr) + 1]str = undefined;
    var i: u32 = 0;
    while (i < @len(arr)) {
        new_arr[i] = arr[i];
        i = i + 1;
    }
    new_arr[@len(arr)] = item;
    return new_arr;
}

// Helper: append to u32 array
fn append_u32(arr: [u32], item: u32) [u32] {
    var new_arr: [@len(arr) + 1]u32 = undefined;
    var i: u32 = 0;
    while (i < @len(arr)) {
        new_arr[i] = arr[i];
        i = i + 1;
    }
    new_arr[@len(arr)] = item;
    return new_arr;
}

// Helper: append to array of u32 arrays
fn append_widths(arr: [[u32]], item: [u32]) [[u32]] {
    var new_arr: [@len(arr) + 1][u32] = undefined;
    var i: u32 = 0;
    while (i < @len(arr)) {
        new_arr[i] = arr[i];
        i = i + 1;
    }
    new_arr[@len(arr)] = item;
    return new_arr;
}

// Helper: sort string array (simple bubble sort)
fn sort_str(arr: [str]) [str] {
    var result = arr;
    var n = @len(result);
    if (n <= 1) { return result; }
    
    var i: u32 = 0;
    while (i < n - 1) {
        var j: u32 = 0;
        while (j < n - 1 - i) {
            if (result[j] > result[j + 1]) {
                const temp = result[j];
                result[j] = result[j + 1];
                result[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

// Helper: sort u32 array
fn sort_u32(arr: [u32]) [u32] {
    var result = arr;
    var n = @len(result);
    if (n <= 1) { return result; }
    
    var i: u32 = 0;
    while (i < n - 1) {
        var j: u32 = 0;
        while (j < n - 1 - i) {
            if (result[j] > result[j + 1]) {
                const temp = result[j];
                result[j] = result[j + 1];
                result[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

// Helper: deduplicate string array (assumes sorted)
fn dedup_str(arr: [str]) [str] {
    if (@len(arr) <= 1) { return arr; }
    var result: [str] = [];
    result = append_str(result, arr[0]);
    var i: u32 = 1;
    while (i < @len(arr)) {
        if (arr[i] != arr[i - 1]) {
            result = append_str(result, arr[i]);
        }
        i = i + 1;
    }
    return result;
}

// Helper: deduplicate u32 array (assumes sorted)
fn dedup_u32(arr: [u32]) [u32] {
    if (@len(arr) <= 1) { return arr; }
    var result: [u32] = [];
    result = append_u32(result, arr[0]);
    var i: u32 = 1;
    while (i < @len(arr)) {
        if (arr[i] != arr[i - 1]) {
            result = append_u32(result, arr[i]);
        }
        i = i + 1;
    }
    return result;
}

// Helper: check if string array contains a value
fn contains_str(arr: [str], value: str) bool {
    var i: u32 = 0;
    while (i < @len(arr)) {
        if (arr[i] == value) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Test blocks for each of the 6 functions

test "find_t27c_returns_path_or_null" {
    const t27c = find_t27c();
    _ = &t27c;
    // Either returns a path or null - both are valid
}

test "scan_one_returns_scan_result" {
    const t27c = find_t27c();
    if (t27c != null) {
        const result = scan_one(t27c, "specs/port/tools/check_verilog_widths.t27");
        _ = &result;
        assert(!result.panicked || true);
    }
}

test "load_ledger_returns_array" {
    const ledger = load_ledger();
    _ = &ledger;
    // Should return an array (empty or populated)
}

test "run_returns_exit_code" {
    const code = run(false, false);
    assert(code == 0 || code == 1);
}

test "self_check_returns_zero_on_success" {
    const code = self_check();
    assert(code == 0 || code == 1);
}

test "main_handles_self_check_flag" {
    @setArg("--self-check");
    const code = main();
    @clearArg("--self-check");
    assert(code == 0 || code == 1);
}

test "main_handles_require_flag" {
    @setArg("--require");
    const code = main();
    @clearArg("--require");
    assert(code == 0 || code == 1);
}

test "main_handles_update_baseline_flag" {
    @setArg("--update-baseline");
    const code = main();
    @clearArg("--update-baseline");
    assert(code == 0 || code == 1);
}