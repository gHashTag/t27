// ============================================================================
// Test Blocks for each of the 6 functions
// ============================================================================

test "find_t27c_function" {
    const result = find_t27c();
    assert(result == null or result.len > 0);
}

test "scan_one_function" {
    const t27c = "target/release/t27c";
    const spec = "specs/example.t27";
    const result = scan_one(t27c, spec);
    assert(result.widths.len >= 0);
    assert(result.panicked == true or result.panicked == false);
}

test "load_ledger_function" {
    const result = load_ledger();
    assert(result.len >= 0);
}

test "run_function" {
    const result = run(false, false);
    assert(result == 0 or result == 1 or result == 2);
}

test "self_check_function" {
    const result = self_check();
    assert(result == 0 or result == 1);
}

test "main_function" {
    const result = main();
    assert(result == 0 or result == 1 or result == 2);
}