// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/tools/jtag/mpsse_jtag.t27
// Port of tools/jtag/mpsse_jtag.py to t27
//
// The FTDI MPSSE transport under the JTAG primitives. Opening the cable is the
// target runtime's job; what a spec can hold is the arithmetic that sits above
// it -- the opcode encoding, the TMS bit packing, the split of a bit count into
// whole bytes and a remainder, and the two verdicts. All of those have answers
// that are known independently of any hardware, which is the only reason they
// are worth writing down.
//
// The port this replaces returned the expected IDCODE, 0x13636093, from the
// body of `mpsse_shift_dr_read`, above the comment `// expected IDCODE`. A
// function that answers a read with the value its caller is checking for is a
// fixture wearing the shape of a measurement: every test over it passes, and
// passes just as well with no cable attached. The bodies that touch hardware
// here are `undefined` instead -- the shape read_user1.t27 and link_relay.t27
// use for the same device in this directory.

module MpsseJtag {
    // ========================================================================
    // Opcodes, and what their bits mean
    // ========================================================================

    // An MPSSE opcode is not a magic number: each bit names one property of
    // the transfer. Spelling the decoder out is what lets the constants below
    // be checked against their own names rather than trusted.
    const OP_NEG_WRITE : u32 = 0x01;   // shift TDI out on the falling edge
    const OP_BIT_MODE  : u32 = 0x02;   // length counts bits, not bytes
    const OP_NEG_READ  : u32 = 0x04;   // sample TDO on the falling edge
    const OP_LSB_FIRST : u32 = 0x08;   // least significant bit leaves first
    const OP_WRITE_TDI : u32 = 0x10;
    const OP_READ_TDO  : u32 = 0x20;
    const OP_WRITE_TMS : u32 = 0x40;

    // The opcodes the Python names, with its values.
    const CLK_BYTES_OUT_NEG : u32 = 0x19;
    const CLK_BITS_OUT_NEG  : u32 = 0x1B;
    const CLK_BITS_IO_NEG   : u32 = 0x3B;
    const CLK_TMS_OUT_NEG   : u32 = 0x4B;
    const CLK_TMS_IO_NEG    : u32 = 0x6B;

    // Bytes in and out, LSB first, on the falling edge. The Python spells this
    // one as a bare 0x39 at its only use site.
    const CLK_BYTES_IO_NEG : u32 = 0x39;

    pub fn op_neg_write(op: u32) bool { return (op & OP_NEG_WRITE) != 0; }
    pub fn op_bit_mode(op: u32) bool  { return (op & OP_BIT_MODE) != 0; }
    pub fn op_lsb_first(op: u32) bool { return (op & OP_LSB_FIRST) != 0; }
    pub fn op_write_tdi(op: u32) bool { return (op & OP_WRITE_TDI) != 0; }
    pub fn op_read_tdo(op: u32) bool  { return (op & OP_READ_TDO) != 0; }
    pub fn op_write_tms(op: u32) bool { return (op & OP_WRITE_TMS) != 0; }

    // ========================================================================
    // Clock rate
    // ========================================================================

    // TCK = 60 MHz / ((1 + divisor) * 2). The Python writes divisor 29 and its
    // comment claims 1 MHz; that claim is arithmetic, so it is checked below
    // rather than believed.
    const FTDI_CLOCK_HZ : u32 = 60000000;
    const DIV_1MHZ      : u32 = 29;
    const TCK_1MHZ      : u32 = 1000000;

    // ========================================================================
    // The device handle
    // ========================================================================

    // Opening the cable is the runtime's, so the handle carries nothing here.
    // It is spelled exactly as read_user1.t27 and link_relay.t27 spell it: one
    // device named three ways in one directory would be three types with one
    // name, and the type ledger would be right to refuse it.
    pub struct Mpsse {
    }

    pub fn mpsse_new(index: u32) Mpsse {
        undefined;
    }

    pub fn mpsse_w(m: Mpsse, data: []u8) void {
        undefined;
    }

    // Reads up to `n` bytes, and may return fewer -- the Python loops on a
    // deadline and returns whatever arrived. A body that returned `n` zeros
    // instead would make every short read indistinguishable from a chain
    // reading all-zero, which is one of the two silent deaths this file exists
    // to tell apart.
    pub fn mpsse_r(m: Mpsse, n: u32) []u8 {
        undefined;
    }

    pub fn mpsse_close(m: Mpsse) void {
        undefined;
    }

    // ========================================================================
    // libftdi return codes
    // ========================================================================

    // libftdi reports failure as a negative return. The Python raises on it and
    // stops; the port this replaces wrote `// We'll do nothing.` into the body
    // of `chk` and returned, which turns every failed open, reset and write
    // into a successful one.
    pub fn rc_failed(rc: i32) bool {
        return rc < 0;
    }

    // ========================================================================
    // TMS bit packing
    // ========================================================================

    // The TMS command carries at most seven bits, because the eighth bit of the
    // value byte is the level TDI is held at for the whole transfer. The Python
    // asserts the range; a spec states it as a predicate so the boundary is a
    // thing that can be tested rather than a thing that aborts.
    const TMS_MAX_BITS : u32 = 7;
    const TDI_BIT      : u32 = 7;

    pub fn tms_len_ok(n: u32) bool {
        if (n == 0) { return false; }
        return n <= TMS_MAX_BITS;
    }

    // Bit i of the sequence goes to bit i of the byte: the first TMS bit
    // clocked out is the least significant one.
    pub fn tms_byte(bits: []u8, tdi_level: u32) u32 {
        var val : u32 = 0;
        var i : u32 = 0;
        while (i < bits.len) {
            val = val | ((bits[i] & 1) << i);
            i = i + 1;
        }
        return val | ((tdi_level & 1) << TDI_BIT);
    }

    // The length field is a count minus one, which is why a zero-length TMS
    // transfer cannot be encoded at all.
    pub fn tms_len_field(n: u32) u32 {
        if (n == 0) { return 0; }
        return n - 1;
    }

    // ========================================================================
    // Splitting a bit count for a DR read
    // ========================================================================

    // A read of `nbits` is a byte transfer for the whole bytes and a bit
    // transfer for what is left over. Shifts rather than divide and modulo:
    // this is a bit protocol, and eight is not a tuning parameter.
    pub fn whole_bytes(nbits: u32) u32 {
        return nbits >> 3;
    }

    pub fn spare_bits(nbits: u32) u32 {
        return nbits & 7;
    }

    // The byte-mode length field is sixteen bits, count minus one, little
    // endian -- two separate bytes in the command stream.
    pub fn len_lo(count: u32) u32 {
        if (count == 0) { return 0; }
        return (count - 1) & 0xFF;
    }

    pub fn len_hi(count: u32) u32 {
        if (count == 0) { return 0; }
        return ((count - 1) >> 8) & 0xFF;
    }

    // A partial byte comes back left-justified: MPSSE shifts TDO in from the
    // top, so `rem` bits sit in the high end and have to be brought down.
    // `rem == 0` would ask for a shift by eight, which is why the Python
    // guards the whole branch rather than the expression.
    pub fn align_partial(b: u32, rem: u32) u32 {
        if (rem == 0) { return 0; }
        if (rem > 7) { return b & 0xFF; }
        return (b & 0xFF) >> (8 - rem);
    }

    // ========================================================================
    // The IDCODE verdict
    // ========================================================================

    // What a DR read came back with. `ok` false is a short read, which is a
    // different answer from a word of zeros -- the Python tells them apart by
    // length before it decodes anything.
    pub struct IdcodeRead {
        ok: bool,
        value: u32,
    }

    // The bytes arrive least significant first. This is the opposite order from
    // link_relay.t27's `bytes_to_int`, which packs big-endian for a different
    // register on the same cable; the two are not interchangeable.
    pub fn word_le(b0: u32, b1: u32, b2: u32, b3: u32) u32 {
        return (b0 & 0xFF) | ((b1 & 0xFF) << 8) | ((b2 & 0xFF) << 16) | ((b3 & 0xFF) << 24);
    }

    // The top nibble of an IDCODE is the silicon revision and differs between
    // parts that are otherwise the same die, so the comparison masks it off.
    // That is why the expected value in the module docstring (0x13636093, as
    // openFPGALoader prints it) and the value compared against (0x03636093)
    // differ in exactly that nibble.
    const IDCODE_MASK   : u32 = 0x0FFFFFFF;
    const IDCODE_XC7A200T : u32 = 0x03636093;

    pub fn idcode_matches(idcode: u32) bool {
        return (idcode & IDCODE_MASK) == IDCODE_XC7A200T;
    }

    // ========================================================================
    // The USER1 verdict
    // ========================================================================

    // Four bits come back on USER1:
    //   bit0 ok | bit1 beat | bit2 constant 1 | bit3 constant 0
    //
    // Bits 3:2 must read `01`. The two ways a readback dies silently are an
    // all-zero chain and an all-one chain, and neither can produce a pattern
    // with one bit set and the other clear -- so `ok` from a chain that is not
    // there cannot be mistaken for `ok` from one that is.
    pub struct Verdict {
        read: bool,
        alive: bool,
        pass: bool,
        beat: bool,
    }

    pub fn user1_bit(v: u32, n: u32) u32 {
        return (v >> n) & 1;
    }

    pub fn chain_alive(v: u32) bool {
        if (user1_bit(v, 2) != 1) { return false; }
        return user1_bit(v, 3) == 0;
    }

    pub fn read_verdict(got: []u8) Verdict {
        if (got.len == 0) {
            return Verdict { read: false, alive: false, pass: false, beat: false };
        }
        const v = got[0] & 0xF;
        return Verdict {
            read: true,
            alive: chain_alive(v),
            pass: user1_bit(v, 0) == 1,
            beat: user1_bit(v, 1) == 1,
        };
    }

    // ========================================================================
    // Exit status
    // ========================================================================

    // Both of the Python's entry points collapse their result into the same two
    // codes, and `pass` reaches neither of them: `read_user1` prints
    // "FAIL -- a wrong class was latched" and then returns 0 on the next line,
    // and `main` prints MISMATCH and returns 0 the same way. The ported shape
    // keeps that, because changing it here would make this file a different
    // program from the one it claims to be a port of. `Verdict.pass` is
    // therefore carried, printed, and not acted on -- which is a finding about
    // the Python, not a licence to repeat it in anything new.
    pub fn user1_exit(v: Verdict) i32 {
        if (!v.read) { return 1; }
        if (!v.alive) { return 1; }
        return 0;
    }

    pub fn idcode_exit(r: IdcodeRead) i32 {
        if (r.ok) { return 0; }
        return 1;
    }

    // ========================================================================
    // Entry points
    // ========================================================================

    // The state walk is TLR (five TMS ones) -> Run-Test/Idle -> Select-DR ->
    // Capture-DR -> Shift-DR, then out through Exit1-DR and Update-DR. Driving
    // it needs the cable, so it lives under `undefined` with the rest.
    pub fn read_idcode(idx: u32) IdcodeRead {
        undefined;
    }

    pub fn read_user1(idx: u32) Verdict {
        undefined;
    }

    pub fn main(idx: u32) i32 {
        return idcode_exit(read_idcode(idx));
    }

    // ========================================================================
    // Tests
    // ========================================================================

    test "every opcode decodes to what its name claims"
        // Bytes out, LSB first, falling edge, write only.
        assert(op_neg_write(CLK_BYTES_OUT_NEG));
        assert(!op_bit_mode(CLK_BYTES_OUT_NEG));
        assert(op_lsb_first(CLK_BYTES_OUT_NEG));
        assert(op_write_tdi(CLK_BYTES_OUT_NEG));
        assert(!op_read_tdo(CLK_BYTES_OUT_NEG));
        // The same, in bit mode.
        assert(op_bit_mode(CLK_BITS_OUT_NEG));
        assert(!op_read_tdo(CLK_BITS_OUT_NEG));
        // Bits in and out.
        assert(op_bit_mode(CLK_BITS_IO_NEG));
        assert(op_read_tdo(CLK_BITS_IO_NEG));
        assert(op_write_tdi(CLK_BITS_IO_NEG));
        // TMS out, and TMS in and out.
        assert(op_write_tms(CLK_TMS_OUT_NEG));
        assert(op_bit_mode(CLK_TMS_OUT_NEG));
        assert(!op_read_tdo(CLK_TMS_OUT_NEG));
        assert(op_write_tms(CLK_TMS_IO_NEG));
        assert(op_read_tdo(CLK_TMS_IO_NEG));
        // Bytes in and out, which the Python leaves as a bare 0x39.
        assert(!op_bit_mode(CLK_BYTES_IO_NEG));
        assert(op_read_tdo(CLK_BYTES_IO_NEG));
        assert(op_lsb_first(CLK_BYTES_IO_NEG));

    test "the two opcodes link_relay.t27 binds are not the ones it names them"
        // Recorded, not repaired: that file is a port of a different Python and
        // is not this commit's subject. `CLK_BITS_OUT_NEG = 0x11` there is byte
        // mode, MSB first -- two properties away from its name -- and
        // `CLK_TMS_OUT_NEG = 0x4A` clocks on the rising edge, not the falling.
        assert(!op_bit_mode(0x11));
        assert(!op_lsb_first(0x11));
        assert(op_write_tms(0x4A));
        assert(!op_neg_write(0x4A));
        // Which is the whole point of having a decoder: the claim in a name is
        // checkable, and these two do not check out.

    test "divisor 29 really is one megahertz"
        assert((1 + DIV_1MHZ) * 2 * TCK_1MHZ == FTDI_CLOCK_HZ);

    test "TMS packs the first bit clocked into the least significant place"
        // Five ones to reach Test-Logic-Reset from anywhere.
        assert(tms_byte([1, 1, 1, 1, 1], 0) == 0x1F);
        // Select-DR, Capture-DR, Shift-DR.
        assert(tms_byte([1, 0, 0], 0) == 0x01);
        // Exit1-DR, Update-DR, Run-Test/Idle.
        assert(tms_byte([1, 1, 0], 0) == 0x03);
        // One bit to Run-Test/Idle.
        assert(tms_byte([0], 0) == 0x00);
        // Order matters, and these two differ only in it.
        assert(tms_byte([1, 0], 0) == 0x01);
        assert(tms_byte([0, 1], 0) == 0x02);

    test "TDI rides in bit seven and nowhere else"
        assert(tms_byte([1, 1, 1, 1, 1], 1) == 0x9F);
        assert(tms_byte([0], 1) == 0x80);
        // Seven TMS bits still leave bit seven free, which is the reason for
        // the seven-bit ceiling.
        assert(tms_byte([1, 1, 1, 1, 1, 1, 1], 0) == 0x7F);
        assert(tms_byte([1, 1, 1, 1, 1, 1, 1], 1) == 0xFF);

    test "a TMS transfer of zero bits cannot be encoded"
        assert(!tms_len_ok(0));
        assert(tms_len_ok(1));
        assert(tms_len_ok(7));
        assert(!tms_len_ok(8));
        // The field is a count minus one, so one bit is a zero on the wire.
        assert(tms_len_field(1) == 0);
        assert(tms_len_field(7) == 6);

    test "a bit count splits into whole bytes and a remainder"
        assert(whole_bytes(32) == 4);
        assert(spare_bits(32) == 0);
        assert(whole_bytes(4) == 0);
        assert(spare_bits(4) == 4);
        // The awkward one: a byte transfer AND a bit transfer.
        assert(whole_bytes(12) == 1);
        assert(spare_bits(12) == 4);
        assert(whole_bytes(0) == 0);
        assert(spare_bits(0) == 0);

    test "the byte-mode length field is count minus one, little endian"
        assert(len_lo(1) == 0);
        assert(len_hi(1) == 0);
        assert(len_lo(4) == 3);
        assert(len_hi(4) == 0);
        // 256 bytes is 0x00FF, which is where a one-byte field would wrap.
        assert(len_lo(256) == 0xFF);
        assert(len_hi(256) == 0);
        assert(len_lo(257) == 0x00);
        assert(len_hi(257) == 1);

    test "a partial byte is brought down from the top of the byte"
        // Four bits read back as 0b1010 arrive in the high nibble.
        assert(align_partial(0xA0, 4) == 0x0A);
        assert(align_partial(0x80, 1) == 0x01);
        assert(align_partial(0xFE, 7) == 0x7F);
        // And zero bits is not a shift by eight; it is no read at all.
        assert(align_partial(0xFF, 0) == 0);

    test "a word arrives least significant byte first"
        assert(word_le(0x93, 0x60, 0x63, 0x13) == 0x13636093);
        // The same four bytes big-endian would be a different word entirely,
        // which is what reusing link_relay's packer here would produce.
        assert(word_le(0x13, 0x63, 0x60, 0x93) == 0x93606313);

    test "IDCODE ignores the revision nibble and nothing else"
        assert(idcode_matches(0x13636093));
        // A later revision of the same die still matches.
        assert(idcode_matches(0x03636093));
        assert(idcode_matches(0xF3636093));
        // One bit away in the part number does not.
        assert(!idcode_matches(0x13636092));
        assert(!idcode_matches(0x13636193));

    test "the two silent deaths cannot be mistaken for a part"
        // A chain reading all zeros, and one reading all ones.
        assert(!idcode_matches(0x00000000));
        assert(!idcode_matches(0xFFFFFFFF));

    test "the constant pattern is what says the chain is there"
        // bit2 = 1, bit3 = 0.
        assert(chain_alive(0x4));
        assert(chain_alive(0x5));
        assert(chain_alive(0x6));
        assert(chain_alive(0x7));
        // All zero and all one, the two silent deaths again, at four bits.
        assert(!chain_alive(0x0));
        assert(!chain_alive(0xF));
        // And the inverted pattern, which is the third way to be wrong.
        assert(!chain_alive(0x8));

    test "a verdict without a read claims nothing"
        const none = read_verdict([]);
        assert(!none.read);
        assert(!none.alive);
        assert(!none.pass);
        assert(user1_exit(none) == 1);

    test "a live chain reports its ok bit"
        // 0b0101: ok, no beat, constant pattern present.
        const good = read_verdict([0x5]);
        assert(good.read);
        assert(good.alive);
        assert(good.pass);
        assert(!good.beat);
        // 0b0110: beat, no ok, still alive.
        const bad = read_verdict([0x6]);
        assert(bad.alive);
        assert(!bad.pass);
        assert(bad.beat);

    test "a dead chain's ok bit is not read as a pass"
        // 0b0001 -- ok set, and the constant pattern absent. The Python prints
        // "CHAIN DEAD -- ok is meaningless" for exactly this word.
        const dead = read_verdict([0x1]);
        assert(dead.read);
        assert(!dead.alive);
        assert(user1_exit(dead) == 1);
        // 0b1111 is the other one: every bit set, including ok.
        const stuck = read_verdict([0xF]);
        assert(!stuck.alive);
        assert(user1_exit(stuck) == 1);

    test "only the low nibble of the byte is the verdict"
        // The high nibble is whatever the shift left in the byte; 0xF5 and 0x05
        // are the same answer.
        const high = read_verdict([0xF5]);
        const low = read_verdict([0x05]);
        assert(high.alive == low.alive);
        assert(high.pass == low.pass);

    test "the port keeps the Python's exit codes, including the collapsed one"
        // A live chain that latched a wrong class exits 0. This is the defect
        // named above, asserted so that changing it is a visible change.
        const latched_wrong = read_verdict([0x4]);
        assert(latched_wrong.alive);
        assert(!latched_wrong.pass);
        assert(user1_exit(latched_wrong) == 0);
        // A short IDCODE read exits 1; anything that arrived exits 0, match or
        // mismatch.
        assert(idcode_exit(IdcodeRead { ok: false, value: 0 }) == 1);
        assert(idcode_exit(IdcodeRead { ok: true, value: 0x13636093 }) == 0);
        assert(idcode_exit(IdcodeRead { ok: true, value: 0xDEADBEEF }) == 0);

    test "a negative libftdi return is a failure"
        assert(rc_failed(-1));
        assert(rc_failed(-666));
        assert(!rc_failed(0));
        assert(!rc_failed(3));
}
