// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/tools/verify_multitarget.t27
// Port of tools/verify_multitarget.py to t27
//
// Cross-target bit-exactness for the GF-T primitives the trainer is built on.
// `smul` and `sadd` -- the functions the microsequencer's shared datapath uses
// -- must compute IDENTICALLY across t27's backends. verify_emit_bitexact
// already proves Verilog == the independent model over a full training run;
// this proves C == model and Rust == model on the same operands, which closes
// the "one spec, any target, bit-exact" claim across all four.
//
// The file this replaces was Rust: `use std::env;`, `match`, `Result`, `?`,
// closures and `PathBuf`. It also set `N: u32 = 1000` where the Python sets
// `N = 600`, so the one number it carried across was wrong.
//
// What a spec can hold here is not the subprocess plumbing. It is the three
// decisions the Python makes and argues for: when a missing prerequisite is a
// skip and when it is a failure, why a crashed target is not a disagreement,
// and what the operand set does and does not cover.

module VerifyMultitarget {
    // ========================================================================
    // Skip, or fail: the same state read two ways
    // ========================================================================

    // Locally this gate SKIPs when t27c, a C compiler or rustc is absent --
    // a contributor without rustc should not be blocked. In CI that tolerance
    // is wrong: the workflow builds t27c itself and the runner ships cc and
    // rustc, so a skip there means the environment broke, and exit 0 makes
    // "proved" indistinguishable from "never ran". `--require` turns every
    // skip into a failure.
    const STATE_PASS : u32 = 0;
    const STATE_SKIP : u32 = 1;
    const STATE_FAIL : u32 = 2;

    pub fn state_for(require: bool, prereq_missing: bool, diverged: bool) u32 {
        // A real cross-target divergence is a failure in both modes. It is
        // tested first for exactly that reason: no flag reaches it.
        if (diverged) { return STATE_FAIL; }
        if (prereq_missing) {
            if (require) { return STATE_FAIL; }
            return STATE_SKIP;
        }
        return STATE_PASS;
    }

    pub fn exit_for(state: u32) i32 {
        if (state == STATE_FAIL) { return 1; }
        return 0;
    }

    // The two forbidden readings, named rather than left to be inferred. A
    // SKIP that reaches exit 1 and a FAIL that reaches exit 0 are both silent
    // successes of the kind this gate exists to find, and they are three lines
    // apart in the source.
    pub fn marker_leaked(state: u32, code: i32) bool {
        if (state == STATE_SKIP) { return code != 0; }
        if (state == STATE_FAIL) { return code != 1; }
        return false;
    }

    // ========================================================================
    // A crash is not a disagreement
    // ========================================================================

    // One target's run: its exit code together with how many results actually
    // came back. Spelled exactly as run_conformance_vvp.t27 spells it -- one
    // idea named twice in one directory would be two types with one name, and
    // the type ledger would be right to refuse it.
    //
    // The count is carried rather than discarded because taking stdout without
    // checking the exit code means a crash arrives as a SHORT result list,
    // which then surfaces as a numeric mismatch between targets -- the most
    // alarming reading available, and the wrong one. A program that died on
    // signal 11 did not disagree about arithmetic.
    pub struct Run {
        rc: i32,
        executed: u32,
    }

    // A target that never started is not a target that exited badly. The
    // Python returns None there; a spec with no optional has to put a value in
    // the field, so this one is chosen to be unreachable from a real child --
    // a process exits in 0..255 and a signal death is reported as the negated
    // signal number, so nothing a subprocess can produce lands here.
    const RC_NEVER_RAN : i32 = 0 - 1000;

    pub fn from_a_process(rc: i32) bool {
        if (rc > 255) { return false; }
        return rc >= 0 - 255;
    }

    pub fn started(r: Run) bool {
        return from_a_process(r.rc);
    }

    const CMP_SAME        : u32 = 0;
    const CMP_DIFFERENT   : u32 = 1;
    const CMP_UNAVAILABLE : u32 = 2;

    pub fn run_ok(r: Run) bool {
        if (!started(r)) { return false; }
        return r.rc == 0;
    }

    pub fn compare(a: Run, b: Run, values_equal: bool) u32 {
        if (!run_ok(a)) { return CMP_UNAVAILABLE; }
        if (!run_ok(b)) { return CMP_UNAVAILABLE; }
        // A short list is not a shorter answer to the same question.
        if (a.executed != b.executed) { return CMP_UNAVAILABLE; }
        if (values_equal) { return CMP_SAME; }
        return CMP_DIFFERENT;
    }

    // Only CMP_DIFFERENT is the thing this gate refuses. Unavailable is a
    // broken environment and belongs to the skip/require decision above.
    pub fn is_divergence(verdict: u32) bool {
        return verdict == CMP_DIFFERENT;
    }

    // ========================================================================
    // Exit codes from a child process
    // ========================================================================

    pub fn died_on_signal(code: i32) bool {
        return code < 0;
    }

    pub fn signal_number(code: i32) i32 {
        if (code < 0) { return 0 - code; }
        return 0;
    }

    // T132, carried across because it is an argument and not a comment. Five
    // copies of the signal line survive the boundary mutant that turns `< 0`
    // into `<= 0`. All five are reached only AFTER a return-code check, so at
    // that point the value cannot be zero -- and on every value it can hold,
    // the two operators agree. Proven from the guard above, not assumed from
    // the shape.
    pub fn same_on_nonzero(code: i32) bool {
        if (code == 0) { return true; }
        const strict = code < 0;
        const loose = code <= 0;
        return strict == loose;
    }

    // ========================================================================
    // What the operands cover, and what they do not
    // ========================================================================

    // The original 600 pairs are drawn from values in [-4, 4]. That band is
    // `off` 35..41 -- SIX of the format's 81 exponents. Measured, not
    // estimated: a divergence that only appears when the two operands are
    // decades apart had never been in front of this gate.
    const OFF_COUNT : u32 = 81;
    const BAND_LO   : u32 = 35;
    const BAND_HI   : u32 = 41;
    const BASE_PAIRS : u32 = 600;

    pub fn band_width(lo: u32, hi: u32) u32 {
        if (hi <= lo) { return 0; }
        return hi - lo;
    }

    // `d = hi_off - lo_off` is what selects the alignment path, so a grid that
    // varies both exponents INDEPENDENTLY is not the same experiment as a
    // sweep that moves them together -- the latter holds the interesting
    // variable fixed, which is how iteration 207's binade mistake happened.
    pub fn align_delta(hi_off: i32, lo_off: i32) i32 {
        return hi_off - lo_off;
    }

    // The wide grid: eleven exponents (-40 to 40 in steps of 8) times four
    // mantissas, each appended twice for the two signs.
    const GRID_EXPONENTS : u32 = 11;
    const GRID_MANTISSAS : u32 = 4;
    const GRID_SIGNS     : u32 = 2;
    const SAMPLE_WANT    : u32 = 12;

    pub fn wide_count() u32 {
        return GRID_EXPONENTS * GRID_MANTISSAS * GRID_SIGNS;
    }

    // Integer division with a floor of one, spelled as repeated subtraction
    // because a stride of zero would sample nothing and `max(1, ...)` is the
    // Python's guard against exactly that.
    pub fn stride(n: u32, want: u32) u32 {
        if (want == 0) { return 1; }
        var acc : u32 = 0;
        var q : u32 = 0;
        while (acc + want <= n) {
            acc = acc + want;
            q = q + 1;
        }
        if (q == 0) { return 1; }
        return q;
    }

    // How many indices 0, step, 2*step, ... fall below n.
    pub fn sampled_count(n: u32, step: u32) u32 {
        if (step == 0) { return 0; }
        var c : u32 = 0;
        var i : u32 = 0;
        while (i < n) {
            c = c + 1;
            i = i + step;
        }
        return c;
    }

    pub fn total_pairs() u32 {
        const w = wide_count();
        return BASE_PAIRS + w * sampled_count(w, stride(w, SAMPLE_WANT));
    }

    // The wide pairs are APPENDED, not mixed into the value list. Drawing from
    // a longer list under the same seed would replace all 600 existing pairs,
    // which trades coverage for coverage instead of adding it. Appending keeps
    // the old rows byte-identical.
    pub fn old_rows_kept(before: u32, after: u32) bool {
        return after >= before;
    }

    // ========================================================================
    // The four targets, and which comparisons close the claim
    // ========================================================================

    // verify_emit_bitexact proves Verilog == model over a full training run.
    // This gate adds C == model and Rust == model. The claim is closed when
    // all three hold; comparing the model against itself proves nothing and is
    // not one of them.
    pub fn claim_closed(verilog_vs_model: bool, c_vs_model: bool, rust_vs_model: bool) bool {
        if (!verilog_vs_model) { return false; }
        if (!c_vs_model) { return false; }
        return rust_vs_model;
    }

    // ========================================================================
    // What the controls prove, and what they do not
    // ========================================================================

    // Said out loud rather than left to be inferred. The self-check plants a
    // tree with no compiler and proves the skip pair reaches both of its exits
    // for the right reason. It does NOT reach the cross-target mismatch
    // verdict: that needs a fake compiler emitting deliberately wrong C and
    // Rust, a control worth building and not built. So this gate is proven
    // able to fail on a broken ENVIRONMENT and unproven on a broken
    // ARITHMETIC, and a spec that did not say so would be claiming both.
    pub fn proven_against_broken_environment() bool {
        return true;
    }

    pub fn proven_against_broken_arithmetic() bool {
        return false;
    }

    // The gate was also invisible to `tri gates sweep` for a whole campaign,
    // because it is named `verify_*` rather than `check_*` -- a name standing
    // in for a property.
    pub fn swept_by_name_prefix(is_check_prefixed: bool) bool {
        return is_check_prefixed;
    }

    // ========================================================================
    // Runtime boundary
    // ========================================================================

    // Locating t27c, running a backend, invoking cc and rustc, and reading the
    // numbers back are the runtime's. A body returning a plausible list here
    // would make every comparison above agree without a compiler in the room.
    pub fn find_t27c() []u8 {
        undefined;
    }

    pub fn generate(backend: []u8, spec: []u8) []u8 {
        undefined;
    }

    pub fn build_and_run(target: []u8, source: []u8) Run {
        undefined;
    }

    pub fn main(require: bool) i32 {
        undefined;
    }

    // ========================================================================
    // Tests
    // ========================================================================

    test "a missing prerequisite is a skip locally and a failure in CI"
        assert(state_for(false, true, false) == STATE_SKIP);
        assert(exit_for(state_for(false, true, false)) == 0);
        assert(state_for(true, true, false) == STATE_FAIL);
        assert(exit_for(state_for(true, true, false)) == 1);

    test "a divergence fails in both modes, because no flag reaches it"
        assert(state_for(false, false, true) == STATE_FAIL);
        assert(state_for(true, false, true) == STATE_FAIL);
        // Even when a prerequisite is also missing, the divergence wins.
        assert(state_for(false, true, true) == STATE_FAIL);
        assert(exit_for(state_for(false, true, true)) == 1);

    test "everything present and agreeing is a pass in both modes"
        assert(state_for(false, false, false) == STATE_PASS);
        assert(state_for(true, false, false) == STATE_PASS);
        assert(exit_for(STATE_PASS) == 0);

    test "the two silent successes are refused by name"
        // A SKIP reaching exit 1.
        assert(marker_leaked(STATE_SKIP, 1));
        assert(!marker_leaked(STATE_SKIP, 0));
        // A FAIL reaching exit 0 -- the one that makes "never ran" read as
        // "proved".
        assert(marker_leaked(STATE_FAIL, 0));
        assert(!marker_leaked(STATE_FAIL, 1));
        // And the mapping this file actually uses leaks neither, in all six
        // reachable combinations.
        assert(!marker_leaked(state_for(false, true, false), exit_for(state_for(false, true, false))));
        assert(!marker_leaked(state_for(true, true, false), exit_for(state_for(true, true, false))));
        assert(!marker_leaked(state_for(false, false, true), exit_for(state_for(false, false, true))));
        assert(!marker_leaked(state_for(true, false, true), exit_for(state_for(true, false, true))));
        assert(!marker_leaked(state_for(false, false, false), exit_for(state_for(false, false, false))));
        assert(!marker_leaked(state_for(true, false, false), exit_for(state_for(true, false, false))));

    test "a target that died did not disagree about arithmetic"
        const good = Run { rc: 0, executed: 1744 };
        const crashed = Run { rc: -11, executed: 3 };
        // The reading the Python guards against: a signal-11 death arriving as
        // a numeric mismatch.
        assert(compare(good, crashed, false) == CMP_UNAVAILABLE);
        assert(!is_divergence(compare(good, crashed, false)));
        // A target that never started is the same kind of answer.
        const absent = Run { rc: RC_NEVER_RAN, executed: 0 };
        assert(compare(good, absent, false) == CMP_UNAVAILABLE);

    test "a short result list is unavailable, not different"
        const full = Run { rc: 0, executed: 1744 };
        const short = Run { rc: 0, executed: 1743 };
        // Both exited 0 and one answered fewer questions.
        assert(compare(full, short, false) == CMP_UNAVAILABLE);
        assert(compare(full, short, true) == CMP_UNAVAILABLE);

    test "two targets that both ran and disagree are a divergence"
        const a = Run { rc: 0, executed: 1744 };
        const b = Run { rc: 0, executed: 1744 };
        assert(compare(a, b, false) == CMP_DIFFERENT);
        assert(is_divergence(compare(a, b, false)));
        assert(compare(a, b, true) == CMP_SAME);
        assert(!is_divergence(compare(a, b, true)));

    test "a nonzero exit is not success even when a run happened"
        assert(!run_ok(Run { rc: 1, executed: 1744 }));
        assert(!run_ok(Run { rc: RC_NEVER_RAN, executed: 1744 }));
        assert(run_ok(Run { rc: 0, executed: 1744 }));

    test "the never-ran code is one no child process could return"
        // The whole reason a sentinel is honest here: a real exit status is
        // 0..255 and a signal death is its negation, so this value cannot
        // arrive from a process and be mistaken for one.
        assert(!from_a_process(RC_NEVER_RAN));
        assert(!started(Run { rc: RC_NEVER_RAN, executed: 0 }));
        assert(from_a_process(0));
        assert(from_a_process(255));
        assert(from_a_process(0 - 11));
        assert(!from_a_process(256));
        assert(started(Run { rc: 1, executed: 0 }));

    test "a negative return code carries a signal number"
        assert(died_on_signal(-11));
        assert(signal_number(-11) == 11);
        assert(!died_on_signal(1));
        assert(signal_number(1) == 0);
        assert(!died_on_signal(0));

    test "T132: on the domain it is reached with, < 0 and <= 0 agree"
        // The guard above forces the value nonzero, and on every nonzero
        // value the two operators return the same answer -- so the surviving
        // boundary mutant is equivalent, and that is a proof rather than a
        // shrug.
        assert(same_on_nonzero(-11));
        assert(same_on_nonzero(-1));
        assert(same_on_nonzero(1));
        assert(same_on_nonzero(11));
        assert(same_on_nonzero(127));
        // And at zero, where they genuinely differ, the guard has already
        // returned.
        assert((0 < 0) != (0 <= 0));

    test "the base operand band is six of eighty-one exponents"
        assert(band_width(BAND_LO, BAND_HI) == 6);
        assert(OFF_COUNT == 81);
        // Which is the measurement behind "decades apart has never been in
        // front of this gate": 75 of the 81 exponents are untouched by the
        // original 600 pairs.
        assert(OFF_COUNT - band_width(BAND_LO, BAND_HI) == 75);
        assert(band_width(41, 35) == 0);

    test "the alignment path is chosen by the difference, not the magnitude"
        // A diagonal sweep moves both exponents together and holds the
        // interesting variable fixed.
        assert(align_delta(40, 35) == align_delta(41, 36));
        assert(align_delta(40, 35) == align_delta(-10, -15));
        // An independent grid does not.
        assert(align_delta(40, 35) != align_delta(40, 36));
        // And the sign of the difference is a different path again.
        assert(align_delta(35, 40) == 0 - 5);

    test "the wide grid and its sample have the sizes the Python computes"
        assert(wide_count() == 88);
        assert(stride(88, 12) == 7);
        assert(sampled_count(88, 7) == 13);
        assert(total_pairs() == 1744);
        // Which is where the value 1000 in the file this replaces came from:
        // nowhere.
        assert(total_pairs() != 1000);
        assert(BASE_PAIRS == 600);

    test "a stride never reaches zero, however short the list"
        // max(1, len//12) -- a list shorter than the sample size still yields
        // a usable step.
        assert(stride(5, 12) == 1);
        assert(stride(0, 12) == 1);
        assert(stride(12, 12) == 1);
        assert(stride(24, 12) == 2);
        // And a zero sample size cannot divide.
        assert(stride(88, 0) == 1);
        assert(sampled_count(88, 0) == 0);

    test "appending keeps the old rows and mixing would have replaced them"
        assert(old_rows_kept(BASE_PAIRS, total_pairs()));
        // The rejected alternative: same seed, longer value list, same count.
        // Every one of the 600 original rows would differ.
        assert(!old_rows_kept(BASE_PAIRS, 599));

    test "the claim needs all three comparisons and none of them is trivial"
        assert(claim_closed(true, true, true));
        assert(!claim_closed(false, true, true));
        assert(!claim_closed(true, false, true));
        assert(!claim_closed(true, true, false));

    test "what the controls prove is stated, and so is what they do not"
        assert(proven_against_broken_environment());
        // Unproven, and said so. A spec that returned true here would be
        // claiming a control that was never built.
        assert(!proven_against_broken_arithmetic());
        // The name that hid it: `verify_*` is not swept, `check_*` is.
        assert(!swept_by_name_prefix(false));
        assert(swept_by_name_prefix(true));
}
