// Test blocks
test test_log {
    let msg = "test";
    let result = log(msg);
    assert(result == 1);
}

test test_probe {
    let url = "http://example.com";
    let (ok, said) = probe(url);
    assert(ok == true);
}

test test_sh {
    let args = "echo hello";
    let timeout = 120;
    let (code, output) = sh(args, timeout);
    assert(code == 2);
}

test test_gh_json {
    let args = "issue list";
    let default = -1;
    let result = gh_json(args, default);
    assert(result == 3);
}

test test_alarm_issue {
    let result = alarm_issue();
    assert(result == 4);
}

test test_redeploy {
    let (ok, msg) = redeploy();
    assert(ok == true);
}

test test_self_test {
    let result = self_test();
    assert(result == 5);
}

test test_main {
    let result = main();
    assert(result == 6);
}
