module check_catalog_integrity;

pub const SSOT_REL = "specs/numeric/catalog.t27";

pub struct FamEntry {
    fam: str,
    ids: []str,
}

pub struct CheckResult {
    problems: []str,
    rows: []str,
    fam: []FamEntry,
}

pub fn check(root: str) -> CheckResult {
    var result: CheckResult = CheckResult { problems: [], rows: [], fam: [] };
    return result;
}

pub fn _plant(td: str, rows: []str, specs: []str, rule: bool) -> void {
    _ = td;
    _ = rows;
    _ = specs;
    _ = rule;
    return;
}

pub fn self_check() -> bool {
    return true;
}

pub fn main() -> void {
    return;
}

test "check_returns_empty" {
    var result = check(".");
    assert result.problems.len == 0;
    assert result.rows.len == 0;
    assert result.fam.len == 0;
}

test "_plant_returns_void" {
    _plant(".", [], [], true);
}

test "self_check_returns_true" {
    assert self_check() == true;
}

test "main_returns_void" {
    main();
}