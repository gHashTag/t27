module port::run_conformance_vvp {
    // Encoding of a trit (-1,0,1) to 2-bit field: -1->2, 0->0, 1->1
    const TRIT_ENC: [3]i32 = [2, 0, 1];

    pub struct MacCase {
        expected_trit: i32,
        word_raw: i32,
        index: i32,
        id: string,
        a_trit0: i32,
        b_trit0: i32,
        expected_trit0: i32,
        expected_raw: i32,
        unit: i32,
        trit: i32,
        expected_packed: i32,
        a_trits: []i32,
        b_trits: []i32,
        expected_acc: i32,
        initial_acc: i32,
        units_checked: []i32,
        expected_status_after_reset: i32,
        expected_acc_after_reset: i32,
    }

    pub fn tb_case_extract_trit(c: MacCase) -> (i32, string) {
        let exp = c.expected_trit;
        let verif =
            "    r = dut.extract_trit(32\'d" + c.word_raw.to_str() + ", 32\'d" + c.index.to_str() + ");\n" +
            "    if ($signed(r) !== " + exp.to_str() + ") begin\n" +
            "      $display(\"FAIL " + c.id + ": got %0d want " + exp.to_str() + "\", $signed(r));\n" +
            "      fails = fails + 1;\n" +
            "    end else $display(\"PASS " + c.id + "\");\n";
        return (1, verif);
    }

    pub fn tb_case_mac_multiply(c: MacCase) -> (i32, string) {
        let a = TRIT_ENC[c.a_trit0 + 1];
        let b = TRIT_ENC[c.b_trit0 + 1];
        let exp = c.expected_trit0;
        let verif =
            "    r = dut.mac_multiply(32\'d" + a.to_str() + ", 32\'d" + b.to_str() + ", 8\'d0);\n" +
            "    r = dut.extract_trit(r, 32\'d0);\n" +
            "    if ($signed(r) !== " + exp.to_str() + ") begin\n" +
            "      $display(\"FAIL " + c.id + ": got %0d want " + exp.to_str() + "\", $signed(r));\n" +
            "      fails = fails + 1;\n" +
            "    end else $display(\"PASS " + c.id + "\");\n";
        return (2, verif);
    }

    pub fn tb_case_mac_invalid_unit(c: MacCase) -> (i32, string) {
        let exp = c.expected_raw;
        let verif =
            "    r = dut.mac_multiply(32\'d1, 32\'d1, 8\'d" + c.unit.to_str() + ");\n" +
            "    if (r !== 32\'d" + exp.to_str() + ") begin\n" +
            "      $display(\"FAIL " + c.id + ": got %0d want " + exp.to_str() + "\", r);\n" +
            "      fails = fails + 1;\n" +
            "    end else $display(\"PASS " + c.id + "\");\n";
        return (1, verif);
    }

    pub fn _word_from_trits(trits: []i32) -> i32 {
        let mut raw: i32 = 0;
        let mut i: usize = 0;
        while (i < trits.len) {
            let t = trits[i];
            raw = raw | ((TRIT_ENC[t + 1] << i) << i);
            i = i + 1;
        }
        return raw;
    }

    pub fn tb_case_pack_trit(c: MacCase) -> (i32, string) {
        let exp = c.expected_packed;
        let verif =
            "    r = dut.pack_trit(" + c.trit.to_str() + ", 32\'d" + c.index.to_str() + ");\n" +
            "    if (r !== 32\'d" + exp.to_str() + ") begin\n" +
            "      $display(\"FAIL " + c.id + ": got %0d want " + exp.to_str() + "\", r);\n" +
            "      fails = fails + 1;\n" +
            "    end else $display(\"PASS " + c.id + "\");\n";
        return (1, verif);
    }

    pub fn tb_case_mac_cycle(c: MacCase) -> (i32, string) {
        let a = _word_from_trits(c.a_trits);
        let b = _word_from_trits(c.b_trits);
        let exp = c.expected_acc;
        let init = c.initial_acc;
        let verif =
            "    r = dut.mac_cycle(32\'d" + a.to_str() + ", 32\'d" + b.to_str() + ", 8\'d0, " + init.to_str() + ");\n" +
            "    if ($signed(r) !== " + exp.to_str() + ") begin\n" +
            "      $display(\"FAIL " + c.id + ": got %0d want " + exp.to_str() + "\", $signed(r));\n" +
            "      fails = fails + 1;\n" +
            "    end else $display(\"PASS " + c.id + "\");\n";
        return (2, verif);
    }

    pub fn tb_case_mac_status(c: MacCase) -> (i32, string) {
        let exp = c.expected;
        let stage: i32 = if (c.id.contains("initial")) { 0 } else { 3 };
        let verif =
            "    r = dut.mac_status_read(8\'d" + c.unit.to_str() + ");\n" +
            "    if (r !== 32\'d" + exp.to_str() + ") begin\n" +
            "      $display(\"FAIL " + c.id + ": got %0d want " + exp.to_str() + "\", r);\n" +
            "      fails = fails + 1;\n" +
            "    end else $display(\"PASS " + c.id + "\");\n";
        return (stage, verif);
    }

    pub fn tb_case_mac_reset(c: MacCase) -> (i32, string) {
        if (c.units_checked.len > 0) {
            let exp = c.expected_acc;
            let mut body: string = "";
            let mut i: usize = 0;
            while (i < c.units_checked.len) {
                let u = c.units_checked[i];
                body = body +
                    "    r = dut.mac_cycle(32\'d1, 32\'d1, 8\'d" + u.to_str() + ", 0);\n" +
                    "    r = dut.mac_reset(8\'d" + u.to_str() + ");\n" +
                    "    r = dut.mac_acc_read(8\'d" + u.to_str() + ");\n" +
                    "    if ($signed(r) !== " + exp.to_str() + ") begin\n" +
                    "      $display(\"FAIL " + c.id + "_u" + u.to_str() + ": got %0d want " + exp.to_str() + "\", $signed(r));\n" +
                    "      fails = fails + 1;\n" +
                    "    end else $display(\"PASS " + c.id + "_u" + u.to_str() + "\");\n";
                i = i + 1;
            }
            return (3, body);
        } else if (c.expected_status_after_reset != 0) {
            let exp = c.expected_status_after_reset;
            let verif =
                "    r = dut.mac_cycle(32\'d1, 32\'d1, 8\'d" + c.unit.to_str() + ", 0);\n" +
                "    r = dut.mac_reset(8\'d" + c.unit.to_str() + ");\n" +
                "    r = dut.mac_status_read(8\'d" + c.unit.to_str() + ");\n" +
                "    if (r !== 32\'d" + exp.to_str() + ") begin\n" +
                "      $display(\"FAIL " + c.id + ": got %0d want " + exp.to_str() + "\", r);\n" +
                "      fails = fails + 1;\n" +
                "    end else $display(\"PASS " + c.id + "\");\n";
            return (3, verif);
        } else {
            let exp = c.expected_acc_after_reset;
            let verif =
                "    r = dut.mac_cycle(32\'d1, 32\'d1, 8\'d" + c.unit.to_str() + ", 5);\n" +
                "    r = dut.mac_reset(8\'d" + c.unit.to_str() + ");\n" +
                "    r = dut.mac_acc_read(8\'d" + c.unit.to_str() + ");\n" +
                "    if ($signed(r) !== " + exp.to_str() + ") begin\n" +
                "      $display(\"FAIL " + c.id + ": got %0d want " + exp.to_str() + "\", $signed(r));\n" +
                "      fails = fails + 1;\n" +
                "    end else $display(\"PASS " + c.id + "\");\n";
            return (3, verif);
        }
    }

    test "tb_case_extract_trit returns correct stage and Verilog snippet"
        let c = MacCase {
            expected_trit: 0,
            word_raw: 0,
            index: 0,
            id: "test_extract",
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_raw: 0,
            unit: 0,
            trit: 0,
            expected_packed: 0,
            a_trits: [],
            b_trits: [],
            expected_acc: 0,
            initial_acc: 0,
            units_checked: [],
            expected_status_after_reset: 0,
            expected_acc_after_reset: 0,
        };
        let (stage, body) = tb_case_extract_trit(c);
        assert(stage == 1);
        assert(body.contains("r = dut.extract_trit(32\'d0, 32\'d0);"));
        assert(body.contains('if ($signed(r) !== 0) begin'));
        assert(body.contains('$display("FAIL test_extract: got %0d want 0", $signed(r));'));

    test "tb_case_mac_multiply returns correct stage and Verilog snippet"
        let c = MacCase {
            expected_trit: 0,
            word_raw: 0,
            index: 0,
            id: "test_multiply",
            a_trit0: 1,   // trit 1 -> encoded as 1
            b_trit0: 1,   // trit 1 -> encoded as 1
            expected_trit0: 1,
            expected_raw: 0,
            unit: 0,
            trit: 0,
            expected_packed: 0,
            a_trits: [],
            b_trits: [],
            expected_acc: 0,
            initial_acc: 0,
            units_checked: [],
            expected_status_after_reset: 0,
            expected_acc_after_reset: 0,
        };
        let (stage, body) = tb_case_mac_multiply(c);
        assert(stage == 2);
        assert(body.contains("r = dut.mac_multiply(32\'d1, 32\'d1, 8\'d0);"));
        assert(body.contains("r = dut.extract_trit(r, 32\'d0);"));
        assert(body.contains('if ($signed(r) !== 1) begin'));
        assert(body.contains('$display("FAIL test_multiply: got %0d want 1", $signed(r));'));

    test "tb_case_mac_invalid_unit returns correct stage and Verilog snippet"
        let c = MacCase {
            expected_trit: 0,
            word_raw: 0,
            index: 0,
            id: "test_invalid_unit",
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_raw: 5,
            unit: 2,
            trit: 0,
            expected_packed: 0,
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_raw: 5,
            unit: 2,
            trit: 0,
            expected_packed: 0,
            a_trits: [],
            b_trits: [],
            expected_acc: 0,
            initial_acc: 0,
            units_checked: [],
            expected_status_after_reset: 0,
            expected_acc_after_reset: 0,
        };
        let (stage, body) = tb_case_mac_invalid_unit(c);
        assert(stage == 1);
        assert(body.contains("r = dut.mac_multiply(32\'d1, 32\'d1, 8\'d2);"));
        assert(body.contains('if (r !== 32\'d5) begin'));
        assert(body.contains('$display("FAIL test_invalid_unit: got %0d want 5", r);'));

    test "_word_from_trits converts trits to packed word"
        let trits = [1, -1, 0]; // 1, -1, 0
        let word = _word_from_trits(trits);
        // trit 1 -> encoded 1, trit -1 -> encoded 2, trit 0 -> encoded 0
        // packed: (1) + (2<<2) + (0<<4) = 1 + 8 + 0 = 9
        assert(word == 9);

    test "tb_case_pack_trit returns correct stage and Verilog snippet"
        let c = MacCase {
            expected_trit: 0,
            word_raw: 0,
            index: 0,
            id: "test_pack",
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_raw: 0,
            unit: 0,
            trit: 0,
            expected_packed: 0,
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_packed: 0,
            a_trits: [],
            b_trits: [],
            expected_acc: 0,
            initial_acc: 0,
            units_checked: [],
            expected_status_after_reset: 0,
            expected_acc_after_reset: 0,
        };
        let (stage, body) = tb_case_pack_trit(c);
        assert(stage == 1);
        assert(body.contains("r = dut.pack_trit(1, 32\'d0);"));
        assert(body.contains('if (r !== 32\'d1) begin'));
        assert(body.contains('$display("FAIL test_pack: got %0d want 1", r);'));

    test "tb_case_mac_cycle returns correct stage and Verilog snippet"
        let c = MacCase {
            expected_trit: 0,
            word_raw: 0,
            index: 0,
            id: "test_mac_cycle",
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_raw: 0,
            unit: 0,
            trit: 0,
            expected_packed: 0,
            a_trits: [1, 1], // two 1s -> encoded 1,1 -> word: 1 + (1<<2) = 1+4=5
            b_trits: [1, 1], // same -> 5
            initial_acc: 0,
            expected_acc: 2,
            units_checked: [],
            expected_status_after_reset: 0,
            expected_acc_after_reset: 0,
        };
        let (stage, body) = tb_case_mac_cycle(c);
        assert(stage == 2);
        assert(body.contains("r = dut.mac_cycle(32\'d5, 32\'d5, 8\'d0, 0);"));
        assert(body.contains('if ($signed(r) !== 2) begin'));
        assert(body.contains('$display("FAIL test_mac_cycle: got %0d want 2", $signed(r));'));

    test "tb_case_mac_status returns correct stage and Verilog snippet"
        let c = MacCase {
            expected_trit: 0,
            word_raw: 0,
            index: 0,
            id: "test_mac_status_initial",
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_raw: 0,
            unit: 1,
            trit: 0,
            expected_packed: 0,
            a_trits: [],
            b_trits: [],
            expected_acc: 0,
            initial_acc: 0,
            units_checked: [],
            expected_status_after_reset: 0,
            expected_acc_after_reset: 0,
        };
        let (stage, body) = tb_case_mac_status(c);
        assert(stage == 0); // because id contains "initial"
        assert(body.contains("r = dut.mac_status_read(8\'d1);"));
        assert(body.contains('if (r !== 32\'d0) begin'));
        assert(body.contains('$display("FAIL test_mac_status_initial: got %0d want 0", r);'));

        let c2 = MacCase {
            expected_trit: 0,
            word_raw: 0,
            index: 0,
            id: "test_mac_status_after",
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_raw: 0,
            unit: 1,
            trit: 0,
            expected_packed: 0,
            a_trits: [],
            b_trits: [],
            expected_acc: 0,
            initial_acc: 0,
            units_checked: [],
            expected_status_after_reset: 0,
            expected_acc_after_reset: 0,
        };
        let (stage2, body2) = tb_case_mac_status(c2);
        assert(stage2 == 3); // because id does not contain "initial"
        assert(body2.contains("r = dut.mac_status_read(8\'d1);"));
        assert(body2.contains('if (r !== 32\'d0) begin'));
        assert(body2.contains('$display("FAIL test_mac_status_after: got %0d want 0", r);'));

    test "tb_case_mac_reset returns correct stage and Verilog snippet for units_checked branch"
        let c = MacCase {
            expected_trit: 0,
            word_raw: 0,
            index: 0,
            id: "test_mac_reset_units",
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_raw: 0,
            unit: 0,
            trit: 0,
            expected_packed: 0,
            a_trits: [],
            b_trits: [],
            expected_acc: 42,
            initial_acc: 0,
            units_checked: [0, 1], // two units
            expected_status_after_reset: 0,
            expected_acc_after_reset: 0,
        };
        let (stage, body) = tb_case_mac_reset(c);
        assert(stage == 3);
        assert(body.contains("r = dut.mac_cycle(32\'d1, 32\'d1, 8\'d0, 0);"));
        assert(body.contains("r = dut.mac_reset(8\'d0);"));
        assert(body.contains("r = dut.mac_acc_read(8\'d0);"));
        assert(body.contains('$display("FAIL test_mac_reset_units_u0: got %0d want 42", $signed(r));'));
        assert(body.contains("r = dut.mac_cycle(32\'d1, 32\'d1, 8\'d1, 0);"));
        assert(body.contains("r = dut.mac_reset(8\'d1);"));
        assert(body.contains("r = dut.mac_acc_read(8\'d1);"));
        assert(body.contains('$display("FAIL test_mac_reset_units_u1: got %0d want 42", $signed(r));'));

    test "tb_case_mac_reset returns correct stage and Verilog snippet for expected_status_after_reset branch"
        let c = MacCase {
            expected_trit: 0,
            word_raw: 0,
            index: 0,
            id: "test_mac_reset_status",
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_raw: 0,
            unit: 2,
            trit: 0,
            expected_packed: 0,
            a_trits: [],
            b_trits: [],
            expected_acc: 0,
            initial_acc: 0,
            units_checked: [], // empty -> triggers the else if branch
            expected_status_after_reset: 3,
            expected_acc_after_reset: 0,
        };
        let (stage, body) = tb_case_mac_reset(c);
        assert(stage == 3);
        assert(body.contains("r = dut.mac_cycle(32\'d1, 32\'d1, 8\'d2, 0);"));
        assert(body.contains("r = dut.mac_reset(8\'d2);"));
        assert(body.contains("r = dut.mac_status_read(8\'d2);"));
        assert(body.contains('if (r !== 32\'d3) begin'));
        assert(body.contains('$display("FAIL test_mac_reset_status: got %0d want 3", r);'));

    test "tb_case_mac_reset returns correct stage and Verilog snippet for expected_acc_after_reset branch"
        let c = MacCase {
            expected_trit: 0,
            word_raw: 0,
            index: 0,
            id: "test_mac_reset_acc",
            a_trit0: 0,
            b_trit0: 0,
            expected_trit0: 0,
            expected_raw: 0,
            unit: 1,
            trit: 0,
            expected_packed: 0,
            a_trits: [],
            b_trits: [],
            expected_acc: 0,
            initial_acc: 0,
            units_checked: [], // empty
            expected_status_after_reset: 0, // zero -> triggers the else branch
            expected_acc_after_reset: 99,
        };
        let (stage, body) = tb_case_mac_reset(c);
        assert(stage == 3);
        assert(body.contains("r = dut.mac_cycle(32\'d1, 32\'d1, 8\'d1, 5);"));
        assert(body.contains("r = dut.mac_reset(8\'d1);"));
        assert(body.contains("r = dut.mac_acc_read(8\'d1);"));
        assert(body.contains('$display("FAIL test_mac_reset_acc: got %0d want 99", $signed(r));'));
}