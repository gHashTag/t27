let HERE = dirname(abspath(__file__));
let ROOT = dirname(HERE);

// The registry maps module names to (top_module, vectors_file, group_case_renderers)
let REGISTRY = {
    "spi": (
        "SPI_Master",
        "conformance/fpga_spi.json",
        {
            "spi_prescaler": tb_case_spi_prescaler,
        },
    ),
};

// tb_case_spi_prescaler: returns (stage, verilog_code) for a given case
fn tb_case_spi_prescaler(c: map) -> (int, string) {
    let d = c["expected_divisor"];
    let code = bit_width(d) - 2;
    let ret_str = "    r = dut.spi_set_prescaler(8'd" + code + ");\n    r = dut.spi_get_prescaler_div(1'b0);\n    if (r !== 32'd" + d + ") begin\n      $display(\"FAIL \" + c["id"] + \": got %0d want \" + d + "\", r);\n      fails = fails + 1;\n    end else $display(\"PASS \" + c["id"] + \");\n";
    return (1, ret_str);
}

// run_module: builds and runs the testbench for a given module
fn run_module(name: string, verilog_path: string, workdir: string) -> (int, int, list<string>) {
    let (top, vec_path, groups) = REGISTRY[name];
    let vec_full_path = path.join(ROOT, vec_path);
    let file = open(vec_full_path, "r");
    let json_str = file.read();
    file.close();
    let data = json.parse(json_str);
    let vectors = data["vectors"];

    let stages = {0: [], 1: [], 2: [], 3: []};
    let executed = 0;
    for (gname, render) in groups.items() {
        let cases = vectors.get(gname, {}).get("cases", []);
        for (c) in cases {
            let (stage_num, text) = render(c);
            // We assume stages[stage_num] is a list; we append text.
            let mut stage_list = stages[stage_num];
            stage_list = stage_list + [text];
            stages[stage_num] = stage_list;
            executed = executed + 1;
        }
    }
    // Concatenate all stages in order 0,1,2,3
    let body_str = "";
    for (stage_num in [0, 1, 2, 3]) {
        let stage_list = stages[stage_num];
        for (line) in stage_list {
            body_str = body_str + line;
        }
    }
    let skipped = [g for g in vectors if g not in groups];

    let tb = 
        "\`timescale 1ns/1ps\n" +
        "module conformance_tb;\n" +
        "  reg clk = 0; reg rst_n = 1; reg en = 1; wire ready;\n" +
        "  " + top + " dut(.clk(clk), .rst_n(rst_n), .en(en), .ready(ready));\n" +
        "  reg [31:0] r;\n" +
        "  integer fails = 0;\n" +
        "  initial begin\n" +
        body_str +
        '    if (folds == 0) $display("CONFORMANCE OK: all executed cases passed");\n' +
        '    else $display("CONFORMANCE FAILED: %0d case(s)", fails);\n' +
        "    $finish(fails == 0 ? 0 : 1);\n" +
        "  end\n" +
        "endmodule\n";

    let tb_path = path.join(workdir, name + "_conformance_tb.v");
    let tb_file = open(tb_path, "w");
    tb_file.write(tb);
    tb_file.close();

    let vvp_path = path.join(workdir, name + "_conformance.vvp");
    let iverilog_path = shutil.which("iverilog");
    if (iverilog_path == None) {
        print(name + ": iverilog is not on PATH");
        print(name + ": NOTHING WAS EXECUTED -- the simulator is absent, which is");
        print("not the same as vectors that failed.");
        return (2, 0, skipped);
    }
    let build_result = subprocess.run(
        [iverilog_path, "-g2012", "-DSIMULATION", "-o", vvp_path, verilog_path, tb_path],
        capture_output = true,
        text = true
    );
    if (build_result[0] != 0) {
        print(build_result[2]); // stderr
        print(name + ": TB BUILD FAILED");
        return (1, executed, skipped);
    }
    let vvp_path = shutil.which("vvp");
    if (vvp_path == None) {
        print(name + ": vvp is not on PATH");
        print(name + ": NOTHING WAS EXECUTED -- the simulator is absent.");
        return (2, 0, skipped);
    }
    let sim_result = subprocess.run([vvp_path, vvp_path], capture_output = true, text = true);
    print(sim_result[1]); // stdout
    if (sim_result[2] != "") {
        print(sim_result[2]); // stderr
    }
    let failed = (sim_result[1].index_of("CONFORMANCE OK") == -1) or (sim_result[0] != 0);
    let rc = if (failed) 1 else 0;
    return (rc, executed, skipped);
}

// self_check: runs the whole program for each verdict it can reach without a simulator
fn self_check() -> int {
    let mut ok = true;

    fn case(label: string, argv: list<string>, want: int, expect: list<string>, absent: list<string>, env: map<string,string> | None) -> void {
        let mut r = subprocess.run(
            [sys.executable, path.abspath(__file__)] + argv,
            capture_output = true,
            text = true,
            env = env or os.environ.copy()
        );
        let out = r.stdout + r.stderr;
        let mut missing = [s for s in expect if s not in out];
        let mut leaked = [s for s in absent if s in out];
        let good = (r.returncode == want) and (missing.length == 0) and (leaked.length == 0);
        print("  " + label.ljust(40) + " " + (if good then "exit " + string(want) + ", right branch" else "CONTROL FAILED"));
        if (!good) {
            ok = false;
            print("       exit " + string(r.returncode) + " (want " + string(want) + ")");
            if (missing.length > 0) {
                print("       the branch never said: " + string(missing));
            }
            if (leaked.length > 0) {
                print("       neighbouring marker leaked: " + string(leaked));
            }
            print("       said " + string(out[0:300]));
        }
    }

    case("no arguments is usage, not a pass", [], 2,
         ["usage: run_conformance_vvp.py"],
         ["CONFORMANCE OK", "NOTHING WAS EXECUTED", "TB BUILD FAILED", "Traceback"],
         None);

    case("a module outside the registry is refused",
         ["not_a_real_module", "/nonexistent.v"], 2,
         ["not in the executed-vector registry"],
         ["CONFORMANCE OK", "TB BUILD FAILED", "Traceback"],
         None);

    let name = sorted(REGISTRY.keys())[0];
    with tempfile.TemporaryDirectory() as td {
        // Check if iverilog is available for the unbuildable RTL test
        if (shutil.which("iverilog") != None) {
            let bad_v = path.join(td, "not_verilog.v");
            let bad_file = open(bad_v, "w");
            bad_file.write("this is not verilog at all\n");
            bad_file.close();
            case("unbuildable RTL is a build failure",
                 [name, bad_v, td], 1,
                 [name + ": TB BUILD FAILED"],
                 ["CONFORMANCE OK", "is not on PATH", "Traceback"],
                 None);
        } else {
            print("  unbuildable RTL is a build failure     UNRUN (no iverilog on PATH)");
            ok = false;
        }

        // Test with simulator removed from PATH
        let stripped_env = os.environ.copy();
        let paths = stripped_env["PATH"].split(path.pathsep);
        let filtered_paths = [p for p in paths if p != "" and not path.exists(path.join(p, "iverilog"))];
        let new_path = path.pathsep.join(filtered_paths);
        stripped_env["PATH"] = new_path;
        case("a missing simulator is named, not a failure",
             [name, path.join(td, "whatever.v"), td], 2,
             ["iverilog is not on PATH", "NOTHING WAS EXECUTED"],
             ["TB BUILD FAILED", "CONFORMANCE OK", "Traceback"],
             stripped_env);
    }

    print("  self-check: four verdicts reached, each by its own message; the passing path and per-case mismatch are NOT covered here = " + string(ok));
    return if (ok) 0 else 1;
}

// main: entry point
fn main() -> int {
    if ("--self-check" in sys.argv) {
        return self_check();
    }
    if (sys.argv.length < 3) {
        print("usage: run_conformance_vvp.py <module> <generated.v> [workdir]");
        return 2;
    }
    let name = sys.argv[1];
    let verilog_path = sys.argv[2];
    let workdir = if (sys.argv.length > 3) then sys.argv[3] else "/tmp";
    if (!(name in REGISTRY)) {
        print(name + ": not in the executed-vector registry (v1 covers: " + string(sorted(REGISTRY.keys())) + ")");
        return 2;
    }
    let (rc, executed, skipped) = run_module(name, verilog_path, workdir);
    print("executed cases: " + string(executed) + "; groups not yet executed: " + string(skipped.length) + " " + string(sorted(skipped)));
    // T67: zero executed cases is a FAILURE, not a pass.
    if (rc == 0 and executed == 0) {
        print();
        print(name + ": NOTHING WAS EXECUTED. 'all executed cases passed' over an");
        print("empty set is not a pass -- the vectors this module names are gone,");
        print("unparseable, or no longer match the registry's call templates.");
        return 1;
    }
    return rc;
}

if (__name__ == "__main__") {
    sys.exit(main());
}

// Tests
test "tb_case_spi_prescaler" {
    let c = { "expected_divisor": 4, "id": "TEST1" };
    let (stage, verilog_code) = tb_case_spi_prescaler(c);
    expect stage == 1;
    expect verilog_code == 
        "    r = dut.spi_set_prescaler(8'd1);\n" +
        "    r = dut.spi_get_prescaler_div(1'b0);\n" +
        "    if (r !== 32'd4) begin\n" +
        "      $display(\"FAIL TEST1: got %0d want 4\", r);\n" +
        "      fails = fails + 1;\n" +
        "    end else $display(\"PASS TEST1\");\n";
}

test "run_module" {
    // Test with a non-existent module to check error handling
    let (rc, executed, skipped) = run_module("not_a_real_module", "/nonexistent.v", "/tmp");
    expect rc == 2;
    expect executed == 0;
    // skipped is a list; we don't check its content
}

test "self_check" {
    // We cannot easily test self_check without mocking, but we can call it and check that it returns an int
    let rc = self_check();
    // We expect it to return 0 or 1; we don't know which without the test environment.
    // We'll just check that it is an integer.
    expect rc == 0 or rc == 1;
}

