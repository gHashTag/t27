// specs/port/tools/check_conflict_markers.t27
// Port of tools/check_conflict_markers.py
// φ² + 1/φ² = 3 | TRINITY

module CheckConflictMarkers {
    use base::types;
    use shell::schema;
    use shell::process;

    // ════════════════════════════════════════════════════════════════════════════
    // Types
    // ════════════════════════════════════════════════════════════════════════════

    // ConflictMarker represents a conflict marker found in a file
    struct ConflictMarker {
        line_number: u32,
        line: str,
    }

    // GitResult represents the result of a git command
    struct GitResult {
        exit_code: i32,
        stdout: str,
        stderr: str,
        success: bool,
    }

    // ScanResult represents the result of a scan
    struct ScanResult {
        files_with_markers: [str],
        markers: [ConflictMarker],
        baseline_markers: [ConflictMarker],
        new_markers: [ConflictMarker],
    }

    // ════════════════════════════════════════════════════════════════════════════
    // Internal: _git
    // ════════════════════════════════════════════════════════════════════════════

    // _git runs a git command in the given root directory
    fn _git(root: str, args: [str], binary: bool) -> Result<GitResult, str> {
        var opts = ProcessOptions {
            cwd = root,
            env = [],
            timeout = 30000,
            stdin = null,
            captureOutput = true,
            abort = false,
        };

        var cmd = ["git"] + args;
        var process_result = process::spawn_shell("git " + args.join(" "), opts);

        if (process_result.is_err()) {
            return err("Failed to spawn git: " + process_result.unwrap_err());
        }

        var result = process_result.unwrap();
        var git_result = GitResult {
            exit_code = result.exitCode,
            stdout = result.stdout,
            stderr = result.stderr,
            success = result.success,
        };

        if (!git_result.success && !binary) {
            return err("Git command failed: " + git_result.stderr);
        }

        return ok(git_result);
    }

    // ════════════════════════════════════════════════════════════════════════════
    // tracked_files
    // ════════════════════════════════════════════════════════════════════════════

    // tracked_files returns all files tracked by git in the repository
    fn tracked_files(root: str) -> Result<[str], str> {
        var result = _git(root, ["ls-files", "-z"], false);
        
        if (result.is_err()) {
            return err(result.unwrap_err());
        }

        var git_result = result.unwrap();
        var files = git_result.stdout.split("\0");
        var filtered = [str]();

        for (file in files) {
            if (file.len > 0) {
                filtered.push(file);
            }
        }

        return ok(filtered);
    }

    // ════════════════════════════════════════════════════════════════════════════
    // staged_files
    // ════════════════════════════════════════════════════════════════════════════

    // staged_files returns all files staged in the index
    fn staged_files(root: str) -> Result<[str], str> {
        var result = _git(root, ["diff", "--cached", "--name-only", "-z"], false);
        
        if (result.is_err()) {
            return err(result.unwrap_err());
        }

        var git_result = result.unwrap();
        var files = git_result.stdout.split("\0");
        var filtered = [str]();

        for (file in files) {
            if (file.len > 0) {
                filtered.push(file);
            }
        }

        return ok(filtered);
    }

    // ════════════════════════════════════════════════════════════════════════════
    // markers_in_text
    // ════════════════════════════════════════════════════════════════════════════

    // markers_in_text finds conflict markers in the given text
    // Returns array of (line_number, line) tuples
    fn markers_in_text(text: str) -> [ConflictMarker] {
        var lines = text.split("\n");
        var markers = [ConflictMarker]();
        var line_number: u32 = 1;

        for (line in lines) {
            // Check for conflict marker patterns
            // <<<<<<<, =======, >>>>>>>
            if (line.starts_with("<<<<<<<") 
                || line.starts_with("=======") 
                || line.starts_with(">>>>>>>")) {
                markers.push(ConflictMarker {
                    line_number = line_number,
                    line = line,
                });
            }
            line_number = line_number + 1;
        }

        return markers;
    }

    // ════════════════════════════════════════════════════════════════════════════
    // markers_in_index
    // ════════════════════════════════════════════════════════════════════════════

    // markers_in_index checks for conflict markers in a staged file
    fn markers_in_index(root: str, name: str) -> Result<[ConflictMarker], str> {
        var result = _git(root, ["show", ":" + name], true);
        
        if (result.is_err()) {
            return err(result.unwrap_err());
        }

        var git_result = result.unwrap();
        
        if (!git_result.success) {
            return ok([ConflictMarker]());
        }

        var markers = markers_in_text(git_result.stdout);
        return ok(markers);
    }

    // ════════════════════════════════════════════════════════════════════════════
    // markers_in
    // ════════════════════════════════════════════════════════════════════════════

    // markers_in checks for conflict markers in a file at the given path
    fn markers_in(path: str) -> Result<[ConflictMarker], str> {
        // Read file content
        // In T27, we'd use filesystem operations, but for now we'll simulate
        // This would need a file read operation from the shell/filesystem module
        
        // For the port, we'll define the interface - the actual file reading
        // would be implemented via shell process or a filesystem module
        var read_result = process::spawn_shell("cat " + path, ProcessOptions {
            cwd = "",
            env = [],
            timeout = 5000,
            stdin = null,
            captureOutput = true,
            abort = false,
        });

        if (read_result.is_err()) {
            return err("Failed to read file: " + read_result.unwrap_err());
        }

        var result = read_result.unwrap();
        
        if (!result.success) {
            return err("Failed to read file: exit code " + result.exitCode.to_str());
        }

        var markers = markers_in_text(result.stdout);
        return ok(markers);
    }

    // ════════════════════════════════════════════════════════════════════════════
    // load_baseline
    // ════════════════════════════════════════════════════════════════════════════

    // load_baseline loads the conflict markers baseline from .git/conflict-markers-baseline
    fn load_baseline(root: str) -> Result<[ConflictMarker], str> {
        var baseline_path = root + "/.git/conflict-markers-baseline";
        
        var read_result = process::spawn_shell("cat " + baseline_path, ProcessOptions {
            cwd = "",
            env = [],
            timeout = 5000,
            stdin = null,
            captureOutput = true,
            abort = false,
        });

        if (read_result.is_err()) {
            // If file doesn't exist, return empty baseline
            return ok([ConflictMarker]());
        }

        var result = read_result.unwrap();
        
        if (!result.success) {
            return ok([ConflictMarker]());
        }

        var lines = result.stdout.split("\n");
        var markers = [ConflictMarker]();

        for (line in lines) {
            if (line.len == 0) {
                continue;
            }
            // Parse baseline format: "file:line_number:line_content"
            var parts = line.split(":", 3);
            if (parts.len >= 3) {
                var file = parts[0];
                var line_num_str = parts[1];
                var line_content = parts[2];
                
                var line_num = line_num_str.parse_u32();
                if (line_num.is_ok()) {
                    markers.push(ConflictMarker {
                        line_number = line_num.unwrap(),
                        line = line_content,
                    });
                }
            }
        }

        return ok(markers);
    }

    // ════════════════════════════════════════════════════════════════════════════
    // scan
    // ════════════════════════════════════════════════════════════════════════════

    // scan scans the repository for conflict markers
    fn scan(root: str, staged: bool) -> Result<ScanResult, str> {
        var files_to_check = [str]();
        
        if (staged) {
            var staged_result = staged_files(root);
            if (staged_result.is_err()) {
                return err(staged_result.unwrap_err());
            }
            files_to_check = staged_result.unwrap();
        } else {
            var tracked_result = tracked_files(root);
            if (tracked_result.is_err()) {
                return err(tracked_result.unwrap_err());
            }
            files_to_check = tracked_result.unwrap();
        }

        var all_markers = [ConflictMarker]();
        var files_with_markers = [str]();

        for (file in files_to_check) {
            var markers_result;
            
            if (staged) {
                markers_result = markers_in_index(root, file);
            } else {
                var full_path = root + "/" + file;
                markers_result = markers_in(full_path);
            }

            if (markers_result.is_err()) {
                // Skip files that can't be read
                continue;
            }

            var markers = markers_result.unwrap();
            
            if (markers.len > 0) {
                files_with_markers.push(file);
                for (marker in markers) {
                    all_markers.push(marker);
                }
            }
        }

        var baseline_result = load_baseline(root);
        var baseline_markers = [ConflictMarker]();
        
        if (baseline_result.is_ok()) {
            baseline_markers = baseline_result.unwrap();
        }

        // Compute new markers (not in baseline)
        var new_markers = [ConflictMarker]();
        
        for (marker in all_markers) {
            var in_baseline = false;
            for (baseline in baseline_markers) {
                if (marker.line_number == baseline.line_number && marker.line == baseline.line) {
                    in_baseline = true;
                    break;
                }
            }
            if (!in_baseline) {
                new_markers.push(marker);
            }
        }

        var scan_result = ScanResult {
            files_with_markers = files_with_markers,
            markers = all_markers,
            baseline_markers = baseline_markers,
            new_markers = new_markers,
        };

        return ok(scan_result);
    }

    // ════════════════════════════════════════════════════════════════════════════
    // Tests
    // ════════════════════════════════════════════════════════════════════════════

    test "_git runs git command successfully" {
        // Test would need a git repo - mock for now
        var result = _git(".", ["--version"], false);
        assert(result.is_ok(), "_git should succeed for valid command");
        var git_result = result.unwrap();
        assert(git_result.success, "git --version should succeed");
        assert(git_result.stdout.len > 0, "should have version output");
    }

    test "tracked_files returns tracked files" {
        var result = tracked_files(".");
        assert(result.is_ok(), "tracked_files should succeed in a git repo");
        var files = result.unwrap();
        assert(files.len > 0, "should have tracked files");
    }

    test "staged_files returns staged files" {
        var result = staged_files(".");
        assert(result.is_ok(), "staged_files should succeed");
        // In a clean repo, this returns empty array
        var files = result.unwrap();
        // Just verify it returns an array
        assert(true, "staged_files returns array");
    }

    test "markers_in_text finds conflict markers" {
        var text = "line 1\n<<<<<<< HEAD\nconflict\n=======\nother\n>>>>>>> branch\nline 6";
        var markers = markers_in_text(text);
        assert(markers.len == 3, "should find 3 conflict markers");
        assert(markers[0].line_number == 2, "first marker at line 2");
        assert(markers[0].line == "<<<<<<< HEAD", "first marker content");
        assert(markers[1].line_number == 4, "second marker at line 4");
        assert(markers[1].line == "=======", "second marker content");
        assert(markers[2].line_number == 6, "third marker at line 6");
        assert(markers[2].line == ">>>>>>> branch", "third marker content");
    }

    test "markers_in_text returns empty for clean text" {
        var text = "line 1\nline 2\nline 3";
        var markers = markers_in_text(text);
        assert(markers.len == 0, "should find no markers in clean text");
    }

    test "markers_in_index checks staged file" {
        // This test would need a git repo with staged changes
        var result = markers_in_index(".", "nonexistent.txt");
        // Should handle missing files gracefully
        assert(result.is_ok() || result.is_err(), "should return result");
    }

    test "markers_in reads file and finds markers" {
        // This test would need a temp file with conflict markers
        // For now, test the interface exists
        var result = markers_in("/nonexistent/file.txt");
        assert(result.is_err(), "should error for nonexistent file");
    }

    test "load_baseline loads baseline file" {
        var result = load_baseline(".");
        assert(result.is_ok(), "load_baseline should succeed");
        var markers = result.unwrap();
        // Baseline may be empty if file doesn't exist
        assert(true, "returns array of markers");
    }

    test "scan finds conflict markers in repo" {
        var result = scan(".", false);
        assert(result.is_ok(), "scan should succeed");
        var scan_result = result.unwrap();
        assert(scan_result.files_with_markers.len >= 0, "has files array");
        assert(scan_result.markers.len >= 0, "has markers array");
        assert(scan_result.baseline_markers.len >= 0, "has baseline array");
        assert(scan_result.new_markers.len >= 0, "has new markers array");
    }

    test "scan staged mode checks staged files" {
        var result = scan(".", true);
        assert(result.is_ok(), "scan staged should succeed");
        var scan_result = result.unwrap();
        assert(true, "returns scan result for staged files");
    }
}