// SPDX-License-Identifier: Apache-2.0
// specs/port/tools/check_duplicate_declarations.t27 -- port of
// tools/check_duplicate_declarations.py to .t27. The host runs t27c over the
// corpus and ratchets per-spec duplicate counts; the port keeps the finding
// messages and the exit-code contract, with the host scan stubbed.

module CheckDuplicateDeclarations;

// Constants
pub const STRONG : str = "every backend rejects a redeclaration";
pub const WEAK : str = "both a type and a function";
pub const LOWERED : str = "SAME identifier in";

// The binary path the host gate invokes; stubbed, the port never runs it.
pub fn t27c() -> str {
    return "t27c";
}

// Stub for the host scan: (strong, weak, lowered) duplicate counts for one
// spec. The real gate derives them from `t27c check` output.
pub fn findings(binary: str, spec: str) -> (u32, u32, u32) {
    return (0, 0, 0);
}

// Stub for the corpus walk: no specs are enumerated by the port itself.
pub fn specs() -> []str {
    return []str{};
}

// Stub for the baseline maps; the host reads the two baseline files.
pub fn read_baseline() -> []str {
    return []str{};
}

pub fn read_lowered_baseline() -> []str {
    return []str{};
}

// Stub for the negative control: the host plants a fixture with a known
// duplicate and asserts the gate names it.
pub fn self_check(binary: str) -> u32 {
    return 0;
}

// The original's main(): 0 = every spec within its baseline, 1 = a growth or a
// new duplicate, 2 = the gate could not run. The port has no corpus to scan,
// so the honest verdict for a non-run is 2.
pub fn main() -> u32 {
    return 2;
}

// The port keeps the gate's vocabulary and its honest non-run verdict (#8475):
// the finding messages stay byte-stable, the stub scans enumerate nothing, the
// negative control stays green, and main still refuses to claim a scan ran.
test duplicate_gate_stub_contract {
    assert(STRONG == "every backend rejects a redeclaration");
    assert(WEAK == "both a type and a function");
    assert(LOWERED == "SAME identifier in");
    assert(t27c() == "t27c");
    assert(specs().len == 0);
    assert(read_baseline().len == 0);
    assert(read_lowered_baseline().len == 0);
    assert(self_check(t27c()) == 0);
    assert(main() == 2);
}
