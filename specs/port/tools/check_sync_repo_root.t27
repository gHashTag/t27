    when result = self_check()
    then result == EXIT_OK

test "self_check_rejects_invalid_patterns"
    // The self_check function internally tests invalid patterns
    // and only returns EXIT_OK if all pass
    given 
    when result = self_check()
    then result == EXIT_OK

test "main_returns_ok_for_correct_depth"
