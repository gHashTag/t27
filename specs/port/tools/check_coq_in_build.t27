test "is_coq identifies Coq code" {
    let coq_code = "Theorem test : True.\nProof. trivial.\nQed.";
    let verilog_code = "module test; endmodule";
    let mixed_code = "Module Test.\n  (* Some comment *)\nEnd Test.\nmodule test; endmodule";
    
    assert(is_coq(coq_code) == true);
    assert(is_coq(verilog_code) == false);
    // Mixed case depends on which has more matches
}

