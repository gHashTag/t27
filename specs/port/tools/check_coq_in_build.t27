module check_coq_in_build;

// Constants from the original implementation
pub const VERILOG_KEYWORD_REGEX : str = r"(?m)^\s*(module|endmodule|input|output|inout|wire|reg|assign|always)\b";
pub const COQ_KEYWORD_REGEX : str = r"(?m)^\s*(\(*\)|Theorem|Lemma|Corollary|Proposition|Fact|Remark|Example|Definition|Fixpoint|CoFixpoint|Inductive|CoInductive|Section|End|Require|Import|Export|Variable|Variables|Hypothesis|Hypotheses|Let|Notation|Reserved|Infix|Bind|Scope|Open|Close|Delimit|Local|Global|Unset|Set|Check|Compute|Eval|Extraction|Proof|Qed|Defined|Saved|Admitted|Axiom|Parameter|Parameters|Variable|Variables|Hypothesis|Hypotheses)\b";
pub const COQ_TACTIC_REGEX : str = r"(?m)^\s*(intros|intro|apply|exact|reflexivity|symmetry|transitivity|rewrite|simpl|compute|unfold|fold|destruct|induction|inversion|split|left|right|exists|assert|cut|have|pose|generalize|dependent|revert|move|case|eqname|rename|pattern|generalize|dependent|in|clear|subst|automaton|tauto|ring|ring_simplify|field|field_simplify|omega|lia|nia|psatz|oconstraint|syntax|assertions|refine|eapply|econstructor|eexists|left|right|split|exists|exfalso|contradiction|discriminate|injection|congruence|namespace|section)\b";

// Port of refuse() function from line 43 of the original
fn refuse(msg: str) -> void {
    @printErr("check_coq_in_build.py: error: " + msg);
    @exit(2);
}

// Port of is_coq() function from line 49 of the original
fn is_coq(text: str) -> bool {
    let mut verilog_count : i32 = 0;
    let mut coq_count : i32 = 0;
    
    for line in text.split("\n") {
        if @regexMatch(line, VERILOG_KEYWORD_REGEX) {
            verilog_count = verilog_count + 1;
        }
        if @regexMatch(line, COQ_KEYWORD_REGEX) || @regexMatch(line, COQ_TACTIC_REGEX) {
            coq_count = coq_count + 1;
        }
    }
    
    return coq_count > verilog_count;
}

// Port of projects() function from line 54 of the original
fn projects() -> [str] {
    // Find all _CoqProject files
    return @glob("_CoqProject");
}

// Port of listed() function from line 61 of the original
fn listed() -> [str] {
    let mut files : [str] = [];
    
    for project in projects() {
        if @isFile(project) {
            let content = @readToString(project);
            for line in content.split("\n") {
                let trimmed = @trim(line);
                if trimmed.len() > 0 && !trimmed.startsWith("#") && !trimmed.startsWith("-") {
                    // Handle relative paths - make them absolute if needed
                    let abs_path = if @isAbsolute(trimmed) {
                        trimmed
                    } else {
                        @join(@dirname(project), trimmed)
                    };
                    files[abs_path] = true; // Using map-like behavior to deduplicate
                }
            }
        }
    }
    
    // Convert map keys to array
    let mut result : [str] = [];
    for key in files.keys() {
        result[key.len()] = key;
    }
    return result;
}

// Port of coq_files() function from line 74 of the original
fn coq_files() -> [str] {
    let mut result : [str] = [];
    
    for file in @glob("**/*.v") {
        if @isFile(file) {
            let content = @readToString(file);
            if is_coq(content) {
                result[result.len()] = file;
            }
        }
    }
    
    return result;
}

// Port of outside() function from line 90 of the original
fn outside() -> [str] {
    let mut listed_set : [bool] = [];
    for file in listed() {
        listed_set[file] = true;
    }
    
    let mut result : [str] = [];
    for file in coq_files() {
        if !listed_set.containsKey(file) || !listed_set[file] {
            result[result.len()] = file;
        }
    }
    
    return result;
}

// Port of load() function from line 95 of the original
fn load() -> [bool] {
    if !@isFile(".lab02") {
        return [];
    }
    
    let content = @readToString(".lab02");
    let mut result : [bool] = [];
    
    for line in content.split("\n") {
        let trimmed = @trim(line);
        if trimmed.len() > 0 {
            result[trimmed] = true;
        }
    }
    
    return result;
}

// Port of write() function from line 102 of the original
fn write(rows: [str]) -> void {
    let mut content : str = "";
    for row in rows {
        content = content + row + "\n";
    }
    @writeString(".lab02", content);
}

