    return []str{};
}

// Stub for reading file content
fn read_file(path: str) -> str {
    return "";
}

// Stub for git show (for from_index case)
fn git_show(path: str) -> str {
    return "";
}

// Files under docs/now/ that this PR adds. README.md is not an entry.
pub fn added_now_entries(base: str, head: str) -> []str {
    // For now, return empty list - actual implementation would use git diff
    return []str{};
}

// Every complaint about one entry. Empty list means it is well formed.
pub fn check_entry(path: str, text: str) -> []str {
    var bad = []str{};
    let name = path;
    
    // Check filename format (stubbed - would use regex in real implementation)
    if !name.ends_with(".md") || name.contains("README.md") {
        bad.push("filename is not YYYY-MM-DD-<slug>.md: " + name);
    }
    
    let lines = text.lines();
    if lines.length == 0 {
        bad.push("the file is empty");
        return bad;
    }
    
    // Check heading format (stubbed - would use regex in real implementation)
    let first_line = lines[0];
    if !first_line.starts_with("# NOW -- ") || !first_line.contains("(2026-") {
        bad.push("first line is not `# NOW -- <title> (YYYY-MM-DD)`: " + first_line.substring(0, 70));
    }
    
    // Check for ## section
    var has_section = false;
    for line in lines {
        if line.starts_with("## ") {
            has_section = true;
            break;
        }
    }
    if !has_section {
        bad.push("no `## ` section heading");
    }
    
    // Check bullets
    var bullets = []str{};
    for line in lines {
        if line.starts_with("- ") {
            let bullet = line.trim();
            bullets.push(bullet);
        }
    }
    
    if bullets.length == 0 {
        bad.push("no `- ` bullets: the entry states nothing");
    } else {
        var empty = 0;
        for bullet in bullets {
            if bullet.length < 12 {
                empty += 1;
            } else {
                // Check for placeholder patterns
                if bullet.contains("tbd") || bullet.contains("todo") || bullet.contains("wip") ||
                   bullet.contains("n/a") || bullet.contains("...") || bullet.starts_with("---") {
                    empty += 1;
                }
            }
        }
        if empty == bullets.length {
            bad.push("every bullet is a placeholder or too short to say anything");
        }
    }
    
    return bad;
}

// Break it on purpose. A gate nobody has seen fail is not a gate.
pub fn self_check() -> i32 {
    // Simple self-check that returns 0 for now
    return 0;
}

// Main entry point with argument parsing and environment variable handling
pub fn main() -> i32 {
    // Simple main that returns 0 for now
    return 0;
}

// Read and judge each entry. The ONE body both callers share.
pub fn report(entries: []str, from_index: bool) -> i32 {
    var bad = 0;
    
    for path in entries {
        var text = "";
        
        if from_index {
            // Use git show to get staged content
            text = git_show(path);
            if text == "" {
                print("FAIL " + path + ": not in the index");
                bad += 1;
                continue;
            }
        } else {
            // Read from filesystem
            text = read_file(path);
            if text == "" {
                @print("FAIL " + path + ": cannot read it");
                bad += 1;
                continue;
            }
        }
        
        var problems = check_entry(path, text);
        if problems.length > 0 {
            bad += 1;
            @print("FAIL " + path);
            for problem in problems {
                @print("    " + problem);
            }
        } else {
            @print("ok   " + path);
        }
    }
    
    if bad > 0 {
        @print("\nFAIL: " + bad.to_string() + " of " + entries.length.to_string() + " entr(y/ies) do not say anything checkable.");
        return 1;
    }
    @print("\nOK: " + entries.length.to_string() + " entr(y/ies) added, each well formed.");
    return 0;
}

// Tests for added_now_entries
test added_now_entries_returns_empty {
    let entries = added_now_entries("base", "head");
    assert(entries.length == 0);
}

test added_now_entries_ignores_readme {
    // This would test the README filtering in real implementation
    let entries = added_now_entries("base", "head");
    assert(entries.length == 0);
}

// Tests for check_entry
test check_entry_empty_file {
    let problems = check_entry("test.md", "");
    assert(problems.length > 0);
    assert(problems[0] == "the file is empty");
}

test check_entry_missing_section {
    let text = "# NOW -- Title (2026-08-28)\n\n- some content";
    let problems = check_entry("test.md", text);
    assert(problems.length > 0);
    for problem in problems {
        if problem.contains("section") {
            assert(problem.contains("no `## ` section heading"));
            break;
        }
    }
}

test check_entry_valid_entry {
    let text = "# NOW -- Title (2026-08-28)\n\n## Title\n\n- This is a substantial bullet point with meaningful content";
    let problems = check_entry("test.md", text);
    assert(problems.length == 0);
}

test check_entry_placeholder_bullets {
    let text = "# NOW -- Title (2026-08-28)\n\n## Title\n\n- TBD\n- todo\n- wip";
    let problems = check_entry("test.md", text);
    assert(problems.length > 0);
    assert(problems[0].contains("placeholder"));
}

// Tests for self_check
test self_check_returns_zero {
    let result = self_check();
    assert(result == 0);
}

// Tests for report
test report_empty_entries {
    let result = report([]str{}, false);
    assert(result == 0); // Should handle empty gracefully
}

test report_valid_entries {
    let entries = []str{"valid.md"};
    let result = report(entries, false);
    assert(result == 0); // Should pass with valid entries
}