// specs/port/tools/check_now_entry_shape.t27 -- port of
// tools/check_now_entry_shape.py to .t27. Validates that docs/now/ entries
// added by PRs have proper format: YYYY-MM-DD-<slug>.md filename,
// # NOW -- <title> (YYYY-MM-DD) heading, matching dates, ## section,
// and non-placeholder bullets.

module check_now_entry_shape;

use std::fs;
use std::os;
use std::process;
use std::string;
use std::temp;

// Constants for filename and heading validation
const FILENAME_PATTERN : str = "^(\\d{4}-\\d{2}-\\d{2})-[a-z0-9][a-z0-9-]*\\.md$";
const HEADING_PATTERN : str = "^# NOW -- (.+) \\((\\d{4}-\\d{2}-\\d{2})\\)\\s*$";
const PLACEHOLDER_PATTERN : str = "^(tbd|todo|wip|n/?a|\\.\\.\\.|-+)$";

