module TernaryModel;

// _i16: wrap value to signed 16-bit two's complement range [-32768, 32767]
fn _i16(v: i32) -> i16 {
    return (((v + 32768) & 0xFFFF) - 32768) as i16;
}

// _i8: wrap value to signed 8-bit two's complement range [-128, 127]
fn _i8(v: i32) -> i8 {
    return (((v + 128) & 0xFF) - 128) as i8;
}

// tmul: ternary multiplication
// if ta == 1 -> 0; if tb == 1 -> 0; if ta == tb -> 1; else -1
fn tmul(ta: u8, tb: u8) -> i8 {
    if (ta == 1) { return 0; }
    if (tb == 1) { return 0; }
    if (ta == tb) { return 1; }
    return _i8(-1);
}

// dot27: sum of tmul over 27 trit lanes, two bits each, accumulated in i16
fn dot27(a: u64, b: u64) -> i16 {
    var acc : i16 = 0;
    var i : u32 = 0;
    while (i < 27) {
        var ta : u8 = ((a >> (i << 1)) & 3) as u8;
        var tb : u8 = ((b >> (i << 1)) & 3) as u8;
        acc = _i16(acc + tmul(ta, tb) as i16);
        i = i + 1;
    }
    return acc;
}

// sign0: v > 0 -> 2; v < 0 -> 0; else 1
fn sign0(v: i16) -> u8 {
    if (v > 0) { return 2; }
    if (v < 0) { return 0; }
    return 1;
}

// negate: 2 -> 0; 0 -> 2; anything else -> 1
fn negate(t: u8) -> u8 {
    if (t == 2) { return 0; }
    if (t == 0) { return 2; }
    return 1;
}

// pack2: packs two trits (NOT masked to two bits, spec behaviour reproduced)
fn pack2(t0: u64, t1: u64) -> u64 {
    var z : u64 = 6004799503160661;
    var cleared : u64 = z & 18446744073709551600;
    return (cleared | (t0 & 0xFFFFFFFFFFFFFFFF) | ((t1 & 0xFFFFFFFFFFFFFFFF) << 2)) & 0xFFFFFFFFFFFFFFFF;
}

// pack3: packs three trits
fn pack3(t0: u64, t1: u64, t2: u64) -> u64 {
    var z : u64 = 6004799503160661;
    var cleared : u64 = z & 18446744073709551552;
    return (cleared | t0 | (t1 << 2) | (t2 << 4)) & 0xFFFFFFFFFFFFFFFF;
}

// Tests for _i16
test _i16_zero { assert_eq(_i16(0), 0); }
test _i16_positive { assert_eq(_i16(100), 100); }
test _i16_negative { assert_eq(_i16(-100), -100); }
test _i16_wrap_positive { assert_eq(_i16(32768), -32768); }
test _i16_wrap_negative { assert_eq(_i16(-32769), 32767); }

// Tests for _i8
test _i8_zero { assert_eq(_i8(0), 0); }
test _i8_positive { assert_eq(_i8(50), 50); }
test _i8_negative { assert_eq(_i8(-50), -50); }
test _i8_wrap_positive { assert_eq(_i8(128), -128); }
test _i8_wrap_negative { assert_eq(_i8(-129), 127); }

// Tests for tmul
test tmul_ta_one { assert_eq(tmul(1, 0), 0); }
test tmul_tb_one { assert_eq(tmul(0, 1), 0); }
test tmul_both_one { assert_eq(tmul(1, 1), 0); }
test tmul_equal_zero { assert_eq(tmul(0, 0), 1); }
test tmul_equal_two { assert_eq(tmul(2, 2), 1); }
test tmul_equal_three { assert_eq(tmul(3, 3), 1); }
test tmul_diff_zero_two { assert_eq(tmul(0, 2), -1); }
test tmul_diff_two_zero { assert_eq(tmul(2, 0), -1); }

// Tests for dot27
test dot27_zero { assert_eq(dot27(0, 0), 0); }
test dot27_single_trit { assert_eq(dot27(0, 0), 0); }
test dot27_all_zero_trits { assert_eq(dot27(0, 0), 0); }
test dot27_matching_trits { assert_eq(dot27(0x555555555555555, 0x555555555555555), 27); }
test dot27_opposite_trits { assert_eq(dot27(0x555555555555555, 0xAAAAAAAAAAAAAAA), -27); }

// Tests for sign0
test sign0_positive { assert_eq(sign0(1), 2); }
test sign0_negative { assert_eq(sign0(-1), 0); }
test sign0_zero { assert_eq(sign0(0), 1); }
test sign0_large_positive { assert_eq(sign0(1000), 2); }
test sign0_large_negative { assert_eq(sign0(-1000), 0); }

// Tests for negate
test negate_two { assert_eq(negate(2), 0); }
test negate_zero { assert_eq(negate(0), 2); }
test negate_one { assert_eq(negate(1), 1); }
test negate_three { assert_eq(negate(3), 1); }

// Tests for pack2
test pack2_zero_zero { assert_eq(pack2(0, 0), 6004799503160661 & 18446744073709551600); }
test pack2_one_two { assert_eq(pack2(1, 2), (6004799503160661 & 18446744073709551600) | 1 | (2 << 2)); }
test pack2_large_values { assert_eq(pack2(5, 10), (6004799503160661 & 18446744073709551600) | 5 | (10 << 2)); }

// Tests for pack3
test pack3_zero_zero_zero { assert_eq(pack3(0, 0, 0), 6004799503160661 & 18446744073709551552); }
test pack3_one_two_three { assert_eq(pack3(1, 2, 3), (6004799503160661 & 18446744073709551552) | 1 | (2 << 2) | (3 << 4)); }
test pack3_large_values { assert_eq(pack3(5, 10, 15), (6004799503160661 & 18446744073709551552) | 5 | (10 << 2) | (15 << 4)); }

endmodule