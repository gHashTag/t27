// specs/port/tools/dedupe_identical_tests.t27
// Port of tools/dedupe_identical_tests.py - two functions: blocks, process
// φ² + 1/φ² = 3 | TRINITY

module dedupe-identical-tests;

// Regex patterns for detecting test blocks and top-level items
// TEST matches: test "name" {  OR  test name {  OR  test name (gherkin)
// ITEM matches top-level declarations that end a gherkin test block

// Test block regex: captures indent, quoted name, unquoted name, and opening brace
const TEST_PATTERN = r'^(\s*)test\s+(?:"([^"]*)"|([A-Za-z_][\w\-]*))\s*(\{)?\s*$';
// Item regex: top-level keywords that start a new region
const ITEM_PATTERN = r'^\s*(?:pub\s+)?(test|bench|invariant|fn|struct|enum|module|const|impl|use|type)\b';
// Guarded keywords at any indentation
const GUARDED_ANY = ["struct", "module", "impl", "use", "bench"];
// Guarded keywords at column zero only
const GUARDED_COL0 = ["invariant", "fn", "const", "type", "enum"];

// BlockInfo represents a test block: (start_line, end_line, name)
type BlockInfo = (u32, u32, str);

// blocks(lines: [str]) -> [BlockInfo]
// Returns all test blocks found in the given lines
pub fn blocks(lines: [str]) [BlockInfo] {
    var result: [BlockInfo] = [];
    var i: u32 = 0;
    while (i < @len(lines)) {
        // Match test pattern
        var m = @regexMatch(TEST_PATTERN, lines[i]);
        if (!m.matched) {
            i += 1;
            continue;
        }
        // Extract name: group 2 (quoted) or group 3 (unquoted)
        var name: str = if (m.groups[1].len > 0) m.groups[1] else m.groups[2];
        var end: u32;
        if (m.groups[3].len > 0) {
            // Brace form: match braces
            var depth: i32 = 0;
            // Count braces on the opening line
            for (c in lines[i]) {
                if (c == '{') depth += 1;
                else if (c == '}') depth -= 1;
            }
            var j: u32 = i + 1;
            while (j < @len(lines) && depth > 0) {
                for (c in lines[j]) {
                    if (c == '{') depth += 1;
                    else if (c == '}') depth -= 1;
                }
                j += 1;
            }
            end = j;
        } else {
            // Gherkin form: go to next top-level item
            var j: u32 = i + 1;
            while (j < @len(lines)) {
                var im = @regexMatch(ITEM_PATTERN, lines[j]);
                if (im.matched) break;
                j += 1;
            }
            // Trim trailing blank lines
            while (j > i + 1 && @trim(lines[j - 1]).len == 0) {
                j -= 1;
            }
            end = j;
        }
        result = @append(result, (i, end, name));
        i = end;
    }
    return result;
}

// counts(lines: [str]) -> [(str, u32)]
// Counts guarded keywords for the counting control
fn counts(lines: [str]) [(str, u32)] {
    var counts_map: [(str, u32)] = [];
    for (line in lines) {
        // Check GUARDED_ANY at any indentation
        var m_any = @regexMatch(r'^\s*(?:pub\s+)?([a-z_]+)\b', line);
        if (m_any.matched) {
            var kw = m_any.groups[0];
            for (g in GUARDED_ANY) {
                if (kw == g) {
                    // Increment count in map
                    var found = false;
                    for (idx in 0..@len(counts_map)) {
                        if (counts_map[idx].0 == kw) {
                            counts_map[idx] = (kw, counts_map[idx].1 + 1);
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        counts_map = @append(counts_map, (kw, 1));
                    }
                    break;
                }
            }
        }
        // Check GUARDED_COL0 at column zero only
        var m_col0 = @regexMatch(r'^(?:pub )?([a-z_]+)\b', line);
        if (m_col0.matched) {
            var kw = m_col0.groups[0];
            for (g in GUARDED_COL0) {
                if (kw == g) {
                    var key = "col0-" + kw;
                    var found = false;
                    for (idx in 0..@len(counts_map)) {
                        if (counts_map[idx].0 == key) {
                            counts_map[idx] = (key, counts_map[idx].1 + 1);
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        counts_map = @append(counts_map, (key, 1));
                    }
                    break;
                }
            }
        }
    }
    return counts_map;
}

// counts_equal(a, b: [(str, u32)]) -> bool
// Compares two count maps for equality
fn counts_equal(a: [(str, u32)], b: [(str, u32)]) bool {
    if (@len(a) != @len(b)) return false;
    for (i in 0..@len(a)) {
        var found = false;
        for (j in 0..@len(b)) {
            if (a[i].0 == b[j].0 && a[i].1 == b[j].1) {
                found = true;
                break;
            }
        }
        if (!found) return false;
    }
    return true;
}

// process(content: str) -> Option<str>
// Returns the deduplicated content if duplicates were removed, or None if no changes
// Returns error string if round-trip or counting control fails
pub fn process(content: str) Option<str> {
    var lines = @split(content, "\n");
    var bs = blocks(lines);
    if (@len(bs) == 0) {
        return Option<str>.None;
    }
    
    // ROUND-TRIP CONTROL: rebuild from blocks must match original lines
    var rebuilt: [str] = [];
    var prev: u32 = 0;
    for (block in bs) {
        var s = block.0;
        var e = block.1;
        for (k in prev..s) {
            rebuilt = @append(rebuilt, lines[k]);
        }
        for (k in s..e) {
            rebuilt = @append(rebuilt, lines[k]);
        }
        prev = e;
    }
    for (k in prev..@len(lines)) {
        rebuilt = @append(rebuilt, lines[k]);
    }
    
    if (!@equal(rebuilt, lines)) {
        return Option<str>.Some("REFUSED: round-trip differs");
    }
    
    // Find duplicate blocks (same name and body)
    var seen: [(str, str)] = []; // (name, body)
    var drop: [BlockInfo] = [];
    for (block in bs) {
        var s = block.0;
        var e = block.1;
        var name = block.2;
        
        // Build body: lines s+1 to e-1, rstripped, joined, stripped
        var body_lines: [str] = [];
        for (k in s + 1..e) {
            body_lines = @append(body_lines, @rtrim(lines[k]));
        }
        var body = @trim(@join(body_lines, "\n"));
        
        var is_duplicate = false;
        for (seen_entry in seen) {
            if (seen_entry.0 == name && seen_entry.1 == body) {
                is_duplicate = true;
                break;
            }
        }
        if (is_duplicate) {
            drop = @append(drop, block);
        } else {
            seen = @append(seen, (name, body));
        }
    }
    
    if (@len(drop) == 0) {
        return Option<str>.None;
    }
    
    // Build set of dropped line indices
    var dropped: [bool] = [];
    for (_ in 0..@len(lines)) {
        dropped = @append(dropped, false);
    }
    for (block in drop) {
        for (k in block.0..block.1) {
            if (k < @len(dropped)) dropped[k] = true;
        }
    }
    
    // Build output without dropped lines
    var out: [str] = [];
    for (k in 0..@len(lines)) {
        if (!dropped[k]) {
            out = @append(out, lines[k]);
        }
    }
    
    // COUNTING CONTROL: only test lines may disappear
    var before = counts(lines);
    var after = counts(out);
    if (!counts_equal(before, after)) {
        return Option<str>.Some("REFUSED: a non-test declaration moved");
    }
    
    return Option<str>.Some(@join(out, "\n"));
}

// Test for blocks function
test "blocks_finds_brace_form" {
    var lines = [
        "test \"foo\" {",
        "  assert(true);",
        "}",
        "test bar {",
        "  assert(false);",
        "}",
    ];
    var result = blocks(lines);
    assert(@len(result) == 2);
    assert(result[0].0 == 0);
    assert(result[0].1 == 3);
    assert(result[0].2 == "foo");
    assert(result[1].0 == 3);
    assert(result[1].1 == 5);
    assert(result[1].2 == "bar");
}

test "blocks_finds_gherkin_form" {
    var lines = [
        "test foo",
        "  assert(true);",
        "  assert(false);",
        "fn other() {}",
    ];
    var result = blocks(lines);
    assert(@len(result) == 1);
    assert(result[0].0 == 0);
    assert(result[0].1 == 3);  // stops before fn
    assert(result[0].2 == "foo");
}

test "blocks_skips_non_test_lines" {
    var lines = [
        "fn setup() {}",
        "test \"first\" {",
        "  pass;",
        "}",
        "const x = 1;",
        "test second",
        "  pass;",
        "fn teardown() {}",
    ];
    var result = blocks(lines);
    assert(@len(result) == 2);
    assert(result[0].0 == 1);
    assert(result[0].1 == 4);
    assert(result[0].2 == "first");
    assert(result[1].0 == 5);
    assert(result[1].1 == 7);
    assert(result[1].2 == "second");
}

test "blocks_handles_nested_braces" {
    var lines = [
        "test \"nested\" {",
        "  if (true) {",
        "    pass;",
        "  }",
        "}",
    ];
    var result = blocks(lines);
    assert(@len(result) == 1);
    assert(result[0].0 == 0);
    assert(result[0].1 == 5);  // includes all nested braces
    assert(result[0].2 == "nested");
}

// Test for process function
test "process_returns_none_for_no_tests" {
    var content = "fn main() {}\nconst x = 1;\n";
    var result = process(content);
    assert(!result.has_value);
}

test "process_removes_duplicate_brace_tests" {
    var content = "test \"foo\" {\n  assert(true);\n}\n\ntest \"foo\" {\n  assert(true);\n}\n";
    var result = process(content);
    assert(result.has_value);
    // Should keep only one copy
    var out = result.value;
    var bs = blocks(@split(out, "\n"));
    assert(@len(bs) == 1);
}

test "process_removes_duplicate_gherkin_tests" {
    var content = "test foo\n  pass;\n  pass;\nfn other() {}\n\ntest foo\n  pass;\n  pass;\nfn other2() {}\n";
    var result = process(content);
    assert(result.has_value);
    var out = result.value;
    var bs = blocks(@split(out, "\n"));
    assert(@len(bs) == 1);
}

test "process_keeps_different_bodies_same_name" {
    var content = "test \"foo\" {\n  assert(true);\n}\n\ntest \"foo\" {\n  assert(false);\n}\n";
    var result = process(content);
    // Different bodies - should NOT remove either
    assert(!result.has_value || result.value == "REFUSED: a non-test declaration moved" || result.value == "REFUSED: round-trip differs");
}

test "process_refuses_round_trip_failure" {
    // This is hard to trigger without complex edge cases, but we test the path exists
    var content = "test \"foo\" {\n  pass;\n}\n";
    var result = process(content);
    // Single block - no duplicates, returns None
    assert(!result.has_value);
}