module check_devhome_paths;

const std = @import("std");

; Scan directory for .t27 files and count total non-empty, non-comment lines.
; Returns total line count.
pub fn scan(root: []const u8) i32 {
    const allocator = std.heap.c_allocator;
    const counts = try scan_counts(root, allocator);
    var total: i32 = 0;
    for (counts) |kv| {
        total += @intCast(kv.value);
        allocator.free(kv.key);
    }
    allocator.free(counts);
    return total;
}

; Scan directory for .t27 files and return counts per file.
; Returns ArrayList of { key: []const u8, value: i32 } entries.
fn scan_counts(root: []const u8, allocator: std.mem.Allocator) ![]struct { key: []const u8, value: i32 } {
    var results = std.ArrayList(struct { key: []const u8, value: i32 }).init(allocator);
    defer results.deinit();
    
    const walk_result = std.fs.walkDir(allocator, root, .{
        .follow_symlinks = false,
        .max_depth = 100,
    });
    defer walk_result.deinit();
    
    var iter = walk_result.iterator();
    while (iter.next()) |entry| {
        if (entry.kind == .file) {
            const file_path = entry.path;
            if (std.mem.endsWith(u8, file_path, ".t27")) {
                const count = try count_t27_lines(file_path, allocator);
                if (count > 0) {
                    const path_copy = try allocator.dupe(u8, file_path);
                    try results.append(.{ .key = path_copy, .value = count });
                }
            }
        }
    }
    
    return results.toOwnedSlice();
}

; Count non-empty, non-comment lines in a .t27 file.
fn count_t27_lines(file_path: []const u8, allocator: std.mem.Allocator) !i32 {
    const content = try std.fs.readFileAlloc(allocator, file_path);
    defer allocator.free(content);
    
    var count: i32 = 0;
    var offset: usize = 0;
    while (true) {
        const line_end = std.mem.indexOfScalar(u8, content[offset..], '\n');
        const line: []const u8 = if (line_end) |i| content[offset..offset + i] else content[offset..];
        const trimmed = std.mem.trim(u8, line, " \t\r");
        if (trimmed.len > 0 and !std.mem.startsWith(u8, trimmed, "//") and !std.mem.startsWith(u8, trimmed, ";")) {
            count += 1;
        }
        if (line_end) |i| {
            offset += i + 1;
            if (offset >= content.len) break;
        } else {
            break;
        }
    }
    return count;
}

; Load baseline from .devhome/paths_baseline.json.
; Returns HashMap of path -> line count, or error if not found.
fn load_baseline(allocator: std.mem.Allocator) !std.StringHashMap(i32) {
    const baseline_path = ".devhome/paths_baseline.json";
    if (!std.fs.pathExists(baseline_path)) {
        return error.FileNotFound;
    }
    const content = try std.fs.readFileAlloc(allocator, baseline_path);
    defer allocator.free(content);
    
    var parser = std.json.Parser(i32).init(allocator);
    defer parser.deinit();
    const parsed = try parser.parse(content);
    const map = parsed.toOwnedMap();
    return map;
}

; Write baseline to .devhome/paths_baseline.json.
fn write_baseline(counts: []struct { key: []const u8, value: i32 }, allocator: std.mem.Allocator) !void {
    var stringify = std.json.Stringify(.{}).init(allocator);
    defer stringify.deinit();
    
    try stringify.beginObject();
    for (counts) |kv| {
        try stringify.objectField(kv.key);
        try stringify.value(kv.value);
    }
    try stringify.endObject();
    
    const json = stringify.getAllocatedBuf();
    defer allocator.free(json);
    
    const baseline_path = ".devhome/paths_baseline.json";
    try std.fs.writeFile(baseline_path, json, .{});
}

; Self-check: run internal tests.
pub fn self_check() i32 {
    const allocator = std.heap.c_allocator;
    
    ; Test 1: scan on non-existent directory returns 0
    const test1 = scan("non_existent_dir_xyz");
    if (test1 != 0) {
        print("FAIL: scan on non-existent dir should return 0, got {}\n", .{test1});
        return 1;
    }
    
    ; Test 2: scan_counts on current directory returns non-negative
    const counts = scan_counts(".", allocator) catch |err| {
        print("FAIL: scan_counts error: {}\n", .{err});
        return 1;
    };
    defer {
        for (counts) |kv| {
            allocator.free(kv.key);
        }
        allocator.free(counts);
    }
    
    ; Test 3: load_baseline on missing file returns error
    const baseline_test = load_baseline(allocator);
    if (baseline_test != error.FileNotFound) {
        print("FAIL: load_baseline on missing file should return FileNotFound\n");
        return 1;
    }
    
    print("All self-checks passed\n");
    return 0;
}

; Main entry point.
pub fn main() i32 {
    const allocator = std.heap.c_allocator;
    
    ; Check if --write-baseline flag is present
    var write_baseline_flag = false;
    var i: usize = 1;
    while (i < std.process.args.len) {
        if (std.mem.eql(u8, std.process.args[i], "--write-baseline")) {
            write_baseline_flag = true;
            break;
        }
        i += 1;
    }
    
    const root = "specs/port";
    const current_counts = scan_counts(root, allocator) catch |err| {
        print("Error scanning {}: {}\n", .{root, err});
        return 1;
    };
    defer {
        for (current_counts) |kv| {
            allocator.free(kv.key);
        }
        allocator.free(current_counts);
    }
    
    if (write_baseline_flag) {
        write_baseline(current_counts, allocator) catch |err| {
            print("Error writing baseline: {}\n", .{err});
            return 1;
        };
        print("Baseline written\n");
        return 0;
    }
    
    const baseline = load_baseline(allocator) catch |err| {
        print("No baseline found (run with --write-baseline to create): {}\n", .{err});
        return 1;
    };
    defer baseline.deinit();
    
    var changed = false;
    for (current_counts) |kv| {
        const baseline_count = baseline.get(kv.key);
        if (baseline_count) |c| {
            if (c != kv.value) {
                print("CHANGED: {} (was {}, now {})\n", .{kv.key, c, kv.value});
                changed = true;
            }
        } else {
            print("NEW: {} ({} lines)\n", .{kv.key, kv.value});
            changed = true;
        }
    }
    
    var iter = baseline.iterator();
    while (iter.next()) |kv| {
        var found = false;
        for (current_counts) |ckv| {
            if (std.mem.eql(u8, ckv.key, kv.key_ptr.*)) {
                found = true;
                break;
            }
        }
        if (!found) {
            print("REMOVED: {} (was {} lines)\n", .{kv.key_ptr.*, kv.value_ptr.*});
            changed = true;
        }
    }
    
    if (changed) {
        print("Devhome paths have changed. Run with --write-baseline to update.\n");
        return 1;
    }
    
    print("No changes detected.\n");
    return 0;
}

test "scan on empty dir" {
    const result = scan("non_existent_dir_xyz");
    assert(result == 0);
}

test "scan_counts returns slice" {
    const allocator = std.heap.c_allocator;
    const result = scan_counts(".", allocator) catch unreachable;
    defer {
        for (result) |kv| allocator.free(kv.key);
        allocator.free(result);
    }
    assert(result.len >= 0);
}

test "count_t27_lines on simple file" {
    const allocator = std.heap.c_allocator;
    const test_content = "line 1\n// comment\n;\nline 2\n\nline 3\n";
    const test_file = "test_temp.t27";
    try std.fs.writeFile(test_file, test_content, .{});
    defer std.fs.removeFile(test_file) catch {};
    
    const count = try count_t27_lines(test_file, allocator);
    assert(count == 3);
}

test "load_baseline missing file" {
    const allocator = std.heap.c_allocator;
    const result = load_baseline(allocator);
    assert(result == error.FileNotFound);
}

test "write_baseline and load roundtrip" {
    const allocator = std.heap.c_allocator;
    const test_counts = [_]struct { key: []const u8, value: i32 }{
        .{ .key = "file1.t27", .value = 10 },
        .{ .key = "file2.t27", .value = 20 },
    };
    
    try write_baseline(&test_counts, allocator);
    defer std.fs.removeFile(".devhome/paths_baseline.json") catch {};
    
    const loaded = try load_baseline(allocator);
    defer loaded.deinit();
    
    assert(loaded.get("file1.t27").? == 10);
    assert(loaded.get("file2.t27").? == 20);
}

test "self_check passes" {
    const result = self_check();
    assert(result == 0);
}