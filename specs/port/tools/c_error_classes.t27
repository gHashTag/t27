// Test blocks for each function
test "test_t27c" {
    let result = t27c();
    assert(result == "t27c_binary", "t27c should return a binary path");
}

test "test_cc_uncap_flag" {
    let result = cc_uncap_flag();
    assert(result == "-ferror-limit=0", "cc_uncap_flag should return a compiler flag");
}

test "test_diagnose" {
    let binary = "t27c";
    let out_dir = "/tmp";
    let result = diagnose(binary, out_dir);
    assert(true, "diagnose should return non-empty string");
}

test "test_undeclared_split" {
    let text = "call to undeclared function 'foo'";
    undeclared_split(text);
    assert(true, "undeclared_split should complete without error");
}

test "test_self_check" {
    let binary = "t27c";
    let result = self_check(binary);
    assert(result == 0, "self_check should return 0 on success");
}

test "test_main" {
    let result = main();
    assert(result == 0, "main should return 0");
}