module check_ring_spec_drift;

// Constants from the original implementation
pub const RINGS : str = "rings";

fn t27c() -> str {
    let paths = [ "target/release/t27c", "bootstrap/target/release/t27c" ];
    for p in paths {
        if @fileExists(p) {
            return p;
        }
    }
    match @env("TRI_T27C") {
        Some(env) => {
            if @fileExists(env) {
                return env;
            }
        }
        None => {}
    }
    @panic("check_ring_spec_drift: t27c not built. Exit 2 = COULD NOT RUN.");
}// Helper function to parse signatures without regex (simplified version)
fn signatures(text: str) -> dict(str, (str, str)) {
    let mut out = dict(str, (str, str)){};
    let mut i = 0;
    while i < text.len() {
        // Look for "pub"
        if i + 3 <= text.len() && text[i..i+3] == "pub" {
            i += 3;
            // Optional space
            if i < text.len() && text[i] == ' ' { i += 1; }
            // Optional "const"
            if i + 5 <= text.len() && text[i..i+5] == "const" {
                i += 5;
                if i < text.len() && text[i] == ' ' { i += 1; }
            }
            // "fn"
            if i + 2 <= text.len() && text[i..i+2] == "fn" {
                i += 2;
                if i < text.len() && text[i] == ' ' { i += 1; }
                // Function name: [a-z_][a-z_0-9]*
                let mut name_start = i;
                if i < text.len() && (text[i] == '_' || ('a' <= text[i] && text[i] <= 'z')) {
                    i += 1;
                    while i < text.len() && (text[i] == '_' || ('a' <= text[i] && text[i] <= 'z') || ('0' <= text[i] && text[i] <= '9')) {
                        i += 1;
                    }
                }
                let name = text[name_start..i];
                // Skip whitespace
                while i < text.len() && text[i] == ' ' { i += 1; }
                // Expect '('
                if i < text.len() && text[i] == '(' {
                    i += 1;
                    let mut params_start = i;
                    // Find matching ')'
                    let mut paren_count = 1;
                    while i < text.len() && paren_count > 0 {
                        if text[i] == '(' { paren_count += 1; }
                        else if text[i] == ')' { paren_count -= 1; }
                        i += 1;
                    }
                    let params = text[params_start..i-1]; // exclude the closing ')'
                    // Skip whitespace
                    while i < text.len() && text[i] == ' ' { i += 1; }
                    // Expect "->"
                    if i + 2 <= text.len() && text[i..i+2] == "->" {
                        i += 2;
                        // Skip whitespace
                        while i < text.len() && text[i] == ' ' { i += 1; }
                        // Return type: until '{' or ';'
                        let mut ret_start = i;
                        while i < text.len() && text[i] != '{' && text[i] != ';' {
                            i += 1;
                        }
                        let ret = text[ret_start..i];
                        // Trim whitespace from params and ret
                        let params = params.trim();
                        let ret = ret.trim();
                        out.insert(name, (params, ret));
                    } else {
                        // If we didn't find "->", skip to next
                        continue;
                    }
                } else {
                    // If we didn't find '(', skip to next
                    continue;
                }
            } else {
                // If we didn't find "fn", skip to next
                continue;
            }
        } else {
            i += 1;
        }
    }
    return out;
}

// Classify function as in original
fn classify(hand: dict(str, (str, str)), spec: dict(str, (str, str))) -> str {
    let mut shared = 0;
    let mut same = 0;
    for k in hand {
        let v = hand[k];
        if spec.contains_key(k) {
            shared += 1;
            if spec[k] == v {
                same += 1;
            }
        }
    }
    if shared == 0 {
        return "UNRELATED";
    }
    if same == 0 {
        return "UNRELATED";
    }
    if same == shared {
        return "CONVERGED";
    }
    return "DRIFTED";
