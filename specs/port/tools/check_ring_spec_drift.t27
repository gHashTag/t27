test "signatures_function" {
    let text = "pub fn foo(x: u32) -> u32 { }";
    let sigs = signatures(text);
    // Expect one entry: "foo" -> ("x: u32", "u32")
    assert!(sigs.contains_key("foo"), "signature for foo not found");
    let (params, ret) = sigs["foo"];
    assert!(params == "x: u32", "expected params 'x: u32', got '{params}'");
    assert!(ret == "u32", "expected return 'u32', got '{ret}'");
}

test "classify_function_converged" {
    let mut hand = dict(str, (str, str)){};
    let mut spec = dict(str, (str, str)){};
    hand.insert("f", ("x: u32", "u32"));
    spec.insert("f", ("x: u32", "u32"));
    let result = classify(hand, spec);
    assert!(result == "CONVERGED", "expected CONVERGED, got '{result}'");
}

test "classify_function_drifted" {
    let mut hand = dict(str, (str, str)){};
    let mut spec = dict(str, (str, str)){};
    hand.insert("f", ("x: u32", "u32"));
    hand.insert("g", ("y: i32", "bool"));
    spec.insert("f", ("x: u32", "u32")); // same
    spec.insert("g", ("y: i64", "bool")); // different
    let result = classify(hand, spec);
    assert!(result == "DRIFTED", "expected DRIFTED, got '{result}'");
}

test "classify_function_unrelated" {
    let mut hand = dict(str, (str, str)){};
    let mut spec = dict(str, (str, str)){};
    hand.insert("f", ("x: u32", "u32"));
    spec.insert("g", ("y: i32", "bool"));
    let result = classify(hand, spec);
    assert!(result == "UNRELATED", "expected UNRELATED, got '{result}'");
}

