// Constants from the original implementation
pub const PROSE_KEYS : [5]str = ["id", "description", "note", "name", "comment"];
pub const MARKERS : [6]str = ["UNREADABLE ", "DEPARTED   ", "EMPTIED    ", "LOST DATA  ", "NEW        ", "BETTER     "];
pub const DEBT_EPILOGUE : str = "the measured set getting smaller";
pub const GAIN_EPILOGUE : str = "Files gained data. Record it";
pub const RECORD_REFUSED : str = "refusing to record a baseline over unreadable files:";
pub const RECORD_DONE : str = "baseline updated:";

// Root directory: current directory (assuming run from repository root)
pub const ROOT : str = ".";
// Vectors directory
pub const VECTORS : str = "conformance";
// Baseline file
pub const BASELINE : str = "tools/vector_data_baseline.txt";

