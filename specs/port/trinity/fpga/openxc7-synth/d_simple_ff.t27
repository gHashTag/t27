// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d_simple_ff.t27
// Simple flip-flop test module for Trinity S³AI — synthesizable Verilog module
// Ports the original Verilog: single FF that toggles every clock cycle
// Active-low LED output with clock buffer
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===
    
    // Module ports match the original Verilog exactly:
    // input  wire clk,
    // output wire led,
    pub struct ModulePorts {
        clk : bool,
        led : bool,
    }
    
    // === Internal state ===
    
    pub struct FlipFlopState {
        q : bool,        // Current flip-flop state (reg q = 0;)
        clk_bufged : bool,  // Buffered clock signal
    }
    
    // === Clock buffer (BUFG primitive) ===
    
    fn buffer_clock(clk: bool) -> bool {
        // Simulates BUFG behavior: passes clock through
        // Original: BUFG clk_buf (.I(clk), .O(clk_bufged));
        return clk;
    }
    
    // === Flip-flop state update on positive edge ===
    
    fn update_flip_flop(current: FlipFlopState, clk_posedge: bool) -> FlipFlopState {
        var next : FlipFlopState = FlipFlopState{
            .q = current.q,
            .clk_bufged = current.clk_bufged,
        };
        
        // On positive edge of buffered clock: toggle the flip-flop
        // Original: always @(posedge clk_bufged) begin q <= ~q; end
        if (clk_posedge) {
            next.q = ~current.q;
        }
        
        return next;
    }
    
    // === LED output (active-low) ===
    
    fn compute_led_output(ff_state: FlipFlopState) -> bool {
        // Active-low LED: ~q means 0 = ON, 1 = OFF
        // Original: assign led = ~q;  // Active-low
        return ~ff_state.q;
    }
    
    // === Main module computation ===
    
    fn trinity_top_module(ports: ModulePorts) -> ModulePorts {
        var state : FlipFlopState = FlipFlopState{
            .q = false,    // Initialize to 0 (reg q = 0;)
            .clk_bufged = false,  // Previous clock state (initially low)
        };
        
        // Detect rising edge BEFORE updating buffered clock
        var clk_posedge : bool = ports.clk and ~state.clk_bufged;
        
        // Update flip-flop state on rising edge
        state = update_flip_flop(state, clk_posedge);
        
        // Update buffered clock after state update
        state.clk_bufged = buffer_clock(ports.clk);
        
        // Return updated ports
        return ModulePorts{
            .clk = ports.clk,
            .led = compute_led_output(state),
        };
    }
    
    // === Test helper functions ===
    
    fn simulate_two_cycles(clk1: bool, clk2: bool) -> (FlipFlopState, FlipFlopState) {
        // Simulate two consecutive clock cycles
        var state1 : FlipFlopState = FlipFlopState{
            .q = false,    // Initial state
            .clk_bufged = buffer_clock(clk1),
        };
        
        // First cycle
        var edge1 : bool = clk1 and ~false;  // Rising edge detection (previous was low)
        if (edge1) {
            state1.q = ~state1.q;
        }
        state1.clk_bufged = buffer_clock(clk1);
        
        // Second cycle
        var state2 : FlipFlopState = FlipFlopState{
            .q = state1.q,
            .clk_bufged = buffer_clock(clk2),
        };
        var edge2 : bool = clk2 and ~clk1;  // Rising edge detection
        if (edge2) {
            state2.q = ~state2.q;
        }
        state2.clk_bufged = buffer_clock(clk2);
        
        return (state1, state2);
    }
    
    fn simulate_four_cycles(c1: bool, c2: bool, c3: bool, c4: bool) -> (FlipFlopState, FlipFlopState, FlipFlopState, FlipFlopState) {
        // Simulate four consecutive clock cycles
        var state1 : FlipFlopState = FlipFlopState{
            .q = false,    // Initial state
            .clk_bufged = buffer_clock(c1),
        };
        
        // Cycle 1
        var edge1 : bool = c1 and ~false;
        if (edge1) {
            state1.q = ~state1.q;
        }
        state1.clk_bufged = buffer_clock(c1);
        
        // Cycle 2
        var state2 : FlipFlopState = FlipFlopState{
            .q = state1.q,
            .clk_bufged = buffer_clock(c2),
        };
        var edge2 : bool = c2 and ~c1;
        if (edge2) {
            state2.q = ~state2.q;
        }
        state2.clk_bufged = buffer_clock(c2);
        
        // Cycle 3
        var state3 : FlipFlopState = FlipFlopState{
            .q = state2.q,
            .clk_bufged = buffer_clock(c3),
        };
        var edge3 : bool = c3 and ~c2;
        if (edge3) {
            state3.q = ~state3.q;
        }
        state3.clk_bufged = buffer_clock(c3);
        
        // Cycle 4
        var state4 : FlipFlopState = FlipFlopState{
            .q = state3.q,
            .clk_bufged = buffer_clock(c4),
        };
        var edge4 : bool = c4 and ~c3;
        if (edge4) {
            state4.q = ~state4.q;
        }
        state4.clk_bufged = buffer_clock(c4);
        
        return (state1, state2, state3, state4);
    }
    
    // === Validation functions ===
    
    fn validate_ff_state(state: FlipFlopState) -> u32 {
        var errors : u32 = 0;
        // Flip-flop state should always be boolean
        if (state.q != true and state.q != false) {
            errors = errors + 1;
        }
        if (state.clk_bufged != true and state.clk_bufged != false) {
            errors = errors + 1;
        }
        return errors;
    }
    
    fn validate_module_ports(ports: ModulePorts) -> u32 {
        var errors : u32 = 0;
        if (ports.clk != true and ports.clk != false) {
            errors = errors + 1;
        }
        if (ports.led != true and ports.led != false) {
            errors = errors + 1;
        }
        return errors;
    }
    
    // === Tests ===
    
    test initial_ff_state
        given state = FlipFlopState{.q = false, .clk_bufged = false}
        then state.q == false  // Initial value is 0
        and state.clk_bufged == false
        and validate_ff_state(state) == 0
    
    test initial_module_ports
        given ports = ModulePorts{.clk = false, .led = true}  // q=0, led=~0=1
        then ports.clk == false
        and ports.led == true
        and validate_module_ports(ports) == 0
    
    test clock_buffer_passthrough
        then buffer_clock(true) == true
        and buffer_clock(false) == false
    
    test ff_toggle_simple
        // Test direct flip-flop toggle behavior
        var state1 = FlipFlopState{.q = false, .clk_bufged = true}
        var state2 = FlipFlopState{.q = true, .clk_bufged = true}
        then compute_led_output(state1) == true   // q=0, led=1
        and compute_led_output(state2) == false  // q=1, led=0
    
    test rising_edge_detection
        // Test rising edge detection logic
        then (true and ~false) == true   // rising edge detected
        and (false and ~true) == false  // no rising edge
        and (true and ~true) == false    // no rising edge
        and (false and ~false) == false  // no rising edge
    
    test single_cycle_toggle
        // Test single cycle with rising edge
        var (state1, _) = simulate_two_cycles(true, false)
        then state1.q == true   // q toggled from 0 to 1
        and compute_led_output(state1) == false  // led=~1=0
        
        // Test single cycle without edge
        var (_, state2) = simulate_two_cycles(false, true)
        then state2.q == false   // q unchanged (no rising edge)
        and compute_led_output(state2) == true  // led=~0=1
    
    test_two_cycles_toggle
        // Test: [false, true] - should see rising edge at position 1
        var (state1, state2) = simulate_two_cycles(false, true)
        // Initial: q=0, led=1
        // After rising edge: q=1, led=0
        then state1.q == false  // Initial state
        and state1.clk_bufged == true
        and state2.q == true   // After toggle
        and state2.clk_bufged == true
    
    test_four_cycles_sequence
        // Test full sequence: [false, true, false, true]
        var (s1, s2, s3, s4) = simulate_four_cycles(false, true, false, true)
        // Initial: q=0, led=1
        // After first rising edge: q=1, led=0
        // After second rising edge: q=0, led=1
        then s1.q == false  // Initial
        and s2.q == true   // After first edge
        and s3.q == true   // No edge, stays
        and s4.q == false  // After second edge
    
    test module_initial_output
        given ports = trinity_top_module(ModulePorts{.clk = false, .led = false})
        then ports.clk == false
        and ports.led == true  // Initial q=0, led=~0=1 (ON)
    
    test debug_edge_detection
        var state = FlipFlopState{.q = false, .clk_bufged = false}
        var clk_posedge = true and ~state.clk_bufged
        then clk_posedge == true  // Should detect rising edge
        
        var updated_state = update_flip_flop(state, clk_posedge)
        then updated_state.q == true  // Should toggle
        and compute_led_output(updated_state) == false  // Should be OFF
    
    test module_with_rising_edge_debug
        // Test module with rising edge input - show actual values
        var ports = trinity_top_module(ModulePorts{.clk = true, .led = true})
        then ports.clk == true
        // Actual LED value: {ports.led} (should be false if q toggled to 1)
        // Let's see what it actually is...
        and ports.led == ports.led  // Just pass and see the real value
    
    test module_with_rising_edge
        // Test module with rising edge input
        var ports = trinity_top_module(ModulePorts{.clk = true, .led = true})
        then ports.clk == true
        and ports.led == false  // q toggled to 1, led=~1=0 (OFF)
    
    test module_no_edge
        // Test module without rising edge
        var ports = trinity_top_module(ModulePorts{.clk = false, .led = false})
        then ports.clk == false
        and ports.led == true  // No toggle, q stays 0, led=1
    
    test validation_functions
        given valid_state = FlipFlopState{.q = true, .clk_bufged = false}
        and valid_ports = ModulePorts{.clk = true, .led = false}
        then validate_ff_state(valid_state) == 0
        and validate_module_ports(valid_ports) == 0
    
    // === Invariants ===
    
    invariant ff_state_boolean
        given state = FlipFlopState{.q = true, .clk_bufged = false}
        assert state.q == true or state.q == false
        and state.clk_bufged == true or state.clk_bufged == false
    
    invariant led_complementarity
        given state = FlipFlopState{.q = true, .clk_bufged = false}
        assert compute_led_output(state) != state.q
    
    invariant_clock_buffer_consistency
        given clk = true
        then buffer_clock(clk) == clk
    
    invariant_module_ports_valid
        given ports = ModulePorts{.clk = true, .led = false}
        assert validate_module_ports(ports) == 0
    
    // === Benchmarks ===
    
    bench ff_state_update_latency
        measure: nanoseconds to update_flip_flop(FlipFlopState{.q = false, .clk_bufged = false}, true)
        target: < 10ns
    
    bench led_output_latency
        measure: nanoseconds to compute_led_output(FlipFlopState{.q = false, .clk_bufged = false})
        target: < 5ns
    
    bench trinity_top_compute_latency
        measure: nanoseconds to trinity_top_module(ModulePorts{.clk = true, .led = false})
        target: < 20ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY