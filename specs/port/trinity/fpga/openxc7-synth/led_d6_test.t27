module trinity_top {
    pub fn on_comb(clk: bool) -> bool {
        true
    }

    test on_comb_returns_true {
        assert(on_comb(false) == true)
        assert(on_comb(true) == true)
    }

    test on_comb_returns_true_with_input {
        assert(on_comb(true) == true)
    }

    invariant on_comb_always_true {
        given clk: bool
        then on_comb(clk) == true
    }

    invariant on_comb_always_true_named {
        given clk: bool
        let result = on_comb(clk)
        assert result == true
    }
}