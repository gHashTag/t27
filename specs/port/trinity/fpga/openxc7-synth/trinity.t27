// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/trinity.t27
// Trinity FPGA LED Blinker Module
// Port of gHashTag/trinity fpga/openxc7-synth/trinity.v
// QMTECH XC7A100T Core Board LED Blink: 50MHz clock, LED at J19 (active-low)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Clock and LED constants ===

    pub const CLOCK_FREQUENCY_MHZ : u32 = 50;
    pub const COUNTER_WIDTH : u32 = 26;
    pub const LED_BIT_POSITION : u32 = 24;
    pub const COUNTER_MAX : u32 = 1 << COUNTER_WIDTH; // 2^26 = 67,108,864

    // === Module state ===

    pub struct ModuleState {
        counter : u32,
        led_state : bool,
    }

    // === Constructor ===

    fn module_state() -> ModuleState {
        return ModuleState{
            .counter = 0,
            .led_state = false,
        };
    }

    // === Core logic functions ===

    fn increment_counter(state: ModuleState) -> ModuleState {
        var new_counter : u32 = state.counter + 1;
        if (new_counter >= COUNTER_MAX) {
            new_counter = 0;
        }
        return ModuleState{
            .counter = new_counter,
            .led_state = state.led_state,
        };
    }

    fn compute_led(state: ModuleState) -> bool {
        // LED heartbeat: blink ~1.5 Hz (50MHz / 2^25 ~ 1.49 Hz)
        // Active-low LED: invert so LED visibly blinks
        var led_bit : bool = (state.counter >> LED_BIT_POSITION) & 1;
        return !led_bit;
    }

    fn update_led(state: ModuleState) -> ModuleState {
        return ModuleState{
            .counter = state.counter,
            .led_state = compute_led(state),
        };
    }

    fn clock_tick(state: ModuleState) -> ModuleState {
        var incremented : ModuleState = increment_counter(state);
        return update_led(incremented);
    }

    // === Query functions ===

    fn get_counter_value(state: ModuleState) -> u32 {
        return state.counter;
    }

    fn get_led_state(state: ModuleState) -> bool {
        return state.led_state;
    }

    fn compute_blink_frequency() -> f64 {
        return CLOCK_FREQUENCY_MHZ as f64 / (1 << (LED_BIT_POSITION - 1));
    }

    fn is_counter_at_value(state: ModuleState, target: u32) -> bool {
        return state.counter == target;
    }

    fn get_counter_period() -> u32 {
        return COUNTER_MAX;
    }

    fn get_counter_half_period() -> u32 {
        return COUNTER_MAX / 2;
    }

    // === Tests ===

    test module_state_initialization
        given s = module_state()
        then get_counter_value(s) == 0
        and get_led_state(s) == false

    test counter_increment_from_zero
        given s = module_state()
        then s1 = clock_tick(s)
        and get_counter_value(s1) == 1
        and get_led_state(s1) == true  // bit 24 is 0, inverted to true

    test counter_increment_max_wraparound
        given s = ModuleState{.counter = COUNTER_MAX - 1, .led_state = false}
        then s1 = clock_tick(s)
        and get_counter_value(s1) == 0
        and get_led_state(s1) == true

    test_led_bit_position_24_zero
        given s = ModuleState{.counter = 0, .led_state = false}
        then get_led_state(s) == true  // bit 24 is 0, inverted to true

    test_led_bit_position_24_one
        given s = ModuleState{.counter = 1 << LED_BIT_POSITION, .led_state = false}
        then get_led_state(s) == false  // bit 24 is 1, inverted to false

    test_led_toggle_behavior
        given s0 = ModuleState{.counter = 0, .led_state = false}
        then s1 = clock_tick(s0)
        and s2 = clock_tick(s1)
        and s3 = clock_tick(s2)
        and s4 = clock_tick(s3)
        and s5 = clock_tick(s4)
        and s6 = clock_tick(s5)
        and s7 = clock_tick(s6)
        and s8 = clock_tick(s7)
        and s9 = clock_tick(s8)
        and s10 = clock_tick(s9)
        and s11 = clock_tick(s10)
        and s12 = clock_tick(s11)
        and s13 = clock_tick(s12)
        and s14 = clock_tick(s13)
        and s15 = clock_tick(s14)
        and s16 = clock_tick(s15)
        and s17 = clock_tick(s16)
        and s18 = clock_tick(s17)
        and s19 = clock_tick(s18)
        and s20 = clock_tick(s19)
        and s21 = clock_tick(s20)
        and s22 = clock_tick(s21)
        and s23 = clock_tick(s22)
        and s24 = clock_tick(s23)
        and get_led_state(s0) == true   // counter[24] = 0 -> led = true
        and get_led_state(s1) == true   // counter[24] = 0 -> led = true
        and get_led_state(s2) == true   // counter[24] = 0 -> led = true
        and get_led_state(s3) == true   // counter[24] = 0 -> led = true
        and get_led_state(s4) == true   // counter[24] = 0 -> led = true
        and get_led_value = get_led_state(s24) == false  // counter[24] = 1 -> led = false

    test_blink_frequency_calculation
        then compute_blink_frequency() == 1.4921875  // 50 / 2^24 = 50 / 16,777,216

    test_counter_period
        then get_counter_period() == COUNTER_MAX
        and get_counter_half_period() == COUNTER_MAX / 2

    test_counter_at_specific_values
        given s0 = module_state()
        then s1 = clock_tick(s0)
        and s2 = clock_tick(s1)
        and s3 = clock_tick(s2)
        and is_counter_at_value(s0, 0) == true
        and is_counter_at_value(s1, 1) == true
        and is_counter_at_value(s2, 2) == true
        and is_counter_at_value(s3, 3) == true

    // === Invariants ===

    invariant counter_within_bounds
        given s = module_state()
        assert get_counter_value(s) < COUNTER_MAX

    invariant_led_state_boolean
        given s = module_state()
        assert get_led_state(s) == true or get_led_state(s) == false

    invariant_counter_increment_preserves_led
        given s = module_state()
        then s1 = clock_tick(s)
        and get_counter_value(s1) == get_counter_value(s) + 1 or get_counter_value(s1) == 0

    // === Benchmarks ===

    bench counter_increment_latency
        measure: nanoseconds to clock_tick(module_state())
        target: < 10ns

    bench led_computation_latency
        measure: nanoseconds to compute_led(module_state())
        target: < 5ns

}

// phi^2 + 1/phi^2 = 3 | TRINITY