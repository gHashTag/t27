// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/trinity.t27
// Port of gHashTag/trinity fpga/openxc7-synth/trinity.v (Trinity S3AI, FPGA).
// QMTECH XC7A100T Core Board LED Blink: clock 50 MHz (M22), LED J19 (active-low).
// phi^2 + 1/phi^2 = 3 = TRINITY

module trinity_top {

    // ---- Original ports -------------------------------------------------
    // `input wire clk` -- 50 MHz clock (M22). The Verilog backend clocks the
    // module implicitly; on_comb below exposes the LED decision as a data port.
    // `output wire led` -- the backend names the return port `result`
    // (`assign result = on_comb(...)`), active-low.

    // ---- Constants --------------------------------------------------------
    // `reg [25:0] counter = 26'd0;` -- 26-bit, reset-low.
    pub const COUNTER_BITS: u32 = 26;
    pub const COUNTER_MOD: u32 = 67108864; // 2^26: the counter wraps here.
    pub const CLOCK_HZ: u64 = 50000000;    // 50 MHz clock (M22).
    // `assign led = ~counter[24];` -- bit 24 drives the LED: it is set on
    // exactly the bit-24 band [2^24, 2^25), i.e. LED_BIT_BAND_LO..LED_BIT_BAND_HI-1.
    pub const LED_BIT: u32 = 24;
    pub const LED_BIT_BAND_LO: u32 = 16777216; // 2^24: first counter value with bit 24 set.
    pub const LED_BIT_BAND_HI: u32 = 33554432; // 2^25: first value with bit 24 clear again.

    // ---- Functions ---------------------------------------------------------

    // counter[24]: set exactly when the counter sits in its bit-24 band
    // [2^24, 2^25). Band compare; equivalent to `(counter / 2^24) % 2 == 1`
    // across the counter's full 0..2^26-1 reach.
    fn counter_bit24(counter: u32) -> bool {
        return counter >= LED_BIT_BAND_LO and counter < LED_BIT_BAND_HI;
    }

    // `assign led = ~counter[24];` -- active-low LED: invert bit 24 so the
    // LED visibly blinks.
    fn compute_led(counter: u32) -> bool {
        return !counter_bit24(counter);
    }

    // `always @(posedge clk) counter <= counter + 1'b1;` -- one increment per
    // clock edge, wrapping a 26-bit register at 2^26.
    fn next_counter(counter: u32) -> u32 {
        var n: u32 = counter + 1;
        if (n == COUNTER_MOD) {
            n = 0;
        }
        return n;
    }

    // The original's comment: the heartbeat blinks at ~1.5 Hz because bit 24
    // has period 2^25 clock cycles (50 MHz / 2^25 ~ 1.49 Hz).
    fn blink_period_cycles() -> u64 {
        return 33554432; // 2^25
    }

    fn blink_millihz(clock_hz: u64) -> u64 {
        return clock_hz * 1000 / blink_period_cycles();
    }

    // Combinational surface for the Verilog backend: parameters become
    // inputs, the return is a continuously-driven `output wire result`.
    fn on_comb(counter: u32) -> bool {
        return compute_led(counter);
    }

    // ---- Tests -------------------------------------------------------------

    test reset {
        // counter = 26'd0: bit 24 clear, so the active-low LED is driven on.
        assert(!counter_bit24(0));
        assert(compute_led(0));
        assert(on_comb(0));
        // One clock edge later the counter is 1: still bit-24 clear, LED on.
        assert(next_counter(0) == 1);
        assert(compute_led(1));
    }

    test bit24_drives_led {
        // assign led = ~counter[24]: the LED is off exactly while bit 24 is
        // set, i.e. for counter values in [2^24, 2^25).
        assert(counter_bit24(16777216));
        assert(compute_led(16777216) == false);
        assert(counter_bit24(33554431));   // last cycle of the bit-24 band
        assert(compute_led(33554431) == false);
        assert(!counter_bit24(33554432));  // 2^25: bit 24 clear again
        assert(compute_led(33554432));
    }

    test counter_wraps {
        // A 26-bit reg wraps: 2^26 - 1 + 1 = 0.
        assert(next_counter(67108863) == 0);
        assert(next_counter(67108862) == 67108863);
        // After wrapping the LED is back on (bit 24 clear).
        assert(compute_led(next_counter(67108863)));
    }

    test half_period_flip {
        // The LED flips exactly 2^24 clock edges after reset: march the
        // always-block from 0 and land on the bit-24 boundary.
        var c: u32 = 0;
        var i: usize = 0;
        while (i < 16777216) {
            c = next_counter(c);
            i += 1;
        }
        assert(c == 16777216);
        assert(compute_led(c) == false);
    }

    test heartbeat_frequency {
        // 50 MHz / 2^25 ~ 1.49 Hz, as the original's comment states.
        assert(blink_period_cycles() == 33554432);
        assert(blink_millihz(50000000) == 1490);
    }
}
