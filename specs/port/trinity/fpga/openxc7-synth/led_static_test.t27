// t27/specs/port/trinity/fpga/openxc7-synth/led_static_test.t27
//
// Port of gHashTag/trinity `fpga/openxc7-synth/led_static_test.v`
// (Verilog, 1 module, 29 lines at cdb78c219135) to `.t27`, so that the
// module is generated by `t27c gen-verilog` instead of written by hand.
// This file carries the original's decisions as code; the original stays
// where it is and is not edited by this port.
//
// The original: LED STATIC TEST — both LED pins driven to fixed states to
// verify the pins work. `t23` is tied to logical 1 (if the LEDs are
// active-high, T23 turns ON), `r23` is tied to logical 0 (test opposite
// state for R23 — if the LEDs are active-low, R23 stays OFF). Whichever
// polarity, exactly one of the two LEDs lights, so the test tells the two
// pins apart. `clk` is unused but required.
//
// Backend shape (specs/fpga/apb_bridge.t27, specs/fpga/cts.t27): the module
// header is lowered from the `module Name { ... }` declaration plus the
// boilerplate `clk`/`rst_n`/`en` inputs and a `ready` output. `fn on_comb`
// gives the module a combinational data surface — parameters become input
// ports and the return is driven as `output wire result`
// (`assign result = on_comb();`). Here it drives the T23 pin state, the
// value the original ties to 1'b1, so synthesis keeps it instead of
// dead-code-eliminating the module.
//
// The Verilog backend emits one data output (`result`), so the original's
// two named outputs `t23`/`r23` cannot both appear as ports; the R23
// decision is carried by `led_r23` and the opposite-states relationship by
// `pins_differ`, both tested below.

module led_static_test {

    // The original's pin decisions, as code.

    // Original line 25: `assign t23 = 1'b1;` — LED T23 tied to logical 1.
    // If the LEDs are active-high, T23 turns ON.
    pub fn led_t23() -> bool {
        return true;
    }

    // Original line 26: `assign r23 = 1'b0;` — R23 tied to the opposite
    // state. If the LEDs are active-low, R23 stays OFF.
    pub fn led_r23() -> bool {
        return false;
    }

    // The two pins drive opposite states — that is what makes the static
    // test work: exactly one LED lights whichever way the polarity goes, so
    // the two pins are distinguishable on the board.
    pub fn pins_differ() -> bool {
        return led_t23() != led_r23();
    }

    // Combinational surface for the generated Verilog. The original has no
    // data input (its `clk` is unused but required), so `on_comb` takes no
    // parameters and forwards the T23 pin state, the value the original
    // ties to 1'b1. Never called with arguments from a test.
    fn on_comb() -> bool {
        return led_t23();
    }

    // === Tests: assert what the original produces ===

    test t23_tied_high {
        assert(led_t23() == true);
    }

    test r23_tied_low {
        assert(led_r23() == false);
    }

    test pins_opposite_states {
        assert(pins_differ());
    }

    test on_comb_drives_t23_state {
        assert(on_comb() == true);
    }
}
