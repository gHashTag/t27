module ternary_matvec;

const STATE_IDLE: i32 = 0;
const STATE_COMPUTE: i32 = 1;
const STATE_OUTPUT: i32 = 2;
const STATE_DONE: i32 = 3;

const WEIGHT_PLUS_1: i32 = 1;
const WEIGHT_MINUS_1: i32 = 2;
const WEIGHT_ZERO: i32 = 0;

pub fn weight_to_signed(weight_code: i32) -> i32 {
    if (weight_code == WEIGHT_PLUS_1) {
        return 1;
    } else if (weight_code == WEIGHT_MINUS_1) {
        return -1;
    } else {
        return 0;
    }
}

pub fn compute_weight_code(i_idx: u32, j_idx: u32) -> u32 {
    const ij_sum = i_idx + j_idx;
    return (ij_sum % 3);
}

pub fn get_expected_pattern(j: u32) -> i32 {
    const mod3 = j % 3;
    if (mod3 == 0) {
        return 43;
    } else if (mod3 == 1) {
        return -22;
    } else {
        return -21;
    }
}

test weight_conversion {
    assert(weight_to_signed(WEIGHT_PLUS_1) == 1);
    assert(weight_to_signed(WEIGHT_MINUS_1) == -1);
    assert(weight_to_signed(WEIGHT_ZERO) == 0);
}

test weight_code_computation {
    assert(compute_weight_code(0, 0) == 0);  // 0+0=0, 0%3=0
    assert(compute_weight_code(1, 0) == 1);  // 1+0=1, 1%3=1
    assert(compute_weight_code(2, 0) == 2);  // 2+0=2, 2%3=2
    assert(compute_weight_code(3, 0) == 0);  // 3+0=3, 3%3=0
}

test expected_pattern {
    assert(get_expected_pattern(0) == 43);
    assert(get_expected_pattern(1) == -22);
    assert(get_expected_pattern(2) == -21);
    assert(get_expected_pattern(3) == 43);
    assert(get_expected_pattern(4) == -22);
}