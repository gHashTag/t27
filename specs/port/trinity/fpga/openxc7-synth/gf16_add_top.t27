// ============================================================================
// Port of gHashTag/trinity fpga/openxc7-synth/gf16_add_top.v (174 lines)
// to a .t27 specification. Generated Verilog must be functionally
// equivalent to the hand-written original.
//
// Original module: gf16_add_top
//   Ports: clk, rst_n, a[15:0], b[15:0], result[15:0], led
//   Purpose: GF16 floating-point adder with input/output pipeline
//   registers for Fmax measurement.
//
// GF16 format (16 bits): 1 sign | 6 exponent (bias-free, valid 1..62)
//                        | 9 mantissa (implicit leading 1 -> 10-bit)
//
// Port-the-decision-not-the-plumbing: the clocked input/output registers
// are plumbing around the Fmax measurement loop; the DECISION is the
// adder datapath. It is encoded below as pure functions:
//   field decode -> exponent difference + barrel shift -> 10-bit mantissa
//   add -> leading-zero normalize -> round (tie-to-even) -> saturate
// All constants keep the original names and values.
// ============================================================================

module gf16_add_top {

    // Original lines 45-46: localparam GF16_MAX_EXP = 6'd62, GF16_MIN_EXP = 6'd1
    pub const GF16_MAX_EXP: u16 = 62;
    pub const GF16_MIN_EXP: u16 = 1;

    // ------------------------------------------------------------------
    // Field decode (original lines 49, 56-57)
    //   wire        sign_a = a[15];
    //   wire [5:0]  exp_a  = a[14:9];
    //   wire [9:0]  mant_a = {1'b1, a[8:0]};   // implicit leading 1
    // ------------------------------------------------------------------
    pub fn sign_bit(x: u16) -> u16 {
        return (x >> 15) & 1;
    }

    pub fn exp_field(x: u16) -> u16 {
        return (x >> 9) & 0x3F;
    }

    pub fn mant_field(x: u16) -> u16 {
        return 0x0100 | (x & 0x01FF);
    }

    // ------------------------------------------------------------------
    // Exponent difference (original lines 50, 66-68)
    //   wire [5:0] exp_diff = exp_a - exp_b;             // 6-bit wraparound
    //   if (exp_diff[5]) shift_b = 5'd31;                // negative a-b
    //   else             shift_b = exp_diff[4:0];
    // ------------------------------------------------------------------
    pub fn shift_amount(exp_a: u16, exp_b: u16) -> u16 {
        var exp_diff: u16 = (exp_a + 64 - exp_b) & 0x3F;
        if (((exp_diff >> 5) & 1) == 1) {
            return 31;
        }
        return exp_diff & 0x1F;
    }

    // ------------------------------------------------------------------
    // Barrel shift of the smaller operand's mantissa
    // (original lines 53-64, 69-70)
    //   wire [9:0] mant_b_shifted = mant_b >> shift_b;   // [9:0] wire
    //   wire [5:0] exp_aligned    = exp_a >= exp_b ? exp_a : exp_b;
    // ------------------------------------------------------------------
    pub fn barrel_shift_right9(mant_b: u16, shift: u16) -> u16 {
        if (shift == 0) {
            return mant_b;
        }
        if (shift <= 9) {
            return mant_b >> shift;
        }
        return 0;
    }

    pub fn exp_aligned_max(exp_a: u16, exp_b: u16) -> u16 {
        if (exp_a >= exp_b) {
            return exp_a;
        }
        return exp_b;
    }

    // ------------------------------------------------------------------
    // Leading-zero count over 10 bits (original lines 106-125)
    //   wire [3:0] lz_count = mant_add_result[9] ? 0 :
    //                         mant_add_result[8] ? 1 : ... : 9;
    // ------------------------------------------------------------------
    pub fn leading_zeros_10(m: u16) -> u16 {
        if (((m >> 9) & 1) == 1) { return 0; }
        if (((m >> 8) & 1) == 1) { return 1; }
        if (((m >> 7) & 1) == 1) { return 2; }
        if (((m >> 6) & 1) == 1) { return 3; }
        if (((m >> 5) & 1) == 1) { return 4; }
        if (((m >> 4) & 1) == 1) { return 5; }
        if (((m >> 3) & 1) == 1) { return 6; }
        if (((m >> 2) & 1) == 1) { return 7; }
        if (((m >> 1) & 1) == 1) { return 8; }
        if ((m & 1) == 1) { return 9; }
        return 9;
    }

    // ------------------------------------------------------------------
    // Normalization shift left by lz_count (original lines 129-148)
    //   mant_normalized = mant_add_result << lz_count;  // per-bit chain
    // ------------------------------------------------------------------
    pub fn normalize_10(m: u16, lz: u16) -> u16 {
        if (lz == 0) { return m; }
        if (lz == 1) { return (m & 0x01FF) << 1; }
        if (lz == 2) { return (m & 0x00FF) << 2; }
        if (lz == 3) { return (m & 0x007F) << 3; }
        if (lz == 4) { return (m & 0x003F) << 4; }
        if (lz == 5) { return (m & 0x001F) << 5; }
        if (lz == 6) { return (m & 0x000F) << 6; }
        if (lz == 7) { return (m & 0x0007) << 7; }
        if (lz == 8) { return (m & 0x0003) << 8; }
        return 0x0100;
    }

    // ------------------------------------------------------------------
    // Round-to-nearest-tie-to-even (original lines 121-140)
    //   wire [9:0] mant_rounded     = mant_normalized[9:0];
    //   wire        round_bit       = mant_rounded[9];
    //   wire [4:0]  round_remainder = mant_rounded[14:10];  // always 0:
    //                               mant_rounded is a 10-bit wire, so this
    //                               slice is constant zero.
    //   do_round    = round_bit & (round_remainder != 6'd0);
    //   tie_to_even = round_bit & (round_remainder == 6'd0) & ~mant_normalized[0];
    //   increment   = do_round & ~tie_to_even;
    // The full semantics (including the constant-zero remainder) are
    // kept; the returned increment is therefore 0 for every input.
    // ------------------------------------------------------------------
    pub fn round_increment(mant_normalized: u16) -> u16 {
        var round_bit: u16 = (mant_normalized >> 9) & 1;
        var round_remainder: u16 = (mant_normalized >> 10) & 0x1F;
        var do_round: u16 = 0;
        if (round_bit == 1) {
            if (round_remainder != 0) {
                do_round = 1;
            }
        }
        var tie_to_even: u16 = 0;
        if (round_bit == 1) {
            if (round_remainder == 0) {
                if ((mant_normalized & 1) == 0) {
                    tie_to_even = 1;
                }
            }
        }
        var increment: u16 = do_round;
        if (tie_to_even == 1) {
            increment = 0;
        }
        return increment;
    }

    // ------------------------------------------------------------------
    // The adder datapath: one pure function combining the stages above.
    // Mirrors original lines 49-154 (decode through saturate).
    // ------------------------------------------------------------------
    pub fn gf16_add(a: u16, b: u16) -> u16 {
        // Decode
        var sign_a: u16 = sign_bit(a);
        var sign_b: u16 = sign_bit(b);
        var exp_a: u16 = exp_field(a);
        var exp_b: u16 = exp_field(b);
        var mant_a: u16 = mant_field(a);
        var mant_b: u16 = mant_field(b);

        // Align the smaller-magnitude operand (6-bit exp diff, barrel shift)
        var shift_b: u16 = shift_amount(exp_a, exp_b);
        var mant_b_shifted: u16 = barrel_shift_right9(mant_b, shift_b);
        var exp_aligned: u16 = exp_aligned_max(exp_a, exp_b);

        // 10-bit mantissa add with carry into the exponent
        // (original lines 75-85)
        var mant_sum: u16 = mant_a + mant_b_shifted;
        var mant_overflow: u16 = (mant_sum >> 9) & 1;
        var mant_add_result: u16 = mant_sum;
        if (mant_overflow == 1) {
            mant_add_result = mant_sum >> 1;
        }
        var exp_add_norm: u16 = exp_aligned;
        if (mant_overflow == 1) {
            exp_add_norm = (exp_aligned + 1) & 0x3F;
        }

        // Sign is XOR of the input signs (original line 87)
        var sign_result: u16 = sign_a ^ sign_b;

        // Normalize with leading-zero count (original lines 88-119)
        var lz_count: u16 = leading_zeros_10(mant_add_result);
        var mant_normalized: u16 = normalize_10(mant_add_result, lz_count);
        var exp_normalized: u16 = (exp_add_norm + 64 - lz_count) & 0x3F;

        // Saturation clamp on the exponent (original lines 149-154).
        // >= 62 and < 1 are mutually exclusive, so two sequential guards
        // are equivalent to the original's if / else-if.
        var exp_final: u16 = exp_normalized;
        if (exp_normalized >= GF16_MAX_EXP) {
            exp_final = GF16_MAX_EXP;
        }
        if (exp_normalized < GF16_MIN_EXP) {
            exp_final = GF16_MIN_EXP;
        }

        // Round (original lines 121-140) and carry into exponent
        var increment: u16 = round_increment(mant_normalized);
        var mant_rounded: u16 = mant_normalized & 0x01FF;
        var mant_inc: u16 = (mant_rounded + increment) & 0x01FF;
        var round_overflow: u16 = (mant_inc >> 8) & 1;
        var mant_result: u16 = mant_inc;
        if (round_overflow == 1) {
            mant_result = 1;
        }
        var exp_result: u16 = exp_final;
        if (round_overflow == 1) {
            exp_result = (exp_final + 1) & 0x3F;
        }

        // Final saturation clamp (original lines 156-160)
        var exp_result_clamped: u16 = exp_result;
        if (exp_result >= GF16_MAX_EXP) {
            exp_result_clamped = GF16_MAX_EXP;
        }

        return (sign_result << 15) | (exp_result_clamped << 9) | (mant_result & 0x01FF);
    }

    // ------------------------------------------------------------------
    // Hardware boundary (original line 161):
    //   assign result = {sign_result, exp_result_clamped[5:0], mant_result[8:0]};
    // on_comb lowers to the combinational output port `result`.
    // ------------------------------------------------------------------
    pub fn on_comb(a: u16, b: u16) -> u16 {
        return gf16_add(a, b);
    }

    // ------------------------------------------------------------------
    // LED indicator (original line 171):
    //   assign led = rst_n ? 1'b0 : 1'b1;   // active-low: ON when not in reset
    // ------------------------------------------------------------------
    pub fn led_level(rst_n: u16) -> u16 {
        if (rst_n != 0) {
            return 0;
        }
        return 1;
    }

    // ==================================================================
    // Tests. Expected values are bit-exact outputs of the original
    // Verilog datapath, hand-traced line by line from gf16_add_top.v.
    // ==================================================================

    test gf16_add_top_decode_fields {
        assert(sign_bit(0x8001) == 1);
        assert(sign_bit(0x7FFF) == 0);
        assert(sign_bit(0x0000) == 0);
        assert(sign_bit(0xFFFF) == 1);
        assert(exp_field(0x1400) == 10);
        assert(exp_field(0xFFFF) == 63);
        assert(exp_field(0x0200) == 1);
        assert(exp_field(0x7C00) == 62);
        assert(mant_field(0x0000) == 0x0100);
        assert(mant_field(0x0001) == 0x0101);
        assert(mant_field(0x1FFF) == 0x01FF);
    }

    test gf16_add_top_exponent_alignment {
        assert(shift_amount(10, 10) == 0);
        assert(shift_amount(10, 8) == 2);
        assert(shift_amount(8, 10) == 31);
        assert(shift_amount(0, 62) == 2);
        assert(shift_amount(0, 31) == 31);
        assert(shift_amount(63, 0) == 31);
        assert(exp_aligned_max(10, 8) == 10);
        assert(exp_aligned_max(8, 10) == 10);
    }

    test gf16_add_top_barrel_shift {
        assert(barrel_shift_right9(0x01FF, 0) == 0x01FF);
        assert(barrel_shift_right9(0x01FF, 1) == 0x00FF);
        assert(barrel_shift_right9(0x01FF, 2) == 0x007F);
        assert(barrel_shift_right9(0x01FF, 8) == 0x0001);
        assert(barrel_shift_right9(0x01FF, 9) == 0);
        assert(barrel_shift_right9(0x01FF, 31) == 0);
        assert(barrel_shift_right9(0x0100, 4) == 0x0010);
    }

    test gf16_add_top_leading_zeros {
        assert(leading_zeros_10(0x03FF) == 0);
        assert(leading_zeros_10(0x0200) == 0);
        assert(leading_zeros_10(0x01FF) == 1);
        assert(leading_zeros_10(0x0100) == 1);
        assert(leading_zeros_10(0x00FF) == 2);
        assert(leading_zeros_10(0x0002) == 8);
        assert(leading_zeros_10(0x0001) == 9);
        assert(leading_zeros_10(0x0000) == 9);
    }

    test gf16_add_top_normalize {
        assert(normalize_10(0x0100, 0) == 0x0100);
        assert(normalize_10(0x013F, 1) == 0x027E);
        assert(normalize_10(0x0040, 2) == 0x0100);
        assert(normalize_10(0x0001, 9) == 0x0100);
        assert(normalize_10(0x0000, 9) == 0x0100);
    }

    test gf16_add_top_round_tie_to_even {
        assert(round_increment(0x0000) == 0);
        assert(round_increment(0x01FF) == 0);
        assert(round_increment(0x03FF) == 0);
    }

    test gf16_add_top_datapath_vectors {
        assert(gf16_add(0x0000, 0x0000) == 0x0200);
        assert(gf16_add(0x1400, 0x1400) == 0x1400);
        assert(gf16_add(0x1400, 0x1480) == 0x1480);
        assert(gf16_add(0x1401, 0x141F) == 0x1420);
        assert(gf16_add(0x143F, 0x103F) == 0x1401);
        assert(gf16_add(0x103F, 0x143F) == 0x127E);
        assert(gf16_add(0x1FFF, 0x1FFF) == 0x2001);
        assert(gf16_add(0x0001, 0x3FFF) == 0x3C02);
        assert(gf16_add(0x8001, 0x3FFF) == 0xBC02);
        assert(gf16_add(0xFFFF, 0xFFFF) == 0x7C01);
        assert(gf16_add(0x7C00, 0x7C00) == 0x7C00);
        assert(gf16_add(0x8200, 0x8200) == 0x0200);
        assert(gf16_add(0x03E0, 0x03E0) == 0x0401);
        assert(gf16_add(0x001F, 0x0010) == 0x022E);
        assert(gf16_add(0x7FFF, 0x03FF) == 0x7C01);
        assert(gf16_add(0x0000, 0x7C00) == 0x7A80);
    }

    test gf16_add_top_sign_xor {
        assert(gf16_add(0x8000, 0x0000) == 0x8200);
        assert(gf16_add(0x0000, 0x8000) == 0x8200);
        assert(gf16_add(0x8000, 0x8000) == 0x0200);
    }

    test gf16_add_top_boundary_and_led {
        // Saturation constants keep the original names and values.
        assert(GF16_MAX_EXP == 62);
        assert(GF16_MIN_EXP == 1);
        // on_comb is the combinational port of the generated module.
        assert(on_comb(0x143F, 0x103F) == 0x1401);
        assert(on_comb(0x0000, 0x0000) == 0x0200);
        // led = rst_n ? 1'b0 : 1'b1 (line 171): active-low reset LED.
        assert(led_level(0) == 1);
        assert(led_level(1) == 0);
    }
}
