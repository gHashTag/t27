// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/clock_bufg_test.t27
// Clock BUFG Test Module Port for Trinity T27 FPGA HIR
// Global Clock Buffer (BUFG) test with LED outputs for Xilinx 7-series
// Models BUFG instantiation, 26-bit counter, and LED blink behavior
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module clock_bufg_test {

    // === Clock input and LED output constants ===

    pub const CLK_FREQ_MHZ : u32 = 50;  // 50 MHz input clock on U22
    pub const COUNTER_WIDTH : u32 = 26; // 26-bit counter
    pub const FAST_BLINK_BIT : u32 = 22; // T23 LED bit (fast blink ~6 Hz)
    pub const SLOW_BLINK_BIT : u32 = 24; // R23 LED bit (slow blink ~1.5 Hz)

    // === Clock buffer configuration ===

    pub struct BufgConfig {
        name : &str,
        input_freq_mhz : u32,
        output_freq_mhz : u32,
    }

    // === Constructor helpers ===

    fn bufg_config(name: &str) -> BufgConfig {
        return BufgConfig{
            .name = name,
            .input_freq_mhz = CLK_FREQ_MHZ,
            .output_freq_mhz = CLK_FREQ_MHZ, // BUFG preserves frequency
        };
    }

    // === Clock period calculations ===

    fn clock_period_ps(freq_mhz: u32) -> u32 {
        if (freq_mhz == 0) {
            return 0;
        }
        return 1000000000 / freq_mhz;
    }

    fn blink_frequency(freq_mhz: u32, bit_pos: u32) -> u32 {
        if (bit_pos == 0) {
            return freq_mhz;
        }
        var divisor : u32 = 1 << bit_pos;
        return freq_mhz / divisor;
    }

    fn led_on_time_ps(freq_mhz: u32, bit_pos: u32) -> u32 {
        var freq : u32 = blink_frequency(freq_mhz, bit_pos);
        if (freq == 0) {
            return 0; // Avoid division by zero
        }
        var period_ps : u32 = 1000000000 / freq; // Period in picoseconds
        return period_ps / 2; // Half period for 50% duty cycle
    }

    // === LED output computation ===

    fn compute_t23_led(counter_value: u32) -> bool {
        // T23 LED toggles based on counter bit 22 (fast blink ~6 Hz)
        // LED is active-low (inverted)
        var bit_value : u32 = (counter_value >> FAST_BLINK_BIT) & 1;
        return !bit_value;
    }

    fn compute_r23_led(counter_value: u32) -> bool {
        // R23 LED toggles based on counter bit 24 (slow blink ~1.5 Hz)
        // LED is active-low (inverted)
        var bit_value : u32 = (counter_value >> SLOW_BLINK_BIT) & 1;
        return !bit_value;
    }

    fn compute_led_outputs_t23(counter_value: u32) -> bool {
        return compute_t23_led(counter_value);
    }

    fn compute_led_outputs_r23(counter_value: u32) -> bool {
        return compute_r23_led(counter_value);
    }

    // === Counter behavior simulation ===

    fn simulate_counter_increment(current_value: u32, rising_edges: u32) -> u32 {
        var result : u32 = current_value;
        var i : u32 = 0;
        while (i < rising_edges) {
            result = result + 1;
            i = i + 1;
        }
        return result;
    }

    // === Validation functions ===

    fn validate_counter_width(width: u32) -> bool {
        return width >= 1 and width <= 64; // Reasonable width range
    }

    fn validate_led_bit_positions(fast_bit: u32, slow_bit: u32) -> bool {
        return fast_bit < COUNTER_WIDTH and slow_bit < COUNTER_WIDTH and fast_bit != slow_bit;
    }

    fn validate_clock_frequency(freq_mhz: u32) -> bool {
        return freq_mhz > 0 and freq_mhz <= 1000; // 1 MHz to 1 GHz range
    }

    // === Tests ===

    test clock_buffer_creation
        given cfg = bufg_config("clk_bufg")
        then cfg.name == "clk_bufg"
        and cfg.input_freq_mhz == 50
        and cfg.output_freq_mhz == 50

    test clock_period_calculation
        then clock_period_ps(50) == 20000000  // 50 MHz = 20 ns
        and clock_period_ps(100) == 10000000  // 100 MHz = 10 ns

    test blink_frequency_fast
        then blink_frequency(50, 22) == 50 / (1 << 22)  // 0 Hz (50 / 4194304 = 0)

    test blink_frequency_slow
        then blink_frequency(50, 24) == 50 / (1 << 24)  // 0 Hz (50 / 16777216 = 0)

    test led_on_time_calculation
        then led_on_time_ps(50, 22) > 0
        and led_on_time_ps(50, 24) > 0

    test validate_counter_width_ok
        then validate_counter_width(26) == true
        and validate_counter_width(32) == true

    test validate_counter_width_bad
        then validate_counter_width(0) == false
        and validate_counter_width(65) == false

    test validate_led_bit_positions_ok
        then validate_led_bit_positions(22, 24) == true

    test validate_led_bit_positions_bad
        then validate_led_bit_positions(22, 22) == false  // Same bit
        and validate_led_bit_positions(26, 24) == false  // Bit out of range

    test validate_clock_frequency_ok
        then validate_clock_frequency(50) == true
        and validate_clock_frequency(100) == true

    test validate_clock_frequency_bad
        then validate_clock_frequency(0) == false
        and validate_clock_frequency(1001) == false

    test counter_increment_simple
        then simulate_counter_increment(0, 1) == 1
        and simulate_counter_increment(5, 3) == 8

    test_led_t23_initial
        then compute_t23_led(0) == true  // Active-low, bit 0 = 0, so LED off (true)

    test_led_t23_after_increment
        then compute_t23_led(1 << FAST_BLINK_BIT) == false  // Bit 22 = 1, so LED on (false)

    test_led_r23_initial
        then compute_r23_led(0) == true  // Active-low, bit 24 = 0, so LED off (true)

    test_led_r23_after_increment
        then compute_r23_led(1 << SLOW_BLINK_BIT) == false  // Bit 24 = 1, so LED on (false)

    test_led_outputs_initial
        then compute_led_outputs_t23(0) == true  // T23 off
        and compute_led_outputs_r23(0) == true  // R23 off

    test_led_outputs_both_on
        var counter_val : u32 = (1 << FAST_BLINK_BIT) + (1 << SLOW_BLINK_BIT);
        then compute_led_outputs_t23(counter_val) == false  // T23 on
        and compute_led_outputs_r23(counter_val) == false  // R23 on

    // === Invariants ===

    invariant counter_width_positive
        assert validate_counter_width(COUNTER_WIDTH)

    invariant led_bit_positions_valid
        assert validate_led_bit_positions(FAST_BLINK_BIT, SLOW_BLINK_BIT)

    invariant clock_frequency_valid
        assert validate_clock_frequency(CLK_FREQ_MHZ)

    bench led_output_calculation_latency
        measure: nanoseconds to compute_led_outputs_t23(42)
        target: < 100ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY