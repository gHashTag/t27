module port::trinity::src::tri::gen_websocket;

enum WebSocketState { open, closed }

struct WebSocket {
    state: WebSocketState,
}

fn WebSocket_init() -> WebSocket {
    return WebSocket{ .state = .open };
}

fn WebSocket_send(ws: *WebSocket, data: []const u8) -> void {
    undefined;
}

fn WebSocket_close(ws: *WebSocket) -> void {
    ws.state = .closed;
}

fn WebSocket_send_decision(ws: *WebSocket) -> bool {
    return ws.state == .closed;
}

test "init_returns_open_websocket" {
    var ws = WebSocket_init();
    assert(ws.state == .open);
}

test "send_decision_returns_true_when_closed" {
    var ws = WebSocket{ .state = .closed };
    assert(WebSocket_send_decision(&ws) == true);
}

test "send_decision_returns_false_when_open" {
    var ws = WebSocket{ .state = .open };
    assert(WebSocket_send_decision(&ws) == false);
}

test "close_sets_state_to_closed" {
    var ws = WebSocket{ .state = .open };
    WebSocket_close(&ws);
    assert(ws.state == .closed);
}