module port::trinity::src::tri::gen_websocket;

enum WebSocketState { open, closed }

struct WebSocket {
    state: WebSocketState,
}

fn WebSocket_init() -> WebSocket {
    return WebSocket{ .state = .open };
}

fn WebSocket_send(ws: *WebSocket, data: []const u8) -> void {
    undefined;
}

fn WebSocket_close(ws: *WebSocket) -> void {
    ws.state = .closed;
}

// Decision: Can we send data on this websocket?
// Returns true if send would succeed, false if it would return an error
fn WebSocket_send_can_send(ws: *WebSocket) -> bool {
    return ws.state != .closed;
}

// Decision: What error would send return?
// Returns true if send would return error.Closed, false if it would succeed
fn WebSocket_send_would_error(ws: *WebSocket) -> bool {
    return ws.state == .closed;
}

test "init_returns_open_websocket" {
    var ws = WebSocket_init();
    assert(ws.state == .open);
}

test "send_can_send_returns_true_when_open" {
    var ws = WebSocket{ .state = .open };
    assert(WebSocket_send_can_send(&ws) == true);
}

test "send_can_send_returns_false_when_closed" {
    var ws = WebSocket{ .state = .closed };
    assert(WebSocket_send_can_send(&ws) == false);
}

test "send_would_error_returns_true_when_closed" {
    var ws = WebSocket{ .state = .closed };
    assert(WebSocket_send_would_error(&ws) == true);
}

test "send_would_error_returns_false_when_open" {
    var ws = WebSocket{ .state = .open };
    assert(WebSocket_send_would_error(&ws) == false);
}

test "close_sets_state_to_closed" {
    var ws = WebSocket{ .state = .open };
    WebSocket_close(&ws);
    assert(ws.state == .closed);
}