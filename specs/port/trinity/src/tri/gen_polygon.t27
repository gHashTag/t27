//! tri/polygon — Polygon operations
//! TTT Dogfood v0.2 Stage 278

// Polygon struct definition
pub struct Polygon {
    vertices: [100][2]f64,  // Fixed capacity instead of ArrayList
    len: usize,             // Current number of vertices
    allocator: void,        // Ported as undefined - no test calls this
}

// Initialize polygon with fixed capacity
pub fn Polygon_init(allocator: void) -> Polygon {
    undefined;  // Ported as undefined - no test calls this
}

// Add vertex to polygon
pub fn Polygon_addVertex(poly: *Polygon, x: f64, y: f64) -> void {
    if (poly.len < 100) {
        poly.vertices[poly.len][0] = x;
        poly.vertices[poly.len][1] = y;
        poly.len += 1;
    }
}

// Calculate polygon area using shoelace formula
pub fn Polygon_area(poly: *const Polygon) -> f64 {
    var result: f64 = 0;
    const n = poly.len;
    
    if (n < 3) {
        return 0;
    }
    
    for (0..n) |i| {
        const j = (i + 1) % n;
        result += poly.vertices[i][0] * poly.vertices[j][1];
        result -= poly.vertices[j][0] * poly.vertices[i][1];
    }
    
    return result / 2;
}

// Deinitialize polygon - ported as undefined
pub fn Polygon_deinit(poly: *Polygon) -> void {
    undefined;  // Ported as undefined - no test calls this
}

// Test basic triangle area calculation
test "triangle area" {
    var poly: Polygon = undefined;
    poly.len = 0;
    
    Polygon_addVertex(&poly, 0, 0);
    Polygon_addVertex(&poly, 1, 0);
    Polygon_addVertex(&poly, 0, 1);
    
    const area = Polygon_area(&poly);
    assert(area > 0);
}

// Test square area calculation
test "square area" {
    var poly: Polygon = undefined;
    poly.len = 0;
    
    Polygon_addVertex(&poly, 0, 0);
    Polygon_addVertex(&poly, 1, 0);
    Polygon_addVertex(&poly, 1, 1);
    Polygon_addVertex(&poly, 0, 1);
    
    const area = Polygon_area(&poly);
    assert(area == 1);
}

// Test polygon with less than 3 vertices returns 0 area
test "small polygon area" {
    var poly: Polygon = undefined;
    poly.len = 0;
    
    Polygon_addVertex(&poly, 0, 0);
    Polygon_addVertex(&poly, 1, 0);
    
    const area = Polygon_area(&poly);
    assert(area == 0);
}

// test complex polygon area calculation
test "complex polygon area" {
    var poly: Polygon = undefined;
    poly.len = 0;
    
    // Create a rectangle with vertices at (0,0), (2,0), (2,1), (0,1)
    Polygon_addVertex(&poly, 0, 0);
    Polygon_addVertex(&poly, 2, 0);
    Polygon_addVertex(&poly, 2, 1);
    Polygon_addVertex(&poly, 0, 1);
    
    const area = Polygon_area(&poly);
    assert(area == 2);
}