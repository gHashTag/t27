module port::trinity::src::tri;

struct PropertyTest {
    name: []const u8,
    iterations: usize,
}

fn PropertyTest_init(name: []const u8, iterations: usize) PropertyTest {
    return PropertyTest { name: name, iterations: iterations };
}

fn PropertyTest_check(pt: PropertyTest, fn_ptr: "fn(i32) bool") -> bool {
    var i: usize = 0;
    while (i < pt.iterations) {
        i = i + 1;
        let input: i32 = i as i32;
        if (!fn_ptr(input)) {
            return false;
        }
    }
    return true;
}

test "PropertyTest_init_sets_fields" {
    let pt = PropertyTest_init("test", 5);
    assert(pt.name == "test");
    assert(pt.iterations == 5);
}

test "PropertyTest_check_always_true" {
    let pt = PropertyTest_init("always_true", 10);
    fn always_true(x: i32) bool {
        return true;
    }
    assert(PropertyTest_check(pt, always_true));
}

test "PropertyTest_check_returns_false_on_false" {
    let pt = PropertyTest_init("false_at_5", 10);
    fn returns_false_at_5(x: i32) bool {
        return x != 5;
    }
    assert(!PropertyTest_check(pt, returns_false_at_5));
}