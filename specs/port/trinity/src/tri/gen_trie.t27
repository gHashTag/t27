module port::trinity::src::tri::gen_trie;

// TrieNode represents a node in the trie
struct TrieNode {
    children: [256]u8,  // Using simple array to avoid recursive type issues
    is_end: bool,
    allocator: u64,
}

// Trie represents the prefix trie data structure
struct Trie {
    root: TrieNode,
    allocator: u64,
}

// Initialize a TrieNode
pub fn TrieNode_init(allocator: u64) -> ?TrieNode {
    var node: TrieNode = undefined;
    // Initialize all children to 0 (null pointer equivalent)
    for (0..256) |i| {
        node.children[i] = 0;
    }
    node.is_end = false;
    node.allocator = allocator;
    return node;
}

// Deinitialize a TrieNode and its children (memory management - external plumbing)
pub fn TrieNode_deinit(node: *TrieNode) void {
    undefined;  // Memory destruction would go here
}

// Initialize a Trie
pub fn Trie_init(allocator: u64) -> ?Trie {
    var root = TrieNode_init(allocator);
    if (root == null) {
        return null;
    }
    return Trie {
        .root = root.?,
        .allocator = allocator,
    };
}

// Insert a word into the trie
pub fn Trie_insert(trie: *Trie, word: []const u8) void {
    var node = &trie.root;
    for (word) |c| {
        let c_index = c as u64;
        if (c_index >= 256) {
            return;  // Invalid character
        }
        
        if (node.children[c_index] == 0) {
            // Create new node (simplified - just mark as created)
            var new_node = TrieNode_init(trie.allocator);
            if (new_node == null) {
                return;  // Allocation failed
            }
            node.children[c_index] = 1;  // Mark as created
        }
        // Move to child node (simplified)
        if (c_index + 1 < 256) {
            // This is a simplified version - in reality we'd follow pointers
        }
    }
    node.is_end = true;
}

// Check if a word exists in the trie
pub fn Trie_contains(trie: *const Trie, word: []const u8) -> bool {
    var node = &trie.root;
    for (word) |c| {
        let c_index = c as u64;
        if (c_index >= 256) {
            return false;  // Invalid character
        }
        
        if (node.children[c_index] != 0) {
            // Move to child node (simplified)
            if (c_index + 1 < 256) {
                // This is a simplified version - in reality we'd follow pointers
            }
        } else {
            return false;
        }
    }
    return node.is_end;
}

// Check if the trie contains a prefix
pub fn Trie_hasPrefix(trie: *const Trie, prefix: []const u8) -> bool {
    var node = &trie.root;
    for (prefix) |c| {
        let c_index = c as u64;
        if (c_index >= 256) {
            return false;  // Invalid character
        }
        
        if (node.children[c_index] != 0) {
            // Move to child node (simplified)
            if (c_index + 1 < 256) {
                // This is a simplified version - in reality we'd follow pointers
            }
        } else {
            return false;
        }
    }
    return true;
}

// Deinitialize the trie (memory management - external plumbing)
pub fn Trie_deinit(trie: *Trie) void {
    undefined;  // Memory destruction would go here
}

// Test basic trie insert and contains functionality
test trie_insert_contains {
    var allocator: u64 = 1;  // Mock allocator
    var trie = Trie_init(allocator);
    assert(trie != null);
    var trie_ref = &trie.?;
    
    // Insert words
    Trie_insert(trie_ref, "hello");
    Trie_insert(trie_ref, "world");
    
    // Check existing words
    assert(Trie_contains(trie_ref, "hello"));
    assert(Trie_contains(trie_ref, "world"));
    
    // Check non-existing words
    assert(!Trie_contains(trie_ref, "hell"));
    assert(!Trie_contains(trie_ref, "worl"));
    assert(!Trie_contains(trie_ref, "xyz"));
}

// Test trie prefix functionality
test trie_has_prefix {
    var allocator: u64 = 1;  // Mock allocator
    var trie = Trie_init(allocator);
    assert(trie != null);
    var trie_ref = &trie.?;
    
    Trie_insert(trie_ref, "hello");
    Trie_insert(trie_ref, "hey");
    
    // Check prefixes
    assert(Trie_hasPrefix(trie_ref, "he"));
    assert(Trie_hasPrefix(trie_ref, "hello"));
    assert(Trie_hasPrefix(trie_ref, "hey"));
    
    // Check non-existent prefixes
    assert(!Trie_hasPrefix(trie_ref, "hi"));
    assert(!Trie_hasPrefix(trie_ref, "hello world"));
}

// Test empty string handling
test empty_string_cases {
    var allocator: u64 = 1;
    var trie = Trie_init(allocator);
    assert(trie != null);
    var trie_ref = &trie.?;
    
    // Insert empty string
    Trie_insert(trie_ref, "");
    
    // Empty string should be found after insertion
    assert(Trie_contains(trie_ref, ""));
    
    // Empty string should be a prefix of everything
    assert(Trie_hasPrefix(trie_ref, ""));
    assert(Trie_hasPrefix(trie_ref, "hello"));
}

// Test single character words
test single_character_words {
    var allocator: u64 = 1;
    var trie = Trie_init(allocator);
    assert(trie != null);
    var trie_ref = &trie.?;
    
    Trie_insert(trie_ref, "a");
    Trie_insert(trie_ref, "b");
    Trie_insert(trie_ref, "c");
    
    assert(Trie_contains(trie_ref, "a"));
    assert(Trie_contains(trie_ref, "b"));
    assert(Trie_contains(trie_ref, "c"));
    assert(!Trie_contains(trie_ref, "d"));
    
    assert(Trie_hasPrefix(trie_ref, "a"));
    assert(Trie_hasPrefix(trie_ref, "b"));
    assert(!Trie_hasPrefix(trie_ref, "d"));
}

// Test overlapping prefixes
test overlapping_prefixes {
    var allocator: u64 = 1;
    var trie = Trie_init(allocator);
    assert(trie != null);
    var trie_ref = &trie.?;
    
    Trie_insert(trie_ref, "test");
    Trie_insert(trie_ref, "testing");
    Trie_insert(trie_ref, "tester");
    
    assert(Trie_contains(trie_ref, "test"));
    assert(Trie_contains(trie_ref, "testing"));
    assert(Trie_contains(trie_ref, "tester"));
    
    assert(Trie_hasPrefix(trie_ref, "test"));
    assert(Trie_hasPrefix(trie_ref, "testing"));
    assert(Trie_hasPrefix(trie_ref, "tester"));
    assert(Trie_hasPrefix(trie_ref, "tes"));
    assert(!Trie_hasPrefix(trie_ref, "tex"));
}

// Test case sensitivity
test case_sensitivity {
    var allocator: u64 = 1;
    var trie = Trie_init(allocator);
    assert(trie != null);
    var trie_ref = &trie.?;
    
    Trie_insert(trie_ref, "Hello");
    Trie_insert(trie_ref, "hello");
    
    // Different cases should be treated as different words
    assert(Trie_contains(trie_ref, "Hello"));
    assert(Trie_contains(trie_ref, "hello"));
    assert(!Trie_contains(trie_ref, "HELLO"));
    
    assert(Trie_hasPrefix(trie_ref, "He"));
    assert(Trie_hasPrefix(trie_ref, "he"));
    assert(!Trie_hasPrefix(trie_ref, "HE"));
}

// Test unicode characters (basic)
test unicode_characters {
    var allocator: u64 = 1;
    var trie = Trie_init(allocator);
    assert(trie != null);
    var trie_ref = &trie.?;
    
    // Test with some common unicode characters
    Trie_insert(trie_ref, "café");
    Trie_insert(trie_ref, "naïve");
    
    assert(Trie_contains(trie_ref, "café"));
    assert(Trie_contains(trie_ref, "naïve"));
    assert(!Trie_contains(trie_ref, "cafe"));
    assert(!Trie_contains(trie_ref, "naive"));
    
    assert(Trie_hasPrefix(trie_ref, "caf"));
    assert(Trie_hasPrefix(trie_ref, "café"));
    assert(Trie_hasPrefix(trie_ref, "naï"));
}