module port::trinity::src::brain::angular_gyrus;

pub const PHI: f64 = 1.6180339887498948482;
pub const PHI_INV: f64 = 1.0 / PHI;
pub const PHI_SQ: f64 = PHI * PHI;
pub const PHI_INV_SQ: f64 = 1.0 / PHI_SQ;
pub const TRINITY: f64 = PHI_SQ + PHI_INV_SQ;

pub const FormatInfo = struct {
    name: []const u8,
    total_bits: u8,
    exp_bits: u8,
    mant_bits: u8,
    exp_mant_ratio: f64,
    phi_distance: f64,
    golden_pct: f64,
};

pub const GF16_INFO = FormatInfo{
    .name = "GF16",
    .total_bits = 16,
    .exp_bits = 6,
    .mant_bits = 9,
    .exp_mant_ratio = 6.0 / 9.0,
    .phi_distance = 0.0485833228,
    .golden_pct = 96.9166677,
};

pub const BF16_INFO = FormatInfo{
    .name = "BF16",
    .total_bits = 16,
    .exp_bits = 8,
    .mant_bits = 7,
    .exp_mant_ratio = 8.0 / 7.0,
    .phi_distance = 0.131423848,
    .golden_pct = 91.8576152,
};

pub const FP16_INFO = FormatInfo{
    .name = "FP16",
    .total_bits = 16,
    .exp_bits = 5,
    .mant_bits = 10,
    .exp_mant_ratio = 5.0 / 10.0,
    .phi_distance = 0.118033988,
    .golden_pct = 92.6966012,
};

pub fn phiDistance(exp_bits: u8, mant_bits: u8) f64 {
    const ratio = exp_bits as f64 / mant_bits as f64;
    const diff = ratio - PHI_INV;
    if (diff < 0.0) {
        return -diff;
    }
    return diff;
}

pub fn goldenPct(exp_bits: u8, mant_bits: u8) f64 {
    const dist = phiDistance(exp_bits, mant_bits);
    return (1.0 - dist / PHI_INV) * 100.0;
}

pub fn formatTable(writer: anytype) void {
    undefined;
}

pub fn autoSelectFormat(layer_idx: usize, total_layers: usize) FormatInfo {
    const ratio = layer_idx as f64 / total_layers as f64;
    if (ratio < 0.2) return FP16_INFO;
    if (ratio < 0.8) return GF16_INFO;
    return BF16_INFO;
}

test phi_distance_GF16 {
    const dist = phiDistance(6, 9);
    assert(dist < 0.05);
    assert(dist > 0);
}

test phi_distance_GF16_is_closest {
    const gf16_dist = phiDistance(6, 9);
    const bf16_dist = phiDistance(8, 7);
    const fp16_dist = phiDistance(5, 10);
    assert(gf16_dist < bf16_dist);
    assert(gf16_dist < fp16_dist);
}

test golden_pct_GF16 {
    const pct = goldenPct(6, 9);
    assert(pct > 90.0);
}

test auto_select_format {
    assert(autoSelectFormat(0, 10).name == "FP16");
    assert(autoSelectFormat(5, 10).name == "GF16");
    assert(autoSelectFormat(9, 10).name == "BF16");
}

test trinity_identity {
    const val = TRINITY - 3.0;
    if (val < 0.0) {
        assert(-val < 1e-10);
    } else {
        assert(val < 1e-10);
    }
}