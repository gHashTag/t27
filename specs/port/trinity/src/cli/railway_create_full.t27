module port::trinity::src::cli::railway_create_full;

// Port of railway_create_full.zig from gHashTag/trinity
// This function validates command line arguments and constructs the GraphQL query
pub fn main() -> i32 {
    // Validate command line arguments
    const argc = 5; // Simulated argc (program name + 4 args)
    if (argc < 5) {
        return 1; // Exit code 1 for usage error
    }
    
    undefined; // HTTP request and execution logic moved to undefined body
}

// Helper function to validate argument count
pub fn validate_args(argc: u32) -> bool {
    return argc >= 5;
}

// Helper function to check for errors in response
pub fn has_errors(response: []const u8) -> bool {
    // Simple check for "errors" in the response string
    var i: u32 = 0;
    while (i < response.len - 6) {
        if (response[i] == '"') {
            if (response[i+1] == 'e' and response[i+2] == 'r' and response[i+3] == 'r' and 
                response[i+4] == 'o' and response[i+5] == 'r' and response[i+6] == 's') {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

test main_validation {
    // Test argument validation
    assert(validate_args(5) == true);
    assert(validate_args(4) == false);
    assert(validate_args(6) == true);
}

test error_detection {
    // Test error detection in response
    const error_response = "{\"data\": null, \"errors\": [{\"message\": \"Invalid input\"}]}";
    const success_response = "{\"data\": {\"serviceCreate\": {\"id\": \"svc-123\", \"name\": \"test\"}}}";
    
    assert(has_errors(error_response) == true);
    assert(has_errors(success_response) == false);
}