// Test: Argument validation logic
test validate_args_enough {
    // Test that argc < 4 returns error
    var argc_small: u32 = 3;
    const argv_small: [3][]const u8 = ["program", "id", "name"];
    // This would call main() which should return error.UsageError
    // We can't test the main function directly due to undefined plumbing,
    // but we can test the decision logic functions
    
    // Test containsError function
    const response_with_error: []const u8 = "{\"errors\": [\"test error\"]}";
    assert(containsError(response_with_error) == true);
    
    const response_without_error: []const u8 = "{\"data\": {\"success\": true}}";
    assert(containsError(response_without_error) == false);
}

// Test: Query construction logic
test build_query_correct {
    const service_id: []const u8 = "56cd0d31-13be-45de-a6e7-cd7c47cb63d9";
    const dockerfile_name: []const u8 = "Dockerfile.hslm-train";
    
    // Test the query construction logic
    const query = buildGraphQLQuery(service_id, dockerfile_name);
    // For now, just test that it returns something
    assert(query.len > 0);
    
    // Test containsError function with various inputs
    assert(containsError("{\"errors\": [\"test error\"]}") == true);
    assert(containsError("{\"data\": {\"success\": true}}") == false);
    assert(containsError("") == false);
    assert(containsError("no_errors_here") == false);
    assert(containsError("\"errors\"") == true);
}

// Test: Status message construction
test build_status_messages {
    const service_id: []const u8 = "test-service-id";
    const dockerfile_name: []const u8 = "test-dockerfile";
    
    // Test that status messages contain expected content
    const messages = buildStatusMessages(service_id, dockerfile_name);
    assert(messages.len > 0);
    
    // Test containsError function with edge cases
    assert(containsError("{\"errors\": [{\"message\": \"test error\"}]}") == true);
    assert(containsError("{\"data\": {\"success\": true}, \"errors\": null}") == true);
    assert(containsError("{\"data\": {\"success\": true}}") == false);
}