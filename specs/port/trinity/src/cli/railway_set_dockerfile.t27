// Decision logic: Check if API response contains errors
fn containsError(response: []const u8) bool {
    // Simple string search for errors
    if (response.len < 8) return false;
    
    // Check for "errors" substring using basic comparison
    if (response.len >= 8) {
        if (response[0] == '"' and response[1] == 'e' and response[2] == 'r' 
            and response[3] == 'r' and response[4] == 'o' and response[5] == 'r' 
            and response[6] == 's' and response[7] == '"') {
            return true;
        }
    }
    
    // Check for "errors" at other positions
    if (response.len >= 9) {
        if (response[1] == '"' and response[2] == 'e' and response[3] == 'r' 
            and response[4] == 'r' and response[5] == 'o' and response[6] == 'r' 
            and response[7] == 's' and response[8] == '"') {
            return true;
        }
    }
    
    return false;
}

