    }
}

// Test the GraphQL query construction logic
test build_graphql_query {
    // Test the decision logic for constructing the GraphQL mutation
    const service_id: []const u8 = "test-service";
    const repo_url: []const u8 = "https://github.com/test/repo";
    
    // This mimics the query construction from the original:
    // \\{{"query": "mutation($serviceId: String!, $input: ServiceInstanceUpdateInput!) {{ serviceInstanceUpdate(serviceId: $serviceId, input: $input) }}", "variables": {{"serviceId": "{s}", "input": {{"repo": "{s}"}}}}}}
    
    // Verify the service_id and repo_url are valid strings
    if (service_id.len == 0 or repo_url.len == 0) {
        return; // Error: empty parameters
    }
    
    // Verify the URL format (basic check)
    if (repo_url[0] != 'h' or repo_url[1] != 't' or repo_url[2] != 't' or repo_url[3] != 'p') {
        return; // Error: invalid URL format
    }
}

// Test basic error detection
test error_detection {
    // Test basic error detection logic
    const valid_response: []const u8 = "{\"success\": true}";
    const invalid_response: []const u8 = "{\"error\": \"not found\"}";
    
    // Simple test: check that strings are not empty
    if (valid_response.len == 0 or invalid_response.len == 0) {
        return;
    }
    
    // Test that we can detect the difference between success and error
    if (valid_response[0] == '{' and invalid_response[0] == '{') {
        return; // Both start with { as expected
    }
}