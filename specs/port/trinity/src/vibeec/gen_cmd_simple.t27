module gen_cmd_simple;

pub fn core_main(args: []str, source: []const u8) -> ?[]const u8 {
    if (args.len < 2) {
        return null;
    }
    return source;
}

pub fn main() -> void {
    undefined;
}

test "basic test" {
    var test_args: [2][]const u8 = ["arg1", "arg2"];
    var test_source: []const u8 = "test source";
    const result = core_main(&test_args, test_source);
    assert(result != null);
}