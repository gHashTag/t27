module port::scripts::gen_w375;

const Result = struct {
    changed: bool,
    start: usize,
    end: usize,
    new_block: []const u8,
};

fn find_substring(s: []const u8, sub: []const u8, start: usize) usize {
    var i: usize = start;
    _ = &i;
    while (i < s.len) {
        var j: usize = 0;
        _ = &j;
        while (((j < sub.len) and ((i + j) < s.len)) and (s[i + j] == sub[j])) {
            j += 1;
        }
        if (j == sub.len) {
            return i;
        }
        i += 1;
    }
    return s.len;
}

fn substring(s: []const u8, start: usize, end: usize) []const u8 {
    return s[start .. end];
}

fn replace_all(s: []const u8, from: []const u8, to: []const u8) []const u8 {
    const MaxSize: usize = 4096;
    var buf: [MaxSize]u8 = undefined;
    _ = &buf;
    var buf_len: usize = 0;
    _ = &buf_len;
    var i: usize = 0;
    _ = &i;
    while (i < s.len) {
        var match: bool = true;
        _ = &match;
        if ((i + from.len) > s.len) {
            match = false;
        } else {
            var j: usize = 0;
            _ = &j;
            while (j < from.len) {
                if (s[i + j] != from[j]) {
                    match = false;
                    break;
                }
                j += 1;
            }
        }
        if (match) {
            var j: usize = 0;
            _ = &j;
            while ((j < to.len) and (buf_len < 4096)) {
                buf[buf_len] = to[j];
                buf_len += 1;
                j += 1;
            }
            i += from.len;
        } else {
            if (buf_len < 4096) {
                buf[buf_len] = s[i];
                buf_len += 1;
            }
            i += 1;
        }
    }
    return buf[0 .. buf_len];
}

fn append_w375(s: []const u8) Result {
    const wave_marker: []const u8 = "// Wave Loop 374";
    var last_start: usize = s.len;
    _ = &last_start;
    var last_end: usize = s.len;
    _ = &last_end;
    var block: []const u8 = .{};
    _ = &block;
    var pos: usize = 0;
    _ = &pos;
    while (true) {
        const idx = find_substring(s, wave_marker, pos);
        if (idx == s.len) {
            break;
        }
        const marker_end: usize = find_substring(s, "\n", idx);
        if (marker_end == s.len) {
            pos = idx + 1;
            continue;
        }
        const invariant_start: usize = find_substring(s, "invariant", marker_end + 1);
        if (invariant_start == s.len) {
            pos = idx + 1;
            continue;
        }
        const true_start: usize = find_substring(s, "true", invariant_start);
        if (true_start == s.len) {
            pos = idx + 1;
            continue;
        }
        const after_true: usize = true_start + 4;
        const has_newline: bool = (after_true < s.len) and (s[after_true] == '\n');
        if (!has_newline) {
            pos = idx + 1;
            continue;
        }
        const block_start: usize = idx;
        const block_end: usize = after_true + 1;
        last_start = block_start;
        last_end = block_end;
        block = substring(s, block_start, block_end);
        pos = block_end;
    }
    if (last_start == s.len) {
        return Result{ .changed = false, .start = 0, .end = 0, .new_block = @constCast(&[_]u8{}[0..0]) };
    }
    var new_block: []const u8 = block;
    _ = &new_block;
    new_block = replace_all(new_block, "Wave Loop 374", "Wave Loop 375");
    new_block = replace_all(new_block, "w374_", "w375_");
    new_block = replace_all(new_block, "W373 seal regeneration", "W374 seal regeneration");
    new_block = replace_all(new_block, "after W373", "after W374");
    new_block = replace_all(new_block, "WAVE_LOOP_373_COOPERATION.md", "WAVE_LOOP_374_COOPERATION.md");
    return Result{ .changed = true, .start = last_start, .end = last_end, .new_block = new_block };
}

test "append_w375_works" {
    const input: []const u8 = "// Wave Loop 374\ninvariant something true\n";
    const result = append_w375(input);
    assert_eq(result.changed, true);
    assert_eq(result.start, 0);
    assert_eq(result.end, 40);
    const expected_new_block: []const u8 = "// Wave Loop 375\ninvariant something true\n";
    assert_eq(std.mem.eql(u8, result.new_block, expected_new_block), true);
}

test "append_w375_skips_when_no_match" {
    const input: []const u8 = "// Some other text\n";
    _ = u8; // dead after const-inlining
    const result = append_w375(input);
    assert_eq(result.changed, false);
}

test "append_w375_skips_when_wave_not_374" {
    const input: []const u8 = "// Wave Loop 373\ninvariant something true\n";
    _ = u8; // dead after const-inlining
    const result = append_w375(input);
    assert_eq(result.changed, false);
}
