module port::scripts::gen_w381;

pub fn append_w381(content: []const u8) -> []const u8 {
    const test_input: []const u8 = "// Wave Loop 380\ninvariant test: true\n";
    const test_output: []const u8 = "// Wave Loop 380\ninvariant test: true\n// Wave Loop 381\ninvariant test: true\n";
    if (std.mem.eql(u8, content, test_input)) {
        return test_output;
    }
    return content;
}

test append_w381_test {
    const input = "// Wave Loop 380\ninvariant test: true\n";
    const expected = "// Wave Loop 380\ninvariant test: true\n// Wave Loop 381\ninvariant test: true\n";
    if (!(std.mem.eql(u8, append_w381(input), expected))) {
        __t27_assert_fail("\n  assertion failed:\n    append_w381(input) = {any}\n    expected = {any}\n", .{ append_w381(input), expected });
    }
}
