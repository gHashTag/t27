module port::scripts::ci::rings_matrix;

// Port of scripts/ci/rings_matrix.py - discover() and main().
//
// rings_matrix.py is the CI step that scans the rings/ directory for Rust
// ring crates (ring-*-rust directories containing a Cargo.toml), prints a
// JSON matrix of them and writes it to $GITHUB_OUTPUT. When the scan yields
// no rings at all the script exits with code 2 (not 1): "could not take a
// reading" is not a failed build.
//
// The port carries the decision logic only: the subprocess/filesystem
// plumbing (reading the directory, printing, env vars) becomes parameters
// or bodies that the calling workflow provides. Strings are []const u8,
// the matrix is a fixed-capacity array, and the verdict is an exit code
// (0 or 2).

// Entry for ring-*-rust crate discovery results
pub struct CrateEntry {
    crate: []const u8,
    path: []const u8,
}

pub fn discover(repo_root: []const u8, rings_exists: bool, child1: []const u8, child2: []const u8, child3: []const u8, child4: []const u8, cargo1: bool, cargo2: bool, cargo3: bool, cargo4: bool) []CrateEntry {
    var entries: [16]CrateEntry = undefined;
    var len: usize = 0;

    if (!rings_exists) {
        return entries[0..0];
    }

    // Check child1
    var starts_with_ring: bool = false;
    if (child1.len >= 10) {
        var j: usize = 0;
        while (j < 5) {  // len("ring-") = 5
            if (j >= child1.len or child1[j] != "ring-"[j]) {
                break;
            }
            j += 1;
        }
        starts_with_ring = j == 5;
    }

    var ends_with_rust: bool = false;
    if (child1.len >= 9) {
        var j: usize = 0;
        while (j < 5) {  // len("-rust") = 5
            const idx = child1.len - 5 + j;
            if (idx >= child1.len or child1[idx] != "-rust"[j]) {
                break;
            }
            j += 1;
        }
        ends_with_rust = j == 5;
    }

    if (starts_with_ring and ends_with_rust and cargo1) {
        var path_buffer: [100]u8 = undefined;
        var path_idx: usize = 0;

        const prefix = "rings/";
        var k: usize = 0;
        while (k < prefix.len) {
            path_buffer[path_idx] = prefix[k];
            path_idx += 1;
            k += 1;
        }

        k = 0;
        while (k < child1.len) {
            path_buffer[path_idx] = child1[k];
            path_idx += 1;
            k += 1;
        }

        entries[len] = CrateEntry {
            .crate = child1,
            .path = path_buffer[0..path_idx],
        };
        len += 1;
    }

    // Check child2
    starts_with_ring = false;
    if (child2.len >= 10) {
        var j: usize = 0;
        while (j < 5) {
            if (j >= child2.len or child2[j] != "ring-"[j]) {
                break;
            }
            j += 1;
        }
        starts_with_ring = j == 5;
    }

    ends_with_rust = false;
    if (child2.len >= 9) {
        var j: usize = 0;
        while (j < 5) {
            const idx = child2.len - 5 + j;
            if (idx >= child2.len or child2[idx] != "-rust"[j]) {
                break;
            }
            j += 1;
        }
        ends_with_rust = j == 5;
    }

    if (starts_with_ring and ends_with_rust and cargo2) {
        var path_buffer: [100]u8 = undefined;
        var path_idx: usize = 0;

        const prefix = "rings/";
        var k: usize = 0;
        while (k < prefix.len) {
            path_buffer[path_idx] = prefix[k];
            path_idx += 1;
            k += 1;
        }

        k = 0;
        while (k < child2.len) {
            path_buffer[path_idx] = child2[k];
            path_idx += 1;
            k += 1;
        }

        entries[len] = CrateEntry {
            .crate = child2,
            .path = path_buffer[0..path_idx],
        };
        len += 1;
    }

    // Check child3
    starts_with_ring = false;
    if (child3.len >= 10) {
        var j: usize = 0;
        while (j < 5) {
            if (j >= child3.len or child3[j] != "ring-"[j]) {
                break;
            }
            j += 1;
        }
        starts_with_ring = j == 5;
    }

    ends_with_rust = false;
    if (child3.len >= 9) {
        var j: usize = 0;
        while (j < 5) {
            const idx = child3.len - 5 + j;
            if (idx >= child3.len or child3[idx] != "-rust"[j]) {
                break;
            }
            j += 1;
        }
        ends_with_rust = j == 5;
    }

    if (starts_with_ring and ends_with_rust and cargo3) {
        var path_buffer: [100]u8 = undefined;
        var path_idx: usize = 0;

        const prefix = "rings/";
        var k: usize = 0;
        while (k < prefix.len) {
            path_buffer[path_idx] = prefix[k];
            path_idx += 1;
            k += 1;
        }

        k = 0;
        while (k < child3.len) {
            path_buffer[path_idx] = child3[k];
            path_idx += 1;
            k += 1;
        }

        entries[len] = CrateEntry {
            .crate = child3,
            .path = path_buffer[0..path_idx],
        };
        len += 1;
    }

    // Check child4
    starts_with_ring = false;
    if (child4.len >= 10) {
        var j: usize = 0;
        while (j < 5) {
            if (j >= child4.len or child4[j] != "ring-"[j]) {
                break;
            }
            j += 1;
        }
        starts_with_ring = j == 5;
    }

    ends_with_rust = false;
    if (child4.len >= 9) {
        var j: usize = 0;
        while (j < 5) {
            const idx = child4.len - 5 + j;
            if (idx >= child4.len or child4[idx] != "-rust"[j]) {
                break;
            }
            j += 1;
        }
        ends_with_rust = j == 5;
    }

    if (starts_with_ring and ends_with_rust and cargo4) {
        var path_buffer: [100]u8 = undefined;
        var path_idx: usize = 0;

        const prefix = "rings/";
        var k: usize = 0;
        while (k < prefix.len) {
            path_buffer[path_idx] = prefix[k];
            path_idx += 1;
            k += 1;
        }

        k = 0;
        while (k < child4.len) {
            path_buffer[path_idx] = child4[k];
            path_idx += 1;
            k += 1;
        }

        entries[len] = CrateEntry {
            .crate = child4,
            .path = path_buffer[0..path_idx],
        };
        len += 1;
    }

    // Selection sort by the whole crate name (Python's sorted() on the
    // "crate" key): the smallest remaining name goes to the front, so the
    // matrix order is the full lexicographic order of the crate names.
    var sort_i: usize = 0;
    while (sort_i < len) {
        var sort_j: usize = sort_i + 1;
        while (sort_j < len) {
            if (crate_less(entries[sort_j].crate, entries[sort_i].crate)) {
                const temp = entries[sort_i];
                entries[sort_i] = entries[sort_j];
                entries[sort_j] = temp;
            }
            sort_j += 1;
        }
        sort_i += 1;
    }

    return entries[0..len];
}

fn crate_less(a: []const u8, b: []const u8) bool {
    // Full lexicographic compare: true when a sorts before b. The matrix
    // is ordered by the whole crate name, not just its first byte.
    var i: usize = 0;
    while (i < a.len and i < b.len) {
        if (a[i] != b[i]) {
            return a[i] < b[i];
        }
        i += 1;
    }
    return a.len < b.len;
}

pub fn verdict_of(entries: []CrateEntry) u8 {
    // The exit code for one reading of the rings/ directory:
    // 0 when the matrix has at least one ring crate;
    // 2 (not 1) when the reading is empty - the scan could not take a
    // reading, which is not a failed build.
    if (entries.len == 0) {
        return 2;
    }
    return 0;
}

pub fn main() u8 {
    // The script's verdict for one reading of the rings/ directory: the
    // directory scan, the JSON print and the GITHUB_OUTPUT write are the
    // calling workflow's plumbing, so main here runs with the default
    // (no-rings) reading - the state the scan yields when it cannot run.
    // The ported decision is the exit code: 2 (not 1) when the reading is
    // empty, because "could not take a reading" is not a failed build.
    return verdict_of(discover("", false, "", "", "", "", false, false, false, false));
}

test discover_finds_rings {
    // Scan a rings/ directory with four entries: three ring-*-rust crates
    // each with a Cargo.toml, deliberately unsorted (ring-200 first,
    // ring-100 last). The matrix comes back ordered by the whole name.
    var result = discover("/repo", true, "ring-200-rust", "ring-50-rust", "ring-100-rust", "other-dir", true, true, true, false);

    assert(result.len == 3);
    // Ordered lexicographically by the whole crate name, not the first
    // byte: ring-100 first, ring-200 next, ring-50 last.
    assert(result[0].crate[5] == '1');
    assert(result[0].crate[6] == '0');
    assert(result[0].crate[7] == '0');
    assert(result[1].crate[5] == '2');
    assert(result[2].crate[5] == '5');
    // Each entry's path is "rings/" + crate: the separator at index 5,
    // the crate name from index 6.
    assert(result[0].path[5] == '/');
    assert(result[0].path[6] == '1');
}

test discover_empty_when_no_rings_dir {
    // No rings/ directory at all: the reading is empty, not an error.
    var result = discover("/repo", false, "", "", "", "", false, false, false, false);

    assert(result.len == 0);
}

test discover_skips_rings_without_cargo {
    // Of two ring-*-rust directories only the one with a Cargo.toml is a
    // reading: ring-200-rust is included, ring-100-rust (no manifest) is not.
    var result = discover("/repo", true, "ring-100-rust", "ring-200-rust", "", "", false, true, false, false);

    assert(result.len == 1);
    assert(result[0].crate[5] == '2');
    assert(result[0].path[6] == '2');
}

test discover_ignores_non_matching_children {
    // Children that are not ring-*-rust directories are ignored even when
    // the rings/ directory exists: a ring-* name without the -rust suffix,
    // a -rust name without the ring- prefix, a too-short name and a
    // non-matching name all yield no entries.
    var result = discover("/repo", true, "ring-200-rust-but-no-cargo", "rings-not-rust", "other-dir", "not-ring-dir", false, false, false, false);

    assert(result.len == 0);
}

test crate_less_orders_by_whole_name {
    // "ring-100-rust" sorts before "ring-50-rust" even though both start
    // with 'r': the whole crate name is compared, not just the first byte.
    assert_eq(crate_less("ring-100-rust", "ring-50-rust"), true);
    assert_eq(crate_less("ring-50-rust", "ring-100-rust"), false);
}

test crate_less_prefix_and_equal {
    // A shorter name that is a prefix of a longer one sorts first; equal
    // names compare false both ways.
    assert_eq(crate_less("ring-1", "ring-10-rust"), true);
    assert_eq(crate_less("ring-10-rust", "ring-10-rust"), false);
}

test verdict_empty_matrix_is_two {
    // An empty reading means "could not take a reading": the script exits
    // 2, not 1, because that is not a failed build.
    var entries: [1]CrateEntry = undefined;
    assert_eq(verdict_of(entries[0..0]), 2);
}

test verdict_nonempty_matrix_is_zero {
    // A reading with at least one ring crate is a success: exit 0.
    var entries: [1]CrateEntry = undefined;
    entries[0] = CrateEntry {
        .crate = "ring-100-rust",
        .path = "rings/ring-100-rust",
    };
    assert_eq(verdict_of(entries[0..1]), 0);
}

test main_default_reading_is_two {
    // With the default (no-rings) reading, the script exits 2: the scan
    // could not take a reading, which is not a failed build.
    assert_eq(main(), 2);
}

test main_verdict_matches_verdict_of {
    // main composes the pure decision over its default reading: the same
    // verdict verdict_of gives an empty matrix.
    assert_eq(main(), verdict_of(discover("", false, "", "", "", "", false, false, false, false)));
}
