module port::check_untrusted_javascript_interp;

// Port the decision logic, not the plumbing
// File operations and printing are undefined; in the generated code

const EXPR_PATTERN = "\\$\\{\\{\\s*([^}]+?)\\s*\\}\\}";
const GITHUB_TOKEN_PATTERN = "\\bgithub(?:\\.[A-Za-z_][A-Za-z0-9_]*)+";
const USES_PATTERN = "^\\s*-?\\s*uses:\\s*actions/github-script@[\\s#]+";
const SCRIPT_PATTERN = "^(\\s*)script:\\s*([|>].*)?$";

struct ScriptBlock {
    line_number: usize,
    script_text: []const u8,
}

pub fn script_blocks(text: []const u8, results: *ScriptBlock[100], max_results: *usize) -> void {
    var lines: [1000][]const u8 = undefined;
    var line_count: usize = 0;
    
    // Split text into lines
    var start: usize = 0;
    var i: usize = 0;
    while (i < text.len) {
        if (text[i] == '\n') {
            lines[line_count] = text[start..i];
            line_count += 1;
            start = i + 1;
        }
        i += 1;
    }
    if (start < text.len) {
        lines[line_count] = text[start..];
        line_count += 1;
    }
    
    var result_index: usize = 0;
    
    var current_i: usize = 0;
    while (current_i < line_count) {
        var line = lines[current_i];
        
        // Check if this line uses github-script
        var uses_match = false;
        var j: usize = 0;
        while (j < line.len) {
            if (line[j] == ' ' or line[j] == '\t') {
                j += 1;
            } else if (line.len - j >= 5 and line[j..j+5] == "uses:") {
                j += 5;
                // Skip whitespace
                while (j < line.len and (line[j] == ' ' or line[j] == '\t')) {
                    j += 1;
                }
                // Check for actions/github-script
                if (line.len - j >= 23 and line[j..j+23] == "actions/github-script@") {
                    uses_match = true;
                    break;
                }
            } else {
                break;
            }
        }
        
        if (!uses_match) {
            current_i += 1;
            continue;
        }
        
        // Found a github-script step, find script block
        var step_indent: usize = 0;
        while (step_indent < line.len and (line[step_indent] == ' ' or line[step_indent] == '\t')) {
            step_indent += 1;
        }
        
        var current_j: usize = current_i + 1;
        var script_found = false;
        var script_indent: usize = 0;
        var script_start_line: usize = 0;
        
        while (current_j < line_count) {
            var current_line = lines[current_j];
            var indent: usize = 0;
            while (indent < current_line.len and (current_line[indent] == ' ' or current_line[indent] == '\t')) {
                indent += 1;
            }
            
            // Check if we've reached the next step
            if (current_line.len > indent and current_line[indent] == '-') {
                var k: usize = indent + 1;
                while (k < current_line.len and (current_line[k] == ' ' or current_line[k] == '\t')) {
                    k += 1;
                }
                if (current_line.len - k >= 4 and current_line[k..k+4] == "uses:") {
                    break;
                }
            }
            
            // Check for script: line
            if (current_line.len >= 6 and current_line[0..6] == "script:") {
                script_found = true;
                script_indent = indent;
                script_start_line = current_j + 1;  // 1-based line number
                break;
            }
            
            current_j += 1;
        }
        
        if (script_found and result_index < max_results.*) {
            results[result_index].line_number = script_start_line;
            
            // Extract script body - simplified version
            var body: [1000]u8 = undefined;
            var body_index: usize = 0;
            var k: usize = current_j + 1;
            
            while (k < line_count) {
                var body_line = lines[k];
                var body_indent: usize = 0;
                while (body_indent < body_line.len and (body_line[body_indent] == ' ' or body_line[body_indent] == '\t')) {
                    body_indent += 1;
                }
                
                // Stop if we reach a line with less indentation
                if (body_line.len > body_indent and body_indent <= script_indent) {
                    break;
                }
                
                // Copy line to body
                var line_index: usize = 0;
                while (line_index < body_line.len) {
                    if (body_line[line_index] != '\r') {  // Remove carriage returns
                        body[body_index] = body_line[line_index];
                        body_index += 1;
                    }
                    line_index += 1;
                }
                
                // Add newline if not last line
                if (k < line_count - 1) {
                    body[body_index] = '\n';
                    body_index += 1;
                }
                
                k += 1;
            }
            
            results[result_index].script_text = body[0..body_index];
            result_index += 1;
        }
        
        current_i = current_j;
    }
    
    max_results.* = result_index;
}

pub fn main() -> i32 {
    // File operations and printing are undefined;
    return undefined;
}

test script_blocks_finds_script {
    var workflow_text: [5][]const u8 = [
        "- uses: actions/github-script@v4",
        "  script: |",
        "    console.log('hello world');",
        "    const x = 42;",
        "- uses: actions/checkout@v3"
    ];
    var results: [100]ScriptBlock = undefined;
    var count: usize = 0;
    
    script_blocks(&workflow_text, &results, &count);
    
    // Should find one script block
    assert(count == 1);
    assert(results[0].line_number == 2);
    assert(results[0].script_text[0..25] == "console.log('hello world');\n");
}

test script_blocks_basic {
    var workflow_text: [3][]const u8 = [
        "- uses: actions/github-script@v4",
        "  script: echo 'test'",
        "- uses: actions/checkout@v3"
    ];
    var results: [100]ScriptBlock = undefined;
    var count: usize = 0;
    
    script_blocks(&workflow_text, &results, &count);
    
    // Should find one script block
    assert(count == 1);
    assert(results[0].line_number == 1);
    assert(results[0].script_text[0..11] == "echo 'test'");
}