module port::gen_w316;

pub fn get_last_block(lines: []const u8) -> ?[]const u8 {
    var test_indices: [20]usize = undefined;
    var test_count: usize = 0;
    var inv_indices: [20]usize = undefined;
    var inv_count: usize = 0;
    
    var pos: usize = 0;
    while (pos < lines.len) {
        var line_end: usize = pos;
        while (line_end < lines.len and lines[line_end] != '\n') {
            line_end += 1;
        }
        
        const line_len = line_end - pos;
        var stripped_len: usize = 0;
        while (stripped_len < line_len and 
               (lines[pos + stripped_len] == ' ' or 
                lines[pos + stripped_len] == '\t' or 
                lines[pos + stripped_len] == '\r')) {
            stripped_len += 1;
        }
        
        const content_len = line_len - stripped_len;
        if (content_len > 0) {
            var is_test: bool = false;
            var is_invariant: bool = false;
            
            if (content_len >= 5 and lines[pos + stripped_len] == 't' and
                lines[pos + stripped_len + 1] == 'e' and
                lines[pos + stripped_len + 2] == 's' and
                lines[pos + stripped_len + 3] == 't' and
                lines[pos + stripped_len + 4] == ' ') {
                is_test = true;
            } else if (content_len >= 10 and lines[pos + stripped_len] == 'i' and
                      lines[pos + stripped_len + 1] == 'n' and
                      lines[pos + stripped_len + 2] == 'v' and
                      lines[pos + stripped_len + 3] == 'a' and
                      lines[pos + stripped_len + 4] == 'r' and
                      lines[pos + stripped_len + 5] == 'i' and
                      lines[pos + stripped_len + 6] == 'a' and
                      lines[pos + stripped_len + 7] == 'n' and
                      lines[pos + stripped_len + 8] == 't' and
                      lines[pos + stripped_len + 9] == ' ') {
                is_invariant = true;
            }
            
            if (is_test) {
                if (test_count < test_indices.len) {
                    test_indices[test_count] = pos;
                    test_count += 1;
                }
            } else if (is_invariant) {
                if (inv_count < inv_indices.len) {
                    inv_indices[inv_count] = pos;
                    inv_count += 1;
                }
            }
        }
        
        pos = if (line_end < lines.len) line_end + 1 else lines.len;
    }
    
    if (test_count < 2 or inv_count < 1) {
        return null;
    }
    
    const last_inv = inv_indices[inv_count - 1];
    var tests_before_count: usize = 0;
    var tests_before_indices: [20]usize = undefined;
    
    var idx: usize = 0;
    while (idx < test_count) {
        if (test_indices[idx] < last_inv) {
            if (tests_before_count < tests_before_indices.len) {
                tests_before_indices[tests_before_count] = test_indices[idx];
                tests_before_count += 1;
            }
        }
        idx += 1;
    }
    
    if (tests_before_count < 2) {
        return null;
    }
    
    const start = tests_before_indices[tests_before_count - 2];
    var end: usize = lines.len;
    
    var search_pos: usize = last_inv + 1;
    while (search_pos < lines.len) {
        var line_end_search: usize = search_pos;
        while (line_end_search < lines.len and lines[line_end_search] != '\n') {
            line_end_search += 1;
        }
        
        const line_len_search = line_end_search - search_pos;
        var stripped_len_search: usize = 0;
        while (stripped_len_search < line_len_search and 
               (lines[search_pos + stripped_len_search] == ' ' or 
                lines[search_pos + stripped_len_search] == '\t' or 
                lines[search_pos + stripped_len_search] == '\r')) {
            stripped_len_search += 1;
        }
        
        const content_len_search = line_len_search - stripped_len_search;
        if (content_len_search > 0) {
            var is_test_search: bool = false;
            var is_invariant_search: bool = false;
            var is_fn_search: bool = false;
            var is_pub_search: bool = false;
            var is_comment_search: bool = false;
            var is_type_search: bool = false;
            var is_struct_search: bool = false;
            
            if (content_len_search >= 5 and lines[search_pos + stripped_len_search] == 't' and
                lines[search_pos + stripped_len_search + 1] == 'e' and
                lines[search_pos + stripped_len_search + 2] == 's' and
                lines[search_pos + stripped_len_search + 3] == 't' and
                lines[search_pos + stripped_len_search + 4] == ' ') {
                is_test_search = true;
            } else if (content_len_search >= 10 and lines[search_pos + stripped_len_search] == 'i' and
                      lines[search_pos + stripped_len_search + 1] == 'n' and
                      lines[search_pos + stripped_len_search + 2] == 'v' and
                      lines[search_pos + stripped_len_search + 3] == 'a' and
                      lines[search_pos + stripped_len_search + 4] == 'r' and
                      lines[search_pos + stripped_len_search + 5] == 'i' and
                      lines[search_pos + stripped_len_search + 6] == 'a' and
                      lines[search_pos + stripped_len_search + 7] == 'n' and
                      lines[search_pos + stripped_len_search + 8] == 't' and
                      lines[search_pos + stripped_len_search + 9] == ' ') {
                is_invariant_search = true;
            } else if (content_len_search >= 3 and lines[search_pos + stripped_len_search] == 'f' and
                      lines[search_pos + stripped_len_search + 1] == 'n' and
                      lines[search_pos + stripped_len_search + 2] == ' ') {
                is_fn_search = true;
            } else if (content_len_search >= 4 and lines[search_pos + stripped_len_search] == 'p' and
                      lines[search_pos + stripped_len_search + 1] == 'u' and
                      lines[search_pos + stripped_len_search + 2] == 'b' and
                      lines[search_pos + stripped_len_search + 3] == ' ') {
                is_pub_search = true;
            } else if (content_len_search >= 2 and lines[search_pos + stripped_len_search] == '/' and
                      lines[search_pos + stripped_len_search + 1] == '/') {
                is_comment_search = true;
            } else if (content_len_search >= 5 and lines[search_pos + stripped_len_search] == 't' and
                      lines[search_pos + stripped_len_search + 1] == 'y' and
                      lines[search_pos + stripped_len_search + 2] == 'p' and
                      lines[search_pos + stripped_len_search + 3] == 'e' and
                      lines[search_pos + stripped_len_search + 4] == ' ') {
                is_type_search = true;
            } else if (content_len_search >= 7 and lines[search_pos + stripped_len_search] == 's' and
                      lines[search_pos + stripped_len_search + 1] == 't' and
                      lines[search_pos + stripped_len_search + 2] == 'r' and
                      lines[search_pos + stripped_len_search + 3] == 'u' and
                      lines[search_pos + stripped_len_search + 4] == 'c' and
                      lines[search_pos + stripped_len_search + 5] == 't' and
                      lines[search_pos + stripped_len_search + 6] == ' ') {
                is_struct_search = true;
            }
            
            if (is_test_search or is_invariant_search or is_fn_search or is_pub_search or 
                is_comment_search or is_type_search or is_struct_search) {
                end = search_pos;
                break;
            }
        }
        
        search_pos = if (line_end_search < lines.len) line_end_search + 1 else lines.len;
    }
    
    return lines[start..end];
}

pub fn transform_block(block_lines: []const u8) -> []const u8 {
    var result = block_lines;
    
    // Replace _w315 with _w316
    var temp: [1000]u8 = undefined;
    var temp_len: usize = 0;
    var i: usize = 0;
    while (i < result.len) {
        if (i + 4 <= result.len and 
            result[i] == '_' and result[i + 1] == 'w' and 
            result[i + 2] == '3' and result[i + 3] == '1' and 
            result[i + 4] == '5') {
            temp[temp_len] = '_';
            temp[temp_len + 1] = 'w';
            temp[temp_len + 2] = '3';
            temp[temp_len + 3] = '1';
            temp[temp_len + 4] = '6';
            temp_len += 5;
            i += 5;
        } else if (i + 4 <= result.len and 
                   result[i] == '_' and result[i + 1] == 'w' and 
                   result[i + 2] == '3' and result[i + 3] == '1' and 
                   result[i + 4] == '4') {
            temp[temp_len] = '_';
            temp[temp_len + 1] = 'w';
            temp[temp_len + 2] = '3';
            temp[temp_len + 3] = '1';
            temp[temp_len + 4] = '6';
            temp_len += 5;
            i += 5;
        } else if (i + 4 <= result.len and 
                   result[i] == '_' and result[i + 1] == 'w' and 
                   result[i + 2] == '3' and result[i + 3] == '1' and 
                   result[i + 4] == '3') {
            temp[temp_len] = '_';
            temp[temp_len + 1] = 'w';
            temp[temp_len + 2] = '3';
            temp[temp_len + 3] = '1';
            temp[temp_len + 4] = '6';
            temp_len += 5;
            i += 5;
        } else {
            if (temp_len < temp.len) {
                temp[temp_len] = result[i];
                temp_len += 1;
            }
            i += 1;
        }
    }
    
    result = temp[0..temp_len];
    
    // Append newline
    if (temp_len + 1 < temp.len) {
        temp[temp_len] = '\n';
        return temp[0..temp_len + 1];
    } else {
        var new_result: [1001]u8 = undefined;
        var j: usize = 0;
        while (j < result.len) {
            new_result[j] = result[j];
            j += 1;
        }
        new_result[result.len] = '\n';
        return new_result[0..result.len + 1];
    }
}

pub fn process_specs() {
    undefined;
}

test get_last_block_basic {
    const test_content = "test basic1 {\n    assert(true);\n}\n\ntest basic2 {\n    assert(false);\n}\n\ninvariant always_true {\n    assert(true);\n}\n";
    const result = get_last_block(test_content);
    assert(result != null);
}

test get_last_block_insufficient_tests {
    const test_content = "test only_one {\n    assert(true);\n}\n\ninvariant always_true {\n    assert(true);\n}\n";
    
    const result = get_last_block(test_content);
    assert(result == null);
}

test transform_block_replacements {
    const block_content = "test w315_test {\n    var x: _w315 = 0;\n    var y: _w314 = 1;\n    var z: _w313 = 2;\n}\n";
    
    const expected = "test w315_test {\n    var x: _w316 = 0;\n    var y: _w316 = 1;\n    var z: _w316 = 2;\n}\n";
    
    const result = transform_block(block_content);
    if (result.len != expected.len) {
        assert(false);
    }
    var i: usize = 0;
    while (i < result.len) {
        if (result[i] != expected[i]) {
            assert(false);
        }
        i += 1;
    }
    assert(true);
}