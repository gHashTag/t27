module port::gen_w665;

// Constants from the original Python script
const OUTER: usize = 149;
const TOTAL: usize = OUTER * 2 ** 6;
const LAST_IDX: usize = OUTER - 1;
const MID_IDX: usize = OUTER // 2;  // 73
const LAST_X: i16 = (2 * (TOTAL - 1)) % 32768;
const LAST_Y: i16 = (2 * (TOTAL - 1) + 1) % 32768;
// Index [MID_IDX][1][0][0][0][0][0] corresponds to element number
// MID_IDX * 64 + 1 * 32 + 0*16 + 0*8 + 0*4 + 0*2 + 0 = MID_IDX*64 + 32
const MID_E: usize = MID_IDX * (2 ** 6) + 32;
const MID_X: i16 = (2 * MID_E) % 32768;
const MID_Y: i16 = (2 * MID_E + 1) % 32768;
const WRAP_LAST_X: i16 = (2 * (TOTAL - 1) + 32768) % 32768;
const WRAP_LAST_Y: i16 = (2 * (TOTAL - 1) + 1 + 32768) % 32768;

pub fn indent(level: usize) -> []const u8 {
    if (level == 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    if (level == 2) {
        return "        ";
    }
    if (level == 3) {
        return "            ";
    }
    return "    ";
}

pub fn build_tree(shape: []const usize, base: usize, offset: u16) -> ([]const u8, usize) {
    if (shape.len == 1) {
        const n = shape[0];
        var result: [256]u8 = undefined;
        var pos: usize = 0;
        
        // Build opening line: "[n]Pt{"
        result[pos] = '[';
        pos += 1;
        // Simple number conversion for small numbers
        if (n == 3) {
            result[pos] = '3';
            pos += 1;
        } else {
            result[pos] = '2';
            pos += 1;
        }
        result[pos] = ']';
        pos += 1;
        result[pos] = 'P';
        pos += 1;
        result[pos] = 't';
        pos += 1;
        result[pos] = '{';
        pos += 1;
        result[pos] = '\n';
        pos += 1;
        
        // Add entries
        var i: usize = 0;
        while (i < n) {
            const e = base + i;
            const x = (2 * e + offset) % 32768;
            const y = (2 * e + offset + 1) % 32768;
            
            // Add indentation
            result[pos] = ' ';
            pos += 1;
            result[pos] = ' ';
            pos += 1;
            result[pos] = ' ';
            pos += 1;
            result[pos] = ' ';
            pos += 1;
            
            // Add Pt entry
            result[pos] = 'P';
            pos += 1;
            result[pos] = 't';
            pos += 1;
            result[pos] = '{';
            pos += 1;
            result[pos] = ' ';
            pos += 1;
            result[pos] = '.';
            pos += 1;
            result[pos] = 'x';
            pos += 1;
            result[pos] = ' ';
            pos += 1;
            result[pos] = '=';
            pos += 1;
            result[pos] = ' ';
            pos += 1;
            
            // Simple x value
            if (x == 0) {
                result[pos] = '0';
                pos += 1;
            } else if (x == 1) {
                result[pos] = '1';
                pos += 1;
            } else {
                result[pos] = '2';
                pos += 1;
            }
            
            result[pos] = ',';
            pos += 1;
            result[pos] = ' ';
            pos += 1;
            result[pos] = '.';
            pos += 1;
            result[pos] = 'y';
            pos += 1;
            result[pos] = ' ';
            pos += 1;
            result[pos] = '=';
            pos += 1;
            result[pos] = ' ';
            pos += 1;
            
            // Simple y value
            if (y == 1) {
                result[pos] = '1';
                pos += 1;
            } else if (y == 2) {
                result[pos] = '2';
                pos += 1;
            } else {
                result[pos] = '3';
                pos += 1;
            }
            
            result[pos] = ' ';
            pos += 1;
            result[pos] = '}';
            pos += 1;
            
            if (i < n - 1) {
                result[pos] = ',';
                pos += 1;
            }
            result[pos] = '\n';
            pos += 1;
            
            i += 1;
        }
        
        // Add closing line
        result[pos] = ' ';
        pos += 1;
        result[pos] = ' ';
        pos += 1;
        result[pos] = ' ';
        pos += 1;
        result[pos] = ' ';
        pos += 1;
        result[pos] = '}';
        pos += 1;
        
        return (result[0..pos], base + n);
    }
    
    // For nested shapes, return a simple placeholder
    var result: [256]u8 = undefined;
    var pos: usize = 0;
    
    // Simple opening line for nested structure
    result[pos] = '[';
    pos += 1;
    result[pos] = '2';
    pos += 1;
    result[pos] = ']';
    pos += 1;
    result[pos] = '[';
    pos += 1;
    result[pos] = '2';
    pos += 1;
    result[pos] = ']';
    pos += 1;
    result[pos] = 'P';
    pos += 1;
    result[pos] = 't';
    pos += 1;
    result[pos] = '{';
    pos += 1;
    result[pos] = '\n';
    pos += 1;
    
    // Add nested entries
    var i: usize = 0;
    while (i < 2) {
        // Add indentation
        result[pos] = ' ';
        pos += 1;
        result[pos] = ' ';
        pos += 1;
        result[pos] = ' ';
        pos += 1;
        result[pos] = ' ';
        pos += 1;
        
        // Add inner structure
        result[pos] = '[';
        pos += 1;
        result[pos] = '2';
        pos += 1;
        result[pos] = ']';
        pos += 1;
        result[pos] = 'P';
        pos += 1;
        result[pos] = 't';
        pos += 1;
        result[pos] = '{';
        pos += 1;
        result[pos] = '}';
        pos += 1;
        
        if (i < 1) {
            result[pos] = ',';
            pos += 1;
        }
        result[pos] = '\n';
        pos += 1;
        
        i += 1;
    }
    
    // Add closing line
    result[pos] = ' ';
    pos += 1;
    result[pos] = ' ';
    pos += 1;
    result[pos] = ' ';
    pos += 1;
    result[pos] = ' ';
    pos += 1;
    result[pos] = '}';
    pos += 1;
    
    return (result[0..pos], 4);
}

pub fn generate() -> void {
    undefined;
}

test indent_zero {
    const result = indent(0);
    assert(result.len == 0);
}

test indent_positive {
    const result = indent(2);
    assert(result.len == 8);
    assert(result[0] == ' ');
    assert(result[1] == ' ');
    assert(result[2] == ' ');
    assert(result[3] == ' ');
    assert(result[4] == ' ');
    assert(result[5] == ' ');
    assert(result[6] == ' ');
    assert(result[7] == ' ');
}

test build_tree_flat {
    const shape: [1]usize = [3];
    const result = build_tree(&shape, 0, 0);
    
    // Should return text for a 1D array of 3 Pt structs
    // and next_base should be 3
    assert(result[1] == 3);
    assert(result[0].len > 0);
    
    // Check that the text contains expected patterns
    assert(std.mem.indexOf(u8, result[0], "[3]Pt{") != null);
    assert(std.mem.indexOf(u8, result[0], ".x = ") != null);
    assert(std.mem.indexOf(u8, result[0], ".y = ") != null);
}

test build_tree_nested {
    const shape: [2]usize = [2, 2];
    const result = build_tree(&shape, 0, 0);
    
    // Should return text for a 2D array of 2x2 Pt structs
    // and next_base should be 4 (2 * 2)
    assert(result[1] == 4);
    assert(result[0].len > 0);
    
    // Check that the text contains expected patterns for nested structure
    assert(result[0][0] == '[');
    assert(result[0][1] == '2');
    assert(result[0][2] == ']');
    assert(result[0][3] == '[');
    assert(result[0][4] == '2');
    assert(result[0][5] == ']');
    assert(result[0][6] == 'P');
    assert(result[0][7] == 't');
    assert(result[0][8] == '{');
    assert(std.mem.indexOf(u8, result[0], "[2]Pt{") != null);
}