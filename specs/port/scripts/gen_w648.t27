module port::gen_w648;

// Constants from the original
const OUTER: i32 = 115;
const TOTAL: i32 = OUTER * 2 ** 6;
const LAST_IDX: i32 = OUTER - 1;
const MID_IDX: i32 = OUTER // 2;  // 57
const LAST_X: i32 = (2 * (TOTAL - 1)) % 32768;
const LAST_Y: i32 = (2 * (TOTAL - 1) + 1) % 32768;
const MID_E: i32 = MID_IDX * (2 ** 6) + 32;
const MID_X: i32 = (2 * MID_E) % 32768;
const MID_Y: i32 = (2 * MID_E + 1) % 32768;
const WRAP_LAST_X: i32 = (2 * (TOTAL - 1) + 32768) % 32768;
const WRAP_LAST_Y: i32 = (2 * (TOTAL - 1) + 1 + 32768) % 32768;

pub fn indent(level: i32) -> []const u8 {
    var result: [256]u8 = undefined;
    var i: usize = 0;
    while (i < level) {
        if (i * 4 + 3 < result.len) {
            result[i * 4] = ' ';
            result[i * 4 + 1] = ' ';
            result[i * 4 + 2] = ' ';
            result[i * 4 + 3] = ' ';
        }
        i += 1;
    }
    return result[0..level * 4];
}

pub fn build_tree(shape: []const i32, base: i32, offset: i32) -> struct { text: []const u8, next_base: i32 } {
    if (shape.len == 1) {
        const n = shape[0];
        
        // Simple case: return a basic structure
        if (n == 0) {
            return .{ .text = "[]Pt{}", .next_base = base };
        }
        
        // For n=1, return a simple point
        if (n == 1) {
            const e = base;
            const x = (2 * e + offset) % 32768;
            const y = (2 * e + offset + 1) % 32768;
            var result: [100]u8 = undefined;
            var pos = int_to_str(1, result[0..]);
            if (pos + 1 < result.len) result[pos] = ']'; pos += 1;
            if (pos + 1 < result.len) result[pos] = 'P'; pos += 1;
            if (pos + 1 < result.len) result[pos] = 't'; pos += 1;
            if (pos + 1 < result.len) result[pos] = '{'; pos += 1;
            if (pos + 1 < result.len) result[pos] = ' '; pos += 1;
            if (pos + 1 < result.len) result[pos] = '.'; pos += 1;
            if (pos + 1 < result.len) result[pos] = 'x'; pos += 1;
            if (pos + 1 < result.len) result[pos] = ' '; pos += 1;
            pos += int_to_str(x, result[pos..]);
            if (pos + 1 < result.len) result[pos] = ' '; pos += 1;
            if (pos + 1 < result.len) result[pos] = '.'; pos += 1;
            if (pos + 1 < result.len) result[pos] = 'y'; pos += 1;
            if (pos + 1 < result.len) result[pos] = ' '; pos += 1;
            if (pos + 1 < result.len) result[pos] = '}'; pos += 1;
            return .{ .text = result[0..pos], .next_base = base + n };
        }
        
        // For n>1, build a comma-separated list
        var result: [1000]u8 = undefined;
        var pos: usize = 0;
        
        // Opening bracket
        if (pos + 1 < result.len) {
            result[pos] = '[';
            pos += 1;
        }
        pos += int_to_str(n, result[pos..]);
        if (pos + 3 < result.len) {
            result[pos] = ']';
            result[pos + 1] = 'P';
            result[pos + 2] = 't';
            result[pos + 3] = '{';
            pos += 4;
        }
        
        // Add points
        var i: i32 = 0;
        while (i < n) {
            const e = base + i;
            const x = (2 * e + offset) % 32768;
            const y = (2 * e + offset + 1) % 32768;
            
            if (i > 0 && pos + 1 < result.len) {
                result[pos] = ',';
                pos += 1;
            }
            
            if (pos + 5 < result.len) {
                result[pos] = '\n';
                result[pos + 1] = ' ';
                result[pos + 2] = ' ';
                result[pos + 3] = ' ';
                result[pos + 4] = ' ';
                pos += 5;
            }
            
            // Add point
            if (pos + 3 < result.len) {
                result[pos] = 'P';
                result[pos + 1] = 't';
                result[pos + 2] = '{';
                pos += 3;
            }
            
            if (pos + 4 < result.len) {
                result[pos] = ' ';
                result[pos + 1] = '.';
                result[pos + 2] = 'x';
                result[pos + 3] = ' ';
                pos += 4;
            }
            
            pos += int_to_str(x, result[pos..]);
            
            if (pos + 4 < result.len) {
                result[pos] = ' ';
                result[pos + 1] = '.';
                result[pos + 2] = 'y';
                result[pos + 3] = ' ';
                pos += 4;
            }
            
            pos += int_to_str(y, result[pos..]);
            
            if (pos + 1 < result.len) {
                result[pos] = '}';
                pos += 1;
            }
            
            i += 1;
        }
        
        // Closing
        if (pos + 5 < result.len) {
            result[pos] = '\n';
            result[pos + 1] = ' ';
            result[pos + 2] = ' ';
            result[pos + 3] = ' ';
            result[pos + 4] = ' ';
            pos += 5;
        }
        
        if (pos + 1 < result.len) {
            result[pos] = '}';
            pos += 1;
        }
        
        return .{ .text = result[0..pos], .next_base = base + n };
    }
    
    // Multi-dimensional case - just return a simple structure for now
    const n = shape[0];
    var result: [100]u8 = undefined;
    var pos: usize = 0;
    
    if (pos + 1 < result.len) {
        result[pos] = '[';
        pos += 1;
    }
    pos += int_to_str(n, result[pos..]);
    if (pos + 1 < result.len) result[pos] = ']'; pos += 1;
    if (pos + 1 < result.len) result[pos] = 'P'; pos += 1;
    if (pos + 1 < result.len) result[pos] = 't'; pos += 1;
    if (pos + 1 < result.len) result[pos] = '{'; pos += 1;
    if (pos + 1 < result.len) result[pos] = '}'; pos += 1;
    
    return .{ .text = result[0..pos], .next_base = base + n };
}

// Helper functions
fn int_to_str(n: i32, buffer: []u8) -> usize {
    var pos: usize = 0;
    var abs_n = if (n < 0) -n else n;
    var digits: [10]u8 = undefined;
    var digit_count: usize = 0;
    
    if (abs_n == 0) {
        if (pos + 1 < buffer.len) {
            buffer[pos] = '0';
            pos += 1;
        }
        return pos;
    }
    
    while (abs_n > 0) {
        digits[digit_count] = '0' + (abs_n % 10);
        abs_n = abs_n / 10;
        digit_count += 1;
    }
    
    if (n < 0 && pos + 1 < buffer.len) {
        buffer[pos] = '-';
        pos += 1;
    }
    
    var i: usize = digit_count;
    while (i > 0) {
        i -= 1;
        if (pos + 1 < buffer.len) {
            buffer[pos] = digits[i];
            pos += 1;
        }
    }
    
    return pos;
}

fn join_dims(shape: []const i32) -> []const u8 {
    var result: [100]u8 = undefined;
    var pos: usize = 0;
    
    if (pos + 1 < result.len) {
        result[pos] = '[';
        pos += 1;
    }
    
    var i: usize = 0;
    while (i < shape.len) {
        if (i > 0 && pos + 1 < result.len) {
            result[pos] = ']';
            pos += 1;
            if (pos + 1 < result.len) {
                result[pos] = '[';
                pos += 1;
            }
        }
        
        const num_str = int_to_str(shape[i], result[pos..]);
        pos += num_str;
        i += 1;
    }
    
    return result[0..pos];
}

pub fn generate() -> void {
    undefined;
}

// Tests for the pure functions
test indent_basic {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test indent_negative {
    assert(indent(-1) == "");  // Should handle negative gracefully
    assert(indent(-5) == "");  // Should handle negative gracefully
}

test build_tree_flat {
    const shape = [3];
    const result = build_tree(shape, 10, 0);
    
    // Should generate a flat array with 3 points
    // Points: (20, 21), (22, 23), (24, 25)
    assert(result.next_base == 13);  // base + n = 10 + 3
}

test build_tree_nested {
    const shape = [2, 2];
    const result = build_tree(shape, 0, 0);
    
    // Should generate a 2x2 nested structure
    assert(result.next_base == 4);  // base + n = 0 + 2
    // Result should contain the nested structure
    assert(result.text.len > 0);
    assert(result.text[0] == '[');  // Should start with opening bracket
}

test build_tree_offset {
    const shape = [2];
    const result1 = build_tree(shape, 0, 0);
    const result2 = build_tree(shape, 0, 1);
    
    // Same shape but different offset should produce different results
    // result1: (0,1), (2,3)
    // result2: (1,2), (3,4)
    assert(result1.text != result2.text);
}