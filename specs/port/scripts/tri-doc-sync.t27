// Port of scripts/tri-doc-sync.py (gHashTag/t27, 80 lines) to .t27.
//
// The original is a CLI wrapper around the NotebookLM documentation sync:
// it parses --file/--title/--pattern/--repo-root/--dry-run, then either
// uploads one file or batch-syncs a pattern, and exits 0 or 1.
//
// Port the decision, not the plumbing: the NotebookLM client (client_new,
// notebook_create), the network calls (doc_upload_notebooklm, doc_sync_all),
// the prints and the argparse call stay with the caller. Here live the
// decisions main() makes, as pure functions the tests reach: which title an
// upload uses, where pathlib finds a file's stem, which exit code each
// branch returns, and main()'s verdict given the flags and the answers the
// plumbing observed.

module port::scripts::tri_doc_sync;

// Python's exit codes: `return 0` on success, `return 1` on failure
// (lines 36, 55, 58, 69 and 75 of the original).
const EXIT_OK: i32 = 0;
const EXIT_FAIL: i32 = 1;

// Python's `if args.file:` (line 32) is false for None and for an empty
// string alike, so an unset flag and `--file ""` behave the same: here
// "" means unset. The same truthiness picks the dry-run print (lines 32-35).
pub fn flag_is_set(value: []const u8) -> bool {
    return value != "";
}

// pathlib's Path(p).stem, as a span: the stem of p is p[start..end] for the
// (start, end) this returns. The name starts after the last '/'; a dot only
// ends the stem once a non-dot character precedes it inside the basename,
// so ".hidden" keeps its leading dot, the way pathlib skips leading dots
// when it looks for an extension. One trailing slash is dropped, as pathlib
// drops it; collapsing of repeated slashes is not ported.
pub fn stem_span(path: []const u8) -> (usize, usize) {
    var n: usize = path.len;
    var ends_slash: bool = false;
    for c in path {
        ends_slash = c == '/';
    }
    if (ends_slash) {
        n -= 1;
    }
    var start: usize = 0;
    var ext_dot: usize = n;
    var seen_nondot: bool = false;
    var idx: usize = 0;
    for c in path {
        if (idx < n) {
            if (c == '/') {
                start = idx + 1;
                ext_dot = n;
                seen_nondot = false;
            } else {
                if (c == '.') {
                    if (seen_nondot) {
                        ext_dot = idx;
                    }
                } else {
                    seen_nondot = true;
                }
            }
        }
        idx += 1;
    }
    var end: usize = n;
    if (ext_dot < n) {
        end = ext_dot;
    }
    return (start, end);
}

pub fn file_stem(path: []const u8) -> []const u8 {
    const (s, e) = stem_span(path);
    return path[s..e];
}

// Python lines 42-45: for a single-file upload without --title, the title
// becomes the file's stem. An unset or empty --title falls back to it.
pub fn title_used(title: []const u8, file: []const u8) -> []const u8 {
    if (title == "") {
        return file_stem(file);
    }
    return title;
}

// Python lines 47-58: doc_upload_notebooklm hands back a source id; the
// run exits 0 when one came back and 1 when it did not.
pub fn upload_exit(source_id: []const u8) -> i32 {
    if (source_id == "") {
        return EXIT_FAIL;
    }
    return EXIT_OK;
}

// Python lines 61-69: doc_sync_all hands back counts (synced, failed); the
// verdict only reads `failed`. The batch branch prints the failed count when
// it is positive and returns 0 either way: batch failures never fail the run.
pub fn batch_exit(failed: usize) -> i32 {
    if (failed > 0) {
        // Line 68 prints the failed count here; the branch still returns 0.
        return EXIT_OK;
    }
    return EXIT_OK;
}

// The verdict of the original main() (lines 19-75), with the plumbing
// replaced by what the caller observed: `source_id` is the id returned by
// doc_upload_notebooklm for a single upload ("" when none came back),
// `failed` is doc_sync_all's failed count for a batch sync, and `errored`
// stands for the try/except around the NotebookLM calls. --pattern and
// --repo-root only reach doc_sync_all and the dry-run print, so they do not
// move the verdict; --title reaches the upload through title_used.
pub fn main(dry_run: bool, file: []const u8, source_id: []const u8, failed: usize, errored: bool) -> i32 {
    if (dry_run) {
        // Lines 31-36: a dry run returns 0 before any client is created,
        // whatever else was asked.
        return EXIT_OK;
    }
    if (errored) {
        // Lines 71-75: any exception out of the plumbing exits 1.
        return EXIT_FAIL;
    }
    if (flag_is_set(file)) {
        // Lines 42-58: single-file upload.
        return upload_exit(source_id);
    }
    // Lines 59-69: batch sync, with or without failures.
    return batch_exit(failed);
}

test flag_is_set_is_python_truthiness {
    assert(flag_is_set("README.md"));
    assert(!flag_is_set(""));
}

test title_falls_back_to_stem {
    // --title unset: Path(args.file).stem becomes the title.
    const t = title_used("", "docs/readme.md");
    assert(t == "readme");
}

test title_kept_when_given {
    const t = title_used("Sync notes", "docs/readme.md");
    assert(t == "Sync notes");
}

test stem_matches_pathlib {
    assert(file_stem("readme.md") == "readme");
    assert(file_stem("docs/readme.md") == "readme");
    assert(file_stem("archive.tar.gz") == "archive.tar");
    assert(file_stem("Makefile") == "Makefile");
    assert(file_stem("dir.v2/changes") == "changes");
}

test stem_keeps_leading_dot {
    // pathlib: a leading dot is not an extension.
    assert(file_stem(".hidden") == ".hidden");
    assert(file_stem("docs/.hidden") == ".hidden");
}

test stem_span_positions {
    const (s, e) = stem_span("docs/readme.md");
    assert(s == 5);
    assert(e == 11);
}

test stem_drops_trailing_slash {
    assert(file_stem("docs/readme/") == "readme");
}

test upload_exit_codes {
    assert(upload_exit("src_abc123") == 0);
    assert(upload_exit("") == 1);
}

test batch_exit_zero_even_with_failures {
    // Line 69: the batch branch returns 0 whatever the failed count is.
    assert(batch_exit(0) == 0);
    assert(batch_exit(7) == 0);
}

test main_dry_run_exits_zero {
    // A dry run exits 0 with a file, without one, and before any plumbing
    // error would be seen: the original returns before its try block.
    assert(main(true, "README.md", "", 0, false) == 0);
    assert(main(true, "", "", 0, false) == 0);
    assert(main(true, "", "", 0, true) == 0);
}

test main_single_upload_verdict {
    assert(main(false, "README.md", "src_1", 0, false) == 0);
    assert(main(false, "README.md", "", 0, false) == 1);
}

test main_batch_sync_verdict {
    // An empty --file falls through to the batch branch, as Python's
    // truthiness does; the batch branch exits 0 even when files failed.
    assert(main(false, "", "", 0, false) == 0);
    assert(main(false, "", "", 3, false) == 0);
}

test main_error_exits_one {
    assert(main(false, "README.md", "", 0, true) == 1);
}
