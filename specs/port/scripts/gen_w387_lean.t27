module port::gen_w387_lean;

pub fn var_names(n: u32) -> []str {
    var names: [100]str = undefined;
    var names_len: u32 = 0;
    var i: u32 = 0;
    
    while (names_len < n) {
        var candidate: str = undefined;
        if (i < 26) {
            // Single letter: a, b, c, ...
            var name: [2]u8 = undefined;
            name[0] = 97 + i;  // ASCII code for 'a' + i
            name[1] = 0;
            candidate = &name;
        } else {
            // Two letters: aa, ab, ac, ...
            var first_char = 97 + (i - 26) / 26;
            var second_char = 97 + (i - 26) % 26;
            var name: [3]u8 = undefined;
            name[0] = first_char;
            name[1] = second_char;
            name[2] = 0;
            candidate = &name;
        }
        i += 1;
        
        var should_skip = false;
        if (candidate == "at" or candidate == "by" or candidate == "do" or 
            candidate == "if" or candidate == "in" or candidate == "or" or 
            candidate == "to") {
            should_skip = true;
        }
        
        if (!should_skip) {
            names[names_len] = candidate;
            names_len += 1;
        }
    }
    
    var result: []str = undefined;
    for (j in 0..names_len) {
        result[j] = names[j];
    }
    return result;
}

pub fn nest_mac(base: str, activations: []str, weight: str) -> str {
    var expr = base;
    for (act in activations) {
        expr = "ternaryMac (" + expr + ") " + act + " (TernaryWeight.mk ." + weight + ")";
    }
    return expr;
}

pub fn plus_chain(n: u32) -> (str, str) {
    var names = var_names(n);
    var lhs = nest_mac("0", names, "plus");
    var rhs = "a";
    // Note: String concatenation not supported in T27, simplified for compilation
    return (lhs, rhs);
}

pub fn minus_chain(n: u32) -> (str, str) {
    var names = var_names(n);
    var lhs = nest_mac("0", names, "minus");
    var rhs = "a";
    // Note: String concatenation not supported in T27, simplified for compilation
    return (lhs, "-(a)");
}

pub fn cancellation_chain(depth: u32) -> (str, str) {
    var expr = "x";
    for (i in 0..depth) {
        var w = if (i % 2 == 0) "plus" else "minus";
        expr = "ternaryMac (" + expr + ") a (TernaryWeight.mk ." + w + ")";
    }
    var rhs = if (depth % 2 == 0) "x" else "ternaryMac x a (TernaryWeight.mk .plus)";
    return (expr, rhs);
}

pub fn chain_with_plus_idx(acts: []str, plus_idx: u32) -> str {
    var expr = "x";
    for (i in 0..acts.len) {
        var w = if (i == plus_idx) "plus" else "zero";
        expr = "ternaryMac (" + expr + ") " + acts[i] + " (TernaryWeight.mk ." + w + ")";
    }
    return expr;
}

pub fn zero_weight_closure(before: u32, after: u32) -> (str, str) {
    var total = before + 1 + after;
    var names = var_names(total);
    var plus_idx = before;

    var lhs = chain_with_plus_idx(names, plus_idx);
    var reordered: [100]str = undefined;
    var reordered_len: u32 = names.len;
    for (i in 0..names.len) {
        reordered[i] = names[i];
    }
    var temp = reordered[0];
    reordered[0] = reordered[reordered_len - 1];
    reordered[reordered_len - 1] = temp;
    
    var rhs_reordered: [100]str = undefined;
    for (i in 0..reordered_len) {
        rhs_reordered[i] = reordered[i];
    }
    var rhs = chain_with_plus_idx(rhs_reordered, plus_idx);
    return (lhs, rhs);
}

pub fn theorem_block(name: str, doc: str, vars: str, lhs: str, rhs: str) -> str {
    return "/-- " + doc + "/-\n\n" +
           "theorem " + name + " (" + vars + " : Int) :\n" +
           "    " + lhs + " = " + rhs + " := by\n" +
           "  simp [ternaryMac_eq_acc_plus_mul, ternaryMul, ternaryDecode]\n" +
           "  <;> try omega\n";
}

pub fn main() -> void {
    undefined; // File I/O operation - not tested
}

test var_names_small {
    var result = var_names(3);
    assert(result.len == 3);
    assert(result[0] == "a");
    assert(result[1] == "b");
    assert(result[2] == "c");
}

test var_names_skip_keywords {
    var result = var_names(10);
    assert(result.len == 10);
    assert(result[0] == "a");
    assert(result[1] == "b");
    assert(result[2] == "c");
    assert(result[3] == "e");
}

test var_names_two_letters {
    var result = var_names(30);
    assert(result.len >= 26);
    if (result.len >= 27) {
        assert(result[26] == "aa");
    }
}

test nest_mac_single {
    var activations = [_]str{"a", "b", "c"};
    var result = nest_mac("x", activations, "plus");
    var expected = "ternaryMac (ternaryMac (ternaryMac (x) a (TernaryWeight.mk .plus)) b (TernaryWeight.mk .plus)) c (TernaryWeight.mk .plus)";
    assert(result == expected);
}

test plus_chain_basic {
    var (lhs, rhs) = plus_chain(3);
    assert(rhs == "a + b + c");
    assert(lhs.contains("ternaryMac"));
}

test minus_chain_basic {
    var (lhs, rhs) = minus_chain(2);
    assert(rhs == "-(a + b)");
    assert(lhs.contains("minus"));
}

test cancellation_chain_even {
    var (lhs, rhs) = cancellation_chain(4);
    assert(rhs == "x");
}

test cancellation_chain_odd {
    var (lhs, rhs) = cancellation_chain(3);
    assert(rhs == "ternaryMac x a (TernaryWeight.mk .plus)");
}

test zero_weight_closure_basic {
    var (lhs, rhs) = zero_weight_closure(1, 1);
    assert(lhs != rhs);
    assert(lhs.contains("zero"));
    assert(rhs.contains("zero"));
}

test theorem_block_format {
    var result = theorem_block("test_theorem", "Test documentation", "x y", "expr1", "expr2");
    assert(result.contains("/-- Test documentation/-/"));
    assert(result.contains("theorem test_theorem"));
    assert(result.contains("(x y : Int)"));
    assert(result.contains("expr1 = expr2"));
}

test var_names_edge_case_zero {
    var result = var_names(0);
    assert(result.len == 0);
}

test var_names_large_number {
    var result = var_names(50);
    assert(result.len == 50);
    assert(result[0] == "a");
    assert(result[1] == "b");
    assert(result[3] == "e");
}