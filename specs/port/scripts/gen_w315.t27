// SPDX-License-Identifier: Apache-2.0
// Port of scripts/gen_w315.py (issue #7515).
// The original appends a block to every IGLA race/coder spec: it takes the last two
// tests plus the invariant that follows them and rewrites the wave suffix to _w315.
// The decisions in it are (1) which lines of a file form that block, and (2) which
// occurrences of _w312/_w313/_w314 are rewritten. Reading the files, joining text and
// appending to them is plumbing.
module port::scripts::gen_w315;

const NONE: i64 = -1;

// End of the line that starts at pos: the index of the next '\n', or the text length.
fn line_end(text: str, pos: usize) -> usize {
    var i: usize = pos;
    while (i < text.len and text[i] != '\n') {
        i += 1;
    }
    return i;
}

// Python `line.strip().startswith(prefix)` for the line that starts at pos: leading
// whitespace is skipped first (a line holds no '\n').
fn line_starts_with(text: str, pos: usize, prefix: str) -> bool {
    const le: usize = line_end(text, pos);
    var i: usize = pos;
    while (i < le and (text[i] == ' ' or text[i] == '\t' or text[i] == '\r')) {
        i += 1;
    }
    if (i + prefix.len > le) {
        return false;
    }
    var j: usize = 0;
    while (j < prefix.len) {
        if (text[i + j] != prefix[j]) {
            return false;
        }
        j += 1;
    }
    return true;
}

// True when the line that starts at pos is only whitespace (Python: `not line.strip()`).
fn is_blank(text: str, pos: usize) -> bool {
    const le: usize = line_end(text, pos);
    var i: usize = pos;
    while (i < le) {
        if (text[i] != ' ' and text[i] != '\t' and text[i] != '\r') {
            return false;
        }
        i += 1;
    }
    return true;
}

// The keywords that end the block in get_last_block.
fn ends_block(text: str, pos: usize) -> bool {
    if (is_blank(text, pos)) {
        return false;
    }
    return line_starts_with(text, pos, "test ") or
        line_starts_with(text, pos, "invariant ") or
        line_starts_with(text, pos, "fn ") or
        line_starts_with(text, pos, "pub ") or
        line_starts_with(text, pos, "//") or
        line_starts_with(text, pos, "type ") or
        line_starts_with(text, pos, "struct ");
}

// get_last_block(lines): the original takes the lines of a file (text.split('\n')) and
// returns lines[start:end], or None. Here the file text is the parameter and the answer
// is the pair of line numbers (start, end); start == -1 means None (fewer than 2 tests
// before the last invariant, or no invariant at all).
fn get_last_block(text: str) -> (i64, i64) {
    // Pass 1: the number of lines and the last invariant.
    var last_inv: i64 = NONE;
    var n_lines: i64 = 0;
    var pos: usize = 0;
    var done: bool = false;
    while (!done) {
        if (line_starts_with(text, pos, "invariant ")) {
            last_inv = n_lines;
        }
        n_lines += 1;
        const le: usize = line_end(text, pos);
        if (le >= text.len) {
            done = true;
        } else {
            pos = le + 1;
        }
    }
    if (last_inv == NONE) {
        return (NONE, NONE);
    }
    // Pass 2: the two last tests before that invariant, and the first keyword line after it.
    var n_tests: usize = 0;
    var last_before: i64 = NONE;
    var second_last_before: i64 = NONE;
    var end: i64 = n_lines;
    var found_end: bool = false;
    var ln: i64 = 0;
    pos = 0;
    done = false;
    while (!done) {
        if (ln < last_inv and line_starts_with(text, pos, "test ")) {
            second_last_before = last_before;
            last_before = ln;
            n_tests += 1;
        }
        if (ln > last_inv and !found_end and ends_block(text, pos)) {
            end = ln;
            found_end = true;
        }
        ln += 1;
        const le: usize = line_end(text, pos);
        if (le >= text.len) {
            done = true;
        } else {
            pos = le + 1;
        }
    }
    if (n_tests < 2) {
        return (NONE, NONE);
    }
    return (second_last_before, end);
}

// Which old wave number a suffix at position i is: 312, 313 or 314, else 0.
fn wave_suffix_at(line: str, i: usize) -> u32 {
    if (i + 5 > line.len) {
        return 0;
    }
    if (line[i] != '_' or line[i + 1] != 'w') {
        return 0;
    }
    if (line[i + 2] < '0' or line[i + 2] > '9' or line[i + 3] < '0' or line[i + 3] > '9' or line[i + 4] < '0' or line[i + 4] > '9') {
        return 0;
    }
    const n: u32 = ((line[i + 2] - '0') as u32) * 100 + ((line[i + 3] - '0') as u32) * 10 + ((line[i + 4] - '0') as u32);
    if (n == 312 or n == 313 or n == 314) {
        return n;
    }
    return 0;
}

// transform_block(line): how many suffixes the original rewrites to _w315 in one line
// (each match is 5 characters and contains no '_' after the first, so none overlap).
fn transform_block(line: str) -> u32 {
    var count: u32 = 0;
    var i: usize = 0;
    while (i < line.len) {
        if (wave_suffix_at(line, i) != 0) {
            count += 1;
            i += 5;
        } else {
            i += 1;
        }
    }
    return count;
}

// Plumbing: globs the spec files and appends to them; no test calls it.
fn process_specs() -> u32 {
    undefined;
}

test line_starts_with_skips_leading_whitespace {
    assert(line_starts_with("  test foo", 0, "test "));
    assert(line_starts_with("a\n\tinvariant x", 2, "invariant "));
    assert(!line_starts_with("xtest foo", 0, "test "));
    assert(!line_starts_with("te\nst ", 0, "test "));
}

test block_ends_at_the_next_keyword {
    const (s, e) = get_last_block("test a\nx\ntest b\ny\ninvariant i\nz\ntest c\nfn q");
    assert(s == 0);
    assert(e == 6);
}

test block_runs_to_the_end_without_a_keyword {
    // 6 lines: the end is the line count
    const (s, e) = get_last_block("test a\ntest b\ninvariant i\nz\n\nw");
    assert(s == 0);
    assert(e == 6);
}

test trailing_newline_counts_one_more_line {
    const (s, e) = get_last_block("test a\ntest b\ninvariant i\nz\n");
    assert(s == 0);
    assert(e == 5);
}

test no_block_with_one_test_or_no_invariant {
    const (s1, e1) = get_last_block("test a\ninvariant i\nz");
    assert(s1 == -1);
    assert(e1 == -1);
    const (s2, e2) = get_last_block("test a\ntest b\nz");
    assert(s2 == -1);
    assert(e2 == -1);
}

test blank_lines_do_not_end_the_block {
    const (s, e) = get_last_block("test a\ntest b\ninvariant i\n   \nz");
    assert(s == 0);
    assert(e == 5);
}

test only_tests_before_the_last_invariant_count {
    // the last invariant is j (line 5): the two last tests before it are c and d (lines 3, 4)
    const (s, e) = get_last_block("test a\ntest b\ninvariant i\ntest c\ntest d\ninvariant j\nz");
    assert(s == 3);
    assert(e == 7);
}

test old_wave_suffixes_are_recognised {
    assert(wave_suffix_at("a_w312b", 1) == 312);
    assert(wave_suffix_at("a_w313b", 1) == 313);
    assert(wave_suffix_at("a_w314b", 1) == 314);
    assert(wave_suffix_at("a_w315b", 1) == 0);
    assert(wave_suffix_at("a_w311b", 1) == 0);
    assert(wave_suffix_at("a_w3", 1) == 0);
}

test transform_counts_rewrites {
    assert(transform_block("hello_w315_world") == 0);
    assert(transform_block("foo_w313_bar_w312_baz") == 2);
    assert(transform_block("x_w314") == 1);
    assert(transform_block("") == 0);
}
