// Port of scripts/gen_w315.py (issue #7515).
// The original appends a block to every IGLA race/coder spec: it takes the last two
// tests plus the invariant that follows them and rewrites the wave suffix to _w315.
// The decisions in it are (1) which lines of a file form that block, and (2) which
// occurrences of _w312/_w313/_w314 are rewritten. Reading the files, joining text and
// appending to them is plumbing.
module port::scripts::gen_w315;

use port::scripts::gen_w_blocks;

// line_end, line_starts_with, is_blank, ends_block, get_last_block and their tests live in
// gen_w_blocks.t27, shared by the seven gen_w ports.

// Which old wave number a suffix at position i is: 312, 313 or 314, else 0.
fn wave_suffix_at(line: str, i: usize) -> u32 {
    return wave_suffix_from(line, i, 312);
}

// transform_block(line): how many suffixes the original rewrites to _w315 in one line
// (each match is 5 characters and contains no '_' after the first, so none overlap).
fn transform_block(line: str) -> u32 {
    return transform_block_from(line, 312);
}

// Plumbing: globs the spec files and appends to them; no test calls it.
fn process_specs() -> u32 {
    undefined;
}

test old_wave_suffixes_are_recognised {
    assert(wave_suffix_at("a_w312b", 1) == 312);
    assert(wave_suffix_at("a_w313b", 1) == 313);
    assert(wave_suffix_at("a_w314b", 1) == 314);
    assert(wave_suffix_at("a_w315b", 1) == 0);
    assert(wave_suffix_at("a_w311b", 1) == 0);
    assert(wave_suffix_at("a_w3", 1) == 0);
}

test transform_counts_rewrites {
    assert(transform_block("hello_w315_world") == 0);
    assert(transform_block("foo_w313_bar_w312_baz") == 2);
    assert(transform_block("x_w314") == 1);
    assert(transform_block("") == 0);
}
