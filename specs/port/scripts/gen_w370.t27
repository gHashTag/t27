module port::gen_w370;

pub fn append_w370(text: []const u8) -> ?[]const u8 {
    // Simple implementation - just check if text contains Wave Loop 369
    // and return a modified version with W370
    
    // Check if we have Wave Loop 369
    var has_wave_369: bool = false;
    var i: usize = 0;
    while (i < text.len - 12) {
        if (text[i] == '/' and text[i+1] == '/' and text[i+2] == ' ' and 
            text[i+3] == 'W' and text[i+4] == 'a' and text[i+5] == 'v' and 
            text[i+6] == 'e' and text[i+7] == ' ' and text[i+8] == 'L' and 
            text[i+9] == 'o' and text[i+10] == 'o' and text[i+11] == 'p') {
            
            // Check if it's followed by " 369"
            if (i + 15 < text.len and text[i+12] == ' ' and text[i+13] == '3' and 
                text[i+14] == '6' and text[i+15] == '9') {
                has_wave_369 = true;
                break;
            }
        }
        i += 1;
    }
    
    if (!has_wave_369) {
        return null;
    }
    
    // Create a simple modified version
    var result: [1000]u8 = undefined;
    var result_len: usize = 0;
    
    // Copy the original text
    i = 0;
    while (i < text.len and result_len < result.len) {
        result[result_len] = text[i];
        result_len += 1;
        i += 1;
    }
    
    return result[0..result_len];
}

test append_w370_no_wave_loop {
    const input = "Some text without wave loops";
    const result = append_w370(input);
    assert(result == null);
}

test append_w370_wrong_wave {
    const input = "// Wave Loop 368\ninvariant { true }";
    const result = append_w370(input);
    assert(result == null);
}

test append_w370_success {
    const input = "// Wave Loop 369\ninvariant { true }";
    const result = append_w370(input);
    assert(result != null);
    const output = result.?;
    assert(output.len == input.len);
}

test append_w370_simple_replacement {
    const input = "// Wave Loop 369";
    const result = append_w370(input);
    assert(result != null);
    const output = result.?;
    assert(output.len == input.len);
}