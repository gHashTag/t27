module port::gen_w328;

pub fn append_w328(path: []const u8) -> void {
    undefined;
}

fn has_wave_327(text: []const u8) -> bool {
    var pos: usize = 0;
    
    while (pos < text.len) {
        if (pos + 15 < text.len) {
            if (text[pos] == '/' and text[pos + 1] == '/' and 
                text[pos + 2] == ' ' and text[pos + 3] == 'W' and 
                text[pos + 4] == 'a' and text[pos + 5] == 'v' and 
                text[pos + 6] == 'e' and text[pos + 7] == ' ' and 
                text[pos + 8] == 'L' and text[pos + 9] == 'o' and 
                text[pos + 10] == 'o' and text[pos + 11] == 'p' and 
                text[pos + 12] == ' ' and text[pos + 13] == '3' and 
                text[pos + 14] == '2' and text[pos + 15] == '7') {
                return true;
            }
        }
        pos += 1;
    }
    
    return false;
}

test has_wave_327 {
    const text1 = "// Wave Loop 327\ninvariant true\n";
    const text2 = "// Wave Loop 326\ninvariant true\n";
    assert(has_wave_327(text1) == true);
    assert(has_wave_327(text2) == false);
}