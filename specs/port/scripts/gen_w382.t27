module port::scripts::gen_w382;

struct Path { }

fn append_w382(path: Path) void {
    undefined;
}

fn should_process(wave: i32) -> bool {
    if (wave == 381) {
        return true;
    }
    return false;
}

test should_process_test {
    assert(should_process(381));
    assert(!should_process(380));
    assert(!should_process(382));
}