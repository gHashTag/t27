module port::scripts;

fn append_w382(text: []const u8) -> bool {
    var i: usize = 0;
    while (i < text.len) {
        if (text[i] == '/' and
            i + 1 < text.len and text[i+1] == '/' and
            i + 2 < text.len and text[i+2] == ' ' and
            i + 3 < text.len and text[i+3] == 'W' and
            i + 4 < text.len and text[i+4] == 'a' and
            i + 5 < text.len and text[i+5] == 'v' and
            i + 6 < text.len and text[i+6] == 'e' and
            i + 7 < text.len and text[i+7] == ' ' and
            i + 8 < text.len and text[i+8] == 'L' and
            i + 9 < text.len and text[i+9] == 'o' and
            i + 10 < text.len and text[i+10] == 'o' and
            i + 11 < text.len and text[i+11] == 'p' and
            i + 12 < text.len and text[i+12] == ' ' and
            i + 13 < text.len and text[i+13] == '3' and
            i + 14 < text.len and text[i+14] == '8' and
            i + 15 < text.len and text[i+15] == '1') {
            return true;
        }
        i += 1;
    }
    return false;
}

test append_w382_returns_true_when_needle_present {
    const text: []const u8 = &[_]u8{ '/', '/', ' ', 'W', 'a', 'v', 'e', ' ', 'L', 'o', 'o', 'p', ' ', '3', '8', '1', '\n' };
    assert(append_w382(text) == true);
}

test append_w382_returns_false_when_needle_absent {
    const text: []const u8 = &[_]u8{ 'n', 'o', ' ', 'm', 'a', 't', 'c', 'h' };
    assert(append_w382(text) == false);
}