module port::gen_w388;

struct WaveSegment {
    wave: i32,
    start: usize,
    end: usize,
}

pub fn wave_segments(text: []const u8) -> [10]WaveSegment {
    var segments: [10]WaveSegment = undefined;
    var count: usize = 0;
    
    var pos: usize = 0;
    while (pos < text.len) {
        // Find "// Wave Loop " pattern
        if (pos + 14 <= text.len and std.mem.eql(u8, text[pos..pos+14], "// Wave Loop ")) {
            // Extract the wave number
            var start_num: usize = pos + 14;
            var end_num: usize = start_num;
            while (end_num < text.len and text[end_num] >= '0' and text[end_num] <= '9') {
                end_num += 1;
            }
            
            if (end_num > start_num) {
                var wave_num: i32 = 0;
                var i: usize = start_num;
                while (i < end_num) {
                    wave_num = wave_num * 10 + (text[i] - '0');
                    i += 1;
                }
                
                // Find the next Wave Loop or end of text
                var next_start: usize = text.len;
                var next_pos: usize = pos + 1;
                while (next_pos < text.len) {
                    if (next_pos + 14 <= text.len and std.mem.eql(u8, text[next_pos..next_pos+14], "// Wave Loop ")) {
                        next_start = next_pos;
                        break;
                    }
                    next_pos += 1;
                }
                
                if (count < segments.len) {
                    segments[count] = .{ .wave = wave_num, .start = pos, .end = next_start };
                    count += 1;
                }
            }
        }
        pos += 1;
    }
    
    return segments;
}

pub fn append_w388(path: []const u8) -> void {
    undefined;
}

test wave_segments_basic {
    var text: []const u8 = "// Wave Loop 387\nsome content\n// Wave Loop 388\nmore content";
    var segments = wave_segments(text);
    assert(segments.len >= 2);
    assert(segments[0].wave == 387);
    assert(segments[0].start == 0);
    assert(segments[0].end == 19);  // Before "// Wave Loop 388"
    assert(segments[1].wave == 388);
    assert(segments[1].start == 19);
    assert(segments[1].end == 36);  // End of text
}

test wave_segments_single {
    var text: []const u8 = "// Wave Loop 387\nonly one block";
    var segments = wave_segments(text);
    assert(segments.len >= 1);
    assert(segments[0].wave == 387);
    assert(segments[0].start == 0);
    assert(segments[0].end == text.len);
}

test wave_segments_no_matches {
    var text: []const u8 = "no wave loops here";
    var segments = wave_segments(text);
    assert(segments.len == 0);
}

test wave_segments_duplicate_removal_logic {
    // Test the logic that would remove duplicate W387 blocks
    var text: []const u8 = "// Wave Loop 387\nfirst\n// Wave Loop 387\nduplicate\n// Wave Loop 388\nlast";
    var segments = wave_segments(text);
    assert(segments.len >= 3);
    
    // Check that we can identify duplicate W387 blocks
    if (segments.len >= 2) {
        var last_wave = segments[segments.len - 1].wave;
        var second_last_wave = segments[segments.len - 2].wave;
        
        // This would be the condition for removing duplicates
        var should_remove_duplicate = (last_wave == 387 and second_last_wave == 387);
        assert(should_remove_duplicate == false);  // In this case, last is 388
    }
}