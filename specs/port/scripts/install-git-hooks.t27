// Test basic string operations
test basic_string_operations {
    const test_string: []const u8 = "hello";
    assert(test_string == "hello");
    
    const another_string: []const u8 = "world";
    assert(another_string == "world");
}

// Test that the main function returns success
test main_function_returns_zero {
    const result: i32 = main();
    assert(result == 0);
}

// Test hook names are correctly identified
test hook_names {
    const commit_msg_hook: []const u8 = "commit-msg";
    const pre_commit_hook: []const u8 = "pre-commit";
    const pre_push_hook: []const u8 = "pre-push";
    
    assert(commit_msg_hook == "commit-msg");
    assert(pre_commit_hook == "pre-commit");
    assert(pre_push_hook == "pre-push");
}

// Test hook purposes are correctly identified
test hook_purposes {
    const l1_traceability: []const u8 = "L1 TRACEABILITY";
    const l3_purity: []const u8 = "L3 PURITY";
    const l4_testability: []const u8 = "L4 TESTABILITY";
    
    assert(l1_traceability == "L1 TRACEABILITY");
    assert(l3_purity == "L3 PURITY");
    assert(l4_testability == "L4 TESTABILITY");
}