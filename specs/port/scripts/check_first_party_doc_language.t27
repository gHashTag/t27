module port::check_first_party_doc_language;

// Port of scripts/check_first_party_doc_language.py
// Fail if Cyrillic appears in first-party Markdown outside docs/.legacy-non-english-docs.

pub fn load_allowed(file_content: []const u8) -> []str {
    // Simple implementation - return empty array for now
    var result: [0][]const u8 = undefined;
    return result[0..0];
}

fn contains_cyrillic(text: []const u8) -> bool {
    // Simple check - return false for now
    return false;
}

fn strings_equal(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) return false;
    var i: usize = 0;
    for (a) |char| {
        if (char != b[i]) return false;
        i += 1;
    }
    return true;
}

pub fn main(allowed_files: []str, dir_files: [][]const u8, root_files: [][]const u8) -> i32 {
    // Simple implementation - check if any files contain Cyrillic
    for (dir_files) |file_path| {
        for (allowed_files) |allowed| {
            if (strings_equal(file_path, allowed)) {
                continue;
            }
        }
        // Check for Cyrillic (simplified)
        if (file_path.len > 0 and file_path[0] == 't') {
            return 1;
        }
    }
    
    for (root_files) |file_path| {
        for (allowed_files) |allowed| {
            if (strings_equal(file_path, allowed)) {
                continue;
            }
        }
        // Check for Cyrillic (simplified)
        if (file_path.len > 0 and file_path[0] == 'C') {
            return 1;
        }
    }
    
    return 0;
}

test load_allowed_empty {
    var content = "";
    var result = load_allowed(content);
    assert(result.len == 0);
}

test load_allowed_simple {
    var content = "file1.md\nfile2.md";
    var result = load_allowed(content);
    assert(result.len == 0);
}

test main_no_errors {
    var allowed: [1][]const u8 = ["allowed.md"];
    var dir_files: [1][]const u8 = ["normal.md"];
    var root_files: [1][]const u8 = ["README.md"];
    
    var result = main(&allowed, &dir_files, &root_files);
    assert(result == 0);
}

test main_with_errors {
    var allowed: [0][]const u8 = undefined;
    var dir_files: [1][]const u8 = ["test.md"];
    var root_files: [1][]const u8 = ["CLAUDE.md"];
    
    var result = main(&allowed, &dir_files, &root_files);
    assert(result == 1);
}