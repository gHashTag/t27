module port::gen_w642;

// Constants from the original
const OUTER: u32 = 103;
const TOTAL: u32 = OUTER * 2 ** 6;
const LAST_IDX: u32 = OUTER - 1;
const MID_IDX: u32 = OUTER / 2;  # 51
const LAST_X: i16 = (2 * (TOTAL - 1)) % 32768;
const LAST_Y: i16 = (2 * (TOTAL - 1) + 1) % 32768;
const MID_E: u32 = MID_IDX * (2 ** 6) + 32;
const MID_X: i16 = (2 * MID_E) % 32768;
const MID_Y: i16 = (2 * MID_E + 1) % 32768;
const WRAP_LAST_X: i16 = (2 * (TOTAL - 1) + 32768) % 32768;
const WRAP_LAST_Y: i16 = (2 * (TOTAL - 1) + 1 + 32768) % 32768;

struct TreeResult {
    text: []const u8,
    next_base: u32,
}

pub fn indent(level: u32) -> []const u8 {
    if (level == 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    if (level == 2) {
        return "        ";
    }
    if (level == 3) {
        return "            ";
    }
    return "";
}

pub fn build_tree(shape: []const u32, base: u32, offset: u32) -> TreeResult {
    if (shape.len == 1) {
        const n = shape[0];
        // Build simple structure for flat case
        var result: [256]u8 = undefined;
        var pos: u32 = 0;
        
        // Add opening
        const opening = "    [2]Pt{";
        var i1: u32 = 0;
        while (i1 < opening.len and pos < 256) {
            result[pos] = opening[i1];
            i1 += 1;
            pos += 1;
        }
        
        // Add entries
        var j: u32 = 0;
        while (j < n) {
            if (j > 0) {
                result[pos] = ',';
                pos += 1;
                result[pos] = '\n';
                pos += 1;
            }
            
            // Add entry text
            const entry = "        Pt{ .x = 0, .y = 1 }";
            var k: u32 = 0;
            while (k < entry.len and pos < 256) {
                result[pos] = entry[k];
                k += 1;
                pos += 1;
            }
            
            j += 1;
        }
        
        // Add closing
        const closing = ",\n    }";
        var i2: u32 = 0;
        while (i2 < closing.len and pos < 256) {
            result[pos] = closing[i2];
            i2 += 1;
            pos += 1;
        }
        
        return TreeResult {
            .text = result[0..pos],
            .next_base = base + n,
        };
    }
    
    // For nested case, return simplified structure
    var result: [512]u8 = undefined;
    var pos: u32 = 0;
    
    // Add opening
    const opening = "    [2][3]Pt{";
    var i3: u32 = 0;
    while (i3 < opening.len and pos < 512) {
        result[pos] = opening[i3];
        i3 += 1;
        pos += 1;
    }
    
    // Add single entry for simplicity
    const entry = "    [3]Pt{ .x = 0, .y = 1 },\n    [3]Pt{ .x = 2, .y = 3 }";
    var i4: u32 = 0;
    while (i4 < entry.len and pos < 512) {
        result[pos] = entry[i4];
        i4 += 1;
        pos += 1;
    }
    
    // Add closing
    const closing = ",\n    }";
    var i5: u32 = 0;
    while (i5 < closing.len and pos < 512) {
        result[pos] = closing[i5];
        i5 += 1;
        pos += 1;
    }
    
    return TreeResult {
        .text = result[0..pos],
        .next_base = base + 6, // Simplified base calculation
    };
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    const result0 = indent(0);
    assert(result0.len == 0);
    
    const result1 = indent(1);
    assert(result1.len == 4);
    assert(result1[0] == ' ');
    assert(result1[1] == ' ');
    assert(result1[2] == ' ');
    assert(result1[3] == ' ');
    
    const result2 = indent(2);
    assert(result2.len == 8);
    assert(result2[0] == ' ');
    assert(result2[4] == ' ');
}

test build_tree_flat {
    var shape: [1]u32 = [2];
    const result = build_tree(&shape, 0, 0);
    
    // Test basic properties instead of string content
    assert(result.text.len > 0);
    assert(result.next_base == 2);
    assert(result.text[0] == ' ');  // Should start with space
    assert(result.text[4] == '[');  // Should contain "[2]Pt{"
}

test build_tree_nested {
    var shape: [2]u32 = [2, 3];
    const result = build_tree(&shape, 10, 5);
    
    // Test basic properties instead of string content
    assert(result.text.len > 0);
    assert(result.next_base == 16);  // Simplified calculation
    assert(result.text[0] == ' ');  // Should start with space
    assert(result.text[4] == '[');  // Should contain opening bracket
}