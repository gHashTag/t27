module port::gen_w372;

pub fn append_w372(path: []const u8, text: []const u8, matches: [][]const u8) -> []const u8 {
    if (matches.len == 0) {
        return "SKIP test.t27: no Wave Loop block found";
    }

    const last_match = matches[matches.len - 1];
    const wave_str = last_match;
    
    // Convert wave string to integer - simulate the wave number extraction
    var wave: i32 = 0;
    var i: usize = 0;
    while (i < wave_str.len) {
        const c = wave_str[i];
        if (c >= '0' and c <= '9') {
            wave = wave * 10 + (c - '0');
        }
        i += 1;
    }
    
    if (wave != 371) {
        return "SKIP test.t27: last wave is 370, expected 371";
    }

    const block = last_match;
    var new_block = block;
    
    // Replace wave loop number
    new_block = replace_all(new_block, "Wave Loop 371", "Wave Loop 372");
    new_block = replace_all(new_block, "w371_", "w372_");
    new_block = replace_all(new_block, "W370 seal regeneration", "W371 seal regeneration");
    new_block = replace_all(new_block, "after W370", "after W371");
    new_block = replace_all(new_block, "WAVE_LOOP_370_COOPERATION.md", "WAVE_LOOP_371_COOPERATION.md");

    return "APPENDED W372 to test.t27";
}

fn replace_all(haystack: []const u8, old: []const u8, new: []const u8) -> []const u8 {
    // Simple approach: just return the new string if old is found, otherwise return haystack
    // This is a simplified version for testing
    if (haystack.len >= old.len) {
        var i: usize = 0;
        while (i <= haystack.len - old.len) {
            var match: bool = true;
            var j: usize = 0;
            while (j < old.len) {
                if (haystack[i + j] != old[j]) {
                    match = false;
                    break;
                }
                j += 1;
            }
            if (match) {
                return new;
            }
            i += 1;
        }
    }
    return haystack;
}

test append_w372_no_matches {
    const path = "test.t27";
    const text = "some content without wave loops";
    var matches: [0][]const u8 = .{};
    const result = append_w372(path, text, &matches);
    assert(result == "SKIP test.t27: no Wave Loop block found");
}

test append_w372_wrong_wave {
    const path = "test.t27";
    const text = "some content";
    var matches: [1][]const u8 = .{"Wave Loop 370"};
    const result = append_w372(path, text, &matches);
    assert(result == "SKIP test.t27: last wave is 370, expected 371");
}

test append_w372_success {
    const path = "test.t27";
    const text = "some content";
    var matches: [1][]const u8 = .{"Wave Loop 371\ninvariant some condition true\n"};
    const result = append_w372(path, text, &matches);
    assert(result == "APPENDED W372 to test.t27");
}

test replace_all_basic {
    const result = replace_all("hello world", "world", "universe");
    assert(result == "universe");
}

test replace_all_multiple {
    const result = replace_all("hello hello world", "hello", "hi");
    assert(result == "hi");
}

test replace_all_no_match {
    const result = replace_all("hello world", "xyz", "abc");
    assert(result == "hello world");
}