// Test rate calculation
test calculate_rate_basic {
    // Test rate calculation logic with current implementation
    const first_data = "dispatches: {finished: 0}";
    const last_data = "dispatches: {finished: 0}";
    const rate = calculate_rate(first_data, last_data, 3600);
    // Should calculate 0 dispatches per hour when both readings are 0
    assert(rate.? == 0.0);
}

test calculate_rate_zero_interval {
    // Test that zero since_seconds returns null rate
    const first_data = "dispatches: {finished: 10}";
    const last_data = "dispatches: {finished: 20}";
    const rate = calculate_rate(first_data, last_data, 0);
    assert(rate == null);
}

test format_workers_structure {
    // Test worker formatting returns expected structure
    const workers_data = "workers: {active: 5, capacity: 10}";
    const result = format_workers(workers_data);
    // Should contain key elements of worker display
    assert(std.mem.indexOf(u8, result, "lanes") != null);
    assert(std.mem.indexOf(u8, result, "active") != null);
}

test format_dispatches_structure {
    // Test dispatch formatting returns expected structure
    const dispatches_data = "dispatches: {total: 42, finished: 38, unreviewed: 4}";
    const result = format_dispatches(dispatches_data);
    // Should contain key elements of dispatch display
    assert(std.mem.indexOf(u8, result, "dispatches") != null);
    assert(std.mem.indexOf(u8, result, "total") != null);
    assert(std.mem.indexOf(u8, result, "finished") != null);
}