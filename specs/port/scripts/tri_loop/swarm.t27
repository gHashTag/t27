// Calculate finished dispatches per hour between two readings
fn calculate_rate(first_data: []const u8, last_data: []const u8, since_seconds: u32) -> ?f64 {
    // Parse JSON data (this would be done by a helper in real implementation)
    // For now, simulate the logic with sample data structure
    var first_finished: u32 = 0;
    var last_finished: u32 = 0;
    
    // In a real implementation, we'd parse JSON and extract these values
    // For testing, we'll simulate the calculation
    if (since_seconds > 0) {
        const done: u32 = last_finished - first_finished;
        const done_f64: f64 = @floatFromInt(done);
        const since_f64: f64 = @floatFromInt(since_seconds);
        return done_f64 * 3600.0 / since_f64;
    }
    return null;
}

// Format worker information for display
