// SPDX-License-Identifier: Apache-2.0
// Port of scripts/gen_w669.py (issue #8257).
// The original writes the spec w669_bench_module_157x2p6_aos_var_call_write.t27: a
// [157][2][2][2][2][2][2]Pt grid literal whose points are numbered in row-major
// order. The decisions in it are the indent width, the coordinate of each point
// (2e + offset, wrapped at 32768), how many points a subtree of a shape consumes,
// and the ASCII guard the original applies before writing. Building the text and
// writing the file are plumbing.
module gen_w669 {
    const WRAP: u32 = 32768;
    const INDENT_UNIT: u32 = 4;
    const OUTER: u32 = 157;
    const TOTAL: u32 = OUTER * 64;
    const MID_E: u32 = (OUTER / 2) * 64 + 32;

    fn indent(level: u32) -> u32 {
        return INDENT_UNIT * level;
    }

    fn coordinate(e: u32, offset: u32, step: u32) -> u32 {
        return (2 * e + offset + step) % WRAP;
    }

    // build_tree(shape, base): the next base after building every point of shape,
    // starting at base. A leaf shape is one dimension and advances by n; a nested
    // shape advances through n subtrees of the inner shape, so by the product of
    // its dims. The original's offset parameter only affects the coordinates.
    fn build_tree(shape: []const u32, base: u32) -> u32 {
        if (shape.len == 1) {
            return base + shape[0];
        }
        var b: u32 = base;
        var i: u32 = 0;
        while (i < shape[0]) {
            b = build_tree(shape[1..shape.len], b);
            i = i + 1;
        }
        return b;
    }

    // The original raises ValueError before writing if any character is >= 128.
    fn is_ascii(text: []const u8) -> bool {
        var i: u32 = 0;
        while (i < text.len) {
            if (text[i] >= 128) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // Plumbing: assembles the text and writes the .t27 file; no test calls it.
    fn generate() -> u32 {
        undefined;
    }

    test indent_is_four_spaces_per_level {
        assert(indent(0) == 0);
        assert(indent(1) == 4);
        assert(indent(2) == 8);
    }

    test first_point_is_zero_one {
        assert(coordinate(0, 0, 0) == 0);
        assert(coordinate(0, 0, 1) == 1);
    }

    test last_point_matches_the_generated_expectations {
        // 157 * 64 = 10048 points, the last has e = 10047: x = 20094, y = 20095.
        assert(coordinate(TOTAL - 1, 0, 0) == 20094);
        assert(coordinate(TOTAL - 1, 0, 1) == 20095);
        // The point at dst[78][1][0][0][0][0][0] has e = 78 * 64 + 32 = 5024 -- the
        // original's trailing '# 73' comment is stale: 157 // 2 is 78.
        assert(coordinate(MID_E, 0, 0) == 10048);
        assert(coordinate(MID_E, 0, 1) == 10049);
    }

    test offset_32768_wraps_back {
        assert(coordinate(0, 32768, 0) == 0);
        assert(coordinate(0, 32768, 1) == 1);
        assert(coordinate(TOTAL - 1, 32768, 0) == 20094);
        assert(coordinate(TOTAL - 1, 32768, 1) == 20095);
    }

    test build_tree_advances_the_base {
        // A leaf shape of 4 single points starting at base 3 advances by 4.
        var leaf4: [1]u32 = [4];
        assert(build_tree(&leaf4, 3) == 7);
        // 2 subtrees of 3 points each from base 5 advance by 6.
        var nested23: [2]u32 = [2, 3];
        assert(build_tree(&nested23, 5) == 11);
        // An outer entry of 0 subtrees advances nothing.
        var zero_outer: [1]u32 = [0];
        assert(build_tree(&zero_outer, 7) == 7);
    }

    test whole_grid_has_10048_points {
        // 157 * 2^6 points: 157 outer entries of 64 points each.
        var full_shape: [7]u32 = [157, 2, 2, 2, 2, 2, 2];
        assert(build_tree(&full_shape, 0) == TOTAL);
    }

    test ascii_guard_rejects_non_ascii {
        assert(is_ascii("module w669_bench_module_157x2p6_aos_var_call_write\n\npub struct Pt { x : i16, y : i16 }\n\n"));
        // A byte >= 128 is rejected.
        var bad: [2]u8 = [65, 200];
        assert(!is_ascii(&bad));
        var ok: [2]u8 = [65, 66];
        assert(is_ascii(&ok));
    }
}
