// Port of scripts/gen_w709.py (gHashTag/t27 at 28a81d675, 145 lines), the
// deterministic generator of specs/scratch/w709_bench_module_237x2p6_aos_var_call_write.t27.
// The script is one file of pure functions with a single file-write at the
// end; this port keeps every decision as a function and drops the plumbing.
// No .t27 library grows strings or lists, so the built literal text becomes
// the numeric decisions that determine it.

module port::scripts::gen_w709;

use port::scripts::gen_w_tree;

// 237 x 2**6 Pt grid. The x/y of element e under offset are
// (2e + offset) % 32768 and (2e + offset + 1) % 32768 (original lines 13-21,
// 40-42); the expected array in the emitted footer is folded the same way.
const COORD_MOD: i64 = 32768;

const OUTER: i64 = 237;
const TOTAL: i64 = OUTER * 64; // OUTER * 2 ** 6 = 15168 (original line 10)
const LAST_IDX: i64 = OUTER - 1; // 236
const MID_IDX: i64 = OUTER / 2; // 118; the original's "# 118" comment is accurate here
const LAST_X: i64 = (2 * (TOTAL - 1)) % COORD_MOD; // 30334
const LAST_Y: i64 = (2 * (TOTAL - 1) + 1) % COORD_MOD; // 30335
const MID_E: i64 = MID_IDX * 64 + 32; // 7584
const MID_X: i64 = (2 * MID_E) % COORD_MOD; // 15168
const MID_Y: i64 = (2 * MID_E + 1) % COORD_MOD; // 15169
const WRAP_LAST_X: i64 = (2 * (TOTAL - 1) + COORD_MOD) % COORD_MOD; // 30334
const WRAP_LAST_Y: i64 = (2 * (TOTAL - 1) + 1 + COORD_MOD) % COORD_MOD; // 30335

// indent, elem_x, elem_y, TreeBuild, build_level, build_tree, flat_index and is_ascii
// (original lines 24-25, 28-58, 40-42 and 136) live in gen_w_tree.t27, shared by the
// eight gen_w bench ports.

// Original line 61: def generate() -> None. Writes the assembled text to
// DST and prints a one-line summary - pure data moving out (file, stdout).
// Its decisions live in the consts and helpers above; the body stays
// undefined and no test calls it.
pub fn generate() -> i64 {
    undefined;
}

test indent_levels {
    const l0: str = indent(0);
    const l1: str = indent(1);
    const l2: str = indent(2);
    const l3: str = indent(3);
    assert(l0 == "");
    assert(l1 == "    ");
    assert(l2 == "        ");
    assert(l3 == "            ");
    assert(l1.len == 4);
    assert(l2.len == 8);
    assert(l3.len == 12);
    // Python: "    " * -2 is "".
    assert(indent(-2) == "");
}

test indent_deep_levels {
    const l4: str = indent(4);
    const l7: str = indent(7);
    assert(l4.len == 16);
    assert(l7.len == 28);
}

test bench_constants_match_original {
    // Each constant against the value the original computes for it. The
    // comparison runs through runtime memory so the harness executes it
    // instead of folding it away.
    var c: [11]i64 = [OUTER, TOTAL, LAST_IDX, MID_IDX, LAST_X, LAST_Y, MID_E, MID_X, MID_Y, WRAP_LAST_X, WRAP_LAST_Y];
    var want: [11]i64 = [237, 15168, 236, 118, 30334, 30335, 7584, 15168, 15169, 30334, 30335];
    var i: usize = 0;
    while (i < 11) {
        assert(c[i] == want[i]);
        i += 1;
    }
}

test elem_coords_match_emitted_assertions {
    // dst[0][0][0][0][0][0][0].x == 0 and .y == 1 in the emitted footer.
    assert(elem_x(0, 0) == 0);
    assert(elem_y(0, 0) == 1);
    // dst[LAST_IDX][1][1][1][1][1][1] is element TOTAL-1 = 15167.
    assert(elem_x(15167, 0) == 30334);
    assert(elem_y(15167, 0) == 30335);
    // make_grid(32768) folds offset 32768 back onto offset 0.
    assert(elem_x(15167, 32768) == 30334);
    assert(elem_y(15167, 32768) == 30335);
    // dst[MID_IDX][1][0][0][0][0][0] is element MID_E = 7584.
    assert(elem_x(7584, 0) == 15168);
    assert(elem_y(7584, 0) == 15169);
}

test build_tree_leaf_walks_base {
    var shape: [1]i64 = [4];
    const t: TreeBuild = build_tree(&shape, 10, 0);
    assert(t.first_x == 20);
    assert(t.first_y == 21);
    assert(t.last_x == 26);
    assert(t.last_y == 27);
    assert(t.leaves == 4);
    assert(t.next_base == 14);
}

test build_tree_nested_threads_base {
    var shape: [3]i64 = [2, 2, 2];
    const t: TreeBuild = build_tree(&shape, 7, 0);
    assert(t.first_x == 14);
    assert(t.first_y == 15);
    assert(t.last_x == 28);
    assert(t.last_y == 29);
    assert(t.leaves == 8);
    assert(t.next_base == 15);
}

test build_tree_offset_shifts_both_coords {
    var shape: [1]i64 = [2];
    const t: TreeBuild = build_tree(&shape, 0, 1);
    assert(t.first_x == 1);
    assert(t.first_y == 2);
    assert(t.last_x == 3);
    assert(t.last_y == 4);
}

test build_tree_coords_fold_modulo {
    var shape: [1]i64 = [2];
    const t: TreeBuild = build_tree(&shape, 16383, 0);
    assert(t.first_x == 32766);
    assert(t.first_y == 32767);
    assert(t.last_x == 0);
    assert(t.last_y == 1);
}

test build_tree_zero_width_dim_keeps_base {
    var shape: [2]i64 = [0, 3];
    const t: TreeBuild = build_tree(&shape, 5, 0);
    assert(t.leaves == 0);
    assert(t.next_base == 5);
}

test build_tree_full_bench_shape_matches_footer {
    var shape: [7]i64 = [OUTER, 2, 2, 2, 2, 2, 2];
    const t: TreeBuild = build_tree(&shape, 0, 0);
    // First leaf: dst[0][0][0][0][0][0][0] -> x 0, y 1.
    assert(t.first_x == 0);
    assert(t.first_y == 1);
    // Last leaf in row-major order: dst[236][1][1][1][1][1][1] -> LAST_X, LAST_Y.
    assert(t.last_x == LAST_X);
    assert(t.last_y == LAST_Y);
    assert(t.leaves == TOTAL);
    assert(t.next_base == TOTAL);
}

test build_level_leaf_direct {
    var shape: [2]i64 = [2, 3];
    const t: TreeBuild = build_level(&shape, 1, 10, 0);
    assert(t.first_x == 20);
    assert(t.last_x == 24);
    assert(t.leaves == 3);
    assert(t.next_base == 13);
}

test flat_index_matches_original_comment {
    var shape: [7]i64 = [OUTER, 2, 2, 2, 2, 2, 2];
    var mid: [7]i64 = [118, 1, 0, 0, 0, 0, 0];
    var last: [7]i64 = [236, 1, 1, 1, 1, 1, 1];
    // MID_IDX * 64 + 32, from the original's lines 15-17.
    assert(flat_index(&shape, &mid) == 7584);
    assert(flat_index(&shape, &last) == 15167);
}

test is_ascii_gate {
    assert(is_ascii("module w709_bench_module_237x2p6_aos_var_call_write\n"));
    assert(is_ascii(""));
    var bad: [4]u8 = [80, 116, 200, 10];
    assert(!is_ascii(&bad));
}
