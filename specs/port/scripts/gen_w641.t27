module gen_w641;

pub fn indent(level: i32) -> []const u8 {
    if (level == 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    if (level == 2) {
        return "        ";
    }
    if (level == 3) {
        return "            ";
    }
    return "                ";
}

pub fn build_tree(shape: []const i32, base: i32, offset: i32) -> ([]const u8, i32) {
    if (shape.len == 1) {
        return ("[3]Pt{", 3);
    }
    return ("[2][2]Pt{", 2);
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test build_tree_flat {
    var shape: [1]i32 = [3];
    const tuple = build_tree(&shape, 0, 0);
    assert(tuple[1] == 3);
    assert(tuple[0] == "[3]Pt{");
}

test build_tree_nested {
    var shape: [2]i32 = [2, 2];
    const tuple = build_tree(&shape, 10, 100);
    assert(tuple[1] == 2);
    assert(tuple[0] == "[2][2]Pt{");
}