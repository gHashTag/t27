module port::gen_w651;

// Constants from the original
const OUTER: usize = 121;
const TOTAL: usize = OUTER * 2 ** 6;
const LAST_IDX: usize = OUTER - 1;
const MID_IDX: usize = OUTER // 2;
const LAST_X: i16 = (2 * (TOTAL - 1)) % 32768;
const LAST_Y: i16 = (2 * (TOTAL - 1) + 1) % 32768;
const MID_E: usize = MID_IDX * (2 ** 6) + 32;
const MID_X: i16 = (2 * MID_E) % 32768;
const MID_Y: i16 = (2 * MID_E + 1) % 32768;
const WRAP_LAST_X: i16 = (2 * (TOTAL - 1) + 32768) % 32768;
const WRAP_LAST_Y: i16 = (2 * (TOTAL - 1) + 1 + 32768) % 32768;

pub fn indent(level: usize) -> []const u8 {
    if (level == 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    if (level == 2) {
        return "        ";
    }
    if (level == 3) {
        return "            ";
    }
    // For higher levels
    var result: [256]u8 = undefined;
    var i: usize = 0;
    while (i < level * 4) {
        result[i] = ' ';
        i += 1;
    }
    return result[0..level * 4];
}

pub fn build_tree(shape: []const usize, base: usize, offset: u16) -> ([]const u8, usize) {
    if (shape.len == 1) {
        const n = shape[0];
        // Simple flat array
        var buffer: [100]u8 = undefined;
        var pos: usize = 0;
        
        // Add opening
        const indent1 = indent(1);
        var i: usize = 0;
        while (i < indent1.len) {
            buffer[pos] = indent1[i];
            pos += 1;
            i += 1;
        }
        buffer[pos] = '[';
        pos += 1;
        buffer[pos] = '3';
        pos += 1;
        buffer[pos] = ']';
        pos += 1;
        buffer[pos] = 'P';
        pos += 1;
        buffer[pos] = 't';
        pos += 1;
        buffer[pos] = '{';
        pos += 1;
        buffer[pos] = '\n';
        pos += 1;
        
        // Add entries
        i = 0;
        while (i < 3) {
            const indent2 = indent(2);
            var j: usize = 0;
            while (j < indent2.len) {
                buffer[pos] = indent2[j];
                pos += 1;
                j += 1;
            }
            
            buffer[pos] = 'P';
            pos += 1;
            buffer[pos] = 't';
            pos += 1;
            buffer[pos] = '{';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '.';
            pos += 1;
            buffer[pos] = 'x';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '=';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            
            // Add x value
            const x_val = (2 * (base + i) + offset) % 32768;
            pos += std.fmt.formatInt(&buffer[pos], x_val, 10, .lower, 0);
            
            buffer[pos] = ',';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '.';
            pos += 1;
            buffer[pos] = 'y';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '=';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            
            // Add y value
            const y_val = (2 * (base + i) + offset + 1) % 32768;
            pos += std.fmt.formatInt(&buffer[pos], y_val, 10, .lower, 0);
            
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '}';
            pos += 1;
            
            if (i < 2) {
                buffer[pos] = ',';
                pos += 1;
            }
            buffer[pos] = '\n';
            pos += 1;
            i += 1;
        }
        
        // Add closing
        const indent1_end = indent(1);
        i = 0;
        while (i < indent1_end.len) {
            buffer[pos] = indent1_end[i];
            pos += 1;
            i += 1;
        }
        buffer[pos] = '}';
        pos += 1;
        
        return &buffer[0..pos], base + 3;
    }
    
    // Handle nested arrays
    const n = shape[0];
    const inner_shape = shape[1..];
    
    // Build dimension string
    var dims: [20]u8 = undefined;
    var dims_pos: usize = 0;
    dims[dims_pos] = '[';
    dims_pos += 1;
    dims_pos += std.fmt.formatInt(&dims[dims_pos], n, 10, .lower, 0);
    dims[dims_pos] = ']';
    dims_pos += 1;
    dims[dims_pos] = '[';
    dims_pos += 1;
    dims_pos += std.fmt.formatInt(&dims[dims_pos], inner_shape[0], 10, .lower, 0);
    dims[dims_pos] = ']';
    dims_pos += 1;
    
    // Build result
    var result: [500]u8 = undefined;
    var result_pos: usize = 0;
    
    // Add opening line
    const indent1 = indent(1);
    var i: usize = 0;
    while (i < indent1.len) {
        result[result_pos] = indent1[i];
        result_pos += 1;
        i += 1;
    }
    
    // Add dimensions
    i = 0;
    while (i < dims_pos) {
        result[result_pos] = dims[i];
        result_pos += 1;
        i += 1;
    }
    
    result[result_pos] = 'P';
    result_pos += 1;
    result[result_pos] = 't';
    result_pos += 1;
    result[result_pos] = '{';
    result_pos += 1;
    result[result_pos] = '\n';
    result_pos += 1;
    
    // Add entries
    i = 0;
    while (i < n) {
        const entry_text, new_base = build_tree(inner_shape, base, offset);
        base = new_base;
        
        // Copy entry text
        var j: usize = 0;
        while (j < entry_text.len) {
            result[result_pos] = entry_text[j];
            result_pos += 1;
            j += 1;
        }
        
        if (i < n - 1) {
            result[result_pos] = ',';
            result_pos += 1;
        }
        result[result_pos] = '\n';
        result_pos += 1;
        i += 1;
    }
    
    // Add closing
    const indent1_end = indent(1);
    i = 0;
    while (i < indent1_end.len) {
        result[result_pos] = indent1_end[i];
        result_pos += 1;
        i += 1;
    }
    result[result_pos] = '}';
    result_pos += 1;
    
    return &result[0..result_pos], base;
}

pub fn generate() -> void {
    undefined; // File I/O - port the decision, not the plumbing
}

test indent_basic {
    const result = indent(0);
    assert(result.len == 0);
    
    const result1 = indent(1);
    assert(result1.len == 4);
    assert(result1[0] == ' ');
    assert(result1[1] == ' ');
    assert(result1[2] == ' ');
    assert(result1[3] == ' ');
    
    const result2 = indent(2);
    assert(result2.len == 8);
    assert(result2[0] == ' ');
    assert(result2[4] == ' ');
}

test build_tree_flat {
    const shape: [2]usize = [3, 0];
    const result, next_base = build_tree(&shape, 0, 0);
    
    assert(next_base == 3);
    assert(result.len > 0);
    // Check for opening brace
    var found_open = false;
    var i: usize = 0;
    while (i < result.len) {
        if (result[i] == '{') {
            found_open = true;
            break;
        }
        i += 1;
    }
    assert(found_open);
}

test build_tree_nested {
    const shape: [2]usize = [2, 2];
    const result, next_base = build_tree(&shape, 10, 5);
    
    assert(next_base == 14);
    assert(result.len > 0);
    // Check for nested structure
    var bracket_count = 0;
    var i: usize = 0;
    while (i < result.len) {
        if (result[i] == '[') {
            bracket_count += 1;
        }
        i += 1;
    }
    assert(bracket_count >= 2);
}

test build_tree_modulo {
    const shape: [1]usize = [1];
    const result, next_base = build_tree(&shape, 16384, 0);
    
    assert(next_base == 1);
    assert(result.len > 0);
    // Check for x=0 (modulo behavior)
    var found_x0 = false;
    var i: usize = 0;
    while (i < result.len - 4) {
        if (result[i] == 'x' and result[i + 1] == ' ' and result[i + 2] == '=' and result[i + 3] == ' ' and result[i + 4] == '0') {
            found_x0 = true;
            break;
        }
        i += 1;
    }
    assert(found_x0);
}