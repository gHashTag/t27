module port::scripts::gen_w319;

fn starts_with_after_whitespace(s: []const u8, prefix: []const u8) bool {
    var i: usize = 0;
    while ((i < s.len) and (((s[i] == ' ') or (s[i] == '\t') or (s[i] == '\r') or (s[i] == '\n')))) {
        i += 1;
    }
    if ((i + prefix.len) > s.len) {
        return false;
    }
    var j: usize = 0;
    while (j < prefix.len) {
        if (s[i + j] != prefix[j]) {
            return false;
        }
        j += 1;
    }
    return true;
}

fn line_starts_with_declaration(line: []const u8) bool {
    return (((((starts_with_after_whitespace(line, "test ") or starts_with_after_whitespace(line, "invariant ")) or starts_with_after_whitespace(line, "fn ")) or starts_with_after_whitespace(line, "pub ")) or starts_with_after_whitespace(line, "//")) or starts_with_after_whitespace(line, "type ")) or starts_with_after_whitespace(line, "struct ");
}

pub fn get_last_block(lines: [][]const u8) [][]const u8 {
    const MAX_INDICES: usize = 64;
    var _test_indices: [MAX_INDICES]usize = undefined;
    var _test_count: usize = 0;
    var _inv_indices: [MAX_INDICES]usize = undefined;
    var _inv_count: usize = 0;
    var i: usize = 0;
    while (i < lines.len) {
        const line = lines[i];
        if (starts_with_after_whitespace(line, "test ")) {
            if (_test_count < 64) {
                _test_indices[_test_count] = i;
                _test_count += 1;
            }
        } else if (starts_with_after_whitespace(line, "invariant ")) {
            if (_inv_count < 64) {
                _inv_indices[_inv_count] = i;
                _inv_count += 1;
            }
        }
        i += 1;
    }
    if ((_test_count < 2) or (_inv_count < 1)) {
        var _empty: [0][]const u8 = undefined;
        return &_empty[0 .. 0];
    }
    const last_inv = _inv_indices[_inv_count - 1];
    var _tests_before: [MAX_INDICES]usize = undefined;
    var _tb_count: usize = 0;
    var j: usize = 0;
    while (j < _test_count) {
        const ti = _test_indices[j];
        if (ti < last_inv) {
            if (_tb_count < 64) {
                _tests_before[_tb_count] = ti;
                _tb_count += 1;
            }
        }
        j += 1;
    }
    if (_tb_count < 2) {
        var _empty2: [0][]const u8 = undefined;
        return &_empty2[0 .. 0];
    }
    const start = _tests_before[_tb_count - 2];
    var _end: usize = lines.len;
    var k: usize = last_inv + 1;
    while (k < lines.len) {
        if (line_starts_with_declaration(lines[k])) {
            _end = k;
            break;
        }
        k += 1;
    }
    return lines[start .. _end];
}

pub fn transform_block(block_lines: [][]const u8) []const u8 {
    _ = block_lines;
    undefined;
}

pub fn process_specs() void {
    undefined;
}

test "get_last_block_returns_empty_when_insufficient_tests" {
    const _lines: [2][]const u8 = .{ "invariant foo", "test bar" };
    const _result = get_last_block(&_lines);
    if (!(_result.len == 0)) {
        __t27_assert_fail("\n  assertion failed:\n    result.len = {any}\n", .{ _result.len });
    }
}

test "get_last_block_returns_empty_when_insufficient_invariants" {
    const _lines: [2][]const u8 = .{ "test foo", "test bar" };
    const _result = get_last_block(&_lines);
    if (!(_result.len == 0)) {
        __t27_assert_fail("\n  assertion failed:\n    result.len = {any}\n", .{ _result.len });
    }
}

test "get_last_block_returns_correct_block" {
    const _lines: [7][]const u8 = .{ "", "test a", "test b", "invariant c", "    some code", "test d", "test e" };
    const _expected: [4][]const u8 = .{ "test a", "test b", "invariant c", "    some code" };
    const _result = get_last_block(&_lines);
    if (!(_result.len == _expected.len)) {
        __t27_assert_fail("\n  assertion failed:\n    result.len = {any}\n    expected.len = {any}\n", .{ _result.len, _expected.len });
    }
    var idx: usize = 0;
    while (idx < _result.len) {
        if (!(_result[idx] == _expected[idx])) {
          __t27_assert_fail("\n  assertion failed:\n    result[idx] = {any}\n    expected[idx] = {any}\n", .{ _result[idx], _expected[idx] });
        }
        idx += 1;
    }
}