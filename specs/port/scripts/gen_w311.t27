// SPDX-License-Identifier: Apache-2.0
// Port of scripts/gen_w311.py (issue #7768).
// The original appends a block to every IGLA race/coder spec: it takes the last two
// tests plus the invariant that follows them and rewrites the wave suffix to _w311.
// The decisions in it are (1) which lines of a file form that block, and (2) which
// occurrences of _w308/_w309/_w310 are rewritten. Reading the files, joining text and
// appending to them is plumbing.
module port::scripts::gen_w311;

const NONE: i64 = -1;

// Python `line.strip().startswith(prefix)`: leading whitespace is skipped first.
fn line_starts_with(line: str, prefix: str) -> bool {
    var i: usize = 0;
    while (i < line.len and (line[i] == ' ' or line[i] == '\t' or line[i] == '\r' or line[i] == '\n')) {
        i += 1;
    }
    if (i + prefix.len > line.len) {
        return false;
    }
    var j: usize = 0;
    while (j < prefix.len) {
        if (line[i + j] != prefix[j]) {
            return false;
        }
        j += 1;
    }
    return true;
}

// True when every character is whitespace (Python: `not line.strip()`).
fn is_blank(line: str) -> bool {
    for c in line {
        if (c != ' ' and c != '\t' and c != '\r' and c != '\n') {
            return false;
        }
    }
    return true;
}

// The keywords that end the block in get_last_block.
fn ends_block(line: str) -> bool {
    if (is_blank(line)) {
        return false;
    }
    return line_starts_with(line, "test ") or
        line_starts_with(line, "invariant ") or
        line_starts_with(line, "fn ") or
        line_starts_with(line, "pub ") or
        line_starts_with(line, "//") or
        line_starts_with(line, "type ") or
        line_starts_with(line, "struct ");
}

// get_last_block(lines): the original returns lines[start:end], or None. Here the answer is
// the pair (start, end); start == -1 means None (fewer than 2 tests before the last
// invariant, or no invariant at all).
fn get_last_block(lines: []str) -> (i64, i64) {
    var n_tests: usize = 0;
    var last_inv: i64 = NONE;
    var second_last_before: i64 = NONE;
    var last_before: i64 = NONE;
    var i: usize = 0;
    // First pass: the last invariant.
    var k: usize = 0;
    var n_inv: usize = 0;
    while (k < lines.len) {
        if (line_starts_with(lines[k], "invariant ")) {
            last_inv = k as i64;
            n_inv += 1;
        }
        k += 1;
    }
    if (n_inv < 1) {
        return (NONE, NONE);
    }
    // Second pass: the two last tests before that invariant.
    while (i < lines.len) {
        if (line_starts_with(lines[i], "test ") and (i as i64) < last_inv) {
            second_last_before = last_before;
            last_before = i as i64;
            n_tests += 1;
        }
        i += 1;
    }
    if (n_tests < 2) {
        return (NONE, NONE);
    }
    var end: i64 = lines.len as i64;
    var m: usize = (last_inv + 1) as usize;
    while (m < lines.len) {
        if (ends_block(lines[m])) {
            end = m as i64;
            break;
        }
        m += 1;
    }
    return (second_last_before, end);
}

// Which old wave number a suffix at position i is: 308, 309 or 310, else 0.
fn wave_suffix_at(line: str, i: usize) -> u32 {
    if (i + 5 > line.len) {
        return 0;
    }
    if (line[i] != '_' or line[i + 1] != 'w' or line[i + 2] != '3' or (line[i + 3] != '0' and line[i + 3] != '1')) {
        return 0;
    }
    if (line[i + 3] == '0' and line[i + 4] == '8') {
        return 308;
    }
    if (line[i + 3] == '0' and line[i + 4] == '9') {
        return 309;
    }
    if (line[i + 3] == '1' and line[i + 4] == '0') {
        return 310;
    }
    return 0;
}

// transform_block(line): how many suffixes the original rewrites to _w311 in one line
// (each match is 5 characters and contains no '_' after the first, so none overlap).
fn transform_block(line: str) -> u32 {
    var count: u32 = 0;
    var i: usize = 0;
    while (i < line.len) {
        if (wave_suffix_at(line, i) != 0) {
            count += 1;
            i += 5;
        } else {
            i += 1;
        }
    }
    return count;
}

// Plumbing: globs the spec files and appends to them; no test calls it.
fn process_specs() -> u32 {
    undefined;
}

test line_starts_with_skips_leading_whitespace {
    assert(line_starts_with("  test foo", "test "));
    assert(line_starts_with("\tinvariant x", "invariant "));
    assert(!line_starts_with("xtest foo", "test "));
    assert(!line_starts_with("te", "test "));
}

test block_ends_at_the_next_keyword {
    var lines: [8][]const u8 = ["test a", "x", "test b", "y", "invariant i", "z", "test c", "fn q"];
    const (s, e) = get_last_block(&lines);
    assert(s == 0);
    assert(e == 6);
}

test block_runs_to_the_end_without_a_keyword {
    var lines: [6][]const u8 = ["test a", "test b", "invariant i", "z", "", "w"];
    const (s, e) = get_last_block(&lines);
    assert(s == 0);
    assert(e == 6);
}

test no_block_with_one_test_or_no_invariant {
    var one: [3][]const u8 = ["test a", "invariant i", "z"];
    const (s1, e1) = get_last_block(&one);
    assert(s1 == -1);
    assert(e1 == -1);
    var none: [3][]const u8 = ["test a", "test b", "z"];
    const (s2, e2) = get_last_block(&none);
    assert(s2 == -1);
    assert(e2 == -1);
}

test blank_lines_do_not_end_the_block {
    var lines: [5][]const u8 = ["test a", "test b", "invariant i", "   ", "z"];
    const (s, e) = get_last_block(&lines);
    assert(s == 0);
    assert(e == 5);
}

test old_wave_suffixes_are_recognised {
    assert(wave_suffix_at("a_w308b", 1) == 308);
    assert(wave_suffix_at("a_w309b", 1) == 309);
    assert(wave_suffix_at("a_w310b", 1) == 310);
    assert(wave_suffix_at("a_w311b", 1) == 0);
    assert(wave_suffix_at("a_w3", 1) == 0);
}

test transform_counts_rewrites {
    assert(transform_block("hello_w311_world") == 0);
    assert(transform_block("foo_w310_bar_w309_baz") == 2);
    assert(transform_block("x_w308") == 1);
    assert(transform_block("") == 0);
}
