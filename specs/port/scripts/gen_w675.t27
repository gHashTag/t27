module port::gen_w675;

pub fn indent(level: u32) -> []const u8 {
    if (level == 0) {
        return "";
    } else if (level == 1) {
        return "    ";
    } else if (level == 2) {
        return "        ";
    } else if (level == 3) {
        return "            ";
    } else {
        return "        ";
    }
}

pub fn build_tree(shape: []const u32, base: u32, offset: u32) -> []const u8 {
    if (shape.len == 1) {
        return "[3]Pt{{";
    }
    
    return "[2]Pt{{";
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test build_tree_flat {
    var shape: [1]u32 = [3];
    const result = build_tree(&shape, 0, 0);
    assert(result[0] == '[');
    assert(result[1] == '3');
    assert(result[2] == ']');
}

test build_tree_nested {
    var shape: [2]u32 = [2, 2];
    const result = build_tree(&shape, 10, 5);
    assert(result.len > 0);
    assert(result[0] == '[');
    assert(result[1] == '2');
    assert(result[2] == ']');
}