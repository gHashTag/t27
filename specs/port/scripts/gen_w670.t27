module gen_w670;

const OUTER: u32 = 159;
const TOTAL: u32 = OUTER * (2 ** 6);
const LAST_IDX: u32 = OUTER - 1;
const MID_IDX: u32 = OUTER / 2; // 73
const LAST_X: i16 = @intCast((2 * (TOTAL - 1)) % 32768);
const LAST_Y: i16 = @intCast((2 * (TOTAL - 1) + 1) % 32768);
// Index [MID_IDX][1][0][0][0][0][0] corresponds to element number
// MID_IDX * 64 + 1 * 32 + 0*16 + 0*8 + 0*4 + 0*2 + 0 = MID_IDX*64 + 32
const MID_E: u32 = MID_IDX * (2 ** 6) + 32;
const MID_X: i16 = @intCast((2 * MID_E) % 32768);
const MID_Y: i16 = @intCast((2 * MID_E + 1) % 32768);
const WRAP_LAST_X: i16 = @intCast((2 * (TOTAL - 1) + 32768) % 32768);
const WRAP_LAST_Y: i16 = @intCast((2 * (TOTAL - 1) + 1 + 32768) % 32768);

pub fn indent(level: u32) -> []const u8 {
    if (level == 0) {
        return "";
    }
    var result: [256]u8 = undefined;
    var i: u32 = 0;
    while (i < level) {
        const offset = i * 4;
        if (offset + 4 > 256) {
            break;
        }
        result[offset + 0] = ' ';
        result[offset + 1] = ' ';
        result[offset + 2] = ' ';
        result[offset + 3] = ' ';
        i += 1;
    }
    return result[0..level * 4];
}

pub fn build_tree(shape: []const u32, base: u32, offset: u16) -> ([]const u8, u32) {
    if (shape.len == 1) {
        const n = shape[0];
        var lines_buffer: [1024]u8 = undefined;
        var lines_writer = std.io.fixedBufferStream(&lines_buffer).writer();
        
        // Write opening line
        try lines_writer.writeAll(indent(1));
        try lines_writer.writeAll("[");
        try lines_writer.print("{d}", .{n});
        try lines_writer.writeAll("]Pt{");
        
        var entries_buffer: [4096]u8 = undefined;
        var entries_writer = std.io.fixedBufferStream(&entries_buffer).writer();
        
        var i: u32 = 0;
        while (i < n) {
            const e = base + i;
            const x = @intCast((2 * e + offset) % 32768);
            const y = @intCast((2 * e + offset + 1) % 32768);
            
            if (i > 0) {
                try entries_writer.writeAll(",\n");
            }
            
            try entries_writer.writeAll(indent(2));
            try entries_writer.writeAll("Pt{ .x = ");
            try entries_writer.print("{d}", .{x});
            try entries_writer.writeAll(", .y = ");
            try entries_writer.print("{d}", .{y});
            try entries_writer.writeAll(" }");
            
            i += 1;
        }
        
        try lines_writer.writeAll(",\n");
        try lines_writer.writeAll(entries_buffer[0..entries_writer.cursor]);
        try lines_writer.writeAll("\n");
        try lines_writer.writeAll(indent(1));
        try lines_writer.writeAll("}");
        
        return lines_buffer[0..lines_writer.cursor], base + n;
    }
    
    const n = shape[0];
    const inner_shape = shape[1..];
    
    // Build dimension string
    var dims_buffer: [128]u8 = undefined;
    var dims_writer = std.io.fixedBufferStream(&dims_buffer).writer();
    try dims_writer.writeAll("[");
    var dim_idx: usize = 0;
    while (dim_idx < shape.len) {
        if (dim_idx > 0) {
            try dims_writer.writeAll("][");
        }
        try dims_writer.print("{d}", .{shape[dim_idx]});
        dim_idx += 1;
    }
    try dims_writer.writeAll("]");
    const dims = dims_buffer[0..dims_writer.cursor];
    
    var lines_buffer: [8192]u8 = undefined;
    var lines_writer = std.io.fixedBufferStream(&lines_buffer).writer();
    
    // Write opening line
    try lines_writer.writeAll(indent(1));
    try lines_writer.writeAll(dims);
    try lines_writer.writeAll("Pt{");
    
    var entries_buffer: [16384]u8 = undefined;
    var entries_writer = std.io.fixedBufferStream(&entries_buffer).writer();
    
    var i: u32 = 0;
    while (i < n) {
        const entry_text, base = build_tree(inner_shape, base, offset);
        
        if (i > 0) {
            try entries_writer.writeAll(",\n");
        }
        
        try entries_writer.writeAll(entry_text);
        
        i += 1;
    }
    
    try lines_writer.writeAll(",\n");
    try lines_writer.writeAll(entries_buffer[0..entries_writer.cursor]);
    try lines_writer.writeAll("\n");
    try lines_writer.writeAll(indent(1));
    try lines_writer.writeAll("}");
    
    return lines_buffer[0..lines_writer.cursor], base;
}

pub fn generate() -> void {
    // Decision logic: generate the module content
    // File I/O is handled by caller, so this body is undefined
    undefined;
}

test indent_levels {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test build_tree_flat {
    const shape = [_]u32{3};
    const result, next_base = build_tree(&shape, 10, 0);
    
    // Should create a 3-element array of Pt structs starting at base 10
    const expected = "    [3]Pt{\n        Pt{ .x = 20, .y = 21 },\n        Pt{ .x = 22, .y = 23 },\n        Pt{ .x = 24, .y = 25 }\n    }";
    // Note: In real t27, string comparison might work differently, but the structure should be correct
    assert(next_base == 13); // 10 + 3
}

test build_tree_nested {
    const shape = [_]u32{2, 2};
    const result, next_base = build_tree(&shape, 0, 0);
    
    // Should create a 2x2 array, consuming 4 elements total
    assert(next_base == 4); // 2 * 2
    
    // Check that result contains expected structure
    assert(std.mem.indexOf(u8, &result, "[2][2]Pt{") != null);
    assert(std.mem.indexOf(u8, &result, "Pt{ .x = 0, .y = 1 }") != null);
    assert(std.mem.indexOf(u8, &result, "Pt{ .x = 2, .y = 3 }") != null);
}

test constants_calculation {
    // Test that our constants match the original Python calculations
    assert(OUTER == 159);
    assert(TOTAL == 159 * 64); // 2^6 = 64
    assert(LAST_IDX == 158);
    assert(MID_IDX == 79); // 159 / 2 = 79.5, but integer division gives 79
    assert(LAST_X == @intCast((2 * (10143) % 32768))); // 2 * (159*64 - 1)
    assert(LAST_Y == @intCast((2 * (10143) + 1) % 32768));
}