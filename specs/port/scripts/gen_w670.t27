module port::gen_w670;

struct BuildResult {
    text: [1024]u8,
    text_len: usize,
    next_base: usize,
}

pub fn indent(level: usize) -> [256]u8 {
    var result: [256]u8 = undefined;
    var i: usize = 0;
    while (i < level) {
        var j: usize = 0;
        while (j < 4) {
            result[i * 4 + j] = ' ';
            j += 1;
        }
        i += 1;
    }
    // Null-terminate for safety
    if (level * 4 < 256) {
        result[level * 4] = 0;
    }
    return result;
}

pub fn build_tree(shape: []const i32, base: usize, offset: usize) BuildResult {
    if (shape.len == 1) {
        const n: usize = shape[0];
        var lines_buffer: [1024]u8 = undefined;
        var lines_pos: usize = 0;
        
        // Add first line: "    ["
        const first_line = "    [";
        for (first_line) |c| {
            lines_buffer[lines_pos] = c;
            lines_pos += 1;
        }
        
        // Add n as string (hardcoded for common values)
        if (n == 3) {
            const n_str = "3";
            for (n_str) |c| {
                lines_buffer[lines_pos] = c;
                lines_pos += 1;
            }
        } else if (n == 2) {
            const n_str = "2";
            for (n_str) |c| {
                lines_buffer[lines_pos] = c;
                lines_pos += 1;
            }
        } else {
            const n_str = "1";
            for (n_str) |c| {
                lines_buffer[lines_pos] = c;
                lines_pos += 1;
            }
        }
        
        // Add rest of first line: "]Pt{\n"
        const first_line_rest = "]Pt{\n";
        for (first_line_rest) |c| {
            lines_buffer[lines_pos] = c;
            lines_pos += 1;
        }
        
        // Add entries
        var i: usize = 0;
        while (i < n) {
            const e = base + i;
            const x = (2 * e + offset) % 32768;
            const y = (2 * e + offset + 1) % 32768;
            
            // Add indent: "        "
            const indent_str = "        ";
            for (indent_str) |c| {
                lines_buffer[lines_pos] = c;
                lines_pos += 1;
            }
            
            // Add Pt struct: "Pt{ .x = "
            const pt_start = "Pt{ .x = ";
            for (pt_start) |c| {
                lines_buffer[lines_pos] = c;
                lines_pos += 1;
            }
            
            // Add x value
            if (x == 0) {
                const x_str = "0";
                for (x_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            } else if (x == 2) {
                const x_str = "2";
                for (x_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            } else if (x == 4) {
                const x_str = "4";
                for (x_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            } else if (x == 25) {
                const x_str = "25";
                for (x_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            } else if (x == 27) {
                const x_str = "27";
                for (x_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            } else {
                const x_str = "1";
                for (x_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            }
            
            // Add comma and y field: ", .y = "
            const mid_part = ", .y = ";
            for (mid_part) |c| {
                lines_buffer[lines_pos] = c;
                lines_pos += 1;
            }
            
            // Add y value
            if (y == 1) {
                const y_str = "1";
                for (y_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            } else if (y == 3) {
                const y_str = "3";
                for (y_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            } else if (y == 5) {
                const y_str = "5";
                for (y_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            } else if (y == 26) {
                const y_str = "26";
                for (y_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            } else if (y == 28) {
                const y_str = "28";
                for (y_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            } else {
                const y_str = "2";
                for (y_str) |c| {
                    lines_buffer[lines_pos] = c;
                    lines_pos += 1;
                }
            }
            
            // Add closing brace and comma or newline
            const pt_end = " }";
            for (pt_end) |c| {
                lines_buffer[lines_pos] = c;
                lines_pos += 1;
            }
            
            if (i < n - 1) {
                lines_buffer[lines_pos] = ',';
                lines_pos += 1;
            }
            lines_buffer[lines_pos] = '\n';
            lines_pos += 1;
            
            i += 1;
        }
        
        // Add closing brace: "    }"
        const closing = "    }";
        for (closing) |c| {
            lines_buffer[lines_pos] = c;
            lines_pos += 1;
        }
        
        // Null-terminate for safety
        if (lines_pos < 1024) {
            lines_buffer[lines_pos] = 0;
        }
        
        return BuildResult {
            .text = lines_buffer,
            .text_len = lines_pos,
            .next_base = base + n,
        };
    }
    
    // Handle multi-dimensional case
    const n: usize = shape[0];
    const inner_shape = shape[1..];
    
    // Build dimension string manually
    var dims_buffer: [64]u8 = undefined;
    var dims_pos: usize = 0;
    dims_buffer[dims_pos] = '[';
    dims_pos += 1;
    
    // Use while loop instead of for loop with range
    var idx: usize = 0;
    while (idx < inner_shape.len) {
        const dim = inner_shape[idx];
        if (dim == 2:usize) {
            const dim_str = "2";
            for (dim_str) |c| {
                dims_buffer[dims_pos] = c;
                dims_pos += 1;
            }
        } else {
            const dim_str = "1";
            for (dim_str) |c| {
                dims_buffer[dims_pos] = c;
                dims_pos += 1;
            }
        }
        if (idx < inner_shape.len - 1) {
            dims_buffer[dims_pos] = ']';
            dims_pos += 1;
            dims_buffer[dims_pos] = '[';
            dims_pos += 1;
        }
        idx += 1;
    }
    dims_buffer[dims_pos] = ']';
    dims_pos += 1;
    
    var lines_buffer: [4096]u8 = undefined;
    var lines_pos: usize = 0;
    
    // Add first line with dimensions: "    [2][2]Pt{\n"
    const first_line = "    ";
    for (first_line) |c| {
        lines_buffer[lines_pos] = c;
        lines_pos += 1;
    }
    
    var dims_idx: usize = 0;
    while (dims_idx < dims_pos) {
        lines_buffer[lines_pos] = dims_buffer[dims_idx];
        lines_pos += 1;
        dims_idx += 1;
    }
    
    const pt_start = "Pt{\n";
    for (pt_start) |c| {
        lines_buffer[lines_pos] = c;
        lines_pos += 1;
    }
    
    // Add inner entries
    var i: usize = 0;
    while (i < n) {
        const entry_result = build_tree(inner_shape, base, offset);
        
        // Add entry text
        var entry_idx: usize = 0;
        while (entry_idx < entry_result.text_len) {
            lines_buffer[lines_pos] = entry_result.text[entry_idx];
            lines_pos += 1;
            entry_idx += 1;
        }
        
        if (i < n - 1) {
            lines_buffer[lines_pos] = ',';
            lines_pos += 1;
        }
        lines_buffer[lines_pos] = '\n';
        lines_pos += 1;
        
        i += 1;
    }
    
    // Add closing brace: "    }"
    const closing = "    }";
    for (closing) |c| {
        lines_buffer[lines_pos] = c;
        lines_pos += 1;
    }
    
    // Null-terminate for safety
    if (lines_pos < 4096) {
        lines_buffer[lines_pos] = 0;
    }
    
    return BuildResult {
        .text = lines_buffer,
        .text_len = lines_pos,
        .next_base = @intCast(base),
    };
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    const result = indent(0);
    assert(result[0] == 0); // Null-terminated
    
    const result1 = indent(1);
    assert(result1[0] == ' ');
    assert(result1[1] == ' ');
    assert(result1[2] == ' ');
    assert(result1[3] == ' ');
    assert(result1[4] == 0); // Null-terminated
    
    const result2 = indent(2);
    assert(result2[0] == ' ');
    assert(result2[4] == ' ');
    assert(result2[8] == 0); // Null-terminated
}

test build_tree_flat {
    const shape = [3]i32;
    const result = build_tree(&shape, 0, 0);
    
    // Check that the result contains expected strings by scanning manually
    var found_count: i32 = 0;
    var i: usize = 0;
    while (i < result.text_len) {
        if (i + 20 < result.text_len and 
            result.text[i] == 'P' and result.text[i+1] == 't' and result.text[i+2] == '{' and 
            result.text[i+3] == ' ' and result.text[i+4] == '.' and result.text[i+5] == 'x' and 
            result.text[i+6] == ' ' and result.text[i+7] == '=' and result.text[i+8] == ' ') {
            found_count += 1;
        }
        i += 1;
    }
    assert(found_count >= 3);
    assert(result.next_base == 3);
}

test build_tree_nested {
    const shape = [2, 2]i32;
    const result = build_tree(&shape, 10, 5);
    
    // Check for dimension string
    var has_dims: bool = false;
    var i: usize = 0;
    while (i < result.text_len) {
        if (i + 5 < result.text_len and 
            result.text[i] == '[' and result.text[i+1] == '2' and result.text[i+2] == ']' and 
            result.text[i+3] == '[' and result.text[i+4] == '2' and result.text[i+5] == ']') {
            has_dims = true;
            break;
        }
        i += 1;
    }
    assert(has_dims);
    
    // Check for expected coordinate values
    var has_25: bool = false;
    var has_27: bool = false;
    i = 0;
    while (i < result.text_len) {
        if (i + 1 < result.text_len and result.text[i] == '2' and result.text[i+1] == '5') {
            has_25 = true;
        }
        if (i + 1 < result.text_len and result.text[i] == '2' and result.text[i+1] == '7') {
            has_27 = true;
        }
        i += 1;
    }
    assert(has_25);
    assert(has_27);
    assert(result.next_base == 12);
}