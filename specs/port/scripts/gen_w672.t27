// SPDX-License-Identifier: Apache-2.0
// Port of scripts/gen_w672.py (issue #8265).
// The original writes the spec w672_bench_module_163x2p6_aos_var_call_write.t27: a
// [163][2][2][2][2][2][2]Pt grid literal whose points are numbered in row-major order.
// The decisions in it are the indent width, the coordinate of each point (2e + offset,
// wrapped at 32768) and how many points a subtree consumes. Building the text and
// writing the file are plumbing. One note on the original's comments: the comment
// on MID_IDX says "# 73" but the code computes 163 // 2 = 81; a comment is not a
// value, and this port carries the code's value.
module gen_w672 {
    const WRAP: u32 = 32768;
    const INDENT_UNIT: u32 = 4;

    // indent(level): the number of spaces for one indent level ("    " * level).
    fn indent(level: u32) -> u32 {
        return INDENT_UNIT * level;
    }

    // coordinate(e, offset, step): x is step 0, y is step 1 -> (2e + offset + step) % 32768.
    fn coordinate(e: u32, offset: u32, step: u32) -> u32 {
        return (2 * e + offset + step) % WRAP;
    }

    // build_tree(n, inner_points, base): the next base after n subtrees of inner_points
    // points each, starting at base. A leaf row is n subtrees of one point.
    fn build_tree(n: u32, inner_points: u32, base: u32) -> u32 {
        var b: u32 = base;
        var i: u32 = 0;
        while (i < n) {
            b = b + inner_points;
            i = i + 1;
        }
        return b;
    }

    // Plumbing: assembles the text and writes the .t27 file; no test calls it.
    fn generate() -> u32 {
        undefined;
    }

    test indent_is_four_spaces_per_level {
        assert(indent(0) == 0);
        assert(indent(1) == 4);
        assert(indent(2) == 8);
    }

    test first_point_is_zero_one {
        assert(coordinate(0, 0, 0) == 0);
        assert(coordinate(0, 0, 1) == 1);
    }

    test last_point_matches_the_generated_expectations {
        // 163 * 64 = 10432 points, the last has e = 10431: x = 20862, y = 20863.
        assert(coordinate(10431, 0, 0) == 20862);
        assert(coordinate(10431, 0, 1) == 20863);
        // The point at dst[81][1][0][0][0][0][0] has e = 81 * 64 + 32 = 5216.
        assert(coordinate(5216, 0, 0) == 10432);
        assert(coordinate(5216, 0, 1) == 10433);
    }

    test offset_32768_wraps_back {
        assert(coordinate(0, 32768, 0) == 0);
        assert(coordinate(0, 32768, 1) == 1);
        assert(coordinate(10431, 32768, 0) == 20862);
        assert(coordinate(10431, 32768, 1) == 20863);
    }

    test build_tree_advances_the_base {
        // leaf row of 163 single points starting at 0
        assert(build_tree(163, 1, 0) == 163);
        // 2 subtrees of 32 points from base 10
        assert(build_tree(2, 32, 10) == 74);
        assert(build_tree(0, 5, 7) == 7);
    }

    test whole_grid_has_10432_points {
        // 163 * 2^6 points: 163 outer entries of 64 points each
        assert(build_tree(163, 64, 0) == 10432);
    }
}
