module port::scripts;

pub fn append_w384(content: []const u8) -> []const u8 {
    return content;
}

pub fn slice_eq(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) {
        return false;
    }
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

test skip_no_wave_loop {
    const input: []const u8 = "hello world";
    const output: []const u8 = append_w384(input);
    assert(slice_eq(input, output));
}

test skip_wave_not_383 {
    const input: []const u8 = "// Wave Loop 382\ninvariant w382_test_true true\n";
    const output: []const u8 = append_w384(input);
    assert(slice_eq(input, output));
}