module port::scripts::gen_w374;

/// A match result for a wave loop block.
pub struct WaveMatch {
    /// The wave number extracted from the comment.
    wave: i32,
    /// The full matched text block (from "// Wave Loop N" through "invariant ... true\n").
    block: []const u8,
    /// The end position of the match in the source text (where to insert after).
    end_pos: usize,
};

/// Result of finding the last wave 373 block.
pub struct FindResult {
    /// Whether a suitable wave 373 block was found.
    found: bool,
    /// The match if found, otherwise undefined.
    match: ?WaveMatch,
    /// Skip reason if not found.
    skip_reason: []const u8,
};

/// Extract the wave number from a "// Wave Loop N" comment line.
/// Returns 0 if the line doesn't match the pattern.
pub fn extract_wave_number(line: []const u8) -> i32 {
    const prefix = "// Wave Loop ";
    if (line.len < prefix.len) {
        return 0;
    }
    var i: usize = prefix.len;
    var num: i32 = 0;
    var has_digit: bool = false;
    while (i < line.len) {
        const c = line[i];
        if (c >= '0' and c <= '9') {
            num = num * 10 + (c - '0');
            has_digit = true;
        } else {
            break;
        }
        i += 1;
    }
    if (!has_digit) {
        return 0;
    }
    return num;
}

/// Check if a line starts with "// Wave Loop ".
pub fn is_wave_loop_line(line: []const u8) -> bool {
    const prefix = "// Wave Loop ";
    if (line.len < prefix.len) {
        return false;
    }
    for i in 0..prefix.len {
        if (line[i] != prefix[i]) {
            return false;
        }
    }
    return true;
}

/// Find the last wave loop block in the text.
/// The block pattern is: "// Wave Loop N" ... "invariant ... true\n"
/// Returns the last match with wave number 373, or a skip reason.
pub fn find_last_wave_373(text: []const u8) -> FindResult {
    var matches: [32]WaveMatch = undefined;
    var match_count: usize = 0;

    var search_start: usize = 0;
    while (search_start < text.len) {
        // Find next "// Wave Loop "
        var wave_pos: usize = search_start;
        var found_wave: bool = false;
        while (wave_pos < text.len) {
            if (wave_pos + 13 <= text.len) { // "// Wave Loop " = 13 chars
                var is_match: bool = true;
                const prefix = "// Wave Loop ";
                for i in 0..13 {
                    if (text[wave_pos + i] != prefix[i]) {
                        is_match = false;
                        break;
                    }
                }
                if (is_match) {
                    found_wave = true;
                    break;
                }
            }
            wave_pos += 1;
        }
        if (!found_wave) {
            break;
        }

        // Extract wave number from this line
        var line_end: usize = wave_pos;
        while (line_end < text.len and text[line_end] != '\n') {
            line_end += 1;
        }
        const wave_line = text[wave_pos..line_end];
        const wave_num = extract_wave_number(wave_line);

        // Find the next "invariant ... true\n" after this wave comment
        var invariant_start: usize = line_end + 1;
        var found_invariant: bool = false;
        var invariant_end: usize = invariant_start;
        while (invariant_start < text.len) {
            // Look for "invariant "
            if (invariant_start + 10 <= text.len) {
                var is_invariant: bool = true;
                const inv_prefix = "invariant ";
                for i in 0..10 {
                    if (text[invariant_start + i] != inv_prefix[i]) {
                        is_invariant = false;
                        break;
                    }
                }
                if (is_invariant) {
                    // Found "invariant ", now find "true\n"
                    var search_pos: usize = invariant_start + 10;
                    while (search_pos + 4 <= text.len) {
                        if (text[search_pos] == 't' and text[search_pos + 1] == 'r' and
                            text[search_pos + 2] == 'u' and text[search_pos + 3] == 'e' and
                            (search_pos + 4 == text.len or text[search_pos + 4] == '\n')) {
                            found_invariant = true;
                            invariant_end = search_pos + 4; // include the \n
                            if (invariant_end < text.len and text[invariant_end] == '\n') {
                                invariant_end += 1;
                            }
                            break;
                        }
                        search_pos += 1;
                    }
                    if (found_invariant) {
                        break;
                    }
                }
            }
            invariant_start += 1;
        }

        if (found_invariant) {
            if (match_count < matches.len) {
                matches[match_count] = WaveMatch {
                    .wave = wave_num,
                    .block = text[wave_pos..invariant_end],
                    .end_pos = invariant_end,
                };
                match_count += 1;
            }
            search_start = invariant_end;
        } else {
            search_start = line_end + 1;
        }
    }

    if (match_count == 0) {
        return FindResult {
            .found = false,
            .match = null,
            .skip_reason = "no Wave Loop block found",
        };
    }

    const last = matches[match_count - 1];
    if (last.wave != 373) {
        return FindResult {
            .found = false,
            .match = null,
            .skip_reason = "last wave is not 373",
        };
    }

    return FindResult {
        .found = true,
        .match = last,
        .skip_reason = "",
    };
}

