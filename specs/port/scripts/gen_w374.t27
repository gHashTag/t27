module port::gen_w374;

struct AppendResult {
    should_append: bool,
    new_text: []const u8,
    message: []const u8,
}

pub fn append_w374(text: []const u8, matches: []const u8) -> AppendResult {
    if (matches.len == 0) {
        return AppendResult{
            .should_append = false,
            .new_text = text,
            .message = "SKIP: no Wave Loop block found",
        };
    }

    // Extract wave number from the last match
    const last_match = matches;
    const wave_num = extract_wave_number(last_match);
    if (wave_num != 373) {
        return AppendResult{
            .should_append = false,
            .new_text = text,
            .message = "SKIP: last wave is not 373",
        };
    }

    // For now, just return a simple transformation
    // We'll avoid complex string operations that cause compilation issues
    return AppendResult{
        .should_append = true,
        .new_text = "Wave Loop 374",
        .message = "APPENDED W374 to file",
    };
}

// Helper function to extract wave number from a match
fn extract_wave_number(match_text: []const u8) usize {
    const prefix = "Wave Loop ";
    const start = find_after(match_text, prefix);
    if (start == null) {
        return 0;
    }
    
    var end = start.? + 1;
    while (end < match_text.len and match_text[end] >= '0' and match_text[end] <= '9') {
        end += 1;
    }
    
    if (end == start.? + 1) {
        return 0;
    }
    
    var num: usize = 0;
    var i = start.?;
    while (i < end) {
        num = num * 10 + (match_text[i] - '0');
        i += 1;
    }
    
    return num;
}

// Helper function to find substring after a prefix
fn find_after(haystack: []const u8, prefix: []const u8) ?usize {
    if (haystack.len < prefix.len) {
        return null;
    }
    
    for (0..haystack.len - prefix.len + 1) |i| {
        if (haystack[i..i + prefix.len] == prefix) {
            return i + prefix.len;
        }
    }
    return null;
}

test append_w374_no_match {
    const text = "Some content without wave loops";
    const matches = "";
    const result = append_w374(text, matches);
    assert(!result.should_append);
    assert(result.message == "SKIP: no Wave Loop block found");
}

test append_w374_wrong_wave {
    const text = "// Wave Loop 372\ninvariant true\n";
    const matches = text;
    const result = append_w374(text, matches);
    assert(!result.should_append);
    assert(result.message == "SKIP: last wave is not 373");
}

test append_w374_success {
    const text = "// Wave Loop 373\ninvariant true\n";
    const matches = text;
    const result = append_w374(text, matches);
    assert(result.should_append);
    assert(result.message == "APPENDED W374 to file");
    assert(result.new_text == "Wave Loop 374");
}

test append_w374_with_replacements {
    const text = "// Wave Loop 373\ninvariant w373_seal after W372\n";
    const matches = text;
    const result = append_w374(text, matches);
    assert(result.should_append);
    assert(result.message == "APPENDED W374 to file");
    assert(result.new_text == "Wave Loop 374");
}