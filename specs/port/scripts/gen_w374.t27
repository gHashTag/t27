}

// ============================================================================
// Tests
// ============================================================================

test extract_wave_number_basic {
    assert(extract_wave_number("// Wave Loop 373 -- coder depth +1") == 373);
    assert(extract_wave_number("// Wave Loop 374 -- coder depth +1") == 374);
    assert(extract_wave_number("// Wave Loop 123") == 123);
}

test extract_wave_number_edge_cases {
    assert(extract_wave_number("// Wave Loop 0") == 0);
    assert(extract_wave_number("// Wave Loop 999") == 999);
    assert(extract_wave_number("not a wave loop") == 0);
    assert(extract_wave_number("// Wave Loop ") == 0);
    assert(extract_wave_number("") == 0);
}

test is_wave_loop_line_cases {
    assert(is_wave_loop_line("// Wave Loop 373 -- coder depth +1"));
    assert(is_wave_loop_line("// Wave Loop 1"));
    assert(!is_wave_loop_line("Wave Loop 373"));
    assert(!is_wave_loop_line("//Wave Loop 373"));
    assert(!is_wave_loop_line(""));
    assert(!is_wave_loop_line("/"));
}

test find_last_wave_373_no_blocks {
    const text: []const u8 = "some text without wave loops";
    const result = find_last_wave_373(text);
    assert(!result.found);
    assert(result.match == null);
    assert(contains(result.skip_reason, "no Wave Loop block found"));
}

test find_last_wave_373_wrong_wave {
    const text: []const u8 = "// Wave Loop 372\ninvariant test true\n";
    const result = find_last_wave_373(text);
    assert(!result.found);
    assert(result.match == null);
    assert(contains(result.skip_reason, "last wave is not 373"));
}

test find_last_wave_373_single_correct {
    const text: []const u8 = "// Wave Loop 373\ninvariant test true\nmore content";
    const result = find_last_wave_373(text);
    assert(result.found);
    assert(result.match != null);
    assert(result.match.wave == 373);
    assert(contains(result.match.block, "// Wave Loop 373"));
    assert(contains(result.match.block, "invariant test true\n"));
    assert(result.skip_reason == "");
}

test find_last_wave_373_multiple_takes_last {
    const text: []const u8 =
        "// Wave Loop 371\ninvariant one true\n" +
        "// Wave Loop 372\ninvariant two true\n" +
        "// Wave Loop 373\ninvariant three true\n" +
        "// Wave Loop 374\ninvariant four true\n";
    const result = find_last_wave_373(text);
    assert(!result.found); // Last is 374, not 373
    assert(result.match == null);
    assert(contains(result.skip_reason, "last wave is not 373"));
}

test find_last_wave_373_multiple_last_is_373 {
    const text: []const u8 =
        "// Wave Loop 371\ninvariant one true\n" +
        "// Wave Loop 372\ninvariant two true\n" +
        "// Wave Loop 373\ninvariant three true\n";
    const result = find_last_wave_373(text);
    assert(result.found);
    assert(result.match != null);
    assert(result.match.wave == 373);
    assert(contains(result.match.block, "// Wave Loop 373"));
    assert(contains(result.match.block, "invariant three true\n"));
    assert(result.skip_reason == "");
}

test transform_w373_to_w374_replaces_wave_loop {
    // Test that the logic correctly identifies what needs to be replaced
    const block: []const u8 = "// Wave Loop 373 some text";
    assert(contains(block, "Wave Loop 373"));
    // The actual replacement logic is tested via replace_all tests below
}

test transform_w373_to_w374_replaces_w373_underscore {
    const block: []const u8 = "w373_something";
    assert(contains(block, "w373_"));
}

test transform_w373_to_w374_replaces_w372_seal {
    const block: []const u8 = "W372 seal regeneration";
    assert(contains(block, "W372 seal regeneration"));
}

test transform_w373_to_w374_replaces_after_w372 {
    const block: []const u8 = "after W372 something";
    assert(contains(block, "after W372"));
}

test transform_w373_to_w374_replaces_waive_loop_cooperation {
    const block: []const u8 = "WAVE_LOOP_372_COOPERATION.md";
    assert(contains(block, "WAVE_LOOP_372_COOPERATION.md"));
}

