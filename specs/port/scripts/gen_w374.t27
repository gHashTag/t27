test contains_finds_substring {
    assert(contains("hello world", "world"));
    assert(!contains("hello world", "xyz"));
    assert(contains("hello", ""));
    assert(!contains("", "hello"));
    assert(contains("", ""));
}

test contains_case_sensitive {
    assert(contains("Hello World", "hello") == false);
    assert(contains("Hello World", "Hello") == true);
}

test append_w374_has_correct_signature {
