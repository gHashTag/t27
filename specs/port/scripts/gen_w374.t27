/// Check if a string contains a substring.
pub fn contains(haystack: []const u8, needle: []const u8) -> bool {
    if (needle.len == 0) {
        return true;
    }
    if (haystack.len < needle.len) {
        return false;
    }
    for i in 0..(haystack.len - needle.len + 1) {
        var match: bool = true;
        for j in 0..needle.len {
            if (haystack[i + j] != needle[j]) {
                match = false;
                break;
            }
        }
        if (match) {
            return true;
        }
    }
    return false;
}

/// The main append_w374 function - does file I/O, so body is undefined.
/// The decision logic is in find_last_wave_373 and transform_w373_to_w374.
