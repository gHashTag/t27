test ensureAgentImageLoaded_unknownName_returnsNull {
    const openclaw_name: []const u8 = "openclaw-agent";
    const openclaw_img: []const u8 = "openclaw-image:latest";
    const hermes_name: []const u8 = "hermes-agent";
    const hermes_img: []const u8 = "hermes-image:latest";
    const result = ImageLoader_ensureAgentImageLoaded(
        "unknown-agent",
        null,
        openclaw_name,
        openclaw_img,
        hermes_name,
        hermes_img,
        fn(ref: []const u8, onLog: ?fn([]const u8) -> void) -> ?i32 { return null; }
    );
    assert(result == null);
}

test ensureAgentImageLoaded_pullFails_returnsPullError {
    // Mock pullImage that returns an error
    fn mock_pullImage(ref: []const u8, onLog: ?fn([]const u8) -> void) -> ?i32 {
        return 42;
    }
    const openclaw_name: []const u8 = "openclaw-agent";
    const openclaw_img: []const u8 = "openclaw-image:latest";
    const hermes_name: []const u8 = "hermes-agent";
    const hermes_img: []const u8 = "hermes-image:latest";
    const result = ImageLoader_ensureAgentImageLoaded(
        openclaw_name,
        null,
        openclaw_name,
        openclaw_img,
        hermes_name,
        hermes_img,
        mock_pullImage
    );
    assert(result == 42);
}