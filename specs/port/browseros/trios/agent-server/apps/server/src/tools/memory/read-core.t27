// Test scenarios based on the original function behavior
test file_not_exists {
    // Simulate the case where core memory file doesn't exist
    const result: ReadCoreResult = ReadCoreResult{ .text = "No core memories yet." };
    assert(result.text == "No core memories yet.");
}

test file_exists_but_empty {
    // Simulate the case where core memory file exists but is empty
    const result: ReadCoreResult = ReadCoreResult{ .text = "Core memory file is empty." };
    assert(result.text == "Core memory file is empty.");
}

test file_exists_with_content {
    // Simulate the case where core memory file exists with content
    const content: []const u8 = "This is some core memory content";
    const result: ReadCoreResult = ReadCoreResult{ .text = content };
    assert(result.text == content);
}

test content_with_whitespace_only {
    // Test edge case: content that only contains whitespace
    const content: []const u8 = "   \n\t  \r  ";
    // This should be considered empty based on the original logic: content.trim()
    const result: ReadCoreResult = ReadCoreResult{ .text = "Core memory file is empty." };
    assert(result.text == "Core memory file is empty.");
}