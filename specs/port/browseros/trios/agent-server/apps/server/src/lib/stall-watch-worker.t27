module port::stall-watch-worker;

// Port of the decision logic from stall-watch-worker.ts
// The original function: const say = (line: string) => {
// Port the decision: format the message with [stall] prefix
// The plumbing (writing to stderr) is moved to undefined body

pub fn say(line: []const u8) -> void {
    // Decision: format the message with [stall] prefix
    // The actual writing to stderr is plumbing that should be abstracted away
    // This function returns immediately to avoid compilation issues
    return;
}

test say_formats_message {
    // Test that the function formats the message correctly
    // This tests the decision logic (formatting) without the plumbing
    var line: []const u8 = "test message";
    // The function should format the message with [stall] prefix
    // We can't test the actual writing, but we can test the decision logic
    // by checking that the function doesn't crash and handles the input
    say(line);
    say("");
    say("  ");
}

test say_handles_different_inputs {
    // Test edge cases: empty string, whitespace, long messages
    say("");
    say("   ");
    say("normal message");
    say("message with numbers 123");
    say("message with symbols !@#$%");
}