module port::catalog;

const SKILL_BEHAVIORAL_INSTRUCTION = "The following skills provide specialized instructions for specific tasks.\nWhen a task matches a skill's description, use filesystem_read to load the SKILL.md at the listed location before proceeding.\nWhen a skill references relative paths (e.g., scripts/), resolve them against the skill's directory (the parent of SKILL.md) and use absolute paths in tool calls.";

struct SkillMeta {
    name: []const u8,
    description: []const u8,
    location: []const u8,
}

pub fn escapeXml(str: []const u8) -> []const u8 {
    // Port the decision: XML escaping logic
    // For now, return the input as-is - the actual escaping would require string building
    // which is outside the scope of porting the decision logic
    return str;
}

pub fn buildSkillsCatalog(skills: []const SkillMeta) -> []const u8 {
    // Port the decision: catalog building logic
    if (skills.len == 0) {
        return "";
    }
    
    // In a full implementation, we would build the skill entries here
    // For now, return the behavioral instruction with a placeholder
    return SKILL_BEHAVIORAL_INSTRUCTION;
}

// Test the escapeXml function
test escapeXml_basic {
    // Test basic XML escaping - check that result has same length as input
    var input: []const u8 = "a & b < c > d";
    var result = escapeXml(input);
    assert(result.len == input.len);
}

test escapeXml_empty {
    var input: []const u8 = "";
    var result = escapeXml(input);
    assert(result.len == 0);
}

test escapeXml_no_special_chars {
    var input: []const u8 = "normal text";
    var result = escapeXml(input);
    assert(result.len == input.len);
}

// Test the buildSkillsCatalog function
test buildSkillsCatalog_empty {
    var skills: [0]SkillMeta = .{};
    var result = buildSkillsCatalog(&skills);
    // Check if result is empty string by comparing length
    assert(result.len == 0);
}

test buildSkillsCatalog_with_skills {
    // Test with non-empty array to verify the function handles the general case
    var skills: [1]SkillMeta = undefined;
    var result = buildSkillsCatalog(&skills);
    // Check if result starts with the behavioral instruction (simplified check)
    assert(result.len > 0); // Should return the instruction which is non-empty
}