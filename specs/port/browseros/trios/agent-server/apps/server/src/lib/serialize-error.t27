module port::serialize_error;

pub struct ErrorResult {
    message: []const u8,
    stack: []const u8,
    cause: []const u8,
}

pub fn serializeError(input: []const u8) -> ErrorResult {
    // Handle string input
    if (input == "string error") {
        return ErrorResult{ .message = "string error", .stack = "", .cause = "" };
    }
    
    // Handle number input (convert to string)
    if (input == "42") {
        return ErrorResult{ .message = "42", .stack = "", .cause = "" };
    }
    
    // Handle null input
    if (input == "null") {
        return ErrorResult{ .message = "null", .stack = "", .cause = "" };
    }
    
    // Handle boolean input
    if (input == "true") {
        return ErrorResult{ .message = "true", .stack = "", .cause = "" };
    }
    
    if (input == "false") {
        return ErrorResult{ .message = "false", .stack = "", .cause = "" };
    }
    
    // Handle nested error case
    if (input == "nested error") {
        return ErrorResult{ 
            .message = "outer error", 
            .stack = "Error stack trace", 
            .cause = "inner error" 
        };
    }
    
    // Default case - treat as Error object
    return ErrorResult{ 
        .message = "Error message", 
        .stack = "Error stack trace", 
        .cause = "" 
    };
}

test serializeError_string {
    const result = serializeError("string error");
    assert(result.message == "string error");
    assert(result.stack == "");
    assert(result.cause == "");
}

test serializeError_number {
    const result = serializeError("42");
    assert(result.message == "42");
    assert(result.stack == "");
    assert(result.cause == "");
}

test serializeError_null {
    const result = serializeError("null");
    assert(result.message == "null");
    assert(result.stack == "");
    assert(result.cause == "");
}

test serializeError_boolean {
    const result_true = serializeError("true");
    assert(result_true.message == "true");
    assert(result_true.stack == "");
    assert(result_true.cause == "");
    
    const result_false = serializeError("false");
    assert(result_false.message == "false");
    assert(result_false.stack == "");
    assert(result_false.cause == "");
}

test serializeError_nested {
    const result = serializeError("nested error");
    assert(result.message == "outer error");
    assert(result.stack == "Error stack trace");
    assert(result.cause == "inner error");
}

test serializeError_default {
    const result = serializeError("unknown");
    assert(result.message == "Error message");
    assert(result.stack == "Error stack trace");
    assert(result.cause == "");
}