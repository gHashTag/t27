module port::monitoring::judge::service;

// Port of LazyMonitoringJudgeService from trios/agent-server/apps/server/src/monitoring/judge/service.ts
// The decision logic: create service with client if config exists, otherwise without client

pub fn createLazyMonitoringJudgeService() -> LazyMonitoringJudgeService {
    const config_exists = resolveLazyMonitoringJudgeConfigExists();
    const client = if (config_exists) {
        createRemoteLazyMonitoringJudgeClient()
    } else {
        LazyMonitoringJudgeClient{} // Empty client when no config
    };
    return LazyMonitoringJudgeService{client: client};
}

// External dependencies - port the decision, not the plumbing
