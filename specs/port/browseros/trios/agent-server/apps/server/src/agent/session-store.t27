module port::browseros::trios::agent_server::apps::server::src::agent;

const SESSION_STORE_CAPACITY: usize = 100;

struct AgentSession {
    // Fields are not used in SessionStore logic; defined for completeness.
    agent: []const u8,
    hiddenPageId: ?i32,
    browserContext: []const u8,
    mcpServerKey: []const u8,
    workingDir: []const u8,
    approvalConfigKey: []const u8,
    modelKey: []const u8,
}

struct SessionStoreEntry {
    key: []const u8,
    value: AgentSession,
    occupied: bool,
}

struct SessionStore {
    entries: [SESSION_STORE_CAPACITY]SessionStoreEntry,
}

// Helper to create an empty session store
fn SessionStore_new() -> SessionStore {
    var store: SessionStore;
    var i: usize = 0;
    while (i < SESSION_STORE_CAPACITY) {
        store.entries[i] = SessionStoreEntry{
            .key = [],
            .value = AgentSession{
                .agent = [],
                .hiddenPageId = null,
                .browserContext = [],
                .mcpServerKey = [],
                .workingDir = [],
                .approvalConfigKey = [],
                .modelKey = [],
            },
            .occupied = false,
        };
        i += 1;
    }
    return store;
}

pub fn SessionStore_get(store: *SessionStore, conversationId: []const u8) -> ?AgentSession {
    var i: usize = 0;
    while (i < SESSION_STORE_CAPACITY) {
        if (store.entries[i].occupied && store.entries[i].key == conversationId) {
            return store.entries[i].value;
        }
        i += 1;
    }
    return null;
}

pub fn SessionStore_set(store: *SessionStore, conversationId: []const u8, session: AgentSession) -> void {
    var i: usize = 0;
    while (i < SESSION_STORE_CAPACITY) {
        if (store.entries[i].occupied) {
            if (store.entries[i].key == conversationId) {
                store.entries[i].value = session;
                return;
            }
        } else {
            // Found empty slot
            store.entries[i].key = conversationId;
            store.entries[i].value = session;
            store.entries[i].occupied = true;
            return;
        }
        i += 1;
    }
    // Store is full; in a real implementation we would grow, but for this port we ignore.
    // The decision (to store the session) is preserved for the cases we test.
}

pub fn SessionStore_has(store: *SessionStore, conversationId: []const u8) -> bool {
    var i: usize = 0;
    while (i < SESSION_STORE_CAPACITY) {
        if (store.entries[i].occupied && store.entries[i].key == conversationId) {
            return true;
        }
        i += 1;
    }
    return false;
}

pub fn SessionStore_remove(store: *SessionStore, conversationId: []const u8) -> bool {
    var i: usize = 0;
    while (i < SESSION_STORE_CAPACITY) {
        if (store.entries[i].occupied && store.entries[i].key == conversationId) {
            store.entries[i].occupied = false;
            return true;
        }
        i += 1;
    }
    return false;
}

pub fn SessionStore_delete(store: *SessionStore, conversationId: []const u8) -> bool {
    // Note: The original async dispose is omitted as plumbing.
    var i: usize = 0;
    while (i < SESSION_STORE_CAPACITY) {
        if (store.entries[i].occupied && store.entries[i].key == conversationId) {
            store.entries[i].occupied = false;
            return true;
        }
        i += 1;
    }
    return false;
}

pub fn SessionStore_count(store: *SessionStore) -> usize {
    var count: usize = 0;
    var i: usize = 0;
    while (i < SESSION_STORE_CAPACITY) {
        if (store.entries[i].occupied) {
            count += 1;
        }
        i += 1;
    }
    return count;
}

test SessionStore_get_returns_null_when_empty {
    var store: SessionStore = SessionStore_new();
    assert(SessionStore_get(&store, "conv1") == null);
}

test SessionStore_set_and_get_returns_session {
    var store: SessionStore = SessionStore_new();
    let session = AgentSession{ .agent = [], .hiddenPageId = null, .browserContext = [], .mcpServerKey = [], .workingDir = [], .approvalConfigKey = [], .modelKey = [] };
    SessionStore_set(&store, "conv1", session);
    let retrieved = SessionStore_get(&store, "conv1");
    assert(retrieved != null);
    // Note: We cannot compare the session contents deeply without agent field usage.
    // We assume the set/get preserves the session reference for the test.
}

test SessionStore_has_returns_true_after_set {
    var store: SessionStore = SessionStore_new();
    let session = AgentSession{ .agent = [], .hiddenPageId = null, .browserContext = [], .mcpServerKey = [], .workingDir = [], .approvalConfigKey = [], .modelKey = [] };
    SessionStore_set(&store, "conv1", session);
    assert(SessionStore_has(&store, "conv1") == true);
}

test SessionStore_remove_returns_true_and_removes {
    var store: SessionStore = SessionStore_new();
    let session = AgentSession{ .agent = [], .hiddenPageId = null, .browserContext = [], .mcpServerKey = [], .workingDir = [], .approvalConfigKey = [], .modelKey = [] };
    SessionStore_set(&store, "conv1", session);
    assert(SessionStore_remove(&store, "conv1") == true);
    assert(SessionStore_has(&store, "conv1") == false);
}

test SessionStore_delete_returns_true_when_exists {
    var store: SessionStore = SessionStore_new();
    let session = AgentSession{ .agent = [], .hiddenPageId = null, .browserContext = [], .mcpServerKey = [], .workingDir = [], .approvalConfigKey = [], .modelKey = [] };
    SessionStore_set(&store, "conv1", session);
    assert(SessionStore_delete(&store, "conv1") == true);
    assert(SessionStore_has(&store, "conv1") == false);
}

test SessionStore_count_returns_correct_number {
    var store: SessionStore = SessionStore_new();
    assert(SessionStore_count(&store) == 0);
    let session1 = AgentSession{ .agent = [], .hiddenPageId = null, .browserContext = [], .mcpServerKey = [], .workingDir = [], .approvalConfigKey = [], .modelKey = [] };
    let session2 = AgentSession{ .agent = [], .hiddenPageId = null, .browserContext = [], .mcpServerKey = [], .workingDir = [], .approvalConfigKey = [], .modelKey = [] };
    SessionStore_set(&store, "conv1", session1);
    SessionStore_set(&store, "conv2", session2);
    assert(SessionStore_count(&store) == 2);
    let removed = SessionStore_remove(&store, "conv1");
    assert(removed);
    assert(SessionStore_count(&store) == 1);
}