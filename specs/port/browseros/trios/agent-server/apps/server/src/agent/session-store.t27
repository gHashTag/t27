module port::browseros::trios::agent_server::apps::server::src::agent;

const MaxSessions = 100;
const MaxConversationIdLength = 64;

pub struct AgentSession {
    pub id: i32,
}

   pub struct SessionStore {
       pub sessions: [MaxSessions]AgentSession,
       pub conversation_ids: [MaxSessions][MaxConversationIdLength]u8,
       pub id_lengths: [MaxSessions]usize,
       pub len: u32,
   }

fn conversationIdEqual(a: []const u8, b: *[MaxConversationIdLength]u8, b_len: usize) -> bool {
    if (a.len != b_len) {
        return false;
    }
    var i: usize = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

fn conversationIdCopy(dest: *[64]u8, src: []const u8) -> void {
    var i: usize = 0;
    while (i < src.len and i < 64) : (i += 1) {
        dest[i] = src[i];
    }
}

fn SessionStore_init() -> SessionStore {
    var store: SessionStore = undefined;
    store.len = 0;
    var i: usize = 0;
    while (i < MaxSessions) : (i += 1) {
        store.sessions[i] = AgentSession{ .id = 0 };
        store.id_lengths[i] = 0;
        var j: usize = 0;
        while (j < MaxConversationIdLength) : (j += 1) {
            store.conversation_ids[i][j] = 0;
        }
    }
    return store;
}

pub fn SessionStore_get(self: *SessionStore, conversationId: []const u8) ?*AgentSession {
    var i: usize = 0;
    while (i < self.len) : (i += 1) {
        if (conversationIdEqual(conversationId, &self.conversation_ids[i], self.id_lengths[i])) {
            return &self.sessions[i];
        }
    }
    return null;
}

pub fn SessionStore_set(self: *SessionStore, conversationId: []const u8, session: AgentSession) -> void {
    var i: usize = 0;
    while (i < self.len) : (i += 1) {
        if (conversationIdEqual(conversationId, &self.conversation_ids[i], self.id_lengths[i])) {
            self.sessions[i] = session;
            return;
        }
    }
    if (self.len < MaxSessions) {
        conversationIdCopy(&self.conversation_ids[self.len], conversationId);
        self.id_lengths[self.len] = conversationId.len;
        self.sessions[self.len] = session;
        self.len += 1;
    }
}

pub fn SessionStore_has(self: *SessionStore, conversationId: []const u8) bool {
    var i: usize = 0;
    while (i < self.len) : (i += 1) {
        if (conversationIdEqual(conversationId, &self.conversation_ids[i], self.id_lengths[i])) {
            return true;
        }
    }
    return false;
}

pub fn SessionStore_remove(self: *SessionStore, conversationId: []const u8) bool {
    var i: usize = 0;
    while (i < self.len) : (i += 1) {
        if (conversationIdEqual(conversationId, &self.conversation_ids[i], self.id_lengths[i])) {
            var j: usize = i;
            while ((j + 1) < self.len) : (j += 1) {
                self.sessions[j] = self.sessions[j + 1];
                self.conversation_ids[j] = self.conversation_ids[j + 1];
                self.id_lengths[j] = self.id_lengths[j + 1];
            }
            self.len -= 1;
            return true;
        }
    }
    return false;
}

pub fn SessionStore_delete(self: *SessionStore, conversationId: []const u8) bool {
    var i: usize = 0;
    while (i < self.len) : (i += 1) {
        if (conversationIdEqual(conversationId, &self.conversation_ids[i], self.id_lengths[i])) {
            var j: usize = i;
            while ((j + 1) < self.len) : (j += 1) {
                self.sessions[j] = self.sessions[j + 1];
                self.conversation_ids[j] = self.conversation_ids[j + 1];
                self.id_lengths[j] = self.id_lengths[j + 1];
            }
            self.len -= 1;
            return true;
        }
    }
    return false;
}

pub fn SessionStore_count(self: *SessionStore) usize {
    return self.len;
}

test "SessionStore_get_not_found" {
    var store = SessionStore_init();
    const result = SessionStore_get(&store, "nonexistent");
    assert(result == null);
}

test "SessionStore_get_found" {
    var store = SessionStore_init();
    var session = AgentSession{ .id = 42 };
    SessionStore_set(&store, "conv1", session);
    const result = SessionStore_get(&store, "conv1");
    assert(result != null);
    assert(result.?.id == 42);
}

test "SessionStore_set_and_has" {
    var store = SessionStore_init();
    assert(!SessionStore_has(&store, "conv1"));
    SessionStore_set(&store, "conv1", AgentSession{ .id = 1 });
    assert(SessionStore_has(&store, "conv1"));
    assert(!SessionStore_has(&store, "conv2"));
}

test "SessionStore_remove_existing" {
    var store = SessionStore_init();
    SessionStore_set(&store, "conv1", AgentSession{ .id = 1 });
    assert(SessionStore_remove(&store, "conv1") == true);
    assert(!SessionStore_has(&store, "conv1"));
    assert(SessionStore_count(&store) == 0);
}

test "SessionStore_remove_nonexistent" {
    var store = SessionStore_init();
    assert(_ = SessionStore_remove(&store, "nonexistent") == false);
}

test "SessionStore_delete_existing" {
    var store = SessionStore_init();
    SessionStore_set(&store, "conv1", AgentSession{ .id = 1 });
    assert(SessionStore_delete(&store, "conv1") == true);
    assert(!SessionStore_has(&store, "conv1"));
    assert(SessionStore_count(&store) == 0);
}

test "SessionStore_delete_nonexistent" {
    var store = SessionStore_init();
    assert(SessionStore_delete(&store, "nonexistent") == false);
}

test "SessionStore_count_multiple" {
    var store = SessionStore_init();
    assert(SessionStore_count(&store) == 0);
    SessionStore_set(&store, "a", AgentSession{ .id = 1 });
    assert(SessionStore_count(&store) == 1);
    SessionStore_set(&store, "b", AgentSession{ .id = 2 });
    assert(SessionStore_count(&store) == 2);
    _ = SessionStore_remove(&store, "a");
    assert(SessionStore_count(&store) == 1);
}