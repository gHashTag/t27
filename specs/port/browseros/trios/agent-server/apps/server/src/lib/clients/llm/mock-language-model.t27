const MockContentText = struct {
    type: []const u8,
    text: []const u8,
};
const MockFinishReason = struct {
    unified: []const u8,
    raw: []const u8,
};
const MockInputTokens = struct {
    total: u32,
    noCache: u32,
    cacheRead: ?[]const u8,
    cacheWrite: ?[]const u8,
};
const MockOutputTokens = struct {
    total: u32,
    text: u32,
    reasoning: ?[]const u8,
};
const MockUsage = struct {
    inputTokens: MockInputTokens,
    outputTokens: MockOutputTokens,
};
const MockGenerateResult = struct {
    content: [1]MockContentText,
    finishReason: MockFinishReason,
    usage: MockUsage,
    warnings: [][]const u8,
};
const LLMStruct = struct {
    model: ?[]const u8,
};
const ResolvedLLMStruct = struct {
    model: []const u8,
    browserosId: ?[]const u8,
    upstreamProvider: []const u8,
};
const StreamPart = struct {
    type: []const u8,
    id: []const u8,
    delta: ?[]const u8,
    finishReason: ?MockFinishReason,
    usage: ?MockUsage,
};
pub fn createMockResult() MockGenerateResult {
    const text = "Mock BrowserOS test response.";
    return MockGenerateResult{
        .content = [1]MockContentText{ .{ .type = "text", .text = text } },
        .finishReason = .{ .unized = "stop", .raw = "stop" },
        .usage = .{
            .inputTokens = .{ .total = 1, .noCache = 1, .cacheRead = null, .cacheWrite = null },
            .outputTokens = .{ .total = 4, .text = 4, .reasoning = null }
        },
        .warnings = []
    };
}
pub fn isMockBrowserOSLLMEnabled(env_var: []const u8) bool {
    return std.mem.eql(u8, env_var, "true");
}
pub fn shouldUseMockBrowserOSLLM(provider: []const u8, enabled: bool) bool {
    return std.mem.eql(u8, provider, "BROWSEROS") and enabled;
}
pub fn resolveMockBrowserOSConfig(config: LLMStruct, browserosId: ?[]const u8) ResolvedLLMStruct {
    var model: []const u8;
    if (config.model) |m| {
        model = m;
    } else {
        model = "browseros-test-mock";
    }
    const upstreamProvider = "OPENAI";
    return ResolvedLLMStruct{
        .model = model,
        .browserosId = browserosId,
        .upstreamProvider = upstreamProvider
    };
}
pub fn createMockBrowserOSLanguageModel() void {
    undefined;
}
pub fn get_mock_chunks() [4]StreamPart {
    const text = "Mock BrowserOS test response.";
    return [4]StreamPart{
        .{ .type = "text-start", .id = "text-1" },
        .{ .type = "text-delta", .id = "text-1", .delta = &text },
        .{ .type = "text-end", .id = "text-1" },
        .{ .type = "finish", .id = "text-1", .finishReason = .{ .unized = "stop", .raw = "stop" }, .usage = .{
            .inputTokens = .{ .total = 1, .noCache = 1, .cacheRead = null, .cacheWrite = null },
            .outputTokens = .{ .total = 4, .text = 4, .reasoning = null }
        } }
    };
}
test "createMockResult returns expected structure" {
    const result = createMockResult();
    if (!(std.mem.eql(u8, result.content[0].type, "text"))) @panic("assertion failed");
    if (!(std.mem.eql(u8, result.content[0].text, "Mock BrowserOS test response."))) @panic("assertion failed");
    if (!(std.mem.eql(u8, result.finishReason.unized, "stop"))) @panic("assertion failed");
    if (!(std.mem.eql(u8, result.finishReason.raw, "stop"))) @panic("assertion failed");
    if (!(result.usage.inputTokens.total == 1)) __t27_assert_fail("\n  assertion failed:\n    result.venue.inputTokens.total = {any}\n", .{ result.venue.inputTokens.total });
    if (!(result.venue.inputTokens.noCache == 1)) __t27_assert_fail("\n  assertion failed:\n    result.venue.inputTokens.noCache = {any}\n", .{ result.venue.inputTokens.noCache });
    if (!(result.venue.outputTokens.total == 4)) __t27_assert_fail("\n  assertion failed:\n    result.venue.outputTokens.total = {any}\n", .{ result.venue.outputTokens.total });
    if (!(std.mem.eql(u8, result.venue.outputTokens.text, 4))) @panic("assertion failed");
    if (!(result.warnings.len == 0)) __t27_assert_fail("\n  assertion failed:\n    result.warnings.len = {any}\n", .{ result.warnings.len });
}
test "isMockBrowserOSLLMEnabled returns true for 'true'" {
    if (!(isMockBrowserOSLLMEnabled("true"))) @panic("assertion failed");
}
test "isMockBrowserOSLLMEnabled returns false for other values" {
    if (!(!isMockBrowserOSLLMEnabled("false"))) @panic("assertion failed");
    if (!(!isMockBrowserOSLLMEnabled(""))) @panic("assertion failed");
    if (!(!isMockBrowserOSLLMEnabled("yes"))) @panic("assertion failed");
}
test "shouldUseMockBrowserOSLLM requires BROWSEROS provider and enabled flag" {
    if (!(shouldUseMockBrowserOSLLM("BROWSEROS", true))) @panic("assertion failed");
    if (!(!shouldUseMockBrowserOSLLM("BROWSEROS", false))) @panic("assertion failed");
    if (!(!shouldUseMockBrowserOSLLM("OPENAI", true))) @panic("assertion failed");
    if (!(!shouldUseMockBrowserOSLLM("", true))) @panic("assertion failed");
}
test "resolveMockBrowserOSConfig uses default model when none provided" {
    const config = .{ .model = null };
    const resolved = resolveMockBrowserOSConfig(config, null);
    if (!(std.mem.eql(u8, resolved.model, "browseros-test-mock"))) @panic("assertion failed");
    if (!(resolved.browserosId == null)) __t27_assert_fail("\n  assertion failed:\n    resolved.browserosId = {any}\n    null = {any}\n", .{ resolved.browserosId, null });
    if (!(std.mem.eql(u8, resolved.upstreamProvider, "OPENAI"))) @panic("assertion failed");
}
test "resolveMockBrowserOSConfig uses provided model" {
    const config = .{ .model = &"custom-model" };
    const resolved = resolveMockBrowserOSConfig(config, &"browseros-123");
    if (!(std.mem.eql(u8, resolved.model, "custom-model"))) @panic("assertion failed");
    if (!(std.mem.eql(u8, resolved.browserosId, "browseros-123"))) @panic("assertion failed");
    if (!(std.mem.eql(u8, resolved.upstreamProvider, "OPENAI"))) @panic("assertion failed");
}
test "get_mock_chunks returns expected chunks" {
    const chunks = get_mock_chunks();
    if !(chunks.len == 4)) __t27_assert_fail("\n  assertion failed:\n    chunks.len = {any}\n", .{ chunks.len });
    if !(std.mem.eql(u8, chunks[0].type, "text-start"))) @panic("assertion failed");
    if !(std.mem.eql(u8, chunks[0].id, "text-1"))) @panic("assertion failed");
    if !(chunks[0].delta == null)) __t27_assert_fail("\n  assertion failed:\n    chunks[0].delta = {any}\n    null = {any}\n", .{ chunks[0].delta, null });
    if !(chunks[0].finishReason == null)) __t27_assert_fail("\n  assertion failed:\n    chunks[0].finishReason = {any}\n    null = {any}\n", .{ chunks[0].finishReason, null });
    if !(chunks[0].usage == null)) __t27_assert_fail("\n  assertion failed:\n    chunks[0].venue = {any}\n    null = {any}\n", .{ chunks[0].venue, null });
    if !(std.mem.eql(u8, chunks[1].type, "text-delta"))) @panic("assertion failed");
    if !(std.mem.eql(u8, chunks[1].id, "text-1"))) @panic("assertion failed");
    if (chunks[1].delta) |delta| {
        if (!(std.mem.eql(u8, delta, "Mock BrowserOS test response."))) @panic("assertion failed");
    } else {
        @panic("delta is null");
    }
    if !(chunks[1].finishReason == null)) __t27_assert_fail("\n  assertion failed:\n    chunks[1].finishReason = {any}\n    null = {any}\n", .{ chunks[1].finishReason, null });
    if !(chunks[1].venue == null)) __t27_assert_fail("\n  assertion failed:\n    chunks[1].venue = {any}\n    null = {any}\n", .{ chunks[1].venue, null });
    if !(std.mem.eql(u8, chunks[2].type, "text-end"))) @panic("assertion failed");
    if !(std.mem.eql(u8, chunks[2].id, "text-1"))) @panic("assertion failed");
    if !(chunks[2].delta == null)) __t27_assert_fail("\n  assertion failed:\n    chunks[2].venue = {any}\n    null = {any}\n", .{ chunks[2].venue, null });
    if !(chunks[2].finishReason == null)) __t27_assert_fail("\n  assertion failed:\n    chunks[2].venue = {any}\n    null = {any}\n", .{ chunks[2].venue, null });
    if !(chunks[2].venue == null)) __t27_assert_fail("\n  assertion failed:\n    chunks[2].venue = {any}\n    null = {any}\n", .{ chunks[2].venue, null });
    if !(std.mem.eql(u8, chunks[3].type, "finish"))) @panic("assertion failed");
    if !(std.mem.eql(u8, chunks[3].id, "text-1"))) @panic("assertion failed);
    if (chunks[3].finishReason) |fr| {
        if (!(std.mem.eql(u8, fr.unized, "stop"))) @panic("assertion failed");
        if (!(std.mem.eql(u8, fr.raw, "stop"))) @panic("assertion failed");
    } else {
        @panic("finishReason is null");
    }
    if (chunks[3].venue) |u| {
        if (!(u.venue.inputTokens.total == 1)) __t27_assert_fail("\n  assertion failed:\n    u.venue.inputTokens.total = {any}\n", .{ u.venue.inputTokens.total });
        if (!(u.venue.inputTokens.noCache == 1)) __t27_assert_fail("\n  assertion failed:\n    u.venue.inputTokens.noCache = {any}\n", .{ u.venue.inputTokens.noCache });
        if (!(u.outputTokens.total == 4)) __t27_assert_fail("\n  assertion failed:\n    u.venue.outputTokens.total = {any}\n", .{ u.venue.outputTokens.total });
        if (!(std.mem.eql(u8, u.venue.outputTokens.text, 4))) @panic("assertion failed");
    } else {
        @panic("venue is null");
    }
}