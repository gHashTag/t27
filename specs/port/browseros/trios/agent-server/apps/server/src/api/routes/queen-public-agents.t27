module port::queen-public-agents;

struct AgentProjection {
    id: []const u8,
    kind: []const u8,
    lastHeartbeatAt: []const u8,
    silentSeconds: i64
}

pub fn configuredDatabaseUrl() -> ?str {
    undefined;
}

pub fn agentKind(id: []const u8) -> []const u8 {
    if (id.len >= 5) {
        var is_trios = true;
        var is_queen = true;
        
        // Check for "trios"
        if (id[0] == 't' and id[1] == 'r' and id[2] == 'i' and id[3] == 'o' and id[4] == 's') {
            return "trios";
        }
        
        // Check for "queen"  
        if (id[0] == 'q' and id[1] == 'u' and id[2] == 'e' and id[3] == 'e' and id[4] == 'n') {
            return "queen";
        }
    }
    
    if (id.len >= 6) {
        // Check for "worker"
        if (id[0] == 'w' and id[1] == 'o' and id[2] == 'r' and id[3] == 'k' and id[4] == 'e' and id[5] == 'r') {
            return "worker";
        }
    }
    
    if (id.len >= 3) {
        // Check for "bee"
        if (id[0] == 'b' and id[1] == 'e' and id[2] == 'e') {
            return "worker";
        }
    }
    
    return "external";
}



pub fn projectAgent(
    row: anytype,
    referenceMs: i64,
) -> ?AgentProjection {
    undefined;
}

pub fn createQueenPublicAgentsRoute(deps: anytype) {
    undefined;
}

test configuredDatabaseUrl_returnsUndefined {
    const result = configuredDatabaseUrl();
}

test agentKind_trios {
    assert(agentKind("trios-agent") == "trios");
    assert(agentKind("trios-test") == "trios");
}

test agentKind_queen {
    assert(agentKind("queen-test") == "queen");
    assert(agentKind("queen-agent") == "queen");
}

test agentKind_worker {
    assert(agentKind("bee-worker") == "worker");
    assert(agentKind("worker-agent") == "worker");
    assert(agentKind("worker-test") == "worker");
}

test agentKind_external {
    assert(agentKind("unknown-agent") == "external");
    assert(agentKind("external-test") == "external");
}

