module port::browseros::trios::agent_server::apps::server::src::api::routes::queen_roadmap;

pub const Roadmap = struct {
    pub dummy: u64,
};

pub const BoardFacts = struct {
    pub dummy: u64,
};

pub fn chooseFirstNonNullRoadmap(r1: ?Roadmap, r2: ?Roadmap) -> ?Roadmap {
    if (r1 == null) {
        return r2;
    } else {
        return r1;
    }
}

pub fn queenDataRouteDecision(url: ?[]const u8, roadmap: ?Roadmap, board: BoardFacts) -> (u64, []const u8) {
    if (url) |_| {
        return (200, "success");
    } else {
        return (503, "error");
    }
}

pub fn queenRoadmapRouteDecision() -> (u64, []const u8) {
    return (200, "shell");
}

pub fn loadRoadmap() -> ?Roadmap {
    undefined;
}

pub fn boardFacts(pool: anytype) -> BoardFacts {
    undefined;
}

pub fn createQueenRoadmapDataRoute() -> void {
    undefined;
}

pub fn createQueenRoadmapRoute() -> void {
    undefined;
}

test "chooseFirstNonNullRoadmap returns first when not null" {
    const r1 = Roadmap{ .dummy = 1 };
    const r2 = Roadmap{ .dummy = 2 };
    const result = chooseFirstNonNullRoadmap(r1, r2);
    std.assert(result != null);
    std.testing.expectEqual(result.?.dummy, 1);
}

test "chooseFirstNonNullRoadmap returns second when first null" {
    const r1: ?Roadmap = null;
    const r2 = Roadmap{ .dummy = 2 };
    const result = chooseFirstNonNullRoadmap(r1, r2);
    if (result == null) {
        std.assert(false, "expected not null");
    } else {
        std.assert(result.dummy == 2);
    }
}

test "chooseFirstNonNullRoadmap returns null when both null" {
    const r1: ?Roadmap = null;
    const r2: ?Roadmap = null;
    const result = chooseFirstNonNullRoadmap(r1, r2);
    std.assert(result == null);
}

test "queenDataRouteDecision returns success when url present" {
    const url = "http://example.com";
    const roadmap = &Roadmap{ .dummy = 0 };
    const board = BoardFacts{ .dummy = 0 };
    const (status, body) = queenDataRouteDecision(&url, roadmap, board);
    std.assert(status == 200);
    std.assert(std.mem.eql(u8, body, "success"));
}

test "queenDataRouteDecision returns error when url null" {
    const url: []const u8 = null;
    const roadmap = &Roadmap{ .dummy = 0 };
    const board = BoardFacts{ .dummy = 0 };
    const (status, body) = queenDataRouteDecision(url, roadmap, board);
    std.assert(status == 503);
    std.assert(std.mem.eql(u8, body, "error"));
}

test "queenRoadmapRouteDecision returns shell" {
    const (status, body) = queenRoadmapRouteDecision();
    std.assert(status == 200);
    std.assert(std.mem.eql(u8, body, "shell"));
}