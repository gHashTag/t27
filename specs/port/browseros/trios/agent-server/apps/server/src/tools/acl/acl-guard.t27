}

test checkAcl_unguarded_tool {
    const toolName = "unknown_tool";
    const args = "page: 1";
    const browser = undefined;
    const rules: [0]AclRule = .{};
    
    const result = checkAcl(toolName, args, browser, &rules);
    assert(!result.blocked);
    assert(result.rule == null);
    assert(result.pageId == null);
    assert(result.elementId == null);
}

test checkAcl_no_rules {
    const toolName = "click";
    const args = "page: 1";
    const browser = undefined;
    const rules: [0]AclRule = .{};
    
    const result = checkAcl(toolName, args, browser, &rules);
    assert(!result.blocked);
    assert(result.rule == null);
    assert(result.pageId == null);
    assert(result.elementId == null);
}

test checkAcl_no_page_id {
    const toolName = "click";
    const args = "other_field: value"; // No page field
    const browser = undefined;
    const rules: [0]AclRule = .{};
    
    const result = checkAcl(toolName, args, browser, &rules);
    assert(!result.blocked);
    assert(result.rule == null);
    assert(result.pageId == null);
    assert(result.elementId == null);
}