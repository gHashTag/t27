module acl::guard;

// Port of GUARDED_TOOLS set from the original TypeScript
const GUARDED_TOOLS = [
    "click",
    "click_at", 
    "fill",
    "type_at",
    "hover",
    "hover_at",
    "drag",
    "drag_at",
    "focus",
    "clear",
    "check",
    "uncheck",
    "select_option",
    "press_key",
    "upload_file"
];

// Port of AclCheckResult interface from the original TypeScript
struct AclCheckResult {
    blocked: bool,
    rule: ?AclRule,
    pageId: ?i32,
    elementId: ?i32
}

// Port of AclRule interface from the original TypeScript  
struct AclRule {
    id: i32,
    sitePattern: []const u8,
    selector: ?[]const u8,
    textMatch: ?[]const u8,
    description: ?[]const u8
}

// Port of resolveTargetElementId function from the original TypeScript
pub fn resolveTargetElementId(
    toolName: []const u8,
    args: *const Record,
    browser: *const Browser,
    pageId: i32
) -> ?i32 {
    // Check if args.element is a number
    if (args.element != null) {
        const elementValue = args.element.?;
        return @as(?i32, @intCast(@as(usize, @bitCast(elementValue))));
    }
    
    // Check for drag tool with sourceElement
    if (std.mem.eql(u8, toolName, "drag") and args.sourceElement != null) {
        const sourceElementValue = args.sourceElement.?;
        return @as(?i32, @intCast(@as(usize, @bitCast(sourceElementValue))));
    }
    
    // Check for coordinates and resolve element at point
    if (args.x != null and args.y != null) {
        // This would call browser.resolveElementAtPoint in the actual implementation
        // For now, return undefined since we can't call external functions
        return null;
    }
    
    // Check for drag_at tool with start coordinates
    if (std.mem.eql(u8, toolName, "drag_at") and args.startX != null and args.startY != null) {
        // This would call browser.resolveElementAtPoint in the actual implementation
        // For now, return undefined since we can't call external functions
        return null;
    }
    
    return null;
}

// Port of checkAcl function from the original TypeScript
pub fn checkAcl(
    toolName: []const u8,
    args: *const Record,
    browser: *const Browser,
    rules: *const []const AclRule
) -> AclCheckResult {
    // Check if tool is in GUARDED_TOOLS
    var isGuarded = false;
    for (const tool in GUARDED_TOOLS) {
        if (std.mem.eql(u8, toolName, tool)) {
            isGuarded = true;
            break;
        }
    }
    if (!isGuarded) {
        return AclCheckResult{ .blocked = false, .rule = null, .pageId = null, .elementId = null };
    }
    
    // Check if rules exist
    if (rules.len == 0) {
        return AclCheckResult{ .blocked = false, .rule = null, .pageId = null, .elementId = null };
    }
    
    // Get pageId from args
    const pageId = args.page.?;
    if (pageId == null) {
        return AclCheckResult{ .blocked = false, .rule = null, .pageId = null, .elementId = null };
    }
    
    // This would call browser.refreshPageInfo in the actual implementation
    // For now, assume page info is available
    const pageInfo: ?PageInfo = null;
    if (pageId == null) {
        return AclCheckResult{ .blocked = false, .rule = null, .pageId = null, .elementId = null };
    }
    
    // Filter rules by site pattern
    var siteRules: []const AclRule = undefined;
    var siteRulesCount: usize = 0;
    for (const rule in rules) {
        if (matchesSitePattern(pageInfo.?.url, rule.sitePattern)) {
            siteRules[siteRulesCount] = rule;
            siteRulesCount += 1;
        }
    }
    
    if (siteRulesCount == 0) {
        return AclCheckResult{ .blocked = false, .rule = null, .pageId = null, .elementId = null };
    }
    
    // Check for site-only rule
    for (const rule in siteRules) {
        if (rule.selector == null and rule.textMatch == null and rule.description == null) {
            // Log the block (in real implementation)
            return AclCheckResult{ 
                .blocked = true, 
                .rule = rule, 
                .pageId = pageId.?, 
                .elementId = null 
            };
        }
    }
    
    // Resolve target element ID
    const elementId = resolveTargetElementId(toolName, args, browser, pageId.?);
    if (elementId == null) {
        return AclCheckResult{ .blocked = false, .rule = null, .pageId = null, .elementId = null };
    }
    
    // This would call browser.resolveElementProperties in the actual implementation
    const props: ?ElementProperties = null;
    if (props == null) {
        return AclCheckResult{ .blocked = false, .rule = null, .pageId = null, .elementId = null };
    }
    
    // This would call scoreFixture in the actual implementation
    const decision: Decision = undefined;
    
    if (decision.blocked) {
        // Find matched rule
        var matchedRule: ?AclRule = null;
        if (decision.matchedRuleId != null) {
            for (const rule in rules) {
                if (rule.id == decision.matchedRuleId.?) {
                    matchedRule = rule;
                    break;
                }
            }
        }
        
        // Log the block (in real implementation)
        return AclCheckResult{ 
            .blocked = true, 
            .rule = matchedRule, 
            .pageId = pageId.?, 
            .elementId = elementId.? 
        };
    }
    
    return AclCheckResult{ .blocked = false, .rule = null, .pageId = null, .elementId = null };
}

// Helper function to match site patterns (placeholder implementation)
fn matchesSitePattern(url: []const u8, pattern: []const u8) -> bool {
    // In the original, this would import from '@browseros/shared/acl/match'
    // For now, return a simple implementation
    return std.mem.indexOf(u8, url, pattern) != null;
}

// Test for resolveTargetElementId with direct element ID
test resolveTargetElementId_direct_element {
    const args = Record{ .element = @as(Record, @intCast(@as(usize, @bitCast(42)))) };
    const result = resolveTargetElementId("click", &args, undefined, 1);
    assert(result.? == 42);
}

// Test for checkAcl with non-guarded tool
test checkAcl_non_guarded_tool {
    const args = Record{ .page = @as(Record, @intCast(@as(usize, @bitCast(1)))) };
    const rules: []const AclRule = undefined;
    const result = checkAcl("unknown_tool", &args, undefined, &rules);
    assert(!result.blocked);
}

// Test for checkAcl with empty rules
test checkAcl_empty_rules {
    const args = Record{ .page = @as(Record, @intCast(@as(usize, @bitCast(1)))) };
    const rules: []const AclRule = undefined;
    const result = checkAcl("click", &args, undefined, &rules);
    assert(!result.blocked);
}