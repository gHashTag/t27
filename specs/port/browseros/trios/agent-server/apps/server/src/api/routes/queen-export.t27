// Port of issueOf function - pure logic
// Original: function issueOf(branch: string): number | null
pub fn issueOf(branch: []const u8) -> ?i32 {
    // Original: /^queen-(\d+)$/.exec(branch.trim())
    if (branch.len < 7) return null; // "queen-" is 6 chars
    
    // Check prefix "queen-"
    var i: usize = 0;
    while (i < 6) {
        if (branch[i] != "queen-"[i]) return null;
        i += 1;
    }
    
    // Extract digits after "queen-"
    var result: i32 = 0;
    var digit_count: usize = 0;
    var j: usize = 6;
    var in_digits = false;
    
    while (j < branch.len) {
        const c = branch[j];
        if (c >= '0' and c <= '9') {
            result = result * 10 + (c - '0');
            digit_count += 1;
            in_digits = true;
        } else if (c == ' ' or c == '\t' or c == '\n' or c == '\r') {
            // Skip whitespace
        } else if (in_digits) {
            // Found non-digit after digits - stop parsing
            break;
        } else {
            // Found non-digit before any digits - invalid
            return null;
        }
        j += 1;
    }
    
    return if (digit_count > 0) result else null;
}

