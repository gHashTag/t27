module port::browseros::trios::agent-server::apps::server::src::api::routes::queen_runners;

// Port of trios/agent-server/apps/server/src/api/routes/queen-runners.ts
// (hand-written TypeScript, 216 lines, 4 functions).
//
// The runner cabinet, and the door a runner knocks on.
//
//   /queen/me/runners   the PERSON, with the bearer token app.t27.ai issued
//                       them. Lists, mints and revokes that person's runner
//                       tokens - nobody else's.
//
//   /queen/runner       the RUNNER, with the token minted above. It says it
//                       is alive, claims the task the round offered its lane,
//                       and hands the work back as a pushed branch.
//
// Neither route accepts, stores or returns a provider key. What .t27 holds is
// the DECISION inside each function: which status a request is answered with,
// which token answer is the only one, and what the runner is told. Everything
// that touches the world - Hono, the pool, the bearer header, the logger, the
// imported services - is a shell with an `undefined;` body no test calls, or
// a parameter the caller passes.

// What a runner speaks. 1 was "registered, nothing to take"; 2 is heartbeat,
// claim and complete. A runner that reads a protocol it does not know stops.
pub const RUNNER_PROTOCOL: i32 = 2;

// Number.isSafeInteger's ceiling: a runner id from a path is trusted only up
// to here, and only above zero.
const MAX_SAFE_INTEGER: i64 = 9007199254740991;

// An opaque database handle - the original's Queryable, as far as .t27 can
// hold it. The caller passes one; nothing here opens a connection.
pub struct QueenPool {
    _dummy: u8,
}

// The Hono app both route creators would build - an opaque handle.
pub struct Route {
    _dummy: u8,
}

// RunnerRouteDeps, as far as .t27 can hold it: which of the three dependency
// slots (pool, identify, complete) the caller brought their own value for.
// The values themselves - a database handle, an identity check, the work
// hand-back - cannot be held here; the caller passes them.
pub struct GivenDeps {
    poolGiven: bool,
    identifyGiven: bool,
    completeGiven: bool,
}

// The same three slots, resolved: true means the route fell back to that
// slot's default (defaultPool, createAppIdentity(), completeRunnerWork in the
// original). A dep the caller passed always wins.
pub struct ResolvedDeps {
    poolIsDefault: bool,
    identifyIsDefault: bool,
    completeIsDefault: bool,
}

// ------------------------------------------------------------------
// defaultPool - the pool side
// ------------------------------------------------------------------

// defaultPool's URL decision, minus the pool it cannot hold: which database
// URL the route would connect to. DATABASE_URL wins, RAILWAY_SSOT_URL is the
// fallback, and an empty string is unset exactly as `||` reads it - neither
// variable set means no pool, and the route answers 503.
pub fn defaultPoolUrl(dbUrl: ?[]const u8, railwayUrl: ?[]const u8) -> ?[]const u8 {
    if (dbUrl != null) {
        if (dbUrl.?.len > 0) {
            return dbUrl.?;
        }
    }
    if (railwayUrl != null) {
        if (railwayUrl.?.len > 0) {
            return railwayUrl.?;
        }
    }
    return null;
}

// One pool for the life of the process, created on first use: a pool per
// request that is never ended is a connection leak with a delay on it. True
// when the next call would create the pool every later call reuses.
pub fn poolNeedsCreating(sharedPoolPresent: bool) -> bool {
    return !sharedPoolPresent;
}

// The original keeps its name. Its body reads the environment, memoizes the
// pool in module state and builds it - the world, which .t27 cannot hold.
// Its decision lives in defaultPoolUrl and poolNeedsCreating above. No test
// calls it.
pub fn defaultPool() -> ?QueenPool {
    undefined;
}

// ------------------------------------------------------------------
// defaults - pure, so it keeps its body
// ------------------------------------------------------------------

// defaults fills the slots the caller left open: a dep the caller passed
// wins, an unprovided slot falls to its default.
pub fn defaults(given: GivenDeps) -> ResolvedDeps {
    return ResolvedDeps {
        poolIsDefault: !given.poolGiven,
        identifyIsDefault: !given.identifyGiven,
        completeIsDefault: !given.completeGiven,
    };
}

// ------------------------------------------------------------------
// createQueenCabinetRoute - /queen/me/runners, the PERSON
// ------------------------------------------------------------------

// The cabinet middleware's verdict before any handler runs: 401 "Sign in to
// app.t27.ai first" with no bearer, 503 "Sign-in service did not answer"
// when identity checking threw IdentityUnavailableError, 401 "The session
// was refused" when the issuer returned no person, and 0 when the request
// may proceed. Any other error from the issuer stays the caller's to handle.
pub fn cabinetGate(hasBearer: bool, identityUnavailable: bool, identified: bool) -> i32 {
    if (!hasBearer) {
        return 401;
    }
    if (identityUnavailable) {
        return 503;
    }
    if (!identified) {
        return 401;
    }
    return 0;
}

// Every cabinet handler answers 503 "No database configured" first when the
// route has no pool to talk to; 0 means a handler may run.
pub fn databaseGate(poolPresent: bool) -> i32 {
    if (!poolPresent) {
        return 503;
    }
    return 0;
}

// A runner needs a name: a label cleanLabel left empty is a 400.
pub fn labelGate(label: []const u8) -> i32 {
    if (label.len == 0) {
        return 400;
    }
    return 0;
}

// The mint: 201 with the one answer that ever carries the token when the
// runner was made; 409 "At most N runners; revoke one first" when the
// person's cabinet is already full. The count itself is the service's
// MAX_RUNNERS_PER_PERSON - not held here, not guessed at.
pub fn mintVerdict(madeOk: bool) -> i32 {
    if (!madeOk) {
        return 409;
    }
    return 201;
}

// A runner id from the path is trusted exactly when Number() made a safe
// positive integer of it; anything else is the same 404 "No such runner".
pub fn isValidRunnerId(id: i64) -> bool {
    return id > 0 && id <= MAX_SAFE_INTEGER;
}

// The revoke: 204 when this person's runner was revoked, 404 otherwise.
// Someone else's runner and no runner at all are the same answer - the
// cabinet does not confirm which ids exist.
pub fn revokeVerdict(done: bool) -> i32 {
    if (done) {
        return 204;
    }
    return 404;
}

// The original keeps its name. Its body builds the Hono app for
// /queen/me/runners - the HTTP framework, which .t27 cannot hold. Its
// verdicts live in the helpers above; every answer is Cache-Control:
// no-store. No test calls it.
pub fn createQueenCabinetRoute(given: GivenDeps) -> Route {
    undefined;
}

// ------------------------------------------------------------------
// createQueenRunnerRoute - /queen/runner, the RUNNER
// ------------------------------------------------------------------

// The runner door's verdict before any handler runs: 503 "No database
// configured" with no pool, 401 "Unknown or revoked runner" with no bearer
// token - the heartbeat is never asked - and 401 again when the token does
// not resolve to a live runner. 0 when the request may proceed.
pub fn runnerGate(poolPresent: bool, tokenPresent: bool, heartbeatFound: bool) -> i32 {
    if (!poolPresent) {
        return 503;
    }
    if (!tokenPresent) {
        return 401;
    }
    if (!heartbeatFound) {
        return 401;
    }
    return 0;
}

// The heartbeat's note, in the original's order: a swarm that is not handing
// tasks to runners right now says so; a held task says whether it is already
// claimed; with nothing held, the next round may still offer one.
pub fn heartbeatNote(runnersEnabled: bool, holding: bool, claimed: bool) -> str {
    if (!runnersEnabled) {
        return "This swarm is not handing tasks to runners right now.";
    }
    if (!holding) {
        return "Nothing for you yet; the next round may offer a task.";
    }
    if (claimed) {
        return "Lease renewed.";
    }
    return "A task is waiting for you: claim it.";
}

// The complete handler's verdict: 400 for a body parseCompleteBody refused,
// the work's own status when it refuses the hand-back, 200 when the branch
// came home and the task was closed.
pub fn completeVerdict(bodyError: bool, doneOk: bool, doneStatus: i32) -> i32 {
    if (bodyError) {
        return 400;
    }
    if (!doneOk) {
        return doneStatus;
    }
    return 200;
}

// The original keeps its name. Its body builds the Hono app for /queen/runner
// - the HTTP framework, which .t27 cannot hold. Its verdicts live in the
// helpers above; every answer is Cache-Control: no-store. No test calls it.
pub fn createQueenRunnerRoute(given: GivenDeps) -> Route {
    undefined;
}

// ------------------------------------------------------------------
// Tests. The three shells above are called by none of them.
// ------------------------------------------------------------------

test RUNNER_PROTOCOL_speaks_v2 {
    assert(RUNNER_PROTOCOL == 2);
}

test defaultPoolUrl_DATABASE_URL_takes_priority {
    const result = defaultPoolUrl("postgres://local", "postgres://railway");
    assert(result != null);
    assert(result.? == "postgres://local");
}

test defaultPoolUrl_falls_back_to_RAILWAY_SSOT_URL {
    const result = defaultPoolUrl(null, "postgres://railway");
    assert(result != null);
    assert(result.? == "postgres://railway");
}

test defaultPoolUrl_empty_DATABASE_URL_is_unset {
    // An empty string is unset, exactly as `||` reads it.
    const result = defaultPoolUrl("", "postgres://railway");
    assert(result != null);
    assert(result.? == "postgres://railway");
}

test defaultPoolUrl_neither_set_means_no_pool {
    // Neither variable set: no pool, and the route answers 503.
    const result = defaultPoolUrl(null, null);
    assert(result == null);
}

test poolNeedsCreating_created_once_reused_after {
    assert(poolNeedsCreating(false) == true);
    assert(poolNeedsCreating(true) == false);
}

test defaults_fills_the_slots_the_caller_left_open {
    const none = GivenDeps { poolGiven: false, identifyGiven: false, completeGiven: false };
    const all = GivenDeps { poolGiven: true, identifyGiven: true, completeGiven: true };
    const mixed = GivenDeps { poolGiven: true, identifyGiven: false, completeGiven: true };

    // Nothing brought: every slot falls to its default.
    const r0 = defaults(none);
    assert(r0.poolIsDefault == true);
    assert(r0.identifyIsDefault == true);
    assert(r0.completeIsDefault == true);

    // Everything brought: nothing falls back.
    const r1 = defaults(all);
    assert(r1.poolIsDefault == false);
    assert(r1.identifyIsDefault == false);
    assert(r1.completeIsDefault == false);

    // Mixed: exactly the unprovided slots fall back.
    const r2 = defaults(mixed);
    assert(r2.poolIsDefault == false);
    assert(r2.identifyIsDefault == true);
    assert(r2.completeIsDefault == false);
}

test cabinetGate_verdicts {
    // No bearer: refused before the issuer is ever asked.
    assert(cabinetGate(false, false, false) == 401);
    // The sign-in service did not answer.
    assert(cabinetGate(true, true, false) == 503);
    // The session was refused.
    assert(cabinetGate(true, false, false) == 401);
    // Identified: the request proceeds to a handler.
    assert(cabinetGate(true, false, true) == 0);
}

test databaseGate_verdicts {
    assert(databaseGate(false) == 503);
    assert(databaseGate(true) == 0);
}

test labelGate_and_mintVerdict {
    assert(labelGate("") == 400);
    assert(labelGate("scout") == 0);
    assert(mintVerdict(false) == 409);
    assert(mintVerdict(true) == 201);
}

test isValidRunnerId_safe_positive_integers_only {
    assert(isValidRunnerId(1) == true);
    assert(isValidRunnerId(42) == true);
    assert(isValidRunnerId(9007199254740991) == true);
    assert(isValidRunnerId(0) == false);
    assert(isValidRunnerId(-3) == false);
    assert(isValidRunnerId(9007199254740992) == false);
}

test revokeVerdict {
    assert(revokeVerdict(true) == 204);
    assert(revokeVerdict(false) == 404);
}

test runnerGate_verdicts {
    // No database.
    assert(runnerGate(false, true, true) == 503);
    // No token: the heartbeat is never asked.
    assert(runnerGate(true, false, false) == 401);
    // Unknown or revoked runner.
    assert(runnerGate(true, true, false) == 401);
    // Alive: the request proceeds to a handler.
    assert(runnerGate(true, true, true) == 0);
}

test heartbeatNote_matches_the_originals_order {
    assert(heartbeatNote(false, true, true) == "This swarm is not handing tasks to runners right now.");
    assert(heartbeatNote(false, false, false) == "This swarm is not handing tasks to runners right now.");
    assert(heartbeatNote(true, false, false) == "Nothing for you yet; the next round may offer a task.");
    assert(heartbeatNote(true, true, true) == "Lease renewed.");
    assert(heartbeatNote(true, true, false) == "A task is waiting for you: claim it.");
}

test completeVerdict {
    // A body the parser refused wins, whatever the work would have said.
    assert(completeVerdict(true, false, 409) == 400);
    assert(completeVerdict(true, true, 200) == 400);
    // The work's refusal carries its own status through.
    assert(completeVerdict(false, false, 409) == 409);
    assert(completeVerdict(false, false, 503) == 503);
    // A handed-back branch is a 200.
    assert(completeVerdict(false, true, 409) == 200);
}
