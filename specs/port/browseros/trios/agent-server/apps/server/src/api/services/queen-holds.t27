module port::browseros::trios::agent_server::apps::server::src::api::services::queen_holds;

// Constants from the original TypeScript
const DECIDED_ACCEPT = "accept";
const DECIDED_FAILED = "failed";
const DECIDED_CANCELLED = "cancelled";
const DECIDED_STALE_CONTRACT = "stale-contract";

// Stage constants from queen-holds.gen.ts
const HS_WORKING: i32 = 0;
const HS_AWAITING: i32 = 1;
const HS_DONE: i32 = 2;
const HS_ESCALATED: i32 = 3;
const HS_SEND_BACK: i32 = 4;

// Port of holdsFiles function - this involves a WASM call so we leave the body undefined
pub fn holdsFiles(stage: i32, minutes: i32) -> bool {
    undefined;
}

// Port of holdStage function - this contains the core decision logic
pub fn holdStage(finished: bool, reviewState: []const u8) -> i32 {
    if (!finished) {
        return HS_WORKING;
    }
    
    if (reviewState == "sendBack") {
        return HS_SEND_BACK;
    }
    
    if (reviewState == "escalate") {
        return HS_ESCALATED;
    }
    
    // Check if verdict is in DECIDED set
    if (reviewState == DECIDED_ACCEPT or reviewState == DECIDED_FAILED or reviewState == DECIDED_CANCELLED or reviewState == DECIDED_STALE_CONTRACT) {
        return HS_DONE;
    }
    
    return HS_AWAITING;
}

// Port of heldPaths function - this contains the core decision logic
pub fn heldPaths(
    finished_at: []const u8,
    review_state: []const u8,
    owned_paths: []const u8,
    now: i64,
) -> []const u8 {
    // Extract owned paths - this involves database/file access so we leave it undefined
    const owned = "";
    
    // Calculate minutes since finished
    const finished = finished_at.len > 0;
    const minutes = if (finished) {
        // This involves date parsing which is external, so we'll pass it as a parameter
        0  // Default to 0, will be set by caller
    } else {
        0
    };
    
    // The core decision logic: return owned if holdsFiles returns true, else empty string
    const stage = holdStage(finished, review_state);
    const shouldHold = holdsFiles(stage, minutes);
    
    if (shouldHold) {
        return owned;
    } else {
        return "";
    }
}

// Test cases for holdsFiles
test holdsFiles_working_stage {
    const result = holdsFiles(0, 5);
    _ = result;
}

test holdsFiles_done_stage {
    const result = holdsFiles(2, 30);
    _ = result;
}

// Test cases for holdStage
test holdStage_not_finished {
    const stage = holdStage(false, "");
    assert(stage == HS_WORKING);
}

test holdStage_send_back {
    const stage = holdStage(true, "sendBack");
    assert(stage == HS_SEND_BACK);
}

test holdStage_escalate {
    const stage = holdStage(true, "escalate");
    assert(stage == HS_ESCALATED);
}

test holdStage_decided {
    const stage = holdStage(true, "accept");
    assert(stage == HS_DONE);
}

test holdStage_awaiting {
    const stage = holdStage(true, "some-other-state");
    assert(stage == HS_AWAITING);
}

test holdStage_empty_verdict {
    const stage = holdStage(true, "");
    assert(stage == HS_AWAITING);
}

// Test cases for heldPaths
test heldPaths_not_finished {
    const result = heldPaths("", "", "", 0);
    assert(result == ""); // should return empty string
}

test heldPaths_finished_with_paths {
    const result = heldPaths("2025-01-01T00:00:00Z", "accept", "", 0);
    assert(result == ""); // should return empty string
}

test heldPaths_working_with_paths {
    const result = heldPaths("", "", "", 0);
    assert(result == ""); // should return empty string
}