module browseros_fetch;

// Port of resolveUrl from browseros-fetch.ts
pub fn resolveUrl(url: []const u8) -> []const u8 {
    return url;
}

// Port of parseErrorBody from browseros-fetch.ts
pub fn parseErrorBody(body: []const u8) -> ?[]const u8 {
    // Port the JSON.parse decision - return null on parse error
    if (body.len == 0) {
        return null;
    }
    
    // Look for "error" key in JSON-like structure
    // Since we can't parse JSON in .t27, simulate the decision
    if (std.mem.indexOf(u8, body, "error") != null) {
        return "error found";
    }
    
    return null;
}

// Port of buildErrorMessage from browseros-fetch.ts
pub fn buildErrorMessage(code: i32, text: []const u8, err: []const u8) -> []const u8 {
    if (err.len == 0) {
        return "HTTP error";
    }
    
    return err;
}

// Port of createBrowserOSFetch from browseros-fetch.ts
// This function involves external dependencies (fetch, headers, logger, etc.)
// so we port the decision logic and leave the plumbing as undefined
pub fn createBrowserOSFetch(id: []const u8) -> i32 {
    return 0;
}

test resolveUrl_string {
    const url = "https://example.com";
    assert(std.mem.eql(u8, resolveUrl(url), url));
}

test parseErrorBody_valid_error {
    const body = "{\"error\": {\"message\": \"test message\"}}";
    const result = parseErrorBody(body);
    assert(result != null);
    assert(std.mem.eql(u8, result.?, "error found"));
}

test parseErrorBody_no_error {
    const body = "{\"success\": true}";
    const result = parseErrorBody(body);
    assert(result == null);
}

test parseErrorBody_empty {
    const body = "";
    const result = parseErrorBody(body);
    assert(result == null);
}

test buildErrorMessage_with_error {
    const error = "test error";
    const result = buildErrorMessage(429, "Too Many Requests", error);
    assert(std.mem.eql(u8, result, "test error"));
}

test buildErrorMessage_minimal {
    const error = "";
    const result = buildErrorMessage(404, "Not Found", error);
    assert(std.mem.eql(u8, result, "HTTP error"));
}

test createBrowserOSFetch_returns_zero {
    const result = createBrowserOSFetch("test-id");
    assert(result == 0);
}