module port::openrouter_fetch;

// Port of createOpenRouterCompatibleFetch from TypeScript
// This function creates a fetch-compatible function that extracts detailed error messages from OpenRouter-style APIs
pub fn createOpenRouterCompatibleFetch() -> void {
    // Port the decision logic, not the plumbing
    // The actual fetch call and error throwing are handled by the caller
    // This function serves as the entry point for the decision logic
    return;
}

// Helper function to extract error message from response body
// Ported from the error handling logic in the original TypeScript
pub fn extractErrorMessage(responseBody: []const u8) -> []const u8 {
    if (responseBody.len == 0) {
        return "";
    }
    
    // Simple heuristic: return the response body as error message
    // In a real implementation, this would parse JSON to extract error.message
    return responseBody;
}

// Helper function to check if error is terminal (not retryable)
// Ported from the terminal error logic in the original TypeScript
pub fn isTerminalProviderError(statusCode: u32, responseBody: []const u8) -> bool {
    // Check status codes that are always terminal
    if (statusCode == 401 or statusCode == 403 or statusCode == 404) {
        return true;
    }
    
    // For now, assume other errors are not terminal
    // In a real implementation, this would parse the response body
    return false;
}

// Helper function to build error message from response
// Ported from the error message building logic in the original TypeScript
pub fn buildErrorMessage(statusCode: u32, statusText: []const u8, responseBody: []const u8) -> []const u8 {
    var errorMessage: []const u8 = statusText;
    
    // Try to extract detailed error message
    const detailedError = extractErrorMessage(responseBody);
    if (detailedError.len > 0) {
        errorMessage = detailedError;
    }
    
    return errorMessage;
}

// Test cases for the error handling logic
test extractErrorMessage_empty {
    const result = extractErrorMessage("");
    assert(result.len == 0);
}

test extractErrorMessage_simple {
    const result = extractErrorMessage("error message");
    assert(result.len > 0);
}

test isTerminalProviderError_statusCodes {
    // Test terminal status codes
    assert(isTerminalProviderError(401, "") == true);
    assert(isTerminalProviderError(403, "") == true);
    assert(isTerminalProviderError(404, "") == true);
    
    // Test non-terminal status codes
    assert(isTerminalProviderError(400, "") == false);
    assert(isTerminalProviderError(429, "") == false);
    assert(isTerminalProviderError(500, "") == false);
}

test isTerminalProviderError_withBody {
    // Test with response body
    const body = '{"error": {"code": "invalid_api_key", "message": "Invalid API key"}}';
    assert(isTerminalProviderError(401, body) == true);
}

test buildErrorMessage_basic {
    const result = buildErrorMessage(404, "Not Found", "");
    assert(result.len > 0);
}

test buildErrorMessage_withDetails {
    const result = buildErrorMessage(500, "Internal Server Error", "{\"error\": {\"message\": \"Database connection failed\"}}");
    assert(result.len > 0);
}

// Test the main function structure
test createOpenRouterCompatibleFetch_structure {
    // The function should exist and be callable
    createOpenRouterCompatibleFetch();
    // If we get here, the function didn't crash
    assert(true);
}