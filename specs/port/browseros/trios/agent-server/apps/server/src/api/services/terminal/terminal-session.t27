module port::browseros::trios::agent_server::apps::server::src::api::services::terminal::terminal_session;

// Port of gHashTag/BrowserOS trios/agent-server/apps/server/src/api/services/
// terminal/terminal-session.ts at 928e1624a50e (109 lines, 3 functions).
//
// The decisions become pure functions and constants. Everything that touches
// the world - Bun.spawn, the pty, TextDecoder, process.env, the logger - is
// either a parameter the caller passes in or named in a comment where it was
// dropped. Three pieces from outside the quoted source are not reproduced:
// buildNerdctlCommand (line 40, ../../../lib/container), the value of
// OPENCLAW_TERMINAL_SHELL (line 46) and of OPENCLAW_CONTAINER_HOME (line 8),
// both imported from @browseros/shared/constants/openclaw.

// Lines 9-10: the pty is opened 80x24.
const DEFAULT_COLS: usize = 80;
const DEFAULT_ROWS: usize = 24;
// Line 11: TERM forced inside the container.
const TERMINAL_NAME: []const u8 = "xterm-256color";
// Line 67: the spawn cwd is always '/'.
const SESSION_CWD: []const u8 = "/";

// The argv that runs the terminal shell inside the container (lines 29-49):
// `limactl shell <vm> -- nerdctl exec -it -w <workingDir> <container> <shell>`.
pub struct TerminalArgv {
    args: [10][]const u8,
    len: usize,
}

// Lines 29-49: buildTerminalExecCommand assembles that argv into a
// fixed-capacity TerminalArgv and returns it.
pub fn buildTerminalExecCommand(limactlPath: []const u8, vmName: []const u8, containerName: []const u8, workingDir: []const u8, shell: []const u8) -> TerminalArgv {
    var args: [10][]const u8 = undefined;
    args[0] = limactlPath;
    args[1] = "shell";
    args[2] = vmName;
    args[3] = "--";
    args[4] = "exec";
    args[5] = "-it";
    args[6] = "-w";
    args[7] = workingDir;
    args[8] = containerName;
    args[9] = shell;
    return TerminalArgv { args: args, len: 10 };
}

// The effective environment of the spawned terminal (lines 51-53): LIMA_HOME
// is forced to limaHome and TERM to TERMINAL_NAME. The inherited process.env
// is the caller's world; the only key the original reads before overriding it
// is TERM, and TERM always loses to TERMINAL_NAME.
pub struct TerminalEnv {
    limaHome: []const u8,
    term: []const u8,
}

pub fn buildTerminalEnv(limaHome: []const u8) -> TerminalEnv {
    return TerminalEnv { limaHome: limaHome, term: TERMINAL_NAME };
}

// Lines 13-21: the facts createTerminalSession reads. The onOutput and onExit
// callbacks have no function values in .t27 today and are named in the port
// report rather than faked.
pub struct TerminalSessionDeps {
    containerName: []const u8,
    limaHome: []const u8,
    limactlPath: []const u8,
    vmName: []const u8,
    workingDir: []const u8,
}

// Lines 55-108: the spawn itself - Bun.spawn with cwd SESSION_CWD, the pty,
// TextDecoder, the returned close/resize/writeInput handle and the exited
// promise - is the world. Its decisions are ported above and below: the argv
// and the effective environment, the 80x24 defaults, the empty-chunk guard
// (forwardsChunk) and the close-once guard (shouldCleanup).
pub fn createTerminalSession(deps: TerminalSessionDeps) {
    undefined;
}

// Line 73 (and the trailing flush on line 83): a decoded chunk is forwarded
// to onOutput only when it is non-empty.
pub fn forwardsChunk(chunkLen: usize) -> bool {
    return chunkLen > 0;
}

// Line 97: close() is idempotent - cleanup and kill run only on the first
// call; every later call returns immediately. The cleanup itself is wrapped
// in try/catch in the original: a kill failure is only logged, never thrown.
pub fn shouldCleanup(closed: bool) -> bool {
    return !closed;
}

test buildTerminalExecCommand_wraps_nerdctl_exec_in_limactl_shell {
    const argv = buildTerminalExecCommand("/usr/local/bin/limactl", "browseros-vm", "openclaw", "/home/user/work", "/bin/bash");
    assert(argv.len == 10);
    assert(argv.args[0] == "/usr/local/bin/limactl");
    assert(argv.args[1] == "shell");
    assert(argv.args[2] == "browseros-vm");
    assert(argv.args[3] == "--");
    assert(argv.args[4] == "exec");
    assert(argv.args[5] == "-it");
    assert(argv.args[6] == "-w");
    assert(argv.args[7] == "/home/user/work");
    assert(argv.args[8] == "openclaw");
    assert(argv.args[9] == "/bin/bash");
}

test buildTerminalExecCommand_places_working_dir_after_w_flag {
    const argv = buildTerminalExecCommand("limactl", "vm-7", "c", "/var/work", "/bin/sh");
    assert(argv.len == 10);
    assert(argv.args[2] == "vm-7");
    assert(argv.args[6] == "-w");
    assert(argv.args[7] == "/var/work");
    assert(argv.args[8] == "c");
}

test buildTerminalEnv_sets_term_and_lima_home {
    const env = buildTerminalEnv("/home/user/.lima");
    assert(env.limaHome == "/home/user/.lima");
    assert(env.term == "xterm-256color");
}

test forwardsChunk_guards_empty_decoded_output {
    assert(!forwardsChunk(0));
    assert(forwardsChunk(1));
    assert(forwardsChunk(4096));
}

test shouldCleanup_runs_only_on_first_close {
    assert(shouldCleanup(false));
    assert(!shouldCleanup(true));
}

test terminal_defaults_match_the_original {
    assert(DEFAULT_COLS == 80);
    assert(DEFAULT_ROWS == 24);
    assert(SESSION_CWD == "/");
    assert(TERMINAL_NAME == "xterm-256color");
}
