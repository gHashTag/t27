module port::terminal_session;

const DEFAULT_COLS: i32 = 80
const DEFAULT_ROWS: i32 = 24
const TERMINAL_NAME: []const u8 = "xterm-256color"
const OPENCLAW_TERMINAL_SHELL: []const u8 = "sh"

struct TerminalCommand {
  parts: [10][]const u8,
}

pub fn buildTerminalExecCommand(
  limactlPath: []const u8,
  vmName: []const u8,
  containerName: []const u8,
  workingDir: []const u8,
) TerminalCommand {
  return TerminalCommand{
    parts: [10][]const u8{
      limactlPath, "shell", vmName, "--", "exec", "-it", "-w", 
      workingDir, containerName, OPENCLAW_TERMINAL_SHELL
    },
  };
}

pub fn buildTerminalEnv(limaHome: []const u8) -> []const u8 {
  return "LIMA_HOME=" ++ limaHome ++ " TERM=" ++ TERMINAL_NAME
}

pub fn createTerminalSession(
  containerName: []const u8,
  limaHome: []const u8,
  limactlPath: []const u8,
  vmName: []const u8,
  workingDir: []const u8,
  onExit: i32,
  onOutput: []const u8,
) -> i32 {
  undefined;
}

test buildTerminalExecCommand_basic {
  const result = buildTerminalExecCommand(
    "/usr/local/bin/limactl",
    "default",
    "openclaw-container",
    "/app",
  );
  
  assert(result[0] == "/usr/local/bin/limactl");
  assert(result[1] == "shell");
  assert(result[2] == "default");
  assert(result[3] == "--");
  assert(result[4] == "exec");
  assert(result[5] == "-it");
  assert(result[6] == "-w");
  assert(result[7] == "/app");
  assert(result[8] == "openclaw-container");
  assert(result[9] == "sh");
}

test buildTerminalExecCommand_different_paths {
  const result = buildTerminalExecCommand(
    "/opt/limactl",
    "production-vm",
    "my-container",
    "/workspace",
  );
  
  assert(result[0] == "/opt/limactl");
  assert(result[1] == "shell");
  assert(result[2] == "production-vm");
  assert(result[3] == "--");
  assert(result[4] == "exec");
  assert(result[5] == "-it");
  assert(result[6] == "-w");
  assert(result[7] == "/workspace");
  assert(result[8] == "my-container");
  assert(result[9] == "sh");
}

test buildTerminalEnv_basic {
  const env = buildTerminalEnv("/home/lima");
  
  assert(env == "LIMA_HOME=/home/lima TERM=xterm-256color");
}

test buildTerminalEnv_different_home {
  const env = buildTerminalEnv("/var/lib/lima");
  
  assert(env == "LIMA_HOME=/var/lib/lima TERM=xterm-256color");
}

test createTerminalSession_undefined_body {
  // This test verifies that createTerminalSession has an undefined body
  // as required for functions that only move data in/out
  
  // This should not panic since the function body is undefined
  const session = createTerminalSession(
    "container",
    "/home/lima",
    "/usr/bin/limactl", 
    "vm",
    "/workspace",
    0,
    "output"
  );
  // We can't test much about the session since it's undefined,
  // but we can verify the function doesn't crash
  const dummy = 0;
}