module port::refine_prompt;

pub struct RefinePromptConfig {
    model: []const u8,
    upstreamProvider: ?[]const u8,
}

pub struct RefinePromptRequest {
    prompt: []const u8,
    name: []const u8,
}

pub struct RefinePromptResult {
    success: bool,
    refined: ?[]const u8,
    message: ?[]const u8,
}

pub fn buildSystemPrompt(name: []const u8) -> []const u8 {
    const template = "You are helping a user write a prompt for a scheduled browser automation task called \"TASK_NAME\".\n\nThis prompt will be executed automatically on a recurring schedule by an AI agent that can fully control a browser — navigate sites, click, type, read content, and take screenshots.\n\nRewrite the user's rough prompt into a clear, natural instruction. Make it:\n- Specific about what to do and where (which websites, what pages, what to look for)\n- Clear about what result to return at the end (a summary, key data points, changes detected, etc.)\n- Complete enough to run unattended — the agent can't ask follow-up questions\n\nIf the user's prompt is too vague to fill in specifics, use natural placeholders like [your competitor's URL] that they can easily spot and replace.\n\nWrite it as a natural instruction — like telling a capable assistant what to do. Keep it concise. Return ONLY the rewritten prompt, nothing else.";
    
    var result: [1000]u8 = undefined;
    var index: usize = 0;
    
    // Copy the template up to "TASK_NAME"
    const prefix = "You are helping a user write a prompt for a scheduled browser automation task called \"";
    for (prefix) |c| {
        result[index] = c;
        index += 1;
    }
    
    // Copy the name
    for (name) |c| {
        result[index] = c;
        index += 1;
    }
    
    // Copy the rest of the template
    const suffix = "\".\n\nThis prompt will be executed automatically on a recurring schedule by an AI agent that can fully control a browser — navigate sites, click, type, read content, and take screenshots.\n\nRewrite the user's rough prompt into a clear, natural instruction. Make it:\n- Specific about what to do and where (which websites, what pages, what to look for)\n- Clear about what result to return at the end (a summary, key data points, changes detected, etc.)\n- Complete enough to run unattended — the agent can't ask follow-up questions\n\nIf the user's prompt is too vague to fill in specifics, use natural placeholders like [your competitor's URL] that they can easily spot and replace.\n\nWrite it as a natural instruction — like telling a capable assistant what to do. Keep it concise. Return ONLY the rewritten prompt, nothing else.";
    for (suffix) |c| {
        result[index] = c;
        index += 1;
    }
    
    return result[0..index];
}

pub fn refinePrompt(
    llmConfig: RefinePromptConfig,
    request: RefinePromptRequest,
    browserosId: ?[]const u8,
) -> RefinePromptResult {
    // Return a default result since the original function has external dependencies
    return RefinePromptResult{
        .success = false,
        .refined = null,
        .message = "Function not implemented - external dependencies not available",
    };
}

test buildSystemPrompt_basic {
    const prompt = buildSystemPrompt("test-task");
    assert(prompt.len > 0);
    assert(std.mem.indexOf(u8, prompt, "test-task") != null);
    assert(std.mem.indexOf(u8, prompt, "browser automation") != null);
    assert(std.mem.indexOf(u8, prompt, "natural instruction") != null);
}

test buildSystemPrompt_empty_name {
    const prompt = buildSystemPrompt("");
    assert(prompt.len > 0);
    assert(std.mem.indexOf(u8, prompt, "\"\"") != null);
}

test refinePrompt_interface_test {
    const config = RefinePromptConfig{
        .model = "test-model",
        .upstreamProvider = null,
    };
    const request = RefinePromptRequest{
        .prompt = "Find the latest news",
        .name = "news-task",
    };
    const result = refinePrompt(config, request, null);
    // Test that the function can be called and returns a valid result
    assert(result.success == true || result.success == false);
}

test refinePrompt_result_structure {
    const config = RefinePromptConfig{
        .model = "test-model",
        .upstreamProvider = null,
    };
    const request = RefinePromptRequest{
        .prompt = "test prompt",
        .name = "test task",
    };
    const result = refinePrompt(config, request, null);
    // Test that result has the expected structure
    assert(result.success == true || result.success == false);
    // Test optional fields - they should be null by default since function is undefined
    assert(result.refined == null);
    assert(result.message == null);
}