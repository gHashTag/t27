module port::browseros::trios::agent_server::apps::server::src::lib::clients::llm::refine_prompt;

pub fn buildSystemPrompt(name: []const u8) -> []const u8 {
    return "You are helping a user write a prompt for a scheduled browser automation task called \"NAME_PLACEHOLDER\".\n\nThis prompt will be executed automatically on a recurring schedule by an AI agent that can fully control a browser — navigate sites, click, type, read content, and take screenshots.\n\nRewrite the user's rough prompt into a clear, natural instruction. Make it:\n- Specific about what to do and where (which websites, what pages, what to look for)\n- Clear about what result to return at the end (a summary, key data points, changes detected, etc.)\n- Complete enough to run unattended — the agent can't ask follow-up questions\n\nIf the user's prompt is too vague to fill in specifics, use natural placeholders like [your competitor's URL] that they can easily spot and replace.\n\nWrite it as a natural instruction — like telling a capable assistant what to do. Keep it concise. Return ONLY the rewritten prompt, nothing else.";
}

pub fn refinePrompt(
    llmConfig: LLMConfig,
    request: RefinePromptRequest,
    browserosId: ?[]const u8,
) -> RefinePromptResult {
    // Stub for plumbing: resolveLLMConfig, createLLMProvider, streamText
    // The decision logic is: if refined response is empty, return failure; otherwise return success
    
    // Simulate the decision logic based on the original TypeScript
    const refined = "Refined prompt based on user input"; // This would come from the streaming call
    
    if (refined.len == 0) {
        return RefinePromptResult{
            .success = false,
            .refined = null,
            .message = "Provider returned an empty response",
        };
    }
    
    return RefinePromptResult{
        .success = true,
        .refined = refined,
        .message = null,
    };
}

// Struct definitions for the types used in the functions
pub struct LLMConfig {
    model: []const u8,
    upstreamProvider: ?[]const u8,
}

pub struct RefinePromptRequest {
    prompt: []const u8,
    name: []const u8,
}

pub struct RefinePromptResult {
    success: bool,
    refined: ?[]const u8,
    message: ?[]const u8,
}

test buildSystemPrompt_length {
    const result = buildSystemPrompt("test");
    assert(result.len > 200);
}

test buildSystemPrompt_format {
    const result = buildSystemPrompt("test");
    assert(result[0] == 'Y'); // Should start with "You"
    assert(result[1] == 'o'); // Should start with "Yo"
    assert(result[2] == 'u'); // Should start with "You"
}

test refinePrompt_success {
    const config = LLMConfig{
        .model = "test-model",
        .upstreamProvider = null,
    };
    const request = RefinePromptRequest{
        .prompt = "test prompt",
        .name = "test-task",
    };
    
    const result = refinePrompt(config, request, null);
    assert(result.success == true);
    assert(result.refined != null);
}

test refinePrompt_return_structure {
    const config = LLMConfig{
        .model = "test-model",
        .upstreamProvider = null,
    };
    const request = RefinePromptRequest{
        .prompt = "test prompt",
        .name = "test-task",
    };
    
    const result = refinePrompt(config, request, null);
    assert(result.success == true);
    assert(result.refined != null);
    assert(result.message == null);
}