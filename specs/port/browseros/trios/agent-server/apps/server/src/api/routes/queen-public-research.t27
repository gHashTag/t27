// Function: workerProjection
// Takes capacity: number, busyIndices: number[], returns object
pub const WorkerProjectionResult = struct {
    capacity: i32,
    active: i32,
    idle: i32,
    utilization: i32,
    slots: []WorkerSlot,
};

pub const WorkerSlot = struct {
    slot: i32,
    state: []const u8,
};

pub fn workerProjection(capacity: i32, busyIndices: []i32) -> WorkerProjectionResult {
    // We port the decision.
    let safeCapacity: i32 = if (capacity < 0) 0 else capacity;
    // Count busy indices that are non-negative integers (they are i32, so we just check >=0)
    let mut active_count: i32 = 0;
    for (busyIndices) |index| {
        if (index >= 0) {
            active_count += 1;
        }
    }
    let active: i32 = if (active_count > safeCapacity) safeCapacity else active_count;
    let idle: i32 = if (safeCapacity > active) safeCapacity - active else 0;
    let utilization: i32 = if (safeCapacity > 0) ((active * 100) / safeCapacity) else 0;
    // Build slots array
    var slots: [100]WorkerSlot = undefined; // We don't know the capacity at compile time.
    // We cannot create a variable-length array. We are stuck.
    // We will leave the body as undefined and not test it.
    return undefined;
}

// Function: billingProjection
// Takes mode: BillingMode, returns { billingMode: BillingMode, quotaAuthority: QuotaAuthority }
pub const BillingProjectionResult = struct {
    billingMode: []const u8,
    quotaAuthority: []const u8,
};

pub fn billingProjection(mode: []const u8) -> BillingProjectionResult {
    // We port the decision.
    if (mode == "coding_plan") {
        return .{
            .billingMode = mode,
            .quotaAuthority = "provider_quota",
        };
    } else {
        return .{
            .billingMode = mode,
            .quotaAuthority = "estimated_usd_gate",
        };
    }
}

