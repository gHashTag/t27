module port::browseros::trios/agent_server/apps/server/src/browser/dom;

const Attribute = struct {
    key: []const u8,
    value: []const u8,
};

const AttrMap = struct {
    items: [32]Attribute,
    len: u32,
};

const DomSearchResult = struct {
    tag: []const u8,
    nodeId: u32,
    backendNodeId: u32,
    attributes: AttrMap,
};

const OutputString = struct {
    data: [200]u8,
    len: u32,
};

pub fn parseNodeAttributes(attributes: [][]const u8) -> AttrMap {
    var map: AttrMap;
    map.len = 0;
    var i: u32 = 0;
    while (i < 32) {
        map.items[i] = .{ .key = [], .value = [] };
        i += 1;
    }
    var j: u32 = 0;
    while (j < attributes.len) {
        if (j + 1 >= attributes.len) {
            break;
        }
        const key = attributes[j];
        const value = attributes[j + 1];
        // Check if key already exists in the map
        var k: u32 = 0;
        var found: bool = false;
        while (k < map.len) {
            if (std.mem.eql(u8, map.items[k].key, key)) {
                map.items[k].value = value;
                found = true;
                break;
            }
            k += 1;
        }
        if (!found && map.len < 32) {
            map.items[map.len] = .{ .key = key, .value = value };
            map.len += 1;
        }
        j += 2;
    }
    return map;
}

pub fn esc(s: []const u8) -> OutputString {
    var out: OutputString = .{ .data = [200]u8{0}, .len = 0 };
    for (c in s) {
        if (out.len >= 200) {
            break;
        }
        if (c == '"' as u8) {
            out.data[out.len] = '\\' as u8;
            out.len += 1;
            if (out.len >= 200) {
                break;
            }
            out.data[out.len] = c;
            out.len += 1;
        } else {
            out.data[out.len] = c;
            out.len += 1;
        }
    }
    return out;
}

pub fn formatSearchResult(result: DomSearchResult) -> OutputString {
    var out: OutputString = .{ .data = [200]u8{0}, .len = 0 };

    // Build header: <tag
    out.data[out.len] = '<' as u8;
    out.len += 1;
    for (c in result.tag) {
        if (out.len >= 200) {
            break;
        }
        out.data[out.len] = c;
        out.len += 1;
    }

    // Build attributes
    var attr_index: u32 = 0;
    while (attr_index < result.attributes.len) {
        const attr = result.attributes.items[attr_index];
        // Space before attribute
        if (out.len >= 200) {
            break;
        }
        out.data[out.len] = ' ' as u8;
        out.len += 1;
        // Key
        for (c in attr.key) {
            if (out.len >= 200) {
                break;
            }
            out.data[out.len] = c;
            out.len += 1;
        }
        // equals sign
        if (out.len >= 200) {
            break;
        }
        out.data[out.len] = '=' as u8;
        out.len += 1;
        // Opening quote
        if (out.len >= 200) {
            break;
        }
        out.data[out.len] = '"' as u8;
        out.len += 1;
        // Escaped value
        const escaped = esc(attr.value);
        for (i in 0..escaped.len) {
            if (out.len >= 200) {
                break;
            }
            out.data[out.len] = escaped.data[i];
            out.len += 1;
        }
        // Closing quote
        if (out.len >= 200) {
            break;
        }
        out.data[out.len] = '"' as u8;
        out.len += 1;
        attr_index += 1;
    }

    // Closing bracket
    if (out.len >= 200) {
        return out;
    }
    out.data[out.len] = '>' as u8;
    out.len += 1;

    // Newline
    if (out.len >= 200) {
        return out;
    }
    out.data[out.len] = '\n' as u8;
    out.len += 1;

    // "  nodeId: "
    if (out.len >= 200) { return out; }
    out.data[out.len] = ' ' as u8; out.len += 1;
    if (out.len >= 200) { return out; }
    out.data[out.len] = ' ' as u8; out.len += 1;
    if (out.len >= 200) { return out; }
    out.data[out.len] = 'n' as u8; out.len += 1;
    if (out.len >= 200) { return out; }
    out.data[out.len] = 'o' as u8; out.len += 1;
    if (out.len >= 200) { return out; }
    out.data[out.len] = 'd' as u8; out.len += 1;
    if (out.len >= 200) { return out; }
    out.data[out.len] = 'e' as u8; out.len += 1;
    if (out.len >= 200) { return out; }
    out.data[out.len] = 'I' as u8; out.len += 1;
    if (out.len >= 200) { return out; }
    out.data[out.len] = 'd' as u8; out.len += 1;
    if (out.len >= 200) { return out; }
    out.data[out.len] = ':' as u8; out.len += 1;
    if (out.len >= 200) { return out; }
    out.data[out.len] = ' ' as u8; out.len += 1;

    // nodeId as decimal string
    var n: u32 = result.nodeId;
    if (n == 0) {
        if (out.len >= 200) {
            return out;
        }
        out.data[out.len] = '0' as u8;
        out.len += 1;
    } else {
        var digits: [10]u8 = [10]u8{0};
        var digit_count: u32 = 0;
        while (n > 0 && digit_count < 10) {
            digits[digit_count] = (n % 10) as u8 + '0' as u8;
            n /= 10;
            digit_count += 1;
        }
        // Reverse digits
        while (digit_count > 0) {
            digit_count -= 1;
            if (out.len >= 200) {
                return out;
            }
            out.data[out.len] = digits[digit_count];
            out.len += 1;
        }
    }

    return out;
}