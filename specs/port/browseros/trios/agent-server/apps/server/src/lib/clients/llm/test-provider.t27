pub fn extractProviderErrorMessage(
  error_input: ?[]const u8,
  _provider: []const u8,
) -> []const u8 {
  // Port of the decision logic from extractProviderErrorMessage
  // This function handles error message extraction from various error types
  
  // Check if error is not null
  if (error_input != null) {
    const error_str = error_input.?;
    
    // Check if it looks like a JSON object with error information
    if (contains_string(error_str, "error")) {
      // Try to extract error message from JSON
      if (contains_string(error_str, "message")) {
        // Extract message field (simplified)
        const msg_start = find_substring(error_str, "\"message\"", 0);
        if (msg_start != error_str.len) {
          const colon_pos = find_substring(error_str, ":", msg_start);
          if (colon_pos != error_str.len) {
            const quote_pos = find_substring(error_str, "\"", colon_pos + 1);
            if (quote_pos != error_str.len) {
              const end_quote = find_substring(error_str, "\"", quote_pos + 1);
              if (end_quote != error_str.len) {
                const message = error_str[quote_pos + 1..end_quote];
                if (message.len > 0) {
                  return message;
                }
              }
            }
          }
        }
      }
      
      // Try to extract error code from JSON
      if (contains_string(error_str, "code")) {
        const code_start = find_substring(error_str, "\"code\"", 0);
        if (code_start != error_str.len) {
          const colon_pos = find_substring(error_str, ":", code_start);
          if (colon_pos != error_str.len) {
            const quote_pos = find_substring(error_str, "\"", colon_pos + 1);
            if (quote_pos != error_str.len) {
              const end_quote = find_substring(error_str, "\"", quote_pos + 1);
              if (end_quote != error_str.len) {
                const code = error_str[quote_pos + 1..end_quote];
                if (code.len > 0) {
                  return code;
                }
              }
            }
          }
        }
      }
    }
    
    // Check if it has a direct message field
    if (contains_string(error_str, "message")) {
      const msg_start = find_substring(error_str, "\"message\"", 0);
      if (msg_start != error_str.len) {
        const colon_pos = find_substring(error_str, ":", msg_start);
        if (colon_pos != error_str.len) {
          const quote_pos = find_substring(error_str, "\"", colon_pos + 1);
          if (quote_pos != error_str.len) {
            const end_quote = find_substring(error_str, "\"", quote_pos + 1);
            if (end_quote != error_str.len) {
              const message = error_str[quote_pos + 1..end_quote];
              if (message.len > 0) {
                return message;
              }
            }
          }
        }
      }
    }
  }
  
  // Fallback to the error string itself if available
  if (error_input != null) {
    return error_input.?;
  }
  
  return "Unknown error";
}

// Helper function to check if a string contains a substring
fn contains_string(haystack: []const u8, needle: []const u8) -> bool {
  if (needle.len == 0) {
    return true;
  }
  if (haystack.len < needle.len) {
    return false;
  }
  
  var i: usize = 0;
  while (i <= haystack.len - needle.len) {
    var match: bool = true;
    var j: usize = 0;
    while (j < needle.len) {
      if (haystack[i + j] != needle[j]) {
        match = false;
        break;
      }
      j += 1;
    }
    if (match) {
      return true;
    }
    i += 1;
  }
  return false;
}

// Helper function to find substring index
fn find_substring(haystack: []const u8, needle: []const u8, start: usize) -> usize {
  if (start > haystack.len) {
    return haystack.len;
  }
  
  var i: usize = start;
  while (i <= haystack.len - needle.len) {
    var match: bool = true;
    var j: usize = 0;
    while (j < needle.len) {
      if (haystack[i + j] != needle[j]) {
        match = false;
        break;
      }
      j += 1;
    }
    if (match) {
      return i;
    }
    i += 1;
  }
  return haystack.len;
}

// Test the extractProviderErrorMessage function
test extract_error_with_response_body {
  // Test case 1: Error with JSON containing error message
  const error_with_json = "{\"error\":{\"message\":\"Network timeout\",\"code\":500}}";
  
  const result1 = extractProviderErrorMessage(error_with_json, "test-provider");
  // Should return the error message from JSON
  assert(result1.len > 0);
  assert(contains_string(result1, "Network timeout"));
}

test extract_error_fallback {
  // Test case 2: Simple error message
  const simple_error = "Connection failed";
  
  const result2 = extractProviderErrorMessage(simple_error, "test-provider");
  // Should return the direct error message
  assert(result2.len > 0);
  assert(contains_string(result2, "Connection failed"));
}