module port::test-provider;

pub struct ProviderTestConfig {
  provider: []const u8,
  model: []const u8,
  upstreamProvider: ?[]const u8,
}

pub struct ProviderTestResult {
  success: bool,
  message: []const u8,
  responseTime: ?i32,
}

pub fn testProviderConnection(
  config: ProviderTestConfig,
  browserosId: ?[]const u8,
) -> ProviderTestResult {
  undefined;
}

pub fn extractProviderErrorMessage(
  error: ?anytype,
  _provider: []const u8,
) -> []const u8 {
  // Check if error is not null
  if (error != null) {
    const errorObj = error.?; // Safe to dereference since we checked != null
    
    // Check if error has responseBody field and it's a string
    if (has_field(errorObj, "responseBody")) {
      const responseBody = get_field_string(errorObj, "responseBody");
      if (responseBody.len > 0) {
        // Look for error patterns in the response body
        if (contains_string(responseBody, "error")) {
          return "Provider returned an error";
        }
        if (contains_string(responseBody, "message")) {
          return "Provider returned a message";
        }
      }
    }
    
    // Check if error has message field and it's a string
    if (has_field(errorObj, "message")) {
      const message = get_field_string(errorObj, "message");
      if (message.len > 0) {
        return message;
      }
    }
  }
  
  return "Unknown error";
}

// Helper function to check if a string contains a substring
fn contains_string(haystack: []const u8, needle: []const u8) -> bool {
  if (needle.len == 0) {
    return true;
  }
  if (haystack.len < needle.len) {
    return false;
  }
  
  var i: usize = 0;
  while (i <= haystack.len - needle.len) {
    var match: bool = true;
    var j: usize = 0;
    while (j < needle.len) {
      if (haystack[i + j] != needle[j]) {
        match = false;
        break;
      }
      j += 1;
    }
    if (match) {
      return true;
    }
    i += 1;
  }
  return false;
}

// Helper function to check if an object has a field (simplified)
fn has_field(obj: anytype, field_name: []const u8) -> bool {
  // For now, assume it has the field if the name matches
  // In a real implementation, this would check the actual structure
  return true;
}

// Helper function to get a string field from an object (simplified)
fn get_field_string(obj: anytype, field_name: []const u8) -> []const u8 {
  // For now, return an empty string
  // In a real implementation, this would access the actual field
  return "";
}

// Test the error message extraction logic
test extract_error_with_response_body {
  // Simulate an error object with responseBody
  const MockError = struct {
    responseBody: []const u8,
    message: []const u8,
  };
  
  const errorWithBody = MockError{
    .responseBody = "{\"error\": {\"message\": \"API key invalid\"}}",
    .message = "Generic error message",
  };
  
  const result = extractProviderErrorMessage(errorWithBody, "test-provider");
  // Should extract the error message from responseBody
  assert(result.len > 0);
}

test extract_error_fallback {
  // Simulate a simple error object
  const SimpleError = struct {
    message: []const u8,
  };
  
  const simpleError = SimpleError{
    .message = "Network timeout",
  };
  
  const result = extractProviderErrorMessage(simpleError, "test-provider");
  // Should return the error message
  assert(result.len > 0);
}