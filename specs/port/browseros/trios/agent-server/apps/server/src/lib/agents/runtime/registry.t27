module port::browseros::trios::agent_server::apps::server::src::lib::agents::runtime;

// Define the minimal AgentRuntimeDescriptor and AgentRuntime for our tests.
// In a real scenario, these would be defined elsewhere, but we need them for the port to be self-contained for testing.
struct AgentRuntimeDescriptor {
    adapterId: []const u8,
}

struct AgentRuntime {
    descriptor: AgentRuntimeDescriptor,
}

// We'll define a fixed capacity for the registry. We choose 100 for our tests.
const MAX_RUNTIMES: usize = 100;

// The registry struct.
struct AgentRuntimeRegistry {
    runtimes: [MAX_RUNTIMES]AgentRuntime,
    len: usize,
}

// The list return struct.
struct AgentRuntimeList {
    runtimes: [MAX_RUNTIMES]AgentRuntime,
    len: usize,
}

// Global registry variable.
var globalRegistry: ?AgentRuntimeRegistry = null;

// Function: AgentRuntimeRegistry_register
// Parameters: registry: *AgentRuntimeRegistry, runtime: AgentRuntime
// Returns: void
// Decision: If the runtime's descriptor.adapterId is already in the registry, do nothing (throw in original, but we just return early).
//           Otherwise, add it to the registry if there is space.
fn AgentRuntimeRegistry_register(registry: *AgentRuntimeRegistry, runtime: AgentRuntime) -> void {
    var i: usize = 0;
    while (i < registry.len) {
        if (std.mem.eql(u8, registry.runtimes[i].descriptor.adapterId, runtime.descriptor.adapterId)) {
            // Duplicate found, do not register.
            return;
        }
        i += 1;
    }

    if (registry.len < MAX_RUNTIMES) {
        registry.runtimes[registry.len] = runtime;
        registry.len += 1;
    }
    // If no space, we do nothing (could return an error, but original doesn't specify behavior for full registry).
}

// Function: AgentRuntimeRegistry_get
// Parameters: registry: *AgentRuntimeRegistry, adapterId: []const u8
// Returns: ?AgentRuntime
// Decision: Look for the adapterId in the registry and return the runtime if found, else null.
fn AgentRuntimeRegistry_get(registry: *AgentRuntimeRegistry, adapterId: []const u8) -> ?AgentRuntime {
    var i: usize = 0;
    while (i < registry.len) {
        if (std.mem.eql(u8, registry.runtimes[i].descriptor.adapterId, adapterId)) {
            return &registry.runtimes[i];
        }
        i += 1;
    }
    return null;
}

// Function: AgentRuntimeRegistry_list
// Parameters: registry: *AgentRuntimeRegistry
// Returns: AgentRuntimeList
// Decision: Return a copy of the runtimes array up to len.
fn AgentRuntimeRegistry_list(registry: *AgentRuntimeRegistry) -> AgentRuntimeList {
    var list: AgentRuntimeList = AgentRuntimeList { .runtimes = undefined, .len = 0 };
    var i: usize = 0;
    while (i < registry.len) {
        list.runtimes[i] = registry.runtimes[i];
        i += 1;
    }
    list.len = registry.len;
    return list;
}

// Function: AgentRuntimeRegistry_unregister
// Parameters: registry: *AgentRuntimeRegistry, adapterId: []const u8
// Returns: bool
// Decision: Remove the runtime with the given adapterId by shifting elements left and return true if found, else false.
fn AgentRuntimeRegistry_unregister(registry: *AgentRuntimeRegistry, adapterId: []const u8) -> bool {
    var i: usize = 0;
    while (i < registry.len) {
        if (std.mem.eql(u8, registry.runtimes[i].descriptor.adapterId, adapterId)) {
            // Found, shift elements left.
            var j: usize = i;
            while (j < registry.len - 1) {
                registry.runtimes[j] = registry.runtimes[j + 1];
                j += 1;
            }
            registry.len -= 1;
            return true;
        }
        i += 1;
    }
    return false;
}

// Function: getAgentRuntimeRegistry
// Returns: *AgentRuntimeRegistry
// Decision: Return the global registry, creating it if necessary.
pub fn getAgentRuntimeRegistry() -> *AgentRuntimeRegistry {
    if (globalRegistry == null) {
        globalRegistry = &AgentRuntimeRegistry { .runtimes = undefined, .len = 0 };
    }
    return globalRegistry;
}

// Function: resetAgentRuntimeRegistry
// Returns: void
// Decision: Set the global registry to null.
pub fn resetAgentRuntimeRegistry() -> void {
    globalRegistry = null;
}

// Now, we write at least 6 tests.

test "register and get" {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry { .runtimes = undefined, .len = 0 };
    var desc1: AgentRuntimeDescriptor = AgentRuntimeDescriptor { .adapterId = "id1" };
    var runtime1: AgentRuntime = AgentRuntime { .descriptor = desc1 };
    AgentRuntimeRegistry_register(&registry, runtime1);
    var retrieved: ?AgentRuntime = AgentRuntimeRegistry_get(&registry, "id1");
    assert(retrieved != null);
    assert(std.mem.eql(u8, retrieved?.descriptor.adapterId, "id1"));
}

test "register duplicate does nothing" {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry { .runtimes = undefined, .len = 0 };
    var desc: AgentRuntimeDescriptor = AgentRuntimeDescriptor { .adapterId = "id1" };
    var runtime: AgentRuntime = AgentRuntime { .descriptor = desc };
    AgentRuntimeRegistry_register(&registry, runtime);
    AgentRuntimeRegistry_register(&registry, runtime); // duplicate
    assert(registry.len == 1);
}

test "list returns correct runtimes" {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry { .runtimes = undefined, .len = 0 };
    var desc1: AgentRuntimeDescriptor = AgentRuntimeDescriptor { .adapterId = "id1" };
    var runtime1: AgentRuntime = AgentRuntime { .descriptor = desc1 };
    var desc2: AgentRuntimeDescriptor = AgentRuntimeDescriptor { .adapterId = "id2" };
    var runtime2: AgentRuntime = AgentRuntime { .descriptor = desc2 };
    AgentRuntimeRegistry_register(&registry, runtime1);
    AgentRuntimeRegistry_register(&registry, runtime2);
    var list: AgentRuntimeList = AgentRuntimeRegistry_list(&registry);
    assert(list.len == 2);
    assert(std.mem.eql(u8, list.runtimes[0].descriptor.adapterId, "id1"));
    assert(std.mem.eql(u8, list.runtimes[1].descriptor.adapterId, "id2"));
}

test "get returns null for missing id" {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry { .runtimes = undefined, .len = 0 };
    var result: ?AgentRuntime = AgentRuntimeRegistry_get(&registry, "missing");
    assert(result == null);
}

test "unregister existing runtime" {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry { .runtimes = undefined, .len = 0 };
    var desc: AgentRuntimeDescriptor = AgentRuntimeDescriptor { .adapterId = "id1" };
    var runtime: AgentRuntime = AgentRuntime { .descriptor = desc };
    AgentRuntimeRegistry_register(&registry, runtime);
    var removed: bool = AgentRuntimeRegistry_unregister(&registry, "id1");
    assert(removed == true);
    assert(registry.len == 0);
    var retrieved: ?AgentRuntime = AgentRuntimeRegistry_get(&registry, "id1");
    assert(retrieved == null);
}

test "unregister missing runtime returns false" {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry { .runtimes = undefined, .len = 0 };
    var removed: bool = AgentRuntimeRegistry_unregister(&registry, "missing");
    assert(removed == false);
    assert(registry.len == 0);
}

test "global registry functions" {
    // Reset first to ensure clean state.
    resetAgentRuntimeRegistry();
    var reg1: *AgentRuntimeRegistry = getAgentRuntimeRegistry();
    assert(reg1 != null);
    var reg2: *AgentRuntimeRegistry = getAgentRuntimeRegistry();
    assert(reg1 == reg2); // same instance
    resetAgentRuntimeRegistry();
    var reg3: *AgentRuntimeRegistry = getAgentRuntimeRegistry();
    assert(reg3 != null);
    assert(reg3 != reg1); // new instance after reset
}

// Additional test: list after unregister maintains order.
test "list order preserved after unregister" {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry { .runtimes = undefined, .len = 0 };
    var desc1: AgentRuntimeDescriptor = AgentRuntimeDescriptor { .adapterId = "id1" };
    var runtime1: AgentRuntime = AgentRuntime { .descriptor = desc1 };
    var desc2: AgentRuntimeDescriptor = AgentRuntimeDescriptor { .adapterId = "id2" };
    var runtime2: AgentRuntime = AgentRuntime { .descriptor = desc2 };
    var desc3: AgentRuntimeDescriptor = AgentRuntimeDescriptor { .adapterId = "id3" };
    var runtime3: AgentRuntime = AgentRuntime { .descriptor = desc3 };
    AgentRuntimeRegistry_register(&registry, runtime1);
    AgentRuntimeRegistry_register(&registry, runtime2);
    AgentRuntimeRegistry_register(&registry, runtime3);
    assert(registry.len == 3);
    AgentRuntimeRegistry_unregister(&registry, "id2");
    assert(registry.len == 2);
    var list: AgentRuntimeList = AgentRuntimeRegistry_list(&registry);
    assert(list.len == 2);
    assert(std.mem.eql(u8, list.runtimes[0].descriptor.adapterId, "id1"));
    assert(std.mem.eql(u8, list.runtimes[1].descriptor.adapterId, "id3"));
}