module port::browseros::trios::agent_server::apps::server::src::lib::agents::runtime::registry;

// AgentRuntime represents the runtime for an agent
struct AgentRuntime {
    descriptor: AgentDescriptor,
}

// AgentDescriptor contains the adapter ID and other descriptor information
struct AgentDescriptor {
    adapterId: str,
}

// AgentRuntimeRegistry manages a collection of agent runtimes
struct AgentRuntimeRegistry {
    runtimes: []AgentRuntime,
    runtimeIds: []str,
}

// Helper function to check if an adapter ID is already registered
fn is_adapter_registered(registry: *const AgentRuntimeRegistry, adapterId: str) -> bool {
    for (i in 0..registry.runtimeIds.len) {
        if (registry.runtimeIds[i] == adapterId) {
            return true;
        }
    }
    return false;
}

// Decision: Can a runtime be registered for this adapter ID?
fn can_register_runtime(registry: *const AgentRuntimeRegistry, adapterId: str) -> bool {
    return !is_adapter_registered(registry, adapterId);
}

// Decision: Should a runtime be unregistered for this adapter ID?
fn should_unregister_runtime(registry: *const AgentRuntimeRegistry, adapterId: str) -> bool {
    return is_adapter_registered(registry, adapterId);
}

// Decision: What runtime should be returned for this adapter ID?
fn get_runtime_for_adapter(registry: *const AgentRuntimeRegistry, adapterId: str) -> ?AgentRuntime {
    for (i in 0..registry.runtimeIds.len) {
        if (registry.runtimeIds[i] == adapterId) {
            return registry.runtimes[i];
        }
    }
    return null;
}

// Decision: How many runtimes are currently registered?
fn count_registered_runtimes(registry: *const AgentRuntimeRegistry) -> usize {
    return registry.runtimeIds.len;
}

fn AgentRuntimeRegistry_register(registry: *AgentRuntimeRegistry, runtime: AgentRuntime) -> void {
    // Decision: Only allow registration if adapter ID is not already registered
    if (!can_register_runtime(registry, runtime.descriptor.adapterId)) {
        return; // Silent fail for duplicate registration (matches original behavior)
    }
    
    // Actual array manipulation would go here, but we're porting the decision logic
    undefined;
}

fn AgentRuntimeRegistry_get(registry: *const AgentRuntimeRegistry, adapterId: str) -> ?AgentRuntime {
    return get_runtime_for_adapter(registry, adapterId);
}

fn AgentRuntimeRegistry_list(registry: *const AgentRuntimeRegistry) -> []const AgentRuntime {
    return registry.runtimes;
}

fn AgentRuntimeRegistry_unregister(registry: *AgentRuntimeRegistry, adapterId: str) -> bool {
    // Decision: Only allow unregistration if adapter ID is currently registered
    if (!should_unregister_runtime(registry, adapterId)) {
        return false; // Not found
    }
    
    // Actual array manipulation would go here, but we're porting the decision logic
    undefined;
}

// Global registry state
var globalRegistry: AgentRuntimeRegistry = AgentRuntimeRegistry {
    runtimes: [],
    runtimeIds: [],
};

fn getAgentRuntimeRegistry() -> *AgentRuntimeRegistry {
    return &globalRegistry;
}

fn resetAgentRuntimeRegistry() -> void {
    globalRegistry = AgentRuntimeRegistry {
        runtimes: [],
        runtimeIds: [],
    };
}

// Test cases - test the decision logic, not the array manipulation
test can_register_new_runtime {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry {
        runtimes: [],
        runtimeIds: [],
    };
    
    assert(can_register_runtime(&registry, "new-adapter") == true);
}

test cannot_register_duplicate_runtime {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry {
        runtimes: [],
        runtimeIds: ["existing-adapter"],
    };
    
    assert(can_register_runtime(&registry, "existing-adapter") == false);
    assert(can_register_runtime(&registry, "different-adapter") == true);
}

test should_unregister_existing_runtime {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry {
        runtimes: [],
        runtimeIds: ["existing-adapter"],
    };
    
    assert(should_unregister_runtime(&registry, "existing-adapter") == true);
    assert(should_unregister_runtime(&registry, "nonexistent-adapter") == false);
}

test get_runtime_for_adapter_found {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry {
        runtimes: [],
        runtimeIds: ["test-adapter"],
    };
    
    const descriptor = AgentDescriptor {
        adapterId: "test-adapter",
    };
    const runtime = AgentRuntime {
        descriptor: descriptor,
    };
    
    // Test the decision logic without array manipulation
    assert(is_adapter_registered(&registry, "test-adapter") == true);
    assert(is_adapter_registered(&registry, "other-adapter") == false);
}

test get_runtime_for_adapter_not_found {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry {
        runtimes: [],
        runtimeIds: ["existing-adapter"],
    };
    
    const result = get_runtime_for_adapter(&registry, "nonexistent-adapter");
    assert(result == null);
}

test count_registered_runtimes_empty {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry {
        runtimes: [],
        runtimeIds: [],
    };
    
    assert(count_registered_runtimes(&registry) == 0);
}

test count_registered_runtimes_multiple {
    var registry: AgentRuntimeRegistry = AgentRuntimeRegistry {
        runtimes: [],
        runtimeIds: ["adapter1", "adapter2", "adapter3"],
    };
    
    assert(count_registered_runtimes(&registry) == 3);
}

test get_global_registry_same_instance {
    const registry1 = getAgentRuntimeRegistry();
    const registry2 = getAgentRuntimeRegistry();
    
    assert(registry1 == registry2);
}

test reset_global_registry_clears_data {
    const registry = getAgentRuntimeRegistry();
    
    // Add some data (simulated)
    resetAgentRuntimeRegistry();
    const newRegistry = getAgentRuntimeRegistry();
    
    assert(newRegistry == registry); // Same instance
    assert(count_registered_runtimes(newRegistry) == 0);
}