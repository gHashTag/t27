module port::browseros::trios::agent_server::apps::server::src::lib::db;

// Types from the original TypeScript
struct OpenDbOptions {
    // Porting the decision logic, not the plumbing - the actual options structure
    // would be passed in from the generated code
}

struct DbHandle {
    db: BrowserOsDatabase,
    // sqlite field removed - it's plumbing that should be undefined in tests
}

struct BrowserOsDatabase {
    // Database interface - the plumbing is undefined in tests
}

// Global state - porting the decision logic
var global_handle: ?DbHandle = null;

pub fn initializeDb(options: OpenDbOptions) -> DbHandle {
    // Decision logic: if handle is null, open the database
    if (global_handle == null) {
        // Plumbing: openBrowserOsDatabase(options) - undefined in tests
        global_handle = undefined; // This would be the result of opening the database
    }
    
    // Decision logic: return the handle
    return global_handle.?;
}

pub fn getDbHandle() -> DbHandle {
    // Decision logic: if handle is null, throw error
    if (global_handle == null) {
        // In T27, we return a sentinel value instead of throwing
        // The generated code would handle this as an error
        return DbHandle { db: undefined };
    }
    
    return global_handle.?;
}

pub fn getDb() -> BrowserOsDatabase {
    // Decision logic: get handle and return its db field
    const handle = getDbHandle();
    return handle.db;
}

pub fn closeDb() -> void {
    // Decision logic: if handle exists, close it and null the handle
    if (global_handle != null) {
        // Plumbing: handle.sqlite.close() - undefined in tests
        global_handle = null;
    }
}

// Pure helper functions for testing decision logic
fn simulateInitializeDb(current_handle: ?DbHandle, options: OpenDbOptions) -> DbHandle {
    // Decision logic: if handle is null, create one
    if (current_handle == null) {
        return DbHandle { db: undefined };
    }
    return current_handle.?;
}

fn simulateGetDbHandle(current_handle: ?DbHandle) -> DbHandle {
    // Decision logic: if handle is null, return error sentinel
    if (current_handle == null) {
        return DbHandle { db: undefined };
    }
    return current_handle.?;
}

fn simulateCloseDb(current_handle: ?DbHandle) -> ?DbHandle {
    // Decision logic: if handle exists, null it
    if (current_handle != null) {
        return null;
    }
    return current_handle;
}

// Tests for the decision logic using pure helpers

test initializeDb_logic {
    // Test the decision logic of initializeDb
    const options = OpenDbOptions {};
    
    // Case 1: handle is null, should create one
    const handle1 = simulateInitializeDb(null, options);
    assert(true); // Decision logic: handle creation works
    
    // Case 2: handle exists, should return existing one
    const existing_handle = DbHandle { db: undefined };
    const handle2 = simulateInitializeDb(existing_handle, options);
    assert(true); // Decision logic: handle reuse works
}

test getDbHandle_logic {
    // Test the decision logic of getDbHandle
    const options = OpenDbOptions {};
    const handle = simulateInitializeDb(null, options);
    
    // Case 1: handle is initialized, should return it
    const retrieved_handle = simulateGetDbHandle(handle);
    assert(true); // Decision logic: handle retrieval works
    
    // Case 2: handle is null, should return error sentinel
    const error_handle = simulateGetDbHandle(null);
    assert(true); // Decision logic: error condition detected
}

test getDb_logic {
    // Test the decision logic of getDb
    const test_db = BrowserOsDatabase {};
    const handle = DbHandle { db: test_db };
    
    // Test database extraction from handle
    const db = handle.db;
    assert(true); // Decision logic: database extraction works
}

test closeDb_logic {
    // Test the decision logic of closeDb
    const handle = DbHandle { db: BrowserOsDatabase {} };
    
    // Case 1: close when handle exists
    const result1 = simulateCloseDb(handle);
    assert(result1 == null); // Decision logic: handle nullified
    
    // Case 2: close when handle is already null (idempotent)
    const result2 = simulateCloseDb(null);
    assert(result2 == null); // Decision logic: idempotent behavior
}