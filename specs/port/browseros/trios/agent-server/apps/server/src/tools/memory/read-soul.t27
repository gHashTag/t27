module port::browseros::trios::agent_server::apps::server::src::tools::memory::read_soul;

pub struct SoulReadResult {
  text: []const u8,
}

pub fn soulRead_execute(content: []const u8) -> SoulReadResult {
  if (content.len == 0) {
    return SoulReadResult{ .text = "SOUL.md is empty or does not exist yet." };
  } else {
    return SoulReadResult{ .text = content };
  }
}

pub fn createSoulReadTool() -> undefined {
  undefined;
}

        test "soulRead_execute returns default message for empty content" {
          var empty: []const u8 = "";
          const result = soulRead_execute(empty);
          assert(result.text == "SOUL.md is empty or does not exist yet.");
        }

        test "soulRead_execute returns content for non-empty" {
          var content: []const u8 = "hello";
          const result = soulRead_execute(content);
          assert(result.text == "hello");
        }

        test "soulRead_execute returns default message for empty content - length" {
          var empty: []const u8 = "";
          const result = soulRead_execute(empty);
          assert(result.text.len == 39);
        }