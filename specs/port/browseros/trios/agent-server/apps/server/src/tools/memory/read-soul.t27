module specs::port::browseros::trios::agent_server::apps::server::src::tools::memory::read_soul;

pub fn soulReadResultToText(content: []const u8) -> []const u8 {
    if (content.len == 0) {
        return "SOUL.md is empty or does not exist yet.";
    } else {
        return content;
    }
}

pub fn createSoulReadTool() -> void {
    undefined;
}

test soulReadResultToText_returnsFixedMessageWhenEmpty {
    var empty: []const u8 = &[];
    assert(soulReadResultToText(empty) == "SOUL.md is empty or does not exist yet.");
}

test soulReadResultToText_returnsContentWhenNotEmpty {
    var content: []const u8 = "hello";
    assert(soulReadResultToText(content) == "hello");
}