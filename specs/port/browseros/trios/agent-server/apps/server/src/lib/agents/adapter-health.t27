module specs::port::browseros::trios::agent-server::apps::server::src::lib::agents::adapter_health;

const AdapterHealth = struct {
    healthy: bool,
    reason: ?[]const u8,
    checkedAt: i64,
};

const AgentRuntimeSnapshot = struct {
    isReady: bool,
    lastError: ?[]const u8,
};

fn AdapterHealthChecker_getHealth(adapter: []const u8, registry: *void) -> AdapterHealth {
    undefined;
}

fn runtimeSnapshotToHealth(snap: AgentRuntimeSnapshot) -> AdapterHealth {
    return AdapterHealth{
        .healthy = snap.isReady,
        .reason = if (snap.isReady) null else snap.lastError,
        .checkedAt = 0,
    };
}

fn openclawFallback(adapter: []const u8) -> AdapterHealth {
    if (adapter == "openclaw") {
        return AdapterHealth{
            .healthy = true,
            .reason = null,
            .checkedAt = 0,
        };
    } else {
        return AdapterHealth{
            .healthy = false,
            .reason = null,
            .checkedAt = 0,
        };
    }
}

test runtimeSnapshotToHealth_ready {
    var snap: AgentRuntimeSnapshot = .{ .isReady = true, .lastError = null };
    var health = runtimeSnapshotToHealth(snap);
    assert(health.healthy == true);
    assert(health.reason == null);
}

test runtimeSnapshotToHealth_notReady_withError {
    var snap: AgentRuntimeSnapshot = .{ .isReady = false, .lastError = "failed to start" };
    var health = runtimeSnapshotToHealth(snap);
    assert(health.healthy == false);
    assert(health.reason != null);
}

test runtimeSnapshotToHealth_notReady_noError {
    var snap: AgentRuntimeSnapshot = .{ .isReady = false, .lastError = null };
    var health = runtimeSnapshotToHealth(snap);
    assert(health.healthy == false);
    assert(health.reason == null);
}

test openclawFallback_openclaw {
    var health = openclawFallback("openclaw");
    assert(health.healthy == true);
    assert(health.reason == null);
}

test openclawFallback_other {
    var health = openclawFallback("other");
    assert(health.healthy == false);
    // Note: reason is not tested due to limitations in .t27 string handling
}