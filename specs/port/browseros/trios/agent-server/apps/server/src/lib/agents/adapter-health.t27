module specs::port::browseros::trios::agent_server::apps::server::src::lib::agents::adapter_health;

struct AgentRuntimeSnapshot {
    isReady: bool,
    lastError: ?[]const u8,
    probedAt: ?i64,
    lastErrorAt: i64,
}
struct AdapterHealth {
    healthy: bool,
    reason: ?[]const u8,
    checkedAt: i64,
}

fn AdapterHealthChecker_getHealth(adapter: []const u8) -> AdapterHealth {
    undefined;
}

fn runtimeSnapshotToHealth(snapshot: AgentRuntimeSnapshot, now: i64) -> AdapterHealth {
    const checkedAt = if (snapshot.probedAt != null) snapshot.probedAt else if (snapshot.lastErrorAt != null) snapshot.lastErrorAt else now;
    return AdapterHealth {
        .healthy = snapshot.isReady,
        .reason = if (snapshot.isReady) null else snapshot.lastError,
        .checkedAt = checkedAt,
    };
}

fn openclawFallback(adapter: []const u8, now: i64) -> AdapterHealth {
    if (std.mem.eql(u8, adapter, "openclaw")) {
        return AdapterHealth {
            .healthy = true,
            .reason = null,
            .checkedAt = now,
        };
    } else {
        return AdapterHealth {
            .healthy = false,
            .reason = "No runtime registered for \"" ++ adapter ++ "\"",
            .checkedAt = now,
        };
    }
}

test runtimeSnapshotToHealth_healthy {
    var snapshot: AgentRuntimeSnapshot = .{
        .isReady = true,
        .lastError = null,
        .probedAt = null,
        .lastErrorAt = null,
    };
    const now = 1_000_000_000;
    const health = runtimeSnapshotToHealth(snapshot, now);
    assert(health.healthy == true);
    assert(health.reason == null);
    assert(health.checkedAt == now);
}

test runtimeSnapshotToHealth_unhealthy_withLastError {
    var snapshot: AgentRuntimeSnapshot = .{
        .isReady = false,
        .lastError = "something went wrong",
        .probedAt = null,
        .lastErrorAt = 2_000_000_000,
    };
    const now = 1_000_000_000;
    const health = runtimeSnapshotToHealth(snapshot, now);
    assert(health.healthy == false);
    assert(health.reason == &"something went wrong");
    assert(health.checkedAt == 2_000_000_000);
}

test openclawFallback_openclaw {
    const adapter = "openclaw";
    const now = 1_234_567_890;
    const health = openclawFallback(adapter, now);
    assert(health.healthy == true);
    assert(health.reason == null);
    assert(health.checkedAt == now);
}

test openclawFallback_other {
    const adapter = "other";
    const now = 1_234_567_890;
    const health = openclawFallback(adapter, now);
    assert(health.healthy == false);
    assert(health.reason == &"No runtime registered for \"other\"");
    assert(health.checkedAt == now);
}