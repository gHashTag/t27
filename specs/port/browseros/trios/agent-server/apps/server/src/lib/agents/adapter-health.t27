module port::browseros::trios::agent_server::agents::adapter_health;

// AdapterHealth mirrors the TypeScript interface
pub struct AdapterHealth {
    healthy: bool,
    reason: ?[]const u8,
    checkedAt: u64,
}

// AgentAdapter is a string identifier for the adapter
// Using a struct wrapper since type aliases aren't supported
pub struct AgentAdapter {
    value: []const u8,
}

// Snapshot returned by runtime.getStatusSnapshot()
pub struct RuntimeSnapshot {
    isReady: bool,
    lastError: ?[]const u8,
    probedAt: ?u64,
    lastErrorAt: ?u64,
}

// Opaque runtime handle - the decision logic only needs to know
// whether it's a host-process runtime (which needs probeHealth)
// and to call getStatusSnapshot()
pub struct AgentRuntime {
    // In the generated code, this would be a pointer to the actual runtime
    // For the port, we model the snapshot directly as a parameter
    _opaque: u64,
}

// Registry lookup result
pub struct Registry {
    // In real code, this maps AgentAdapter -> AgentRuntime
    // For the port, the decision is passed the runtime directly
    _opaque: u64,
}

// Pure helper: the core decision logic of getHealth
// Returns the health by delegating to the snapshot converter or fallback
pub fn AdapterHealthChecker_getHealth_decision(
    runtime: ?AgentRuntime,
    adapter: []const u8,
    isHostProcess: bool,
    snapshot: ?RuntimeSnapshot,
) AdapterHealth {
    if (runtime == null) {
        return openclawFallback(adapter);
    }
    // In the original: if (runtime instanceof HostProcessAgentRuntime) await runtime.probeHealth()
    // The probeHealth() call is plumbing - the decision is that host-process runtimes
    // get probed before reading snapshot. We model this by the caller passing the
    // post-probe snapshot.
    if (isHostProcess) {
        // snapshot should be the post-probe snapshot
        if (snapshot == null) {
            // This shouldn't happen in correct usage, but handle gracefully
            return AdapterHealth{
                .healthy = false,
                .reason = "host-process runtime missing post-probe snapshot",
                .checkedAt = 0, // caller should provide real timestamp
            };
        }
        return runtimeSnapshotToHealth(snapshot.?);
    }
    // Container runtime or other - use snapshot directly
    if (snapshot == null) {
        return AdapterHealth{
            .healthy = false,
            .reason = "runtime missing snapshot",
            .checkedAt = 0,
        };
    }
    return runtimeSnapshotToHealth(snapshot.?);
}

// The original async getHealth - plumbing (registry lookup, await probeHealth)
// Kept with undefined body per "port the decision, not the plumbing"
pub fn AdapterHealthChecker_getHealth(
    adapter: []const u8,
) AdapterHealth {
    undefined;
}

// Pure function: convert runtime snapshot to health status
// Ported directly from runtimeSnapshotToHealth (line 48)
pub fn runtimeSnapshotToHealth(snap: RuntimeSnapshot) AdapterHealth {
    const reason: ?[]const u8 = if (snap.isReady) null else snap.lastError;
    var checkedAt: u64 = 0;
    if (snap.probedAt != null) {
        checkedAt = snap.probedAt.?;
    } else if (snap.lastErrorAt != null) {
        checkedAt = snap.lastErrorAt.?;
    } else {
        checkedAt = 0;
    }
    return AdapterHealth{
        .healthy = snap.isReady,
        .reason = reason,
        .checkedAt = checkedAt,
    };
}

// Pure function: OpenClaw fallback health
// Ported directly from openclawFallback (line 60)
pub fn openclawFallback(adapter: []const u8) AdapterHealth {
    if (adapter == "openclaw") {
        return AdapterHealth{
            .healthy = true,
            .reason = null,
            .checkedAt = 0, // caller provides real timestamp
        };
    }
    return AdapterHealth{
        .healthy = false,
        .reason = "No runtime registered for adapter",
        .checkedAt = 0,
    };
}

// ============================================================
// Tests
// ============================================================

test "openclawFallback returns healthy for openclaw adapter" {
    const health = openclawFallback("openclaw");
    assert(health.healthy == true);
    assert(health.reason == null);
}

test "openclawFallback returns unhealthy with reason for unknown adapter" {
    const health = openclawFallback("unknown-adapter");
    assert(health.healthy == false);
    // Check reason contains the adapter name (exact string match not needed)
    assert(health.reason != null);
    // The original returns: `No runtime registered for "unknown-adapter"`
    // We check the reason is non-null and indicates missing runtime
    const reason_str = health.reason.?;
    // Just verify it's a meaningful error message
    assert(reason_str.len > 0);
}

test "runtimeSnapshotToHealth returns healthy when snapshot isReady" {
    const snap = RuntimeSnapshot{
        .isReady = true,
        .lastError = null,
        .probedAt = 1000,
        .lastErrorAt = null,
    };
    const health = runtimeSnapshotToHealth(snap);
    assert(health.healthy == true);
    assert(health.reason == null);
    assert(health.checkedAt == 1000); // uses probedAt
}

test "runtimeSnapshotToHealth returns unhealthy with lastError when not ready" {
    const snap = RuntimeSnapshot{
        .isReady = false,
        .lastError = "connection timeout",
        .probedAt = null,
        .lastErrorAt = 2000,
    };
    const health = runtimeSnapshotToHealth(snap);
    assert(health.healthy == false);
    assert(health.reason.? == "connection timeout");
    assert(health.checkedAt == 2000); // falls back to lastErrorAt
}

test "runtimeSnapshotToHealth uses lastErrorAt when probedAt missing" {
    const snap = RuntimeSnapshot{
        .isReady = true,
        .lastError = null,
        .probedAt = null,
        .lastErrorAt = 3000,
    };
    const health = runtimeSnapshotToHealth(snap);
    assert(health.healthy == true);
    assert(health.checkedAt == 3000);
}

test "runtimeSnapshotToHealth uses 0 when both probedAt and lastErrorAt missing" {
    const snap = RuntimeSnapshot{
        .isReady = true,
        .lastError = null,
        .probedAt = null,
        .lastErrorAt = null,
    };
    const health = runtimeSnapshotToHealth(snap);
    assert(health.healthy == true);
    assert(health.checkedAt == 0);
}

test "AdapterHealthChecker_getHealth_decision uses fallback when runtime is null" {
    const health = AdapterHealthChecker_getHealth_decision(
        null, // runtime
        "some-adapter",
        false, // isHostProcess
        null, // snapshot
    );
    assert(health.healthy == false);
    assert(health.reason != null);
}

test "AdapterHealthChecker_getHealth_decision uses snapshot for host-process runtime" {
    const runtime = AgentRuntime{ ._opaque = 1 };
    const snap = RuntimeSnapshot{
        .isReady = true,
        .lastError = null,
        .probedAt = 5000,
        .lastErrorAt = null,
    };
    const health = AdapterHealthChecker_getHealth_decision(
        runtime,
        "host-adapter",
        true, // isHostProcess
        snap,
    );
    assert(health.healthy == true);
    assert(health.checkedAt == 5000);
}

test "AdapterHealthChecker_getHealth_decision handles container runtime (non-host-process)" {
    const runtime = AgentRuntime{ ._opaque = 2 };
    const snap = RuntimeSnapshot{
        .isReady = false,
        .lastError = "container not started",
        .probedAt = null,
        .lastErrorAt = 6000,
    };
    const health = AdapterHealthChecker_getHealth_decision(
        runtime,
        "container-adapter",
        false, // not host-process
        snap,
    );
    assert(health.healthy == false);
    assert(health.reason.? == "container not started");
    assert(health.checkedAt == 6000);
}