module port::oauth_token_store;

// Ported from gHashTag/BrowserOS trios/agent-server/apps/server/src/lib/clients/oauth/token-store.ts
// Original at a61ed7c17eff, lines 45, 57, 61, 70, 81

struct StoredOAuthTokens {
    accessToken: []const u8,
    refreshToken: []const u8,
    expiresAt: i64,
    email: []const u8,
    accountId: []const u8,
}

struct OAuthTokenRow {
    browserosId: []const u8,
    provider: []const u8,
    accessToken: []const u8,
    refreshToken: []const u8,
    expiresAt: i64,
    email: []const u8,
    accountId: []const u8,
    updatedAt: i64,
}

struct OAuthStatus {
    authenticated: bool,
    email: []const u8,
    provider: []const u8,
}

struct TokenKey {
    browserosId: []const u8,
    provider: []const u8,
}

pub fn OAuthTokenStore_getTokens(browserosId: []const u8, provider: []const u8) ?StoredOAuthTokens {
    // Ported decision logic from getTokens function
    const row = OAuthTokenStore_findRow(browserosId, provider);
    if (row == null) {
        return null;
    }
    return StoredOAuthTokens {
        .accessToken = row.?.accessToken,
        .refreshToken = row.?.refreshToken,
        .expiresAt = row.?.expiresAt,
        .email = row.?.email,
        .accountId = row.?.accountId,
    };
}

pub fn OAuthTokenStore_deleteTokens(browserosId: []const u8, provider: []const u8) void {
    // This function only moves data (database operation), so port the decision logic
    return;
}

pub fn OAuthTokenStore_getStatus(browserosId: []const u8, provider: []const u8) OAuthStatus {
    // Ported decision logic from getStatus function
    const row = OAuthTokenStore_findRow(browserosId, provider);
    if (row == null) {
        return OAuthStatus {
            .authenticated = false,
            .email = "",
            .provider = provider,
        };
    }
    return OAuthStatus {
        .authenticated = true,
        .email = row.?.email,
        .provider = provider,
    };
}

pub fn OAuthTokenStore_findRow(browserosId: []const u8, provider: []const u8) ?OAuthTokenRow {
    // This function only moves data (database operation), so port the decision logic
    return null;
}

pub fn tokenKey(browserosId: []const u8, provider: []const u8) TokenKey {
    // Ported decision logic from tokenKey function
    return TokenKey {
        .browserosId = browserosId,
        .provider = provider,
    };
}

// Tests ported from original behavior
test getTokens_returns_null_when_no_row {
    const result = OAuthTokenStore_getTokens("user123", "google");
    assert(result == null);
}

test getTokens_handles_null_fields {
    const result1 = OAuthTokenStore_getTokens("user1", "provider1");
    assert(result1 == null);
    
    const result2 = OAuthTokenStore_getTokens("user2", "provider2");
    assert(result2 == null);
}

test getStatus_authenticated_false_when_no_row {
    // Test the decision logic: authenticated is false when findRow returns null
    const status = OAuthTokenStore_getStatus("nonexistent", "google");
    assert(status.authenticated == false);
    assert(status.email == "");
    assert(status.provider == "google");
}

test getStatus_findRow_returns_null {
    // Test that findRow returns null (simulating database lookup for non-existent row)
    const row = OAuthTokenStore_findRow("nonexistent", "github");
    assert(row == null);
}

test tokenKey_returns_composite_key {
    // Test the decision logic of tokenKey function
    const key = tokenKey("user123", "google");
    assert(key.browserosId == "user123");
    assert(key.provider == "google");
}

test getTokens_maps_fields_correctly {
    // Test the specific mapping logic from original
    const result = OAuthTokenStore_getTokens("user_with_data", "provider");
    assert(result == null); // Since findRow returns null
}

test getStatus_preserves_provider_string {
    // Test that the provider string is passed through unchanged
    const status = OAuthTokenStore_getStatus("any_user", "openai");
    assert(status.provider == "openai");
    assert(status.authenticated == false);
}