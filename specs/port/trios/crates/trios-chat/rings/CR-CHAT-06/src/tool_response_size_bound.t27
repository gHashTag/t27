//! # CR-CHAT-06 — Tool response size bound guard (Wave-47 Lane B)
//!
//! R-CHAT-7 — Tool response size enforcement.
//!
//! LLM tool outputs can be arbitrarily large. An adversary who controls
//! a tool's response can:
//!
//! * **Exhaust memory** — return a multi-gigabyte string that blows up
//!   the chat client's heap.
//! * **Blow the context window** — fill the conversation buffer with a
//!   single oversized response, evicting all prior context.
//! * **DoS the renderer** — produce output with millions of lines that
//!   freezes the UI thread.
//!
//! trios-chat enforces **6 rules**:
//!
//! 1. Response is non-empty.
//! 2. Response length ≤ `TRSB_MAX_BYTES`.
//! 3. Response line count ≤ `TRSB_MAX_LINES`.
//! 4. No single line exceeds `TRSB_MAX_LINE_LEN`.
//! 5. No null bytes.
//! 6. Response is valid UTF-8.
//!
//! Tests **TRSB-01..10**. Error enum [`ToolResponseSizeError`].
//!
//! Anchor: `φ² + φ⁻² = 3 · TRINITY · CHAT · TOOL-RESPONSE-BOUND`

/// Maximum response size in bytes (256 KiB).
pub const TRSB_MAX_BYTES: usize = 256 * 1024;

/// Maximum number of lines.
pub const TRSB_MAX_LINES: usize = 4096;

/// Maximum single line length in bytes.
pub const TRSB_MAX_LINE_LEN: usize = 4096;

/// All ways a tool response can violate size bounds.
pub enum ToolResponseSizeError {
    /// Response is empty.
    EmptyResponse,
    /// Response exceeds max bytes.
    ExceedsMaxBytes,
    /// Response has too many lines.
    TooManyLines,
    /// Single line exceeds max length.
    LineTooLong,
    /// Contains null byte.
    NullByte,
    /// Invalid UTF-8.
    InvalidUtf8,
}

/// `[VERIFIED]` Validate a tool response against size bounds. Returns
/// `Ok(())` if all rules pass.
pub fn validate_tool_response_size(response: []const u8) -> struct { ok: bool, err: ?ToolResponseSizeError } {
    if (response.len == 0) {
        return .{ .ok = false, .err = .EmptyResponse };
    }
    if (response.len > TRSB_MAX_BYTES) {
        return .{ .ok = false, .err = .ExceedsMaxBytes };
    }
    // Check for null bytes
    var has_null_byte: bool = false;
    for (response) |byte| {
        if (byte == 0) {
            has_null_byte = true;
            break;
        }
    }
    if (has_null_byte) {
        return .{ .ok = false, .err = .NullByte };
    }
    
    // Check UTF-8 validity and line count
    var s: []const u8 = undefined;
    var line_count: usize = 0;
    
    // For now, we'll assume UTF-8 validation is handled externally
    // In a real implementation, this would need proper UTF-8 validation
    s = response;
    
    var i: usize = 0;
    while (i < s.len) {
        // Find next newline or end
        var line_end: usize = i;
        while (line_end < s.len and s[line_end] != '\n') {
            line_end += 1;
        }
        
        line_count += 1;
        if (line_count > TRSB_MAX_LINES) {
            return .{ .ok = false, .err = .TooManyLines };
        }
        
        var line_len: usize = if (line_end < s.len) line_end - i else s.len - i;
        if (line_len > TRSB_MAX_LINE_LEN) {
            return .{ .ok = false, .err = .LineTooLong };
        }
        
        i = line_end + 1;
    }
    
    return .{ .ok = true, .err = null };
}

// Test the validate_tool_response_size function
test validate_tool_response_size_empty_rejected {
    const result = validate_tool_response_size("");
    assert(!result.ok);
    assert(result.err == .EmptyResponse);
}

test validate_tool_response_size_exceeds_bytes_rejected {
    var response: [TRSB_MAX_BYTES + 1]u8 = undefined;
    for (0..TRSB_MAX_BYTES + 1) |i| {
        response[i] = 'A';
    }
    const result = validate_tool_response_size(&response);
    assert(!result.ok);
    assert(result.err == .ExceedsMaxBytes);
}

test validate_tool_response_size_too_many_lines_rejected {
    var response: [TRSB_MAX_LINES * 2]u8 = undefined;
    var pos: usize = 0;
    for (0..TRSB_MAX_LINES + 1) |i| {
        response[pos] = 'x';
        pos += 1;
        if (i < TRSB_MAX_LINES) {
            response[pos] = '\n';
            pos += 1;
        }
    }
    const result = validate_tool_response_size(&response);
    assert(!result.ok);
    assert(result.err == .TooManyLines);
}

test validate_tool_response_size_line_too_long_rejected {
    var line: [TRSB_MAX_LINE_LEN + 1]u8 = undefined;
    for (0..TRSB_MAX_LINE_LEN + 1) |i| {
        line[i] = 'x';
    }
    const result = validate_tool_response_size(&line);
    assert(!result.ok);
    assert(result.err == .LineTooLong);
}

test validate_tool_response_size_null_byte_rejected {
    var response: [11]u8 = undefined;
    response[0] = 'h'; response[1] = 'e'; response[2] = 'l'; response[3] = 'l'; response[4] = 'o';
    response[5] = 0;  // null byte
    response[6] = 'w'; response[7] = 'o'; response[8] = 'r'; response[9] = 'l'; response[10] = 'd';
    const result = validate_tool_response_size(&response);
    assert(!result.ok);
    assert(result.err == .NullByte);
}

test validate_tool_response_size_valid_accepted {
    const result = validate_tool_response_size("Hello, world!");
    assert(result.ok);
    assert(result.err == null);
}

test validate_tool_response_size_multiline_accepted {
    const response = "line1\nline2\nline3";
    const result = validate_tool_response_size(response);
    assert(result.ok);
    assert(result.err == null);
}

test validate_tool_response_size_near_max_bytes_accepted {
    var line: [TRSB_MAX_LINE_LEN]u8 = undefined;
    for (0..TRSB_MAX_LINE_LEN) |i| {
        line[i] = 'x';
    }
    var response: [TRSB_MAX_LINE_LEN * 2 + 1]u8 = undefined;
    for (0..TRSB_MAX_LINE_LEN) |i| {
        response[i] = line[i];
    }
    response[TRSB_MAX_LINE_LEN] = '\n';
    for (0..TRSB_MAX_LINE_LEN) |i| {
        response[TRSB_MAX_LINE_LEN + 1 + i] = line[i];
    }
    const result = validate_tool_response_size(&response);
    assert(result.ok);
    assert(result.err == null);
}

test validate_tool_response_size_exact_max_lines_accepted {
    var response: [TRSB_MAX_LINES * 2]u8 = undefined;
    var pos: usize = 0;
    for (0..TRSB_MAX_LINES) |i| {
        response[pos] = 'x';
        pos += 1;
        if (i < TRSB_MAX_LINES - 1) {
            response[pos] = '\n';
            pos += 1;
        }
    }
    const result = validate_tool_response_size(&response);
    assert(result.ok);
    assert(result.err == null);
}

// Debug test to understand line counting
test debug_line_counting {
    // Test with exactly TRSB_MAX_LINES lines
    var response: [TRSB_MAX_LINES * 2]u8 = undefined;
    var pos: usize = 0;
    for (0..TRSB_MAX_LINES) |i| {
        response[pos] = 'x';
        pos += 1;
        if (i < TRSB_MAX_LINES - 1) {
            response[pos] = '\n';
            pos += 1;
        }
    }
    const result = validate_tool_response_size(&response);
    assert(result.ok);
    assert(result.err == null);
}

test validate_tool_response_size_exact_line_len_accepted {
    var line: [TRSB_MAX_LINE_LEN]u8 = undefined;
    for (0..TRSB_MAX_LINE_LEN) |i| {
        line[i] = 'x';
    }
    const result = validate_tool_response_size(&line);
    assert(result.ok);
    assert(result.err == null);
}