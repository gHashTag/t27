    "pa", "pb", "pc", "pd", "pe", "pf", "pg", "ph",
    "pi", "pj", "pk", "pl", "pm", "pn", "po", "pp"
    ];
    var entries: [ACWB_MAX_ENTRIES]ContextEntry = undefined;
    var i: usize = 0;
    while (i < ACWB_MAX_ENTRIES) {
        entries[i] = ContextEntry { id: ids[i], tokens: 1 };
        i += 1;
    }
    assert(validate_context_budget(&entries) == null);
}
