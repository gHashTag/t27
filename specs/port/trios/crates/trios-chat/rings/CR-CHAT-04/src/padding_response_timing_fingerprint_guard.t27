module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_response_timing_fingerprint_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_response_timing_fingerprint_guard.rs
// (CR-CHAT-04 - Padding response timing fingerprint guard, Wave-143
// Lane A, requirement R-CHAT-4).
//
// Padded and unpadded responses must cost the same time: an
// observer timing the server reads off whether padding applied,
// infers short from fast, and builds a binary classifier for the
// message type. The rules, in the original's order: the batch
// ceiling, the empty batch (accepted before the sample floor,
// exactly as the original places it), the sample floor, then per
// sample the zero-id probe and the repeated-id scan, then over
// the whole batch the mean floor and the coefficient-of-
// variation ceiling - the standard deviation over the mean,
// scaled by a thousand and compared as the original's integer
// cross-multiplication.
//
// The original returns Result<(), TimingFingerprintError>. This
// port carries the verdict as a named struct (owner decision D5):
// Ok first, then the six error variants in the original's
// declaration order - HighCv, TooFew, LowMean, Duplicate,
// ZeroId, TooMany - with every payload field: the measured and
// ceiling CV (x1000) for HighCv, got and min for TooFew, the
// got and min mean for LowMean, idx for the id rules, and got
// and max for the batch ceiling.
//
// The original's u64::isqrt becomes a bisection over the whole
// answer range - thirty-three halvings, exact for every u64, no
// float anywhere. The BTreeSet dedup becomes a scan over the
// samples already visited; the mean, variance and CV stay the
// original's integer u64 arithmetic, the length widening through
// the int cast.

// Maximum CV numerator (x1000).
pub const PRTF_MAX_CV_NUM: u64 = 200;

// Maximum CV denominator (x1000).
pub const PRTF_MAX_CV_DEN: u64 = 1000;

// Minimum samples.
pub const PRTF_MIN_SAMPLES: usize = 8;

// Minimum mean timing in microseconds.
pub const PRTF_MIN_MEAN_US: u64 = 50;

// Maximum samples per batch.
pub const PRTF_MAX_SAMPLES: usize = 512;

// Sample ID length.
pub const PRTF_SAMPLE_ID_LEN: usize = 16;

// A timing sample record.
pub struct TimingSample {
    sample_id: [16]u8,
    time_us: u64,
}

// Verdict codes: Ok(()) and TimingFingerprintError's variants, in declaration order.
pub enum TimingFingerprintCode {
    Ok,
    HighCv,
    TooFew,
    LowMean,
    Duplicate,
    ZeroId,
    TooMany,
}

// The verdict of the timing fingerprint validation, with every
// error payload field.
pub struct TimingFingerprintVerdict {
    code: TimingFingerprintCode,
    idx: usize,
    got: usize,
    bound: usize,
    got64: u64,
    bound64: u64,
}

// Whole-form equality over the fixed sixteen id bytes.
pub fn ids16_equal(a: [16]u8, b: [16]u8) -> bool {
    for i in 0..16 {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

// The all-zero sample id - the original's [0u8; 16] probe.
pub fn id16_zero(id: [16]u8) -> bool {
    for i in 0..16 {
        if (id[i] != 0) {
            return false;
        }
    }
    return true;
}

// Whether sample i repeats an earlier id - the original's
// BTreeSet insert probe, answered by a scan.
pub fn id_seen_before(samples: []const TimingSample, i: usize) -> bool {
    for j in 0..i {
        if (ids16_equal(samples[j].sample_id, samples[i].sample_id)) {
            return true;
        }
    }
    return false;
}

// The integer square root of a u64 - the original's u64::isqrt,
// answered by a bisection over the whole answer range. The
// largest root of any u64 is 4294967295, and thirty-three
// halvings settle the search exactly.
pub fn isqrt64(v: u64) -> u64 {
    var lo: u64 = 0;
    var hi: u64 = 4294967295;
    var mid: u64 = 0;
    for _ in 0..33 {
        if (lo <= hi) {
            mid = (lo + hi) / 2;
            if (mid * mid <= v) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
    }
    return hi;
}

// [VERIFIED] Validate padding response timing fingerprint.
// Returns Ok only when every rule holds, checked in the
// original's order: the batch ceiling, the empty batch (accepted),
// the sample floor, then per sample the zero id and the repeated
// id, then over the whole batch the mean floor and the CV
// ceiling.
pub fn validate_timing_fingerprint(samples: []const TimingSample) -> TimingFingerprintVerdict {
    if (samples.len > PRTF_MAX_SAMPLES) {
        return TimingFingerprintVerdict { code: TimingFingerprintCode.TooMany, idx: 0, got: samples.len, bound: PRTF_MAX_SAMPLES, got64: 0, bound64: 0, };
    }
    if (samples.len == 0) {
        return TimingFingerprintVerdict { code: TimingFingerprintCode.Ok, idx: 0, got: 0, bound: 0, got64: 0, bound64: 0, };
    }
    if (samples.len < PRTF_MIN_SAMPLES) {
        return TimingFingerprintVerdict { code: TimingFingerprintCode.TooFew, idx: 0, got: samples.len, bound: PRTF_MIN_SAMPLES, got64: 0, bound64: 0, };
    }
    for i in 0..samples.len {
        if (id16_zero(samples[i].sample_id)) {
            return TimingFingerprintVerdict { code: TimingFingerprintCode.ZeroId, idx: i, got: 0, bound: 0, got64: 0, bound64: 0, };
        }
        if (id_seen_before(samples, i)) {
            return TimingFingerprintVerdict { code: TimingFingerprintCode.Duplicate, idx: i, got: 0, bound: 0, got64: 0, bound64: 0, };
        }
    }
    const len64: u64 = @as(u64, samples.len);
    var sum: u64 = 0;
    for i in 0..samples.len {
        sum = sum + samples[i].time_us;
    }
    const mean: u64 = sum / len64;
    if (mean < PRTF_MIN_MEAN_US) {
        return TimingFingerprintVerdict { code: TimingFingerprintCode.LowMean, idx: 0, got: 0, bound: 0, got64: mean, bound64: PRTF_MIN_MEAN_US, };
    }
    var var_sum: u64 = 0;
    var diff: u64 = 0;
    for i in 0..samples.len {
        if (samples[i].time_us > mean) {
            diff = samples[i].time_us - mean;
        } else {
            diff = mean - samples[i].time_us;
        }
        var_sum = var_sum + diff * diff;
    }
    const std_dev_x1000: u64 = isqrt64(var_sum / len64) * 1000;
    var cv_x1000: u64 = 18446744073709551615;
    if (mean > 0) {
        cv_x1000 = std_dev_x1000 / mean;
    }
    const max_cv_x1000: u64 = PRTF_MAX_CV_NUM * 1000 / PRTF_MAX_CV_DEN;
    if (cv_x1000 > max_cv_x1000) {
        return TimingFingerprintVerdict { code: TimingFingerprintCode.HighCv, idx: 0, got: 0, bound: 0, got64: cv_x1000, bound64: max_cv_x1000, };
    }
    return TimingFingerprintVerdict { code: TimingFingerprintCode.Ok, idx: 0, got: 0, bound: 0, got64: 0, bound64: 0, };
}

