// **PTSC-01** - too fast rejected: ninety-nine microseconds of a
// floor hundred.
test ptsc_01_too_fast_rejected {
    const ms: [1]TimingMeasurement = [1]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 99, },
    };
    const v = validate_timing_constancy(&ms);
    assert(v.code == TimingSideChannelCode.TooFast);
    assert(v.idx == 0);
    assert(v.got64 == 99);
    assert(v.bound64 == 100);
}

// **PTSC-02** - too slow rejected: 10001 microseconds of a
// ceiling ten thousand.
test ptsc_02_too_slow_rejected {
    const ms: [1]TimingMeasurement = [1]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 10001, },
    };
    const v = validate_timing_constancy(&ms);
    assert(v.code == TimingSideChannelCode.TooSlow);
    assert(v.idx == 0);
    assert(v.got64 == 10001);
    assert(v.bound64 == 10000);
}

// **PTSC-03** - zero duration rejected.
test ptsc_03_zero_duration_rejected {
    const ms: [1]TimingMeasurement = [1]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 0, },
    };
    const v = validate_timing_constancy(&ms);
    assert(v.code == TimingSideChannelCode.ZeroDuration);
    assert(v.idx == 0);
}

// **PTSC-04** - high variance rejected: a spread of 1001
// microseconds over the ceiling of a thousand.
test ptsc_04_high_variance_rejected {
    const ms: [2]TimingMeasurement = [2]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 500, },
        TimingMeasurement { op_id: OPID_02, duration_us: 1501, },
    };
    const v = validate_timing_constancy(&ms);
    assert(v.code == TimingSideChannelCode.HighVariance);
    assert(v.got64 == 1001);
    assert(v.bound64 == 1000);
}

// **PTSC-05** - duplicate operation id rejected: the second
// measurement repeats the first's id.
test ptsc_05_duplicate_rejected {
    const ms: [2]TimingMeasurement = [2]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 500, },
        TimingMeasurement { op_id: OPID_01, duration_us: 500, },
    };
    const v = validate_timing_constancy(&ms);
    assert(v.code == TimingSideChannelCode.DuplicateOpId);
    assert(v.idx == 1);
}

// **PTSC-06** - too many rejected: 1025 measurements of a maximum
// 1024, built in a loop like the original's, each id carrying the
// big-endian u64 of its index plus one. The batch rule fires
// before any measurement is examined.
test ptsc_06_too_many_rejected {
    var ms: [1025]TimingMeasurement;
    for i in 0..1025 {
        var id: [32]u8;
        for j in 0..32 {
            id[j] = 0;
        }
        id[6] = PTSC_ID6_1025[i];
        id[7] = PTSC_ID7_1025[i];
        ms[i] = TimingMeasurement { op_id: id, duration_us: 500, };
    }
    const v = validate_timing_constancy(&ms);
    assert(v.code == TimingSideChannelCode.TooMany);
    assert(v.got == 1025);
    assert(v.bound == 1024);
}

// **PTSC-07** - the valid batch accepted: durations 500, 550,
// 480 and 520 - a spread of seventy.
test ptsc_07_valid_accepted {
    const ms: [4]TimingMeasurement = [4]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 500, },
        TimingMeasurement { op_id: OPID_02, duration_us: 550, },
        TimingMeasurement { op_id: OPID_03, duration_us: 480, },
        TimingMeasurement { op_id: OPID_04, duration_us: 520, },
    };
    const v = validate_timing_constancy(&ms);
    assert(v.code == TimingSideChannelCode.Ok);
}

// **PTSC-08** - an empty batch accepted.
test ptsc_08_empty_accepted {
    const ms: [0]TimingMeasurement = [0]TimingMeasurement{};
    const v = validate_timing_constancy(&ms);
    assert(v.code == TimingSideChannelCode.Ok);
}

// **PTSC-09** - a single measurement accepted - the variance
// ceiling checks nothing below two.
test ptsc_09_single_accepted {
    const ms: [1]TimingMeasurement = [1]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 500, },
    };
    const v = validate_timing_constancy(&ms);
    assert(v.code == TimingSideChannelCode.Ok);
}

// **PTSC-10** - the boundary variance accepted: a spread of
// exactly a thousand.
test ptsc_10_boundary_variance_accepted {
    const ms: [2]TimingMeasurement = [2]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 500, },
        TimingMeasurement { op_id: OPID_02, duration_us: 1500, },
    };
    const v = validate_timing_constancy(&ms);
    assert(v.code == TimingSideChannelCode.Ok);
}

// The three helpers have direct tests (coverage: Untested 0).
test op_id_helpers_answer {
    assert(op_ids_equal(OPID_01, OPID_01));
    assert(!op_ids_equal(OPID_01, OPID_02));
    var zero: [32]u8;
    for j in 0..32 {
        zero[j] = 0;
    }
    assert(op_id_zero(zero));
    assert(!op_id_zero(OPID_01));
    const ms: [3]TimingMeasurement = [3]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 500, },
        TimingMeasurement { op_id: OPID_02, duration_us: 500, },
        TimingMeasurement { op_id: OPID_01, duration_us: 500, },
    };
    assert(!op_seen_before(&ms, 0));
    assert(!op_seen_before(&ms, 1));
    assert(op_seen_before(&ms, 2));
}

// Rule order is the original's: the zero duration before the
// floor, the floor before the repeated id, the ceiling before
// the repeated id, the repeated id before the batch variance -
// and the batch ceiling before any measurement.
test rule_order_matches_original {
    const zero_fast: [1]TimingMeasurement = [1]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 0, },
    };
    const v1 = validate_timing_constancy(&zero_fast);
    assert(v1.code == TimingSideChannelCode.ZeroDuration);

    const fast_twins: [2]TimingMeasurement = [2]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 99, },
        TimingMeasurement { op_id: OPID_01, duration_us: 99, },
    };
    const v2 = validate_timing_constancy(&fast_twins);
    assert(v2.code == TimingSideChannelCode.TooFast);
    assert(v2.idx == 0);

    const slow_twins: [2]TimingMeasurement = [2]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 10001, },
        TimingMeasurement { op_id: OPID_01, duration_us: 10001, },
    };
    const v3 = validate_timing_constancy(&slow_twins);
    assert(v3.code == TimingSideChannelCode.TooSlow);
    assert(v3.idx == 0);

    const dup_high_variance: [2]TimingMeasurement = [2]TimingMeasurement{
        TimingMeasurement { op_id: OPID_01, duration_us: 500, },
        TimingMeasurement { op_id: OPID_01, duration_us: 1501, },
    };
    const v4 = validate_timing_constancy(&dup_high_variance);
    assert(v4.code == TimingSideChannelCode.DuplicateOpId);
    assert(v4.idx == 1);

    var flooded: [1025]TimingMeasurement;
    for i in 0..1025 {
        var id: [32]u8;
        for j in 0..32 {
            id[j] = 0;
        }
        flooded[i] = TimingMeasurement { op_id: id, duration_us: 0, };
    }
    const v5 = validate_timing_constancy(&flooded);
    assert(v5.code == TimingSideChannelCode.TooMany);
}
