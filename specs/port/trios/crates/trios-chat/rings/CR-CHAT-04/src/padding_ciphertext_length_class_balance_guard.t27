module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_ciphertext_length_class_balance_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_ciphertext_length_class_balance_guard.rs
// (CR-CHAT-04 - Padding ciphertext length class balance guard,
// Wave-131 Lane B, requirement R-CHAT-4).
//
// Ciphertext must spread evenly over the length classes: the
// most populated class likely holds the real messages, a sparse
// class reads as cover, and the class distribution profile
// fingerprints the user. The rules, in the original's order: the
// batch ceiling, the record floor, then per record the zero-size
// probe, the class-index ceiling and the repeated-id scan, then
// over the whole batch the chi-squared ceiling on the class
// counts.
//
// The original returns Result<(), ClassBalanceError>. This port
// carries the verdict as a named struct (owner decision D5): Ok
// first, then the six error variants in the original's
// declaration order - Imbalanced, TooFew, InvalidClass,
// DuplicateRecordId, ZeroSize, TooMany - with every payload
// field: the measured and ceiling chi-squared for Imbalanced,
// got and min for TooFew, idx, got and max for InvalidClass, idx
// for the id and size rules, and got and max for the ceiling.
//
// The class counts accumulate in f64 from the start (the
// int-to-float cast the backends reject), the arithmetic
// identical for integer counts. The BTreeSet dedup becomes a
// scan over the records already visited.

// Number of length classes.
pub const PCLB_NUM_CLASSES: usize = 4;

// Maximum chi-squared statistic.
pub const PCLB_MAX_CHI_SQUARED: f64 = 15.0;

// Minimum records for chi-squared validity.
pub const PCLB_MIN_RECORDS: usize = 16;

// Maximum records per batch.
pub const PCLB_MAX_RECORDS: usize = 4096;

// Record ID length.
pub const PCLB_RECORD_ID_LEN: usize = 32;

// A ciphertext length class record.
pub struct ClassRecord {
    record_id: [32]u8,
    class_index: usize,
    size: usize,
}

// Verdict codes: Ok(()) and ClassBalanceError's variants, in declaration order.
pub enum ClassBalanceCode {
    Ok,
    Imbalanced,
    TooFew,
    InvalidClass,
    DuplicateRecordId,
    ZeroSize,
    TooMany,
}

// The verdict of the class balance validation, with every error
// payload field.
pub struct ClassBalanceVerdict {
    code: ClassBalanceCode,
    idx: usize,
    got: usize,
    bound: usize,
    got_f: f64,
    bound_f: f64,
}

// Whole-form equality over the fixed thirty-two record-id
// bytes.
pub fn record_ids_equal(a: [32]u8, b: [32]u8) -> bool {
    for i in 0..32 {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

// Whether record i repeats an earlier id - the original's
// BTreeSet insert probe, answered by a scan.
pub fn rid_seen_before(records: []const ClassRecord, i: usize) -> bool {
    for j in 0..i {
        if (record_ids_equal(records[j].record_id, records[i].record_id)) {
            return true;
        }
    }
    return false;
}

// The chi-squared distance of the observed class counts from a
// flat distribution - the original's chi_squared_flat over the
// f64 count table. A zero total answers zero, and so does a
// zero expectation.
pub fn chi_squared_flat(observed: [4]f64) -> f64 {
    var total: f64 = 0.0;
    for i in 0..4 {
        total = total + observed[i];
    }
    if (total == 0.0) {
        return 0.0;
    }
    const expected: f64 = total / 4.0;
    if (expected == 0.0) {
        return 0.0;
    }
    var chi: f64 = 0.0;
    var diff: f64 = 0.0;
    for i in 0..4 {
        diff = observed[i] - expected;
        chi = chi + diff * diff / expected;
    }
    return chi;
}

// [VERIFIED] Validate padding ciphertext length class balance.
// Returns Ok only when every rule holds, checked in the
// original's order: the batch ceiling, the record floor, then
// per record the zero size, the class ceiling and the repeated
// id, then the chi-squared ceiling over the class counts.
pub fn validate_class_balance(records: []const ClassRecord) -> ClassBalanceVerdict {
    if (records.len > PCLB_MAX_RECORDS) {
        return ClassBalanceVerdict { code: ClassBalanceCode.TooMany, idx: 0, got: records.len, bound: PCLB_MAX_RECORDS, got_f: 0.0, bound_f: 0.0, };
    }
    if (records.len < PCLB_MIN_RECORDS) {
        return ClassBalanceVerdict { code: ClassBalanceCode.TooFew, idx: 0, got: records.len, bound: PCLB_MIN_RECORDS, got_f: 0.0, bound_f: 0.0, };
    }
    var counts: [4]f64 = [4]f64{0.0, 0.0, 0.0, 0.0,};
    for i in 0..records.len {
        if (records[i].size == 0) {
            return ClassBalanceVerdict { code: ClassBalanceCode.ZeroSize, idx: i, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, };
        }
        if (records[i].class_index >= PCLB_NUM_CLASSES) {
            return ClassBalanceVerdict { code: ClassBalanceCode.InvalidClass, idx: i, got: records[i].class_index, bound: PCLB_NUM_CLASSES - 1, got_f: 0.0, bound_f: 0.0, };
        }
        if (rid_seen_before(records, i)) {
            return ClassBalanceVerdict { code: ClassBalanceCode.DuplicateRecordId, idx: i, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, };
        }
        counts[records[i].class_index] = counts[records[i].class_index] + 1.0;
    }
    const chi: f64 = chi_squared_flat(counts);
    if (chi > PCLB_MAX_CHI_SQUARED) {
        return ClassBalanceVerdict { code: ClassBalanceCode.Imbalanced, idx: 0, got: 0, bound: 0, got_f: chi, bound_f: PCLB_MAX_CHI_SQUARED, };
    }
    return ClassBalanceVerdict { code: ClassBalanceCode.Ok, idx: 0, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, };
}

