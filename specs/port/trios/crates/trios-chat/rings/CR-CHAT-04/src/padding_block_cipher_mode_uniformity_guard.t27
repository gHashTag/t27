module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_block_cipher_mode_uniformity_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_block_cipher_mode_uniformity_guard.rs
// (CR-CHAT-04 - Padding block cipher mode uniformity guard,
// Wave-120 Lane B, requirement R-CHAT-4).
//
// Padded ciphertext blocks must be statistically uniform: a
// padding block encrypted under a different distribution than a
// payload block is separable by frequency analysis, ECB-style
// modes fingerprint repeated patterns, and a chi-squared probe
// reads the mode off the wire. The rules, in the original's
// order: the batch ceiling, then per block the size check, the
// zero-block probe, the entropy floor, the repeated-hash scan
// and the repeated-index scan.
//
// The original returns Result<(), BlockUniformityError>. This
// port carries the verdict as a named struct (owner decision D5):
// Ok first, then the six error variants in the original's
// declaration order - BelowMinEntropy, WrongSize, ZeroBlock,
// DuplicateHash, DuplicateIndex, TooMany - with every payload
// field: idx and the measured/min entropy for BelowMinEntropy,
// idx and the got/expected sizes for WrongSize, idx for the
// zero, hash and index rules, and got and max for the ceiling.
//
// The original's Vec<u8> block data becomes the fixed [16]u8
// form plus its length (the bytes stay, the zero-block probe
// reads them), and the Shannon entropy over the bytes arrives as
// a number the caller computed - the lane convention for
// statistics over byte buffers, and here also a necessity: the
// t27c gen-rust backend does not yet lower @log (it emits a
// zero-arity .log() call, E0061 under rustc), while the native
// backend computes it fine. Both BTreeSet dedups become scans
// over the blocks already visited.

// Block size in bytes.
pub const PBCU_BLOCK_SIZE: usize = 16;

// Minimum entropy per block in bits per byte.
pub const PBCU_MIN_ENTROPY: f64 = 3.0;

// Maximum blocks per batch.
pub const PBCU_MAX_BLOCKS: usize = 4096;

// Hash length for dedup.
pub const PBCU_HASH_LEN: usize = 32;

// A ciphertext block record: the block index, the data length
// and sixteen data bytes, the entropy the caller measured over
// the data, and the dedup hash.
pub struct BlockRecord {
    block_index: u64,
    data_len: usize,
    block_data: [16]u8,
    entropy: f64,
    block_hash: [32]u8,
}

// Verdict codes: Ok(()) and BlockUniformityError's variants, in declaration order.
pub enum BlockUniformityCode {
    Ok,
    BelowMinEntropy,
    WrongSize,
    ZeroBlock,
    DuplicateHash,
    DuplicateIndex,
    TooMany,
}

// The verdict of the block uniformity validation, with every
// error payload field.
pub struct BlockUniformityVerdict {
    code: BlockUniformityCode,
    idx: usize,
    got: usize,
    bound: usize,
    got_f: f64,
    bound_f: f64,
}

// Whole-form equality over the fixed thirty-two hash bytes.
pub fn block_hashes_equal(a: [32]u8, b: [32]u8) -> bool {
    for i in 0..32 {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

// The all-zero block - the original's iter().all zero probe.
pub fn block_data_zero(data: [16]u8) -> bool {
    for i in 0..16 {
        if (data[i] != 0) {
            return false;
        }
    }
    return true;
}

// Whether block i repeats an earlier hash - the original's
// BTreeSet insert probe, answered by a scan.
pub fn hash_seen_before(blocks: []const BlockRecord, i: usize) -> bool {
    for j in 0..i {
        if (block_hashes_equal(blocks[j].block_hash, blocks[i].block_hash)) {
            return true;
        }
    }
    return false;
}

// Whether block i repeats an earlier index - the original's
// second BTreeSet, answered by the same scan.
pub fn index_seen_before(blocks: []const BlockRecord, i: usize) -> bool {
    for j in 0..i {
        if (blocks[j].block_index == blocks[i].block_index) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate padding block cipher mode uniformity.
// Returns Ok only when every rule holds, checked in the
// original's order: the batch ceiling, then per block the size,
// the zero probe, the entropy floor, the repeated hash and the
// repeated index.
pub fn validate_block_uniformity(blocks: []const BlockRecord) -> BlockUniformityVerdict {
    if (blocks.len > PBCU_MAX_BLOCKS) {
        return BlockUniformityVerdict { code: BlockUniformityCode.TooMany, idx: 0, got: blocks.len, bound: PBCU_MAX_BLOCKS, got_f: 0.0, bound_f: 0.0, };
    }
    for i in 0..blocks.len {
        if (blocks[i].data_len != PBCU_BLOCK_SIZE) {
            return BlockUniformityVerdict { code: BlockUniformityCode.WrongSize, idx: i, got: blocks[i].data_len, bound: PBCU_BLOCK_SIZE, got_f: 0.0, bound_f: 0.0, };
        }
        if (block_data_zero(blocks[i].block_data)) {
            return BlockUniformityVerdict { code: BlockUniformityCode.ZeroBlock, idx: i, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, };
        }
        if (blocks[i].entropy < PBCU_MIN_ENTROPY) {
            return BlockUniformityVerdict { code: BlockUniformityCode.BelowMinEntropy, idx: i, got: 0, bound: 0, got_f: blocks[i].entropy, bound_f: PBCU_MIN_ENTROPY, };
        }
        if (hash_seen_before(blocks, i)) {
            return BlockUniformityVerdict { code: BlockUniformityCode.DuplicateHash, idx: i, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, };
        }
        if (index_seen_before(blocks, i)) {
            return BlockUniformityVerdict { code: BlockUniformityCode.DuplicateIndex, idx: i, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, };
        }
    }
    return BlockUniformityVerdict { code: BlockUniformityCode.Ok, idx: 0, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, };
}

// The block data of the fixtures: the original's
// high_entropy_block(seed) walks (i * 79 + seed) mod 256 over
// sixteen bytes - sixteen distinct values, a true four-bit
// entropy each - and its low_entropy_block of sixteen 0x01.
pub const HIGH_ENTROPY_42: [16]u8 = [16]u8{66, 145, 224, 47, 126, 205, 28, 107, 186, 9, 88, 167, 246, 69, 148, 227,};
pub const HIGH_ENTROPY_55: [16]u8 = [16]u8{85, 164, 243, 66, 145, 224, 47, 126, 205, 28, 107, 186, 9, 88, 167, 246,};
