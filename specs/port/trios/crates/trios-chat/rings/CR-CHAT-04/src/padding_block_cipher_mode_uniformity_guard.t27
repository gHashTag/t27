// **PBCU-01** - low entropy rejected: sixteen 0x01 bytes measure
// zero bits per byte against the floor of three.
test pbcu_01_low_entropy_rejected {
    const blocks: [1]BlockRecord = [1]BlockRecord{
        BlockRecord { block_index: 0, data_len: 16, block_data: LOW_ENTROPY_DATA, entropy: 0.0, block_hash: HASH_01, },
    };
    const v = validate_block_uniformity(&blocks);
    assert(v.code == BlockUniformityCode.BelowMinEntropy);
    assert(v.idx == 0);
    assert(v.got_f == 0.0);
    assert(v.bound_f == 3.0);
}

// **PBCU-02** - wrong size rejected: eight bytes of the sixteen
// the mode requires.
test pbcu_02_wrong_size_rejected {
    const blocks: [1]BlockRecord = [1]BlockRecord{
        BlockRecord { block_index: 0, data_len: 8, block_data: HIGH_ENTROPY_42, entropy: 4.0, block_hash: HASH_01, },
    };
    const v = validate_block_uniformity(&blocks);
    assert(v.code == BlockUniformityCode.WrongSize);
    assert(v.idx == 0);
    assert(v.got == 8);
    assert(v.bound == 16);
}

// **PBCU-03** - zero block rejected: sixteen zero bytes under a
// live hash.
test pbcu_03_zero_block_rejected {
    const blocks: [1]BlockRecord = [1]BlockRecord{
        BlockRecord { block_index: 0, data_len: 16, block_data: ZERO_DATA_16, entropy: 4.0, block_hash: HASH_01, },
    };
    const v = validate_block_uniformity(&blocks);
    assert(v.code == BlockUniformityCode.ZeroBlock);
    assert(v.idx == 0);
}

// **PBCU-04** - duplicate hash rejected: the second block
// repeats the first's hash under different data.
test pbcu_04_duplicate_hash_rejected {
    const blocks: [2]BlockRecord = [2]BlockRecord{
        BlockRecord { block_index: 0, data_len: 16, block_data: HIGH_ENTROPY_42, entropy: 4.0, block_hash: HASH_01, },
        BlockRecord { block_index: 1, data_len: 16, block_data: HIGH_ENTROPY_55, entropy: 4.0, block_hash: HASH_01, },
    };
    const v = validate_block_uniformity(&blocks);
    assert(v.code == BlockUniformityCode.DuplicateHash);
    assert(v.idx == 1);
}

// **PBCU-05** - duplicate index rejected: the second block
// repeats the first's index under a different hash.
test pbcu_05_duplicate_index_rejected {
    const blocks: [2]BlockRecord = [2]BlockRecord{
        BlockRecord { block_index: 0, data_len: 16, block_data: HIGH_ENTROPY_42, entropy: 4.0, block_hash: HASH_01, },
        BlockRecord { block_index: 0, data_len: 16, block_data: HIGH_ENTROPY_55, entropy: 4.0, block_hash: HASH_02, },
    };
    const v = validate_block_uniformity(&blocks);
    assert(v.code == BlockUniformityCode.DuplicateIndex);
    assert(v.idx == 1);
}

// **PBCU-06** - too many rejected: 4097 blocks of a maximum
// 4096, built in a loop like the original's. The batch rule
// fires before any block is examined, so every record carries
// the same minimal block.
test pbcu_06_too_many_rejected {
    var blocks: [4097]BlockRecord;
    for i in 0..4097 {
        var h: [32]u8;
        for j in 0..32 {
            h[j] = 0;
        }
        h[0] = PBCU_FLOOD_4097[i];
        blocks[i] = BlockRecord { block_index: @as(u64, i), data_len: 16, block_data: HIGH_ENTROPY_42, entropy: 4.0, block_hash: h, };
    }
    const v = validate_block_uniformity(&blocks);
    assert(v.code == BlockUniformityCode.TooMany);
    assert(v.got == 4097);
    assert(v.bound == 4096);
}

// **PBCU-07** - the valid batch accepted: three blocks, three
// seeds, three hashes, three indices.
test pbcu_07_valid_accepted {
    const blocks: [3]BlockRecord = [3]BlockRecord{
        BlockRecord { block_index: 0, data_len: 16, block_data: HIGH_ENTROPY_42, entropy: 4.0, block_hash: HASH_01, },
        BlockRecord { block_index: 1, data_len: 16, block_data: HIGH_ENTROPY_55, entropy: 4.0, block_hash: HASH_02, },
        BlockRecord { block_index: 2, data_len: 16, block_data: HIGH_ENTROPY_99, entropy: 4.0, block_hash: HASH_03, },
    };
    const v = validate_block_uniformity(&blocks);
    assert(v.code == BlockUniformityCode.Ok);
}

// **PBCU-08** - an empty batch accepted.
test pbcu_08_empty_accepted {
    const blocks: [0]BlockRecord = [0]BlockRecord{};
    const v = validate_block_uniformity(&blocks);
    assert(v.code == BlockUniformityCode.Ok);
}

// **PBCU-09** - a single block accepted.
test pbcu_09_single_accepted {
    const blocks: [1]BlockRecord = [1]BlockRecord{
        BlockRecord { block_index: 0, data_len: 16, block_data: HIGH_ENTROPY_42, entropy: 4.0, block_hash: HASH_01, },
    };
    const v = validate_block_uniformity(&blocks);
    assert(v.code == BlockUniformityCode.Ok);
}

// **PBCU-10** - a large batch accepted: 256 blocks, each hash
// the big-endian u64 of its index plus one. Every block carries
// the same sixteen-byte spread - for each index the original's
// (i * 79 + seed) walk yields sixteen distinct bytes and the
// same four-bit entropy, and the entropy rule reads the
// caller-computed field, never the data.
test pbcu_10_large_batch_accepted {
    var blocks: [256]BlockRecord;
    for i in 0..256 {
        var h: [32]u8;
        for j in 0..32 {
            h[j] = 0;
        }
        h[6] = PBCU_H6_256[i];
        h[7] = PBCU_H7_256[i];
        blocks[i] = BlockRecord { block_index: @as(u64, i), data_len: 16, block_data: HIGH_ENTROPY_42, entropy: 4.0, block_hash: h, };
    }
    const v = validate_block_uniformity(&blocks);
    assert(v.code == BlockUniformityCode.Ok);
}

// The four helpers have direct tests (coverage: Untested 0).
test pbcu_helpers_answer {
    assert(block_hashes_equal(HASH_01, HASH_01));
    assert(!block_hashes_equal(HASH_01, HASH_02));
    assert(block_data_zero(ZERO_DATA_16));
    assert(!block_data_zero(HIGH_ENTROPY_42));
    const three: [3]BlockRecord = [3]BlockRecord{
        BlockRecord { block_index: 0, data_len: 16, block_data: HIGH_ENTROPY_42, entropy: 4.0, block_hash: HASH_01, },
        BlockRecord { block_index: 1, data_len: 16, block_data: HIGH_ENTROPY_55, entropy: 4.0, block_hash: HASH_02, },
        BlockRecord { block_index: 0, data_len: 16, block_data: HIGH_ENTROPY_99, entropy: 4.0, block_hash: HASH_01, },
    };
    assert(!hash_seen_before(&three, 0));
    assert(!hash_seen_before(&three, 1));
    assert(hash_seen_before(&three, 2));
    assert(!index_seen_before(&three, 0));
    assert(!index_seen_before(&three, 1));
    assert(index_seen_before(&three, 2));
}

// Rule order is the original's: the size before the zero probe,
// the zero probe before the entropy floor, the entropy floor
// before the hash scan, the hash scan before the index scan -
// and the batch ceiling before any block.
test rule_order_matches_original {
    const short_zero: [1]BlockRecord = [1]BlockRecord{
        BlockRecord { block_index: 0, data_len: 8, block_data: ZERO_DATA_16, entropy: 0.0, block_hash: HASH_01, },
    };
    const v1 = validate_block_uniformity(&short_zero);
    assert(v1.code == BlockUniformityCode.WrongSize);

    const zero_low: [1]BlockRecord = [1]BlockRecord{
        BlockRecord { block_index: 0, data_len: 16, block_data: ZERO_DATA_16, entropy: 0.0, block_hash: HASH_01, },
    };
    const v2 = validate_block_uniformity(&zero_low);
    assert(v2.code == BlockUniformityCode.ZeroBlock);

    const low_twin_hash: [2]BlockRecord = [2]BlockRecord{
        BlockRecord { block_index: 0, data_len: 16, block_data: HIGH_ENTROPY_42, entropy: 0.0, block_hash: HASH_01, },
        BlockRecord { block_index: 1, data_len: 16, block_data: HIGH_ENTROPY_55, entropy: 4.0, block_hash: HASH_01, },
    };
    const v3 = validate_block_uniformity(&low_twin_hash);
    assert(v3.code == BlockUniformityCode.BelowMinEntropy);
    assert(v3.idx == 0);

    const twin_hash_twin_index: [2]BlockRecord = [2]BlockRecord{
        BlockRecord { block_index: 0, data_len: 16, block_data: HIGH_ENTROPY_42, entropy: 4.0, block_hash: HASH_01, },
        BlockRecord { block_index: 0, data_len: 16, block_data: HIGH_ENTROPY_55, entropy: 4.0, block_hash: HASH_01, },
    };
    const v4 = validate_block_uniformity(&twin_hash_twin_index);
    assert(v4.code == BlockUniformityCode.DuplicateHash);
    assert(v4.idx == 1);

    var flooded: [4097]BlockRecord;
    for i in 0..4097 {
        flooded[i] = BlockRecord { block_index: 0, data_len: 16, block_data: ZERO_DATA_16, entropy: 0.0, block_hash: HASH_01, };
    }
    const v5 = validate_block_uniformity(&flooded);
    assert(v5.code == BlockUniformityCode.TooMany);
}
