// **PBAU-01** - non-uniform rejected: the second block aligns to
// thirty-two where the first set sixteen.
test pbau_01_non_uniform_rejected {
    const blocks: [2]AlignmentRecord = [2]AlignmentRecord{
        AlignmentRecord { block_id: BID_01, alignment: 16, },
        AlignmentRecord { block_id: BID_02, alignment: 32, },
    };
    const v = validate_alignment_uniformity(&blocks);
    assert(v.code == AlignmentUniformityCode.NonUniform);
    assert(v.idx == 1);
    assert(v.bound == 16);
    assert(v.got == 32);
}

// **PBAU-02** - zero block id rejected.
test pbau_02_zero_id_rejected {
    const blocks: [1]AlignmentRecord = [1]AlignmentRecord{
        AlignmentRecord { block_id: ZERO_BID, alignment: 16, },
    };
    const v = validate_alignment_uniformity(&blocks);
    assert(v.code == AlignmentUniformityCode.ZeroBlockId);
    assert(v.idx == 0);
}

// **PBAU-03** - duplicate block id rejected: the second block
// repeats the first's id.
test pbau_03_duplicate_rejected {
    const blocks: [2]AlignmentRecord = [2]AlignmentRecord{
        AlignmentRecord { block_id: BID_01, alignment: 16, },
        AlignmentRecord { block_id: BID_01, alignment: 16, },
    };
    const v = validate_alignment_uniformity(&blocks);
    assert(v.code == AlignmentUniformityCode.DuplicateBlockId);
    assert(v.idx == 1);
}

// **PBAU-04** - not a power of two rejected: twenty-four.
test pbau_04_not_power_of_two_rejected {
    const blocks: [1]AlignmentRecord = [1]AlignmentRecord{
        AlignmentRecord { block_id: BID_01, alignment: 24, },
    };
    const v = validate_alignment_uniformity(&blocks);
    assert(v.code == AlignmentUniformityCode.NotPowerOfTwo);
    assert(v.idx == 0);
    assert(v.got == 24);
}

// **PBAU-05** - below the minimum rejected: eight of a floor
// sixteen.
test pbau_05_below_min_rejected {
    const blocks: [1]AlignmentRecord = [1]AlignmentRecord{
        AlignmentRecord { block_id: BID_01, alignment: 8, },
    };
    const v = validate_alignment_uniformity(&blocks);
    assert(v.code == AlignmentUniformityCode.BelowMinimum);
    assert(v.idx == 0);
    assert(v.got == 8);
    assert(v.bound == 16);
}

// **PBAU-06** - too many rejected: 1025 blocks of a maximum
// 1024, built in a loop like the original's, each id carrying
// the big-endian u64 of its index plus one. The batch rule fires
// before any block is examined.
test pbau_06_too_many_rejected {
    var blocks: [1025]AlignmentRecord;
    for i in 0..1025 {
        var id: [16]u8;
        for j in 0..16 {
            id[j] = 0;
        }
        id[6] = PBAU_ID6_1025[i];
        id[7] = PBAU_ID7_1025[i];
        blocks[i] = AlignmentRecord { block_id: id, alignment: 16, };
    }
    const v = validate_alignment_uniformity(&blocks);
    assert(v.code == AlignmentUniformityCode.TooMany);
    assert(v.got == 1025);
    assert(v.bound == 1024);
}

// **PBAU-07** - the valid batch accepted: three blocks aligned
// to sixteen.
test pbau_07_valid_accepted {
    const blocks: [3]AlignmentRecord = [3]AlignmentRecord{
        AlignmentRecord { block_id: BID_01, alignment: 16, },
        AlignmentRecord { block_id: BID_02, alignment: 16, },
        AlignmentRecord { block_id: BID_03, alignment: 16, },
    };
    const v = validate_alignment_uniformity(&blocks);
    assert(v.code == AlignmentUniformityCode.Ok);
}

// **PBAU-08** - an empty batch accepted.
test pbau_08_empty_accepted {
    const blocks: [0]AlignmentRecord = [0]AlignmentRecord{};
    const v = validate_alignment_uniformity(&blocks);
    assert(v.code == AlignmentUniformityCode.Ok);
}

// **PBAU-09** - a single block accepted, alignment sixty-four.
test pbau_09_single_accepted {
    const blocks: [1]AlignmentRecord = [1]AlignmentRecord{
        AlignmentRecord { block_id: BID_01, alignment: 64, },
    };
    const v = validate_alignment_uniformity(&blocks);
    assert(v.code == AlignmentUniformityCode.Ok);
}

// **PBAU-10** - many uniform blocks accepted: fifty blocks all
// aligned to thirty-two.
test pbau_10_many_uniform_accepted {
    var blocks: [50]AlignmentRecord;
    for i in 0..50 {
        var id: [16]u8;
        for j in 0..16 {
            id[j] = 0;
        }
        id[0] = PBAU_ID_BYTES_50[i];
        blocks[i] = AlignmentRecord { block_id: id, alignment: 32, };
    }
    const v = validate_alignment_uniformity(&blocks);
    assert(v.code == AlignmentUniformityCode.Ok);
}

// The four helpers have direct tests (coverage: Untested 0).
test pbau_helpers_answer {
    assert(block_ids_equal(BID_01, BID_01));
    assert(!block_ids_equal(BID_01, BID_02));
    assert(block_id_zero(ZERO_BID));
    assert(!block_id_zero(BID_01));
    const three: [3]AlignmentRecord = [3]AlignmentRecord{
        AlignmentRecord { block_id: BID_01, alignment: 16, },
        AlignmentRecord { block_id: BID_02, alignment: 16, },
        AlignmentRecord { block_id: BID_01, alignment: 16, },
    };
    assert(!block_seen_before(&three, 0));
    assert(!block_seen_before(&three, 1));
    assert(block_seen_before(&three, 2));
    assert(is_power_of_two(1));
    assert(is_power_of_two(2));
    assert(is_power_of_two(16));
    assert(is_power_of_two(1024));
    assert(!is_power_of_two(0));
    assert(!is_power_of_two(24));
    assert(!is_power_of_two(48));
    assert(!is_power_of_two(18446744073709551615));
}

// Rule order is the original's: the zero id before the duplicate,
// the duplicate before the alignment floor, the floor before the
// power-of-two probe, and the power probe before the uniformity
// check.
test rule_order_matches_original {
    const zero_twins: [2]AlignmentRecord = [2]AlignmentRecord{
        AlignmentRecord { block_id: ZERO_BID, alignment: 16, },
        AlignmentRecord { block_id: ZERO_BID, alignment: 16, },
    };
    const v1 = validate_alignment_uniformity(&zero_twins);
    assert(v1.code == AlignmentUniformityCode.ZeroBlockId);
    assert(v1.idx == 0);

    const dup_low: [2]AlignmentRecord = [2]AlignmentRecord{
        AlignmentRecord { block_id: BID_01, alignment: 16, },
        AlignmentRecord { block_id: BID_01, alignment: 8, },
    };
    const v2 = validate_alignment_uniformity(&dup_low);
    assert(v2.code == AlignmentUniformityCode.DuplicateBlockId);
    assert(v2.idx == 1);

    const floor_non_power: [1]AlignmentRecord = [1]AlignmentRecord{
        AlignmentRecord { block_id: BID_01, alignment: 12, },
    };
    const v3 = validate_alignment_uniformity(&floor_non_power);
    assert(v3.code == AlignmentUniformityCode.BelowMinimum);
    assert(v3.got == 12);

    const power_before_uniform: [2]AlignmentRecord = [2]AlignmentRecord{
        AlignmentRecord { block_id: BID_01, alignment: 32, },
        AlignmentRecord { block_id: BID_02, alignment: 24, },
    };
    const v4 = validate_alignment_uniformity(&power_before_uniform);
    assert(v4.code == AlignmentUniformityCode.NotPowerOfTwo);
    assert(v4.idx == 1);
    assert(v4.got == 24);
}
