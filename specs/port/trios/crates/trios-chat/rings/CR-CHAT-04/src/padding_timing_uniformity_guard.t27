// **PTU-01** - high CV rejected: five observations at a hundred
// microseconds and five at ten million - CV x10000 of 9999 over
// the ceiling of 1500.
test ptu_01_high_cv_rejected {
    const obs_set: [10]TimingObservation = [10]TimingObservation{
        TimingObservation { obs_id: OID_01, interval_us: 100, },
        TimingObservation { obs_id: OID_02, interval_us: 100, },
        TimingObservation { obs_id: OID_03, interval_us: 100, },
        TimingObservation { obs_id: OID_04, interval_us: 100, },
        TimingObservation { obs_id: OID_05, interval_us: 100, },
        TimingObservation { obs_id: OID_06, interval_us: 10000000, },
        TimingObservation { obs_id: OID_07, interval_us: 10000000, },
        TimingObservation { obs_id: OID_08, interval_us: 10000000, },
        TimingObservation { obs_id: OID_09, interval_us: 10000000, },
        TimingObservation { obs_id: OID_10, interval_us: 10000000, },
    };
    const v = validate_timing_uniformity(&obs_set);
    assert(v.code == TimingUniformityCode.HighCv);
    assert(v.got64 == 9999);
    assert(v.bound64 == 1500);
}

// **PTU-02** - low mean rejected: ten observations at ten
// microseconds - a mean of ten under the floor of a hundred.
test ptu_02_low_mean_rejected {
    const obs_set: [10]TimingObservation = [10]TimingObservation{
        TimingObservation { obs_id: OID_01, interval_us: 10, },
        TimingObservation { obs_id: OID_02, interval_us: 10, },
        TimingObservation { obs_id: OID_03, interval_us: 10, },
        TimingObservation { obs_id: OID_04, interval_us: 10, },
        TimingObservation { obs_id: OID_05, interval_us: 10, },
        TimingObservation { obs_id: OID_06, interval_us: 10, },
        TimingObservation { obs_id: OID_07, interval_us: 10, },
        TimingObservation { obs_id: OID_08, interval_us: 10, },
        TimingObservation { obs_id: OID_09, interval_us: 10, },
        TimingObservation { obs_id: OID_10, interval_us: 10, },
    };
    const v = validate_timing_uniformity(&obs_set);
    assert(v.code == TimingUniformityCode.LowMean);
    assert(v.got64 == 10);
    assert(v.bound64 == 100);
}

// **PTU-03** - duplicate id rejected: the uniform batch plus one
// more observation repeating the first id.
test ptu_03_duplicate_rejected {
    const obs_set: [11]TimingObservation = [11]TimingObservation{
        TimingObservation { obs_id: OID_01, interval_us: 1000, },
        TimingObservation { obs_id: OID_02, interval_us: 1010, },
        TimingObservation { obs_id: OID_03, interval_us: 1020, },
        TimingObservation { obs_id: OID_04, interval_us: 1030, },
        TimingObservation { obs_id: OID_05, interval_us: 1040, },
        TimingObservation { obs_id: OID_06, interval_us: 1050, },
        TimingObservation { obs_id: OID_07, interval_us: 1060, },
        TimingObservation { obs_id: OID_08, interval_us: 1070, },
        TimingObservation { obs_id: OID_09, interval_us: 1080, },
        TimingObservation { obs_id: OID_10, interval_us: 1090, },
        TimingObservation { obs_id: OID_01, interval_us: 1000, },
    };
    const v = validate_timing_uniformity(&obs_set);
    assert(v.code == TimingUniformityCode.DuplicateId);
    assert(v.idx == 10);
}

// **PTU-04** - zero id rejected under live intervals.
test ptu_04_zero_id_rejected {
    const obs_set: [10]TimingObservation = [10]TimingObservation{
        TimingObservation { obs_id: ZERO_OID, interval_us: 1000, },
        TimingObservation { obs_id: OID_02, interval_us: 1010, },
        TimingObservation { obs_id: OID_03, interval_us: 1020, },
        TimingObservation { obs_id: OID_04, interval_us: 1030, },
        TimingObservation { obs_id: OID_05, interval_us: 1040, },
        TimingObservation { obs_id: OID_06, interval_us: 1050, },
        TimingObservation { obs_id: OID_07, interval_us: 1060, },
        TimingObservation { obs_id: OID_08, interval_us: 1070, },
        TimingObservation { obs_id: OID_09, interval_us: 1080, },
        TimingObservation { obs_id: OID_10, interval_us: 1090, },
    };
    const v = validate_timing_uniformity(&obs_set);
    assert(v.code == TimingUniformityCode.ZeroId);
    assert(v.idx == 0);
}

// **PTU-05** - too few rejected: three observations of a required
// eight.
test ptu_05_too_few_rejected {
    const obs_set: [3]TimingObservation = [3]TimingObservation{
        TimingObservation { obs_id: OID_01, interval_us: 1000, },
        TimingObservation { obs_id: OID_02, interval_us: 1000, },
        TimingObservation { obs_id: OID_03, interval_us: 1000, },
    };
    const v = validate_timing_uniformity(&obs_set);
    assert(v.code == TimingUniformityCode.TooFew);
    assert(v.got == 3);
    assert(v.bound == 8);
}

// **PTU-06** - too many rejected: 4097 observations of a maximum
// 4096, built in a loop like the original's, each id carrying
// the big-endian u64 of its index plus one. The batch rule fires
// before any observation is examined.
test ptu_06_too_many_rejected {
    var obs_set: [4097]TimingObservation;
    for i in 0..4097 {
        var id: [16]u8;
        for j in 0..16 {
            id[j] = 0;
        }
        id[6] = PTU_ID6_4097[i];
        id[7] = PTU_ID7_4097[i];
        obs_set[i] = TimingObservation { obs_id: id, interval_us: 1000, };
    }
    const v = validate_timing_uniformity(&obs_set);
    assert(v.code == TimingUniformityCode.TooMany);
    assert(v.got == 4097);
    assert(v.bound == 4096);
}

// **PTU-07** - the uniform batch accepted: ten observations
// stepping by ten microseconds from a thousand - CV x10000 of 267.
test ptu_07_valid_accepted {
    const obs_set: [10]TimingObservation = [10]TimingObservation{
        TimingObservation { obs_id: OID_01, interval_us: 1000, },
        TimingObservation { obs_id: OID_02, interval_us: 1010, },
        TimingObservation { obs_id: OID_03, interval_us: 1020, },
        TimingObservation { obs_id: OID_04, interval_us: 1030, },
        TimingObservation { obs_id: OID_05, interval_us: 1040, },
        TimingObservation { obs_id: OID_06, interval_us: 1050, },
        TimingObservation { obs_id: OID_07, interval_us: 1060, },
        TimingObservation { obs_id: OID_08, interval_us: 1070, },
        TimingObservation { obs_id: OID_09, interval_us: 1080, },
        TimingObservation { obs_id: OID_10, interval_us: 1090, },
    };
    const v = validate_timing_uniformity(&obs_set);
    assert(v.code == TimingUniformityCode.Ok);
}

// **PTU-08** - an empty batch rejected on the observation floor.
test ptu_08_empty_rejected {
    const obs_set: [0]TimingObservation = [0]TimingObservation{};
    const v = validate_timing_uniformity(&obs_set);
    assert(v.code == TimingUniformityCode.TooFew);
    assert(v.got == 0);
    assert(v.bound == 8);
}

// **PTU-09** - exactly the minimum count accepted: eight
// identical intervals.
test ptu_09_exact_min_accepted {
    const obs_set: [8]TimingObservation = [8]TimingObservation{
        TimingObservation { obs_id: OID_01, interval_us: 1000, },
        TimingObservation { obs_id: OID_02, interval_us: 1000, },
        TimingObservation { obs_id: OID_03, interval_us: 1000, },
        TimingObservation { obs_id: OID_04, interval_us: 1000, },
        TimingObservation { obs_id: OID_05, interval_us: 1000, },
        TimingObservation { obs_id: OID_06, interval_us: 1000, },
        TimingObservation { obs_id: OID_07, interval_us: 1000, },
        TimingObservation { obs_id: OID_08, interval_us: 1000, },
    };
    const v = validate_timing_uniformity(&obs_set);
    assert(v.code == TimingUniformityCode.Ok);
}

// **PTU-10** - many uniform observations accepted: a hundred
// intervals stepping by one from five thousand.
test ptu_10_many_uniform_accepted {
    var obs_set: [100]TimingObservation;
    var t: u64 = 5000;
    for i in 0..100 {
        var id: [16]u8;
        for j in 0..16 {
            id[j] = 0;
        }
        id[0] = PTU_ID_BYTES_100[i];
        obs_set[i] = TimingObservation { obs_id: id, interval_us: t, };
        t = t + 1;
    }
    const v = validate_timing_uniformity(&obs_set);
    assert(v.code == TimingUniformityCode.Ok);
}

// The four helpers have direct tests (coverage: Untested 0).
test ptu_helpers_answer {
    assert(obs_ids_equal(OID_01, OID_01));
    assert(!obs_ids_equal(OID_01, OID_02));
    assert(obs_id_zero(ZERO_OID));
    assert(!obs_id_zero(OID_01));
    const three: [3]TimingObservation = [3]TimingObservation{
        TimingObservation { obs_id: OID_01, interval_us: 1000, },
        TimingObservation { obs_id: OID_02, interval_us: 1000, },
        TimingObservation { obs_id: OID_01, interval_us: 1000, },
    };
    assert(!obs_seen_before(&three, 0));
    assert(!obs_seen_before(&three, 1));
    assert(obs_seen_before(&three, 2));
    assert(approx_sqrt(0) == 0);
    assert(approx_sqrt(1) == 1);
    assert(approx_sqrt(825) == 28);
    assert(approx_sqrt(225) == 15);
    assert(approx_sqrt(18446744073709551615) == 4294967295);
}

// Rule order is the original's: the observation floor before any
// record, the zero id before the duplicate, the duplicate before
// the mean floor, the mean floor before the CV ceiling - and the
// CV ceiling admitting its exact boundary.
test rule_order_matches_original {
    const zero_twins: [8]TimingObservation = [8]TimingObservation{
        TimingObservation { obs_id: ZERO_OID, interval_us: 1000, },
        TimingObservation { obs_id: ZERO_OID, interval_us: 1000, },
        TimingObservation { obs_id: OID_03, interval_us: 1000, },
        TimingObservation { obs_id: OID_04, interval_us: 1000, },
        TimingObservation { obs_id: OID_05, interval_us: 1000, },
        TimingObservation { obs_id: OID_06, interval_us: 1000, },
        TimingObservation { obs_id: OID_07, interval_us: 1000, },
        TimingObservation { obs_id: OID_08, interval_us: 1000, },
    };
    const v1 = validate_timing_uniformity(&zero_twins);
    assert(v1.code == TimingUniformityCode.ZeroId);
    assert(v1.idx == 0);

    const dup_low_mean: [8]TimingObservation = [8]TimingObservation{
        TimingObservation { obs_id: OID_01, interval_us: 10, },
        TimingObservation { obs_id: OID_01, interval_us: 10, },
        TimingObservation { obs_id: OID_03, interval_us: 10, },
        TimingObservation { obs_id: OID_04, interval_us: 10, },
        TimingObservation { obs_id: OID_05, interval_us: 10, },
        TimingObservation { obs_id: OID_06, interval_us: 10, },
        TimingObservation { obs_id: OID_07, interval_us: 10, },
        TimingObservation { obs_id: OID_08, interval_us: 10, },
    };
    const v2 = validate_timing_uniformity(&dup_low_mean);
    assert(v2.code == TimingUniformityCode.DuplicateId);
    assert(v2.idx == 1);

    const low_mean_high_cv: [8]TimingObservation = [8]TimingObservation{
        TimingObservation { obs_id: OID_01, interval_us: 10, },
        TimingObservation { obs_id: OID_02, interval_us: 10, },
        TimingObservation { obs_id: OID_03, interval_us: 10, },
        TimingObservation { obs_id: OID_04, interval_us: 10, },
        TimingObservation { obs_id: OID_05, interval_us: 10, },
        TimingObservation { obs_id: OID_06, interval_us: 10, },
        TimingObservation { obs_id: OID_07, interval_us: 10, },
        TimingObservation { obs_id: OID_08, interval_us: 630, },
    };
    const v3 = validate_timing_uniformity(&low_mean_high_cv);
    assert(v3.code == TimingUniformityCode.LowMean);
    assert(v3.got64 == 87);

    const boundary_cv: [8]TimingObservation = [8]TimingObservation{
        TimingObservation { obs_id: OID_01, interval_us: 85, },
        TimingObservation { obs_id: OID_02, interval_us: 85, },
        TimingObservation { obs_id: OID_03, interval_us: 85, },
        TimingObservation { obs_id: OID_04, interval_us: 85, },
        TimingObservation { obs_id: OID_05, interval_us: 115, },
        TimingObservation { obs_id: OID_06, interval_us: 115, },
        TimingObservation { obs_id: OID_07, interval_us: 115, },
        TimingObservation { obs_id: OID_08, interval_us: 115, },
    };
    const v4 = validate_timing_uniformity(&boundary_cv);
    assert(v4.code == TimingUniformityCode.Ok);
}
