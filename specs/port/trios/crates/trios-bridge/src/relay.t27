// Pure decision functions (ported logic, testable)

// Decision: which routes to register and their HTTP methods
pub fn relay_app_routes() -> RouteTable {
    var routes: [4]RouteEntry = [
        RouteEntry { path: "/events", method: "GET", handler: "sse_events" },
        RouteEntry { path: "/agents", method: "GET", handler: "list_agents" },
        RouteEntry { path: "/dispatch", method: "POST", handler: "dispatch_task" },
        RouteEntry { path: "/health", method: "GET", handler: "health_check" },
    ];
    return RouteTable { entries: routes, count: 4 };
}

struct RouteEntry {
    path: str,
    method: str,
    handler: str,
}

struct RouteTable {
    entries: [4]RouteEntry,
    count: usize,
}

// Decision: dispatch logic - returns a DispatchPlan that the caller executes
pub fn dispatch_task_plan(req: DispatchRequest, router: Router, server: BridgeServer) -> DispatchPlan {
    if (req.agent_id == "broadcast") {
        let msg = BridgeMessage_send_command("broadcast", req.task, false);
        let broadcast_ok = BridgeServer_broadcast_message(server, msg);
        return DispatchPlan {
            kind: .Broadcast,
            ok: broadcast_ok,
            message: if (broadcast_ok) "Task broadcast to all agents" else "Broadcast failed",
        };
    } else {
        if (!Router_is_registered(router, req.agent_id)) {
            return DispatchPlan {
                kind: .Specific,
                ok: false,
                message: "Agent '" + req.agent_id + "' not registered",
            };
        }
        
        var claim_issue: bool = false;
        var claim_issue_num: u64 = 0;
        var claim_branch: str = "";
        if (req.issue != null and req.branch != null) {
            claim_issue = true;
            claim_issue_num = req.issue.?;
            claim_branch = req.branch.?;
        }
        
        Router_update_status(router, req.agent_id, "Working", req.task);
        
        let msg = BridgeMessage_send_command(req.agent_id, req.task, false);
        let dispatch_ok = BridgeServer_broadcast_message(server, msg);
        
        return DispatchPlan {
            kind: .Specific,
            ok: dispatch_ok,
            message: if (dispatch_ok) "Task dispatched to agent '" + req.agent_id + "'" else "Dispatch failed",
            claim_issue: claim_issue,
            claim_issue_num: claim_issue_num,
            claim_branch: claim_branch,
        };
    }
}

enum DispatchKind {
    Broadcast,
    Specific,
}

struct DispatchPlan {
    kind: DispatchKind,
    ok: bool,
    message: str,
    claim_issue: bool,
    claim_issue_num: u64,
    claim_branch: str,
}

// Decision: health check response computation
pub fn health_check_response(agents: []AgentState) -> HealthResponse {
    return HealthResponse {
        status: "ok",
        agents_count: agents.len,
    };
}

// Decision: SSE stream setup - returns configuration
pub fn sse_events_config() -> SseConfig {
    return SseConfig {
        keep_alive: true,
        filter_lagged: true,
    };
}

struct SseConfig {
    keep_alive: bool,
    filter_lagged: bool,
}

