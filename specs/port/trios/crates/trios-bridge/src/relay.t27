// Tests

test relay_app_routes_structure {
    let routes = relay_app_routes();
    assert(routes.count == 4);
    assert(routes.entries[0].path == "/events");
    assert(routes.entries[0].method == "GET");
    assert(routes.entries[0].handler == "sse_events");
    assert(routes.entries[1].path == "/agents");
    assert(routes.entries[1].method == "GET");
    assert(routes.entries[1].handler == "list_agents");
    assert(routes.entries[2].path == "/dispatch");
    assert(routes.entries[2].method == "POST");
    assert(routes.entries[2].handler == "dispatch_task");
    assert(routes.entries[3].path == "/health");
    assert(routes.entries[3].method == "GET");
    assert(routes.entries[3].handler == "health_check");
}

test dispatch_task_plan_broadcast_success {
    let req = DispatchRequest {
        agent_id: "broadcast",
        task: "test task",
        issue: null,
        branch: null,
    };
    let router = Router {};
    let server = BridgeServer {};
    let plan = dispatch_task_plan(req, router, server);
    assert(plan.kind == .Broadcast);
    assert(plan.ok == true); // assumes broadcast_message returns true in test
    assert(plan.message == "Task broadcast to all agents");
}

test dispatch_task_plan_broadcast_failure {
    // Note: we can't easily test failure path without mocking broadcast_message
    // This test documents the expected structure
    let req = DispatchRequest {
        agent_id: "broadcast",
        task: "test task",
        issue: null,
        branch: null,
    };
    let router = Router {};
    let server = BridgeServer {};
    let plan = dispatch_task_plan(req, router, server);
    assert(plan.kind == .Broadcast);
    // plan.ok depends on broadcast_message result
}

test dispatch_task_plan_specific_agent_not_registered {
    let req = DispatchRequest {
        agent_id: "unknown-agent",
        task: "test task",
        issue: null,
        branch: null,
    };
    let router = Router {};
    let server = BridgeServer {};
    let plan = dispatch_task_plan(req, router, server);
    assert(plan.kind == .Specific);
    assert(plan.ok == false);
    assert(plan.message == "Agent 'unknown-agent' not registered");
}

test dispatch_task_plan_specific_with_issue_and_branch {
    let req = DispatchRequest {
        agent_id: "agent-1",
        task: "work on issue",
        issue: 123,
        branch: "feature/123",
    };
    let router = Router {};
    let server = BridgeServer {};
    let plan = dispatch_task_plan(req, router, server);
    assert(plan.kind == .Specific);
    assert(plan.claim_issue == true);
    assert(plan.claim_issue_num == 123);
    assert(plan.claim_branch == "feature/123");
}

test dispatch_task_plan_specific_without_issue_or_branch {
    let req = DispatchRequest {
        agent_id: "agent-1",
        task: "simple task",
        issue: null,
        branch: null,
    };
    let router = Router {};
    let server = BridgeServer {};
    let plan = dispatch_task_plan(req, router, server);
    assert(plan.kind == .Specific);
    assert(plan.claim_issue == false);
}

test health_check_response_empty_agents {
    let agents: [0]AgentState = [];
    let response = health_check_response(&agents);
    assert(response.status == "ok");
    assert(response.agents_count == 0);
}

test health_check_response_with_agents {
    var agents: [2]AgentState = [
        AgentState { id: "agent-1", status: "Idle" },
        AgentState { id: "agent-2", status: "Working" },
    ];
    let response = health_check_response(&agents);
    assert(response.status == "ok");
    assert(response.agents_count == 2);
}

test sse_events_config_defaults {
    let config = sse_events_config();
    assert(config.keep_alive == true);
    assert(config.filter_lagged == true);
}

test dispatch_request_struct_fields {
    let req = DispatchRequest {
        agent_id: "test",
        task: "do work",
        issue: 42,
        branch: "main",
    };
    assert(req.agent_id == "test");
    assert(req.task == "do work");
    assert(req.issue == 42);
    assert(req.branch == "main");
}

test dispatch_response_struct_fields {
    let resp = DispatchResponse {
        ok: true,
        message: "success",
    };
    assert(resp.ok == true);
    assert(resp.message == "success");
}
