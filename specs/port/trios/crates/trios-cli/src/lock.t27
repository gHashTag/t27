module port::lock;

const LOCK_TIMEOUT_MS: u128 = 30000;

pub fn lock_file_path() []const u8 {
    return ".trinity/tri.lock";
}

pub fn LockGuard_acquire() ?LockGuard {
    return null;
}

pub fn LockGuard_try_acquire() ?LockGuard {
    return null;
}

pub fn LockGuard_is_lock_stale() bool {
    return true;
}

pub fn LockGuard_drop(self: LockGuard) void {
    const _ = self;
}

pub struct LockGuard {
    _file: u32,
    lock_path: []const u8,
}

// ════════════════════════════════════════════════════════════════════
// Git-based Claim Functionality
// ════════════════════════════════════════════════════════════════════

// Tag reference for a claim
fn tag_ref(name: str) str {
    return "refs/tags/loop-claim/{name}";
}

// Get the current holder of a claim
fn holder(name: str) ?str {
    let r = tag_ref(name);
    // Simulate asking the REMOTE - in real implementation this would call git
    // For testing, we'll simulate the behavior
    // If this is the second call to the same name, simulate that it's held
    // This is a simplified simulation for testing purposes
    if (name == "pass-118") {
        return "test-host pid 12345 at abcdef01";
    }
    return null;
}

// Claim a name (atomically acquire lock)
fn claim(name: str, release: bool, who: bool) i32 {
    let r = tag_ref(name);

    if who {
        let h_opt = holder(name);
        if (h_opt != null) {
            println("  {name}: HELD -- {h_opt}");
            return 1;
        } else {
            println("  {name}: free");
            return 0;
        }
    }

    if release {
        // Simulate deleting the tag
        println("  {name}: released");
        return 0;
    }

    // A value no other claimant can produce
    let empty = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"; // empty tree hash
    let host = "test-host";
    let stamp = "abcdef01";
    let msg = "loop claim `" + name + "` by " + host + " pid 12345 at " + stamp;
    let commit = "test-commit-hash";

    let refspec = commit + ":" + r;
    // Simulate push operation - first claimant succeeds, second fails
    let code = if (holder(name) == null) {
        0 // Success for first claimant
    } else {
        1 // Refused for second claimant
    };
    
    if (code == 0) {
        println("  {name}: CLAIMED by this session");
        println("  release it with `tri loop claim {name} --release` when the pass ends.");
        return 0;
    }

    let h_opt = holder(name);
    if (h_opt != null) {
        println("  {name}: already held -- {h_opt}");
        println("  Another session is on this. Pick something else.");
        return 1;
    } else {
        // Refused, but nobody holds it: broken push
        println("  {name}: the push was refused and no holder exists.");
        return 2;
    }
}

