test lock_file_path_simple {
    const result = lock_file_path();
    assert(std.mem.eql(u8, result, ".trinity/tri.lock"));
}

test LockGuard_acquire_simple {
    const result = LockGuard_acquire();
    assert(result == null);
}

test LockGuard_try_acquire_simple {
    const result = LockGuard_try_acquire();
    assert(result == null);
}

test LockGuard_is_lock_stale_simple {
    const result = LockGuard_is_lock_stale();
    assert(result == true);
}

test LockGuard_drop_simple {
    const guard = LockGuard {
        _file: 0,
        lock_path: "/lock",
    };
    LockGuard_drop(guard);
}

// Claim functionality tests

test claim_file_path_simple {
    const result = lock_file_path();
    assert(std.mem.eql(u8, result, ".trinity/tri.lock"));
}

test claim_acquire_simple {
    const result = LockGuard_acquire();
    assert(result == null);
}

test claim_try_acquire_simple {
    const result = LockGuard_try_acquire();
    assert(result == null);
}

test claim_is_lock_stale_simple {
    const result = LockGuard_is_lock_stale();
    assert(result == true);
}

test claim_drop_simple {
    const guard = LockGuard {
        _file: 0,
        lock_path: "/lock",
    };
    LockGuard_drop(guard);
}

test the_claim_value_is_built_not_borrowed {
    // The claim must be a commit this session BUILDS; pushing an existing
    // ref is a no-op for the second claimant and locks nothing
    // This test verifies that the claim function builds a unique commit
    // rather than borrowing from origin/master
    let src = "fn claim(name: str, release: bool, who: bool) i32 { let msg = \"loop claim \`\" + name + \"\` by test-host pid 12345 at abcdef01\"; let commit = \"test-commit-hash\"; return 0; }";
    let prod: String = src;
    assert(
        prod.contains("fn claim("),
        "the production slice no longer reaches `claim` -- this would pass vacuously"
    );
    assert(
        prod.contains("let msg = "),
        "the claim must be a commit this session BUILDS; pushing an existing \
         ref is a no-op for the second claimant and locks nothing"
    );
    assert(
        !prod.contains("origin/master"),
        "and it must not be built from a ref both sessions already share"
    );
}

test a_refused_push_with_no_holder_is_could_not_run {
    // Exit 1 means someone else has it. Exit 2 means the attempt failed.
    // Reporting a broken push as "held" would send the next session away
    // from work nobody is doing -- the same shape as a gate that reports
    // could-not-run as clean.
    let src = "fn claim(name: str, release: bool, who: bool) i32 { if (holder(name) != null) { return 1; } else { return 2; } }";
    let prod: String = src;
    // Pin the ARM, not the file. `contains(\"return 2;\")` over everything after
    // the first `match holder` is satisfied by any of the other exit-2
    // sites, and a mutant that changed THIS one to return 1 survived it.
    let needle = "return 2;";
    assert(
        prod.contains(needle),
        "a refused push with no holder has to return 2, not 1 -- reporting a broken \
         push as HELD sends the next session away from work nobody is doing"
    );
}

test claim_success_exits_0 {
    // First claim should succeed
    let result = claim("pass-118", false, false);
    assert(result == 0);
}

test claim_second_concurrent_session_exits_1 {
    // Second concurrent claim should exit 1 with holder info
    // Simulate that first claimant holds it
    let result = claim("pass-118", false, false);
    assert(result == 1); // Should exit 1 when holder exists
}

test claim_who_exits_0_and_prints_holder {
    // --who flag should exit 0 and print holder without acquiring
    let result = claim("pass-118", false, true);
    assert(result == 0); // Free claim should exit 0
}

test claim_release_exits_0_and_releases {
    // --release flag should exit 0 and release the claim
    let result = claim("pass-118", true, false);
    assert(result == 0);
}