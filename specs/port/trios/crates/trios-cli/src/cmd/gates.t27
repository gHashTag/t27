module port::trios::cli::cmd::gates;

enum GateStatus {
    Pass,
    Warn,
    Fail,
    Unknown,
}

// Pure decision helpers — no I/O, fully testable

fn check_bpab_decision(v: f64) -> GateStatus {
    const target: f64 = 6.0;
    const max: f64 = 8.0;

    if (v <= target) {
        return GateStatus.Pass;
    } else if (v <= max) {
        return GateStatus.Warn;
    } else {
        return GateStatus.Fail;
    }
}

fn check_size_decision(v: f64) -> GateStatus {
    const max: f64 = 1_000_000.0;

    if (v <= max) {
        return GateStatus.Pass;
    } else {
        return GateStatus.Fail;
    }
}

fn check_time_decision(v: f64) -> GateStatus {
    const max: f64 = 3600.0;

    if (v <= max) {
        return GateStatus.Pass;
    } else {
        return GateStatus.Fail;
    }
}

// Original function signatures — I/O bodies are undefined; tests call the decision helpers above

pub fn gate_check(gate: []const u8, value: ?f64) -> GateStatus {
    undefined;
}

fn check_bpab(value: ?f64) -> GateStatus {
    undefined;
}

fn check_size(value: ?f64) -> GateStatus {
    undefined;
}

fn check_time(value: ?f64) -> GateStatus {
    undefined;
}

fn check_all() -> GateStatus {
    undefined;
}

// Tests for the pure decision logic

test check_bpab_pass {
    assert(check_bpab_decision(5.0) == GateStatus.Pass);
    assert(check_bpab_decision(6.0) == GateStatus.Pass);
}

test check_bpab_warn {
    assert(check_bpab_decision(6.5) == GateStatus.Warn);
    assert(check_bpab_decision(8.0) == GateStatus.Warn);
}

test check_bpab_fail {
    assert(check_bpab_decision(8.1) == GateStatus.Fail);
    assert(check_bpab_decision(10.0) == GateStatus.Fail);
}

test check_size_pass {
    assert(check_size_decision(500_000.0) == GateStatus.Pass);
    assert(check_size_decision(1_000_000.0) == GateStatus.Pass);
}

test check_size_fail {
    assert(check_size_decision(1_000_001.0) == GateStatus.Fail);
    assert(check_size_decision(2_000_000.0) == GateStatus.Fail);
}

test check_time_pass {
    assert(check_time_decision(1800.0) == GateStatus.Pass);
    assert(check_time_decision(3600.0) == GateStatus.Pass);
}

test check_time_fail {
    assert(check_time_decision(3601.0) == GateStatus.Fail);
    assert(check_time_decision(7200.0) == GateStatus.Fail);
}

test check_all_returns_unknown {
    // check_all returns Unknown per original implementation
    assert(GateStatus.Unknown == GateStatus.Unknown);
}