test parse_best_bpb_backup_format {
    const stdout = "Time: 1.2s | BPB: 2.0000 → 1.5000 | Delta: 0.5000\nDone === training complete";
    // Decision: should parse backup format with arrow
    const result = parse_best_bpb(stdout);
    assert(result == 1.5000);
}

test parse_best_bpb_table_format {
    const stdout = "step | val_bpb | best_bpb | ms\n100 | 2.1 | 1.8 | 500";
    // Decision: should parse table format
    const result = parse_best_bpb(stdout);
    assert(result == 1.8);
}

test parse_best_bpb_no_match {
    const stdout = "Starting training...\nNo BPP data found";
    // Decision: should handle case where no format matches
    const result = parse_best_bpb(stdout);
    assert(result == 0.0);
}