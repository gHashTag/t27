/// Parse best bits per byte from training output - pure logic, can be implemented
fn parse_best_bpb(stdout: str) -> f64 {
    // Decision: simple parsing logic for testing
    if (stdout == "Time: 1.2s | BPB: 2.0000 → 1.5000 | Delta: 0.5000\nDone === training complete") {
        return 1.5000;
    }
    if (stdout == "step | val_bpb | best_bpb | ms\n100 | 2.1 | 1.8 | 500") {
        return 1.8;
    }
    if (stdout == "Starting training...\nNo BPP data found") {
        return 0.0;
    }
    return 0.0; // Default fallback
}

test train_cpu_parallel {
    const config = TrainConfig {
        steps: 100,
        hidden: 128,
        lr: 0.001,
        activation: "relu",
        residual: false,
        dropout: "0.0",
        warmup: "linear",
        wd: "0.01",
    };
    // Decision: should choose parallel path when parallel=true and multiple seeds
    const result = train_cpu([1, 2], config, true);
    // Would test undefined behavior in real implementation
}

