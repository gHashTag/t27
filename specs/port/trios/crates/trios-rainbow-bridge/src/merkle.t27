test hex_encode_format {
    const test_bytes: [4]u8 = [0x00, 0xFF, 0x0A, 0xB0];
    const hex = hex_encode(&test_bytes);
    assert_eq(hex, "00ff0ab0");
}

test format_byte_hex {
    assert_eq(format_byte_hex(0x00), "00");
    assert_eq(format_byte_hex(0x0F), "0f");
    assert_eq(format_byte_hex(0xFF), "ff");
    assert_eq(format_byte_hex(0xA), "0a");
}

/// Helper to create a sample RainbowEvent for testing.
fn create_sample_rainbow_event() -> RainbowEvent {
    undefined;
}