module port::trios::crates::trios_rainbow_bridge::src;

const SUBSCRIBER_INBOX_CAPACITY: usize = 100;

enum RainbowEvent {
    Event(u8),
}

struct Subscriber {
    id: []const u8,
    inbox: [SUBSCRIBER_INBOX_CAPACITY]RainbowEvent,
    len: usize,
    }

struct ReceivedEvents {
events: [SUBSCRIBER_INBOX_CAPACITY]RainbowEvent,
    len: usize,
    }

fn Subscriber_new(id: []const u8) -> Subscriber {
    return Subscriber {
        id: id,
        inbox: [undefined; SUBSCRIBER_INBOX_CAPACITY],
        len: 0,
    };
}

fn Subscriber_deliver(self: &mut Subscriber, ev: RainbowEvent) {
    if (self.len < SUBSCRIBER_INBOX_CAPACITY) {
        self.inbox[self.len] = ev;
        self.len += 1;
    }
}

fn Subscriber_received(self: &Subscriber) -> ReceivedEvents {
    return ReceivedEvents {
        events: self.inbox,
        len: self.len,
    };
}

fn Subscriber_len(self: &Subscriber) -> usize {
    return self.len;
}

fn Subscriber_is_empty(self: &Subscriber) -> bool {
    return self.len == 0;
}

test subscriber_new_is_empty {
    var sub = Subscriber_new("test");
    assert(Subscriber_is_empty(&sub) == true);
    assert(Subscriber_len(&sub) == 0);
}

test subscriber_deliver_one_event {
    var mut sub = Subscriber_new("test");
    var ev = RainbowEvent.Event(1);
    Subscriber_deliver(&mut sub, ev);
    assert(Subscriber_is_empty(&sub) == false);
    assert(Subscriber_len(&sub) == 1);
}

test subscriber_deliver_two_events_then_received {
    var mut sub = Subscriber_new("test");
    var ev1 = RainbowEvent.Event(1);
    var ev2 = RainbowEvent.Event(2);
    Subscriber_deliver(&mut sub, ev1);
    Subscriber_deliver(&mut sub, ev2);
    var received = Subscriber_received(&sub);
    assert(received.len == 2);
    assert(received.events[0] == RainbowEvent.Event(1));
    assert(received.events[1] == RainbowEvent.Event(2));
}

test subscriber_deliver_three_events_then_len {
    var mut sub = Subscriber_new("test");
    var ev1 = RainbowEvent.Event(1);
    var ev2 = RainbowEvent.Event(2);
    var ev3 = RainbowEvent.Event(3);
    Subscriber_deliver(&mut sub, ev1);
    Subscriber_deliver(&mut sub, ev2);
    Subscriber_deliver(&mut sub, ev3);
    assert(Subscriber_len(&sub) == 3);
}

test subscriber_not_empty_after_deliver {
    var mut sub = Subscriber_new("test");
    var ev = RainbowEvent.Event(1);
    Subscriber_deliver(&mut sub, ev);
    assert(Subscriber_is_empty(&sub) == false);
}