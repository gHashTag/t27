pub struct RainbowEvent {
    value: u8,
}

pub struct ReceivedEvents {
    events: [100]RainbowEvent,
    len: usize,
}

pub struct Subscriber {
    id: []const u8,
    inbox: [100]RainbowEvent,
    len: usize,
}

fn Subscriber_new(id: []const u8) -> Subscriber {
    return Subscriber {
        id: id,
        inbox: [ for i in 0..100 => RainbowEvent { .value = 0 } ],
        len: 0,
    };
}

fn Subscriber_deliver(self: *Subscriber, ev: RainbowEvent) void {
    if (self.len >= 100) {
        return;
    }
    self.inbox[self.len] = ev;
    self.len += 1;
}

fn Subscriber_received(self: Subscriber) -> ReceivedEvents {
    var events: [100]RainbowEvent = [ for i in 0..100 => RainbowEvent { .value = 0 } ];
    var i: usize = 0;
    while (i < self.len) {
        events[i] = self.inbox[i];
        i += 1;
    }
    return ReceivedEvents {
        events: events,
        len: self.len,
    };
}

fn Subscriber_len(self: Subscriber) -> usize {
    return self.len;
}

fn Subscriber_is_empty(self: Subscriber) -> bool {
    return self.len == 0;
}

test new_sets_id {
    var sub = Subscriber_new("perry");
    assert(sub.id == "perry");
}

test new_is_empty {
    var sub = Subscriber_new("perry");
    assert(Subscriber_is_empty(sub));
}

test deliver_increments_len {
    var mut sub = Subscriber_new("perry");
    var ev = RainbowEvent { .value = 42 };
    Subscriber_deliver(&sub, ev);
    assert(Subscriber_len(sub) == 1);
}

test deliver_adds_event {
    var mut sub = Subscriber_new("perry");
    var ev = RainbowEvent { .value = 99 };
    Subscriber_deliver(&sub, ev);
    var received = Subscriber_received(sub);
    assert(received.len == 1);
    assert(received.events[0].value == 99);
}

test received_returns_copy {
    var mut sub = Subscriber_new("perry");
    var ev1 = RainbowEvent { .value = 1 };
    Subscriber_deliver(&sub, ev1);
    var first = Subscriber_received(sub);
    var ev2 = RainbowEvent { .value = 2 };
    Subscriber_deliver(&sub, ev2);
    var second = Subscriber_received(sub);
    assert(first.len == 1);
    assert(first.events[0].value == 1);
    assert(second.len == 2);
    assert(second.events[0].value == 1);
    assert(second.events[1].value == 2);
}

test len_returns_zero_when_empty {
    var sub = Subscriber_new("perry");
    assert(Subscriber_len(sub) == 0);
}

test is_empty_true_when_empty {
    var sub = Subscriber_new("perry");
    assert(Subscriber_is_empty(sub));
}

test is_empty_false_after_deliver {
    var mut sub = Subscriber_new("perry");
    assert(Subscriber_is_empty(sub));
    var ev = RainbowEvent { .value = 7 };
    Subscriber_deliver(&sub, ev);
    assert(!Subscriber_is_empty(sub));
}