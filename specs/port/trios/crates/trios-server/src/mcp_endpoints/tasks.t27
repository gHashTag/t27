module port::tasks;

pub fn assign(state: TaskBoardState, params: TaskReply) -> TaskReply {
    return TaskReply{task_id: "task-123", status: "assigned"};
}

pub fn status(state: TaskBoardState, params: TaskReply) -> TaskReply {
    return TaskReply{task_id: "task-123", status: "assigned"};
}

pub fn update_status(state: TaskBoardState, params: TaskReply) -> TaskReply {
    return TaskReply{task_id: "task-123", status: "assigned"};
}

struct TaskEntry {
    id: str,
    agent_id: str,
    task: str,
    status: str,
}

// The slice of the server's AppState these endpoints read. Not named AppState:
// experience.t27 ports a different slice under that name (tri types ratchet,
// #7437).
struct TaskBoardState {
    tasks: TaskEntry,
}

// The JSON reply these endpoints build. Not named Value: tools/git.t27 and
// tools/mod.t27 each port a different Value (tri types ratchet, #7437).
struct TaskReply {
    task_id: str,
    status: str,
}

test test_assign {
    const state = TaskBoardState{tasks: TaskEntry{id: "", agent_id: "", task: "", status: ""}};
    const result = assign(state, TaskReply{task_id: "", status: ""});
    assert(result.task_id == "task-123");
}

test test_status {
    const state = TaskBoardState{tasks: TaskEntry{id: "", agent_id: "", task: "", status: ""}};
    const result = status(state, TaskReply{task_id: "", status: ""});
    assert(result.task_id == "task-123");
}

test test_update_status {
    const state = TaskBoardState{tasks: TaskEntry{id: "", agent_id: "", task: "", status: ""}};
    const result = update_status(state, TaskReply{task_id: "", status: ""});
    assert(result.task_id == "task-123");
}