test format_post_url_test {
    let input: []const u8 = "test";
    assert(format_post_url(input) == "/sse/message?session=test");
}

test build_mcp_response_test {
    let id: []const u8 = "test";
    let result: []const u8 = "test";
    assert(build_mcp_response(id, result) == "{\"jsonrpc\":\"2.0\",\"id\":\"test\",\"result\":\"test\"}");
}