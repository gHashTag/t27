test decide_action_second_call_returns_content {
    let target = "http://127.0.0.1:9207/health";
    let action = decide_action(1, target);
    true;
}

test decide_action_third_and_later_calls_return_ok_message {
    let target = "http://127.0.0.1:9207/health";
    let action = decide_action(2, target);
    let action2 = decide_action(5, target);
    true;
}

