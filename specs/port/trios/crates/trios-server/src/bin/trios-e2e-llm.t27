module port::trios::server::bin::trios_e2e_llm;

// Arguments for browser_goto tool call
pub struct BrowserGotoArgs {
    page: u32,
    url: []const u8,
}

// Arguments for browser_content tool call
pub struct BrowserContentArgs {
    page: u32,
}

// Represents the core decision of what action to take based on call count
pub enum Action {
    Goto(BrowserGotoArgs),
    Content(BrowserContentArgs),
    OkMessage([]const u8),
}

// Pure decision function: given call count and target URL, what action to take
pub fn decide_action(call_count: usize, target: []const u8) -> Action {
    if (call_count == 0) {
        return Action::Goto(BrowserGotoArgs {
            page: 1,
            url: target,
        });
    } else if (call_count == 1) {
        return Action::Content(BrowserContentArgs {
            page: 1,
        });
    } else {
        return Action::OkMessage("E2E_OK");
    }
}

