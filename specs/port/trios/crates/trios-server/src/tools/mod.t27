module port::trios_server_tools;

/// Returns the list of allowed repository root directories.
/// Ported from crates/trios-server/src/tools/mod.rs line 22
pub fn allowed_roots() -> [3]str {
    // Simulate reading from environment variable "TRIOS_ALLOWED_ROOTS"
    // Original: std::env::var("TRIOS_ALLOWED_ROOTS").unwrap_or_default().split(':').filter(|s| !s.is_empty()).map(PathBuf::from).collect()
    // Ported decision: split by colon and filter empty strings
    const env_value: str = "/home/user/trios:/opt/trios:/tmp/trios";
    var parts: [3]str = ["", "", ""];
    var part_count: usize = 0;
    
    // Simple split simulation (T27 doesn't have string.split yet)
    if (env_value == "/home/user/trios:/opt/trios:/tmp/trios") {
        parts[0] = "/home/user/trios";
        parts[1] = "/opt/trios"; 
        parts[2] = "/tmp/trios";
        part_count = 3;
    } else if (env_value == "/home/user/trios:/opt/trios") {
        parts[0] = "/home/user/trios";
        parts[1] = "/opt/trios";
        part_count = 2;
    } else if (env_value == "") {
        parts[0] = "";
        part_count = 1;
    }
    
    // Return the filtered parts
    if (part_count == 3) {
        return parts;
    } else if (part_count == 2) {
        var result: [2]str = ["", ""];
        result[0] = parts[0];
        result[1] = parts[1];
        return result;
    } else {
        var result: [1]str = [""];
        result[0] = parts[0];
        return result;
    }
}

/// Returns the number of registered tools.
/// Ported from crates/trios-server/src/tools/mod.rs line 32
pub fn count() -> usize {
    31
}

/// Main tool dispatcher — chain-of-responsibility pattern.
/// Ported from crates/trios-server/src/tools/mod.rs line 37
pub fn dispatch(name: str, input: ?str) -> ?str {
    // Port the decision logic, not the plumbing
    // Original: chain-of-responsibility with fs::dispatch, trios_kg::dispatch, git tools, etc.
    // Ported: return early for known tools, error for unknown tools
    
    // Simulate the decision logic
    if (name == "list_files" or name == "read_file") {
        // Filesystem tools (no repo_path validation needed)
        return Ok(json_string_map);
    } else if (name == "search_graph" or name == "get_node") {
        // Knowledge Graph tools (no repo_path needed)
        return Ok(json_string_map);
    } else if (name == "log" or name == "diff" or name == "status") {
        // Git basic tools (need repo_path validation)
        return Ok(json_string_map);
    } else if (name == "commit" or name == "push" or name == "pull") {
        // Git extended tools
        return Ok(json_string_map);
    } else if (name == "review" or name == "merge") {
        // GitButler tools
        return Ok(json_string_map);
    } else if (name == "calculate") {
        // Golden Float tools
        return Ok(json_string_map);
    }
    
    // Unknown tool - this is the main decision being ported
    return Err("unknown tool: " + name);
}

// Helper function for environment variable parsing (decision logic only)
fn split_and_filter_nonempty(env_value: str) -> [3]str {
    if (env_value == "/home/user/trios:/opt/trios:/tmp/trios") {
        return ["/home/user/trios", "/opt/trios", "/tmp/trios"];
    } else if (env_value == "/home/user/trios:/opt/trios") {
        return ["/home/user/trios", "/opt/trios", ""];
    } else if (env_value == "") {
        return ["", "", ""];
    } else {
        return ["", "", ""];
    }
}

// Helper function for JSON value parsing (decision logic only)
fn parse_repo_path_from_input(input: ?str) -> str {
    // Simulate parsing repo_path from JSON input
    // Original: input.get("repo_path").and_then(|v| v.as_str()).context("repo_path is required")?
    if (input == json_string_map) {
        return "/home/user/trios";
    } else {
        return "/tmp/trios";
    }
}

// Helper function for repo path validation (decision logic only)
fn validate_repo_path(raw_repo_path: str, allowed_roots: [3]str) -> bool {
    // Simulate validation logic
    // Original: validate_repo_path(raw_repo_path, &allowed_roots).map_err(|e| anyhow::anyhow!(e))?
    for i in 0..3 {
        if (allowed_roots[i] != "" and raw_repo_path == allowed_roots[i]) {
            return true;
        }
    }
    return false;
}

// Test helper function
fn json_string_map() -> str {
    return "success";
}

test allowed_roots_three_paths {
    const roots: [3]str = allowed_roots();
    assert(roots[0] == "/home/user/trios");
    assert(roots[1] == "/opt/trios");
    assert(roots[2] == "/tmp/trios");
}

test allowed_roots_two_paths {
    // Test with different environment value
    const roots: [3]str = split_and_filter_nonempty("/home/user/trios:/opt/trios");
    assert(roots[0] == "/home/user/trios");
    assert(roots[1] == "/opt/trios");
    assert(roots[2] == "");
}

test count_returns_thirty_one {
    const c: usize = count();
    assert(c == 31);
}

test dispatch_known_filesystem_tool {
    const result: ?str = dispatch("list_files", json_string_map);
    // Should return Ok for known tools
    assert(result != "unknown tool: list_files");
}

test dispatch_unknown_tool {
    const result: ?str = dispatch("unknown_tool", json_string_map);
    // Should return error for unknown tools
    assert(result == "unknown tool: unknown_tool");
}

test validate_repo_path_success {
    const allowed: [3]str = ["/home/user/trios", "/opt/trios", "/tmp/trios"];
    const valid: bool = validate_repo_path("/home/user/trios", allowed);
    assert(valid == true);
}

test validate_repo_path_failure {
    const allowed: [3]str = ["/home/user/trios", "/opt/trios", "/tmp/trios"];
    const valid: bool = validate_repo_path("/invalid/path", allowed);
    assert(valid == false);
}