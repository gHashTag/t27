test "allowed_roots_splits_colon_separated_string" {
    // Test the decision logic: splitting and filtering
    var input = "/root:/home/user:/tmp";
    var expected_len = 3;
    // Note: We're testing the helper function that embodies the decision
    var result = split_and_filter_nonempty(input, ':' as u8);
    assert(result.len == expected_len);
}

test "allowed_roots_ignores_empty_entries" {
    var input = ":/root::/home:";
    var expected_len = 2;
    var result = split_and_filter_nonempty(input, ':' as u8);
    assert(result.len == expected_len);
}

test "count_returns_fixed_number_of_tools" {
