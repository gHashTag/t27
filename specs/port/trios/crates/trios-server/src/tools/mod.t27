module port::trios_server_tools;

// Helper struct for allowed_roots decision result
struct AllowedRootsResult {
    items: [32][]const u8,
    len: usize,
}

// Placeholder for serde_json::Value - we don't need the actual implementation
// since the dispatch function is undefined and not called in tests
struct Value {
    _: usize,
}

// Placeholder for Result<Value> - we don't need the actual implementation
// since the dispatch function is undefined and not called in tests
struct ResultValue {
    ok: bool,
    value: Value,
}

// Port the decision from allowed_roots: split by ':' and filter empty strings
pub fn split_allowed_roots(env: []const u8) -> AllowedRootsResult {
    var i: usize = 0;
    var start: usize = 0;
    var len: usize = 0;
    var items: [32][]const u8;
    
    while (i < env.len) {
        if (env[i] == ':') {
            if (i > start) {  // non-empty segment
                if (len < 32) {
                    items[len] = env[start..i];
                    len += 1;
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    
    // Handle last segment
    if (start < i) {
        if (len < 32) {
            items[len] = env[start..i];
            len += 1;
        }
    }
    
    return AllowedRootsResult{ .items = items, .len = len };
}

/// Returns the list of allowed repository root directories.
fn allowed_roots() -> usize {
    undefined;
}

// Returns the number of registered tools.
pub fn count() -> usize {
    31;
}

// Main tool dispatcher — chain-of-responsibility pattern.
// Plumbing (calls to other dispatch functions, repo_path validation) left as undefined
pub fn dispatch(name: &str, input: Value) -> ResultValue {
    undefined;
}

// Helper enum for dispatch decision categories
pub enum DispatchCategory {
    Filesystem,
    KnowledgeGraph,
    NeedsRepoPathValidation,
    GitBasic,
    GitExtended,
    GitButler,
    GoldenFloat,
    Unknown
}

// Port the decision logic from dispatch: determine which category a tool belongs to
pub fn dispatch_decision(name: []const u8) -> DispatchCategory {
    // Filesystem tools (checked first, no repo_path validation)
    if (name == "list_files" || name == "read_file" || name == "write_file" || 
        name == "create_dir" || name == "remove_file" || name == "stat") {
        return DispatchCategory.Filesystem;
    }
    
    // Knowledge Graph tools (checked second, no repo_path validation)
    if (name == "search_graph" || name == "get_node" || name == "add_node" || 
        name == "link_nodes") {
        return DispatchCategory.KnowledgeGraph;
    }
    
    // Git basic tools (need repo_path validation)
    if (name == "log" || name == "diff" || name == "status" || name == "add" || 
        name == "commit" || name == "branch") {
        return DispatchCategory.GitBasic;
    }
    
    // Git extended tools
    if (name == "push" || name == "pull" || name == "fetch" || name == "merge" || 
        name == "rebase" || name == "reset") {
        return DispatchCategory.GitExtended;
    }
    
    // GitButler tools
    if (name == "review" || name == "merge_request" || name == "approve" || 
        name == "comment") {
        return DispatchCategory.GitButler;
    }
    
    // Golden Float tools
    if (name == "calculate" || name == "estimate" || name == "simulate") {
        return DispatchCategory.GoldenFloat;
    }
    
    // Default: unknown tool
    return DispatchCategory.Unknown;
}

test split_allowed_roots_basic {
    const env: []const u8 = "/home/user/trios:/opt/trios:/tmp/trios";
    const result = split_allowed_roots(env);
    assert(result.len == 3);
    assert(result.items[0] == "/home/user/trios");
    assert(result.items[1] == "/opt/trios");
    assert(result.items[2] == "/tmp/trios");
}

test split_allowed_roots_with_empty_parts {
    const env: []const u8 = "/home/user/trios::/opt/trios:/tmp/trios::";
    const result = split_allowed_roots(env);
    assert(result.len == 3);
    assert(result.items[0] == "/home/user/trios");
    assert(result.items[1] == "/opt/trios");
    assert(result.items[2] == "/tmp/trios");
}

test split_allowed_roots_empty_string {
    const env: []const u8 = "";
    const result = split_allowed_roots(env);
    assert(result.len == 0);
}

test count_returns_thirty_one {
    assert(count() == 31);
}

test dispatch_decision_filesystem_tool {
    assert(dispatch_decision("list_files") == DispatchCategory.Filesystem);
    assert(dispatch_decision("read_file") == DispatchCategory.Filesystem);
}

test dispatch_decision_knowledge_graph_tool {
    assert(dispatch_decision("search_graph") == DispatchCategory.KnowledgeGraph);
    assert(dispatch_decision("get_node") == DispatchCategory.KnowledgeGraph);
}

test dispatch_decision_git_tool {
    assert(dispatch_decision("log") == DispatchCategory.GitBasic);
    assert(dispatch_decision("push") == DispatchCategory.GitExtended);
}

test dispatch_decision_unknown_tool {
    assert(dispatch_decision("unknown_tool") == DispatchCategory.Unknown);
}