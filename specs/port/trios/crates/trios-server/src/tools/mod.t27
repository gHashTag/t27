// Helper to split a string by delimiter and filter empty strings
// This represents the decision logic from allowed_roots
fn split_and_filter_nonempty(s: str, delimiter: u8) -> []str {
    var result: [100]str = [];  // Fixed capacity array
    var len: usize = 0;
    
    // Simple implementation for demonstration
    // In reality, we'd need proper string splitting
    if (s.len > 0) {
        result[0] = s;
        len = 1;
    }
    
    // Return slice of the array
    var ret: []str = &result[0..len];
    return ret;
}

