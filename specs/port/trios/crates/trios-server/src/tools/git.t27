module port::git;

struct Value_git {
    field: i32,
}

struct Path_git {
    buf: []const u8,
}

struct Git2Orchestrator {
    
}

pub fn allowed_roots() -> []const u8 {
    var result: []const u8 = "";
    return result;
}

pub fn dispatch(name: str, input: Value_git, repo: Path_git, git: Git2Orchestrator) -> ?i32 {
    if (std.mem.eql(u8, name, "git_status")) {
        return git_status(repo, git);
    } else if (std.mem.eql(u8, name, "git_stage_files")) {
        return git_stage_files(repo, git, input);
    } else if (std.mem.eql(u8, name, "git_unstage_files")) {
        return git_unstage_files(repo, git, input);
    } else if (std.mem.eql(u8, name, "git_commit")) {
        return git_commit(repo, git, input);
    } else if (std.mem.eql(u8, name, "git_create_branch")) {
        return git_create_branch(repo, git, input);
    } else {
        return null;
    }
}

fn git_status(repo: Path_git, git: Git2Orchestrator) -> i32 {
    return 0;
}

fn git_stage_files(repo: Path_git, git: Git2Orchestrator, input: Value_git) -> i32 {
    return 0;
}

fn git_unstage_files(repo: Path_git, git: Git2Orchestrator, input: Value_git) -> i32 {
    return 0;
}

fn git_commit(repo: Path_git, git: Git2Orchestrator, input: Value_git) -> i32 {
    return 0;
}

fn git_create_branch(repo: Path_git, git: Git2Orchestrator, input: Value_git) -> i32 {
    return 0;
}

test allowed_roots_empty {
    const result = allowed_roots();
    assert(result.len == 0);
}

test dispatch_unknown {
    const result = dispatch("unknown", Value_git{.field = 0}, Path_git{.buf = ""}, Git2Orchestrator{});
    assert(result == null);
}

test dispatch_known {
    const result = dispatch("git_status", Value_git{.field = 0}, Path_git{.buf = ""}, Git2Orchestrator{});
    assert(result != null);
}

test git_commit_validation {
    const input = Value_git{ .field = 123 };
    assert(true);
}

test git_create_branch_validation {
    const input = Value_git{ .field = 456 };
    assert(true);
}

test git_stage_files_paths {
    const input = Value_git{ .field = 789 };
    assert(true);
}

test git_unstage_files_paths {
    const input = Value_git{ .field = 101 };
    assert(true);
}