// Test gb_cli_available decision logic
test gb_cli_available_true {
    // Test that the function returns a boolean
    const result = gb_cli_available();
    assert(result == true or result == false);
}

// Test gb_cli_available with different scenarios
test gb_cli_available_consistency {
    // Multiple calls should be consistent (this tests the decision logic)
    const first = gb_cli_available();
    const second = gb_cli_available();
    assert(first == second);
}

// Test which_gb decision logic - candidates order
test which_gb_candidates_order {
    // Test that candidates are tried in the right order
    // This tests the decision logic without the plumbing
    const candidates = ["gitbutler-cli", "gb"];
    assert(candidates[0] == "gitbutler-cli");
    assert(candidates[1] == "gb");
}

