module port::trios::triossacred::rings::SC01;

pub const PHI: f64 = 1.618_033_988_749_894_8;

pub struct Vec2 {
    x: f64,
    y: f64,
}

pub fn scale_phi(v: Vec2) -> Vec2 {
    return Vec2 {
        x: v.x * PHI,
        y: v.y * PHI,
    };
}

test scale_phi_basic {
    let v = Vec2 { x: 1.0, y: 0.0 };
    let result = scale_phi(v);
    // PHI * 1.0 = PHI, PHI * 0.0 = 0.0
    // Using approximate equality due to floating point
    let dx = if (result.x - PHI < 0.0) -(result.x - PHI) else (result.x - PHI);
    let dy = if (result.y - 0.0 < 0.0) -(result.y - 0.0) else (result.y - 0.0);
    if (dx >= 1e-12) {
        return;
    }
    if (dy >= 1e-12) {
        return;
    }
    // If we get here, the test passes
}

test scale_phi_with_both_components {
    let v = Vec2 { x: 2.0, y: 3.0 };
    let result = scale_phi(v);
    // Expected: x = 2.0 * PHI, y = 3.0 * PHI
    let dx = if (result.x - (2.0 * PHI) < 0.0) -(result.x - (2.0 * PHI)) else (result.x - (2.0 * PHI));
    let dy = if (result.y - (3.0 * PHI) < 0.0) -(result.y - (3.0 * PHI)) else (result.y - (3.0 * PHI));
    if (dx >= 1e-12) {
        return;
    }
    if (dy >= 1e-12) {
        return;
    }
    // If we get here, the test passes
}

// The same contract, asserted rather than returned-from (#8475): scaling by
// PHI multiplies both axes, and the zero vector stays zero.
test scale_phi_asserted_scaling {
    const v = Vec2 { x: 2.0, y: 3.0 };
    const s = scale_phi(v);
    const ex = 2.0 * PHI;
    const ey = 3.0 * PHI;
    const sx = s.x;
    const sy = s.y;
    assert(@abs(sx - ex) < 1.0e-12);
    assert(@abs(sy - ey) < 1.0e-12);
    const zero = scale_phi(Vec2 { x: 0.0, y: 0.0 });
    const zx = zero.x;
    const zy = zero.y;
    assert(@abs(zx) < 1.0e-12);
    assert(@abs(zy) < 1.0e-12);
}