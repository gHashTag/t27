module port::audits_new;

// Data structures ported from the original Rust types
struct Issue {
    id: []const u8,
    title: []const u8,
    impact: []const u8,
    category: []const u8,
    elements: [0]IssueElement,
    score: u8,
}

struct IssueElement {
    selector: []const u8,
    snippet: []const u8,
    label: []const u8,
}

struct Metadata {
    url: []const u8,
    timestamp: []const u8,
    device: []const u8,
    lighthouseVersion: []const u8,
}

