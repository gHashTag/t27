module port::trios::tools::page_gate;

const EXIT_ADMIT: i32 = 0;
const EXIT_BELOW_BAND: i32 = 60;
const EXIT_ABOVE_BAND: i32 = 61;
const EXIT_IO: i32 = 62;
const EXIT_MALFORMED: i32 = 63;

pub enum ExitCode {
    Success,
    Failure(i32),
}

// Pure helper function that computes the exit code based on inputs and outcomes.
fn gate_main(
    pdf: []const u8,
    print_anchors: bool,
    count_only: bool,
    _min_pages: u64,
    _max_pages: u64,
    count_pages_success: bool,
    count_pages_value: u64,     // valid if count_pages_success is true
    count_pages_exit_code: i32, // valid if count_pages_success is false
    check_pdf_success: bool,
    check_pdf_value: u64,       // valid if check_pdf_success is true
    check_pdf_exit_code: i32    // valid if check_pdf_success is false
) -> i32 {
    if (print_anchors) {
        return EXIT_ADMIT;
    }
    if (count_only) {
        if (count_pages_success) {
            return EXIT_ADMIT;
        } else {
            return count_pages_exit_code;
        }
    } else {
        if (check_pdf_success) {
            return EXIT_ADMIT;
        } else {
            return check_pdf_exit_code;
        }
    }
}

// The main function is left as undefined because it handles I/O (plumbing).
// No test should call this function.
pub fn main() -> ExitCode {
    undefined;
}

// Tests for the pure helper function.
test gate_main_print_anchors_returns_admit {
    let pdf: []const u8 = "dummy.pdf";
    let print_anchors: bool = true;
    let count_only: bool = false;
    let min_pages: u64 = 10;
    let max_pages: u64 = 20;
    let count_pages_success: bool = false; // irrelevant
    let count_pages_value: u64 = 0;
    let count_pages_exit_code: i32 = 0;
    let check_pdf_success: bool = false; // irrelevant
    let check_pdf_value: u64 = 0;
    let check_pdf_exit_code: i32 = 0;
    let exit_code = gate_main(pdf, print_anchors, count_only, min_pages, max_pages, count_pages_success, count_pages_value, count_pages_exit_code, check_pdf_success, check_pdf_value, check_pdf_exit_code);
    assert(exit_code == EXIT_ADMIT);
}

test gate_main_count_only_success_returns_admit {
    let pdf: []const u8 = "dummy.pdf";
    let print_anchors: bool = false;
    let count_only: bool = true;
    let min_pages: u64 = 10;
    let max_pages: u64 = 20;
    let count_pages_success: bool = true;
    let count_pages_value: u64 = 42;
    let count_pages_exit_code: i32 = 0; // irrelevant
    let check_pdf_success: bool = false; // irrelevant
    let check_pdf_value: u64 = 0;
    let check_pdf_exit_code: i32 = 0;
    let exit_code = gate_main(pdf, print_anchors, count_only, min_pages, max_pages, count_pages_success, count_pages_value, count_pages_exit_code, check_pdf_success, check_pdf_value, check_pdf_exit_code);
    assert(exit_code == EXIT_ADMIT);
}

test gate_main_count_only_failure_returns_error_code {
    let pdf: []const u8 = "dummy.pdf";
    let print_anchors: bool = false;
    let count_only: bool = true;
    let min_pages: u64 = 10;
    let max_pages: u64 = 20;
    let count_pages_success: bool = false;
    let count_pages_value: u64 = 0; // irrelevant
    let count_pages_exit_code: i32 = EXIT_BELOW_BAND;
    let check_pdf_success: bool = false; // irrelevant
    let check_pdf_value: u64 = 0;
    let check_pdf_exit_code: i32 = 0;
    let exit_code = gate_main(pdf, print_anchors, count_only, min_pages, max_pages, count_pages_success, count_pages_value, count_pages_exit_code, check_pdf_success, check_pdf_value, check_pdf_exit_code);
    assert(exit_code == EXIT_BELOW_BAND);
}

test gate_main_check_pdf_success_returns_admit {
    let pdf: []const u8 = "dummy.pdf";
    let print_anchors: bool = false;
    let count_only: bool = false;
    let min_pages: u64 = 10;
    let max_pages: u64 = 20;
    let count_pages_success: bool = false; // irrelevant
    let count_pages_value: u64 = 0;
    let count_pages_exit_code: i32 = 0;
    let check_pdf_success: bool = true;
    let check_pdf_value: u64 = 42;
    let check_pdf_exit_code: i32 = 0; // irrelevant
    let exit_code = gate_main(pdf, print_anchors, count_only, min_pages, max_pages, count_pages_success, count_pages_value, count_pages_exit_code, check_pdf_success, check_pdf_value, check_pdf_exit_code);
    assert(exit_code == EXIT_ADMIT);
}

test gate_main_check_pdf_failure_returns_error_code {
    let pdf: []const u8 = "dummy.pdf";
    let print_anchors: bool = false;
    let count_only: bool = false;
    let min_pages: u64 = 10;
    let max_pages: u64 = 20;
    let count_pages_success: bool = false; // irrelevant
    let count_pages_value: u64 = 0;
    let count_pages_exit_code: i32 = 0;
    let check_pdf_success: bool = false;
    let check_pdf_value: u64 = 0; // irrelevant
    let check_pdf_exit_code: i32 = EXIT_ABOVE_BAND;
    let exit_code = gate_main(pdf, print_anchors, count_only, min_pages, max_pages, count_pages_success, count_pages_value, count_pages_exit_code, check_pdf_success, check_pdf_value, check_pdf_exit_code);
    assert(exit_code == EXIT_ABOVE_BAND);
}