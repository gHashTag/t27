module port::trios::tools::acm_ae_check;

const EXIT_SUCCESS: i32 = 0;

enum Cmd {
    Print,
    Anchors,
    Run,
}

struct Args {
    cmd: Cmd,
}

fn parse_args(argc: u32, argv: []str) -> Args {
    // For now, default to Print command
    return Args { cmd: Cmd::Print };
}

pub fn main(argc: u32, argv: []str) -> i32 {
    let args = parse_args(argc, argv);
    
    if (args.cmd == Cmd::Print) {
        return EXIT_SUCCESS;
    } else if (args.cmd == Cmd::Anchors) {
        return EXIT_SUCCESS;
    } else if (args.cmd == Cmd::Run) {
        return EXIT_SUCCESS;
    } else {
        return EXIT_SUCCESS;
    }
}

test main_print_command {
    let result = main(1, []);
    assert(result == EXIT_SUCCESS);
}