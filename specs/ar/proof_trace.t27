// t27/specs/ar/proof_trace.t27
// Bounded Proof Traces for CLARA Explainability (≤10 steps)
// φ² + φ⁻² = 3 | TRINITY

module ProofTrace {
    use base::types;
    use ar::ternary_logic;  // K_TRUE, K_FALSE, K_UNKNOWN
    use numeric::gf16;      // GF16 for confidence (NUMERIC-STANDARD-001)

    // ═══════════════════════════════════════════════════════
    // CONSTANTS
    // ═══════════════════════════════════════════════════════
    const MAX_STEPS : u8 = 10;   // CLARA hard limit

    // ═══════════════════════════════════════════════════════
    // TYPES
    // ═══════════════════════════════════════════════════════
    struct DerivationStep {
        step_number  : u8,
        rule_name    : []const u8,    // max 64 bytes
        input_facts  : [3]Trit,       // up to 3 antecedents
        output_fact  : Trit,
        confidence   : GF16,           // [0.0, 1.0] encoded (NUMERIC-STANDARD-001)
        k3_value     : Trit,           // Kleene truth value of this step
    }

    struct ProofTrace {
        steps            : [MAX_STEPS]DerivationStep,
        step_count       : u8,
        conclusion       : Trit,
        total_confidence : GF16,  // Encoded confidence (NUMERIC-STANDARD-001)
        terminated       : bool,   // true = Restraint cut (MAX_STEPS hit)
    }

    enum FormatStyle {
        natural,   // "Step 1: IF hostile(x) THEN threat(x)"
        fitch,     // Formal Fitch-style natural deduction
        compact,   // One-line summary
    }

    // ═══════════════════════════════════════════════════════
    // FUNCTIONS
    // ═══════════════════════════════════════════════════════
    fn create_trace() -> ProofTrace {
        return ProofTrace {
            step_count       = 0,
            conclusion       = K_UNKNOWN,
            total_confidence = gf16_encode_f32(1.0),
            terminated       = false,
        };
    }

    fn append_step(trace: *ProofTrace, step: DerivationStep) -> bool {
        // Returns false = Restraint triggered (MAX_STEPS exceeded)
        if (trace.step_count >= MAX_STEPS) {
            trace.terminated = true;
            return false;
        }
        trace.steps[trace.step_count] = step;
        trace.step_count += 1;
        trace.conclusion = step.output_fact;
        // Multiply confidence values via GF16 encode/decode
        const current_f = gf16_decode_to_f32(trace.total_confidence);
        const step_f = gf16_decode_to_f32(step.confidence);
        trace.total_confidence = gf16_encode_f32(current_f * step_f);
        return true;
    }

    fn get_conclusion(trace: ProofTrace) -> Trit {
        return trace.conclusion;
    }

    fn get_confidence(trace: ProofTrace) -> GF16 {
        return trace.total_confidence;
    }

    fn format(trace: ProofTrace, style: FormatStyle) -> []const u8 {
        return switch (style) {
            .natural => format_natural(trace),
            .fitch   => format_fitch(trace),
            .compact => format_compact(trace),
        };
    }

    fn format_natural(trace: ProofTrace) -> []const u8 {
        // "Step N: [rule_name] -> [output_fact] (conf=X.XX)"
        var buffer : [512]u8 = undefined;
        var offset : usize = 0;

        var i : usize = 0;
        while (i < trace.step_count) {
            const step = trace.steps[i];

            // Convert step number to string (max 2 digits for 10 steps)
            const step_num = step.step_number;
            if (step_num >= 10) {
                buffer[offset] = '1';
                offset = offset + 1;
                buffer[offset] = '0' + (step_num - 10);
                offset = offset + 1;
            } else {
                buffer[offset] = '0' + step_num;
                offset = offset + 1;
            }

            // ": "
            buffer[offset] = ':'; offset = offset + 1;
            buffer[offset] = ' '; offset = offset + 1;

            // Copy rule name (up to 64 bytes, truncate if needed)
            var j : usize = 0;
            while (j < step.rule_name.len and offset < 500) {
                buffer[offset] = step.rule_name[j];
                offset = offset + 1;
                j = j + 1;
            }

            // " -> "
            buffer[offset] = ' '; offset = offset + 1;
            buffer[offset] = '-'; offset = offset + 1;
            buffer[offset] = '>'; offset = offset + 1;
            buffer[offset] = ' '; offset = offset + 1;

            // Output fact representation (T/-1, 0/0, 1/+1)
            match step.output_fact {
                .neg => { buffer[offset] = '-'; offset = offset + 1; buffer[offset] = '1'; offset = offset + 1; }
                .zero => { buffer[offset] = '0'; offset = offset + 1; }
                .pos => { buffer[offset] = '+'; offset = offset + 1; buffer[offset] = '1'; offset = offset + 1; }
            }

            // " (conf="
            buffer[offset] = ' '; offset = offset + 1;
            buffer[offset] = '('; offset = offset + 1;
            buffer[offset] = 'c'; offset = offset + 1;
            buffer[offset] = 'o'; offset = offset + 1;
            buffer[offset] = 'n'; offset = offset + 1;
            buffer[offset] = 'f'; offset = offset + 1;
            buffer[offset] = '='; offset = offset + 1;

            // Confidence value (2 decimal places)
            const conf_f = gf16_decode_to_f32(step.confidence);
            const conf_int = @intFromFloat(conf_f * 100.0);
            const conf_hundreds = (conf_int / 100) % 10;
            const conf_tens = (conf_int / 10) % 10;
            const conf_ones = conf_int % 10;

            buffer[offset] = '0' + conf_hundreds; offset = offset + 1;
            buffer[offset] = '.'; offset = offset + 1;
            buffer[offset] = '0' + conf_tens; offset = offset + 1;
            buffer[offset] = '0' + conf_ones; offset = offset + 1;

            // ")\n"
            buffer[offset] = ')'; offset = offset + 1;
            buffer[offset] = '\n'; offset = offset + 1;

            i = i + 1;
        }

        // Null-terminate
        if (offset < 512) {
            buffer[offset] = 0;
        }

        return buffer[0..offset];
    }

    fn format_fitch(trace: ProofTrace) -> []const u8 {
        // Formal natural deduction columnar format
        // "| 1. {fact}                {rule}"
        var buffer : [512]u8 = undefined;
        var offset : usize = 0;

        var i : usize = 0;
        while (i < trace.step_count) {
            const step = trace.steps[i];

            // Column 1: vertical bar
            buffer[offset] = '|'; offset = offset + 1;
            buffer[offset] = ' '; offset = offset + 1;

            // Column 2: step number (max 2 digits)
            const step_num = step.step_number;
            if (step_num >= 10) {
                buffer[offset] = '1'; offset = offset + 1;
                buffer[offset] = '0' + (step_num - 10); offset = offset + 1;
            } else {
                buffer[offset] = '0' + step_num; offset = offset + 1;
            }

            buffer[offset] = '.'; offset = offset + 1;
            buffer[offset] = ' '; offset = offset + 1;

            // Column 3: fact (output fact + input facts)
            // Write output fact first
            match step.output_fact {
                .neg => { buffer[offset] = '-'; offset = offset + 1; buffer[offset] = '1'; offset = offset + 1; }
                .zero => { buffer[offset] = '0'; offset = offset + 1; }
                .pos => { buffer[offset] = '+'; offset = offset + 1; buffer[offset] = '1'; offset = offset + 1; }
            }

            // Add input facts if present
            if (step.input_facts[0] != .zero or step.input_facts[1] != .zero or step.input_facts[2] != .zero) {
                buffer[offset] = ' '; offset = offset + 1;
                buffer[offset] = '('; offset = offset + 1;
                var fact_idx : usize = 0;
                var need_comma = false;
                while (fact_idx < 3) {
                    if (step.input_facts[fact_idx] != .zero) {
                        if (need_comma) {
                            buffer[offset] = ','; offset = offset + 1;
                        }
                        match step.input_facts[fact_idx] {
                            .neg => { buffer[offset] = '-'; offset = offset + 1; buffer[offset] = '1'; offset = offset + 1; }
                            .zero => { buffer[offset] = '0'; offset = offset + 1; }
                            .pos => { buffer[offset] = '+'; offset = offset + 1; buffer[offset] = '1'; offset = offset + 1; }
                        }
                        need_comma = true;
                    }
                    fact_idx = fact_idx + 1;
                }
                buffer[offset] = ')'; offset = offset + 1;
            }

            // Pad to column 20 (rule column)
            while (offset < 20) {
                buffer[offset] = ' ';
                offset = offset + 1;
            }

            // Column 4: rule name (justification)
            var j : usize = 0;
            while (j < step.rule_name.len and offset < 500) {
                buffer[offset] = step.rule_name[j];
                offset = offset + 1;
                j = j + 1;
            }

            // Newline
            buffer[offset] = '\n'; offset = offset + 1;

            i = i + 1;
        }

        // Null-terminate
        if (offset < 512) {
            buffer[offset] = 0;
        }

        return buffer[0..offset];
    }

    fn format_compact(trace: ProofTrace) -> []const u8 {
        // "N steps | conclusion=[K] | conf=X.XX | terminated=[bool]"
        var buffer : [128]u8 = undefined;
        var offset : usize = 0;

        // Step count
        const steps = trace.step_count;
        if (steps >= 10) {
            buffer[offset] = '1'; offset = offset + 1;
            buffer[offset] = '0' + (steps - 10); offset = offset + 1;
        } else {
            buffer[offset] = '0' + steps; offset = offset + 1;
        }

        // " steps | conclusion="
        const step_str = " steps | conclusion=";
        var i : usize = 0;
        while (i < step_str.len) {
            buffer[offset] = step_str[i];
            offset = offset + 1;
            i = i + 1;
        }

        // Conclusion value
        match trace.conclusion {
            .neg => { buffer[offset] = '-'; offset = offset + 1; buffer[offset] = '1'; offset = offset + 1; }
            .zero => { buffer[offset] = '0'; offset = offset + 1; }
            .pos => { buffer[offset] = '+'; offset = offset + 1; buffer[offset] = '1'; offset = offset + 1; }
        }

        // " | conf="
        const conf_header = " | conf=";
        i = 0;
        while (i < conf_header.len) {
            buffer[offset] = conf_header[i];
            offset = offset + 1;
            i = i + 1;
        }

        // Confidence (2 decimal places)
        const conf_f = gf16_decode_to_f32(trace.total_confidence);
        const conf_int = @intFromFloat(conf_f * 100.0);
        const conf_hundreds = (conf_int / 100) % 10;
        const conf_tens = (conf_int / 10) % 10;
        const conf_ones = conf_int % 10;

        buffer[offset] = '0' + conf_hundreds; offset = offset + 1;
        buffer[offset] = '.'; offset = offset + 1;
        buffer[offset] = '0' + conf_tens; offset = offset + 1;
        buffer[offset] = '0' + conf_ones; offset = offset + 1;

        // " | terminated="
        const term_header = " | terminated=";
        i = 0;
        while (i < term_header.len) {
            buffer[offset] = term_header[i];
            offset = offset + 1;
            i = i + 1;
        }

        // Terminated boolean
        if (trace.terminated) {
            buffer[offset] = 't'; offset = offset + 1;
            buffer[offset] = 'r'; offset = offset + 1;
            buffer[offset] = 'u'; offset = offset + 1;
            buffer[offset] = 'e'; offset = offset + 1;
        } else {
            buffer[offset] = 'f'; offset = offset + 1;
            buffer[offset] = 'a'; offset = offset + 1;
            buffer[offset] = 'l'; offset = offset + 1;
            buffer[offset] = 's'; offset = offset + 1;
            buffer[offset] = 'e'; offset = offset + 1;
        }

        // Null-terminate
        if (offset < 128) {
            buffer[offset] = 0;
        }

        return buffer[0..offset];
    }

    // ═══════════════════════════════════════════════════════
    // TESTS
    // ═══════════════════════════════════════════════════════
    test trace_respects_max_steps
        given trace = create_trace()
        when append 11 DerivationStep instances
        then 10th append returns true
        and  11th append returns false
        and  trace.step_count == 10
        and  trace.terminated == true

    test trace_conclusion_tracks_last_step
        given trace = create_trace()
        when append_step with output_fact = K_TRUE
        then get_conclusion(trace) == K_TRUE

    test trace_confidence_is_product
        given trace = create_trace()
        when append step with confidence=0.9
        and  append step with confidence=0.8
        then get_confidence(trace) ≈ 0.72 (±1e-6)

    test trace_unknown_initial_conclusion
        given fresh trace = create_trace()
        then get_conclusion(trace) == K_UNKNOWN

    test format_natural_contains_step_numbers
        given trace with 3 steps
        when format(trace, .natural)
        then output contains "Step 1" and "Step 2" and "Step 3"

    test format_compact_single_line
        given trace with 5 steps
        when format(trace, .compact)
        then output contains no newline characters

    // ═══════════════════════════════════════════════════════
    // INVARIANTS
    // ═══════════════════════════════════════════════════════
    invariant trace_bounded_by_clara
        for all ProofTrace t: t.step_count <= MAX_STEPS

    invariant step_numbers_monotonic
        for all traces t, indices i < t.step_count - 1:
            t.steps[i].step_number < t.steps[i+1].step_number

    invariant confidence_in_unit_interval
        for all ProofTrace t: 0.0 <= t.total_confidence <= 1.0

    invariant terminated_iff_max_steps
        for all ProofTrace t:
            t.terminated == (t.step_count == MAX_STEPS)

    // ═══════════════════════════════════════════════════════
    // BENCHES
    // ═══════════════════════════════════════════════════════
    bench proof_trace_full_10_steps
        measure: cycles for create_trace + 10 × append_step
        target: < 500 cycles

    bench format_natural_10_steps
        measure: cycles for format(trace_10, .natural)
        target: < 1000 cycles
}
