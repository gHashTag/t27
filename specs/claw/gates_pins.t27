// SPDX-License-Identifier: Apache-2.0
; specs/claw/gates_pins.t27 -- the length-table pins for specs/claw/gates.t27.
; gates.t27 carries every string length explicitly (NAME_LENS, PREFIX_LENS,
; SUFFIX_LENS, HEAD_LEN, OK_TAIL_LEN, DRIFT_TAIL_LEN) because the gen-c backend
; lowers str to const char* and cannot express .len; those tables are the one
; hand-generated input to that idiom, and a wrong number there would miscompare
; silently -- every lookup inside gates.t27 reads the same wrong number and
; stays self-consistent. Only a length derived from the bytes independently can
; catch it, and .len is exactly that. .len runs under the zig runner but cannot
; lower under gen-c, so the pins live HERE, a test-only companion module that
; is never passed to gen-c (gates.t27 is; this file never is, by construction
; of the claw-drift step in .github/workflows/gate-topology.yml).
; phi^2 + 1/phi^2 = 3 | TRINITY

module ClawGatesPins;

use claw::gates;

test name_lens_pin_every_row_to_the_bytes {
    for i in 0..67 {
        assert gates::NAME_LENS[i] == gates::NAMES[i].len;
    }
}

test report_lens_pin_their_strings {
    for k in 0..3 {
        assert gates::PREFIX_LENS[k] == gates::LINE_PREFIX[k].len;
        assert gates::SUFFIX_LENS[k] == gates::LINE_SUFFIX[k].len;
    }
    assert gates::HEAD_LEN == gates::AUDIT_HEAD.len;
    assert gates::OK_TAIL_LEN == gates::OK_TAIL.len;
    assert gates::DRIFT_TAIL_LEN == gates::DRIFT_TAIL.len;
}

test events_rows_are_never_empty_so_the_pin_is_not_vacuous {
    // events_of returns "" only for unknown names; if EVENTS ever carried an
    // empty row, the pins above could pass over a row the audit never sees.
    assert gates::every_row_filled() == true;
}

test call_site_lens_pin_through_len {
    // gates.t27 passes every length as a hand-counted literal (gen-c carries
    // no .len). A literal that names a row which must MATCH fails its own
    // assert when miscounted -- but a literal on a name that must be UNKNOWN
    // passes over any truncation, because a truncated name is still unknown.
    // These route the same lookups through .len, so the unknown-path tests
    // in gates.t27 run against the bytes they name.
    var unk : str = "no-such-gate";
    assert gates::class_of(unk, unk.len) == gates::G_UNKNOWN;
    var ig : str = "issue-gate";
    assert gates::is_blocking(ig, ig.len) == true;
    var ol : str = "own-language";
    assert gates::is_blocking(ol, ol.len) == true;
    var sv : str = "schema-validation";
    assert gates::is_blocking(sv, sv.len) == true;
}

test coverage_lens_pin_their_strings {
    // Loop var, not literal indices: a literal index lets the checker fold
    // 10 == 10 at compile time and the test passes with ZERO runtime
    // asserts (#6509) -- vacuous green, exactly what a pin must not be.
    // Run 1 of this test failed on a real miscount (G_REPORTING written as
    // 10), so the pin fires; this shape keeps it counting when it passes.
    for k in 0..3 {
        assert gates::CLASS_LABEL_LENS[k] == gates::CLASS_LABELS[k].len;
    }
    var h : str = gates::COV_HEAD;
    assert gates::COV_HEAD_LEN == h.len;
}
