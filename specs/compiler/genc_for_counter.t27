; #7307: a range `for` captures a usize, so gen-c declares its C counter `size_t`.
; With an `int` counter a start bound above INT_MAX converted to a negative int,
; the comparison against the size_t end bound was false at once, and the loop ran
; zero times: count_from(4294967295, 2) gave 0, not 2. Run by
; bootstrap/tests/genc_for_counter.rs (gen-c, cc -DT27_TEST_MAIN, execute).
module GencForCounter {
    const BIG: usize = 4294967295;

    fn count_from(start: usize, n: usize) -> usize {
        var s: usize = 0;
        for (start..start + n) |_| {
            s = s + 1;
        }
        return s;
    }

    fn last_index(start: usize, n: usize) -> usize {
        var last: usize = 0;
        for (start..start + n) |i| {
            last = i;
        }
        return last;
    }

    fn count_inclusive(start: usize, n: usize) -> usize {
        var s: usize = 0;
        for (start..=start + n) |_| {
            s = s + 1;
        }
        return s;
    }

    test counts_past_int_max {
        assert(count_from(BIG, 2) == 2, "two steps from 2^32 - 1");
        assert(count_inclusive(BIG, 2) == 3, "inclusive range from 2^32 - 1");
    }

    test capture_is_a_usize {
        assert(last_index(BIG, 2) == 4294967296, "the body sees i = 2^32");
    }

    test small_ranges_unchanged {
        assert(count_from(0, 5) == 5, "0..5");
        assert(last_index(3, 4) == 6, "3..7 ends at 6");
        assert(count_inclusive(0, 0) == 1, "0..=0 runs once");
    }
}
