test t751_fib_warmup {
    // 01:flat 02:flat 03:flat 04:flat 05:flat 06:flat 07:flat 08:warmup 09:flat 10:flat
    assert count_class(&FIB_US, RUNS, ITERS, FLAT) == 9;
    assert count_class(&FIB_US, RUNS, ITERS, WARMUP) == 1;
    assert count_class(&FIB_US, RUNS, ITERS, SLOWDOWN) == 0;
    assert count_class(&FIB_US, RUNS, ITERS, NO_STEADY) == 0;
    assert benchmark_class(&FIB_US, RUNS, ITERS) == GOOD_INCONSISTENT;
    var v08: WarmupVerdict = judge(&FIB_US, 7 * ITERS, ITERS);
    assert v08.cls == WARMUP;
    assert v08.segments == 2;
    assert v08.steady_iter == 36;
}

