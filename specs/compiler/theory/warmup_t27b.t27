test t751_f64loop_warmup {
    // 01:flat 02:flat 03:flat 04:flat 05:flat 06:flat 07:flat 08:flat 09:flat 10:no_steady
    assert count_class(&F64LOOP_US, RUNS, ITERS, FLAT) == 9;
    assert count_class(&F64LOOP_US, RUNS, ITERS, WARMUP) == 0;
    assert count_class(&F64LOOP_US, RUNS, ITERS, SLOWDOWN) == 0;
    assert count_class(&F64LOOP_US, RUNS, ITERS, NO_STEADY) == 1;
    assert benchmark_class(&F64LOOP_US, RUNS, ITERS) == BAD_INCONSISTENT;
    var v10: WarmupVerdict = judge(&F64LOOP_US, 9 * ITERS, ITERS);
    assert v10.cls == NO_STEADY;
    assert v10.segments == 2;
    assert v10.steady_iter == 426;
}

