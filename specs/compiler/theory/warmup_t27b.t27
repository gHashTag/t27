    assert count_class(&SIEVE_US, RUNS, ITERS, WARMUP) == 0;
    assert count_class(&SIEVE_US, RUNS, ITERS, SLOWDOWN) == 0;
    assert count_class(&SIEVE_US, RUNS, ITERS, NO_STEADY) == 0;
    assert benchmark_class(&SIEVE_US, RUNS, ITERS) == FLAT;
}

