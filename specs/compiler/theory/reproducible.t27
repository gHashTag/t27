// SPDX-License-Identifier: Apache-2.0
; specs/compiler/theory/reproducible.t27 -- output determinism test for t27c compiler
; gHashTag/t27#6517, epic #6488. ASCII only (L3).
; 
; Master commit: b73209026 Merge pull request #6598 from gHashTag/t27b-bless-6063
; 
; This module tests output determinism of the t27c compiler: running the same
; t27c binary twice on the same source spec produces bit-identical C output.
; This is NOT a test of reproducible builds of t27c itself (which would require
; two independent builds of t27c and stays open). This is output determinism
; of one t27c binary, as defined by reproducible-builds.org/docs/definition.

module CompilerTheoryReproducible;

; Number of specs tested for output determinism
pub fn spec_count() -> u32 {
    return 12;
}

; Check if i identical outputs were observed (true if all outputs identical)
pub fn identical(i: u32) -> bool {
    return i == 12;
}

; Test that all 12 specs produced identical outputs when run twice
test t27651_all_specs_identical {
    var count : u32 = CompilerTheoryReproducible.spec_count();
    var all_identical : bool = CompilerTheoryReproducible.identical(count);
    assert all_identical == true;
}

; Negative control test: two different integer values should be different
test t27651_negative_control_different_specs {
    var value1 : u32 = 42;
    var value2 : u32 = 100;
    var values_different : bool = (value1 != value2);
    assert values_different == true;
}