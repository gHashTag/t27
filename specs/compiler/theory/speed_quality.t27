; -- Logic (hand-written) --

; The REPS samples of one kernel, sorted (insertion sort), into s.
fn sorted5(xs: []const u32, k: usize, s: []u32) -> void {
    var i: usize = 0;
    while (i < REPS) {
        var v: u32 = xs[k * REPS + i];
        var j: usize = i;
        while (j > 0 and s[j - 1] > v) {
            s[j] = s[j - 1];
            j = j - 1;
        }
        s[j] = v;
        i = i + 1;
    }
}

; The published median of one kernel's samples: the middle of five.
pub fn med5(xs: []const u32, k: usize) -> u32 {
    var s: [8]u32 = [_]u32{0} ** 8;
    sorted5(xs, k, &s);
    return s[REPS / 2];
}

; The published minimum of one kernel's samples.
pub fn min5(xs: []const u32, k: usize) -> u32 {
    var s: [8]u32 = [_]u32{0} ** 8;
    sorted5(xs, k, &s);
    return s[0];
}

; ln of the geometric mean of a[k] / b[k] over kernels lo..hi-1, from medians (or minima).
pub fn log_geomean(a: []const u32, b: []const u32, lo: usize, hi: usize, use_min: bool) -> f64 {
    var sum: f64 = 0.0;
    var k: usize = lo;
    while (k < hi) {
        var x: u32 = med5(a, k);
        var y: u32 = med5(b, k);
        if (use_min) {
            x = min5(a, k);
            y = min5(b, k);
        }
        sum = sum + @log((x as f64) / (y as f64));
        k = k + 1;
    }
    return sum / ((hi - lo) as f64);
}

; True when the geometric mean lies in [lo, hi].
pub fn geomean_in(a: []const u32, b: []const u32, k0: usize, k1: usize, use_min: bool, lo: f64, hi: f64) -> bool {
    var g: f64 = log_geomean(a, b, k0, k1, use_min);
    return g >= @log(lo) and g <= @log(hi);
}

; -- Tests (T753) --

test t753_medians_are_the_published_ones {
    // A few cells of the table in the header, recomputed from the samples.
    assert med5(&T27B_RUN, FIB) == 359415;
    assert min5(&T27B_RUN, FIB) == 317732;
    assert med5(&CLANG_O2, MATMUL) == 194697;
    assert med5(&ZIG_FAST, COLLATZ) == 1532891;
    assert med5(&C_T27C_GEN_C, TERNARY) == 4367;
    assert med5(&C_ZIG_FAST, F64LOOP) == 15457316;
    // A median is a sample and lies between the minimum and the maximum.
    var k: usize = 0;
    while (k < KERNELS) {
        assert min5(&T27B_WALL, k) <= med5(&T27B_WALL, k);
        assert med5(&T27B_RUN, k) < med5(&T27B_WALL, k);
        k = k + 1;
    }
}

test t753_clang_o2_folds_f64loop {
    // clang -O2 runs f64loop in under 20 ms, a tenth of every other row: read as the loop folded at
    // compile time (not checked by disassembly). f64loop leaves the clang -O2 geomean, which would
    // otherwise measure little more than process start.
    var c: u32 = med5(&CLANG_O2, F64LOOP);
    assert c < 20000;
    assert c * 10 < med5(&GCC_O2, F64LOOP);
    assert c * 10 < med5(&ZIG_FAST, F64LOOP);
    assert c * 10 < med5(&T27B_RUN, F64LOOP);
    // No other kernel is folded: each clang -O2 median is above 100 ms.
    var k: usize = 0;
    while (k < F64LOOP) {
        assert med5(&CLANG_O2, k) > 100000;
        k = k + 1;
    }
}

test t753_t27b_code_quality_against_clang_and_zig {
    // t27b against clang -O2, 5 kernels: 3.13x process wall, 2.65x run phase.
    assert geomean_in(&T27B_WALL, &CLANG_O2, 0, F64LOOP, false, 3.12, 3.14);
    assert geomean_in(&T27B_RUN, &CLANG_O2, 0, F64LOOP, false, 2.64, 2.66);
    // Against zig ReleaseFast, all 6 kernels: 2.27x wall, 1.90x run phase.
    assert geomean_in(&T27B_WALL, &ZIG_FAST, 0, KERNELS, false, 2.26, 2.28);
    assert geomean_in(&T27B_RUN, &ZIG_FAST, 0, KERNELS, false, 1.89, 1.91);
    // Against gcc -O2, all 6: 2.72x wall.
    assert geomean_in(&T27B_WALL, &GCC_O2, 0, KERNELS, false, 2.71, 2.73);
    // From minima instead of medians the order holds: 3.31x and 2.32x wall.
    assert geomean_in(&T27B_WALL, &CLANG_O2, 0, F64LOOP, true, 3.30, 3.32);
    assert geomean_in(&T27B_WALL, &ZIG_FAST, 0, KERNELS, true, 2.31, 2.33);
    // Not uniform: on collatz the t27b run phase beats zig ReleaseFast, and it beats every -O0 row there.
    assert med5(&T27B_RUN, COLLATZ) < med5(&ZIG_FAST, COLLATZ);
    assert med5(&T27B_RUN, COLLATZ) < med5(&CLANG_O0, COLLATZ);
    assert med5(&T27B_RUN, COLLATZ) > med5(&GCC_O0, COLLATZ);
}

test t753_t27c_code_quality_through_each_backend {
    // t27c's own output through gcc -O2 and clang -O2 is within 2% (5 kernels), and -O0 costs 2x-7x.
    assert geomean_in(&GCC_O2, &CLANG_O2, 0, F64LOOP, false, 0.97, 0.99);
    assert geomean_in(&GCC_O0, &GCC_O2, 0, KERNELS, false, 2.02, 2.05);
    assert geomean_in(&CLANG_O0, &CLANG_O2, 0, F64LOOP, false, 6.64, 6.66);
    assert geomean_in(&ZIG_DEBUG, &ZIG_FAST, 0, KERNELS, false, 3.53, 3.55);
}

test t753_compile_speed {
    // The t27c front end writes C or Zig in under 8 ms per kernel; t27b's AOT build takes under 4 ms.
    var k: usize = 0;
    while (k < KERNELS) {
        assert med5(&C_T27C_GEN_C, k) < 8000;
        assert med5(&C_T27C_GEN, k) < 8000;
        assert med5(&C_T27B_BUILD, k) < 4000;
        // Every C compile, even gcc -O0, is slower than the gen-c that produced its input.
        assert med5(&C_GCC_O0, k) > med5(&C_T27C_GEN_C, k);
        // zig ReleaseFast takes over 14 s; t27b's JIT compiles, under qemu, in under 0.1 s.
        assert med5(&C_ZIG_FAST, k) > 14000000;
        assert med5(&C_T27B_JIT, k) < 100000;
        k = k + 1;
    }
    // Geomeans: clang -O2 compile is 22.2x gen-c; zig ReleaseFast is 306x the t27b JIT compile.
    assert geomean_in(&C_CLANG_O2, &C_T27C_GEN_C, 0, KERNELS, false, 22.1, 22.4);
    assert geomean_in(&C_ZIG_FAST, &C_T27B_JIT, 0, KERNELS, false, 305.0, 307.0);
}
