; t27core_ddc -- Diverse Double-Compiling of the self-hosted core (#6508,
; theorem T732 in specs/compiler/theory/toolchain.t27, epics #6488 and #5980).

; S is specs/compiler/core/t27core.t27, a t27 compiler written in t27. E is
; `t27c gen-c S`, the C text S must reproduce byte for byte (its fixpoint,
; gated in bootstrap/tests/core_selfhost.rs). This module imports every function
; and constant of S through `use`, carries S and E as data, and has one test:
; run S's `compile` on S and compare the output with E.

; Whoever builds this module builds S's compiler (stage 1); running the test is
; that stage-1 compiler compiling S (stage 2). So each backend that passes the
; test has produced a stage-1 core whose stage-2 output is exactly E:

;   gen-c + cc    stage 2 == E   bootstrap/tests/core_selfhost.rs (fixpoint)
;   t27b (AArch64) stage 2 == E   `t27b test` on this file, t27b lab
;   Zig reference  stage 2 == E   `t27c test-report` on this file, t27b lab

; One command runs the t27b and the Zig routes on this file and compares their
; verdicts test by test (`reference disagree`):
;   t27b corpus specs/compiler/core --blockers --reference target/release/t27c
; The t27b lab runs the same comparison over specs/ on every master commit.

; Three diverse stage-1 builds agreeing on every byte of stage 2 is the DDC
; result: a backend that miscompiles S in a way that changes its output on S
; cannot pass. It has already caught one: the first Zig run failed because
; gen-zig hoisted a repeated `p + 1` above a write to `p` (#6292); S now steps
; with `advance()`. What it does NOT show, stated where the result is read:

; 1. Shared front end (T729). t27b mounts bootstrap/src/compiler.rs's parser
;    and type checker by #[path], and gen-c and gen-zig run behind the same
;    parser. A defect in that front end is common mode: all three routes can
;    agree on it. The diversity is in the back ends (C via cc, AArch64 via
;    t27b, Zig via zig), not in the front end.
; 2. The comparison runs inside the program each backend built. Wheeler
;    compares stage-2 outputs with a tool outside both builds; here a backend
;    that miscompiled the comparison loop itself could pass its own run. The
;    negative control below (one flipped byte must be found) closes the case
;    where the loop is a no-op, not the case of a targeted trojan.
; 3. The data is pinned. S and E below are the bytes of t27core.t27 and of its
;    gen-c output at the sha256 sums listed next to DDC_SRC_LEN and
;    DDC_OUT_LEN. The functions come from the live t27core.t27 through `use`,
;    so after t27core.t27 changes this test checks the new core on the old S
;    until the data is regenerated -- compare the sums with
;    `shasum -a 256 specs/compiler/core/t27core.t27` to know.

; Data layout: every line of ddc_source and ddc_expected is 32 bytes packed
; as four 64-bit words, first byte lowest (as t27core's `w` packs text); the
; tail is one word per call with its byte count. The words are decimal: a hex
; word ending in f16, f32 or f64 loses those digits in the shared front end
; (#6802), which is how this harness first failed. Regenerating the data means
; packing the two files the same way; no step of it decides anything.

; The module-level `var`s are restated here because `use` imports functions
; and constants only (bootstrap/src/use_resolve.rs `decl_name`); a variable
; S adds and this list lacks fails to compile, so the copy cannot go stale
; silently.

module t27core_ddc;

use compiler::core::t27core;

var src: [SRC_MAX]u8 = [_]u8{0} ** SRC_MAX;
var out: [OUT_MAX]u8 = [_]u8{0} ** OUT_MAX;
var tk_kind: [TOK_MAX]i64 = [_]i64{0} ** TOK_MAX;
var tk_pos: [TOK_MAX]i64 = [_]i64{0} ** TOK_MAX;
var tk_len: [TOK_MAX]i64 = [_]i64{0} ** TOK_MAX;
var nd_kind: [NODE_MAX]i64 = [_]i64{0} ** NODE_MAX;
var nd_tok: [NODE_MAX]i64 = [_]i64{0} ** NODE_MAX;
var nd_a: [NODE_MAX]i64 = [_]i64{0} ** NODE_MAX;
var nd_b: [NODE_MAX]i64 = [_]i64{0} ** NODE_MAX;
var nd_c: [NODE_MAX]i64 = [_]i64{0} ** NODE_MAX;
var nd_next: [NODE_MAX]i64 = [_]i64{0} ** NODE_MAX;
var nd_aux: [NODE_MAX]i64 = [_]i64{0} ** NODE_MAX;

var src_len: i64 = 0;
var out_len: i64 = 0;
var tok_count: i64 = 0;
var node_count: i64 = 1;
var p: i64 = 0;
var failed: bool = false;
var err_code: i64 = 0;
var err_pos: i64 = 0;
var has_tests: bool = false;
var uses_assert: bool = false;
var mod_tok: i64 = 0;
var decls: i64 = 0;

; S: specs/compiler/core/t27core.t27, sha256 cd34175099b9f6af819edfde859685b2818add26b58919fd0ca83942f8aa5091
const DDC_SRC_LEN: i64 = 58976;
; E: t27c gen-c of S, sha256 b452f28afc10c27b3b6929dd1803498c58d02bdb8b35af50678672def6c31ce4
const DDC_OUT_LEN: i64 = 56722;
; The byte the negative control flips; inside E.
const DDC_FLIP_AT: i64 = 20000;

; 0 writes the data into `src`; 1 compares it with `out`.
var ddc_mode: i64 = 0;
var ddc_at: i64 = 0;
var ddc_bad: i64 = 0;
var ddc_first: i64 = -1;

fn ddc_begin(mode: i64) -> void {
    ddc_mode = mode;
    ddc_at = 0;
    ddc_bad = 0;
    ddc_first = -1;
}

fn ddc_put(x: i64, n: i64) -> void {
    var i: i64 = 0;
    while (i < n) {
        var b: u8 = ((x >> (i * 8)) & 255) as u8;
        if (ddc_mode == 0) {
            src[(ddc_at + i) as usize] = b;
        } else if (out[(ddc_at + i) as usize] != b) {
            if (ddc_bad == 0) {
                ddc_first = ddc_at + i;
            }
            ddc_bad = ddc_bad + 1;
        }
        i = i + 1;
    }
    ddc_at = ddc_at + n;
}

fn d4(w0: i64, w1: i64, w2: i64, w3: i64) -> void {
    ddc_put(w0, 8);
    ddc_put(w1, 8);
    ddc_put(w2, 8);
    ddc_put(w3, 8);
}

fn d1(x: i64, n: i64) -> void {
    ddc_put(x, n);
}

; Flips one byte of the stage-2 output, so the comparison must see it.
fn ddc_flip(at_pos: i64) -> void {
    out[at_pos as usize] = (out[at_pos as usize] ^ 1) as u8;
}

; Stage 2: the core this module was built into compiles S; the output must be
; E, every byte. Then one flipped byte must be found, at its offset, once.
test ddc_stage2_output_is_gen_c_output {
    ddc_begin(0);
    ddc_source();
    assert(ddc_at == DDC_SRC_LEN);
    var r: i64 = compile(DDC_SRC_LEN);
    assert(err_code == 0);
    assert(r == DDC_OUT_LEN);
    ddc_begin(1);
    ddc_expected();
    assert(ddc_at == DDC_OUT_LEN);
    assert(ddc_bad == 0);
    ddc_flip(DDC_FLIP_AT);
    ddc_begin(1);
    ddc_expected();
    assert(ddc_bad == 1);
    assert(ddc_first == DDC_FLIP_AT);
}

