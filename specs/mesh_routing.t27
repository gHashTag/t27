// Mesh routing spec - reproduces and tests fixes for multiple bugs
pub fn n1_finite(value: u32) -> bool {
    // Test wrapping arithmetic: use wrapping operators to avoid overflow bugs
    let wrapped: u32 = value.+%(1);  // wrapping_add equivalent
    
    // Test bool usage: direct use in condition (should not emit != 0)
    let flag: bool = wrapped > 0;
    if flag {  // This should generate "if flag {" not "if flag != 0 {"
        true
    } else {
        false
    }
}

// test: n1_finite function
test test_n1_finite {
    // Test with 0: 0 + 1 = 1 > 0, should return true
    assert n1_finite(0) == true;
    
    // Test with 4294967295: 4294967295 + 1 = 0 (wrapping), should return false
    assert n1_finite(4294967295) == false;
}