    // ════════════════════════════════════════════════════════════════════
    // User Operations
    // ════════════════════════════════════════════════════════════════════

    // AccountOrgs represents an account with its organizations
    struct AccountOrgs {
        account: Info,
        orgs: [Org],
    }

    // UserInfo represents user information from API
    struct UserInfo {
        id: AccountID,
        email: str,
    }

    // get_user retrieves user information for an account
