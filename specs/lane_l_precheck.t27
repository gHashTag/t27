# Lane L Precheck Specification (t27)
# SPDX-License-Identifier: Apache-2.0
# t27/specs/lane_l_precheck.t27
# EULER chip precheck optimization for 75 TOPS/W baseline via CGT (-12% power)

# =====================================================================
# 1. Module Declaration
# =====================================================================

module lane_l_precheck:
  """
  Lane L Precheck — Computational Graph Transformation dispatch unit.

  This module implements a precomputation filter that leverages Wave-40
  sparsity mask (OP_SPARSE_MASK = 0xED) and Wave-41 sparse gate (OP_SPARSE_SKIP = 0xE8)
  to eliminate redundant computations before the main pipeline.

  The precheck operates on the LEVER STACK architecture (Lanes V/W) and
  dispatches via OP_LUT_LOOKUP (0xDF) to the Platinum LUT PE.

  Target: -12% dynamic power reduction, TOPS/W >= 75 baseline.
  """
  desc: "Lane L Precheck CGT dispatch for EULER 75 TOPS/W baseline"

# =====================================================================
# 2. Parameters
# =====================================================================

param:
  name: PHI_SQ_INV
  type: real
  value: 0.382  # phi^-2 ~ 0.382
  desc: "Golden constant for sparsity threshold"

param:
  name: PRECHECK_DEPTH
  type: nat
  value: 4
  desc: "Precheck pipeline depth (cycles)"

param:
  name: POWER_REDUCTION_TARGET
  type: real
  value: -0.12
  desc: "Target dynamic power reduction (negative = savings)"

param:
  name: TOPS_W_BASELINE_TARGET
  type: real
  value: 75.0
  desc: "Target TOPS/W at precheck exit (pre-boost)"

param:
  name: SPARSITY_CORRELATION_TARGET
  type: real
  value: 0.8
  desc: "Target correlation with Wave-40 mask"

param:
  name: PRECHECK_THRESHOLD
  type: real
  value: 0.3
  desc: "Activation threshold for precheck dispatch"

# =====================================================================
# 3. Input/Output Ports
# =====================================================================

input:
  name: clk
  type: wire[1]
  desc: "System clock"

input:
  name: reset_n
  type: wire[1]
  desc: "Active-low reset"

input:
  name: opcode
  type: wire[8]
  desc: "TRI-27 ISA opcode (OP_LUT_LOOKUP = 0xDF, etc.)"

input:
  name: activation_in
  type: wire[16]
  desc: "Input activation (GF16 format)"

input:
  name: weight_in
  type: wire[16]
  desc: "Input weight (GF16 format)"

input:
  name: sparsity_mask_in
  type: wire[27]
  desc: "27-bit sparsity mask from Wave-40 (Coptic channel groups)"

input:
  name: sparse_gate_in
  type: wire[1]
  desc: "Sparse gate signal from Wave-41 (OP_SPARSE_SKIP)"

output:
  name: precheck_valid
  type: wire[1]
  desc: "Precheck result valid (computed vs skipped)"

output:
  name: activation_out
  type: wire[16]
  desc: "Filtered activation output"

output:
  name: weight_out
  type: wire[16]
  desc: "Filtered weight output"

output:
  name: skip_dispatch
  type: wire[1]
  desc: "Signal to skip main pipeline dispatch"

# =====================================================================
# 4. State Machine
# =====================================================================

enum PrecheckState:
  IDLE
  EVAL_THRESHOLD
  CHECK_MASK
  DISPATCH_DECISION
  FORWARD

state:
  name: state
  type: PrecheckState
  init: IDLE

transition:
  from: IDLE
  to: EVAL_THRESHOLD
  guard: reset_n == 1
  action: "Begin precheck cycle"

transition:
  from: EVAL_THRESHOLD
  to: CHECK_MASK
  guard: |activation_in| > PRECHECK_THRESHOLD
  action: "Activation passes threshold, check mask"

transition:
  from: EVAL_THRESHOLD
  to: FORWARD
  guard: |activation_in| <= PRECHECK_THRESHOLD
  action: "Activation below threshold, forward as zero"

transition:
  from: CHECK_MASK
  to: DISPATCH_DECISION
  guard: sparsity_mask_in[activation_in[14:9]] == 1
  action: "Channel group kept, prepare dispatch"

transition:
  from: CHECK_MASK
  to: FORWARD
  guard: sparsity_mask_in[activation_in[14:9]] == 0
  action: "Channel group pruned, forward as zero"

transition:
  from: DISPATCH_DECISION
  to: FORWARD
  guard: sparse_gate_in == 0
  action: "Sparse gate disabled, forward"

transition:
  from: DISPATCH_DECISION
  to: IDLE
  guard: sparse_gate_in == 1
  action: "Sparse gate enabled, skip dispatch"

transition:
  from: FORWARD
  to: IDLE
  guard: true
  action: "Complete precheck cycle"

# =====================================================================
# 5. Combinational Logic
# =====================================================================

func:
  name: activation_magnitude
  type: real
  args:
    - name: a
      type: gf16
  body: |
    if a.sign == 0:
        return exp2(a.exp - BIAS) * (1 + a.mant / 2^MANT_BITS)
    else:
        return -exp2(a.exp - BIAS) * (1 + a.mant / 2^MANT_BITS)
  desc: "Compute GF16 activation magnitude"

func:
  name: apply_precheck
  type: (gf16, gf16, bool)
  args:
    - name: activation
      type: gf16
    - name: weight
      type: gf16
    - name: mask
      type: wire[27]
    - name: gate
      type: wire[1]
  body: |
    mag = activation_magnitude(activation)
    if mag <= PRECHECK_THRESHOLD:
        return (zero_gf16, zero_gf16, true)  # Skip
    elif mask[activation.exp_mod_27] == 0:
        return (zero_gf16, zero_gf16, true)  # Skip
    elif gate == 1:
        return (zero_gf16, zero_gf16, true)  # Skip
    else:
        return (activation, weight, false)  # Forward
  desc: "Apply precheck logic to activation/weight pair"

# =====================================================================
# 6. RTL Generation Rules
# =====================================================================

rtl_rule:
  name: no_star_multipliers
  constraint: "Zero `*` operators in synthesisable RTL"
  pattern: "Use LUT-based multiplication (op_lut_npu) or addition chains"
  priority: critical

rtl_rule:
  name: pipeline_depth
  constraint: "PRECHECK_DEPTH = 4 cycles maximum"
  pattern: "Use 4-stage pipeline with register boundaries"
  priority: required

rtl_rule:
  name: ascii_only
  constraint: "All identifiers must be ASCII"
  pattern: "No Unicode in variable names or comments"
  priority: required

rtl_rule:
  name: phi_identity
  constraint: "Use phi^-2 = 0.382 for threshold scaling"
  pattern: "threshold = PRECHECK_THRESHOLD * phi_sq_inv"
  priority: recommended

# =====================================================================
# 7. Invariants (Coq Lemmas)
# =====================================================================

invariant:
  name: precheck_power_reduction
  type: real_inequality
  lemma: "forall P_baseline, P_precheck, P_precheck <= 0.88 * P_baseline"
  desc: "Dynamic power reduced by >= 12%"
  method: "bench"  # Verified via power simulation

invariant:
  name: tops_w_baseline_geq_75
  type: real_inequality
  lemma: "forall TOPS_W, TOPS_W >= 75.0 at precheck exit"
  desc: "TOPS/W baseline >= 75 (pre-boost)"
  method: "bench"

invariant:
  name: precheck_sparsity_overlap
  type: correlation
  lemma: "corr(sparsity_mask, precheck_skip) >= 0.8"
  desc: "Precheck decisions correlate >= 80% with Wave-40 mask"
  method: "stat"

invariant:
  name: precheck_no_star
  type: boolean
  lemma: "forall cells in synthesis, cell.opcode != `*`"
  desc: "R-SI-1: Zero `*` operators in precheck RTL"
  method: "lint"

invariant:
  name: lut_lookup_dispatch
  type: mapping
  lemma: "opcode == 0xDF -> dispatch_to_lut_pe"
  desc: "OP_LUT_LOOKUP (0xDF) routes to Platinum LUT PE"
  method: "spec"

invariant:
  name: precheck_idempotent
  type: boolean
  lemma: "forall x, apply_precheck(apply_precheck(x)) == apply_precheck(x)"
  desc: "Precheck application is idempotent"
  method: "proof"

invariant:
  name: precheck_preserves_nonzero
  type: implication
  lemma: "forall x, apply_precheck(x).skip == false -> x != zero_gf16"
  desc: "Non-skipped activations are non-zero"
  method: "proof"

invariant:
  name: precheck_pipeline_depth
  type: nat_equality
  lemma: "forall path, path_length <= PRECHECK_DEPTH = 4"
  desc: "Maximum pipeline depth is 4 cycles"
  method: "proof"

invariant:
  name: golden_lambda_minimizes
  type: real_inequality
  lemma: "forall lambda in [0,1], L_total(phi_sq_inv) <= L_total(lambda)"
  desc: "phi^-2 minimizes the loss surrogate"
  method: "proof"

invariant:
  name: precheck_wave40_compat
  type: compatibility
  lemma: "forall mask, precheck_mask(mask) == Wave40_mask(mask)"
  desc: "Precheck mask is compatible with Wave-40 semantics"
  method: "spec"

# =====================================================================
# 8. Test Vectors
# =====================================================================

test:
  name: zero_activation_skip
  input:
    activation_in: 0x0000  # +0.0
    weight_in: 0x3E80       # 1.0
    sparsity_mask_in: 27'hFFFFFFFF
    sparse_gate_in: 1'b0
  expected:
    skip_dispatch: 1'b1
    activation_out: 0x0000
    desc: "Zero activation should skip"

test:
  name: subthreshold_skip
  input:
    activation_in: 0x0100  # Below threshold
    weight_in: 0x3E80
    sparsity_mask_in: 27'hFFFFFFFF
    sparse_gate_in: 1'b0
  expected:
    skip_dispatch: 1'b1
    desc: "Subthreshold activation should skip"

test:
  name: masked_channel_skip
  input:
    activation_in: 0x3E80  # 1.0, channel 1
    weight_in: 0x3E80
    sparsity_mask_in: 27'h7FFFFFFF  # Channel 0 masked
    sparse_gate_in: 1'b0
  expected:
    skip_dispatch: 1'b1
    desc: "Masked channel should skip"

test:
  name: sparse_gate_skip
  input:
    activation_in: 0x3E80
    weight_in: 0x3E80
    sparsity_mask_in: 27'hFFFFFFFF
    sparse_gate_in: 1'b1  # Gate enabled
  expected:
    skip_dispatch: 1'b1
    desc: "Sparse gate should skip"

test:
  name: forward_valid
  input:
    activation_in: 0x7C00  # 2.0, above threshold
    weight_in: 0x7C00
    sparsity_mask_in: 27'hFFFFFFFF  # All channels kept
    sparse_gate_in: 1'b0
  expected:
    skip_dispatch: 1'b0
    activation_out: 0x7C00
    weight_out: 0x7C00
    desc: "Valid activation should forward"

test:
  name: negative_skip
  input:
    activation_in: 0xFC00  # -2.0
    weight_in: 0x3E80
    sparsity_mask_in: 27'hFFFFFFFF
    sparse_gate_in: 1'b0
  expected:
    skip_dispatch: 1'b0
    desc: "Negative activation magnitude should be considered"

# =====================================================================
# 9. Benchmark Workloads
# =====================================================================

bench:
  name: bitnet_b1_58_3b
  workload: "BitNet b1.58-3B inference"
  target: "Dynamic power <= 88% of baseline"
  metric: "power_efficiency"
  desc: "BitNet with ternary weights, batch=1"

bench:
  name: triton_2x2b
  workload: "Triton 2x2B inference"
  target: "TOPS/W >= 75 at precheck exit"
  metric: "throughput_power"
  desc: "Triton LLM inference workload"

bench:
  name: vgg16_imagenet
  workload: "VGG-16 ImageNet classification"
  target: "Sparsity correlation >= 0.8"
  metric: "sparsity_match"
  desc: "Convolutional neural network workload"

# =====================================================================
# 10. References
# =====================================================================

reference:
  name: Wave-40 SparsityMask
  file: "trios-coq/Physics/SparsityMask.v"
  desc: "11 Qed lemmas, OP_SPARSE_MASK = 0xED"

reference:
  name: Wave-41 SparseGate
  file: "trios-coq/Physics/SparseGate.v"
  desc: "OP_SPARSE_SKIP = 0xE8, sparse-activation gating"

reference:
  name: LEVER STACK RMarker
  file: "coq/IGLA/RMarker.v"
  desc: "OP_LUT_LOOKUP = 0xDF, sacred opcode chain"

reference:
  name: Golden Lambda
  doi: "10.5281/zenodo.19227877"
  desc: "phi^2 + phi^-2 = 3"

reference:
  name: AVS-96 Controller
  file: "rtl_gen/avs_controller_96.v"
  desc: "96-island voltage scaling for 5.4x boost"

