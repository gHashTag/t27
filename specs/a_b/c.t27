// Seal naming fixture for #1962; parser restoration #8756.
// Distinct module name avoids the current parent_module filename collision.
// The test below checks only its local value, not project-wide acceptance.

module c_seal_path_fixture;

// Dummy function to make it a valid module
pub fn dummy() -> bool {
    true
}

// The one value this module declares: dummy() returns the boolean true,
// observed through a local first.
test "c_dummy_value" {
    let observed = dummy();
    assert observed == true;
}
