// SPDX-License-Identifier: Apache-2.0
// t27/specs/ml/layers/layernorm_layer.t27
// Layer normalization over the hidden dimension | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/algo/layernorm.tri. The port's
// forward computed x_hat and threw it away (`_ = normalized_val`), took no
// gamma, beta or output, and its tests said `then true`.
// forward follows the .tri formula and forward_layernorm behavior: mean and
// biased variance over the vector, x_hat = (x - mean) / sqrt(var + eps),
// output = gamma * x_hat + beta. The behavior's `size` is input.len here.
// backward follows the true derivative, not the .tri backward_layernorm,
// which contradicts it twice (finite differences agree with this version):
//   - it writes Σ g x_hat into EVERY grad_gamma slot; dL/dgamma_i = g_i x_hat_i;
//   - its grad_input drops gamma and inv_std (term1 is computed, never used)
//     and uses Σ g x_hat where the derivative needs Σ g gamma x_hat.
// With dx_hat_i = g_i gamma_i:
//   grad_input_i = inv_std (dx_hat_i - mean(dx_hat) - x_hat_i mean(dx_hat x_hat)).

module Layernorm;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const LayerNormConfig = struct {
        normalized_shape : []u32,
        eps : f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn mean_of(input: []const f32) -> f32 {
        var sum : f32 = 0.0;
        var i : usize = 0;
        while (i < input.len) {
            sum = sum + input[i];
            i = i + 1;
        }
        return sum / (input.len as f32);
    }

    // 1 / sqrt(biased variance + eps)
    fn inv_std_of(input: []const f32, mean: f32, eps: f32) -> f32 {
        var sum_sq : f32 = 0.0;
        var i : usize = 0;
        while (i < input.len) {
            const diff = input[i] - mean;
            sum_sq = sum_sq + diff * diff;
            i = i + 1;
        }
        return 1.0 / @sqrt(sum_sq / (input.len as f32) + eps);
    }

    fn forward(input: []const f32, gamma: []const f32, beta: []const f32, output: []f32, config: LayerNormConfig) -> void {
        const mean = mean_of(input);
        const inv_std = inv_std_of(input, mean, config.eps);
        var i : usize = 0;
        while (i < input.len) {
            output[i] = gamma[i] * (input[i] - mean) * inv_std + beta[i];
            i = i + 1;
        }
    }

    fn backward(grad_output: []const f32, input: []const f32, gamma: []const f32, grad_input: []f32, grad_gamma: []f32, grad_beta: []f32, config: LayerNormConfig) -> void {
        const n = input.len as f32;
        const mean = mean_of(input);
        const inv_std = inv_std_of(input, mean, config.eps);
        var sum_dxh : f32 = 0.0;
        var sum_dxh_xh : f32 = 0.0;
        var i : usize = 0;
        while (i < input.len) {
            const x_hat = (input[i] - mean) * inv_std;
            const dx_hat = grad_output[i] * gamma[i];
            sum_dxh = sum_dxh + dx_hat;
            sum_dxh_xh = sum_dxh_xh + dx_hat * x_hat;
            grad_gamma[i] = grad_output[i] * x_hat;
            grad_beta[i] = grad_output[i];
            i = i + 1;
        }
        i = 0;
        while (i < input.len) {
            const x_hat = (input[i] - mean) * inv_std;
            grad_input[i] = inv_std * (grad_output[i] * gamma[i] - sum_dxh / n - x_hat * sum_dxh_xh / n);
            i = i + 1;
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (reference values computed by hand, backward also
    // checked by central finite differences)
    // ═══════════════════════════════════════════════════════════

    // x = (1, 2, 4), gamma = (1, 2, 0.5), beta = (0, 1, -1), eps = 1e-5,
    // grad_output = (0.5, -1, 2). which = 0: forward y0 + 10 y1 + 100 y2;
    // 1: grad_input; 2: grad_gamma; 3: grad_beta (same coding)
    fn layernorm_code(which: u32) -> f32 {
        const x : [3]f32 = [1.0, 2.0, 4.0];
        const gamma : [3]f32 = [1.0, 2.0, 0.5];
        const beta : [3]f32 = [0.0, 1.0, 0.0 - 1.0];
        const go : [3]f32 = [0.5, 0.0 - 1.0, 2.0];
        var shape : [1]u32 = [3];
        var y : [3]f32 = [0.0] ** 3;
        var gi : [3]f32 = [0.0] ** 3;
        var gg : [3]f32 = [0.0] ** 3;
        var gb : [3]f32 = [0.0] ** 3;
        const config = LayerNormConfig{ .normalized_shape = &shape, .eps = 0.00001 };
        forward(&x, &gamma, &beta, &y, config);
        backward(&go, &x, &gamma, &gi, &gg, &gb, config);
        if (which == 0) {
            return y[0] + 10.0 * y[1] + 100.0 * y[2];
        }
        if (which == 1) {
            return gi[0] + 10.0 * gi[1] + 100.0 * gi[2];
        }
        if (which == 2) {
            return gg[0] + 10.0 * gg[1] + 100.0 * gg[2];
        }
        return gb[0] + 10.0 * gb[1] + 100.0 * gb[2];
    }

    // y = (-1.0690415, 0.4654792, -0.3318490)
    test forward_applies_gamma_and_beta
        given result = layernorm_code(0)
        when expected = -29.5991535
        then @abs(result - expected) < 0.0001

    // grad_input = (0.9163189, -1.3744826, 0.4581637); the .tri formula gives 104.8578
    test backward_input_matches_finite_differences
        given result = layernorm_code(1)
        when expected = 32.9878655
        then @abs(result - expected) < 0.0001

    test backward_gamma_is_per_element
        given result = layernorm_code(2)
        when expected = 269.3984659
        then @abs(result - expected) < 0.001

    test backward_beta_is_grad_output
        given result = layernorm_code(3)
        when expected = 190.5
        then @abs(result - expected) < 0.0001

    // NOT CHECKED: normalized_shape -- the .tri formula names it, but its
    // behavior normalizes one vector of `size`; no multi-axis layout is given.
