// SPDX-License-Identifier: Apache-2.0
// t27/specs/ml/transformer/encoder_block.t27
// Transformer encoder block configuration | φ² + 1/φ² = 3 | TRINITY
// Source of truth: trinity specs/algo/encoder_block.tri. The port's
// multi_head_attention, feed_forward and forward all returned their input
// unchanged ("For now, return a simple identity transformation"), and
// their tests read default_input(), defined nowhere. Removed 2026-10-06.
// They are not restorable from the .tri:
//   - multi_head_attention defers to multi_head_attn.tri;
//   - feed_forward names W1, b1, W2, b2 and "activation" but takes none
//     of them as parameters and never says which activation;
//   - forward and the .tri's own equation disagree: the formula returns
//     LayerNorm(MHA) + LayerNorm(FFN) with no input residual, the equation
//     says y = LayerNorm(FFN(LayerNorm(MHA(x)) + x)) + x. Owner decision.
// Checked below: the two .tri constraints, the per-head width d_k, and
// that the .tri defaults satisfy them.

module EncoderBlock;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_D_MODEL : u32 = 512;
    const DEFAULT_N_HEADS : u32 = 8;
    const DEFAULT_D_FF : u32 = 2048;
    const DEFAULT_DROPOUT : f32 = 0.1;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const EncoderBlockConfig = struct {
        d_model : u32,
        n_heads : u32,
        d_ff : u32,
        dropout : f32,
        use_pre_norm : bool,
    };

    pub const AttentionOutput = struct {
        output : []f32,
        attn_weights : [][]f32,
    };

    pub const FFNOutput = struct {
        output : []f32,
    };

    pub const BlockOutput = struct {
        output : []f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // .tri multi_head_attention: d_k = d_model / n_heads
    fn head_dim(config: EncoderBlockConfig) -> u32 {
        return config.d_model / config.n_heads;
    }

    // .tri constraints: d_model % n_heads == 0, d_ff >= d_model
    // (n_heads >= 1 is implied: the modulo needs it)
    fn config_ok(config: EncoderBlockConfig) -> bool {
        return config.n_heads >= 1 and config.d_model % config.n_heads == 0 and config.d_ff >= config.d_model;
    }

    // NOT CHECKED: multi_head_attention, feed_forward, forward -- see header.

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    fn cfg(d_model: u32, n_heads: u32, d_ff: u32) -> EncoderBlockConfig {
        return EncoderBlockConfig{ .d_model = d_model, .n_heads = n_heads, .d_ff = d_ff, .dropout = DEFAULT_DROPOUT, .use_pre_norm = false };
    }

    // defaults and d_ff == d_model pass; 512 over 7 heads, d_ff below
    // d_model and 0 heads fail
    fn bounds_check() -> bool {
        return config_ok(cfg(DEFAULT_D_MODEL, DEFAULT_N_HEADS, DEFAULT_D_FF))
            and config_ok(cfg(512, 8, 512))
            and !config_ok(cfg(512, 7, 2048))
            and !config_ok(cfg(512, 8, 511))
            and !config_ok(cfg(512, 0, 2048));
    }

    test config_follows_tri_constraints
        given result = bounds_check()
        when expected = true
        then result == expected

    // 512 / 8 = 64; 768 / 12 = 64 -> coded 64 + 1000 * 64
    test head_dim_splits_model_width
        given result = head_dim(cfg(DEFAULT_D_MODEL, DEFAULT_N_HEADS, DEFAULT_D_FF)) + 1000 * head_dim(cfg(768, 12, 3072))
        when expected = 64064
        then result == expected

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (.tri constraints on the defaults)
    // ═══════════════════════════════════════════════════════════

    invariant encoder_block_defaults_meet_constraints
        assert DEFAULT_D_MODEL % DEFAULT_N_HEADS == 0 and DEFAULT_D_FF >= DEFAULT_D_MODEL
