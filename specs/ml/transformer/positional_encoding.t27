// SPDX-License-Identifier: Apache-2.0
// t27/specs/ml/transformer/positional_encoding.t27
// Sinusoidal positional encoding formula | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/algo/positional_enc.tri. The port
// used an invented frequency (1/10000 * 2^(dim/2)), had no output buffer,
// stored nothing, and both tests asserted `result != undefined`. This
// follows the .tri formula:
//   even i: PE[pos, i] = sin(pos / 10000^(i / d_model))
//   odd i:  PE[pos, i] = cos(pos / 10000^((i - 1) / d_model))
// The .tri writes "dim i in [0, d_model]"; a row has d_model slots, so
// i runs over [0, d_model). It also writes "embeddings[pos] = PE[pos]"
// for a list of positions; the only layout that fits a buffer sized to
// that list is row k for positions[k], which is what forward does.

module PositionalEnc;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_MAX_LEN : u32 = 2048;
    const BASE : f32 = 10000.0;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const PosEncConfig = struct {
        d_model : u32,
        max_len : u32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // PE[pos, i]; the angle shares one frequency across the pair (2j, 2j + 1)
    fn encoding(pos: u32, i: u32, d_model: u32) -> f32 {
        const pair = i - i % 2;
        const angle = (pos as f32) / @exp(@log(BASE) * (pair as f32) / (d_model as f32));
        if (i % 2 == 0) {
            return @sin(angle);
        }
        return @cos(angle);
    }

    // embeddings[k * d_model + i] = PE[positions[k], i]
    fn forward(positions: []const u32, embeddings: []f32, config: PosEncConfig) -> void {
        var k : usize = 0;
        while (k < positions.len) {
            var i : u32 = 0;
            while (i < config.d_model) {
                embeddings[k * (config.d_model as usize) + (i as usize)] = encoding(positions[k], i, config.d_model);
                i = i + 1;
            }
            k = k + 1;
        }
    }

    // the .tri formula ranges pos over [0, max_len)
    fn positions_ok(positions: []const u32, config: PosEncConfig) -> bool {
        var k : usize = 0;
        while (k < positions.len) {
            if (positions[k] >= config.max_len) {
                return false;
            }
            k = k + 1;
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (values worked by hand, sin/cos to 7 digits)
    // ═══════════════════════════════════════════════════════════

    // d_model 4, positions (2, 0, 1):
    //   row 0 = PE[2] = (sin 2, cos 2, sin 0.02, cos 0.02) = (0.9092974, -0.4161468, 0.0199987, 0.9998000)
    //   row 1 = PE[0] = (0, 1, 0, 1)
    //   row 2 = PE[1] = (sin 1, cos 1, sin 0.01, cos 0.01) = (0.8414710, 0.5403023, 0.0099998, 0.9999500)
    // coded sum of embeddings[k] * (k + 1) = 43.2218599
    // (odd slots with i / d_model instead of (i - 1) / d_model: 50.5626913;
    //  rows indexed by position instead of list order: 37.7585615)
    fn forward_code() -> f32 {
        const positions : [3]u32 = [2, 0, 1];
        var emb : [12]f32 = [9.0] ** 12;
        forward(&positions, &emb, PosEncConfig{ .d_model = 4, .max_len = 8 });
        var sum : f32 = 0.0;
        var k : usize = 0;
        while (k < 12) {
            sum = sum + emb[k] * ((k + 1) as f32);
            k = k + 1;
        }
        return sum;
    }

    // max_len 3: (0, 2) fits, (0, 3) does not
    fn bounds_check() -> bool {
        const fits : [2]u32 = [0, 2];
        const over : [2]u32 = [0, 3];
        const config = PosEncConfig{ .d_model = 4, .max_len = 3 };
        return positions_ok(&fits, config) and !positions_ok(&over, config);
    }

    test forward_sinusoidal_rows
        given result = forward_code()
        when expected = 43.2218599
        then @abs(result - expected) < 0.0001

    test positions_below_max_len
        given result = bounds_check()
        when expected = true
        then result == expected

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants
    // ═══════════════════════════════════════════════════════════

    invariant positional_default_max_len
        assert DEFAULT_MAX_LEN == 2048 and BASE == 10000.0

    // NOT CHECKED: the behavior sinusoidal is a prose claim.
