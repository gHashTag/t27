// SPDX-License-Identifier: Apache-2.0
// t27/specs/ml/transformer/multi_head_attn.t27
// Multi-Head Attention with φ-optimized head dimensions | φ² + 1/φ² = 3 | TRINITY

module MultiHeadAttention;
    use base::types;
    use math::constants;
    use math::statistics;
    use numeric::gf16;
use numeric::gf16::GF16;
    use ml::transformer::positional_enc;
    use ml::transformer::norm;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const PHI : gf16::GF16 = 1.618033988749895;
    const INV_PHI : gf16::GF16 = 1.0 / PHI;
    const PHI_SQUARED : gf16::GF16 = PHI * PHI;
    const DEFAULT_DROPOUT : gf16::GF16 = 0.1;
    const DEFAULT_SCALE : gf16::GF16 = 1.0 / sqrt(PHI); // φ-optimized scaling
    const PHI_HEAD_DIM_DIVISOR : u32 = 8; // Head dim must be divisible by 8 for φ-optimization

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const MHAConfig = struct {
        hidden_size : u32,          // d_model: total hidden dimension
        num_heads : u32,            // h: number of attention heads
        head_dim : u32,             // d_k = d_v: dimension per head (hidden_size / num_heads)
        dropout : gf16::GF16,       // Dropout probability
        use_flash_attention : bool, // Use Flash Attention algorithm
        use_rope : bool,            // Apply Rotary Position Embedding
        use_phi_scaling : bool,     // Use φ-optimized attention scaling
        causal : bool,              // Causal mask (for decoder)
    };

    pub const MHAState = struct {
        w_q : []gf16::GF16,          // Query projection weights: [hidden_size, hidden_size]
        w_k : []gf16::GF16,          // Key projection weights: [hidden_size, hidden_size]
        w_v : []gf16::GF16,          // Value projection weights: [hidden_size, hidden_size]
        w_o : []gf16::GF16,          // Output projection weights: [hidden_size, hidden_size]
        b_q : []gf16::GF16,          // Query bias: [hidden_size]
        b_k : []gf16::GF16,          // Key bias: [hidden_size]
        b_v : []gf16::GF16,          // Value bias: [hidden_size]
        b_o : []gf16::GF16,          // Output bias: [hidden_size]
        rope_state : RoPEState,      // RoPE state (if use_rope)
        norm_state : NormState,      // LayerNorm state (for Pre-LN)
        is_training : bool,          // Training/inference mode
    };

    pub const AttentionMask = struct {
        mask : []gf16::GF16,         // Attention mask values
        shape : [2]u32,              // [seq_len, seq_len] or [batch, seq_len, seq_len]
        is_causal : bool,            // Causal mask flag
    };

    pub const MHAForwardResult = struct {
        output : []gf16::GF16,       // Attention output: [batch, seq_len, hidden_size]
        attention_weights : []gf16::GF16, // Attention scores: [batch, num_heads, seq_len, seq_len]
        dropout_mask : []gf16::GF16,      // Applied dropout mask
    };

    pub const MHAGradients = struct {
        d_w_q : []gf16::GF16,         // Gradient wrt w_q
        d_w_k : []gf16::GF16,         // Gradient wrt w_k
        d_w_v : []gf16::GF16,         // Gradient wrt w_v
        d_w_o : []gf16::GF16,         // Gradient wrt w_o
        d_b_q : []gf16::GF16,         // Gradient wrt b_q
        d_b_k : []gf16::GF16,         // Gradient wrt b_k
        d_b_v : []gf16::GF16,         // Gradient wrt b_v
        d_b_o : []gf16::GF16,         // Gradient wrt b_o
        d_input : []gf16::GF16,      // Gradient wrt input
    };

    pub const FlashAttentionState = struct {
        q_tile : []gf16::GF16,       // Tiled Q for Flash Attention
        k_tile : []gf16::GF16,       // Tiled K for Flash Attention
        v_tile : []gf16::GF16,       // Tiled V for Flash Attention
        o_tile : []gf16::GF16,       // Output tile
        l_tile : []gf16::GF16,       // Logsumexp for each query
        m_tile : []gf16::GF16,       // Max for each query
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(config: MHAConfig) → MHAState
    // Initializes MHA with φ-optimized weight distribution.
    fn init(config: MHAConfig) -> MHAState {
        let head_dim = config.hidden_size / config.num_heads;
        let weights_size = config.hidden_size * config.hidden_size;
        let bias_size = config.hidden_size;
        
        let w_q = zeros(weights_size);
        let w_k = zeros(weights_size);
        let w_v = zeros(weights_size);
        let w_o = zeros(weights_size);
        
        let b_q = zeros(bias_size);
        let b_k = zeros(bias_size);
        let b_v = zeros(bias_size);
        let b_o = zeros(bias_size);
        
        let rope_state = if config.use_rope {
            RoPEState{.head_dim = head_dim}
        } else {
            RoPEState{.head_dim = 0}
        };
        
        let norm_state = NormState{.hidden_size = config.hidden_size};
        
        return MHAState{
            .w_q = w_q,
            .w_k = w_k,
            .w_v = w_v,
            .w_o = w_o,
            .b_q = b_q,
            .b_k = b_k,
            .b_v = b_v,
            .b_o = b_o,
            .rope_state = rope_state,
            .norm_state = norm_state,
            .is_training = true,
        };
    }

    test init_creates_valid_rope_state
        given config = MHAConfig{.hidden_size = 128, .num_heads = 8, .use_rope = true}
        when state = init(config)
        then state.rope_state.head_dim == 16

    test init_creates_zero_norm_state
        given config = MHAConfig{.hidden_size = 64, .num_heads = 4}
        when state = init(config)
        then state.norm_state.hidden_size == 64

    // forward(state: MHAState, input: []gf16::GF16, mask: AttentionMask) → MHAForwardResult
    // Computes multi-head attention forward pass.
    fn forward(state: MHAState, input: []gf16::GF16, mask: AttentionMask) -> MHAForwardResult {
        // 1. Pre-LN (if enabled): x = LayerNorm(input)
        let x = if state.norm_state.hidden_size > 0 {
            norm::layer_norm(input, state.norm_state)
        } else {
            input
        };
        
        // 2. Project: Q = x @ W_q, K = x @ W_k, V = x @ W_v
        let q = matmul(x, state.w_q) + state.b_q;
        let k = matmul(x, state.w_k) + state.b_k;
        let v = matmul(x, state.w_v) + state.b_v;
        
        // 3. Reshape: Q,K,V → [batch, heads, seq_len, head_dim]
        let batch_size = 1; // Simplified for now
        let seq_len = x.len / state.norm_state.hidden_size;
        let head_dim = state.norm_state.hidden_size / 8; // num_heads = 8 for simplicity
        
        let q_reshaped = split_heads(q, 8, head_dim);
        let k_reshaped = split_heads(k, 8, head_dim);
        let v_reshaped = split_heads(v, 8, head_dim);
        
        // 4. Apply RoPE (if use_rope): Q, K = RoPE(Q, K, positions)
        let q_final = if state.rope_state.head_dim > 0 {
            q_reshaped // Simplified - would need RoPE implementation
        } else {
            q_reshaped
        };
        
        let k_final = if state.rope_state.head_dim > 0 {
            k_reshaped // Simplified - would need RoPE implementation
        } else {
            k_reshaped
        };
        
        // 5. Scale: Q = Q / sqrt(d_k) or Q * scale if use_phi_scaling
        let scale = compute_phi_scale(head_dim);
        let q_scaled = scale_array(q_final, scale);
        
        // 6. Attention: A = softmax(Q @ K.T + mask)
        let attention_scores = compute_attention_scores(q_scaled, k_final, GF16(1.0));
        let masked_scores = apply_attention_mask(attention_scores, mask);
        let attention_weights = softmax_attention(masked_scores, 3); // Over last dimension
        
        // 7. Dropout (if training): A = dropout(A)
        let dropout_mask = if state.is_training {
            create_dropout_mask(attention_weights.len, 0.1)
        } else {
            ones(attention_weights.len)
        };
        let attention_weights_dropout = multiply_arrays(attention_weights, dropout_mask);
        
        // 8. Output: O = A @ V
        let o = matmul_attention(attention_weights_dropout, v_reshaped);
        
        // 9. Reshape: O → [batch, seq_len, hidden_size]
        let o_reshaped = merge_heads(o, 8, head_dim);
        
        // 10. Project: O = O @ W_o
        let output = matmul(o_reshaped, state.w_o) + state.b_o;
        
        // 11. Residual (if Pre-LN): O = O + input
        let final_output = if state.norm_state.hidden_size > 0 {
            output // Simplified - no residual for now
        } else {
            output
        };
        
        return MHAForwardResult{
            .output = final_output,
            .attention_weights = attention_weights_dropout,
            .dropout_mask = dropout_mask,
        };
    }

    test forward_output_matches_input_shape
        given config = MHAConfig{.hidden_size = 64, .num_heads = 4}
        and   state = init(config)
        and   input = random_input(64)
        and   mask = create_causal_mask(1)
        when result = forward(state, input, mask)
        then result.output.len == input.len

    test forward_produces_valid_attention_weights
        given config = MHAConfig{.hidden_size = 32, .num_heads = 4}
        and   state = init(config)
        and   input = random_input(32)
        and   mask = create_causal_mask(1)
        when result = forward(state, input, mask)
        then result.attention_weights.len > 0
        and   all(result.attention_weights, fn(x) x >= 0.0)

    // flash_attention_forward(state: MHAState, input: []gf16::GF16, mask: AttentionMask) → MHAForwardResult
    // Flash Attention algorithm: O(N²) → O(N) memory.
    fn flash_attention_forward(state: MHAState, input: []gf16::GF16, mask: AttentionMask) -> MHAForwardResult {
        let hidden_size = state.norm_state.hidden_size;
        let seq_len = input.len / hidden_size;
        let head_dim = hidden_size / 8; // num_heads = 8
        
        // Simplified flash attention implementation
        // In practice, this would use tiling and avoid materializing full attention matrix
        let q = matmul(input, state.w_q) + state.b_q;
        let k = matmul(input, state.w_k) + state.b_k;
        let v = matmul(input, state.w_v) + state.b_v;
        
        let q_reshaped = split_heads(q, 8, head_dim);
        let k_reshaped = split_heads(k, 8, head_dim);
        let v_reshaped = split_heads(v, 8, head_dim);
        
        // Compute attention scores using flash attention principles
        let attention_scores = compute_attention_scores(q_reshaped, k_reshaped, GF16(1.0));
        let masked_scores = apply_attention_mask(attention_scores, mask);
        let attention_weights = softmax_attention(masked_scores, 3);
        
        // Flash attention output (simplified - would use tiling in full implementation)
        let o = matmul_attention(attention_weights, v_reshaped);
        let o_reshaped = merge_heads(o, 8, head_dim);
        let output = matmul(o_reshaped, state.w_o) + state.b_o;
        
        return MHAForwardResult{
            .output = output,
            .attention_weights = [], // Flash attention doesn't store full matrix
            .dropout_mask = ones(output.len),
        };
    }

    test flash_attention_output_shape_correct
        given config = MHAConfig{.hidden_size = 64, .num_heads = 4, .use_flash_attention = true}
        and   state = init(config)
        and   input = random_input(64)
        and   mask = create_causal_mask(1)
        when result = flash_attention_forward(state, input, mask)
        then result.output.len == input.len
        and   result.attention_weights.len == 0 // No full matrix storage

    // compute_attention_scores(q: []gf16::GF16, k: []gf16::GF16, scale: gf16::GF16) → []gf16::GF16
    // Computes scaled dot-product attention scores.
    fn compute_attention_scores(q: []gf16::GF16, k: []gf16::GF16, scale: gf16::GF16) -> []gf16::GF16 {
        let q_seq_len = q.len / 8; // Assuming 8 head_dim for simplicity
        let k_seq_len = k.len / 8; // Assuming 8 head_dim for simplicity
        let scores_len = q_seq_len * k_seq_len;
        let scores = zeros(scores_len);
        
        // Compute q @ k.T
        for i in 0..q_seq_len {
            for j in 0..k_seq_len {
                let dot_product = GF16(0.0);
                for d in 0..8 {
                    dot_product = dot_product + q[i * 8 + d] * k[j * 8 + d];
                }
                scores[i * k_seq_len + j] = dot_product * scale;
            }
        }
        
        return scores;
    }

    test compute_attention_scores_shape_matches
        given q = [GF16(1.0), GF16(2.0), GF16(3.0), GF16(4.0), GF16(1.0), GF16(2.0), GF16(3.0), GF16(4.0)] // 2 seq, 8 dim
        and   k = [GF16(0.5), GF16(1.0), GF16(1.5), GF16(2.0), GF16(0.5), GF16(1.0), GF16(1.5), GF16(2.0)] // 2 seq, 8 dim
        and   scale = GF16(0.125)
        when result = compute_attention_scores(q, k, scale)
        then result.len == 4 // 2x2 matrix

    test compute_attention_scores_applies_scale
        given q = [GF16(1.0), GF16(0.0), GF16(0.0), GF16(0.0)] // 1 seq, 4 dim
        and   k = [GF16(2.0), GF16(0.0), GF16(0.0), GF16(0.0)] // 1 seq, 4 dim
        and   scale = GF16(0.5)
        when result = compute_attention_scores(q, k, scale)
        then result[0] == GF16(1.0) // 2.0 * 0.5 = 1.0

    // apply_causal_mask(scores: []gf16::GF16, seq_len: u32) → []gf16::GF16
    // Applies causal (autoregressive) mask to attention scores.
    fn apply_causal_mask(scores: []gf16::GF16, seq_len: u32) -> []gf16::GF16 {
        let result = scores; // Copy the scores
        let matrix_size = seq_len * seq_len;
        
        for i in 0..seq_len {
            for j in 0..seq_len {
                if j > i {
                    result[i * seq_len + j] = GF16(-1e9); // Negative infinity
                }
            }
        }
        
        return result;
    }

    test apply_causal_mask_blocks_future_tokens
        given seq_len = 3
        and   scores = [GF16(1.0), GF16(2.0), GF16(3.0), 
                       GF16(4.0), GF16(5.0), GF16(6.0), 
                       GF16(7.0), GF16(8.0), GF16(9.0)]
        when result = apply_causal_mask(scores, seq_len)
        then result[0] == GF16(1.0)   // (0,0): can attend
        and   result[1] == GF16(2.0)   // (0,1): can attend
        and   result[2] == GF16(-1e9)  // (0,2): cannot attend
        and   result[3] == GF16(4.0)   // (1,0): can attend
        and   result[4] == GF16(5.0)   // (1,1): can attend
        and   result[5] == GF16(-1e9)  // (1,2): cannot attend
        and   result[6] == GF16(7.0)   // (2,0): can attend
        and   result[7] == GF16(8.0)   // (2,1): can attend
        and   result[8] == GF16(9.0)   // (2,2): can attend

    // apply_attention_mask(scores: []gf16::GF16, mask: AttentionMask) → []gf16::GF16
    // Applies custom attention mask.
    fn apply_attention_mask(scores: []gf16::GF16, mask: AttentionMask) -> []gf16::GF16 {
        let result = scores; // Copy the scores
        
        // Apply the mask by adding it to the scores
        // The mask contains -inf for positions that should be masked
        for i in 0..scores.len {
            result[i] = result[i] + mask.mask[i];
        }
        
        return result;
    }

    test apply_attention_mask_adds_mask_values
        given scores = [GF16(1.0), GF16(2.0), GF16(3.0), GF16(4.0)]
        and   mask = AttentionMask{.mask = [GF16(0.0), GF16(-1e9), GF16(0.0), GF16(-1e9)], .shape = [2, 2], .is_causal = false}
        when result = apply_attention_mask(scores, mask)
        then result[0] == GF16(1.0)   // 1.0 + 0.0 = 1.0
        and   result[1] == GF16(-1e9) // 2.0 + (-1e9) = -1e9 (masked)
        and   result[2] == GF16(3.0)   // 3.0 + 0.0 = 3.0
        and   result[3] == GF16(-1e9) // 4.0 + (-1e9) = -1e9 (masked)

    // softmax_attention(scores: []gf16::GF16, dim: u32) → []gf16::GF16
    // Computes softmax over specified dimension.
    fn softmax_attention(scores: []gf16::GF16, dim: u32) -> []gf16::GF16 {
        // For simplicity, implement softmax over the entire array (dim=0)
        // In a full implementation, this would handle different dimensions
        let max_score = GF16(-1e9);
        for i in 0..scores.len {
            if scores[i] > max_score {
                max_score = scores[i];
            }
        }
        
        let exp_scores = zeros(scores.len);
        let sum_exp = GF16(0.0);
        
        for i in 0..scores.len {
            exp_scores[i] = exp(scores[i] - max_score);
            sum_exp = sum_exp + exp_scores[i];
        }
        
        let softmax = zeros(scores.len);
        for i in 0..scores.len {
            softmax[i] = exp_scores[i] / sum_exp;
        }
        
        return softmax;
    }

    test softmax_sums_to_one
        given scores = [GF16(1.0), GF16(2.0), GF16(3.0)]
        when result = softmax_attention(scores, 0)
        then approximately_equal(sum(result), GF16(1.0), GF16(1e-4))

    test softmax_attends_to_max
        given scores = [GF16(1.0), GF16(2.0), GF16(3.0)]
        when result = softmax_attention(scores, 0)
        then result[2] > result[1]  // Highest score should have highest probability
        and   result[2] > result[0]  // Highest score should have highest probability

    // backward(state: MHAState, result: MHAForwardResult, grad_output: []gf16::GF16) → MHAGradients
    // Computes gradients for backpropagation.
    fn backward(state: MHAState, result: MHAForwardResult, grad_output: []gf16::GF16) -> MHAGradients {
        let hidden_size = state.norm_state.hidden_size;
        let weights_size = hidden_size * hidden_size;
        let bias_size = hidden_size;
        
        // d_O = grad_output
        let d_output = grad_output;
        
        // d_w_o = O.T @ d_O (simplified)
        let d_w_o = zeros(weights_size);
        let d_b_o = zeros(bias_size);
        
        // Simplified gradient computation
        // In a full implementation, this would properly compute gradients through attention
        let d_attention_weights = zeros(result.attention_weights.len);
        let d_q = zeros(hidden_size);
        let d_k = zeros(hidden_size);
        let d_v = zeros(hidden_size);
        
        // d_input = d_Q @ W_q.T + d_K @ W_k.T + d_V @ W_v.T + d_O @ W_o.T
        let d_input = zeros(hidden_size);
        
        return MHAGradients{
            .d_w_q = zeros(weights_size),
            .d_w_k = zeros(weights_size),
            .d_w_v = zeros(weights_size),
            .d_w_o = d_w_o,
            .d_b_q = zeros(bias_size),
            .d_b_k = zeros(bias_size),
            .d_b_v = zeros(bias_size),
            .d_b_o = d_b_o,
            .d_input = d_input,
        };
    }

    test backward_gradients_have_correct_shapes
        given config = MHAConfig{.hidden_size = 64, .num_heads = 4}
        and   state = init(config)
        and   input = random_input(64)
        and   mask = create_causal_mask(1)
        and   forward_result = forward(state, input, mask)
        and   grad_output = random_input(64)
        when grads = backward(state, forward_result, grad_output)
        then grads.d_w_q.len == state.w_q.len
        and   grads.d_w_k.len == state.w_k.len
        and   grads.d_w_v.len == state.w_v.len
        and   grads.d_w_o.len == state.w_o.len
        and   grads.d_b_q.len == state.b_q.len
        and   grads.d_b_k.len == state.b_k.len
        and   grads.d_b_v.len == state.b_v.len
        and   grads.d_b_o.len == state.b_o.len
        and   grads.d_input.len == input.len

    // compute_phi_scale(head_dim: u32) → gf16::GF16
    // Computes φ-optimized attention scaling factor.
    fn compute_phi_scale(head_dim: u32) -> gf16::GF16 {
        // Standard: 1.0 / sqrt(head_dim)
        // φ-optimized: 1.0 / (sqrt(head_dim) * PHI)
        return GF16(1.0 / (sqrt(head_dim as f32) * PHI));
    }

    // merge_heads(attention: []gf16::GF16, num_heads: u32, head_dim: u32) → []gf16::GF16
    // Merges multi-head outputs back to hidden dimension.
    fn merge_heads(attention: []gf16::GF16, num_heads: u32, head_dim: u32) -> []gf16::GF16 {
        let batch_size = attention.len / (num_heads * head_dim);
        let seq_len = attention.len / (batch_size * num_heads);
        let hidden_size = num_heads * head_dim;
        let result = zeros(batch_size * seq_len * hidden_size);
        
        for b in 0..batch_size {
            for s in 0..seq_len {
                for h in 0..num_heads {
                    for d in 0..head_dim {
                        let src_idx = b * (num_heads * seq_len * head_dim) + h * (seq_len * head_dim) + s * head_dim + d;
                        let dst_idx = b * (seq_len * hidden_size) + s * hidden_size + h * head_dim + d;
                        result[dst_idx] = attention[src_idx];
                    }
                }
            }
        }
        
        return result;
    }

    test merge_heads_correct_reshaping
        given attention = [GF16(1.0), GF16(2.0), GF16(3.0), GF16(4.0),  // head 0
                          GF16(5.0), GF16(6.0), GF16(7.0), GF16(8.0)]  // head 1
        and   num_heads = 2
        and   head_dim = 4
        when result = merge_heads(attention, num_heads, head_dim)
        then result.len == 8  // batch=1, seq=1, hidden=8

    // split_heads(x: []gf16::GF16, num_heads: u32, head_dim: u32) → []gf16::GF16
    // Splits hidden dimension into multiple attention heads.
    fn split_heads(x: []gf16::GF16, num_heads: u32, head_dim: u32) -> []gf16::GF16 {
        let batch_size = 1; // Simplified for now
        let seq_len = x.len / (batch_size * num_heads * head_dim);
        let result = zeros(batch_size * num_heads * seq_len * head_dim);
        
        for b in 0..batch_size {
            for s in 0..seq_len {
                for h in 0..num_heads {
                    for d in 0..head_dim {
                        let src_idx = b * (seq_len * num_heads * head_dim) + s * (num_heads * head_dim) + h * head_dim + d;
                        let dst_idx = b * (num_heads * seq_len * head_dim) + h * (seq_len * head_dim) + s * head_dim + d;
                        result[dst_idx] = x[src_idx];
                    }
                }
            }
        }
        
        return result;
    }

    test split_heads_correct_reshaping
        given x = [GF16(1.0), GF16(2.0), GF16(3.0), GF16(4.0), GF16(5.0), GF16(6.0), GF16(7.0), GF16(8.0)]  // 1 seq, 8 hidden
        and   num_heads = 2
        and   head_dim = 4
        when result = split_heads(x, num_heads, head_dim)
        then result.len == 8  // batch=1, heads=2, seq=1, head_dim=4

    // create_causal_mask(seq_len: u32) → AttentionMask
    // Creates a causal (lower-triangular) mask.
    fn create_causal_mask(seq_len: u32) -> AttentionMask {
        let mask_size = seq_len * seq_len;
        let mask_values = zeros(mask_size);
        
        for i in 0..seq_len {
            for j in 0..seq_len {
                if j > i {
                    mask_values[i * seq_len + j] = GF16(-1e9); // Negative infinity for future tokens
                } else {
                    mask_values[i * seq_len + j] = GF16(0.0); // Allow attending to current and past tokens
                }
            }
        }
        
        return AttentionMask{
            .mask = mask_values,
            .shape = [seq_len, seq_len],
            .is_causal = true,
        };
    }

    test create_causal_mask_blocks_future_tokens
        given seq_len = 3
        when mask = create_causal_mask(seq_len)
        then mask.mask[0] == GF16(0.0)    // (0,0): can attend
        and   mask.mask[1] == GF16(0.0)    // (0,1): can attend  
        and   mask.mask[2] == GF16(-1e9)   // (0,2): cannot attend
        and   mask.mask[3] == GF16(0.0)    // (1,0): can attend
        and   mask.mask[4] == GF16(0.0)    // (1,1): can attend
        and   mask.mask[5] == GF16(-1e9)   // (1,2): cannot attend
        and   mask.mask[6] == GF16(0.0)    // (2,0): can attend
        and   mask.mask[7] == GF16(0.0)    // (2,1): can attend
        and   mask.mask[8] == GF16(0.0)    // (2,2): can attend

    // get_head_dim(config: MHAConfig) → u32
    // Returns dimension per attention head.
    fn get_head_dim(config: MHAConfig) -> u32 {
        return config.hidden_size / config.num_heads;
    }

    test get_head_dim_divides_evenly
        given config = MHAConfig{.hidden_size = 128, .num_heads = 8}
        when result = get_head_dim(config)
        then result == 16
        and   config.hidden_size % config.num_heads == 0

    // get_parameter_count(config: MHAConfig) → u64
    // Returns total number of trainable parameters.
    fn get_parameter_count(config: MHAConfig) -> u64 {
        let weight_params = 4 * (config.hidden_size * config.hidden_size); // W_q, W_k, W_v, W_o
        let bias_params = if true { // Assuming bias is used
            4 * config.hidden_size // b_q, b_k, b_v, b_o
        } else {
            0
        };
        return weight_params + bias_params;
    }

    test get_parameter_count_correct
        given config = MHAConfig{.hidden_size = 128, .num_heads = 8, .dropout = 0.1, .use_flash_attention = false, .use_rope = false, .use_phi_scaling = false, .causal = false}
        when result = get_parameter_count(config)
        then result == 4 * 128 * 128 + 4 * 128 // Weights + biases

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    test init_creates_correct_weight_dimensions
        given config = MHAConfig{.hidden_size = 128, .num_heads = 8, .dropout = 0.1, .use_flash_attention = false, .use_rope = false, .use_phi_scaling = false, .causal = false}
        when state = init(config)
        then state.w_q.len == 128 * 128
        and   state.w_k.len == 128 * 128
        and   state.w_v.len == 128 * 128
        and   state.w_o.len == 128 * 128

    test init_with_bias_creates_bias_vectors
        given config = MHAConfig{.hidden_size = 128, .num_heads = 8, .dropout = 0.1}
        and   state = init(config)
        then state.b_q.len == 128
        and   state.b_k.len == 128
        and   state.b_v.len == 128
        and   state.b_o.len == 128

    test get_head_dim_divides_evenly
        given config = MHAConfig{.hidden_size = 128, .num_heads = 8}
        when result = get_head_dim(config)
        then result == 16
        and   config.hidden_size % config.num_heads == 0

    test get_parameter_count_correct
        given config = MHAConfig{.hidden_size = 128, .num_heads = 8, .dropout = 0.1, .use_flash_attention = false, .use_rope = false, .use_phi_scaling = false, .causal = false}
        when result = get_parameter_count(config)
        then result == 4 * 128 * 128 + 4 * 128 // Weights + biases

    test forward_output_shape_matches_input
        given config = MHAConfig{.hidden_size = 64, .num_heads = 4}
        and   state = init(config)
        and   input = random_input(64)
        and   mask = create_causal_mask(1)
        when result = forward(state, input, mask)
        then result.output.len == 64

    test split_heads_correct_reshaping
        given input = random_input(96)  // 3 tokens, 32 hidden
        when result = split_heads(input, 4, 8) // 4 heads, 8 dim each
        then result.len == 96

    test merge_heads_reverses_split
        given input = random_input(96)
        and   split_result = split_heads(input, 4, 8)
        when merged = merge_heads(split_result, 4, 8)
        then merged.len == input.len

    test compute_attention_scores_returns_correct_shape
        given q = random_input(4 * 8)   // 4 queries, 8 dim
        and   k = random_input(6 * 8)   // 6 keys, 8 dim
        and   scale = 0.125           // 1/sqrt(64)
        when result = compute_attention_scores(q, k, scale)
        then result.len == 4 * 6

    test apply_causal_mask_blocks_future
        given seq_len = 4
        and   scores = [1.0] * 16       // 4x4 matrix of ones
        when result = apply_causal_mask(scores, seq_len)
        then result[0] == 1.0           // (0,0): can attend
        and   result[1] == 1.0           // (0,1): can attend
        and   result[4] == 1.0           // (1,0): can attend
        and   result[7] == -inf          // (1,3): cannot attend

    test softmax_sums_to_one
        given scores = [1.0, 2.0, 3.0]
        when result = softmax_attention(scores, 0)
        then approximately_equal(sum(result), 1.0, 1e-4)

    test phi_scale_smaller_than_standard
        given head_dim = 64
        when standard_scale = 1.0 / sqrt(head_dim as gf16::GF16)
        and   phi_scale = compute_phi_scale(head_dim)
        then phi_scale < standard_scale

    test compute_phi_scale_formula
        given head_dim = 64
        when result = compute_phi_scale(head_dim)
        and   expected = 1.0 / (sqrt(64.0) * PHI)
        then approximately_equal(result, expected, 1e-6)

    test flash_attention_no_memory_explosion
        given config = MHAConfig{.hidden_size = 128, .num_heads = 8, .use_flash_attention = true}
        and   state = init(config)
        and   input = random_input(128)
        and   mask = create_causal_mask(1)
        when result = flash_attention_forward(state, input, mask)
        then result.output.len == 128
        and   result.attention_weights.len == 0 // Flash doesn't store full matrix

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants
    // ═══════════════════════════════════════════════════════════

    invariant head_dim_divisible_by_phi
        given config = any_mha_config()
        when head_dim = get_head_dim(config)
        then head_dim % PHI_HEAD_DIM_DIVISOR == 0

    invariant forward_preserves_batch_sequence_shape
        given config = any_mha_config()
        and   state = init(config)
        and   input = random_input(config.hidden_size)
        and   mask = create_causal_mask(1)
        when result = forward(state, input, mask)
        then result.output.len == input.len

    invariant attention_weights_probabilities
        given config = any_mha_config()
        and   state = init(config)
        and   input = random_input(config.hidden_size)
        and   mask = create_causal_mask(1)
        and   result = forward(state, input, mask)
        then all(result.attention_weights, fn(x) x >= 0.0 and x <= 1.0)

    invariant causal_mask_prevents_future_attention
        given seq_len = 10
        and   mask = create_causal_mask(seq_len)
        when mask_matrix = mask.mask
        then for i in 0..seq_len-1:
            for j in i+1..seq_len-1:
                mask_matrix[i*seq_len + j] == -inf

    invariant phi_scale_positive
        given head_dim = positive_u32()
        when scale = compute_phi_scale(head_dim)
        then scale > 0.0

    invariant parameter_count_quartic_in_hidden_size
        given config = any_mha_config()
        when params = get_parameter_count(config)
        // params ≈ 4 * hidden_size^2
        and   params > config.hidden_size * config.hidden_