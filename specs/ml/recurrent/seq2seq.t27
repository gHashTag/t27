// SPDX-License-Identifier: Apache-2.0
// t27/specs/ml/recurrent/seq2seq.t27
// Encoder-decoder sequence-to-sequence | φ² + 1/φ² = 3 | TRINITY
// Source of truth: trinity specs/algo/seq2seq.tri. Its encode formula is
// one comment ("encoder_hidden, encoder_context = encoder(input_seq)") and
// its decode formula calls decoder_step and output_projection, none of
// which the .tri defines. The bodies the port carried (each token adding
// token * 0.01 to every hidden unit, logits = context + hidden + token *
// 0.01) appear nowhere in the .tri; they were invented and never checked
// (the tests read default_input(), defined nowhere). Removed 2026-10-06.
// What the .tri does define -- the types and the three constraints -- is
// checked below.

module Seq2seq;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Seq2SeqConfig = struct {
        vocab_size : u32,
        d_model : u32,
        hidden_size : u32,
    };

    pub const Seq2SeqState = struct {
        encoder_hidden : []f32,
        encoder_context : []f32,
        decoder_hidden : []f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // .tri constraints: vocab_size > 0, d_model > 0, hidden_size > 0
    fn config_ok(config: Seq2SeqConfig) -> bool {
        return config.vocab_size > 0 and config.d_model > 0 and config.hidden_size > 0;
    }

    // NOT CHECKED: encode and decode -- the .tri names encoder, decoder_step
    // and output_projection without defining them, so there is no formula
    // to restore. Restore from a .tri that defines them, not by invention.

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    // all positive passes; zeroing any one field fails
    fn bounds_check() -> bool {
        const good = Seq2SeqConfig{ .vocab_size = 32000, .d_model = 512, .hidden_size = 512 };
        const no_vocab = Seq2SeqConfig{ .vocab_size = 0, .d_model = 512, .hidden_size = 512 };
        const no_model = Seq2SeqConfig{ .vocab_size = 32000, .d_model = 0, .hidden_size = 512 };
        const no_hidden = Seq2SeqConfig{ .vocab_size = 32000, .d_model = 512, .hidden_size = 0 };
        return config_ok(good) and !config_ok(no_vocab) and !config_ok(no_model) and !config_ok(no_hidden);
    }

    test config_follows_tri_constraints
        given result = bounds_check()
        when expected = true
        then result == expected

    // NOT CHECKED: the .tri predictions (alignment learned, teacher forcing
    // speeds training, beam search helps) are empirical claims about
    // training, not properties of this spec.
