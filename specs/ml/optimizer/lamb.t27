// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// LAMB parameter update with trust ratio clipping | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/algo/lamb.tri. The port was
// Python-like (`let`, `append`, `range`, growable arrays) and FALSE where it
// could be read: v_hat was divided by the beta1 correction, the trust
// ratio was |grads| / |v_hat| instead of |w| / |m_hat / (sqrt v_hat + eps)|,
// and it clipped the gradients instead of the ratio.
//
// NOT CHECKED: the update step itself. The .tri contradicts itself: its
// formula applies lr * trust * (grads + weight_decay * params), while its
// lamb_update equation (and You et al. 2020) applies
// lr * min(r, clip) * m_hat / (sqrt(v_hat) + eps). Until the source picks
// one, this spec states only the parts both agree on.

module Lamb;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_LR : f32 = 0.001;
    const DEFAULT_BETA1 : f32 = 0.9;
    const DEFAULT_BETA2 : f32 = 0.999;
    const DEFAULT_EPSILON : f32 = 0.000001;
    const DEFAULT_CLIP_THRESHOLD : f32 = 10.0;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const LAMBConfig = struct {
        learning_rate : f32,
        beta1 : f32,
        beta2 : f32,
        epsilon : f32,
        weight_decay : f32,
        clip_threshold : f32,
    };

    pub const LAMBState = struct {
        m : []f32,
        v : []f32,
        step : u32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // .tri init_state: m = v = 0 (step = 0 is the caller's field)
    fn init_moments(m: []f32, v: []f32) -> void {
        var i : usize = 0;
        while (i < m.len) {
            m[i] = 0.0;
            v[i] = 0.0;
            i = i + 1;
        }
    }

    // m = beta1 m + (1 - beta1) g;  v = beta2 v + (1 - beta2) g^2
    fn moments_step(grads: []const f32, m: []f32, v: []f32, config: LAMBConfig) -> void {
        var i : usize = 0;
        while (i < grads.len) {
            m[i] = config.beta1 * m[i] + (1.0 - config.beta1) * grads[i];
            v[i] = config.beta2 * v[i] + (1.0 - config.beta2) * grads[i] * grads[i];
            i = i + 1;
        }
    }

    // 1 - beta^step
    fn bias_correction(beta: f32, step: u32) -> f32 {
        var p : f32 = 1.0;
        var k : u32 = 0;
        while (k < step) {
            p = p * beta;
            k = k + 1;
        }
        return 1.0 - p;
    }

    // r = min(|w| / |m_hat / (sqrt(v_hat) + eps)|, clip_threshold) with
    // m_hat = m / (1 - beta1^step), v_hat = v / (1 - beta2^step).
    // m and v are the moments AFTER moments_step for this step.
    fn trust_ratio(params: []const f32, m: []const f32, v: []const f32, step: u32, config: LAMBConfig) -> f32 {
        const bc1 = bias_correction(config.beta1, step);
        const bc2 = bias_correction(config.beta2, step);
        var w_sq : f32 = 0.0;
        var u_sq : f32 = 0.0;
        var i : usize = 0;
        while (i < params.len) {
            const u = (m[i] / bc1) / (@sqrt(v[i] / bc2) + config.epsilon);
            w_sq = w_sq + params[i] * params[i];
            u_sq = u_sq + u * u;
            i = i + 1;
        }
        const r = @sqrt(w_sq) / @sqrt(u_sq);
        if (r > config.clip_threshold) {
            return config.clip_threshold;
        }
        return r;
    }

    // .tri constraints: 0 < beta1 < 1, 0 < beta2 < 1, epsilon > 0,
    // clip_threshold > 0
    fn config_ok(config: LAMBConfig) -> bool {
        const b1 = config.beta1 > 0.0 and config.beta1 < 1.0;
        const b2 = config.beta2 > 0.0 and config.beta2 < 1.0;
        return b1 and b2 and config.epsilon > 0.0 and config.clip_threshold > 0.0;
    }

    fn default_config(clip: f32) -> LAMBConfig {
        return LAMBConfig{ .learning_rate = DEFAULT_LR, .beta1 = DEFAULT_BETA1, .beta2 = DEFAULT_BETA2, .epsilon = DEFAULT_EPSILON, .weight_decay = 0.01, .clip_threshold = clip };
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (values worked by hand)
    // ═══════════════════════════════════════════════════════════

    // m = (0.5, 0), v = (0.25, 0), g = (1, -2):
    // m' = (0.55, -0.2), v' = (0.25075, 0.004)
    fn moments_code(index: usize) -> f32 {
        const g : [2]f32 = [1.0, -2.0];
        var m : [2]f32 = [0.5, 0.0];
        var v : [2]f32 = [0.25, 0.0];
        moments_step(&g, &m, &v, default_config(DEFAULT_CLIP_THRESHOLD));
        if (index == 0) {
            return 10.0 * m[0] + m[1];
        }
        return 1000.0 * v[0] + v[1];
    }

    // w = (3, 4), |w| = 5; g = (1, -2) from zero moments at step 1:
    // m_hat = g, v_hat = g^2, so the Adam ratio is about (1, -1) and
    // r = 5 / sqrt 2 = 3.5355366 (eps 1e-6 included). Dividing v by the
    // beta1 correction (the old port) gives 0.35355604.
    fn trust_code(clip: f32) -> f32 {
        const w : [2]f32 = [3.0, 4.0];
        const g : [2]f32 = [1.0, -2.0];
        var m : [2]f32 = [7.0, 7.0];
        var v : [2]f32 = [7.0, 7.0];
        const config = default_config(clip);
        init_moments(&m, &v);
        moments_step(&g, &m, &v, config);
        return trust_ratio(&w, &m, &v, 1, config);
    }

    fn config_check() -> bool {
        const good = default_config(DEFAULT_CLIP_THRESHOLD);
        const beta_one = LAMBConfig{ .learning_rate = DEFAULT_LR, .beta1 = 1.0, .beta2 = DEFAULT_BETA2, .epsilon = DEFAULT_EPSILON, .weight_decay = 0.0, .clip_threshold = 1.0 };
        const no_clip = default_config(0.0);
        return config_ok(good) and !config_ok(beta_one) and !config_ok(no_clip);
    }

    test moments_step_first_moment
        given result = moments_code(0)
        when expected = 5.3
        then @abs(result - expected) < 0.00001

    test moments_step_second_moment
        given result = moments_code(1)
        when expected = 250.754
        then @abs(result - expected) < 0.001

    // 1 - 0.9^2 = 0.19
    test bias_correction_by_hand
        given result = bias_correction(0.9, 2)
        when expected = 0.19
        then @abs(result - expected) < 0.000001

    test trust_ratio_by_hand
        given result = trust_code(DEFAULT_CLIP_THRESHOLD)
        when expected = 3.5355366
        then @abs(result - expected) < 0.0001

    test trust_ratio_clipped
        given result = trust_code(2.0)
        when expected = 2.0
        then @abs(result - expected) < 0.000001

    test config_ok_follows_tri_constraints
        given result = config_check()
        when expected = true
        then result == expected

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (.tri constraints on the defaults)
    // ═══════════════════════════════════════════════════════════

    invariant lamb_defaults_in_range
        assert DEFAULT_BETA1 > 0.0 and DEFAULT_BETA1 < 1.0 and DEFAULT_BETA2 > 0.0 and DEFAULT_BETA2 < 1.0 and DEFAULT_EPSILON > 0.0 and DEFAULT_CLIP_THRESHOLD > 0.0

    // NOT CHECKED: the update step (see header), forward over layers (it
    // only maps compute_layer_update), and the behaviors / references
    // (large-batch training claims, You et al. 2020).
