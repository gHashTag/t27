// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Polyak averaging formula | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/algo/dqn_target.tri. The port
// lost the UpdateMethod variants (`enum : ,`), wrote `for i in 0..x.length`,
// and its should_update ignored the method: the .tri updates EVERY step in
// SOFT mode and only every update_freq steps in HARD mode. Its tests
// asserted result != undefined over a default_input() defined nowhere.

module DqnTarget;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_TAU : f32 = 0.005;
    const DEFAULT_UPDATE_FREQ : u32 = 1000;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // HARD = copy, SOFT = polyak average
    pub const UpdateMethod = enum { HARD, SOFT };

    pub const TargetUpdateConfig = struct {
        method : UpdateMethod,
        tau : f32,
        update_freq : u32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // target[i] = source[i]
    fn hard_update(source: []const f32, target: []f32) -> void {
        var i : usize = 0;
        while (i < source.len) {
            target[i] = source[i];
            i = i + 1;
        }
    }

    // Polyak averaging: target[i] = tau * source[i] + (1 - tau) * target[i]
    fn soft_update(source: []const f32, target: []f32, tau: f32) -> void {
        var i : usize = 0;
        while (i < source.len) {
            target[i] = tau * source[i] + (1.0 - tau) * target[i];
            i = i + 1;
        }
    }

    // HARD: step % update_freq == 0; SOFT: every step
    fn should_update(step: u32, config: TargetUpdateConfig) -> bool {
        if (config.method == UpdateMethod.HARD) {
            return step % config.update_freq == 0;
        }
        return true;
    }

    // .tri constraints: 0 <= tau <= 1, update_freq >= 1
    fn config_ok(config: TargetUpdateConfig) -> bool {
        return config.tau >= 0.0 and config.tau <= 1.0 and config.update_freq >= 1;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (values worked by hand)
    // ═══════════════════════════════════════════════════════════

    // source (1, 2, 3) over target (9, 9, 9): target becomes (1, 2, 3)
    fn hard_code() -> f32 {
        const source : [3]f32 = [1.0, 2.0, 3.0];
        var target : [3]f32 = [9.0, 9.0, 9.0];
        hard_update(&source, &target);
        return 100.0 * target[0] + 10.0 * target[1] + target[2];
    }

    // tau 0.25, source (4, 0), target (0, 8): (0.25*4, 0.75*8) = (1, 6).
    // Swapping tau and 1 - tau gives (3, 2).
    fn soft_code() -> f32 {
        const source : [2]f32 = [4.0, 0.0];
        var target : [2]f32 = [0.0, 8.0];
        soft_update(&source, &target, 0.25);
        return 10.0 * target[0] + target[1];
    }

    // HARD with freq 1000: step 2000 yes, 1500 no; SOFT: 1500 yes
    fn schedule_check() -> bool {
        const hard = TargetUpdateConfig{ .method = UpdateMethod.HARD, .tau = DEFAULT_TAU, .update_freq = DEFAULT_UPDATE_FREQ };
        const soft = TargetUpdateConfig{ .method = UpdateMethod.SOFT, .tau = DEFAULT_TAU, .update_freq = DEFAULT_UPDATE_FREQ };
        const hard_on = should_update(2000, hard);
        const hard_off = should_update(1500, hard);
        const soft_on = should_update(1500, soft);
        return hard_on and !hard_off and soft_on;
    }

    // tau 0.005 / freq 1000 pass; tau 1.5 fails; freq 0 fails
    fn config_check() -> bool {
        const good = TargetUpdateConfig{ .method = UpdateMethod.SOFT, .tau = DEFAULT_TAU, .update_freq = DEFAULT_UPDATE_FREQ };
        const big_tau = TargetUpdateConfig{ .method = UpdateMethod.SOFT, .tau = 1.5, .update_freq = DEFAULT_UPDATE_FREQ };
        const no_freq = TargetUpdateConfig{ .method = UpdateMethod.HARD, .tau = DEFAULT_TAU, .update_freq = 0 };
        return config_ok(good) and !config_ok(big_tau) and !config_ok(no_freq);
    }

    test hard_update_copies
        given result = hard_code()
        when expected = 123.0
        then @abs(result - expected) < 0.0001

    test soft_update_polyak_by_hand
        given result = soft_code()
        when expected = 16.0
        then @abs(result - expected) < 0.0001

    test should_update_depends_on_method
        given result = schedule_check()
        when expected = true
        then result == expected

    test config_ok_follows_tri_constraints
        given result = config_check()
        when expected = true
        then result == expected

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (.tri constraints on the defaults)
    // ═══════════════════════════════════════════════════════════

    // "tau << 1 for stability (typically 0.001-0.01)"
    invariant dqn_target_default_tau_small
        assert DEFAULT_TAU >= 0.001 and DEFAULT_TAU <= 0.01

    invariant dqn_target_default_freq_positive
        assert DEFAULT_UPDATE_FREQ >= 1

    // NOT CHECKED: the behaviors (stable targets, smoother convergence,
    // hybrid soft + periodic hard) are training claims; the two references
    // (Mnih 2015, Lillicrap 2016) are citations, not assertions.
