// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Clipped double Q-learning | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/algo/sac_critic.tri. The port's
// compute_target read config.gamma (SACCriticConfig has no gamma), called
// actor/entropy helpers defined nowhere, and ADDED the entropy term: the
// .tri equation sac_target is y = r + gamma * (min(Q1, Q2) - alpha * log pi).
// Its tests asserted result != undefined or loss >= 0.

module SacCritic;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_TAU : f32 = 0.005;
    const DEFAULT_GAMMA : f32 = 0.99;
    const DEFAULT_INIT_WEIGHT : f32 = 0.003;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const SACCriticConfig = struct {
        state_dim : u32,
        action_dim : u32,
        hidden_dims : []u32,
        init_weight : f32,
    };

    pub const TwinQOutput = struct {
        q1 : f32,
        q2 : f32,
    };

    pub const TargetQUpdate = struct {
        tau : f32,
        gamma : f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // clipped double Q: min(Q1, Q2)
    fn clipped_q(q: TwinQOutput) -> f32 {
        if (q.q1 < q.q2) {
            return q.q1;
        }
        return q.q2;
    }

    // y = r                                         if done
    // y = r + gamma * (min(Q1', Q2') - alpha * log pi(a'|s'))  otherwise
    fn sac_target(reward: f32, next_q: TwinQOutput, next_log_prob: f32, done: bool, update: TargetQUpdate, temperature: f32) -> f32 {
        if (done) {
            return reward;
        }
        return reward + update.gamma * (clipped_q(next_q) - temperature * next_log_prob);
    }

    // ((q1 - y)^2 + (q2 - y)^2) / 2
    fn q_loss(q1_pred: f32, q2_pred: f32, target: f32) -> f32 {
        const d1 = q1_pred - target;
        const d2 = q2_pred - target;
        return (d1 * d1 + d2 * d2) / 2.0;
    }

    // Polyak averaging: target = tau * source + (1 - tau) * target
    fn soft_update_target(source_params: []const f32, target_params: []f32, tau: f32) -> void {
        var i : usize = 0;
        while (i < source_params.len) {
            target_params[i] = tau * source_params[i] + (1.0 - tau) * target_params[i];
            i = i + 1;
        }
    }

    // .tri constraints: 0 < tau < 1, 0 <= gamma <= 1
    fn update_ok(update: TargetQUpdate) -> bool {
        return update.tau > 0.0 and update.tau < 1.0 and update.gamma >= 0.0 and update.gamma <= 1.0;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (values worked by hand)
    // ═══════════════════════════════════════════════════════════

    // r 1, Q' (5, 3), log pi -2, gamma 0.5, alpha 0.25:
    // 1 + 0.5 * (3 + 0.5) = 2.75. max(Q) gives 3.75; + alpha log pi gives 2.25.
    fn target_live() -> f32 {
        const q = TwinQOutput{ .q1 = 5.0, .q2 = 3.0 };
        const u = TargetQUpdate{ .tau = DEFAULT_TAU, .gamma = 0.5 };
        return sac_target(1.0, q, 0.0 - 2.0, false, u, 0.25);
    }

    // done: the target is the reward alone
    fn target_done() -> f32 {
        const q = TwinQOutput{ .q1 = 5.0, .q2 = 3.0 };
        const u = TargetQUpdate{ .tau = DEFAULT_TAU, .gamma = 0.5 };
        return sac_target(1.0, q, 0.0 - 2.0, true, u, 0.25);
    }

    // tau 0.25, source (4, 0), target (0, 8): (1, 6). Swapping tau gives (3, 2).
    fn soft_code() -> f32 {
        const source : [2]f32 = [4.0, 0.0];
        var target : [2]f32 = [0.0, 8.0];
        soft_update_target(&source, &target, 0.25);
        return 10.0 * target[0] + target[1];
    }

    // defaults pass; tau 0 fails; gamma 1.5 fails; gamma 1 passes
    fn update_check() -> bool {
        const good = TargetQUpdate{ .tau = DEFAULT_TAU, .gamma = DEFAULT_GAMMA };
        const no_tau = TargetQUpdate{ .tau = 0.0, .gamma = DEFAULT_GAMMA };
        const big_gamma = TargetQUpdate{ .tau = DEFAULT_TAU, .gamma = 1.5 };
        const edge = TargetQUpdate{ .tau = DEFAULT_TAU, .gamma = 1.0 };
        return update_ok(good) and !update_ok(no_tau) and !update_ok(big_gamma) and update_ok(edge);
    }

    test sac_target_by_hand
        given result = target_live()
        when expected = 2.75
        then @abs(result - expected) < 0.0001

    test sac_target_done_is_reward
        given result = target_done()
        when expected = 1.0
        then @abs(result - expected) < 0.0001

    // (2.5 - 2.8)^2 = 0.09, (3.0 - 2.8)^2 = 0.04, mean 0.065
    test q_loss_by_hand
        given result = q_loss(2.5, 3.0, 2.8)
        when expected = 0.065
        then @abs(result - expected) < 0.00001

    test soft_update_polyak_by_hand
        given result = soft_code()
        when expected = 16.0
        then @abs(result - expected) < 0.0001

    test update_ok_follows_tri_constraints
        given result = update_check()
        when expected = true
        then result == expected

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (.tri constraints on the defaults)
    // ═══════════════════════════════════════════════════════════

    // "0 < tau << 1 (typically 0.005)"
    invariant sac_critic_default_tau_small
        assert DEFAULT_TAU > 0.0 and DEFAULT_TAU <= 0.01

    invariant sac_critic_default_gamma_in_unit
        assert DEFAULT_GAMMA >= 0.0 and DEFAULT_GAMMA <= 1.0

    // NOT CHECKED: forward (the .tri leaves `activation`, the layer
    // layout and the parameter packing undefined) and sampling a' and
    // log pi from the actor (sample_squashed_gaussian is defined nowhere);
    // sac_target takes Q(s', a') and log pi as inputs instead.
