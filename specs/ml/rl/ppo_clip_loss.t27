// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// PPO clipped surrogate objective L^CLIP | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-05 from trinity specs/algo/ppo_clip_loss.tri. The port
// returned the LOG ratio, dropped the min() of the clipped objective, the
// advantage normalisation, the sign of the loss and the max() of the value
// loss, and its tests asserted those wrong values.

module PpoClipLoss;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_CLIP_EPSILON : f32 = 0.2;
    const DEFAULT_ENTROPY_COEF : f32 = 0.01;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const PPOClipConfig = struct {
        clip_epsilon : f32,
        entropy_coef : f32,
        value_clip_coef : f32,
    };

    pub const PPOBatch = struct {
        states : [][]f32,
        actions : [][]f32,
        old_log_probs : []f32,
        advantages : []f32,
        returns : []f32,
        values : []f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // compute_ratio(new_log_prob, old_log_prob) -> r = pi_new / pi_old
    fn compute_ratio(new_log_prob: f32, old_log_prob: f32) -> f32 {
        return @exp(new_log_prob - old_log_prob);
    }

    fn clamp(x: f32, lo: f32, hi: f32) -> f32 {
        return @max(lo, @min(x, hi));
    }

    // min(r A, clip(r, 1 - eps, 1 + eps) A): the pessimistic bound
    fn clipped_surrogate(ratio: f32, advantage: f32, clip_epsilon: f32) -> f32 {
        const clipped_ratio = clamp(ratio, 1.0 - clip_epsilon, 1.0 + clip_epsilon);
        return @min(ratio * advantage, clipped_ratio * advantage);
    }

    // -mean_i clipped_surrogate(r_i, A_norm_i), A_norm = (A - mean) / (std + 1e-8).
    // std is the population std (divide by n); the .tri says std() without
    // choosing, and the normalised values differ from the n-1 form only in scale.
    fn policy_loss(ratios: []const f32, advantages: []const f32, clip_epsilon: f32) -> f32 {
        const n = advantages.len;
        if (n == 0) {
            return 0.0;
        }
        var sum : f32 = 0.0;
        var i : usize = 0;
        while (i < n) {
            sum = sum + advantages[i];
            i = i + 1;
        }
        const mean = sum / (n as f32);
        var sq : f32 = 0.0;
        i = 0;
        while (i < n) {
            const d = advantages[i] - mean;
            sq = sq + d * d;
            i = i + 1;
        }
        const deviation = @sqrt(sq / (n as f32));
        var objective : f32 = 0.0;
        i = 0;
        while (i < n) {
            const a = (advantages[i] - mean) / (deviation + 0.00000001);
            objective = objective + clipped_surrogate(ratios[i], a, clip_epsilon);
            i = i + 1;
        }
        return 0.0 - objective / (n as f32);
    }

    // -entropy_coef * mean(entropies): a bonus, negated for minimisation
    fn entropy_loss(entropies: []const f32, entropy_coef: f32) -> f32 {
        if (entropies.len == 0) {
            return 0.0;
        }
        var sum : f32 = 0.0;
        var i : usize = 0;
        while (i < entropies.len) {
            sum = sum + entropies[i];
            i = i + 1;
        }
        return 0.0 - entropy_coef * sum / (entropies.len as f32);
    }

    // mean(max((v - R)^2, (v_old + clip(v - v_old, -c, c) - R)^2))
    fn value_loss(predicted_values: []const f32, target_values: []const f32, old_values: []const f32, clip_coef: f32) -> f32 {
        const n = predicted_values.len;
        if (n == 0) {
            return 0.0;
        }
        var total : f32 = 0.0;
        var i : usize = 0;
        while (i < n) {
            const unclipped = predicted_values[i] - target_values[i];
            const clipped_pred = old_values[i] + clamp(predicted_values[i] - old_values[i], 0.0 - clip_coef, clip_coef);
            const clipped = clipped_pred - target_values[i];
            total = total + @max(unclipped * unclipped, clipped * clipped);
            i = i + 1;
        }
        return total / (n as f32);
    }

    fn total_loss(policy_loss_value: f32, value_loss_value: f32, entropy_loss_value: f32, value_loss_coef: f32) -> f32 {
        return policy_loss_value + value_loss_coef * value_loss_value + entropy_loss_value;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (values worked by hand from Schulman et al. 2017)
    // ═══════════════════════════════════════════════════════════

    fn policy_loss_at(r0: f32, r1: f32, r2: f32, a0: f32, a1: f32, a2: f32) -> f32 {
        const ratios : [3]f32 = [r0, r1, r2];
        const advantages : [3]f32 = [a0, a1, a2];
        return policy_loss(&ratios, &advantages, DEFAULT_CLIP_EPSILON);
    }

    fn entropy_three() -> f32 {
        const entropies : [3]f32 = [0.5, 0.6, 0.4];
        return entropy_loss(&entropies, DEFAULT_ENTROPY_COEF);
    }

    fn value_loss_one(predicted: f32, target: f32, old: f32) -> f32 {
        const p : [1]f32 = [predicted];
        const t : [1]f32 = [target];
        const o : [1]f32 = [old];
        return value_loss(&p, &t, &o, 0.2);
    }

    // r = exp(0.2), not the log difference 0.2
    test compute_ratio_is_exp_of_log_difference
        given result = compute_ratio(0.5, 0.3)
        when same = compute_ratio(-1.7, -1.7)
        then @abs(result - 1.2214028) < 0.000001 and @abs(same - 1.0) < 0.000001

    // inside [0.8, 1.2] the ratio is used as is: 1.1 * 2 = 2.2
    test clipped_surrogate_inside_the_band
        given result = clipped_surrogate(1.1, 2.0, 0.2)
        when expected = 2.2
        then @abs(result - expected) < 0.000001

    // positive advantage: gain is capped at (1 + eps) A = 2.4 when r = 1.5;
    // but r = 0.5 keeps the smaller r A = 1.0 (no reward for clipping up)
    test clipped_surrogate_positive_advantage
        given high = clipped_surrogate(1.5, 2.0, 0.2)
        when low = clipped_surrogate(0.5, 2.0, 0.2)
        then @abs(high - 2.4) < 0.000001 and @abs(low - 1.0) < 0.000001

    // negative advantage: r = 1.5 keeps the full penalty r A = -3.0;
    // r = 0.5 is capped at (1 - eps) A = -1.6
    test clipped_surrogate_negative_advantage
        given high = clipped_surrogate(1.5, -2.0, 0.2)
        when low = clipped_surrogate(0.5, -2.0, 0.2)
        then @abs(high - (0.0 - 3.0)) < 0.000001 and @abs(low - (0.0 - 1.6)) < 0.000001

    // A = (1, 2, 3) normalises to (-1.2247449, 0, 1.2247449);
    // surrogates: min(1.5 * -1.2247, 1.2 * -1.2247) = -1.8371173, 0,
    // min(0.5 * 1.2247, 0.8 * 1.2247) = 0.6123724; loss = -(sum) / 3
    test policy_loss_by_hand
        given result = policy_loss_at(1.5, 1.0, 0.5, 1.0, 2.0, 3.0)
        when expected = 0.4082483
        then @abs(result - expected) < 0.00001

    // r = 1 everywhere: the normalised advantages average to 0
    test policy_loss_zero_at_old_policy
        given result = policy_loss_at(1.0, 1.0, 1.0, 5.0, -1.0, 2.0)
        when expected = 0.0
        then @abs(result - expected) < 0.00001

    test entropy_loss_is_negative_bonus
        given result = entropy_three()
        when expected = 0.0 - 0.005
        then @abs(result - expected) < 0.0000001

    // v = 1, R = 2, v_old = 0.5: unclipped 1.0, clipped pred 0.7 gives 1.69; max 1.69
    // v = 1, R = 1, v_old = 0.5: unclipped 0, clipped 0.09; max 0.09
    test value_loss_takes_the_larger_error
        given far = value_loss_one(1.0, 2.0, 0.5)
        when near = value_loss_one(1.0, 1.0, 0.5)
        then @abs(far - 1.69) < 0.00001 and @abs(near - 0.09) < 0.00001

    test total_loss_combines_terms
        given result = total_loss(1.0, 0.5, -0.01, 0.5)
        when expected = 1.24
        then @abs(result - expected) < 0.000001

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    invariant ppo_default_clip_in_range
        assert DEFAULT_CLIP_EPSILON > 0.0 and DEFAULT_CLIP_EPSILON <= 1.0

    invariant ppo_default_entropy_nonnegative
        assert DEFAULT_ENTROPY_COEF >= 0.0

    // NOT CHECKED here (were `then true` over an undefined valid_input()):
    // callers keep 0 < clip_epsilon <= 1, entropy_coef >= 0 and equal-length
    // slices. Reference: Schulman et al. (2017), arXiv:1707.06347.
