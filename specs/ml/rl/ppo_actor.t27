// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Reparameterization for gradient estimation | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/algo/ppo_actor.tri. The port lost
// the ActionSpace variants (`enum : ,`) and so ignored the action space:
// forward_discrete returned softmax probabilities where the .tri returns
// logits, and log_prob / entropy were Gaussian-only, wrong for DISCRETE
// (.tri: log_softmax(logits)[a] and -sum p log p). sample_action clipped to
// an invented [-10, 10] and called math::normal_random, defined nowhere.
// Its tests checked only lengths, ranges, `result == result` and >= 0.

module PpoActor;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_INIT_LOG_STD : f32 = 0.0;
    const MIN_LOG_STD : f32 = -20.0;
    const MAX_LOG_STD : f32 = 2.0;
    // 0.5 * ln(2 pi) and 0.5 * ln(2 pi e)
    const HALF_LOG_TWO_PI : f32 = 0.9189385;
    const HALF_LOG_TWO_PI_E : f32 = 1.4189385;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ActionSpace = enum { DISCRETE, CONTINUOUS };

    pub const ActorConfig = struct {
        state_dim : u32,
        action_dim : u32,
        hidden_dims : []u32,
        action_space : ActionSpace,
        init_log_std : f32,
    };

    // logits: action logits (DISCRETE) or the mean (CONTINUOUS)
    pub const PolicyOutput = struct {
        logits : []f32,
        log_std : []f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // forward_continuous's clamp to [MIN_LOG_STD, MAX_LOG_STD]
    fn clamp_log_std(x: f32) -> f32 {
        if (x < MIN_LOG_STD) {
            return MIN_LOG_STD;
        }
        if (x > MAX_LOG_STD) {
            return MAX_LOG_STD;
        }
        return x;
    }

    // deterministic DISCRETE action: argmax(logits), first index on ties
    fn argmax(logits: []const f32) -> usize {
        var best : usize = 0;
        var i : usize = 1;
        while (i < logits.len) {
            if (logits[i] > logits[best]) {
                best = i;
            }
            i = i + 1;
        }
        return best;
    }

    // log sum_j exp(logits[j]), shifted by the max for stability
    fn log_sum_exp(logits: []const f32) -> f32 {
        const top = logits[argmax(logits)];
        var total : f32 = 0.0;
        var i : usize = 0;
        while (i < logits.len) {
            total = total + @exp(logits[i] - top);
            i = i + 1;
        }
        return top + @log(total);
    }

    // CONTINUOUS sample, reparameterized: a = mean (deterministic) or
    // mean + exp(log_std) * noise, with noise ~ N(0, I) passed in
    fn sample_continuous(policy_output: PolicyOutput, noise: []const f32, deterministic: bool, out: []f32) -> void {
        var i : usize = 0;
        while (i < policy_output.logits.len) {
            if (deterministic) {
                out[i] = policy_output.logits[i];
            } else {
                out[i] = policy_output.logits[i] + @exp(policy_output.log_std[i]) * noise[i];
            }
            i = i + 1;
        }
    }

    // DISCRETE: log_softmax(logits)[a], a = action[0] as an index
    // CONTINUOUS: sum_i -(a_i - mu_i)^2 / (2 sigma_i^2) - log sigma_i - 0.5 log 2 pi
    fn log_prob(action: []const f32, policy_output: PolicyOutput, action_space: ActionSpace) -> f32 {
        if (action_space == ActionSpace.DISCRETE) {
            const lse = log_sum_exp(policy_output.logits);
            var k : usize = 0;
            while (k < policy_output.logits.len) {
                if ((k as f32) == action[0]) {
                    return policy_output.logits[k] - lse;
                }
                k = k + 1;
            }
            return MIN_LOG_STD;
        }
        var total : f32 = 0.0;
        var i : usize = 0;
        while (i < action.len) {
            const z = (action[i] - policy_output.logits[i]) / @exp(policy_output.log_std[i]);
            total = total - 0.5 * z * z - policy_output.log_std[i] - HALF_LOG_TWO_PI;
            i = i + 1;
        }
        return total;
    }

    // DISCRETE: -sum p log p with p = softmax(logits)
    // CONTINUOUS: sum_i 0.5 log(2 pi e sigma_i^2) = sum_i (0.5 log 2 pi e + log_std_i)
    fn entropy(policy_output: PolicyOutput, action_space: ActionSpace) -> f32 {
        var total : f32 = 0.0;
        var i : usize = 0;
        if (action_space == ActionSpace.DISCRETE) {
            const lse = log_sum_exp(policy_output.logits);
            while (i < policy_output.logits.len) {
                const lp = policy_output.logits[i] - lse;
                total = total - @exp(lp) * lp;
                i = i + 1;
            }
            return total;
        }
        while (i < policy_output.log_std.len) {
            total = total + HALF_LOG_TWO_PI_E + policy_output.log_std[i];
            i = i + 1;
        }
        return total;
    }

    // .tri constraints: action_dim >= 1, len(hidden_dims) >= 1
    fn config_ok(config: ActorConfig) -> bool {
        return config.action_dim >= 1 and config.hidden_dims.len >= 1;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (values worked by hand)
    // ═══════════════════════════════════════════════════════════

    // logits (1, 2, 0): log sum exp = 2.4076060
    fn discrete_value(which: usize) -> f32 {
        var logits : [3]f32 = [1.0, 2.0, 0.0];
        var log_std : [3]f32 = [0.0, 0.0, 0.0];
        const p = PolicyOutput{ .logits = &logits, .log_std = &log_std };
        const a1 : [1]f32 = [1.0];
        const a2 : [1]f32 = [2.0];
        if (which == 0) {
            return log_prob(&a1, p, ActionSpace.DISCRETE);
        }
        if (which == 1) {
            return log_prob(&a2, p, ActionSpace.DISCRETE);
        }
        if (which == 2) {
            return entropy(p, ActionSpace.DISCRETE);
        }
        return argmax(&logits) as f32;
    }

    // mean (0.5, -1), log_std (0, 0.5), action (1.5, -1.2)
    fn continuous_value(which: usize) -> f32 {
        var mean : [2]f32 = [0.5, -1.0];
        var log_std : [2]f32 = [0.0, 0.5];
        const p = PolicyOutput{ .logits = &mean, .log_std = &log_std };
        const a : [2]f32 = [1.5, -1.2];
        if (which == 0) {
            return log_prob(&a, p, ActionSpace.CONTINUOUS);
        }
        return entropy(p, ActionSpace.CONTINUOUS);
    }

    // noise (1, -2): stochastic (1.5, -1 - 2 e^0.5) coded 10 a0 + a1;
    // deterministic returns the mean (0.5, -1)
    fn sample_code(deterministic: bool) -> f32 {
        var mean : [2]f32 = [0.5, -1.0];
        var log_std : [2]f32 = [0.0, 0.5];
        const p = PolicyOutput{ .logits = &mean, .log_std = &log_std };
        const noise : [2]f32 = [1.0, -2.0];
        var out : [2]f32 = [0.0, 0.0];
        sample_continuous(p, &noise, deterministic, &out);
        return 10.0 * out[0] + out[1];
    }

    // clamp: 5 -> 2, -30 -> -20, 0.5 stays; action_dim 0 and no hidden layer fail
    fn bounds_check() -> bool {
        var hidden : [1]u32 = [64];
        var none : [0]u32 = [];
        const good = ActorConfig{ .state_dim = 4, .action_dim = 2, .hidden_dims = &hidden, .action_space = ActionSpace.CONTINUOUS, .init_log_std = DEFAULT_INIT_LOG_STD };
        const no_actions = ActorConfig{ .state_dim = 4, .action_dim = 0, .hidden_dims = &hidden, .action_space = ActionSpace.DISCRETE, .init_log_std = DEFAULT_INIT_LOG_STD };
        const no_hidden = ActorConfig{ .state_dim = 4, .action_dim = 2, .hidden_dims = &none, .action_space = ActionSpace.DISCRETE, .init_log_std = DEFAULT_INIT_LOG_STD };
        const clamped = clamp_log_std(5.0) == MAX_LOG_STD and clamp_log_std(0.0 - 30.0) == MIN_LOG_STD and clamp_log_std(0.5) == 0.5;
        return clamped and config_ok(good) and !config_ok(no_actions) and !config_ok(no_hidden);
    }

    // 2 - 2.4076060
    test discrete_log_prob_action_1
        given result = discrete_value(0)
        when expected = 0.0 - 0.4076060
        then @abs(result - expected) < 0.0001

    // 0 - 2.4076060
    test discrete_log_prob_action_2
        given result = discrete_value(1)
        when expected = 0.0 - 2.4076060
        then @abs(result - expected) < 0.0001

    test discrete_entropy_by_hand
        given result = discrete_value(2)
        when expected = 0.8323956
        then @abs(result - expected) < 0.0001

    test discrete_argmax
        given result = discrete_value(3)
        when expected = 1.0
        then result == expected

    // -0.5 - 0.9189385 + (-0.5 * 0.0367879 - 0.5 - 0.9189385) = -2.8452347
    test continuous_log_prob_by_hand
        given result = continuous_value(0)
        when expected = 0.0 - 2.8452347
        then @abs(result - expected) < 0.0001

    // 2 * 1.4189385 + 0.5
    test continuous_entropy_by_hand
        given result = continuous_value(1)
        when expected = 3.3378771
        then @abs(result - expected) < 0.0001

    // 15 + (-1 - 3.2974425) = 10.7025575
    test sample_stochastic_by_hand
        given result = sample_code(false)
        when expected = 10.7025575
        then @abs(result - expected) < 0.0001

    test sample_deterministic_is_mean
        given result = sample_code(true)
        when expected = 4.0
        then @abs(result - expected) < 0.0001

    test clamp_and_config_follow_tri
        given result = bounds_check()
        when expected = true
        then result == expected

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (.tri constants)
    // ═══════════════════════════════════════════════════════════

    invariant ppo_actor_log_std_bounds_ordered
        assert MIN_LOG_STD < MAX_LOG_STD

    // "Initialize with std=1.0 (log(1)=0)", inside the clamp range
    invariant ppo_actor_init_log_std_in_range
        assert DEFAULT_INIT_LOG_STD >= MIN_LOG_STD and DEFAULT_INIT_LOG_STD <= MAX_LOG_STD

    // NOT CHECKED: forward_discrete / forward_continuous (the .tri leaves
    // `activation` and the parameter packing undefined; only the log-std
    // clamp is checked) and stochastic DISCRETE sampling
    // (categorical_sample / Gumbel-softmax are named, not defined).
    // CONTINUOUS entropy sums the .tri's per-dimension 0.5 log(2 pi e sigma^2)
    // over the diagonal, the only reading that returns one f32.
