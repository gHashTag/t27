// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// PPO critic: GAE(lambda) advantages, discounted returns, value loss | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-05 from trinity specs/algo/ppo_critic.tri. The port
// returned empty arrays and 0.0, so its exact-value tests could not hold.

module PpoCritic;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    // .tri DEFAULT_HIDDEN = [64, 64]; the port wrote it as a string
    const DEFAULT_HIDDEN : [2]u32 = [64, 64];
    const DEFAULT_GAMMA : f32 = 0.99;
    const DEFAULT_LAMBDA : f32 = 0.95;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Activation = enum { RELU, TANH, GELU };

    pub const CriticConfig = struct {
        state_dim : u32,
        hidden_dims : []u32,
        activation : Activation,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // forward(state, params, config) -> V(s). PLACEHOLDER, NOT CHECKED: the
    // .tri gives the MLP formula but not how W1, b1, ... are laid out in
    // `params`, so no layout is invented here and no test claims a value.
    fn forward(state: []const f32, params: []const f32, config: CriticConfig) -> f32 {
        return params[0];
    }

    // GAE(gamma, lambda), Schulman et al. 2016. values has T + 1 entries:
    // values[T] is the bootstrap value of the state after the last reward.
    //   delta_t = r_t + gamma V(s_{t+1}) - V(s_t)
    //   A_t = delta_t + gamma lambda A_{t+1}
    // Writes A into the caller's `advantages` (length T).
    fn compute_advantage(rewards: []const f32, values: []const f32, gamma: f32, lambda_: f32, advantages: []f32) -> void {
        var gae : f32 = 0.0;
        var t : usize = rewards.len;
        while (t > 0) {
            t = t - 1;
            const delta = rewards[t] + gamma * values[t + 1] - values[t];
            gae = delta + gamma * lambda_ * gae;
            advantages[t] = gae;
        }
    }

    // G_t = r_t + gamma G_{t+1}, G_T = 0. Writes into the caller's `returns`.
    fn compute_returns(rewards: []const f32, gamma: f32, returns: []f32) -> void {
        var g : f32 = 0.0;
        var t : usize = rewards.len;
        while (t > 0) {
            t = t - 1;
            g = rewards[t] + gamma * g;
            returns[t] = g;
        }
    }

    // mean((predicted - target)^2); 0 for no samples
    fn value_loss(predicted_values: []const f32, target_values: []const f32) -> f32 {
        const n = predicted_values.len;
        if (n == 0) {
            return 0.0;
        }
        var total : f32 = 0.0;
        var i : usize = 0;
        while (i < n) {
            const d = predicted_values[i] - target_values[i];
            total = total + d * d;
            i = i + 1;
        }
        return total / (n as f32);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (values worked by hand)
    // ═══════════════════════════════════════════════════════════

    // rewards (1, 1), values (0.5, 1.0, 2.0), gamma 0.9: A[index]
    fn gae_at(lambda_: f32, index: usize) -> f32 {
        const rewards : [2]f32 = [1.0, 1.0];
        const values : [3]f32 = [0.5, 1.0, 2.0];
        var advantages : [2]f32 = [0.0] ** 2;
        compute_advantage(&rewards, &values, 0.9, lambda_, &advantages);
        return advantages[index];
    }

    fn returns_at(gamma: f32, index: usize) -> f32 {
        const rewards : [3]f32 = [1.0, 2.0, 3.0];
        var returns : [3]f32 = [0.0] ** 3;
        compute_returns(&rewards, gamma, &returns);
        return returns[index];
    }

    fn loss_three() -> f32 {
        const predicted : [3]f32 = [1.0, 2.0, 3.0];
        const target : [3]f32 = [1.5, 2.5, 3.5];
        return value_loss(&predicted, &target);
    }

    // delta_1 = 1 + 0.9 * 2 - 1 = 1.8; delta_0 = 1 + 0.9 * 1 - 0.5 = 1.4;
    // A_0 = 1.4 + 0.9 * 0.5 * 1.8 = 2.21
    test gae_by_hand
        given last = gae_at(0.5, 1)
        when first = gae_at(0.5, 0)
        then @abs(last - 1.8) < 0.00001 and @abs(first - 2.21) < 0.00001

    // lambda = 0: A_t is the one-step TD error
    test gae_lambda_zero_is_td_error
        given result = gae_at(0.0, 0)
        when expected = 1.4
        then @abs(result - expected) < 0.00001

    // lambda = 1: A_0 = r_0 + gamma r_1 + gamma^2 V(s_2) - V(s_0) = 3.02
    test gae_lambda_one_is_monte_carlo_minus_baseline
        given result = gae_at(1.0, 0)
        when expected = 1.0 + 0.9 + 0.81 * 2.0 - 0.5
        then @abs(result - expected) < 0.00001

    test compute_returns_basic_case
        given first = returns_at(0.99, 0)
        when expected = 1.0 + 2.0 * 0.99 + 3.0 * 0.99 * 0.99
        then @abs(first - expected) < 0.00001 and @abs(returns_at(0.99, 2) - 3.0) < 0.000001

    // gamma = 0.5: G = (2.75, 3.5, 3)
    test compute_returns_discounts_backwards
        given middle = returns_at(0.5, 1)
        when first = returns_at(0.5, 0)
        then @abs(middle - 3.5) < 0.000001 and @abs(first - 2.75) < 0.000001

    test value_loss_basic_case
        given result = loss_three()
        when expected = 0.25
        then @abs(result - expected) < 0.000001

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    invariant ppo_critic_defaults_in_unit_interval
        assert DEFAULT_GAMMA >= 0.0 and DEFAULT_GAMMA <= 1.0 and DEFAULT_LAMBDA >= 0.0 and DEFAULT_LAMBDA <= 1.0

    // NOT CHECKED here (were `then true` over an undefined valid_input()):
    // callers keep 0 <= gamma <= 1, 0 <= lambda_ <= 1 and
    // values.len == rewards.len + 1. DEFAULT_GAMMA and DEFAULT_LAMBDA are
    // the GAE paper's usual values, added so the range claim has a subject.
    // References: Schulman et al. (2016) GAE; Schulman et al. (2017) PPO.
