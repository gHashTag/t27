// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Minimum distance for negative pairs | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-05 from trinity specs/algo/contrastive_loss.tri: the port kept only
// the first parameter and returned void, so forward computed a value and
// threw it away, and every test asserted `result != undefined`.

module ContrastiveLoss;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ContrastiveLossConfig = struct {
        margin : f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // Euclidean distance. The .tri says only "distance"; Euclidean is the
    // choice of Hadsell, Chopra, LeCun (2006), where this loss comes from.
    fn distance(a: []const f32, b: []const f32) -> f32 {
        var sum : f32 = 0.0;
        var i : usize = 0;
        while (i < a.len) {
            const d = a[i] - b[i];
            sum = sum + d * d;
            i = i + 1;
        }
        return @sqrt(sum);
    }

    // loss = d(anchor, positive)^2 + max(0, margin - d(anchor, negative))^2
    fn forward(anchor: []const f32, positive: []const f32, negative: []const f32, margin: f32) -> f32 {
        const dp = distance(anchor, positive);
        const gap = @max(0.0, margin - distance(anchor, negative));
        return dp * dp + gap * gap;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // anchor (0, 0); positive (px, 0); negative (nx, 0)
    fn loss_at(px: f32, nx: f32, margin: f32) -> f32 {
        const anchor : [2]f32 = [0.0, 0.0];
        const positive : [2]f32 = [px, 0.0];
        const negative : [2]f32 = [nx, 0.0];
        return forward(&anchor, &positive, &negative, margin);
    }

    fn distance_3_4() -> f32 {
        const a : [2]f32 = [0.0, 0.0];
        const b : [2]f32 = [3.0, 4.0];
        return distance(&a, &b);
    }

    test distance_is_euclidean
        given result = distance_3_4()
        when expected = 5.0
        then @abs(result - expected) < 0.000001

    test zero_when_positive_coincides_and_negative_beyond_margin
        given result = loss_at(0.0, 2.0, 1.0)
        when at_margin = loss_at(0.0, 1.0, 1.0)
        then result == 0.0 and at_margin == 0.0

    // positive at 0.5: 0.25; negative at 0.25 inside margin 1: (0.75)^2
    test both_terms_counted
        given result = loss_at(0.5, 0.25, 1.0)
        when positive_only = loss_at(0.5, 5.0, 1.0)
        then @abs(result - 0.8125) < 0.000001 and @abs(positive_only - 0.25) < 0.000001

    test closer_negative_costs_more
        given far = loss_at(0.0, 0.8, 1.0)
        when near = loss_at(0.0, 0.2, 1.0)
        then near > far

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants
    // ═══════════════════════════════════════════════════════════

    invariant contrastive_zero_for_separated_pairs
        assert loss_at(0.0, 3.0, 1.0) == 0.0
