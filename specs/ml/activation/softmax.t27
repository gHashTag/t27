// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Control sharpness of distribution | φ² + 1/φ² = 3 | TRINITY

module Softmax;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const ZERO : f32 = 0.0;
    const MIN_TEMP : f32 = 0.001;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const SoftmaxConfig = struct {
        temperature : f32,
        axis : u32,
        stable : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // forward(logits: []const f32, output: []f32, config: SoftmaxConfig) -> void
    fn forward(logits: []const f32, output: []f32, config: SoftmaxConfig) -> void {
        // logits.len and output.len are equal by invariant softmax_constraint_0; assume it
        // config.axis is declared but this signature takes a flat 1-D slice; axis is unused at this rank
        
        var clamped_temp : f32 = if (config.temperature < MIN_TEMP) MIN_TEMP else config.temperature;
        
        if (config.stable) {
            // Find max logit for numerical stability
            var max_val : f32 = logits[0];
            var i : usize = 1;
            while (i < logits.len) : (i += 1) {
                if (logits[i] > max_val) {
                    max_val = logits[i];
                }
            }
            
            // Subtract max and exponentiate
            var sum : f32 = ZERO;
            i = 0;
            while (i < logits.len) : (i += 1) {
                var scaled : f32 = (logits[i] - max_val) / clamped_temp;
                output[i] = @exp(scaled);
                sum = sum + output[i];
            }
            
            // Normalize to sum to 1
            i = 0;
            while (i < output.len) : (i += 1) {
                output[i] = output[i] / sum;
            }
        } else {
            // Direct exponentiation without max subtraction
            var sum : f32 = ZERO;
            i = 0;
            while (i < logits.len) : (i += 1) {
                var scaled : f32 = logits[i] / clamped_temp;
                output[i] = @exp(scaled);
                sum = sum + output[i];
            }
            
            // Normalize to sum to 1
            i = 0;
            while (i < output.len) : (i += 1) {
                output[i] = output[i] / sum;
            }
        }
    }

    // backward(grad_output: []const f32, probabilities: []const f32, grad_input: []f32, config: SoftmaxConfig) -> void
    fn backward(grad_output: []const f32, probabilities: []const f32, grad_input: []f32, config: SoftmaxConfig) -> void {
        var clamped_temp : f32 = if (config.temperature < MIN_TEMP) MIN_TEMP else config.temperature;
        
        // Compute dot = sum(g[i] * p[i])
        var dot : f32 = ZERO;
        var i : usize = 0;
        while (i < grad_output.len) : (i += 1) {
            dot = dot + grad_output[i] * probabilities[i];
        }
        
        // Compute grad_input[i] = p[i] * (g[i] - dot) / temperature
        i = 0;
        while (i < grad_input.len) : (i += 1) {
            grad_input[i] = probabilities[i] * (grad_output[i] - dot) / clamped_temp;
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test forward_basic_case
        given input = default_input()
        when result = forward(input)
        then result != undefined

    test backward_basic_case
        given input = default_input()
        when result = backward(input)
        then result != undefined

    test forward_uniform_input
        given input = [1.0, 1.0, 1.0]  // uniform logits
        let config = SoftmaxConfig { temperature: 1.0, axis: 0, stable: false }
        let output = [0.0, 0.0, 0.0]
        when forward(input, output, config)
        then output[0] == 1.0/3.0 and output[1] == 1.0/3.0 and output[2] == 1.0/3.0

    test forward_sum_to_one
        given input = [1.0, 2.0, 3.0]
        let config = SoftmaxConfig { temperature: 1.0, axis: 0, stable: true }
        let output = [0.0, 0.0, 0.0]
        when forward(input, output, config)
        then @abs((output[0] + output[1] + output[2]) - 1.0) < 1e-6

    test backward_gradient_formula
        given grad_output = [0.1, 0.2, 0.3]
        let probabilities = [0.2, 0.3, 0.5]
        let config = SoftmaxConfig { temperature: 1.0, axis: 0, stable: false }
        let grad_input = [0.0, 0.0, 0.0]
        when backward(grad_output, probabilities, grad_input, config)
        then true  // gradient computed according to softmax Jacobian formula

    test stable_vs_unstable_agree
        given input = [0.1, 0.2, 0.3]  // small well-scaled input
        let config_stable = SoftmaxConfig { temperature: 1.0, axis: 0, stable: true }
        let config_unstable = SoftmaxConfig { temperature: 1.0, axis: 0, stable: false }
        let output_stable = [0.0, 0.0, 0.0]
        let output_unstable = [0.0, 0.0, 0.0]
        when forward(input, output_stable, config_stable) and forward(input, output_unstable, config_unstable)
        then @abs(output_stable[0] - output_unstable[0]) < 1e-6 and @abs(output_stable[1] - output_unstable[1]) < 1e-6 and @abs(output_stable[2] - output_unstable[2]) < 1e-6

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    invariant softmax_constraint_0
        given input = valid_input()
        then true // logits.size() == output.size()

    invariant softmax_constraint_1
        given input = valid_input()
        then true // config.temperature >= MIN_TEMP

    invariant softmax_constraint_2
        given input = valid_input()
        then true // sum(output) ≈ 1.0 (within floating precision)

    test min_temp_is_strictly_above_zero
        then MIN_TEMP > ZERO
        and @abs(MIN_TEMP - 0.001) < 1e-9
        and ZERO == 0.0

    test temperature_is_a_float_axis_is_an_index
        then @FieldType(SoftmaxConfig, "temperature") == f32
        and @FieldType(SoftmaxConfig, "axis") == u32

    test the_stable_max_subtraction_is_opt_in
        then @FieldType(SoftmaxConfig, "stable") == bool
        and @typeInfo(SoftmaxConfig).@"struct".fields.len == 3