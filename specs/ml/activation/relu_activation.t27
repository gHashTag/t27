// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// ReLU produces sparse gradients | φ² + 1/φ² = 3 | TRINITY

module Relu;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const ZERO : f32 = 0.0;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ReLUConfig = struct {
        negative_slope : f32,
        inplace : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // forward(input: []const f32, output: []f32, config: ReLUConfig) → void
    fn forward(input: []const f32, output: []f32, config: ReLUConfig) -> void {
        // Values at or below ZERO take the negative branch, values above ZERO pass through
        // For negative_slope = 0.0, this gives max(0, x) behavior
        var i : usize = 0;
        while (i < input.len) : (i += 1) {
            if (input[i] > ZERO) {
                output[i] = input[i];  // Positive branch: identity
            } else {
                output[i] = input[i] * config.negative_slope;  // Negative branch: scaled
            }
        }
    }

    // backward(grad_output: []const f32, input: []const f32, grad_input: []f32, config: ReLUConfig) → void
    fn backward(grad_output: []const f32, input: []const f32, grad_input: []f32, config: ReLUConfig) -> void {
        // The gradient gate is on the forward input, not grad_output - this makes gradients sparse
        var i : usize = 0;
        while (i < input.len) : (i += 1) {
            if (input[i] > ZERO) {
                grad_input[i] = grad_output[i];  // Positive branch: identity gradient
            } else {
                grad_input[i] = grad_output[i] * config.negative_slope;  // Negative branch: scaled gradient
            }
        }
    }

    // Note: config.inplace is declared but currently unused by these functions.
    // The buffers are separate parameters, so the aliasing case is not handled.

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // Fixtures: the tests used to call forward(input, config) and
    // backward(grad, input, config), one argument short of the fns above
    // (lab-exec: 6 argument-count errors). The buffers live here now.
    fn relu_at(a: f32, b: f32, c: f32, slope: f32, index: usize) -> f32 {
        const input : [3]f32 = [a, b, c];
        var output : [3]f32 = [0.0] ** 3;
        forward(&input, &output, ReLUConfig{ .negative_slope = slope, .inplace = false });
        return output[index];
    }

    fn relu_grad_at(a: f32, b: f32, c: f32, slope: f32, index: usize) -> f32 {
        const grad_output : [3]f32 = [1.0, 1.0, 1.0];
        const input : [3]f32 = [a, b, c];
        var grad_input : [3]f32 = [0.0] ** 3;
        backward(&grad_output, &input, &grad_input, ReLUConfig{ .negative_slope = slope, .inplace = false });
        return grad_input[index];
    }

    // Removed 2026-10-05: forward_basic_case, backward_basic_case -- each read
    // default_input() (defined nowhere) and asserted `result != undefined`.

    test forward_positive_identity
        given first = relu_at(1.0, 2.0, 3.0, 0.0, 0)
        when last = relu_at(1.0, 2.0, 3.0, 0.0, 2)
        then first == 1.0 and relu_at(1.0, 2.0, 3.0, 0.0, 1) == 2.0 and last == 3.0

    test forward_negative_scaling
        given first = relu_at(-1.0, -2.0, -3.0, 0.5, 0)
        when last = relu_at(-1.0, -2.0, -3.0, 0.5, 2)
        then first == -0.5 and relu_at(-1.0, -2.0, -3.0, 0.5, 1) == -1.0 and last == -1.5

    test forward_zero_negative_slope
        given first = relu_at(-1.0, 0.0, 1.0, 0.0, 0)
        when last = relu_at(-1.0, 0.0, 1.0, 0.0, 2)
        then first == 0.0 and relu_at(-1.0, 0.0, 1.0, 0.0, 1) == 0.0 and last == 1.0

    // grad_output * negative_slope for input <= ZERO, grad_output above it
    test backward_input_gate
        given first = relu_grad_at(-1.0, 0.0, 1.0, 0.5, 0)
        when last = relu_grad_at(-1.0, 0.0, 1.0, 0.5, 2)
        then first == 0.5 and relu_grad_at(-1.0, 0.0, 1.0, 0.5, 1) == 0.5 and last == 1.0

    // away from the kink, backward is the slope of forward (both branches)
    test backward_matches_finite_difference
        given neg = (relu_at(-0.999, 0.0, 0.0, 0.2, 0) - relu_at(-1.001, 0.0, 0.0, 0.2, 0)) / 0.002
        when pos = (relu_at(1.001, 0.0, 0.0, 0.2, 0) - relu_at(0.999, 0.0, 0.0, 0.2, 0)) / 0.002
        then @abs(relu_grad_at(-1.0, 0.0, 0.0, 0.2, 0) - neg) < 0.001 and @abs(relu_grad_at(1.0, 0.0, 0.0, 0.2, 0) - pos) < 0.001

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    invariant relu_zero_is_the_gate
        assert ZERO == 0.0

    // NOT CHECKED here (were `then true` over an undefined valid_input()):
    // input.len == output.len for every caller; all inputs finite.
