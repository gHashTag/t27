// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// GELU, tanh approximation (Hendrycks & Gimpel 2016, eq. 2); the exact erf form is gelu_activation | φ² + 1/φ² = 3 | TRINITY

module GeluApprox;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const SQRT_2_OVER_PI : f32 = 0.7978845608;
    const TANH_COEF : f32 = 0.044715;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const GELUApproxConfig = struct {
        none : void,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // tanh(z) = 1 - 2 / (e^(2z) + 1). Zig has no tanh builtin, so the old
    // `math::tanh` named nothing; this form saturates without inf/inf NaN.
    fn tanh(z: f32) -> f32 {
        return 1.0 - 2.0 / (@exp(2.0 * z) + 1.0);
    }

    // forward(x: f32) → f32
    fn forward(x: f32) -> f32 {
        // GELU approximation: 0.5 * x * (1 + tanh(√(2/π) * (x + 0.044715 * x³)))
        let x_cubed = x * x * x;
        let inner = x + TANH_COEF * x_cubed;
        let tanh_arg = SQRT_2_OVER_PI * inner;
        let tanh_val = tanh(tanh_arg);
        let result = 0.5 * x * (1.0 + tanh_val);
        return result;
    }

    // forward_batch(input: []const f32, output: []f32) -> void
    // Was `-> []f32` writing into `[]f32{}`, a zero-length slice: every
    // non-empty input indexed past its end. The caller owns the output now.
    fn forward_batch(input: []const f32, output: []f32) -> void {
        var i : usize = 0;
        while (i < input.len) {
            output[i] = forward(input[i]);
            i = i + 1;
        }
    }

    fn batch_of_three(index: usize) -> f32 {
        const input : [3]f32 = [1.0, -1.0, 0.5];
        var output : [3]f32 = [0.0] ** 3;
        forward_batch(&input, &output);
        return output[index];
    }

    // derivative(x: f32) → f32
    fn derivative(x: f32) -> f32 {
        // Derivative of GELU approximation
        let x_cubed = x * x * x;
        let inner = x + TANH_COEF * x_cubed;
        let tanh_arg = SQRT_2_OVER_PI * inner;
        let tanh_val = tanh(tanh_arg);
        let sech_squared = 1.0 - tanh_val * tanh_val;
        
        let term1 = 0.5 * (1.0 + tanh_val);
        let derivative_inner = SQRT_2_OVER_PI * (1.0 + 3.0 * TANH_COEF * x * x);
        let term2 = 0.5 * x * sech_squared * derivative_inner;
        
        let result = term1 + term2;
        return result;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test forward_zero_input
        given input = 0.0
        when result = forward(input)
        then result == 0.0

    test forward_positive_input
        given input = 1.0
        when result = forward(input)
        then result > 0.0 and result < 1.0

    test forward_negative_input
        given input = -1.0
        when result = forward(input)
        then result < 0.0 and result > -1.0

    // published value of the tanh form at 1 (exact erf GELU(1) = 0.8413447)
    test forward_reference_value_at_one
        given input = 1.0
        when result = forward(input)
        then abs(result - 0.8411920) < 0.00001

    // the tanh form satisfies gelu(x) - gelu(-x) = x exactly (tanh is odd)
    test forward_odd_part_is_identity
        given input = 1.3
        when result = forward(input) - forward(-input)
        then abs(result - input) < 0.00001

    test forward_saturates_without_overflow
        given input = 50.0
        when result = forward(input)
        then result == 50.0 and forward(-input) == 0.0

    test forward_batch_matches_forward
        given first = batch_of_three(0)
        when result = batch_of_three(1)
        then first == forward(1.0) and result == forward(-1.0) and batch_of_three(2) == forward(0.5)

    test derivative_zero_input
        given input = 0.0
        when result = derivative(input)
        then result > 0.0 and result < 1.0

    test derivative_positive_input
        given input = 1.0
        when result = derivative(input)
        then result > 0.0 and result < 1.5

    // GELU dips below zero: exact GELU'(-1) = Phi(-1) - phi(1) = -0.0833.
    // This test used to claim result > 0, which the lab showed false.
    test derivative_negative_input
        given input = -1.0
        when result = derivative(input)
        then result < 0.0 and result > -0.1

    // derivative must be the slope of forward: central difference
    test derivative_matches_finite_difference
        given slope = (forward(0.701) - forward(0.699)) / 0.002
        when result = derivative(0.7)
        then abs(result - slope) < 0.001

    test derivative_negative_matches_finite_difference
        given slope = (forward(-1.499) - forward(-1.501)) / 0.002
        when result = derivative(-1.5)
        then abs(result - slope) < 0.001
