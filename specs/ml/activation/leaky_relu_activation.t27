// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Piecewise derivative | φ² + 1/φ² = 3 | TRINITY

module LeakyRelu;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_ALPHA : f32 = 0.01;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const LeakyReLUConfig = struct {
        alpha : f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // forward(x: f32, alpha: f32) → f32
    fn forward(x: f32, alpha: f32) -> f32 {
        if x > 0.0 {
            return x;
        } else {
            return alpha * x;
        }
    }

    // forward_batch(input: []const f32, alpha: f32, output: []f32) -> void
    // Was `alloc(input.length)` + `for i in range(...)`: neither alloc, range
    // nor .length exists here (lab-exec: UNDECLARED). Caller owns output.
    fn forward_batch(input: []const f32, alpha: f32, output: []f32) -> void {
        var i : usize = 0;
        while (i < input.len) {
            output[i] = forward(input[i], alpha);
            i = i + 1;
        }
    }

    fn batch_at(a: f32, b: f32, c: f32, alpha: f32, index: usize) -> f32 {
        const input : [3]f32 = [a, b, c];
        var output : [3]f32 = [0.0] ** 3;
        forward_batch(&input, alpha, &output);
        return output[index];
    }

    // derivative(x: f32, alpha: f32) → f32
    fn derivative(x: f32, alpha: f32) -> f32 {
        if x > 0.0 {
            return 1.0;
        } else {
            return alpha;
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test forward_positive_input
        given x = 5.0, alpha = 0.01
        when result = forward(x, alpha)
        then result == 5.0

    test forward_negative_input
        given x = -5.0, alpha = 0.01
        when result = forward(x, alpha)
        then @abs(result + 0.05) < 0.0000001

    test forward_zero_input
        given x = 0.0, alpha = 0.01
        when result = forward(x, alpha)
        then result == 0.0

    test forward_batch_positive_inputs
        given first = batch_at(1.0, 2.0, 3.0, 0.01, 0)
        when last = batch_at(1.0, 2.0, 3.0, 0.01, 2)
        then first == 1.0 and batch_at(1.0, 2.0, 3.0, 0.01, 1) == 2.0 and last == 3.0

    test forward_batch_negative_inputs
        given first = batch_at(-1.0, -2.0, -3.0, 0.01, 0)
        when last = batch_at(-1.0, -2.0, -3.0, 0.01, 2)
        then @abs(first + 0.01) < 0.0000001 and @abs(batch_at(-1.0, -2.0, -3.0, 0.01, 1) + 0.02) < 0.0000001 and @abs(last + 0.03) < 0.0000001

    test forward_batch_mixed_inputs
        given first = batch_at(-1.0, 0.0, 1.0, 0.01, 0)
        when last = batch_at(-1.0, 0.0, 1.0, 0.01, 2)
        then @abs(first + 0.01) < 0.0000001 and batch_at(-1.0, 0.0, 1.0, 0.01, 1) == 0.0 and last == 1.0

    // away from the kink, derivative is the slope of forward
    test derivative_matches_finite_difference
        given neg = (forward(-1.999, 0.2) - forward(-2.001, 0.2)) / 0.002
        when pos = (forward(2.001, 0.2) - forward(1.999, 0.2)) / 0.002
        then @abs(derivative(-2.0, 0.2) - neg) < 0.001 and @abs(derivative(2.0, 0.2) - pos) < 0.001

    test derivative_positive_input
        given x = 5.0, alpha = 0.01
        when result = derivative(x, alpha)
        then result == 1.0

    test derivative_negative_input
        given x = -5.0, alpha = 0.01
        when result = derivative(x, alpha)
        then result == 0.01

    test derivative_zero_input
        given x = 0.0, alpha = 0.01
        when result = derivative(x, alpha)
        then result == 0.01

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    invariant leaky_relu_default_alpha_in_range
        assert DEFAULT_ALPHA > 0.0 and DEFAULT_ALPHA < 1.0

    // NOT CHECKED here (were `then true` over an undefined valid_input()):
    // 0 < alpha < 1 for every caller; formula per Maas et al. (2013).
