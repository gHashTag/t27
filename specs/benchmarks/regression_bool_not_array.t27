// specs/benchmarks/regression_bool_not_array.t27 -- regression spec for issue #6574
// Issue 2: `!a[i]` on a bool array element is emitted as `== 0`, which is a type error.

module regression_bool_not_array;

pub const ARRAY_SIZE : u64 = 10;

pub fn test_bool_array_negation() -> u64 {
    var bool_array : [10]bool = [false; 10];
    var count : u64 = 0;
    
    // Set some elements to true
    bool_array[2] = true;
    bool_array[5] = true;
    bool_array[7] = true;
    
    // This should work: count the number of false elements using ! operator
    var i : u64 = 0;
    while (i < ARRAY_SIZE) {
        if (!bool_array[i]) {  // This is the problematic line - should emit !bool_array[i] not bool_array[i] == 0
            count = count + 1;
        }
        i = i + 1;
    }
    
    return count;
}

test test_bool_array_negation_check {
    assert_eq(test_bool_array_negation(), 7);  // 10 total - 3 true = 7 false
}

endmodule