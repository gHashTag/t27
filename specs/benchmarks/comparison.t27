// t27/specs/benchmarks/comparison.t27
// Competitor Comparison Benchmark Suite
// Compares TRINITY accuracy against DeepProbLog and Tensor Logic
// φ² + 1/φ² = 3 | TRINITY

module ComparisonBenchmark {
    // Import accuracy benchmarks
    use benchmarks::accuracy;

    // ═════════════════════════════════════════════════════════════════
    // 1. Competitor Reference Data
    // ═════════════════════════════════════════════════════════════════════════

    // DeepProbLog reference accuracies (from published papers)
    const DEEPPROBLOG_MNIST_2023 : f64 = 0.982;  // 98.2% on MNIST
    const DEEPPROBLOG_CIFAR_2023 : f64 = 0.871;  // 87.1% on CIFAR-10
    const DEEPPROBLOG_WIKISQL : f64 = 0.843;     // 84.3% on WikiSQL

    // Tensor Logic reference accuracies
    const TENSORLOGIC_MNIST_2024 : f64 = 0.985;  // 98.5% on MNIST
    const TENSORLOGIC_CIFAR_2024 : f64 = 0.895;  // 89.5% on CIFAR-10

    // REASON (Prolog-based) reference accuracies
    const REASON_MNIST_2022 : f64 = 0.976;       // 97.6% on MNIST
    const REASON_CIFAR_2022 : f64 = 0.865;       // 86.5% on CIFAR-10

    // ═════════════════════════════════════════════════════════════════
    // 2. Comparison Results
    // ═════════════════════════════════════════════════════════════════════════

    struct CompetitorDelta {
        name : []const u8,          // Competitor name
        trinity_acc : f64,          // TRINITY measured accuracy
        competitor_acc : f64,       // Competitor reference accuracy
        delta : f64,                // TRINITY - competitor
        delta_pct : f64,            // Percentage difference
        is_parity : bool,           // Within ±2% threshold
    }

    struct ComparisonTable {
        mnist_vs_deepproblog : CompetitorDelta,
        mnist_vs_tensorlogic : CompetitorDelta,
        mnist_vs_reason : CompetitorDelta,
        cifar_vs_deepproblog : CompetitorDelta,
        cifar_vs_tensorlogic : CompetitorDelta,
        cifar_vs_reason : CompetitorDelta,
        overall_winner : []const u8,
        overall_parity : bool,
    }

    // ═════════════════════════════════════════════════════════════════
    // 3. Comparison Functions
    // ═════════════════════════════════════════════════════════════════════════

    // compare_vs_deepproblog(trinity_acc: f64, deepproblog_ref: f64, name: []const u8) → CompetitorDelta
    // Compare TRINITY accuracy against DeepProbLog reference
    fn compare_vs_deepproblog(trinity_acc: f64, deepproblog_ref: f64, name: []const u8) -> CompetitorDelta {
        const delta = trinity_acc - deepproblog_ref;
        const delta_pct = delta * 100.0;
        const is_parity = delta >= -0.02 and delta <= 0.02;

        return CompetitorDelta{
            .name = "DeepProbLog",
            .trinity_acc = trinity_acc,
            .competitor_acc = deepproblog_ref,
            .delta = delta,
            .delta_pct = delta_pct,
            .is_parity = is_parity,
        };
    }

    // compare_vs_tensorlogic(trinity_acc: f64, tensorlogic_ref: f64) → CompetitorDelta
    // Compare TRINITY accuracy against Tensor Logic reference
    fn compare_vs_tensorlogic(trinity_acc: f64, tensorlogic_ref: f64) -> CompetitorDelta {
        const delta = trinity_acc - tensorlogic_ref;
        const delta_pct = delta * 100.0;
        const is_parity = delta >= -0.02 and delta <= 0.02;

        return CompetitorDelta{
            .name = "TensorLogic",
            .trinity_acc = trinity_acc,
            .competitor_acc = tensorlogic_ref,
            .delta = delta,
            .delta_pct = delta_pct,
            .is_parity = is_parity,
        };
    }

    // compare_vs_reason(trinity_acc: f64, reason_ref: f64) → CompetitorDelta
    // Compare TRINITY accuracy against REASON reference
    fn compare_vs_reason(trinity_acc: f64, reason_ref: f64) -> CompetitorDelta {
        const delta = trinity_acc - reason_ref;
        const delta_pct = delta * 100.0;
        const is_parity = delta >= -0.02 and delta <= 0.02;

        return CompetitorDelta{
            .name = "REASON",
            .trinity_acc = trinity_acc,
            .competitor_acc = reason_ref,
            .delta = delta,
            .delta_pct = delta_pct,
            .is_parity = is_parity,
        };
    }

    // ═════════════════════════════════════════════════════════════════
    // 4. Full Comparison Table
    // ═════════════════════════════════════════════════════════════════════════

    // generate_comparison_table() → ComparisonTable
    // Generate full comparison table against all competitors
    fn generate_comparison_table() -> ComparisonTable {
        // Run TRINITY benchmarks
        const trinity_report = accuracy::run_all_accuracy_benchmarks();
        const trinity_mnist = trinity_report.mnist_accuracy.accuracy;
        const trinity_cifar = trinity_report.cifar10_accuracy.accuracy;

        // MNIST comparisons
        const mnist_dpl = compare_vs_deepproblog(trinity_mnist, DEEPPROBLOG_MNIST_2023, "DeepProbLog");
        const mnist_tl = compare_vs_tensorlogic(trinity_mnist, TENSORLOGIC_MNIST_2024);
        const mnist_rsn = compare_vs_reason(trinity_mnist, REASON_MNIST_2022);

        // CIFAR-10 comparisons
        const cifar_dpl = compare_vs_deepproblog(trinity_cifar, DEEPPROBLOG_CIFAR_2023, "DeepProbLog");
        const cifar_tl = compare_vs_tensorlogic(trinity_cifar, TENSORLOGIC_CIFAR_2024);
        const cifar_rsn = compare_vs_reason(trinity_cifar, REASON_CIFAR_2022);

        // Determine overall winner (best average delta)
        var best_delta : f64 = -999.0;
        var winner : []const u8 = "TRINITY";

        // Check each competitor
        if (mnist_dpl.delta > best_delta) { best_delta = mnist_dpl.delta; winner = "DeepProbLog"; }
        if (mnist_tl.delta > best_delta) { best_delta = mnist_tl.delta; winner = "TensorLogic"; }
        if (mnist_rsn.delta > best_delta) { best_delta = mnist_rsn.delta; winner = "REASON"; }

        // Overall parity: TRINITY within 2% of at least 2 competitors
        const parity_count = @boolToInt(mnist_dpl.is_parity) + @boolToInt(cifar_dpl.is_parity) +
                             @boolToInt(mnist_tl.is_parity) + @boolToInt(cifar_tl.is_parity);
        const overall_parity = parity_count >= 2;

        return ComparisonTable{
            .mnist_vs_deepproblog = mnist_dpl,
            .mnist_vs_tensorlogic = mnist_tl,
            .mnist_vs_reason = mnist_rsn,
            .cifar_vs_deepproblog = cifar_dpl,
            .cifar_vs_tensorlogic = cifar_tl,
            .cifar_vs_reason = cifar_rsn,
            .overall_winner = winner,
            .overall_parity = overall_parity,
        };
    }

    // ═════════════════════════════════════════════════════════════════
    // 5. Formatting Functions
    // ═════════════════════════════════════════════════════════════════════════

    // format_comparison_row(delta: CompetitorDelta) → []const u8
    // Format a single comparison row for table output
    fn format_comparison_row(delta: CompetitorDelta) -> []const u8 {
        var buffer : [256]u8 = undefined;
        var offset : usize = 0;

        // Competitor name
        var i : usize = 0;
        while (i < delta.name.len and offset < 250) {
            buffer[offset] = delta.name[i];
            offset = offset + 1;
            i = i + 1;
        }

        // " | TRINITY: "
        const header = " | TRINITY: ";
        i = 0;
        while (i < header.len and offset < 250) {
            buffer[offset] = header[i];
            offset = offset + 1;
            i = i + 1;
        }

        // TRINITY accuracy
        const acc_int = @intFromFloat(delta.trinity_acc * 100.0);
        buffer[offset] = '0' + (acc_int / 100) % 10; offset = offset + 1;
        buffer[offset] = '.'; offset = offset + 1;
        buffer[offset] = '0' + (acc_int / 10) % 10; offset = offset + 1;
        buffer[offset] = '0' + acc_int % 10; offset = offset + 1;
        buffer[offset] = '%'; offset = offset + 1;

        // " vs "
        buffer[offset] = ' '; offset = offset + 1;
        buffer[offset] = 'v'; offset = offset + 1;
        buffer[offset] = 's'; offset = offset + 1;
        buffer[offset] = ' '; offset = offset + 1;

        // Competitor accuracy
        const comp_int = @intFromFloat(delta.competitor_acc * 100.0);
        buffer[offset] = '0' + (comp_int / 100) % 10; offset = offset + 1;
        buffer[offset] = '.'; offset = offset + 1;
        buffer[offset] = '0' + (comp_int / 10) % 10; offset = offset + 1;
        buffer[offset] = '0' + comp_int % 10; offset = offset + 1;
        buffer[offset] = '%'; offset = offset + 1;

        // " | Δ: "
        const delta_header = " | Δ: ";
        i = 0;
        while (i < delta_header.len and offset < 250) {
            buffer[offset] = delta_header[i];
            offset = offset + 1;
            i = i + 1;
        }

        // Delta (with sign)
        if (delta.delta > 0) {
            buffer[offset] = '+'; offset = offset + 1;
        } else if (delta.delta < 0) {
            buffer[offset] = '-'; offset = offset + 1;
        }

        const delta_abs = @abs(delta.delta);
        const delta_int = @intFromFloat(delta_abs * 100.0);
        if (delta_int >= 100) {
            buffer[offset] = '0' + (delta_int / 100) % 10; offset = offset + 1;
        }
        buffer[offset] = '0' + (delta_int / 10) % 10; offset = offset + 1;
        buffer[offset] = '0' + delta_int % 10; offset = offset + 1;
        buffer[offset] = '%'; offset = offset + 1;

        // Parity indicator
        if (delta.is_parity) {
            buffer[offset] = ' '; offset = offset + 1;
            buffer[offset] = '['; offset = offset + 1;
            buffer[offset] = 'P'; offset = offset + 1;
            buffer[offset] = 'A'; offset = offset + 1;
            buffer[offset] = 'R'; offset = offset + 1;
            buffer[offset] = 'I'; offset = offset + 1;
            buffer[offset] = 'T'; offset = offset + 1;
            buffer[offset] = 'Y'; offset = offset + 1;
            buffer[offset] = ']'; offset = offset + 1;
        }

        return buffer[0..offset];
    }

    // format_full_comparison_report() → []const u8
    // Generate formatted comparison report
    fn format_full_comparison_report() -> []const u8 {
        const table = generate_comparison_table();

        var buffer : [4096]u8 = undefined;
        var offset : usize = 0;

        // Header
        const header = "=== TRINITY vs Competitor Accuracy Comparison ===\n";
        var i : usize = 0;
        while (i < header.len) {
            buffer[offset] = header[i];
            offset = offset + 1;
            i = i + 1;
        }

        // MNIST section
        const mnist_header = "\n--- MNIST Classification ---\n";
        i = 0;
        while (i < mnist_header.len and offset < 4000) {
            buffer[offset] = mnist_header[i];
            offset = offset + 1;
            i = i + 1;
        }

        const mnist_dpl_row = format_comparison_row(table.mnist_vs_deepproblog);
        i = 0;
        while (i < mnist_dpl_row.len and offset < 4000) {
            buffer[offset] = mnist_dpl_row[i];
            offset = offset + 1;
            i = i + 1;
        }
        buffer[offset] = '\n'; offset = offset + 1;

        const mnist_tl_row = format_comparison_row(table.mnist_vs_tensorlogic);
        i = 0;
        while (i < mnist_tl_row.len and offset < 4000) {
            buffer[offset] = mnist_tl_row[i];
            offset = offset + 1;
            i = i + 1;
        }
        buffer[offset] = '\n'; offset = offset + 1;

        const mnist_rsn_row = format_comparison_row(table.mnist_vs_reason);
        i = 0;
        while (i < mnist_rsn_row.len and offset < 4000) {
            buffer[offset] = mnist_rsn_row[i];
            offset = offset + 1;
            i = i + 1;
        }
        buffer[offset] = '\n'; offset = offset + 1;

        // CIFAR-10 section
        const cifar_header = "\n--- CIFAR-10 Classification ---\n";
        i = 0;
        while (i < cifar_header.len and offset < 4000) {
            buffer[offset] = cifar_header[i];
            offset = offset + 1;
            i = i + 1;
        }

        const cifar_dpl_row = format_comparison_row(table.cifar_vs_deepproblog);
        i = 0;
        while (i < cifar_dpl_row.len and offset < 4000) {
            buffer[offset] = cifar_dpl_row[i];
            offset = offset + 1;
            i = i + 1;
        }
        buffer[offset] = '\n'; offset = offset + 1;

        const cifar_tl_row = format_comparison_row(table.cifar_vs_tensorlogic);
        i = 0;
        while (i < cifar_tl_row.len and offset < 4000) {
            buffer[offset] = cifar_tl_row[i];
            offset = offset + 1;
            i = i + 1;
        }
        buffer[offset] = '\n'; offset = offset + 1;

        const cifar_rsn_row = format_comparison_row(table.cifar_vs_reason);
        i = 0;
        while (i < cifar_rsn_row.len and offset < 4000) {
            buffer[offset] = cifar_rsn_row[i];
            offset = offset + 1;
            i = i + 1;
        }
        buffer[offset] = '\n'; offset = offset + 1;

        // Summary
        const summary = "\n=== Summary ===\n";
        i = 0;
        while (i < summary.len and offset < 4000) {
            buffer[offset] = summary[i];
            offset = offset + 1;
            i = i + 1;
        }

        const status = if (table.overall_parity) "STATUS: PARITY ACHIEVED (within ±2%)" else "STATUS: PARITY NOT ACHIEVED";
        i = 0;
        while (i < status.len and offset < 4000) {
            buffer[offset] = status[i];
            offset = offset + 1;
            i = i + 1;
        }

        return buffer[0..offset];
    }

    // ═════════════════════════════════════════════════════════════════
    // TDD - Tests
    // ═════════════════════════════════════════════════════════════════════════

    test deepproblog_references_defined
        given mnist = DEEPPROBLOG_MNIST_2023
        and   cifar = DEEPPROBLOG_CIFAR_2023
        then mnist == 0.982 and cifar == 0.871

    test tensorlogic_references_defined
        given mnist = TENSORLOGIC_MNIST_2024
        and   cifar = TENSORLOGIC_CIFAR_2024
        then mnist == 0.985 and cifar == 0.895

    test reason_references_defined
        given mnist = REASON_MNIST_2022
        and   cifar = REASON_CIFAR_2022
        then mnist == 0.976 and cifar == 0.865

    test compare_vs_deepproblog_parity_within_threshold
        given delta = compare_vs_deepproblog(0.980, 0.982, "MNIST")
        then delta.is_parity == true  // -0.002 is within ±0.02

    test compare_vs_deepproblog_no_parity_outside_threshold
        given delta = compare_vs_deepproblog(0.950, 0.982, "MNIST")
        then delta.is_parity == false  // -0.032 is outside ±0.02

    test delta_calculation_positive
        given delta = compare_vs_tensorlogic(0.990, 0.985)
        then delta.delta == 0.005

    test delta_calculation_negative
        given delta = compare_vs_tensorlogic(0.980, 0.985)
        then delta.delta == -0.005

    test overall_parity_requires_two_matches
        // Simulate table with 2 parity matches
        given parity_count = 2
        and   overall_parity = parity_count >= 2
        then overall_parity == true

    // ═════════════════════════════════════════════════════════════════
    // TDD - Benchmarks
    // ═════════════════════════════════════════════════════════════════════════

    bench comparison_table_generation
        measure: microseconds to generate_comparison_table()
        target: < 100  // Should be fast (just arithmetic)

    bench full_report_formatting
        measure: microseconds to format_full_comparison_report()
        target: < 500  // String formatting overhead
}
