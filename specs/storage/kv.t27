//! Simple key-value storage.
//!
//! # Example
//!
//! ```
//! use storage::kv;
//!
//! // Write a value.
//! kv::write(["hello", "world"], "foo");
//!
//! // Read the value.
//! assert_eq!(kv::read(["hello", "world"]).unwrap(), "foo");
//!
//! // Update the value.
//! kv::update(["hello", "world"], |val| {
//!     *val = val.to_uppercase();
//! });
//! assert_eq!(kv::read(["hello", "world"]).unwrap(), "FOO");
//!
//! // Remove the value.
//! kv::remove(["hello", "world"]);
//! assert!(kv::read(["hello", "world"]).is_err());
//! */

