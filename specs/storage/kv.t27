module StorageKv {
      use base::types;
      use storage::schema;
      use tri::collections of result;

      // φ² + 1/φ² = 3 | TRINITY
      // ######################################################################
      // Storage key-value store implementation.
      // ######################################################################

      type StorageKV = struct {
          store: map<Str, StorageKVEntry>,
      };

      type StorageKVEntry = struct {
          value: Str,
          version: Nat,
      };

      pub fn init() -> StorageKV {
          return StorageKV {
              store: map.new(),
          };
      }

      pub fn get(self: &StorageKV, key: Str) -> Result<void, StorageError> {
          match self.store.get(key) {
              case none => {
                  return Result::err(StorageError { msg: "Key not found" });
              }
              case some(entry) => {
                  return Result::ok(entry.value);
              }
          }
      }

      pub fn set(self: &StorageKV, key: Str, value: Str) -> Result<void, StorageError> {
          self.store.set(key, StorageKVEntry {
              value: value,
              version: self.store.get(key).map(|e| e.version + 1).unwrap_or(0),
          });
          return Result::ok(());
      }

      pub fn del(self: &StorageKV, key: Str) -> Result<void, StorageError> {
          match self.store.get(key) {
              case none => {
                  return Result::err(StorageError { msg: "Key not found" });
              }
              case some(_) => {
                  self.store.del(key);
                  return Result::ok(());
              }
          }
      }

      #[test]
      pub fn test_basic() {
          let kv = StorageKV::init();
          let _ = kv.set("hello", "world");
          match kv.get("hello") {
              case ok(v) => {
                  assert(v == "world");
              }
              case err => {
                  assert(false);
              }
          }
          match kv.get("nonexistent") {
              case ok(_) => {
                  assert(false);
              }
              case err => {
                  assert(true);
              }
          }
          let _ = kv.del("hello");
          match kv.get("hello") {
              case ok(_) => {
                  assert(false);
              }
              case err => {
                  assert(true);
              }
          }
      }
  }