#[test]
fn read_nonexistent_returns_err() {
    let result = read<str>(["nonexistent", "key"]);
    assert!(result.is_err());
}

#[test]
fn read_returns_written_value() {
    let _ = write<str>(["test", "key"], "value");
    let result = read<str>(["test", "key"]);
    assert!(result.is_ok());
    assert_eq!(result.unwrap(), "value");
}

#[test]
fn read_after_write_is_consistent() {
    let _ = write<str>(["consistency", "test"], "initial");
    let _ = update<str>(["consistency", "test"], |val| {
        *val = val + "_updated";
    });
    let result = read<str>(["consistency", "test"]);
    assert!(result.is_ok());
    assert_eq!(result.unwrap(), "initial_updated");
}

#[test]
fn remove_makes_read_err() {
    let _ = write<str>(["remove", "test"], "value");
    let _ = remove<str>(["remove", "test"]);
    let result = read<str>(["remove", "test"]);
    assert!(result.is_err());
}

#[test]
fn list_returns_written_keys() {
    let _ = write<str>(["list", "test", "key1"], "value1");
    let _ = write<str>(["list", "test", "key2"], "value2");
    let result = list<str>(["list", "test"]);
    assert!(result.is_ok());
    let mut keys = result.unwrap();
    keys.sort();
    assert_eq!(keys, [["list", "test", "key1"], ["list", "test", "key2"]]);
}

#[test]
fn list_nonexistent_prefix_returns_empty() {
    let result = list<str>(["nonexistent", "prefix"]);
    assert!(result.is_ok());
    assert_eq!(result.unwrap().len(), 0);
}

#[test]
fn exists_returns_true_for_existing_key() {
    let key = ["test", "exists"];
    let _ = write<str>(key, "value");
    let result = exists<str>(key);
    assert!(result.is_ok());
    assert_eq!(result.unwrap(), true);
}

#[test]
fn exists_returns_false_for_missing_key() {
    let result = exists<str>(["does", "not", "exist"]);
    assert!(result.is_ok());
    assert_eq!(result.unwrap(), false);
}

#[test]
fn batch_write_then_read() {
    let entries = [
        (["test", "batch", "key1"], "value1"),
        (["test", "batch", "key2"], "value2"),
    ];
    let _ = batch_write<str>(entries);
    let result1 = read<str>(["test", "batch", "key1"]);
    let result2 = read<str>(["test", "batch", "key2"]);
    assert!(result1.is_ok());
    assert!(result2.is_ok());
    assert_eq!(result1.unwrap(), "value1");
    assert_eq!(result2.unwrap(), "value2");
}

#[test]
fn batch_read_returns_written_values() {
    let _ = write<str>(["batch", "read", "key1"], "value1");
    let _ = write<str>(["batch", "read", "key2"], "value2");
    let keys = [["batch", "read", "key1"], ["batch", "read", "key2"]];
    let result = batch_read<str>(keys);
    assert!(result.is_ok());
    let mut values = result.unwrap();
    values.sort();
    assert_eq!(values, ["value1", "value2"]);
}

#[test]
fn batch_read_returns_none_for_missing_keys() {
    let keys = [["batch", "read", "nonexistent", "key1"], ["batch", "read", "nonexistent", "key2"]];
    let result = batch_read<str>(keys);
    assert!(result.is_ok());
    let values = result.unwrap();
    assert_eq!(values.len(), 2);
    assert!(values[0].is_none());
    assert!(values[1].is_none());
}