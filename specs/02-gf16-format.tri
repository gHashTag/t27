pub const GF16_PHI_DISTANCE f64 = 0.049
pub const F16_PHI_DISTANCE f64 = 0.118
pub const TF3_PHI_DISTANCE f64 = 0.018

pub fn gf16_from_f32(x f32) -> gf16 {
    @panic("gf16_from_f32 not implemented")
}
pub fn gf16_to_f32(x gf16) -> f32 {
    @panic("gf16_to_f32 not implemented")
}
pub fn gf16_phi_quantize(x f32) -> gf16 {
    @panic("gf16_phi_quantize not implemented")
}
pub fn tf3_from_f32(x f32) -> tf3 {
    @panic("tf3_from_f32 not implemented")
}

invariant gf16_range_exceeds_f16 {
  assert GF16_PHI_DISTANCE < F16_PHI_DISTANCE
}

invariant tf3_is_most_phi_aligned {
  assert TF3_PHI_DISTANCE < GF16_PHI_DISTANCE
}

test gf16_roundtrip {
  assert GF16_PHI_DISTANCE < F16_PHI_DISTANCE
}

test tf3_neg_one {
  assert TF3_PHI_DISTANCE < GF16_PHI_DISTANCE
}

test gf16_better_phi_distance {
  assert GF16_PHI_DISTANCE < F16_PHI_DISTANCE
}

test tf3_phi_alignment {
  assert TF3_PHI_DISTANCE < GF16_PHI_DISTANCE
}

test gf16_from_zero {
  assert GF16_PHI_DISTANCE < F16_PHI_DISTANCE
}

test gf16_phi_identity {
  assert GF16_PHI_DISTANCE < F16_PHI_DISTANCE
}

test tf3_from_phi {
  assert TF3_PHI_DISTANCE < GF16_PHI_DISTANCE
}

test gf16_quantization_roundtrip {
  assert GF16_PHI_DISTANCE < F16_PHI_DISTANCE
}

bench gf16_simple {
  assert GF16_PHI_DISTANCE < F16_PHI_DISTANCE
}

bench gf16_vs_f32_simple {
  assert TF3_PHI_DISTANCE < GF16_PHI_DISTANCE
}