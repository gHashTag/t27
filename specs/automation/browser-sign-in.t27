// SPDX-License-Identifier: Apache-2.0
// specs/automation/browser-sign-in.t27 -- how the agent signs its person into a social
// network through their own browser, and why the second sign-in is the fast one.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/browser/sign-in.ts (DOORS,
//       PLAYBOOK, RULES, playbookFor, signedIn), logins.ts (NETWORKS, cookie names,
//       LOGINS_NOTE), recipes.ts (rememberPress, learnedLabel, learnedHere),
//       agent-tools.ts (browser_sign_in, browser_ask_input, browser_click).
// WHY this spec exists: 2026-09-24..26 the owner could not be signed into anything through
// the agent, and two separate defects produced that one symptom. First, the browser had
// stopped being a browser while every health signal said it was fine -- that is
// specs/automation/browser-pod-restart.t27, not this file. Second, and the subject here,
// there was no procedure: LOGINS_NOTE told every agent to "follow the sign-in playbook"
// and the words appeared nowhere else in the codebase, so each attempt began from nothing.
// Five permission requests to sign in to one site, ~110 s each, none of which became a
// login; one learned button label in browser_recipes for five networks tried.
// WHY two homes and not one: the ORDER is a constant and lives in code as data; WHAT A
// SITE WANTS is learned by the presses themselves and lives in browser_recipes, because
// the labels are exactly what sites change. Cookie names and domains stay in logins.ts,
// their one home, and are not copied here.
// Claim status: the order, the doors, the rules and the per-site scoping of lessons are
// unit-tested with doubles (a-sign-in-worth-repeating.test.ts, 13 tests). That the
// playbook CARRIES A SIGN-IN TO COMPLETION against a live network is not claimed: no
// sign-in has been completed through it yet.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::browser_sign_in {

    pub const KIND : str = "automation";
    pub const ID : str = "browser-sign-in";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- The order, the same for every site ----------------------------------------------
    pub const STEPS : u8 = 5;
    pub const STEP_1 : str = "browser_open";       // the DOOR: a sign-in page, never a home page
    pub const STEP_2 : str = "browser_read";       // the page as it IS; last month's labels are gone
    pub const STEP_3 : str = "browser_click";      // press the way in by its LABEL; the press is remembered
    pub const STEP_4 : str = "browser_ask_input";  // the PERSON types the email, password and code
    pub const STEP_5 : str = "browser_logins";     // proof: the network's own cookie, or it did not work
    pub const ORDER_IS_THE_SAME_EVERY_SITE : bool = true;
    pub const TOOL : str = "browser_sign_in";      // asks for the plan; opens nothing, presses nothing

    // ---- The two rules that do not bend --------------------------------------------------
    // An agent that types a password is an agent that holds a password. browser_ask_input
    // shows the field to the person; the agent learns that something was typed and its
    // length, never the value.
    pub const PERSON_TYPES_EVERY_SECRET : bool = true;
    pub const AGENT_MAY_TYPE_A_PASSWORD : bool = false;
    pub const SECRET_STEP : str = "browser_ask_input";
    // A site can show a name and a photo to a session it has already revoked, so a friendly
    // page is not proof. Signed in means logins.ts saw the network's login cookie.
    pub const COOKIE_IS_THE_PROOF : bool = true;
    pub const A_FRIENDLY_PAGE_IS_PROOF : bool = false;
    pub const STATE_SIGNED_IN : str = "signed_in";
    pub const STATE_EXPIRED_IS_NOT_SIGNED_IN : bool = true;
    // The browser being off reads as unreadable, not as signed out: signed_out would send an
    // agent to sign a person in who is already signed in.
    pub const STATE_UNREADABLE : str = "unreadable";

    // ---- The doors -----------------------------------------------------------------------
    // A sign-in page and not a home page: instagram.com while signed out is a feed-shaped
    // wall that a round reads as "nothing new", and the agent then reports a quiet day
    // instead of a sign-in it could have finished.
    pub const DOORS : u8 = 15;
    pub const DOOR_IS_A_SIGN_IN_PAGE : bool = true;
    pub const EVERY_DOOR_IS_HTTPS : bool = true;
    pub const DOOR_NETWORKS_ARE_KNOWN_TO_THE_LOGINS_READER : bool = true;
    pub const UNKNOWN_DOOR_IS_SAID_PLAINLY : bool = true;  // no invented URL; the order is unchanged
    pub const YOUTUBE_DOOR_IS_GOOGLE : bool = true;        // one account, so its lessons are Google's

    // ---- What a site turned out to want --------------------------------------------------
    // Written by the presses, not declared here: browser_click remembers every successful
    // labelled press, and consults what it learned when the asked words are not on the page.
    pub const LESSONS_ARE_LEARNED_NOT_DECLARED : bool = true;
    pub const LESSON_STORE : str = "browser_recipes";
    pub const LESSON_KEY : str = "host,want";
    pub const LESSONS_ARE_SCOPED_TO_THE_SITE : bool = true;  // a subdomain door still finds its own site's
    pub const NO_SELECTORS_IN_THIS_SPEC : bool = true;       // they age badly; the page is read before it is pressed
    pub const SECOND_SIGN_IN_STARTS_AT_THE_LEARNED_PRESS : bool = true;

    // ---- Live evidence -------------------------------------------------------------------
    // 2026-09-26, the owner's own pod: browser_profiles holds one profile, last used
    // 2026-09-26 11:18:55, on a 50 GB volume mounted at the pod's profile path -- so the
    // logins were never lost while none could be made. browser_recipes held 5 rows, of which
    // exactly one concerned a way in ("upwork.com|continue"): the measure of how little five
    // attempts left behind.
    pub const NOTE_POINTED_AT_NOTHING : bool = true;         // LOGINS_NOTE said "sign-in playbook"; there was none
    pub const PLAYBOOK_NOW_EXISTS : bool = true;
    pub const ATTEMPTS_BEFORE : u8 = 5;
    pub const LOGINS_LEARNED_BEFORE : u8 = 0;
    pub const SIGN_IN_LESSONS_IN_STORE_BEFORE : u8 = 1;
    pub const PROFILE_SURVIVED_THROUGHOUT : bool = true;

    // ---- Not claimed ---------------------------------------------------------------------
    // The plan is tested; a completed sign-in through it is not. Nothing here asserts that a
    // network accepts the person, that a captcha can be passed (it cannot -- the rule is to
    // stop and ask), or that the doors are still the doors: a site may move its sign-in page
    // tomorrow, which is why step 2 reads the page instead of trusting this file.
    pub const SIGN_IN_COMPLETED_LIVE : bool = false;
    pub const CAPTCHA_IS_HANDED_TO_THE_PERSON : bool = true;
    pub const ONE_NETWORK_AT_A_TIME : bool = true;  // three half-finished sign-ins are three dead ends

    // The secret step is the ask, whatever else the plan says.
    fn secret_step_is_an_ask(step: str) -> bool {
        return step == SECRET_STEP;
    }

    // Where a step sits in the order, 1-based.
    fn position(tool: str) -> u8 {
        if tool == STEP_1 { return 1; }
        if tool == STEP_2 { return 2; }
        if tool == STEP_3 { return 3; }
        if tool == STEP_4 { return 4; }
        return 5;
    }

    // Signed in is one state and one state only.
    fn signed_in(state: str) -> bool {
        return state == STATE_SIGNED_IN;
    }

    test "the door is opened, the page is read, and only then is anything pressed"
        assert(STEPS == 5);
        assert(ORDER_IS_THE_SAME_EVERY_SITE);
        assert(position(STEP_2) == position(STEP_1) + 1);
        assert(position(STEP_3) == position(STEP_2) + 1);
        assert(position(STEP_4) == position(STEP_3) + 1);
        assert(position(STEP_5) == STEPS);
        assert(DOOR_IS_A_SIGN_IN_PAGE);
        assert(EVERY_DOOR_IS_HTTPS);

    test "the person types every secret and the agent never does"
        assert(PERSON_TYPES_EVERY_SECRET);
        assert(!AGENT_MAY_TYPE_A_PASSWORD);
        assert(secret_step_is_an_ask(STEP_4));
        assert(!secret_step_is_an_ask(STEP_3));
        assert(CAPTCHA_IS_HANDED_TO_THE_PERSON);

    test "a cookie is the proof, and nothing that merely looks friendly is"
        assert(COOKIE_IS_THE_PROOF);
        assert(!A_FRIENDLY_PAGE_IS_PROOF);
        assert(signed_in(STATE_SIGNED_IN));
        assert(!signed_in("expired"));
        assert(STATE_EXPIRED_IS_NOT_SIGNED_IN);
        assert(!signed_in(STATE_UNREADABLE));

    test "the second sign-in is the fast one, because the presses were remembered"
        assert(LESSONS_ARE_LEARNED_NOT_DECLARED);
        assert(LESSONS_ARE_SCOPED_TO_THE_SITE);
        assert(SECOND_SIGN_IN_STARTS_AT_THE_LEARNED_PRESS);
        assert(NO_SELECTORS_IN_THIS_SPEC);
        assert(DOORS == 15);
        assert(DOOR_NETWORKS_ARE_KNOWN_TO_THE_LOGINS_READER);
        assert(UNKNOWN_DOOR_IS_SAID_PLAINLY);

    test "the playbook exists now; a completed sign-in through it is not claimed"
        assert(NOTE_POINTED_AT_NOTHING);
        assert(PLAYBOOK_NOW_EXISTS);
        assert(!SIGN_IN_COMPLETED_LIVE);
        assert(LOGINS_LEARNED_BEFORE == 0);
        assert(ATTEMPTS_BEFORE == 5);
        assert(SIGN_IN_LESSONS_IN_STORE_BEFORE < ATTEMPTS_BEFORE);
        assert(PROFILE_SURVIVED_THROUGHOUT);
        assert(ONE_NETWORK_AT_A_TIME);
}
