// Review jam cases and Queen's actions
// Generated for gHashTag/t27#9032

pub const JAM_NONE = 0;
pub const JAM_NO_REVIEWER = 1;
pub const JAM_STACKED_ON_OPEN = 2;
pub const JAM_REFUSED_NOT_FIXED = 3;
pub const JAM_REFUSED_THEN_PUSHED = 4;
pub const JAM_LABELED_NOT_MERGED = 5;
pub const JAM_CONFLICTING = 6;
pub const JAM_NOISE_RED = 7;
pub const JAM_DRAFT_OR_FRESH = 8;
pub const JAM_UNMEASURED = 9;

pub const ACT_NOTHING = 0;
pub const ACT_DISPATCH_REVIEWER = 1;
pub const ACT_WAIT_FOR_BASE = 2;
pub const ACT_DISPATCH_CODER = 3;
pub const ACT_DISPATCH_RE_REVIEW = 4;
pub const ACT_FINISH_MERGE = 5;
pub const ACT_REBASE_BY_CODER = 6;
pub const ACT_NAME_NOISE_AND_REVIEW = 7;
pub const ACT_WAIT = 8;
pub const ACT_MEASURE_AGAIN = 9;

pub fn jam_case(measured: bool, draft_or_fresh: bool, stacked_on_open: bool, conflicting: bool, labeled_reviewed: bool, refused: bool, pushed_after_refusal: bool, has_reviewer: bool, only_noise_red: bool) -> u8 {
    if (!measured) {
        return JAM_UNMEASURED;
    }
    if (draft_or_fresh) {
        return JAM_DRAFT_OR_FRESH;
    }
    if (stacked_on_open) {
        return JAM_STACKED_ON_OPEN;
    }
    if (conflicting) {
        return JAM_CONFLICTING;
    }
    if (labeled_reviewed) {
        return JAM_LABELED_NOT_MERGED;
    }
    if (refused && pushed_after_refusal) {
        return JAM_REFUSED_THEN_PUSHED;
    }
    if (refused) {
        return JAM_REFUSED_NOT_FIXED;
    }
    if (only_noise_red) {
        return JAM_NOISE_RED;
    }
    if (!has_reviewer) {
        return JAM_NO_REVIEWER;
    }
    return JAM_NONE;
}

pub fn jam_action(case: u8) -> u8 {
    if (case > 9) {
        return ACT_MEASURE_AGAIN;
    }
    return case;
}

pub fn jam_is_queens_turn(case: u8) -> bool {
    return case != JAM_NONE && case != JAM_DRAFT_OR_FRESH && case != JAM_STACKED_ON_OPEN;
}

test "unmeasured beats everything" {
    var result = jam_case(false, false, false, false, false, false, false, false, false);
    assert(result == JAM_UNMEASURED);
}

test "draft or fresh" {
    var result = jam_case(true, true, false, false, false, false, false, false, false);
    assert(result == JAM_DRAFT_OR_FRESH);
}

test "stacked on open" {
    var result = jam_case(true, false, true, false, false, false, false, false, false);
    assert(result == JAM_STACKED_ON_OPEN);
}

test "conflicting" {
    var result = jam_case(true, false, false, true, false, false, false, false, false);
    assert(result == JAM_CONFLICTING);
}

test "labeled not merged" {
    var result = jam_case(true, false, false, false, true, false, false, false, false);
    assert(result == JAM_LABELED_NOT_MERGED);
}

test "refused then pushed" {
    var result = jam_case(true, false, false, false, false, true, true, false, false);
    assert(result == JAM_REFUSED_THEN_PUSHED);
}

test "refused not fixed" {
    var result = jam_case(true, false, false, false, false, true, false, false, false);
    assert(result == JAM_REFUSED_NOT_FIXED);
}

test "noise red" {
    var result = jam_case(true, false, false, false, false, false, false, false, true);
    assert(result == JAM_NOISE_RED);
}

test "no reviewer" {
    var result = jam_case(true, false, false, false, false, false, false, false, false);
    assert(result == JAM_NO_REVIEWER);
}

test "none" {
    var result = jam_case(true, false, false, false, false, false, false, true, false);
    assert(result == JAM_NONE);
}

test "stacked beats no reviewer" {
    var result = jam_case(true, false, true, false, false, false, false, false, false);
    assert(result == JAM_STACKED_ON_OPEN);
}

test "jam_action mapping" {
    assert(jam_action(JAM_NONE) == ACT_NOTHING);
    assert(jam_action(JAM_NO_REVIEWER) == ACT_DISPATCH_REVIEWER);
    assert(jam_action(JAM_STACKED_ON_OPEN) == ACT_WAIT_FOR_BASE);
    assert(jam_action(JAM_REFUSED_NOT_FIXED) == ACT_DISPATCH_CODER);
    assert(jam_action(JAM_REFUSED_THEN_PUSHED) == ACT_DISPATCH_RE_REVIEW);
    assert(jam_action(JAM_LABELED_NOT_MERGED) == ACT_FINISH_MERGE);
    assert(jam_action(JAM_CONFLICTING) == ACT_REBASE_BY_CODER);
    assert(jam_action(JAM_NOISE_RED) == ACT_NAME_NOISE_AND_REVIEW);
    assert(jam_action(JAM_DRAFT_OR_FRESH) == ACT_WAIT);
    assert(jam_action(JAM_UNMEASURED) == ACT_MEASURE_AGAIN);
}

test "jam_action unknown case" {
    assert(jam_action(200) == ACT_MEASURE_AGAIN);
}

test "jam_is_queens_turn true cases" {
    assert(jam_is_queens_turn(JAM_NO_REVIEWER));
    assert(jam_is_queens_turn(JAM_REFUSED_NOT_FIXED));
    assert(jam_is_queens_turn(JAM_REFUSED_THEN_PUSHED));
    assert(jam_is_queens_turn(JAM_LABELED_NOT_MERGED));
    assert(jam_is_queens_turn(JAM_CONFLICTING));
    assert(jam_is_queens_turn(JAM_NOISE_RED));
    assert(jam_is_queens_turn(JAM_UNMEASURED));
}

test "jam_is_queens_turn false cases" {
    assert(!jam_is_queens_turn(JAM_NONE));
    assert(!jam_is_queens_turn(JAM_DRAFT_OR_FRESH));
    assert(!jam_is_queens_turn(JAM_STACKED_ON_OPEN));
}