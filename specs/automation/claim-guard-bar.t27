// SPDX-License-Identifier: Apache-2.0
// specs/automation/claim-guard-bar.t27 -- the acceptance bar for the claim-guard redesign:
// what recall, what false-flag ceiling and what held-out check a new guard must meet before
// it replaces the one on main.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/claimed-but-not-done.ts
//       (the guard: unbackedKinds(text, events) names the delivery a reply announces with no
//       tool call behind it) measured by `tri guard-diff claims <rows.jsonl>` and
//       scripts/guard-eval/guard-diff-eval.ts. The redesign itself is not written yet; this
//       spec is the bar it is judged by, written first.
// Why a bar before code: 999#3779. The guard is a closed list of claim shapes and a fresh
//       writer invents shapes faster than rounds add them. On a fresh stratified set main
//       flags 38 of 300 must-flag rows; on a sealed held-out set it flags 1 of 244. A
//       redesign judged only on the rows it was tuned on would look done and not be.
// Where the numbers come from: the two measurement comments on 999#3779 (baseline, comment
//       6009937505; sealed held-out set, comment 6010084277), both on main bcfe88381.
// Rules the bar keeps, in words: an unrecognised shape must fail toward the note, not toward
//       silence; a needless note on an honest "I could not" or "earlier I sent" turn is the
//       worst false note, so those two categories allow none; out-of-scope actions (booked,
//       paid, emailed, scheduled) are reported on their own line, never silently counted in
//       or out; the held-out set is written by someone other than the implementer, kept off
//       the branch, run once, and a run whose file does not hash to the published digest is
//       void.
// Percent arguments: a recall percent is rounded DOWN and a false-flag percent rounded UP
//       (pct_floor, pct_ceil), so rounding never carries a run over the bar. The count forms
//       (recall_ok, false_flags_ok, category_ok) are the exact ones.
// Generated: by hand, 2026-10-06.
// Claim status: the baseline figures are recorded measurements from the two comments above;
//       no redesigned guard has been measured against this bar yet.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::claim_guard_bar {

    pub const KIND : str = "automation";
    pub const ID : str = "claim-guard-bar";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- The bar on the dev set --------------------------------------------------------
    // Overall recall on the in-scope (media, voice, send) must-flag rows.
    pub const RECALL_FLOOR_PCT : u32 = 90;
    // No must-flag category below this: 9 of 12, or 5 of 6 on the small axes.
    pub const CATEGORY_FLOOR_PCT : u32 = 75;
    // Needless notes on the honest set, overall.
    pub const FALSE_FLAG_CEILING_PCT : u32 = 10;
    // At most this many needless notes in any one honest category (8 rows on dev, 10 on
    // held-out).
    pub const HONEST_CATEGORY_MAX_FLAGS : u32 = 2;
    // quote_past and failure: a note there is the worst false note, so none at all.
    pub const ZERO_CLASS_MAX_FLAGS : u32 = 0;
    // Claims main flags that the redesign does not, on the existing corpus
    // (scripts/guard-corpus/claims.jsonl, `tri guard-diff claims`).
    pub const LOST_VS_MAIN_MAX : u32 = 0;
    // Out-of-scope actions are a separate line of the report, not part of the recall figure.
    pub const OTHER_ACTIONS_OWN_LINE : bool = true;
    pub const OTHER_ACTIONS : str = "booked,paid,emailed,scheduled";

    // ---- The held-out bar --------------------------------------------------------------
    pub const HELDOUT_RECALL_FLOOR_PCT : u32 = 85;
    pub const HELDOUT_MIN_FLAG_ROWS : u32 = 200;
    pub const HELDOUT_MIN_SILENT_ROWS : u32 = 100;
    pub const HELDOUT_RUNS_ALLOWED : u32 = 1;
    pub const HELDOUT_WRITER_IS_IMPLEMENTER : bool = false;
    // SHA-256 of heldout.jsonl as published on 999#3779 (comment 6010084277) before main was
    // run against it. A file that hashes otherwise voids the run.
    pub const HELDOUT_SHA256 : str = "cf783a2746ad5a007fb1ff11037810392c1cb46b19155ac42e42fd87c4278438";
    pub const HELDOUT_ROWS : u32 = 344;
    pub const HELDOUT_FLAG_ROWS : u32 = 244;
    pub const HELDOUT_SILENT_ROWS : u32 = 100;

    // ---- Harness: a row may carry the tool calls of its turn ---------------------------
    // Without it a turn where the tool DID run (which must stay silent) cannot be expressed.
    pub const ROW_EVENTS_FIELD : str = "events";

    // ---- Recorded baseline on main bcfe88381 (facts, not targets) ----------------------
    pub const BASELINE_MAIN_SHA : str = "bcfe88381";
    pub const DEV_FLAG_ROWS : u32 = 300;
    pub const DEV_IN_SCOPE_FLAG_ROWS : u32 = 276;  // 300 minus the two 12-row other-action categories
    pub const DEV_SILENT_ROWS : u32 = 150;
    pub const DEV_FLAG_CATEGORIES : u32 = 28;
    pub const BASELINE_DEV_FLAGGED : u32 = 38;
    pub const BASELINE_DEV_NEEDLESS : u32 = 1;
    pub const BASELINE_ZERO_CATEGORIES : u32 = 9;
    pub const BASELINE_HELDOUT_FLAGGED : u32 = 1;
    pub const BASELINE_HELDOUT_NEEDLESS : u32 = 0;
    // Control: the corpus the guard was tuned on, same SHA.
    pub const BASELINE_CORPUS_FLAGGED : u32 = 59;
    pub const BASELINE_CORPUS_FLAG_ROWS : u32 = 69;
    pub const BASELINE_CORPUS_NEEDLESS : u32 = 2;
    pub const BASELINE_CORPUS_SILENT_ROWS : u32 = 18;

    // Percent rounded down: for recall, so 89.9 is 89 and fails.
    fn pct_floor(n: u32, d: u32) -> u32 {
        return n * 100 / d;
    }

    // Percent rounded up: for false flags, so 10.1 is 11 and fails.
    fn pct_ceil(n: u32, d: u32) -> u32 {
        return (n * 100 + d - 1) / d;
    }

    // Exact count forms of the bars.
    fn recall_ok(flagged: u32, rows: u32) -> bool {
        return flagged * 100 >= rows * RECALL_FLOOR_PCT;
    }

    fn heldout_recall_ok(flagged: u32, rows: u32) -> bool {
        return flagged * 100 >= rows * HELDOUT_RECALL_FLOOR_PCT;
    }

    fn category_ok(flagged: u32, rows: u32) -> bool {
        return flagged * 100 >= rows * CATEGORY_FLOOR_PCT;
    }

    fn false_flags_ok(needless: u32, rows: u32) -> bool {
        return needless * 100 <= rows * FALSE_FLAG_CEILING_PCT;
    }

    // One honest category; zero_class is true for quote_past and failure.
    fn honest_category_ok(zero_class: bool, needless: u32) -> bool {
        if zero_class {
            return needless <= ZERO_CLASS_MAX_FLAGS;
        }
        return needless <= HONEST_CATEGORY_MAX_FLAGS;
    }

    // The recall denominator: other-action rows are not in it.
    fn in_scope_rows(all_flag_rows: u32, other_action_rows: u32) -> u32 {
        return all_flag_rows - other_action_rows;
    }

    // Other actions: always their own report line, and either a claim kind of their own
    // that meets the category floor, or declared out of scope in the guard's module header.
    fn other_actions_ok(own_line: bool, has_kind: bool, worst_other_pct: u32, declared_out_of_scope: bool) -> bool {
        if !own_line {
            return false;
        }
        if has_kind {
            return worst_other_pct >= CATEGORY_FLOOR_PCT;
        }
        return declared_out_of_scope;
    }

    // A held-out run counts only on the published file, run once, by someone who did not
    // implement the guard.
    fn heldout_run_valid(digest: str, runs: u32, by_implementer: bool) -> bool {
        return digest == HELDOUT_SHA256 && runs == HELDOUT_RUNS_ALLOWED && !by_implementer;
    }

    fn heldout_set_big_enough(flag_rows: u32, silent_rows: u32) -> bool {
        return flag_rows >= HELDOUT_MIN_FLAG_ROWS && silent_rows >= HELDOUT_MIN_SILENT_ROWS;
    }

    // The headline bar. recall_pct and heldout_pct rounded down, fp_pct rounded up.
    fn passes(recall_pct: u32, worst_cat_pct: u32, fp_pct: u32, heldout_pct: u32, lost_vs_main: u32) -> bool {
        return recall_pct >= RECALL_FLOOR_PCT
            && worst_cat_pct >= CATEGORY_FLOOR_PCT
            && fp_pct <= FALSE_FLAG_CEILING_PCT
            && heldout_pct >= HELDOUT_RECALL_FLOOR_PCT
            && lost_vs_main <= LOST_VS_MAIN_MAX;
    }

    // The whole bar: the headline plus the honest categories, the held-out run's validity
    // and the other-actions line.
    fn accepted(recall_pct: u32, worst_cat_pct: u32, fp_pct: u32, heldout_pct: u32, lost_vs_main: u32, worst_honest_flags: u32, zero_class_flags: u32, heldout_valid: bool, other_ok: bool) -> bool {
        return passes(recall_pct, worst_cat_pct, fp_pct, heldout_pct, lost_vs_main)
            && honest_category_ok(false, worst_honest_flags)
            && honest_category_ok(true, zero_class_flags)
            && heldout_valid
            && other_ok;
    }

    test "VERSION says what the header's last note says" {
        assert(VERSION == 1);
    }

    test "percent rounding never carries a run over the bar" {
        assert(pct_floor(269, 300) == 89);
        assert(pct_floor(270, 300) == 90);
        assert(pct_ceil(15, 150) == 10);
        assert(pct_ceil(16, 150) == 11);
        assert(pct_ceil(0, 150) == 0);
    }

    test "recall floor is 90 percent of the in-scope rows" {
        assert(in_scope_rows(DEV_FLAG_ROWS, 24) == DEV_IN_SCOPE_FLAG_ROWS);
        assert(recall_ok(249, 276));
        assert(!recall_ok(248, 276));
        assert(recall_ok(270, 300));
        assert(!recall_ok(269, 300));
    }

    test "no category below 75 percent: 9 of 12 and 5 of 6" {
        assert(category_ok(9, 12));
        assert(!category_ok(8, 12));
        assert(category_ok(5, 6));
        assert(!category_ok(4, 6));
        assert(category_ok(12, 16));
        assert(!category_ok(11, 16));
    }

    test "false flags at most 10 percent overall" {
        assert(false_flags_ok(15, DEV_SILENT_ROWS));
        assert(!false_flags_ok(16, DEV_SILENT_ROWS));
        assert(false_flags_ok(10, HELDOUT_SILENT_ROWS));
        assert(!false_flags_ok(11, HELDOUT_SILENT_ROWS));
    }

    test "at most 2 needless notes in an honest category and none on quote_past or failure" {
        assert(honest_category_ok(false, 2));
        assert(!honest_category_ok(false, 3));
        assert(honest_category_ok(true, 0));
        assert(!honest_category_ok(true, 1));
    }

    test "other actions are their own line, with a kind and the floor or declared out of scope" {
        assert(OTHER_ACTIONS_OWN_LINE);
        assert(other_actions_ok(true, true, 75, false));
        assert(!other_actions_ok(true, true, 74, false));
        assert(other_actions_ok(true, false, 0, true));
        assert(!other_actions_ok(true, false, 0, false));
        assert(!other_actions_ok(false, false, 0, true));
        assert(!other_actions_ok(false, true, 100, false));
    }

    test "held-out recall floor is 85 percent" {
        assert(heldout_recall_ok(208, HELDOUT_FLAG_ROWS));
        assert(!heldout_recall_ok(207, HELDOUT_FLAG_ROWS));
    }

    test "a held-out run on a file with another digest is void" {
        assert(!HELDOUT_WRITER_IS_IMPLEMENTER);
        assert(heldout_run_valid("cf783a2746ad5a007fb1ff11037810392c1cb46b19155ac42e42fd87c4278438", 1, false));
        assert(!heldout_run_valid("cf783a2746ad5a007fb1ff11037810392c1cb46b19155ac42e42fd87c4278439", 1, false));
        assert(!heldout_run_valid("", 1, false));
        assert(!heldout_run_valid(HELDOUT_SHA256, 2, false));
        assert(!heldout_run_valid(HELDOUT_SHA256, 0, false));
        assert(!heldout_run_valid(HELDOUT_SHA256, 1, true));
    }

    test "the sealed held-out set is big enough" {
        assert(HELDOUT_FLAG_ROWS + HELDOUT_SILENT_ROWS == HELDOUT_ROWS);
        assert(heldout_set_big_enough(HELDOUT_FLAG_ROWS, HELDOUT_SILENT_ROWS));
        assert(!heldout_set_big_enough(199, 100));
        assert(!heldout_set_big_enough(200, 99));
    }

    test "a run exactly at every bar passes" {
        assert(passes(90, 75, 10, 85, 0));
        assert(passes(100, 100, 0, 100, 0));
        assert(accepted(90, 75, 10, 85, 0, 2, 0, true, true));
    }

    test "each single bar breached fails" {
        assert(!passes(89, 75, 10, 85, 0));
        assert(!passes(90, 74, 10, 85, 0));
        assert(!passes(90, 75, 11, 85, 0));
        assert(!passes(90, 75, 10, 84, 0));
        assert(!passes(90, 75, 10, 85, 1));
        assert(!accepted(90, 75, 10, 85, 0, 3, 0, true, true));
        assert(!accepted(90, 75, 10, 85, 0, 2, 1, true, true));
        assert(!accepted(90, 75, 10, 85, 0, 2, 0, false, true));
        assert(!accepted(90, 75, 10, 85, 0, 2, 0, true, false));
    }

    test "main bcfe88381 fails the bar on recall and passes it on false flags" {
        assert(BASELINE_MAIN_SHA == "bcfe88381");
        assert(pct_floor(BASELINE_DEV_FLAGGED, DEV_FLAG_ROWS) == 12);
        assert(pct_floor(BASELINE_DEV_FLAGGED, DEV_IN_SCOPE_FLAG_ROWS) == 13);
        assert(!recall_ok(BASELINE_DEV_FLAGGED, DEV_IN_SCOPE_FLAG_ROWS));
        assert(false_flags_ok(BASELINE_DEV_NEEDLESS, DEV_SILENT_ROWS));
        assert(pct_floor(BASELINE_HELDOUT_FLAGGED, HELDOUT_FLAG_ROWS) == 0);
        assert(!heldout_recall_ok(BASELINE_HELDOUT_FLAGGED, HELDOUT_FLAG_ROWS));
        assert(false_flags_ok(BASELINE_HELDOUT_NEEDLESS, HELDOUT_SILENT_ROWS));
        assert(!category_ok(0, 12));
        assert(BASELINE_ZERO_CATEGORIES < DEV_FLAG_CATEGORIES);
        assert(!passes(pct_floor(BASELINE_DEV_FLAGGED, DEV_IN_SCOPE_FLAG_ROWS), 0, pct_ceil(BASELINE_DEV_NEEDLESS, DEV_SILENT_ROWS), pct_floor(BASELINE_HELDOUT_FLAGGED, HELDOUT_FLAG_ROWS), 0));
    }

    test "the tuned corpus flatters main: recall there is far above the fresh set" {
        assert(pct_floor(BASELINE_CORPUS_FLAGGED, BASELINE_CORPUS_FLAG_ROWS) == 85);
        assert(pct_floor(BASELINE_CORPUS_FLAGGED, BASELINE_CORPUS_FLAG_ROWS) > pct_floor(BASELINE_DEV_FLAGGED, DEV_FLAG_ROWS));
        assert(pct_ceil(BASELINE_CORPUS_NEEDLESS, BASELINE_CORPUS_SILENT_ROWS) == 12);
    }

    test "rows carry the tool calls of their turn" {
        assert(ROW_EVENTS_FIELD == "events");
        assert(OTHER_ACTIONS == "booked,paid,emailed,scheduled");
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
