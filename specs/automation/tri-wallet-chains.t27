// SPDX-License-Identifier: Apache-2.0
// specs/automation/tri-wallet-chains.t27 -- the TRI payout wallet on every chain a person holds: TON, EVM, Solana and TRON, each bound only by the wallet's own signature.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/tri-wallet.ts (the routes, the
// TON proof, the tables) and src/tri-wallet-chains.ts (the EVM, Solana and TRON signatures), read by
// the mini app's player/src/components/Profile/TriWalletCard.tsx and the wallet-browser page
// player/src/pages/TriBind.tsx.
// Trace: owner 2026-10-09 "make it cross-chain, so that all the networks are ours and on t27",
// then "do the blockchain on all networks, so that it is possible".
// Measured that day: tri_wallets refused every chain but TON (CHECK chain IN ('ton')), the card
// offered TON Connect only, and the mint oracle already numbered chains (trinity-fpga
// src/trinet/mint_authority.zig: ton = 1, solana = 2).
// Generated: t27c gen-ts; vendored spec and generated constants in src/spec/; the rules run from
// tri-wallet-chains.logic.ts (scripts/t27-logic.mjs).
// Claim status: binding only. Nothing here mints, sends or swaps a coin. TRI exists on TON
// testnet only; a payout on another chain waits for the bridge (trinity-fpga
// specs/trinet/mint_on_acceptance.t27, open question CROSS_CHAIN_DOUBLE_MINT), so a bound EVM
// Solana or TRON address is where TRI goes once the bridge is live, and the card says so.
// Not here: smart-contract wallets (EIP-1271 needs a call to each chain); Bitcoin, which has no
// token contract TRI could be paid to.
// v1 (2026-10-09): four chains, one message, the key never from the request, the 15 min
// window and the 60 s skew moved here from the host, the wallet-browser road proposes and the
// person confirms, payouts on TON only until the bridge.
// v2 (2026-10-09): the two doors without a person (/message, /propose) hold each caller to a
// budget per minute, and /propose looks the nonce up before it checks a signature, so a call on
// a nonce nobody was issued costs one key lookup and no curve arithmetic (review on 999#3952).
// v3 (2026-10-09): the open-nonce count is read and the nonce written under one lock per
// person, held across processes (the audit of 2026-10-09 measured 20 parallel challenge
// requests issuing 7 nonces against the cap of 5 on a real Postgres, tri-wallet.ts:353-375),
// and the bind and the unbind are one transaction each: bind_commits(nonce_spent,
// address_written, event_written) and unbind_commits(address_removed, event_written) commit
// all their writes or roll all of them back, so a failure after the address write leaves
// nothing changed and no nonce spent (tri-wallet.ts:491-512).
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::tri_wallet_chains {
    pub const KIND : str = "automation";
    pub const ID : str = "tri-wallet-chains";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 3;

    // ---- the chains ----

    // The numbers are the mint oracle's (mint_authority.zig Chain: ton 1, solana 2), extended
    // here with evm 3 and tron 4: one chain id means one chain everywhere -- in the oracle's
    // signed digest, in a claim, and here. The oracle takes 3 and 4 with the bridge.
    pub const CHAIN_TON : u8 = 1;
    pub const CHAIN_SOLANA : u8 = 2;
    pub const CHAIN_EVM : u8 = 3;
    pub const CHAIN_TRON : u8 = 4;
    pub const CHAINS_BOUND : u8 = 4;

    // The names the API and the table carry.
    pub const CHAIN_TON_NAME : str = "ton";
    pub const CHAIN_SOLANA_NAME : str = "solana";
    pub const CHAIN_EVM_NAME : str = "evm";
    pub const CHAIN_TRON_NAME : str = "tron";

    fn chain_known(chain: u8) -> bool {
        return chain == CHAIN_TON || chain == CHAIN_SOLANA || chain == CHAIN_EVM
            || chain == CHAIN_TRON;
    }

    // ---- the networks ----

    // A TON address is a contract on one network: mainnet and testnet are two bindings (TON
    // Connect ids). An EVM key owns the same address on Ethereum, Base, BNB Chain, Polygon,
    // Arbitrum and every other EVM chain; a Solana key owns the same address on every cluster,
    // and a TRON key on mainnet, Shasta and Nile, so each of those is one binding, named by its
    // CAIP-2 namespace.
    pub const TON_MAINNET : str = "-239";
    pub const TON_TESTNET : str = "-3";
    pub const EVM_NETWORK : str = "eip155";
    pub const SOLANA_NETWORK : str = "solana";
    pub const TRON_NETWORK : str = "tron";
    pub const EVM_ONE_ADDRESS_ALL_CHAINS : bool = true;

    fn networks_of(chain: u8) -> u8 {
        if chain == CHAIN_TON { return 2; }
        if chain == CHAIN_EVM || chain == CHAIN_SOLANA || chain == CHAIN_TRON { return 1; }
        return 0;
    }

    // ---- the proof ----

    // A bound address is where TRI is paid, so whoever can bind can redirect it. The key a
    // signature must verify under is never taken from the request: TON reads it from the
    // wallet's own state init, which must hash to the address; EVM and TRON recover it from the
    // signature and the address must be its hash; a Solana address IS the key.
    pub const KEY_FROM_REQUEST : bool = false;
    pub const KEY_NONE : u8 = 0;
    pub const KEY_STATE_INIT : u8 = 1;
    pub const KEY_RECOVERED : u8 = 2;
    pub const KEY_IS_ADDRESS : u8 = 3;
    // EIP-1271 wallets prove nothing without a call to their chain; v1 refuses them.
    pub const EVM_CONTRACT_WALLETS : bool = false;

    // Where the key a chain's signature is checked under comes from. The host checks a
    // signature by this answer and has no road that reads a key out of the request.
    fn key_source(chain: u8) -> u8 {
        if chain == CHAIN_TON { return KEY_STATE_INIT; }
        if chain == CHAIN_EVM || chain == CHAIN_TRON { return KEY_RECOVERED; }
        if chain == CHAIN_SOLANA { return KEY_IS_ADDRESS; }
        return KEY_NONE;
    }

    // Bytes in an address's key part and in a signature, per chain. A TRON address is 0x41,
    // the same 20-byte key hash as EVM, and a 4-byte checksum, in base58.
    fn address_bytes(chain: u8) -> u8 {
        if chain == CHAIN_EVM || chain == CHAIN_TRON { return 20; }
        if chain == CHAIN_TON || chain == CHAIN_SOLANA { return 32; }
        return 0;
    }

    fn signature_bytes(chain: u8) -> u8 {
        if chain == CHAIN_EVM || chain == CHAIN_TRON { return 65; }
        if chain == CHAIN_TON || chain == CHAIN_SOLANA { return 64; }
        return 0;
    }

    // An EVM or TRON message signature ends in v: 27 or 28 from most wallets, 0 or 1 from some.
    // Anything else (an EIP-155 v belongs to a transaction, not a message) has no recovery
    // id: -1.
    fn recovery_id(v: u8) -> i32 {
        if v == 27 || v == 0 { return 0; }
        if v == 28 || v == 1 { return 1; }
        return 0 - 1;
    }

    // ---- the message a wallet shows ----

    // EVM, Solana and TRON wallets sign text a person reads; TON signs ton_proof's own bytes. The
    // host builds the text line by line from these strings and nothing else:
    //   "<domain> " MESSAGE_INTENT, blank line, MESSAGE_NO_SPEND, blank line,
    //   LABEL_CHAIN <chain name>, LABEL_ADDRESS <address>, LABEL_NONCE <nonce>,
    //   LABEL_ISSUED <ISO 8601 UTC>.
    // The nonce is the one-time challenge the person was issued; the server rebuilds the text
    // from the posted fields and the signature must verify over exactly that.
    pub const MESSAGE_INTENT : str = "wants you to bind this address as your TRI payout wallet.";
    pub const MESSAGE_NO_SPEND : str = "Signing moves no coins and grants no spending rights.";
    pub const LABEL_CHAIN : str = "Chain: ";
    pub const LABEL_ADDRESS : str = "Address: ";
    pub const LABEL_NONCE : str = "Nonce: ";
    pub const LABEL_ISSUED : str = "Issued At: ";
    pub const MESSAGE_LINES : u8 = 8;

    // The nonce is 32 random bytes as lowercase hex: anything else was not issued here.
    pub const NONCE_HEX_CHARS : u32 = 64;
    fn nonce_length_ok(chars: u32) -> bool {
        return chars == NONCE_HEX_CHARS;
    }

    // ---- the window ----

    // A nonce lives 15 minutes; a signed proof is as old as its timestamp says. A wallet clock
    // up to a minute ahead of ours is not "from the future". Ages are in milliseconds; an age
    // beyond i32 is stale (or from the future) either way, and the host clamps it.
    pub const PROOF_TTL_MS : i32 = 900000;
    pub const CLOCK_SKEW_MS : i32 = 60000;

    fn proof_expired(age_ms: i32) -> bool {
        return age_ms > PROOF_TTL_MS;
    }

    fn proof_from_future(age_ms: i32) -> bool {
        return age_ms < 0 - CLOCK_SKEW_MS;
    }

    // Unspent nonces one person may hold at once.
    pub const MAX_OPEN_CHALLENGES : u32 = 5;
    fn may_issue(open: u32) -> bool {
        return open < MAX_OPEN_CHALLENGES;
    }

    // ---- the nonce under one lock per person ----

    // The open-nonce count is read and the nonce is written inside one lock per person, held
    // in Postgres across processes. The audit of 2026-10-09 measured the race on a real
    // Postgres: 20 parallel challenge requests issued 7 nonces against the cap of 5
    // (tri-wallet.ts:353-375), because a request that read room wrote its nonce after another
    // request had filled it. An in-memory counter cannot hold a cap across processes, and one
    // lock per table would make every person wait on every other: the lock is one per person,
    // so two persons issue in parallel and one person does not.
    pub const ISSUE_UNDER_PERSON_LOCK : bool = true;
    pub const LOCK_PER_PERSON : bool = true;
    pub const LOCK_ACROSS_PROCESSES : bool = true;

    // One atomic step under the person's lock: the open count is read and the nonce is written
    // before the lock is released, so no other process reads in between, and the count the
    // step read is the only count it trusts. Returns the open count after the step.
    fn challenge_under_lock(open: u32) -> u32 {
        if may_issue(open) { return open + 1; }
        return open;
    }

    // A challenge request admitted under the person's lock. Outside the lock the same answer
    // would mean nothing.
    fn issue_under_lock(open: u32) -> bool {
        return ISSUE_UNDER_PERSON_LOCK && LOCK_PER_PERSON && LOCK_ACROSS_PROCESSES
            && may_issue(open);
    }

    // The open count after K requests that arrived against a count of C: under the lock every
    // request runs challenge_under_lock in turn, so the count stops at the cap.
    fn locked_open_after(count_seen: u32, requests: u32) -> u32 {
        if count_seen + requests > MAX_OPEN_CHALLENGES { return MAX_OPEN_CHALLENGES; }
        return count_seen + requests;
    }

    // The same K requests without the lock: every request that saw room writes after every
    // other one, and the count ends past the cap. This is the race the audit measured; the
    // lock above is what removes it.
    fn race_open_without_lock(count_seen: u32, requests: u32) -> u32 {
        if count_seen < MAX_OPEN_CHALLENGES { return count_seen + requests; }
        return count_seen;
    }

    // ---- the bind and the unbind are one transaction each ----

    // Spending the nonce, writing the address and writing the event used to be three separate
    // statements: a failure after the address write left a changed address with no event (the
    // audit of 2026-10-09 on a real Postgres, tri-wallet.ts:491-512). bind_commits
    // (nonce_spent, address_written, event_written) puts the three in one transaction: the
    // commit goes out with all three statements, and one failed write rolls all three back,
    // so after the call all three stand or none does.
    fn bind_commits(nonce_spent: bool, address_written: bool, event_written: bool) -> bool {
        return (nonce_spent && address_written && event_written)
            || (!nonce_spent && !address_written && !event_written);
    }

    // The committed side: the nonce is spent once, the address is written and the event is
    // recorded, and the three stand together.
    fn bind_committed(nonce_spent: bool, address_written: bool, event_written: bool) -> bool {
        return bind_commits(nonce_spent, address_written, event_written)
            && nonce_spent && address_written && event_written;
    }

    // The rolled-back side: the nonce is unspent again, the address is what it was and no
    // event was recorded -- nothing of the bind stands, and the person may retry with the
    // same nonce.
    fn bind_rolled_back(nonce_spent: bool, address_written: bool, event_written: bool) -> bool {
        return bind_commits(nonce_spent, address_written, event_written)
            && !nonce_spent && !address_written && !event_written;
    }

    // A nonce is spent once: the spend is the first write of the bind transaction, and a
    // second spend on a nonce already spent is refused.
    fn may_spend_nonce(nonce_open: bool, spent_before: bool) -> bool {
        return nonce_open && !spent_before;
    }

    // Removing the address and writing the event used to be two separate statements: a
    // failure after the address removal left the address gone with no event of it.
    // unbind_commits(address_removed, event_written) puts the two in one transaction: both
    // stand or both are rolled back, so after the call the address is removed exactly when
    // the event of the removal is written.
    fn unbind_commits(address_removed: bool, event_written: bool) -> bool {
        return (address_removed && event_written) || (!address_removed && !event_written);
    }

    // The committed side: the address is removed and the event of it is recorded.
    fn unbind_committed(address_removed: bool, event_written: bool) -> bool {
        return unbind_commits(address_removed, event_written)
            && address_removed && event_written;
    }

    // The rolled-back side: the address remains and no event is recorded -- nothing of the
    // unbind stands, and the person may unbind again.
    fn unbind_rolled_back(address_removed: bool, event_written: bool) -> bool {
        return unbind_commits(address_removed, event_written)
            && !address_removed && !event_written;
    }

    // ---- who binds ----

    // Only the person's own credential binds: a mini-app signature or the app session. Not an
    // agent key, not the server key, not a game token (the host's personIdentity).
    pub const BIND_NEEDS_PERSON : bool = true;
    // One address belongs to one person; a second person gets wallet_bound_elsewhere.
    pub const ONE_PERSON_PER_ADDRESS : bool = true;

    fn may_bind(person: bool, held_by_other: bool) -> bool {
        return (person || !BIND_NEEDS_PERSON) && (!held_by_other || !ONE_PERSON_PER_ADDRESS);
    }

    // ---- the wallet's own browser ----

    // On a phone, Telegram has no EVM, Solana or TRON wallet inside it. The mini app issues a nonce
    // and opens the wallet's own browser at HANDOFF_PATH with the nonce in the fragment, which
    // no server log records. That page has no credential: it may only PROPOSE the address it
    // signed for. Binding takes the person's confirmation in the mini app, where they see the
    // address -- a nonce that leaked can put a proposal in front of the person, never a binding.
    pub const HANDOFF_PATH : str = "/tri/bind";
    pub const NONCE_IN_FRAGMENT : bool = true;
    pub const PROPOSAL_NEEDS_CONFIRM : bool = true;

    // The first valid signature on an open nonce is its proposal; a second one is refused, and
    // the person starts over with a new nonce if it was not theirs.
    fn may_propose(nonce_open: bool, signature_ok: bool, proposed_before: bool) -> bool {
        return nonce_open && signature_ok && !proposed_before;
    }

    fn may_confirm(nonce_is_persons: bool, nonce_open: bool, proposed: bool) -> bool {
        return nonce_is_persons && nonce_open && proposed;
    }

    fn proposal_binds(confirmed: bool) -> bool {
        return confirmed || !PROPOSAL_NEEDS_CONFIRM;
    }

    // ---- the two doors without a person ----

    // /message and /propose answer anybody. Each caller's address may call them this many times
    // in a window, counted in memory only and never stored; past it the answer is 429 and
    // nothing is parsed, checked or written. The count forgets the oldest callers past
    // PUBLIC_CALLERS_TRACKED, so the counter itself cannot grow without bound. The caller's
    // address comes from a proxy header and can be forged: the budget slows a spray, the
    // order below is what makes each refused call cheap.
    pub const PUBLIC_CALLS_PER_WINDOW : u32 = 30;
    pub const PUBLIC_WINDOW_MS : u32 = 60000;
    pub const PUBLIC_CALLERS_TRACKED : u32 = 10000;
    pub const NONCE_BEFORE_SIGNATURE : bool = true;

    fn may_call_public(calls_in_window: u32) -> bool {
        return calls_in_window <= PUBLIC_CALLS_PER_WINDOW;
    }

    // A proposal's signature is checked only on an open nonce nobody has proposed on yet.
    fn checks_signature(nonce_open: bool, proposed_before: bool) -> bool {
        return !NONCE_BEFORE_SIGNATURE || (nonce_open && !proposed_before);
    }

    // ---- where TRI is paid ----

    // One minter until the bridge exists (mint_on_acceptance.t27 CROSS_CHAIN_DOUBLE_MINT): two
    // independent minters could together mint twice the cap. So a binding on another chain is
    // recorded and shown, and TRI is paid there only once the bridge is live.
    pub const PAYOUT_CHAIN : u8 = 1;
    pub const BRIDGE_LIVE : bool = false;

    fn paid_on(chain: u8) -> bool {
        return chain == PAYOUT_CHAIN || (BRIDGE_LIVE && chain_known(chain));
    }

    // ---- tests ----

    test "four chains, numbered as the mint oracle numbers them" {
        assert(CHAIN_TON == 1);
        assert(CHAIN_SOLANA == 2);
        assert(CHAIN_EVM == 3);
        assert(CHAIN_TRON == 4);
        assert(CHAINS_BOUND == 4);
        assert(chain_known(1));
        assert(chain_known(2));
        assert(chain_known(3));
        assert(chain_known(4));
        assert(!chain_known(0));
        assert(!chain_known(5));
    }

    test "TON binds per network, EVM, Solana and TRON once for every network" {
        assert(EVM_ONE_ADDRESS_ALL_CHAINS);
        assert(networks_of(CHAIN_TON) == 2);
        assert(networks_of(CHAIN_EVM) == 1);
        assert(networks_of(CHAIN_SOLANA) == 1);
        assert(networks_of(CHAIN_TRON) == 1);
        assert(networks_of(9) == 0);
    }

    test "the key is never taken from the request" {
        assert(!KEY_FROM_REQUEST);
        assert(!EVM_CONTRACT_WALLETS);
        assert(key_source(CHAIN_TON) == KEY_STATE_INIT);
        assert(key_source(CHAIN_EVM) == KEY_RECOVERED);
        assert(key_source(CHAIN_SOLANA) == KEY_IS_ADDRESS);
        assert(key_source(CHAIN_TRON) == KEY_RECOVERED);
        assert(key_source(0) == KEY_NONE);
        assert(key_source(5) == KEY_NONE);
    }

    test "addresses and signatures have each chain's length" {
        assert(address_bytes(CHAIN_EVM) == 20);
        assert(address_bytes(CHAIN_SOLANA) == 32);
        assert(address_bytes(CHAIN_TON) == 32);
        assert(address_bytes(CHAIN_TRON) == 20);
        assert(address_bytes(0) == 0);
        assert(signature_bytes(CHAIN_EVM) == 65);
        assert(signature_bytes(CHAIN_SOLANA) == 64);
        assert(signature_bytes(CHAIN_TON) == 64);
        assert(signature_bytes(CHAIN_TRON) == 65);
        assert(signature_bytes(7) == 0);
    }

    test "an EVM or TRON message signature recovers with v 27, 28, 0 or 1 and nothing else" {
        assert(recovery_id(27) == 0);
        assert(recovery_id(28) == 1);
        assert(recovery_id(0) == 0);
        assert(recovery_id(1) == 1);
        assert(recovery_id(29) == 0 - 1);
        assert(recovery_id(37) == 0 - 1);
        assert(recovery_id(2) == 0 - 1);
    }

    test "the message has eight lines and names a 64-hex nonce" {
        assert(MESSAGE_LINES == 8);
        assert(NONCE_HEX_CHARS == 64);
        assert(nonce_length_ok(64));
        assert(!nonce_length_ok(63));
        assert(!nonce_length_ok(65));
        assert(!nonce_length_ok(0));
    }

    test "a proof is fresh for 15 minutes and a minute ahead" {
        assert(PROOF_TTL_MS == 900000);
        assert(CLOCK_SKEW_MS == 60000);
        assert(!proof_expired(0));
        assert(!proof_expired(900000));
        assert(proof_expired(900001));
        assert(!proof_from_future(0 - 60000));
        assert(proof_from_future(0 - 60001));
        assert(!proof_from_future(900001));
    }

    test "a person holds at most five open nonces" {
        assert(MAX_OPEN_CHALLENGES == 5);
        assert(may_issue(0));
        assert(may_issue(4));
        assert(!may_issue(5));
        assert(!may_issue(6));
    }

    test "only the person binds, and an address has one person" {
        assert(BIND_NEEDS_PERSON);
        assert(ONE_PERSON_PER_ADDRESS);
        assert(may_bind(true, false));
        assert(!may_bind(false, false));
        assert(!may_bind(true, true));
        assert(!may_bind(false, true));
    }

    test "the wallet browser proposes once and only the person's confirmation binds" {
        assert(NONCE_IN_FRAGMENT);
        assert(PROPOSAL_NEEDS_CONFIRM);
        assert(may_propose(true, true, false));
        assert(!may_propose(false, true, false));
        assert(!may_propose(true, false, false));
        assert(!may_propose(true, true, true));
        assert(may_confirm(true, true, true));
        assert(!may_confirm(false, true, true));
        assert(!may_confirm(true, false, true));
        assert(!may_confirm(true, true, false));
        assert(!proposal_binds(false));
        assert(proposal_binds(true));
    }

    test "a caller without a person gets thirty calls a minute, and a dead nonce costs no curve" {
        assert(PUBLIC_CALLS_PER_WINDOW == 30);
        assert(PUBLIC_WINDOW_MS == 60000);
        assert(PUBLIC_CALLERS_TRACKED == 10000);
        assert(may_call_public(1));
        assert(may_call_public(30));
        assert(!may_call_public(31));
        assert(NONCE_BEFORE_SIGNATURE);
        assert(checks_signature(true, false));
        assert(!checks_signature(false, false));
        assert(!checks_signature(true, true));
    }

    test "TRI is paid on TON only until the bridge is live" {
        assert(PAYOUT_CHAIN == CHAIN_TON);
        assert(!BRIDGE_LIVE);
        assert(paid_on(CHAIN_TON));
        assert(!paid_on(CHAIN_EVM));
        assert(!paid_on(CHAIN_SOLANA));
        assert(!paid_on(CHAIN_TRON));
        assert(!paid_on(0));
    }

    // ---- the person lock and the two transactions (v3) ----

    test "the open-nonce count and the nonce are written under one person lock" {
        assert(ISSUE_UNDER_PERSON_LOCK);
        assert(LOCK_PER_PERSON);
        assert(LOCK_ACROSS_PROCESSES);
        // One atomic step: the count is read and the nonce written before the lock is released.
        assert(challenge_under_lock(0) == 1);
        assert(challenge_under_lock(4) == 5);
        assert(challenge_under_lock(5) == 5);
        assert(issue_under_lock(0));
        assert(issue_under_lock(4));
        assert(!issue_under_lock(5));
        assert(!issue_under_lock(6));
    }

    test "twenty parallel requests issue at most five nonces under the person lock" {
        assert(locked_open_after(0, 20) == 5);
        assert(locked_open_after(2, 20) == 5);
        assert(locked_open_after(4, 20) == 5);
        assert(locked_open_after(5, 20) == 5);
        assert(locked_open_after(0, 3) == 3);
        assert(locked_open_after(3, 1) == 4);
    }

    test "without the person lock the same twenty requests pass the cap of five" {
        // The audit's race: every request that saw room wrote, and the open count ended past
        // the cap. The lock is what removes exactly this.
        assert(race_open_without_lock(0, 20) > MAX_OPEN_CHALLENGES);
        assert(race_open_without_lock(2, 20) > MAX_OPEN_CHALLENGES);
        assert(race_open_without_lock(4, 20) > MAX_OPEN_CHALLENGES);
        assert(race_open_without_lock(4, 2) > MAX_OPEN_CHALLENGES);
        assert(race_open_without_lock(5, 20) == 5);
    }

    test "the person lock is one per person and held across processes" {
        assert(LOCK_PER_PERSON);
        assert(LOCK_ACROSS_PROCESSES);
        assert(ISSUE_UNDER_PERSON_LOCK);
        // The gate reads one person's count: the same count of four admits a nonce for
        // whichever person holds it, and five refuses for whichever person holds it.
        assert(issue_under_lock(4));
        assert(!issue_under_lock(5));
    }

    test "under the person lock the open count climbs one nonce at a request and stops at five" {
        assert(locked_open_after(0, 1) == 1);
        assert(locked_open_after(1, 1) == 2);
        assert(locked_open_after(2, 1) == 3);
        assert(locked_open_after(3, 1) == 4);
        assert(locked_open_after(4, 1) == 5);
        assert(locked_open_after(5, 1) == 5);
        assert(locked_open_after(5, 15) == 5);
    }

    test "bind_commits commits the three writes together" {
        assert(bind_commits(true, true, true));
        assert(bind_committed(true, true, true));
        assert(!bind_commits(true, true, false));
        assert(!bind_commits(true, false, true));
        assert(!bind_commits(false, true, true));
    }

    test "bind_commits rolls the nonce and the address back when the event write fails" {
        // The audited failure: the nonce spent, the address written, the event write failed.
        // All three are rolled back, so the nonce remains unspent and the address is unchanged.
        assert(!bind_commits(true, true, false));
        assert(bind_rolled_back(false, false, false));
        assert(!bind_rolled_back(true, true, false));
        assert(!bind_rolled_back(true, false, false));
    }

    test "bind_commits leaves no partial write standing" {
        // A failure injected at any one write rolls all three back: no mixed state survives.
        assert(!bind_commits(true, false, false));
        assert(!bind_commits(false, true, false));
        assert(!bind_commits(false, false, true));
        assert(!bind_committed(true, true, false));
        assert(!bind_committed(false, true, true));
    }

    test "a rolled-back bind leaves the nonce unspent and the address unchanged" {
        assert(bind_rolled_back(false, false, false));
        assert(!bind_rolled_back(true, true, true));
        // The nonce is open again after the rollback, so the same nonce may be spent on the
        // retry, and only once:
        assert(may_spend_nonce(true, false));
        assert(!may_spend_nonce(true, true));
    }

    test "bind_commits makes the spend, the address and the event one transaction" {
        assert(may_spend_nonce(true, false));
        assert(!may_spend_nonce(false, false));
        assert(!may_spend_nonce(false, true));
        assert(bind_committed(true, true, true));
        assert(bind_rolled_back(false, false, false));
        assert(!bind_committed(true, false, false));
    }

    test "unbind_commits commits the address and the event together" {
        assert(unbind_commits(true, true));
        assert(unbind_committed(true, true));
        assert(unbind_commits(false, false));
        assert(!unbind_commits(true, false));
        assert(!unbind_commits(false, true));
    }

    test "unbind_commits rolls the removal back when the event write fails" {
        // The audited failure: the address removed, the event write failed. Both are rolled
        // back, so the address remains and no event is recorded.
        assert(!unbind_commits(true, false));
        assert(unbind_rolled_back(false, false));
        assert(!unbind_rolled_back(true, false));
        assert(!unbind_rolled_back(true, true));
    }

    test "unbind_commits leaves no half unbind standing" {
        assert(!unbind_commits(true, false));
        assert(!unbind_commits(false, true));
        assert(!unbind_committed(true, false));
        assert(!unbind_committed(false, true));
        assert(!unbind_rolled_back(true, false));
        assert(!unbind_rolled_back(true, true));
    }

    test "a rolled-back unbind leaves the address and records no event" {
        assert(unbind_rolled_back(false, false));
        assert(!unbind_rolled_back(true, false));
        assert(!unbind_rolled_back(true, true));
        assert(unbind_commits(false, false));
        assert(!unbind_committed(false, true));
    }

    test "unbind_commits refuses an address gone without its event" {
        assert(!unbind_commits(true, false));
        assert(!unbind_rolled_back(true, false));
        assert(!unbind_committed(true, false));
        assert(unbind_committed(true, true));
        assert(unbind_rolled_back(false, false));
    }

    test "VERSION says what the header's last note says" {
        assert(VERSION == 3);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
