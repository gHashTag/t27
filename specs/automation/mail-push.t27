// SPDX-License-Identifier: Apache-2.0
// specs/automation/mail-push.t27 -- the owner's mailbox PUSHED: a cron watches the Inbox
// and every new letter reaches the owner in Telegram as a card that already carries a
// drafted reply, sent only by their tap.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/mail-push.ts (the tool
//       mail_push_sweep: cursor, fresh-pick, card, draft) beside src/agent/mail-tools.ts
//       (whose card and transmit halves this reuses -- nothing here sends by itself),
//       registered in src/agent/tools.ts.
// Consumer: the bot src/inngest_app/functions/mail/mailPushSweep.ts (Inngest cron, calls
//       the tool as the owner over the server key, the same door crmProactive.ts uses),
//       registered in src/inngest_app/registerFunctions.ts.
// Law lineage: agent-mail-mcp spec/agent_mail.t27 -- the local bridge this vertical ports.
//       Its measured laws carry over: the first sweep announces nothing (a watcher whose
//       debut is 200 notifications is muted within the minute, and a muted watcher is
//       worse than none), the draft rides with the letter (BRIDGE_DRAFT_WITH_PUSH), a
//       body is data a stranger sent, and the seen set is bounded because state that
//       grows forever becomes the slowest part of the sweep.
// Difference from the bridge: one push target, not a fan-out. The local bridge serves
//       several chats and tracks delivery per chat; the cloud pushes the owner's card
//       alone, so the cursor is one row, and there is no observer to protect.
// Claim status: implemented and unit-tested in the host worktree (branch
//       feat/mail-push-sweep); NOT yet run live -- the cron is not deployed, so no letter
//       has been pushed by it. The card and transmit halves it reuses ARE live: the mail
//       desk answered mail_whoami in production on 2026-09-29 (admin@t27.ai, can_send).
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::mail_push {

    pub const KIND : str = "automation";
    pub const ID : str = "mail-push";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- The door -------------------------------------------------------------------
    pub const TOOL : str = "mail_push_sweep";  // in the render's registry, owner-gated
    pub const CALLER : str = "inngest-cron";  // the bot, as the owner, over the server key
    pub const DOOR : str = "/mcp";  // tools/call, X-Api-Key -- the CRM sweep's own door
    pub const CRON : str = "*/5 * * * *";  // mail lands in the chat within one interval
    pub const CONCURRENCY : u8 = 1;  // two sweeps would race the one cursor row
    pub const RETRIES : u8 = 0;  // a retry after a partial push pushes twice; the next tick is 5 min away

    // ---- The cursor -----------------------------------------------------------------
    pub const STATE_TABLE : str = "mail_push_state";  // one row: the mailbox owner's seen set
    pub const SEEN_CAP : u16 = 500;  // bounded: it only needs to cover what one view returns
    pub const VIEW_LIMIT : u8 = 25;  // one poll reads the newest window, like the bridge

    // ---- The push -------------------------------------------------------------------
    pub const FIRST_SWEEP_ANNOUNCES_NOTHING : bool = true;  // baseline where the Inbox is
    pub const OLDEST_FIRST : bool = true;  // a burst arrives in the chat in mailbox order
    pub const PUSH_PER_TICK : u8 = 5;  // a burst of 25 drafts at 60 s each would outlive
                                       // the wire; the rest carries to the next tick
    pub const PREVIEW_CHARS : u16 = 400;  // the bridge's measured preview length
    pub const SEEN_ON_PUSH : bool = true;  // seen when the CARD is out, not when tapped:
                                           // an untapped card is the owner's decision, not a retry

    // ---- The draft ------------------------------------------------------------------
    pub const DRAFT_WITH_PUSH : bool = true;  // ported: agent-mail-mcp BRIDGE_DRAFT_WITH_PUSH
    pub const DRAFT_NO_TOOLS : bool = true;  // a composer, not an actor; the letter is data
    pub const DRAFT_TIMEOUT_S : u8 = 60;  // the letter waits for nobody's slow model
    pub const DRAFT_MAX_TOKENS : u16 = 700;  // a reply is proposed, not an essay
    pub const DRAFT_FAILURE_PUSHES_ANYWAY : bool = true;  // the letter is the news; the draft is convenience

    // ---- The one outward act --------------------------------------------------------
    pub const SEND_TOOL : str = "mail_send";  // the only thing that can leave (agent-mail-mcp OUTWARD_TOOLS)
    pub const SEND_NEEDS_TAP : bool = true;  // the card IS the gate; the sweep itself never transmits

    // ---- Not claimed ----------------------------------------------------------------
    pub const RUN_LIVE : bool = false;  // not deployed; the whoami proof covers the desk, not the push

    // A letter is announced when the cursor was baselined before (not the first sweep)
    // and the letter's id is not in the seen set. The first sweep baselines and says nothing.
    fn announces(baselined: bool, already_seen: bool) -> bool {
        return baselined && !already_seen;
    }

    // The reply leaves only on the owner's Allow. Any other answer -- Deny, expiry,
    // somebody else's tap -- is a refusal, and the letter is still delivered news.
    fn may_transmit(tap: str) -> bool {
        return tap == "allowed";
    }

    // The seen set never outgrows the cap: newest kept, oldest dropped, because a
    // later view cannot return what has scrolled past the window anyway.
    fn capped(seen: u16) -> usize {
        if seen > SEEN_CAP {
            return SEEN_CAP;
        }
        return seen;
    }

    test "the first sweep announces nothing, and only unseen mail after" {
        assert(!announces(false, false));
        assert(!announces(false, true));
        assert(announces(true, false));
        assert(!announces(true, true));
        assert(FIRST_SWEEP_ANNOUNCES_NOTHING);
    }

    test "the push carries a drafted reply, and a failed draft delays nothing" {
        assert(DRAFT_WITH_PUSH);
        assert(DRAFT_NO_TOOLS);
        assert(DRAFT_FAILURE_PUSHES_ANYWAY);
        assert(DRAFT_TIMEOUT_S <= 60);
        assert(PREVIEW_CHARS == 400);
        assert(OLDEST_FIRST);
        assert(SEEN_ON_PUSH);
    }

    test "nothing transmits without the owner's tap" {
        assert(may_transmit("allowed"));
        assert(!may_transmit("denied"));
        assert(!may_transmit("expired"));
        assert(!may_transmit("pending"));
        assert(SEND_NEEDS_TAP);
        assert(SEND_TOOL == "mail_send");
    }

    test "one writer, one target, bounded state" {
        assert(CONCURRENCY == 1);
        assert(RETRIES == 0);
        assert(capped(3) == 3);
        assert(capped(SEEN_CAP) == SEEN_CAP);
        assert(capped(SEEN_CAP + 100) == SEEN_CAP);
        assert(VIEW_LIMIT <= SEEN_CAP);
        assert(PUSH_PER_TICK >= 1);
        assert(PUSH_PER_TICK <= VIEW_LIMIT);
        assert(CRON == "*/5 * * * *");
    }

    test "the desk is live, the push is not yet" {
        assert(!RUN_LIVE);
        assert(TOOL == "mail_push_sweep");
        assert(DOOR == "/mcp");
        assert(CALLER == "inngest-cron");
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
