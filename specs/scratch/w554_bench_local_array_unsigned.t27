pub fn seq_u8() -> [3]u8 {
    return [3]u8{ 1, 2, 3 };
}

test unsigned_local_test {
    let tmp : [3]u8 = seq_u8();
    assert_eq(tmp[0], 1);
    assert_eq(tmp[1], 2);
    assert_eq(tmp[2], 3);
}

bench "unsigned_local_bench" {
    let tmp : [3]u8 = seq_u8();
    assert_eq(tmp[0], 1);
    assert_eq(tmp[1], 2);
    assert_eq(tmp[2], 3);
}
