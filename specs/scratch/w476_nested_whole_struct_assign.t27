module w476_nested_whole_struct_assign;

pub struct Pt {
    x : u8,
    y : u8,
}

pub struct Shape {
    pts : [3]Pt,
}

pub fn make_shape(v: u8) -> Shape {
    return Shape {
        pts = [3]Pt {
            Pt { x = v,     y = v + 1 },
            Pt { x = v + 2, y = v + 3 },
            Pt { x = v + 4, y = v + 5 }
        }
    };
}

pub fn make_shapes(v: u8) -> [2]Shape {
    return [2]Shape {
        Shape {
            pts = [3]Pt {
                Pt { x = v,     y = v + 1 },
                Pt { x = v + 2, y = v + 3 },
                Pt { x = v + 4, y = v + 5 }
            }
        },
        Shape {
            pts = [3]Pt {
                Pt { x = v + 10, y = v + 11 },
                Pt { x = v + 12, y = v + 13 },
                Pt { x = v + 14, y = v + 15 }
            }
        }
    };
}

pub fn scalar_nested_var_assign() -> bool {
    var shape_a : Shape = make_shape(0);
    var shape_b : Shape = make_shape(1);
    shape_a = shape_b;
    return shape_a == shape_b;
}

pub fn aos_element_assign() -> bool {
    var shapes_a : [2]Shape = make_shapes(0);
    var shapes_b : [2]Shape = make_shapes(1);
    shapes_a[0] = shapes_b[0];
    return (shapes_a[0] == shapes_b[0]) && (shapes_a[1] != shapes_b[1]);
}

pub fn local_aos_copy_assign() -> bool {
    var a : [2]Shape = make_shapes(2);
    var b : [2]Shape = make_shapes(3);
    a = b;
    return a == b;
}

pub fn aos_element_var_index_assign() -> bool {
    var shapes_a : [2]Shape = make_shapes(0);
    var shapes_b : [2]Shape = make_shapes(1);
    var i : u8 = 1;
    shapes_a[i] = shapes_b[i];
    return shapes_a[1] == shapes_b[1];
}

test scalar_nested_var_assign { assert(scalar_nested_var_assign()); }
test aos_element_assign { assert(aos_element_assign()); }
test local_aos_copy_assign { assert(local_aos_copy_assign()); }
test aos_element_var_index_assign { assert(aos_element_var_index_assign()); }

invariant nested_whole_struct_assign_sound:
    scalar_nested_var_assign() && aos_element_assign();

endmodule
