pub var dst : [2][2][2][2][2][2][2][2]Pt = make_oct(20);

test module_var_8d {
    assert_eq(dst, expected);
    assert_eq(dst[0][0][0][0][0][0][0][0].x, 21);
    assert_eq(dst[0][0][0][0][0][0][0][0].y, 22);
    assert_eq(dst[1][1][1][1][1][1][1][1].x, 531);
    assert_eq(dst[1][1][1][1][1][1][1][1].y, 532);
}

bench module_bench_8d_call_write {
    // Site 1: whole-array equality before writes
    assert_eq(dst, expected);

    // Site 2: indexed read before writes
    assert_eq(dst[1][0][0][0][0][0][0][0].x, expected[1][0][0][0][0][0][0][0].x);
    assert_eq(dst[0][1][1][1][1][1][1][1].y, expected[0][1][1][1][1][1][1][1].y);

    // Mutate a few indexed signed fields
    dst[0][0][0][0][0][0][0][0].x = 999;
    dst[0][0][0][0][0][0][0][0].y = -999;
    dst[1][1][1][1][1][1][1][1].x = -1234;
    dst[1][1][1][1][1][1][1][1].y = 1234;

    // Site 3: read back updated fields
    assert_eq(dst[0][0][0][0][0][0][0][0].x, 999);
    assert_eq(dst[0][0][0][0][0][0][0][0].y, -999);
    assert_eq(dst[1][1][1][1][1][1][1][1].x, -1234);
    assert_eq(dst[1][1][1][1][1][1][1][1].y, 1234);

    // Site 4: frame condition — unchanged elements still match expected
    assert_eq(dst[1][0][0][0][0][0][0][0].x, expected[1][0][0][0][0][0][0][0].x);
    assert_eq(dst[0][1][1][1][1][1][1][1].y, expected[0][1][1][1][1][1][1][1].y);
}

endmodule
