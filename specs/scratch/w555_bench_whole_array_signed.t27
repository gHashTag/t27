// W555 witness: deterministic bench block asserting equality on the complete
// 2-D signed primitive scalar array value.
module w555_bench_whole_array_signed;

pub fn mat() -> [2][3]i8 {
    return [2][3]i8{
        [3]i8{ -1, -2, -3 },
        [3]i8{ -4, -5, -6 }
    };
}

test whole_array_signed_test {
    let tmp : [2][3]i8 = mat();
    assert_eq(tmp, [2][3]i8{
        [3]i8{ -1, -2, -3 },
        [3]i8{ -4, -5, -6 }
    });
}

bench "whole_array_signed_bench" {
    let tmp : [2][3]i8 = mat();
    assert_eq(tmp, [2][3]i8{
        [3]i8{ -1, -2, -3 },
        [3]i8{ -4, -5, -6 }
    });
}

endmodule
