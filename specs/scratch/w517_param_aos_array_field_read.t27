; SPDX-License-Identifier: Apache-2.0
; t27/specs/scratch/w517_param_aos_array_field_read.t27
; W517 witness: whole-array-field read from a packed array-of-structs parameter.
; The parameter is passed as a single packed vector and the outer index is
; variable, exercising the full-field slice path for AOS parameters.
; phi^2 + 1/phi^2 = 3 | TRINITY

module w517_param_aos_array_field_read;

pub struct S {
    tag    : u32,
    coords : [3]u32
}

fn read_aos_coords(arr : [2]S, i : u8) -> [3]u32 {
    return arr[i].coords;
}

fn scalar_s_sum(p : S) -> u32 {
    var c : [3]u32 = p.coords;
    return c[0] + c[1] + c[2];
}

test w517_param_aos_array_field_read_basic {
    let arr : [2]S = [2]S{
        S{.tag = 1, .coords = [10, 20, 30]},
        S{.tag = 2, .coords = [40, 50, 60]}
    };
    var c0 : [3]u32 = read_aos_coords(arr, 0);
    assert_eq(c0[0], 10);
    assert_eq(c0[1], 20);
    assert_eq(c0[2], 30);
    var c1 : [3]u32 = read_aos_coords(arr, 1);
    assert_eq(c1[0], 40);
    assert_eq(c1[1], 50);
    assert_eq(c1[2], 60);
    assert_eq(scalar_s_sum(arr[0]), 60);
    assert_eq(scalar_s_sum(arr[1]), 150);
}

invariant w517_param_aos_array_field_read_nonneg:
    scalar_s_sum(S{.tag = 2, .coords = [40, 50, 60]}) == 150;

bench w517_param_aos_array_field_read_latency {
    let arr : [2]S = [2]S{
        S{.tag = 1, .coords = [10, 20, 30]},
        S{.tag = 2, .coords = [40, 50, 60]}
    };
    assert_eq(scalar_s_sum(arr[1]), 150);
    assert_eq(read_aos_coords(arr, 0)[2], 30);
}

endmodule
