// W493 positive witness: a struct-literal field initialized from a scalar-struct
// identifier (parameter, local, or module-level constant). The backend lowers
// the identifier to a packed vector concatenation operand.
// φ² + φ⁻² = 3 | TRINITY

module w493_nested_struct_field_from_identifier_lowerable;

pub struct Inner {
    y : u32,
}

pub struct Outer {
    x : Inner,
}

pub fn make_inner(a : u32) -> Inner {
    return Inner { y: a + 1 };
}

pub fn make_outer(inner : Inner) -> Outer {
    // Struct-literal field initialized from a scalar-struct parameter. The
    // backend lowers this to the packed-vector parameter directly.
    return Outer { x: inner };
}

pub fn get_y() -> u32 {
    return make_outer(make_inner(5)).x.y;
}

test nested_struct_return_field {
    assert_eq(get_y(), 6);
}

endmodule
