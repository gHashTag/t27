module w572_bench_6d_aos_call_dedup;

pub struct Pt {
    x : i16,
    y : i16,
}

pub fn make_hexa() -> [2][2][2][2][2][2]Pt {
    return [2][2][2][2][2][2]Pt{
    [2][2][2][2][2]Pt{
        [2][2][2][2]Pt{
            [2][2][2]Pt{
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 0, .y = 1 },
                        Pt{ .x = 2, .y = 3 } },
                    [2]Pt{ Pt{ .x = 4, .y = 5 },
                        Pt{ .x = 6, .y = 7 } }
                },
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 8, .y = 9 },
                        Pt{ .x = 10, .y = 11 } },
                    [2]Pt{ Pt{ .x = 12, .y = 13 },
                        Pt{ .x = 14, .y = 15 } }
                }
            },
            [2][2][2]Pt{
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 16, .y = 17 },
                        Pt{ .x = 18, .y = 19 } },
                    [2]Pt{ Pt{ .x = 20, .y = 21 },
                        Pt{ .x = 22, .y = 23 } }
                },
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 24, .y = 25 },
                        Pt{ .x = 26, .y = 27 } },
                    [2]Pt{ Pt{ .x = 28, .y = 29 },
                        Pt{ .x = 30, .y = 31 } }
                }
            }
        },
        [2][2][2][2]Pt{
            [2][2][2]Pt{
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 32, .y = 33 },
                        Pt{ .x = 34, .y = 35 } },
                    [2]Pt{ Pt{ .x = 36, .y = 37 },
                        Pt{ .x = 38, .y = 39 } }
                },
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 40, .y = 41 },
                        Pt{ .x = 42, .y = 43 } },
                    [2]Pt{ Pt{ .x = 44, .y = 45 },
                        Pt{ .x = 46, .y = 47 } }
                }
            },
            [2][2][2]Pt{
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 48, .y = 49 },
                        Pt{ .x = 50, .y = 51 } },
                    [2]Pt{ Pt{ .x = 52, .y = 53 },
                        Pt{ .x = 54, .y = 55 } }
                },
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 56, .y = 57 },
                        Pt{ .x = 58, .y = 59 } },
                    [2]Pt{ Pt{ .x = 60, .y = 61 },
                        Pt{ .x = 62, .y = 63 } }
                }
            }
        }
    },
    [2][2][2][2][2]Pt{
        [2][2][2][2]Pt{
            [2][2][2]Pt{
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 64, .y = 65 },
                        Pt{ .x = 66, .y = 67 } },
                    [2]Pt{ Pt{ .x = 68, .y = 69 },
                        Pt{ .x = 70, .y = 71 } }
                },
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 72, .y = 73 },
                        Pt{ .x = 74, .y = 75 } },
                    [2]Pt{ Pt{ .x = 76, .y = 77 },
                        Pt{ .x = 78, .y = 79 } }
                }
            },
            [2][2][2]Pt{
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 80, .y = 81 },
                        Pt{ .x = 82, .y = 83 } },
                    [2]Pt{ Pt{ .x = 84, .y = 85 },
                        Pt{ .x = 86, .y = 87 } }
                },
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 88, .y = 89 },
                        Pt{ .x = 90, .y = 91 } },
                    [2]Pt{ Pt{ .x = 92, .y = 93 },
                        Pt{ .x = 94, .y = 95 } }
                }
            }
        },
        [2][2][2][2]Pt{
            [2][2][2]Pt{
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 96, .y = 97 },
                        Pt{ .x = 98, .y = 99 } },
                    [2]Pt{ Pt{ .x = 100, .y = 101 },
                        Pt{ .x = 102, .y = 103 } }
                },
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 104, .y = 105 },
                        Pt{ .x = 106, .y = 107 } },
                    [2]Pt{ Pt{ .x = 108, .y = 109 },
                        Pt{ .x = 110, .y = 111 } }
                }
            },
            [2][2][2]Pt{
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 112, .y = 113 },
                        Pt{ .x = 114, .y = 115 } },
                    [2]Pt{ Pt{ .x = 116, .y = 117 },
                        Pt{ .x = 118, .y = 119 } }
                },
                [2][2]Pt{
                    [2]Pt{ Pt{ .x = 120, .y = 121 },
                        Pt{ .x = 122, .y = 123 } },
                    [2]Pt{ Pt{ .x = 124, .y = 125 },
                        Pt{ .x = 126, .y = 127 } }
                }
            }
        }
    }
};
}

test hexa_test {
    let hexa : [2][2][2][2][2][2]Pt = make_hexa();
    assert_eq(hexa[0][1][0][1][1][1].x, 46);
    assert_eq(hexa[1][0][1][0][1][0].y, 85);
    assert_eq(hexa, make_hexa());
    assert_eq(make_hexa(), [2][2][2][2][2][2]Pt{
    [2][2][2][2][2]Pt{
        [2][2][2][2]Pt{
