// W541 witness: module-level constant of a lowerable packed scalar struct whose
// total width exceeds 64 bits.  The independent VCD cross-check must bind the
// constant value in the Python reference model and reconstruct it from slices.
module w541_module_wide_struct_const;

struct Wide {
    data: [5]u16,
}

pub const src : Wide = Wide{ .data = [5]u16{1, 2, 3, 4, 5} };

test wide_struct_const {
    assert_eq(src, Wide{ .data = [5]u16{1, 2, 3, 4, 5} });
}

endmodule
