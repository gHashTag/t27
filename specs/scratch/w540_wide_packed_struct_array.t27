// W540 witness: a lowerable packed scalar struct whose fixed-size scalar array
// field makes the total packed width exceed 64 bits.  The generated Verilog
// splits the actual expression into 64-bit VCD slices, and the Python reference
// model reconstructs the full value.
module w540_wide_packed_struct_array;

struct Wide {
    data: [5]u16,
}

pub fn make() -> Wide {
    return Wide{ .data = [5]u16{1, 2, 3, 4, 5} };
}

test wide_packed_struct_array {
    assert_eq(make(), Wide{ .data = [5]u16{1, 2, 3, 4, 5} });
}

endmodule
