// W543 Variant B negative witness: a module initializer that calls a function
// returning a non-lowerable type must not break the cocotb gate.  The reference
// model skips non-lowerable bindings and the Icarus classifier marks the whole
// module as not lowerable, so no cross-check is attempted.
module w543_negative_nonlowerable_call_init;

pub fn make_label(v : i32) -> String {
    return v as String;
}

const label : String = make_label(42);

test should_skip_nonlowerable {
    // Intentionally exercises the lowerability classifier / reference-model skip.
}

endmodule
