// W533 witness: module-level var packed scalar struct copied from a module
// const with a fixed-size scalar array field. Issue #1504.
module w533_module_scalar_struct_var_copy;

struct Pt {
    data : [3]i16,
}

const src : Pt = Pt{data: [3]i16{-3, 4, 5}};
var dst : Pt;

test var_copy_read {
    dst = src;
    assert_eq(dst.data[0], -3);
    assert_eq(dst.data[1], 4);
    assert_eq(dst.data[2], 5);
}

endmodule
