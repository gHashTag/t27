module w508_break_search;

pub fn find_index(target : u32) -> u32 {
    var arr : [5]u32 = [5]u32{3, 7, 1, 9, 2};
    var i : u32 = 0;
    var found : u32 = 5;
    while (i < 5) {
        if (arr[i] == target) {
            found = i;
            break;
        }
        i = i + 1;
    }
    return found;
}

test break_search {
    assert_eq(find_index(1), 2);
    assert_eq(find_index(9), 3);
    assert_eq(find_index(8), 5);
}

endmodule
