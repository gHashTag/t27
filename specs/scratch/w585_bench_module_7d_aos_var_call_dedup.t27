pub var dst : [2][2][2][2][2][2][2]Pt = make_week(10);

test module_var_7d {
    assert_eq(dst, expected);
    assert_eq(dst[0][0][0][0][0][0][0].x, 11);
    assert_eq(dst[0][0][0][0][0][0][0].y, 12);
    assert_eq(dst[0][1][1][1][1][1][1].x, 137);
    assert_eq(dst[0][1][1][1][1][1][1].y, 138);
    assert_eq(dst[1][1][1][1][1][1][1].x, 265);
    assert_eq(dst[1][1][1][1][1][1][1].y, 266);
}

bench module_bench_7d {
    // Whole-array equality at site 1
    assert_eq(dst, expected);
    // Indexed equality at site 2
    assert_eq(dst[0][0][0][0][0][0][0].x, expected[0][0][0][0][0][0][0].x);
    assert_eq(dst[1][1][1][1][1][1][1].y, expected[1][1][1][1][1][1][1].y);
    // Local copy from module variable at site 3
    var actual : [2][2][2][2][2][2][2]Pt = dst;
    assert_eq(actual, expected);
}

endmodule

