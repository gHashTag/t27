module w382_ram_lowering;

var mem : [4]u16;

fn write_read() -> u16 {
    mem[0] = 0xABCD;
    mem[1] = 0x1234;
    return mem[0];
}

test ram_write_read {
    assert_eq(write_read(), 0xABCD);
}

fn write_distinct() -> bool {
    mem[2] = 0xBEEF;
    mem[3] = 0xCAFE;
    return (mem[2] == 0xBEEF) && (mem[3] == 0xCAFE);
}

test ram_distinct_addresses {
    assert(write_distinct());
}

endmodule
