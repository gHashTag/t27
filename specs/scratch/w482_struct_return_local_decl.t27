// SPDX-License-Identifier: Apache-2.0
; W482 witness: same-file struct-return result stored in a local and then
; field-accessed. gen-verilog must declare the local as a packed reg and emit
; slice-based reads.
; φ² + 1/φ² = 3 | TRINITY

module w482_struct_return_local_decl;

struct Pt {
    x : u32,
    y : u32,
}

fn make_pt() -> Pt {
    return Pt{.x = 11, .y = 13};
}

fn use_local_return() -> u32 {
    let r = make_pt();
    return r.x + r.y;
}

test struct_return_local_field {
    assert_eq(use_local_return(), 24);
}

invariant struct_return_local_positive {
    use_local_return() == 24
}

bench struct_return_local_bench {
    assert_eq(use_local_return(), 24);
}

endmodule
