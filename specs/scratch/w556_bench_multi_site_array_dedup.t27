// W556 witness: deterministic bench block using the same packed-array-returning
// function call at multiple sites. Exercises multi-site temporary
// deduplication: one packed-vector temporary is assigned once and shared
// between element indexing and whole-array comparison.
module w556_bench_multi_site_array_dedup;

pub fn mat() -> [2][3]u8 {
    return [2][3]u8{
        [3]u8{ 7, 8, 9 },
        [3]u8{ 10, 11, 12 }
    };
}

test multi_site_test {
    assert_eq(mat()[1][2], 12);
    assert_eq(mat(), [2][3]u8{
        [3]u8{ 7, 8, 9 },
        [3]u8{ 10, 11, 12 }
    });
}

bench "multi_site_dedup_bench" {
    assert_eq(mat()[1][2], 12);
    assert_eq(mat(), [2][3]u8{
        [3]u8{ 7, 8, 9 },
        [3]u8{ 10, 11, 12 }
    });
}

endmodule
