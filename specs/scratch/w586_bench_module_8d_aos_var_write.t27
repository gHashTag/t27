module w586_bench_module_8d_aos_var_write;

pub struct Pt {
    x : i16,
    y : i16,
}

pub var dst : [2][2][2][2][2][2][2][2]Pt = [2][2][2][2][2][2][2][2]Pt{};

bench module_bench_8d_var_write {
    dst[0][0][0][0][0][0][0][0].x = 42;
    dst[0][0][0][0][0][0][0][0].y = -17;
    dst[1][0][0][0][0][0][0][0].x = -1000;
    dst[1][1][1][1][1][1][1][1].y = -999;

    assert_eq(dst[0][0][0][0][0][0][0][0].x, 42);
    assert_eq(dst[0][0][0][0][0][0][0][0].y, -17);
    assert_eq(dst[1][0][0][0][0][0][0][0].x, -1000);
    assert_eq(dst[1][1][1][1][1][1][1][1].y, -999);
}

endmodule
