// SPDX-License-Identifier: Apache-2.0
// t27/specs/scratch/w375_early_return.t27
// Regression spec for W375 gen-verilog early-return if-else chaining.
// A sequence of bare-if early returns must be emitted as a single if-else-if
// chain so that later assignments do not overwrite an earlier return value.

module w375_early_return;
use base::types;

fn sign(x : i8) -> i8 {
    if (x < 0) { return -1; }
    if (x > 0) { return 1; }
    return 0;
}

fn exp_approx_short(x : f32) -> f32 {
    if (x == 0.0) { return 1.0; }
    if (x < 0.0) { return 0.5; }
    return x;
}

test w375_early_return_sign {
    assert sign(-5) == -1;
    assert sign(5) == 1;
    assert sign(0) == 0;
}

test w375_early_return_exp {
    assert exp_approx_short(0.0) == 1.0;
    assert exp_approx_short(-1.0) == 0.5;
    assert exp_approx_short(2.0) == 2.0;
}

endmodule
