// W381 regression spec: nested tuple-return call lowering.
// inner returns a pair; outer calls inner, destructures, and returns swapped pair;
// sum_pair calls outer and sums the elements.

module w381_tuple_call_chain;

fn inner(a : u32, b : u32) -> (u32, u32) {
    return (a, b);
}

fn outer(p : u32, q : u32) -> (u32, u32) {
    let(x, y) = inner(p, q);
    return (y, x);
}

fn sum_pair() -> u32 {
    let(u, v) = outer(1, 2);
    return u + v;
}

test sum_pair_ok {
    assert sum_pair() == 3;
}

invariant w381_tuple_call_chain_parses always true;

endmodule
