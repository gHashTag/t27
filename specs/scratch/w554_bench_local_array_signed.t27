pub fn seq_i8() -> [3]i8 {
    return [3]i8{ -1, -2, -3 };
}

test signed_local_test {
    let tmp : [3]i8 = seq_i8();
    assert_eq(tmp[0], -1);
    assert_eq(tmp[1], -2);
    assert_eq(tmp[2], -3);
}

bench "signed_local_bench" {
    let tmp : [3]i8 = seq_i8();
    assert_eq(tmp[0], -1);
    assert_eq(tmp[1], -2);
    assert_eq(tmp[2], -3);
}
