// W529 witness: module-level 2-D scalar-struct variable lowered as a packed
// register with procedural initialization and accessed from a function.
module w529_module_2d_struct_array_var;

pub struct Pt {
    x : u16,
    y : u16,
}

pub var grid : [2][3]Pt = [2][3]Pt{
    [3]Pt{ Pt{.x = 1, .y = 2}, Pt{.x = 3, .y = 4}, Pt{.x = 5, .y = 6} },
    [3]Pt{ Pt{.x = 7, .y = 8}, Pt{.x = 9, .y = 10}, Pt{.x = 11, .y = 12} }
};

pub fn read_var(i : u32, j : u32) -> u32 {
    return (grid[i][j].x as u32) + (grid[i][j].y as u32);
}

pub fn read_var_literal() -> u32 {
    return (grid[0][0].x as u32) + (grid[1][2].y as u32);
}

test module_var_2d {
    assert_eq(read_var(0, 0), 3);
    assert_eq(read_var(1, 2), 23);
    assert_eq(read_var_literal(), 13);
}

endmodule
