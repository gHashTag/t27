// W533 witness: module-level var packed scalar struct initialized from a
// struct-returning function call. Issue #1504.
module w533_module_scalar_struct_var_call;

struct Pt {
    data : [3]i16,
}

pub fn make_pt(x : i16, y : i16, z : i16) -> Pt {
    return Pt{data: [3]i16{x, y, z}};
}

var dst : Pt = make_pt(-3, 4, 5);

test var_call_read {
    assert_eq(dst.data[0], -3);
    assert_eq(dst.data[1], 4);
    assert_eq(dst.data[2], 5);
}

endmodule
