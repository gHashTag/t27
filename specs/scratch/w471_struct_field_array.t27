module w471_struct_field_array;

pub struct Pt {
    x : u16,
    y : u16,
}

pub struct Shape {
    pts : [3]Pt,
}

pub fn sum_shape(s : Shape) -> u32 {
    let total : u32 = 0;
    for i in 0..3 {
        total = total + (s.pts[i].x as u32) + (s.pts[i].y as u32);
    }
    return total;
}

pub fn test_shape() -> u32 {
    return sum_shape(Shape{
        .pts = [3]Pt{
            Pt{.x = 1, .y = 2},
            Pt{.x = 3, .y = 4},
            Pt{.x = 5, .y = 6},
        },
    });
}

test struct_field_array {
    assert_eq(test_shape(), 21);
}

endmodule
