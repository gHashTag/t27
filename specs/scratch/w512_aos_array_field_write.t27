; SPDX-License-Identifier: Apache-2.0
; t27/specs/scratch/w512_aos_array_field_write.t27
; W512 witness: write scalar and array-typed fields of a packed-element
; bench-local array of structs and read them back.
; phi^2 + 1/phi^2 = 3 | TRINITY

module w512_aos_array_field_write;

pub struct S {
    tag : u32,
    vals : [3]u32,
}

fn read_tag(arr : [2]S, i : u8) -> u32 {
    return arr[i].tag;
}

fn read_val(arr : [2]S, i : u8, j : u8) -> u32 {
    return arr[i].vals[j];
}

bench w512_aos_array_field_write_bench {
    let arr : [2]S = [2]S{
        S{.tag = 1, .vals = [10, 20, 30]},
        S{.tag = 2, .vals = [40, 50, 60]},
    };
    arr[0].tag = 7;
    arr[1].vals[2] = 99;
    assert_eq(read_tag(arr, 0), 7);
    assert_eq(read_val(arr, 1, 2), 99);
    assert_eq(read_val(arr, 0, 1), 20);
}

endmodule
