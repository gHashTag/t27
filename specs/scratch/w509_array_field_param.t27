; SPDX-License-Identifier: Apache-2.0
; t27/specs/scratch/w509_array_field_param.t27
; W509 witness: scalar struct with a fixed-size scalar array field passed as a
; packed-vector function parameter.
; phi^2 + 1/phi^2 = 3 | TRINITY

module w509_array_field_param;

struct Pt {
    coords : [3]u8,
    tag : u8,
};

struct Pt2 {
    grid : [2][3]u8,
    tag : u8,
};

fn sum_pt(p : Pt) -> u16 {
    var s : u16 = 0;
    s = s + (p.coords[0] as u16);
    s = s + (p.coords[1] as u16);
    s = s + (p.coords[2] as u16);
    s = s + (p.tag as u16);
    return s;
}

fn sum_2d_pt(p : Pt2) -> u16 {
    var s : u16 = 0;
    s = s + (p.grid[0][0] as u16);
    s = s + (p.grid[0][2] as u16);
    s = s + (p.grid[1][1] as u16);
    s = s + (p.tag as u16);
    return s;
}

test w509_array_field_param_basic { assert_eq(sum_pt(Pt{.coords = [1, 2, 3], .tag = 7}), 13); var a : Pt = Pt{.coords = [1, 2, 3], .tag = 7}; assert_eq(sum_pt(a), 13); assert_eq(sum_2d_pt(Pt2{.grid = [2][3]u8{1, 2, 3, 4, 5, 6}, .tag = 1}), 10); }

invariant w509_array_field_param_nonneg:
    sum_pt(Pt{.coords = [0, 0, 0], .tag = 0}) == 0;

bench w509_array_field_param_latency { assert_eq(sum_pt(Pt{.coords = [1, 2, 3], .tag = 7}), 13); }

endmodule
