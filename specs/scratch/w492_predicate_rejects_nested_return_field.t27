// SPDX-License-Identifier: Apache-2.0
; W492 adversarial witness: a construct that the current gen-verilog backend
; cannot lower without a placeholder, so the Icarus-lowerability predicate
; (and the Icarus smoke pass) correctly rejects it.
; φ² + 1/φ² = 3 | TRINITY

module w492_predicate_rejects_nested_return_field;

struct Inner {
    v : u32,
}

struct Outer {
    inner : Inner,
}

fn make_outer() -> Outer {
    return Outer { .inner = Inner { .v = 5 } };
}

fn bad() -> u32 {
    ; Direct field access on a nested struct returned from a call is currently
    ; not lowered and emits an UNSUPPORTED_ICARUS placeholder.
    return make_outer().inner.v;
}

test should_be_rejected {
    assert_eq(bad(), 5);
}
