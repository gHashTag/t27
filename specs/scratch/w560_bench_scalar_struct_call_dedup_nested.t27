// W560 witness: nested binary expression using two field accesses on the same
// scalar-struct return call. Both make(9, 10).x and make(9, 10).y must slice the
// same packed-vector temporary.
module w560_bench_scalar_struct_call_dedup_nested;

struct Pt {
    x: i16,
    y: i16,
}

pub fn make(a: i16, b: i16) -> Pt {
    return Pt{ .x = a, .y = b };
}

test scalar_struct_call_dedup_nested_test {
    assert_eq(make(9, 10).x + make(9, 10).y, 19);
}

bench "scalar_struct_call_dedup_nested_bench" {
    assert_eq(make(11, 12).y - make(11, 12).x, 1);
}

endmodule
