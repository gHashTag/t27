// SPDX-License-Identifier: Apache-2.0
; W485 witness: module/function-scope wildcard `_` bindings must not produce
; placeholder registers or sized-zero assignments in generated Verilog.
; φ² + φ⁻² = 3 | TRINITY

module w485_wildcard_binding;

; Host-only recursive helper; its result is intentionally discarded.
fn host_sum_inner(n: u32, acc: u32) -> u32 {
    if (n == 0) {
        return acc;
    }
    return host_sum_inner(n - 1, acc + n);
}

fn host_sum(n: u32) -> u32 {
    return host_sum_inner(n, 0);
}

; Emitted helper whose result may be discarded.
fn emitted_value() -> u32 {
    return 42;
}

; Function that uses a wildcard binding inside its body.
fn uses_wildcard() -> u32 {
    let _ = emitted_value();
    let _ = host_sum(5);
    return 7;
}

; Module-level wildcard binding for a host-only call.
let _ = host_sum(3);

; Module-level wildcard binding for an emitted call.
let _ = emitted_value();

test wildcard_bindings_pass {
    assert_eq(uses_wildcard(), 7);
    assert_eq(emitted_value(), 42);
}

invariant wildcard_sound:
    uses_wildcard() == 7
    && emitted_value() == 42;

bench wildcard_bench {
    let r : u32 = uses_wildcard();
    assert_eq(r, 7);
}

endmodule
