module w456_rom_readonly;

const lut : [4]u16 = [4]u16{0x1234, 0x5678, 0x9ABC, 0xDEF0};

fn lookup(idx : u32) -> u16 {
    return lut[idx];
}

test rom_first_entry {
    assert_eq(lookup(0), 0x1234);
}

test rom_last_entry {
    assert_eq(lookup(3), 0xDEF0);
}

fn sum_rom() -> u32 {
    var s : u32 = 0;
    for i in 0..4 {
        s = s + lookup(i as u32);
    }
    return s;
}

test rom_sum {
    assert_eq(sum_rom(), 0x1234 + 0x5678 + 0x9ABC + 0xDEF0);
}

endmodule
