// W532 witness: 2-D packed array of scalar structs with a signed fixed-size
// scalar array field; read one element and check sign extension.
module w532_signed_struct_array_field_2d_read;

pub struct Pt {
    data : [3]i16,
}

pub const grid : [2][3]Pt = [2][3]Pt{
    [3]Pt{ Pt{data: [3]i16{1, -2, 3}}, Pt{data: [3]i16{-4, 5, -6}}, Pt{data: [3]i16{7, -8, 9}} },
    [3]Pt{ Pt{data: [3]i16{-10, 11, -12}}, Pt{data: [3]i16{13, -14, 15}}, Pt{data: [3]i16{-16, 17, -18}} }
};

pub fn read_signed(i : u32, j : u32, k : u32) -> i16 {
    return grid[i][j].data[k];
}

test signed_array_field_2d {
    assert_eq(read_signed(0, 0, 0), 1);
    assert_eq(read_signed(0, 0, 1), -2);
    assert_eq(read_signed(0, 1, 0), -4);
    assert_eq(read_signed(0, 1, 2), -6);
    assert_eq(read_signed(1, 2, 0), -16);
    assert_eq(read_signed(1, 2, 2), -18);
}

endmodule
