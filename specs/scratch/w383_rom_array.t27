module w383_rom_array;

const lut : [4]u16 = [4]u16{0x1234, 0x5678, 0x9ABC, 0xDEF0};

fn lookup(idx : u32) -> u16 {
    return lut[idx];
}

test rom_first_entry {
    assert_eq(lookup(0), 0x1234);
}

test rom_last_entry {
    assert_eq(lookup(3), 0xDEF0);
}

fn local_reverse() -> u16 {
    var tmp : [2]u16;
    tmp[0] = 0xA1B2;
    tmp[1] = 0xC3D4;
    return tmp[0];
}

test local_array_read_write {
    assert_eq(local_reverse(), 0xA1B2);
}

endmodule
