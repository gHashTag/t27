// W532 negative witness: a scalar struct with a string field must remain
// non-lowerable for Icarus Verilog.
module w532_negative_string_field;

pub struct Bad {
    label : string,
    data : [3]i16,
}

pub fn read_bad(b : Bad, k : u32) -> i16 {
    return b.data[k];
}

test negative_string_field {
    assert_eq(read_bad(Bad{label: "hello", data: [3]i16{1, -2, 3}}, 1), -2);
}

endmodule
