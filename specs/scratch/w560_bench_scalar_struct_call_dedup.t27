// W560 witness: block-scoped call CSE for lowerable packed scalar-struct
// returns. Exercises whole-struct comparison, field access on a call result,
// and local initialization all reusing the same packed-vector temporary.
module w560_bench_scalar_struct_call_dedup;

struct Pt {
    x: i16,
    y: i16,
}

pub fn make(a: i16, b: i16) -> Pt {
    return Pt{ .x = a, .y = b };
}

test scalar_struct_call_dedup_test {
    // whole-struct actual expression; becomes a packed-vector probe
    assert_eq(make(1, 2), Pt{ .x = 1, .y = 2 });
    // field access on the same call text; must slice the shared temporary
    assert_eq(make(1, 2).x, 1);
    // local init from the same call; uses the shared temporary
    var tmp : Pt = make(1, 2);
    assert_eq(tmp.y, 2);
}

bench "scalar_struct_call_dedup_bench" {
    assert_eq(make(3, 4), Pt{ .x = 3, .y = 4 });
    assert_eq(make(3, 4).y, 4);
    var tmp : Pt = make(3, 4);
    assert_eq(tmp.x, 3);
}

endmodule
