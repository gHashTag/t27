module w385_signed_local_array;

fn read_signed(idx : u32) -> i16 {
    var temps : [4]i16;
    temps[0] = -100;
    temps[1] = -1;
    temps[2] = 0;
    temps[3] = 100;
    return temps[idx];
}

test signed_first {
    assert_eq(read_signed(0), -100);
}

test signed_last {
    assert_eq(read_signed(3), 100);
}

test signed_zero {
    assert_eq(read_signed(2), 0);
}

fn write_read_signed(idx : u32, val : i16) -> i16 {
    var temps : [4]i16;
    temps[0] = 0;
    temps[1] = 0;
    temps[2] = 0;
    temps[3] = 0;
    temps[idx] = val;
    return temps[idx];
}

test signed_write_read {
    assert_eq(write_read_signed(1, -42), -42);
}

endmodule
