// W380 regression spec: tuple-return function generation scaffolding.
// The parser must accept tuple return types and tuple literals, and the
// Verilog backend must emit a packed result for multi-return functions.

module w380_tuple_return;

fn make_pair(a : u32, b : u32) -> (u32, u32) {
    return (a, b);
}

fn make_mixed(x : u16, y : u32, z : u8) -> (u16, u32, u8) {
    return (x, y, z);
}

fn use_pair() -> u32 {
    let(p, q) = make_pair(1, 2);
    return p + q;
}

fn use_mixed() -> u32 {
    let(a, b, c) = make_mixed(3, 4, 5);
    return a + b + c;
}

test use_pair_ok {
    assert use_pair() == 3;
}

test use_mixed_ok {
    assert use_mixed() == 12;
}

invariant w380_tuple_return_parses always true;

endmodule
