// W545 positive witness: a module const initialized by a function returning a
// fixed-size primitive scalar array.  The packed-vector function result is
// stored as a packed localparam and indexed by static bit-slices.
module w545_call_init_returns_array;

pub fn seq() -> [3]u8 {
    return [3]u8{ 1, 2, 3 };
}

const a : [3]u8 = seq();

test call_init_returns_array {
    assert_eq(a[0], 1);
    assert_eq(a[1], 2);
    assert_eq(a[2], 3);
}

endmodule
