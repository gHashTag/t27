// W532 witness: return a scalar struct with a signed fixed-size scalar array
// field by value and read its elements.
module w532_signed_struct_array_field_return;

pub struct Pt {
    data : [3]i16,
}

pub fn make_pt() -> Pt {
    return Pt{data: [3]i16{1, -2, 3}};
}

pub fn read_returned(k : u32) -> i16 {
    var p : Pt = make_pt();
    return p.data[k];
}

test signed_array_field_return {
    assert_eq(read_returned(0), 1);
    assert_eq(read_returned(1), -2);
    assert_eq(read_returned(2), 3);
}

endmodule
