// W552 witness: deterministic bench block asserting on a 2-D primitive scalar
// array return value. Exercises row-major flat-index VCD reconstruction inside
// a bench block.
module w552_bench_2d_array_return;

pub fn grid() -> [2][3]u8 {
    return [2][3]u8{
        [3]u8{ 1, 2, 3 },
        [3]u8{ 4, 5, 6 }
    };
}

pub fn sum() -> u32 {
    let m : [2][3]u8 = grid();
    return (m[0][0] as u32) + (m[1][2] as u32);
}

test two_d_unsigned_sum {
    assert_eq(sum(), 7);
}

bench "two_d_array_bench" {
    assert_eq(sum(), 7);
}

endmodule
