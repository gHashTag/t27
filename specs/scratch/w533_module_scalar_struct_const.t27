// W533 witness: module-level const packed scalar struct with a fixed-size
// scalar array field. Issue #1504.
module w533_module_scalar_struct_const;

struct Pt {
    data : [3]i16,
}

const src : Pt = Pt{data: [3]i16{-3, 4, 5}};

test const_read {
    assert_eq(src.data[0], -3);
    assert_eq(src.data[1], 4);
    assert_eq(src.data[2], 5);
}

endmodule
