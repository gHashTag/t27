module w457_ram_style_block;

pragma ram_style = "block";
var mem : [4]u16 = [4]u16{0, 0, 0, 0};

fn write_read(i : u32, v : u16) -> u16 {
    mem[i] = v;
    return mem[i];
}

fn sum_ram() -> u32 {
    var s : u32 = 0;
    for i in 0..4 {
        mem[i] = (i + 1) as u16;
        s = s + mem[i] as u32;
    }
    return s;
}

test block_ram_write_read {
    assert_eq(write_read(0, 0xABCD), 0xABCD);
    assert_eq(write_read(3, 0x1234), 0x1234);
}

test block_ram_sum {
    assert_eq(sum_ram(), 1 + 2 + 3 + 4);
}

endmodule
