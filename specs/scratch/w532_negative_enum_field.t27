// W532 negative witness: a scalar struct with an enum field must remain
// non-lowerable for Icarus Verilog.
module w532_negative_enum_field;

pub enum Color {
    Red,
    Green,
    Blue,
}

pub struct Bad {
    tag : Color,
    data : [3]i16,
}

pub fn read_bad(b : Bad, k : u32) -> i16 {
    return b.data[k];
}

test negative_enum_field {
    assert_eq(read_bad(Bad{tag: Color::Red, data: [3]i16{1, -2, 3}}, 1), -2);
}

endmodule
