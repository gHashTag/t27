// W533 witness: scalar struct passed as a function parameter and read as a
// module-level const parameter. Issue #1504.
module w533_module_scalar_struct_param;

struct Pt {
    x: i16,
    y: i16,
    z: u16,
}

const src : Pt = Pt{ .x = -7, .y = 8, .z = 9 };

pub fn sum(p : Pt) -> i32 {
    return p.x as i32 + p.y as i32 + p.z as i32;
}

test param_pass {
    assert_eq(sum(src), 10);
    assert_eq(sum(Pt{ .x = 1, .y = 2, .z = 3 }), 6);
}

endmodule
