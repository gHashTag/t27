module w386_for_local_array_param;

fn fill_n(n : u32) -> u16 {
    var buf : [4]u16;
    for i in 0..n {
        buf[i] = 0x1111 * (i + 1);
    }
    var sum : u16 = 0;
    for i in 0..n {
        sum = sum + buf[i];
    }
    return sum;
}

test fill_n_0 { assert_eq(fill_n(0), 0); }
test fill_n_2 { assert_eq(fill_n(2), 0x1111 + 0x2222); }
test fill_n_4 { assert_eq(fill_n(4), 0x1111 + 0x2222 + 0x3333 + 0x4444); }

endmodule
