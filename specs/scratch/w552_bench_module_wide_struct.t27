// W552 witness: module-level mutable var receives a whole-struct assignment
// inside a deterministic bench block, then the updated value is asserted.
module w552_bench_module_wide_struct;

struct Wide {
    data: [5]u16,
}

pub fn make() -> Wide {
    return Wide{ .data = [5]u16{11, 12, 13, 14, 15} };
}

var dst : Wide;

test wide_struct_assign {
    dst = make();
    assert_eq(dst, Wide{ .data = [5]u16{11, 12, 13, 14, 15} });
}

bench "wide_struct_assign_bench" {
    dst = make();
    assert_eq(dst, Wide{ .data = [5]u16{11, 12, 13, 14, 15} });
}

endmodule
