module w475_adversarial_nested_equality;

pub struct Pt {
    x : u8,
    y : u8,
}

pub struct Shape {
    pts : [3]Pt,
}

pub fn make_shapes() -> [2]Shape {
    return [2]Shape {
        Shape { pts = [3]Pt { Pt { x = 1, y = 2 }, Pt { x = 3, y = 4 }, Pt { x = 5, y = 6 } } },
        Shape { pts = [3]Pt { Pt { x = 7, y = 8 }, Pt { x = 9, y = 10 }, Pt { x = 11, y = 12 } } }
    };
}

pub fn local_aos_nested_equal() -> bool {
    var a : [2]Shape = [2]Shape {
        Shape { pts = [3]Pt { Pt { x = 1, y = 2 }, Pt { x = 3, y = 4 }, Pt { x = 5, y = 6 } } },
        Shape { pts = [3]Pt { Pt { x = 7, y = 8 }, Pt { x = 9, y = 10 }, Pt { x = 11, y = 12 } } }
    };
    var b : [2]Shape = make_shapes();
    return a == b;
}

pub fn local_aos_nested_compare_return() -> bool {
    var a : [2]Shape = make_shapes();
    return a == make_shapes();
}

pub fn read_shape_x(shapes: [2]Shape, i: u8) -> u8 {
    return shapes[i].pts[0].x;
}

pub fn local_aos_nested_varidx_read() -> bool {
    var a : [2]Shape = make_shapes();
    var x0 : u8 = read_shape_x(a, 0);
    var x1 : u8 = read_shape_x(a, 1);
    return (x0 == 1) && (x1 == 7);
}

pub fn local_aos_param_nested_sum(shapes: [2]Shape) -> u16 {
    var total : u16 = 0;
    for i in 0..2 {
        total = total + shapes[i].pts[0].x;
        total = total + shapes[i].pts[1].x;
        total = total + shapes[i].pts[2].x;
    }
    return total;
}

pub fn local_aos_param_nested_sum_call() -> bool {
    var a : [2]Shape = make_shapes();
    var total : u16 = local_aos_param_nested_sum(a);
    return total == (1 + 3 + 5 + 7 + 9 + 11);
}

test local_aos_nested_equal { assert(local_aos_nested_equal()); }
test local_aos_nested_compare_return { assert(local_aos_nested_compare_return()); }
test local_aos_nested_varidx_read { assert(local_aos_nested_varidx_read()); }
test local_aos_param_nested_sum_call { assert(local_aos_param_nested_sum_call()); }

endmodule
