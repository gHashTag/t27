// W543 Variant B witness: function-call arguments passed through narrowing and
// widening casts are correctly coerced before binding to parameters.
module w543_call_arg_casts;

pub fn sum8(a : u8, b : u8) -> u16 {
    return (a as u16) + (b as u16);
}

pub fn widen_diff(a : i8, b : i8) -> i16 {
    return (a as i16) - (b as i16);
}

test call_arg_casts {
    assert_eq(sum8(0xff, 0x01), 0x0100);
    assert_eq(widen_diff(-64, 32), -96);
}

endmodule
