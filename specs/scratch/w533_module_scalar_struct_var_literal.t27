// W533 witness: module-level var packed scalar struct initialized from a
// struct literal with a fixed-size scalar array field. Issue #1504.
module w533_module_scalar_struct_var_literal;

struct Pt {
    data : [3]i16,
}

var dst : Pt = Pt{data: [3]i16{-3, 4, 5}};

test var_literal_read {
    assert_eq(dst.data[0], -3);
    assert_eq(dst.data[1], 4);
    assert_eq(dst.data[2], 5);
}

endmodule
