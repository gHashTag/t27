module w469_2d_struct_array_param;

pub struct Pt {
    x : u16,
    y : u16,
}

pub fn sum_2d_param(pts : [2][3]Pt) -> u32 {
    var total : u32 = 0;
    for i in 0..2 {
        for j in 0..3 {
            total = total + (pts[i][j].x as u32);
        }
    }
    return total;
}

const data : [2][3]Pt = [2][3]Pt{
    [3]Pt{ Pt{.x = 1, .y = 2}, Pt{.x = 3, .y = 4}, Pt{.x = 5, .y = 6} },
    [3]Pt{ Pt{.x = 7, .y = 8}, Pt{.x = 9, .y = 10}, Pt{.x = 11, .y = 12} },
};

test two_d_struct_array_param {
    assert_eq(sum_2d_param(data), 36);
}

endmodule
