// W555 witness: deterministic bench block asserting equality on the complete
// 2-D primitive scalar array value. Exercises the W540 multi-slice VCD probe
// path for a wide packed primitive array inside a bench block.
module w555_bench_whole_array_unsigned;

pub fn mat() -> [2][3]u8 {
    return [2][3]u8{
        [3]u8{ 1, 2, 3 },
        [3]u8{ 4, 5, 6 }
    };
}

test whole_array_unsigned_test {
    let tmp : [2][3]u8 = mat();
    assert_eq(tmp, [2][3]u8{
        [3]u8{ 1, 2, 3 },
        [3]u8{ 4, 5, 6 }
    });
}

bench "whole_array_unsigned_bench" {
    let tmp : [2][3]u8 = mat();
    assert_eq(tmp, [2][3]u8{
        [3]u8{ 1, 2, 3 },
        [3]u8{ 4, 5, 6 }
    });
}

endmodule
