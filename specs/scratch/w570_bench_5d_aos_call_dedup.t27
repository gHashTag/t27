module w570_bench_5d_aos_call_dedup;

pub struct Pt {
    x : i16,
    y : i16,
}

pub fn make_penta() -> [2][2][2][2][2]Pt {
    return [2][2][2][2][2]Pt{
        [2][2][2][2]Pt{ [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 0, .y = 1 }, Pt{ .x = 2, .y = 3 } },
                                                [2]Pt{ Pt{ .x = 4, .y = 5 }, Pt{ .x = 6, .y = 7 } } },
                                          [2][2]Pt{ [2]Pt{ Pt{ .x = 8, .y = 9 }, Pt{ .x = 10, .y = 11 } },
                                                [2]Pt{ Pt{ .x = 12, .y = 13 }, Pt{ .x = 14, .y = 15 } } } },
                            [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 16, .y = 17 }, Pt{ .x = 18, .y = 19 } },
                                                [2]Pt{ Pt{ .x = 20, .y = 21 }, Pt{ .x = 22, .y = 23 } } },
                                          [2][2]Pt{ [2]Pt{ Pt{ .x = 24, .y = 25 }, Pt{ .x = 26, .y = 27 } },
                                                [2]Pt{ Pt{ .x = 28, .y = 29 }, Pt{ .x = 30, .y = 31 } } } } },
        [2][2][2][2]Pt{ [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 32, .y = 33 }, Pt{ .x = 34, .y = 35 } },
                                                [2]Pt{ Pt{ .x = 36, .y = 37 }, Pt{ .x = 38, .y = 39 } } },
                                          [2][2]Pt{ [2]Pt{ Pt{ .x = 40, .y = 41 }, Pt{ .x = 42, .y = 43 } },
                                                [2]Pt{ Pt{ .x = 44, .y = 45 }, Pt{ .x = 46, .y = 47 } } } },
                            [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 48, .y = 49 }, Pt{ .x = 50, .y = 51 } },
                                                [2]Pt{ Pt{ .x = 52, .y = 53 }, Pt{ .x = 54, .y = 55 } } },
                                          [2][2]Pt{ [2]Pt{ Pt{ .x = 56, .y = 57 }, Pt{ .x = 58, .y = 59 } },
                                                [2]Pt{ Pt{ .x = 60, .y = 61 }, Pt{ .x = 62, .y = 63 } } } } }
    };
}

test penta_test {
    let penta : [2][2][2][2][2]Pt = make_penta();
    assert_eq(penta[0][1][0][1][1].x, 22);
    assert_eq(penta[1][0][1][0][1].y, 43);
    assert_eq(penta, make_penta());
    assert_eq(make_penta(), [2][2][2][2][2]Pt{
        [2][2][2][2]Pt{ [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 0, .y = 1 }, Pt{ .x = 2, .y = 3 } },
                                                    [2]Pt{ Pt{ .x = 4, .y = 5 }, Pt{ .x = 6, .y = 7 } } },
                                              [2][2]Pt{ [2]Pt{ Pt{ .x = 8, .y = 9 }, Pt{ .x = 10, .y = 11 } },
                                                    [2]Pt{ Pt{ .x = 12, .y = 13 }, Pt{ .x = 14, .y = 15 } } } },
                                [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 16, .y = 17 }, Pt{ .x = 18, .y = 19 } },
                                                    [2]Pt{ Pt{ .x = 20, .y = 21 }, Pt{ .x = 22, .y = 23 } } },
                                              [2][2]Pt{ [2]Pt{ Pt{ .x = 24, .y = 25 }, Pt{ .x = 26, .y = 27 } },
                                                    [2]Pt{ Pt{ .x = 28, .y = 29 }, Pt{ .x = 30, .y = 31 } } } } },
            [2][2][2][2]Pt{ [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 32, .y = 33 }, Pt{ .x = 34, .y = 35 } },
                                                    [2]Pt{ Pt{ .x = 36, .y = 37 }, Pt{ .x = 38, .y = 39 } } },
                                              [2][2]Pt{ [2]Pt{ Pt{ .x = 40, .y = 41 }, Pt{ .x = 42, .y = 43 } },
                                                    [2]Pt{ Pt{ .x = 44, .y = 45 }, Pt{ .x = 46, .y = 47 } } } },
                                [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 48, .y = 49 }, Pt{ .x = 50, .y = 51 } },
                                                    [2]Pt{ Pt{ .x = 52, .y = 53 }, Pt{ .x = 54, .y = 55 } } },
                                              [2][2]Pt{ [2]Pt{ Pt{ .x = 56, .y = 57 }, Pt{ .x = 58, .y = 59 } },
                                                    [2]Pt{ Pt{ .x = 60, .y = 61 }, Pt{ .x = 62, .y = 63 } } } } }
    });
}

bench "penta_bench" {
    let penta : [2][2][2][2][2]Pt = make_penta();
    assert_eq(penta[0][0][0][0][0].x, 0);
    assert_eq(penta, make_penta());
    assert_eq(make_penta(), [2][2][2][2][2]Pt{
        [2][2][2][2]Pt{ [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 0, .y = 1 }, Pt{ .x = 2, .y = 3 } },
                                                    [2]Pt{ Pt{ .x = 4, .y = 5 }, Pt{ .x = 6, .y = 7 } } },
                                              [2][2]Pt{ [2]Pt{ Pt{ .x = 8, .y = 9 }, Pt{ .x = 10, .y = 11 } },
                                                    [2]Pt{ Pt{ .x = 12, .y = 13 }, Pt{ .x = 14, .y = 15 } } } },
                                [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 16, .y = 17 }, Pt{ .x = 18, .y = 19 } },
                                                    [2]Pt{ Pt{ .x = 20, .y = 21 }, Pt{ .x = 22, .y = 23 } } },
                                              [2][2]Pt{ [2]Pt{ Pt{ .x = 24, .y = 25 }, Pt{ .x = 26, .y = 27 } },
                                                    [2]Pt{ Pt{ .x = 28, .y = 29 }, Pt{ .x = 30, .y = 31 } } } } },
            [2][2][2][2]Pt{ [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 32, .y = 33 }, Pt{ .x = 34, .y = 35 } },
                                                    [2]Pt{ Pt{ .x = 36, .y = 37 }, Pt{ .x = 38, .y = 39 } } },
                                              [2][2]Pt{ [2]Pt{ Pt{ .x = 40, .y = 41 }, Pt{ .x = 42, .y = 43 } },
                                                    [2]Pt{ Pt{ .x = 44, .y = 45 }, Pt{ .x = 46, .y = 47 } } } },
                                [2][2][2]Pt{ [2][2]Pt{ [2]Pt{ Pt{ .x = 48, .y = 49 }, Pt{ .x = 50, .y = 51 } },
                                                    [2]Pt{ Pt{ .x = 52, .y = 53 }, Pt{ .x = 54, .y = 55 } } },
                                              [2][2]Pt{ [2]Pt{ Pt{ .x = 56, .y = 57 }, Pt{ .x = 58, .y = 59 } },
                                                    [2]Pt{ Pt{ .x = 60, .y = 61 }, Pt{ .x = 62, .y = 63 } } } } }
    });
}

endmodule
