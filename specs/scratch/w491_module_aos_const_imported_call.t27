// SPDX-License-Identifier: Apache-2.0
// W491 positive witness: module-scope AOS constant of a same-file scalar struct
// is lowerable, and an imported scalar-struct constructor call is also lowerable.
// φ² + φ⁻² = 3 | TRINITY

module w491_module_aos_const_imported_call;

use w491_aos_struct_supplier::Point;

struct LocalPt {
    x: u32,
    y: u32,
}

const pts : [2]LocalPt = [2]LocalPt {
    LocalPt { x: 1, y: 2 },
    LocalPt { x: 3, y: 4 },
};

pub fn sum_local_aos() -> u32 {
    return pts[0].x + pts[1].x;
}

pub fn sum_imported() -> u32 {
    let p = w491_aos_struct_supplier::Point { x: 5, y: 6 };
    return p.x + p.y;
}

test module_aos_const_imported_call_ok {
    assert_eq(sum_local_aos(), 4);
    assert_eq(sum_imported(), 11);
}

endmodule
