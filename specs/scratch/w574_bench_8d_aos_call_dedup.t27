bench "octa_bench" {
    let octa : [2][2][2][2][2][2][2][2]Pt = make_octa();
    assert_eq(octa[0][0][0][0][0][0][0][0].x, 0);
    assert_eq(octa[1][0][1][0][1][0][1][0].y, 341);
    assert_eq(octa, make_octa());
    let expected : [2][2][2][2][2][2][2][2]Pt =     [2][2][2][2][2][2][2][2]Pt{
                [2][2][2][2][2][2][2]Pt{
                                [2][2][2][2][2][2]Pt{
