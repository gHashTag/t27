module w469_struct_field_array_2d;

pub struct Pt {
    coords : [2][3]u8,
}

pub fn sum_literal() -> u32 {
    var p : Pt = Pt{
        .coords = [2][3]u8{
            [3]u8{1, 2, 3},
            [3]u8{4, 5, 6},
        },
    };
    return (p.coords[0][0] as u32) + (p.coords[1][2] as u32);
}

pub fn set_and_sum() -> u32 {
    var p : Pt = Pt{
        .coords = [2][3]u8{
            [3]u8{1, 2, 3},
            [3]u8{4, 5, 6},
        },
    };
    p.coords[0][0] = 10;
    p.coords[1][2] = 20;
    return (p.coords[0][0] as u32) + (p.coords[1][2] as u32);
}

pub fn sum_array_param(pts : [2]Pt) -> u32 {
    return (pts[0].coords[0][0] as u32) + (pts[1].coords[1][2] as u32);
}

const data : [2]Pt = [2]Pt{
    Pt{ .coords = [2][3]u8{ [3]u8{1, 2, 3}, [3]u8{4, 5, 6} } },
    Pt{ .coords = [2][3]u8{ [3]u8{7, 8, 9}, [3]u8{10, 11, 12} } },
};

test struct_field_array_2d {
    assert_eq(sum_literal(), 7);
    assert_eq(set_and_sum(), 30);
    assert_eq(sum_array_param(data), 13);
}

endmodule
