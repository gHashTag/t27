// SPDX-License-Identifier: Apache-2.0
// W493 positive witness: struct-literal field initialized from a literal-index
// module-level array-of-struct constant. Module-level arrays of structs are
// lowered to flat memories, so a literal-index element can be packed as one
// concatenation operand.
// φ² + 1/φ² = 3 | TRINITY

module w493_module_aos_element_field_lowerable;

pub struct Inner {
    y : u32,
}

pub struct Outer {
    x : Inner,
}

const CHOICES : [2]Inner = [2]Inner { Inner { y: 1 }, Inner { y: 2 } };

pub fn make_outer() -> Outer {
    return Outer { x: CHOICES[0] };
}

pub fn get_y() -> u32 {
    return make_outer().x.y;
}

test module_aos_element_field {
    assert_eq(get_y(), 1);
}

endmodule
