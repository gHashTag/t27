// W562 witness: whole-struct comparison for structs with array-typed fields.
// The scalar struct has a fixed-size scalar-array field, and the test/bench
// block compares the whole packed struct value against a literal.
module w562_bench_struct_array_field;

pub struct Packet {
    data : [4]i8,
    sum  : i16,
}

pub fn make_packet(d0 : i8, d1 : i8, d2 : i8, d3 : i8, s : i16) -> Packet {
    return Packet{ .data = [4]i8{d0, d1, d2, d3}, .sum = s };
}

test struct_array_field_test {
    assert_eq(make_packet(1, 2, 3, 4, 10), Packet{ .data = [4]i8{1, 2, 3, 4}, .sum = 10 });
    assert_eq(make_packet(1, 2, 3, 4, 10).data[1], 2);
    assert_eq(make_packet(1, 2, 3, 4, 10).sum, 10);
}

bench struct_array_field_bench {
    var tmp : Packet = make_packet(5, 6, 7, 8, 20);
    assert_eq(tmp, Packet{ .data = [4]i8{5, 6, 7, 8}, .sum = 20 });
    assert_eq(tmp.data[2], 7);
    assert_eq(tmp.sum, 20);
}

endmodule
