// W563 witness: array-of-struct return call deduplication.
// A function returns a fixed-size array of lowerable packed scalar structs.
// The test/bench block reuses the same call at multiple sites through a single
// packed-vector temporary, and a local 1-D array-of-struct is initialized from
// the same call.
module w563_bench_array_of_struct_call_dedup;

pub struct Pt {
    x : i16,
    y : i16,
}

pub fn make_pts(a : i16, b : i16, c : i16, d : i16) -> [2]Pt {
    return [2]Pt{ Pt{ .x = a, .y = b }, Pt{ .x = c, .y = d } };
}

test aos_test {
    var tmp : [2]Pt = make_pts(1, 2, 3, 4);
    assert_eq(tmp[0].x, 1);
    assert_eq(tmp[1].y, 4);
    assert_eq(make_pts(1, 2, 3, 4)[0].y, 2);
    assert_eq(make_pts(1, 2, 3, 4)[1].x, 3);
}

bench aos_bench {
    var t : [2]Pt = make_pts(5, 6, 7, 8);
    assert_eq(t[0].y, 6);
    assert_eq(make_pts(5, 6, 7, 8)[1].x, 7);
}

endmodule
