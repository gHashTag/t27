module w462_array_param_literal;
pub fn sum_pair(arr : [4]u16, i : u32, j : u32) -> u16 { return arr[i] + arr[j]; }
// W462: array parameters can be passed as literal array expressions. The
// backend lowers each distinct literal to a module-level anonymous ROM.
test from_literal_a { assert_eq(sum_pair([4]u16{1, 2, 3, 4}, 0, 1), 3); }
test from_literal_b { assert_eq(sum_pair([4]u16{10, 20, 30, 40}, 2, 3), 70); }
test both {
    assert_eq(sum_pair([4]u16{1, 2, 3, 4}, 1, 2), 5);
    assert_eq(sum_pair([4]u16{10, 20, 30, 40}, 1, 2), 50);
}
endmodule
