module w473_3d_module_var_struct_array;

pub struct Pt {
    x : u16,
    y : u16,
}

pub struct Shape {
    pts : [3]Pt,
}

pub var grid : [2][3]Shape = [2][3]Shape{
    [3]Shape{
        Shape{
            .pts = [3]Pt{
                Pt{.x = 1, .y = 2},
                Pt{.x = 3, .y = 4},
                Pt{.x = 5, .y = 6},
            },
        },
        Shape{
            .pts = [3]Pt{
                Pt{.x = 7, .y = 8},
                Pt{.x = 9, .y = 10},
                Pt{.x = 11, .y = 12},
            },
        },
        Shape{
            .pts = [3]Pt{
                Pt{.x = 13, .y = 14},
                Pt{.x = 15, .y = 16},
                Pt{.x = 17, .y = 18},
            },
        },
    },
    [3]Shape{
        Shape{
            .pts = [3]Pt{
                Pt{.x = 19, .y = 20},
                Pt{.x = 21, .y = 22},
                Pt{.x = 23, .y = 24},
            },
        },
        Shape{
            .pts = [3]Pt{
                Pt{.x = 25, .y = 26},
                Pt{.x = 27, .y = 28},
                Pt{.x = 29, .y = 30},
            },
        },
        Shape{
            .pts = [3]Pt{
                Pt{.x = 31, .y = 32},
                Pt{.x = 33, .y = 34},
                Pt{.x = 35, .y = 36},
            },
        },
    },
};

pub fn sum_grid() -> u32 {
    let total : u32 = 0;
    for i in 0..2 {
        for j in 0..3 {
            for k in 0..3 {
                total = total + (grid[i][j].pts[k].x as u32);
                total = total + (grid[i][j].pts[k].y as u32);
            }
        }
    }
    return total;
}

test three_d_module_var_struct_array {
    assert_eq(sum_grid(), 666);
}

endmodule
