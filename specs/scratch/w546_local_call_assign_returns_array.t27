// W546 positive witness: a function-local packed primitive array is first
// initialized from a literal, then reassigned from an array-returning function
// call, and finally read back through static bit-slices.
module w546_local_call_assign_returns_array;

pub fn seq() -> [3]u8 {
    return [3]u8{ 7, 8, 9 };
}

pub fn check() -> u32 {
    let a : [3]u8 = [3]u8{ 1, 2, 3 };
    a = seq();
    return a[0] + a[1] + a[2];
}

test local_call_assign_returns_array {
    assert_eq(check(), 24);
}

endmodule
