// W544 negative boundary witness: function returns a primitive scalar array.
// The Icarus-lowerable classifier rejects this shape because the current
// backend does not connect packed/unpacked function returns to module const/var
// storage consistently.
module w544_negative_call_init_returns_array;

pub fn seq() -> [3]u8 {
    return [3]u8{ 1, 2, 3 };
}

const a : [3]u8 = seq();

test call_init_returns_array {
    assert_eq(a[0], 1);
    assert_eq(a[1], 2);
    assert_eq(a[2], 3);
}

endmodule
