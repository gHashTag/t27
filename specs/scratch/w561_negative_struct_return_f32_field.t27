// W561 negative witness: a function returning a scalar-struct with an f32
// field must not be treated as a lowerable packed-vector return.
module w561_negative_struct_return_f32_field;

pub struct Bad {
    value : f32,
    count : i16,
}

pub fn make_bad(c : i16) -> Bad {
    return Bad{value: 1.5, count: c};
}

test negative_struct_return_f32_field {
    assert_eq(make_bad(7).count, 7);
}

endmodule
