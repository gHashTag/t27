// W541 witness: module-level var initialized from a wide packed scalar struct
// literal.  The Python reference model must bind the initializer and compare the
// reconstructed VCD value against the expected literal.
module w541_module_wide_struct_var;

struct Wide {
    data: [5]u16,
}

var dst : Wide = Wide{ .data = [5]u16{6, 7, 8, 9, 10} };

test wide_struct_var {
    assert_eq(dst, Wide{ .data = [5]u16{6, 7, 8, 9, 10} });
}

endmodule
