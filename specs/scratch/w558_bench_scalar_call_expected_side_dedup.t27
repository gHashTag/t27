// W558 witness: deterministic bench block using the same scalar-returning
// function call on both sides of assert_eq. Exercises that the W557 general
// block-scoped call CSE machinery already deduplicates expected-side calls:
// one temporary is assigned once and shared between actual and expected operands.
module w558_bench_scalar_call_expected_side_dedup;

pub fn val() -> u32 {
    return 0xAB;
}

pub fn other() -> u32 {
    return 0xCD;
}

test scalar_call_expected_side_dedup_test {
    assert_eq(val(), val());
    assert_eq(val() + other(), val() + other());
}

bench "scalar_call_expected_side_dedup_bench" {
    assert_eq(val(), val());
    assert_eq(val() + other(), val() + other());
}

endmodule
