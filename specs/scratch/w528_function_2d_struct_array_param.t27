// W528 witness: 2-D scalar-struct array passed as a function parameter as a
// single packed input, with element and field accesses in the callee.
module w528_function_2d_struct_array_param;

pub struct Pt {
    x : u16,
    y : u16,
}

pub fn sum_param(m : [2][3]Pt) -> u32 {
    return (m[0][0].x as u32) + (m[0][2].y as u32) + (m[1][1].x as u32) + (m[1][2].y as u32);
}

pub fn varidx_param(m : [2][3]Pt, i : u32, j : u32) -> u32 {
    return (m[i][j].x as u32) + (m[i][j].y as u32);
}

pub fn make_grid() -> [2][3]Pt {
    return [2][3]Pt{
        [3]Pt{ Pt{.x = 1, .y = 2}, Pt{.x = 3, .y = 4}, Pt{.x = 5, .y = 6} },
        [3]Pt{ Pt{.x = 7, .y = 8}, Pt{.x = 9, .y = 10}, Pt{.x = 11, .y = 12} }
    };
}

test function_param_2d {
    assert_eq(sum_param(make_grid()), 28);
    assert_eq(varidx_param(make_grid(), 0, 0), 3);
    assert_eq(varidx_param(make_grid(), 1, 2), 23);
}

endmodule
