// W583 witness: module-level 3-D array-of-struct constant compared against a
// function-returned 3-D AoS with computed fields, in a deterministic bench
// block. Exercises module-scope packed parameters, whole-array assertion for
// multi-D AoS, and the W583 fix for non-literal expressions in packed
// concatenations.
module w583_bench_module_3d_aos_call_dedup;

pub struct Pt {
    x : u16,
    y : u16,
}

pub const expected : [2][2][2]Pt = [2][2][2]Pt{
    [2][2]Pt{
        [2]Pt{ Pt{.x = 1, .y = 2}, Pt{.x = 3, .y = 4} },
        [2]Pt{ Pt{.x = 5, .y = 6}, Pt{.x = 7, .y = 8} }
    },
    [2][2]Pt{
        [2]Pt{ Pt{.x = 9, .y = 10}, Pt{.x = 11, .y = 12} },
        [2]Pt{ Pt{.x = 13, .y = 14}, Pt{.x = 15, .y = 16} }
    }
};

pub fn make_cube(offset : u16) -> [2][2][2]Pt {
    return [2][2][2]Pt{
        [2][2]Pt{
            [2]Pt{ Pt{.x = offset + 1, .y = offset + 2}, Pt{.x = offset + 3, .y = offset + 4} },
            [2]Pt{ Pt{.x = offset + 5, .y = offset + 6}, Pt{.x = offset + 7, .y = offset + 8} }
        },
        [2][2]Pt{
            [2]Pt{ Pt{.x = offset + 9, .y = offset + 10}, Pt{.x = offset + 11, .y = offset + 12} },
            [2]Pt{ Pt{.x = offset + 13, .y = offset + 14}, Pt{.x = offset + 15, .y = offset + 16} }
        }
    };
}

test module_const_3d {
    assert_eq(make_cube(0), expected);
}

bench module_bench_3d {
    var actual : [2][2][2]Pt = make_cube(0);
    assert_eq(actual, expected);
}

endmodule
