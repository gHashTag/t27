// W559 witness: deterministic bench block asserting equality on a complete
// 4-D signed primitive scalar array value. The packed width is 256 bits,
// so this also exercises the W540 multi-slice VCD probe reconstruction for
// a wide signed rank-4 array.
module w559_bench_whole_array_4d_signed;

pub fn hyper() -> [2][2][2][2]i32 {
    return [2][2][2][2]i32{
        [2][2][2]i32{
            [2][2]i32{
                [2]i32{ -1,  -2 },
                [2]i32{ -3,  -4 }
            },
            [2][2]i32{
                [2]i32{ -5,  -6 },
                [2]i32{ -7,  -8 }
            }
        },
        [2][2][2]i32{
            [2][2]i32{
                [2]i32{ -9, -10 },
                [2]i32{ -11, -12 }
            },
            [2][2]i32{
                [2]i32{ -13, -14 },
                [2]i32{ -15, -16 }
            }
        }
    };
}

test whole_array_4d_signed_test {
    let tmp : [2][2][2][2]i32 = hyper();
    assert_eq(tmp, [2][2][2][2]i32{
        [2][2][2]i32{
            [2][2]i32{
                [2]i32{ -1,  -2 },
                [2]i32{ -3,  -4 }
            },
            [2][2]i32{
                [2]i32{ -5,  -6 },
                [2]i32{ -7,  -8 }
            }
        },
        [2][2][2]i32{
            [2][2]i32{
                [2]i32{ -9, -10 },
                [2]i32{ -11, -12 }
            },
            [2][2]i32{
                [2]i32{ -13, -14 },
                [2]i32{ -15, -16 }
            }
        }
    });
}

bench "whole_array_4d_signed_bench" {
    let tmp : [2][2][2][2]i32 = hyper();
    assert_eq(tmp, [2][2][2][2]i32{
        [2][2][2]i32{
            [2][2]i32{
                [2]i32{ -1,  -2 },
                [2]i32{ -3,  -4 }
            },
            [2][2]i32{
                [2]i32{ -5,  -6 },
                [2]i32{ -7,  -8 }
            }
        },
        [2][2][2]i32{
            [2][2]i32{
                [2]i32{ -9, -10 },
                [2]i32{ -11, -12 }
            },
            [2][2]i32{
                [2]i32{ -13, -14 },
                [2]i32{ -15, -16 }
            }
        }
    });
}

endmodule
