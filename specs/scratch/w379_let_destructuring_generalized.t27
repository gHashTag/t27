// W379 regression spec: semantically-aware let destructuring.
// The backend must infer the number of bindings and per-binding width from
// the LHS pattern, not hardcode 3x32-bit slots.

module w379_let_destructuring_generalized;

fn make_pair(a : u32, b : u32) -> (u32, u32) {
    return (a, b);
}

fn make_quad(a : u16, b : u16, c : u16, d : u16) -> (u16, u16, u16, u16) {
    return (a, b, c, d);
}

fn use_pair() -> u32 {
    let(x, y) = make_pair(1, 2);
    return x + y;
}

fn use_quad() -> u32 {
    let(a, b, c, d) = make_quad(1, 2, 3, 4);
    return a + b + c + d;
}

fn use_underscore() -> u32 {
    let(x, _y) = make_pair(5, 6);
    return x;
}

test use_pair_ok {
    assert use_pair() == 3;
}

test use_quad_ok {
    assert use_quad() == 10;
}

test use_underscore_ok {
    assert use_underscore() == 5;
}

invariant w379_let_destructuring_parses always true;

endmodule
