// SPDX-License-Identifier: Apache-2.0
// W493 adversarial witness: struct-literal field initialized from an indexed
// local array-of-struct element. Non-memory-mode local arrays of structs are
// unpacked into per-element per-field registers, so packing an indexed element
// inside a struct-literal concatenation is not yet lowered. The generated
// Verilog contains an UNSUPPORTED_ICARUS placeholder.
// φ² + 1/φ² = 3 | TRINITY

module w493_local_aos_element_field_not_lowerable;

pub struct Inner {
    y : u32,
}

pub struct Outer {
    x : Inner,
}

pub fn make_choices() -> [2]Inner {
    return [2]Inner { Inner { y: 1 }, Inner { y: 2 } };
}

pub fn make_outer(i : u32) -> Outer {
    let choices : [2]Inner = make_choices();
    return Outer { x: choices[i] };
}

pub fn get_y(i : u32) -> u32 {
    return make_outer(i).x.y;
}

test local_aos_element_field {
    assert_eq(get_y(0), 1);
    assert_eq(get_y(1), 2);
}

endmodule
