module w385_signed_local_array_init;

fn read_signed_init(idx : u32) -> i16 {
    var temps : [3]i16 = [3]i16{-100, 0, 100};
    return temps[idx];
}

test signed_init_first {
    assert_eq(read_signed_init(0), -100);
}

test signed_init_last {
    assert_eq(read_signed_init(2), 100);
}

fn overwrite_signed_init(idx : u32, val : i16) -> i16 {
    var temps : [3]i16 = [3]i16{-1, -2, -3};
    temps[idx] = val;
    return temps[idx];
}

test signed_init_overwrite {
    assert_eq(overwrite_signed_init(1, 42), 42);
}

endmodule
