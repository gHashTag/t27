// W561 negative witness: a function returning a scalar-struct with a string
// field must not be treated as a lowerable packed-vector return, and therefore
// cannot participate in the W560 call-deduplication optimization.
module w561_negative_struct_return_string_field;

pub struct Bad {
    label : string,
    value : i16,
}

pub fn make_bad(v : i16) -> Bad {
    return Bad{label: "bad", value: v};
}

test negative_struct_return_string_field {
    assert_eq(make_bad(7).value, 7);
}

endmodule
