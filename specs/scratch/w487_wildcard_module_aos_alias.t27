// W487 witness: module-scope wildcard alias to a 1-D array of structs.
// Each scalar leaf field must be copied into an anonymous per-field memory.
// φ² + φ⁻² = 3 | TRINITY

module w487_wildcard_module_aos_alias;

struct Pt {
    x: u32,
    y: u32,
}

const pts : [4]Pt = [4]Pt{Pt{x=1, y=2}, Pt{x=3, y=4}, Pt{x=5, y=6}, Pt{x=7, y=8}};
let _ = pts;

test aos_alias_pass {
    assert_eq(1, 1);
}

endmodule
