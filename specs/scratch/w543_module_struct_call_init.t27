// W543 witness: a module-level const initialized by a packed scalar struct
// function call is bound eagerly and its fields are cross-checked against VCD.
module w543_module_struct_call_init;

struct Pt {
    x: i16,
    y: i16,
}

pub fn neg(p : Pt) -> Pt {
    return Pt{ .x = -p.x, .y = -p.y };
}

const src : Pt = neg(Pt{ .x = 3, .y = -4 });

test struct_call_init {
    assert_eq(src.x, -3);
    assert_eq(src.y, 4);
}

endmodule
