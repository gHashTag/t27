// t27/specs/scratch/w377_struct_field_mapping.t27
// Regression spec for W377 gen-verilog struct-field register-name mapping.
// Functions that take a struct parameter must be lowered so that struct field
// reads reference the struct-type register names (e.g. word_data), not the
// parameter-variable names (e.g. w_data). This ensures yosys parses the output
// without emitting undeclared signal errors.

module w377_struct_field_mapping;

struct Word {
    data : u32,
    tag : u8,
};

fn sum_word(w : Word) -> u32 {
    return w.data + (w.tag as u32);
}

fn word_plus_one(w : Word) -> u32 {
    var base : u32 = w.data;
    return base + 1;
}

test w377_struct_field_mapping_basic {
    assert sum_word(Word { data: 10, tag: 5 }) == 15;
    assert word_plus_one(Word { data: 10, tag: 5 }) == 11;
}

invariant w377_struct_field_mapping_bounds always sum_word(Word { data: 3, tag: 4 }) >= 0;

endmodule
