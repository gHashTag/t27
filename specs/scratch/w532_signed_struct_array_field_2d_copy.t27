// W532 witness: copy from a module-level signed array-field const into a
// function-local 2-D packed array of scalar structs and read back.
module w532_signed_struct_array_field_2d_copy;

pub struct Pt {
    data : [3]i16,
}

pub const src : [2][2]Pt = [2][2]Pt{
    [2]Pt{ Pt{data: [3]i16{1, -2, 3}}, Pt{data: [3]i16{-4, 5, -6}} },
    [2]Pt{ Pt{data: [3]i16{7, -8, 9}}, Pt{data: [3]i16{-10, 11, -12}} }
};

pub fn copy_and_read(i : u32, j : u32, k : u32) -> i16 {
    var tmp : [2][2]Pt = src;
    return tmp[i][j].data[k];
}

test signed_array_field_2d_copy {
    assert_eq(copy_and_read(0, 0, 1), -2);
    assert_eq(copy_and_read(0, 1, 0), -4);
    assert_eq(copy_and_read(1, 0, 1), -8);
    assert_eq(copy_and_read(1, 1, 2), -12);
}

endmodule
