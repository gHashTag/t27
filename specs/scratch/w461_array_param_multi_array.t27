module w461_array_param_multi_array;
const rom_a : [4]u16 = [4]u16{1, 2, 3, 4};
const rom_b : [4]u16 = [4]u16{10, 20, 30, 40};
pub fn sum_pair(arr : [4]u16, i : u32, j : u32) -> u16 { return arr[i] + arr[j]; }
// W461: the same logical function is called with two different module-level
// arrays. The backend emits one Verilog function clone per binding signature,
// so rom_a and rom_b can both be passed without conflict.
test from_a { assert_eq(sum_pair(rom_a, 0, 1), 3); }
test from_b { assert_eq(sum_pair(rom_b, 2, 3), 70); }
test both {
    assert_eq(sum_pair(rom_a, 1, 2), 5);
    assert_eq(sum_pair(rom_b, 1, 2), 50);
}
endmodule
