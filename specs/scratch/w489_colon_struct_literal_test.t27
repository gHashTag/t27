// t27/specs/scratch/w489_colon_struct_literal_test.t27
// Witness: test block declares and uses a colon-style struct literal.
// phi^2 + 1/phi^2 = 3 | TRINITY

module w489_colon_struct_literal_test;

pub struct Pt {
    x : u32,
    y : u32,
}

test colon_test_block {
    var p : Pt = Pt{x: 5, y: 7};
    assert_eq(p.x + p.y, 12);
}

endmodule
