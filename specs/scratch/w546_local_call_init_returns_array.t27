// W546 positive witness: a function-local let binding initialized by a function
// returning a fixed-size primitive scalar array.  The packed-vector function
// result is stored in a packed local reg and indexed by static bit-slices.
module w546_local_call_init_returns_array;

pub fn seq() -> [3]u8 {
    return [3]u8{ 1, 2, 3 };
}

pub fn check() -> u32 {
    let a : [3]u8 = seq();
    return a[0] + a[1] + a[2];
}

test local_call_init_returns_array {
    assert_eq(check(), 6);
}

endmodule
