// W543 witness: a module-level const initialized by a scalar function call is
// bound eagerly in the Python reference model and cross-checked against VCD.
module w543_module_scalar_call_init;

pub fn make(x : u32) -> u32 {
    return x + 1;
}

const src : u32 = make(5);

test scalar_call_init {
    assert_eq(src, 6);
    assert_eq(make(0), 1);
    assert_eq(src + 1, 7);
}

endmodule
