module w384_variable_index;
fn read_var_idx(idx : u32) -> u16 {
    var buf : [4]u16;
    buf[0] = 0xA1B2;
    buf[1] = 0xC3D4;
    buf[2] = 0xE5F6;
    buf[3] = 0x1234;
    return buf[idx];
}
fn write_var_idx(idx : u32, val : u16) -> u16 {
    var buf : [4]u16;
    buf[0] = 0x0000;
    buf[1] = 0x0000;
    buf[2] = 0x0000;
    buf[3] = 0x0000;
    buf[idx] = val;
    return buf[idx];
}
test variable_index_read_0 { assert_eq(read_var_idx(0), 0xA1B2); }
test variable_index_read_1 { assert_eq(read_var_idx(1), 0xC3D4); }
test variable_index_read_2 { assert_eq(read_var_idx(2), 0xE5F6); }
test variable_index_read_3 { assert_eq(read_var_idx(3), 0x1234); }
test variable_index_write_0 { assert_eq(write_var_idx(0, 0xDEAD), 0xDEAD); }
test variable_index_write_2 { assert_eq(write_var_idx(2, 0xBEEF), 0xBEEF); }
endmodule
