; t27/specs/scratch/w513_local_aos_read.t27
; W513 witness: read scalar and array-typed fields of a function-local
; packed-element array of structs.
; phi^2 + 1/phi^2 = 3 | TRINITY

module w513_local_aos_read;

pub struct S {
    tag : u32,
    vals : [3]u32,
}

fn read_fixed() -> u32 {
    let arr : [2]S = [2]S{
        S{.tag = 1, .vals = [10, 20, 30]},
        S{.tag = 2, .vals = [40, 50, 60]},
    };
    return arr[0].tag + arr[1].vals[1];
}

fn read_indexed(i : u8, j : u8) -> u32 {
    let arr : [2]S = [2]S{
        S{.tag = 1, .vals = [10, 20, 30]},
        S{.tag = 2, .vals = [40, 50, 60]},
    };
    return arr[i].vals[j];
}

bench w513_local_aos_read_bench {
    assert_eq(read_fixed(), 51);
    assert_eq(read_indexed(0, 2), 30);
    assert_eq(read_indexed(1, 0), 40);
}

endmodule
