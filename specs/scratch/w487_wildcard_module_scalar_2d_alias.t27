// SPDX-License-Identifier: Apache-2.0
// W487 witness: module-scope wildcard alias to a 2-D scalar array.
// The source memory must be emitted with full dimensions and the alias must
// copy it element-by-element into an anonymous memory.
// φ² + φ⁻² = 3 | TRINITY

module w487_wildcard_module_scalar_2d_alias;

const src : [2][3]u32 = [2][3]u32{1, 2, 3, 4, 5, 6};
let _ = src;

test scalar_2d_alias_pass {
    assert_eq(1, 1);
}

endmodule
