// SPDX-License-Identifier: Apache-2.0
; W485 witness: host-side recursive helpers are used only in non-Verilog
; contexts (tests/invariants) and must not be emitted to Verilog.
; φ² + φ⁻² = 3 | TRINITY

module w485_host_helper_shadow;

; Host-only recursive helper: computes the sum of the first n natural numbers.
; It uses an unbounded recursive pattern that t27 cannot lower to synthesizable
; Verilog, so it must be skipped by the Verilog backend.
fn sum_first_n_inner(n: u32, acc: u32) -> u32 {
    if (n == 0) {
        return acc;
    }
    return sum_first_n_inner(n - 1, acc + n);
}

; Public wrapper also host-only because it calls the helper.
fn sum_first_n(n: u32) -> u32 {
    return sum_first_n_inner(n, 0);
}

; A synthesizable function that does not depend on the host helper.
fn emitted_value() -> u32 {
    return 10;
}

test host_helper_in_test {
    assert_eq(sum_first_n(0), 0);
    assert_eq(sum_first_n(1), 1);
    assert_eq(sum_first_n(5), 15);
}

invariant host_helper_sound:
    sum_first_n(5) == 15;

; The synthesizable function must still work in simulation.
test emitted_value_passes {
    assert_eq(emitted_value(), 10);
}

bench emitted_value_bench {
    let v : u32 = emitted_value();
    assert_eq(v, 10);
}

endmodule
