// W549 positive witness: a function returning a 3-D unsigned primitive scalar
// array initializes a function-local let binding.  Exercises the full rank-3
// row-major flat-index path in the Verilog backend and the cocotb reference model.
module w549_3d_call_init_returns_array;

pub fn cube() -> [2][3][4]u8 {
    return [2][3][4]u8{
        [3][4]u8{
            [4]u8{ 1,  2,  3,  4 },
            [4]u8{ 5,  6,  7,  8 },
            [4]u8{ 9, 10, 11, 12 }
        },
        [3][4]u8{
            [4]u8{ 13, 14, 15, 16 },
            [4]u8{ 17, 18, 19, 20 },
            [4]u8{ 21, 22, 23, 24 }
        }
    };
}

pub fn check() -> u32 {
    let m : [2][3][4]u8 = cube();
    return (m[0][0][0] as u32) + (m[0][2][3] as u32) + (m[1][0][0] as u32) + (m[1][2][3] as u32);
}

test three_d_corner_sum {
    assert_eq(check(), 50);
}

endmodule
