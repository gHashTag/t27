// SPDX-License-Identifier: Apache-2.0
; W485 witness: bench-local fixed-size arrays are hoisted to module scope and
; initialize correctly when used directly inside the bench.
; φ² + φ⁻² = 3 | TRINITY

module w485_bench_local_array_hoist;

fn sum_inline(a: u32, b: u32, c: u32, d: u32) -> u32 {
    return a + b + c + d;
}

test emitted_scalar_sum {
    assert_eq(sum_inline(10, 20, 30, 40), 100);
}

bench bench_local_array_hoist {
    let data : [4]u32 = [1, 2, 3, 4];
    let s : u32 = sum_inline(data[0], data[1], data[2], data[3]);
    assert_eq(s, 10);
}

endmodule
