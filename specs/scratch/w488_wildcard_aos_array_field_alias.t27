// SPDX-License-Identifier: Apache-2.0
// W488 witness: module-scope wildcard alias to an array of structs whose
// element struct has an array-typed field. The anonymous AOS copy must emit
// multi-dimensional per-field memories for the array-typed field and copy every
// element in an initial block.
// φ² + φ⁻² = 3 | TRINITY

module w488_wildcard_aos_array_field_alias;

struct Pt {
    x: u32,
    coords: [3]u8,
}

const pts : [4]Pt = [4]Pt{
    Pt{x = 1, coords = [3]u8{1, 2, 3}},
    Pt{x = 2, coords = [3]u8{4, 5, 6}},
    Pt{x = 3, coords = [3]u8{7, 8, 9}},
    Pt{x = 4, coords = [3]u8{10, 11, 12}}
};

let _ = pts;

test aos_array_field_alias_pass {
    assert_eq(1, 1);
}

endmodule
