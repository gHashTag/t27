// W559 witness: deterministic bench block asserting equality on a complete
// 3-D signed primitive scalar array value. Exercises the W555 whole-array
// probe path extended to rank 3 with signed elements.
module w559_bench_whole_array_3d_signed;

pub fn cube() -> [2][3][4]i8 {
    return [2][3][4]i8{
        [3][4]i8{
            [4]i8{ -1,  -2,  -3,  -4 },
            [4]i8{ -5,  -6,  -7,  -8 },
            [4]i8{ -9, -10, -11, -12 }
        },
        [3][4]i8{
            [4]i8{ -13, -14, -15, -16 },
            [4]i8{ -17, -18, -19, -20 },
            [4]i8{ -21, -22, -23, -24 }
        }
    };
}

test whole_array_3d_signed_test {
    let tmp : [2][3][4]i8 = cube();
    assert_eq(tmp, [2][3][4]i8{
        [3][4]i8{
            [4]i8{ -1,  -2,  -3,  -4 },
            [4]i8{ -5,  -6,  -7,  -8 },
            [4]i8{ -9, -10, -11, -12 }
        },
        [3][4]i8{
            [4]i8{ -13, -14, -15, -16 },
            [4]i8{ -17, -18, -19, -20 },
            [4]i8{ -21, -22, -23, -24 }
        }
    });
}

bench "whole_array_3d_signed_bench" {
    let tmp : [2][3][4]i8 = cube();
    assert_eq(tmp, [2][3][4]i8{
        [3][4]i8{
            [4]i8{ -1,  -2,  -3,  -4 },
            [4]i8{ -5,  -6,  -7,  -8 },
            [4]i8{ -9, -10, -11, -12 }
        },
        [3][4]i8{
            [4]i8{ -13, -14, -15, -16 },
            [4]i8{ -17, -18, -19, -20 },
            [4]i8{ -21, -22, -23, -24 }
        }
    });
}

endmodule
