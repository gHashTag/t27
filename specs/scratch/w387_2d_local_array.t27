module w387_2d_local_array;

fn read_2d_numeric() -> u16 {
    var m : [2][3]u16;
    m[0][0] = 0xA1B2;
    m[0][1] = 0xC3D4;
    m[0][2] = 0xE5F6;
    m[1][0] = 0x1234;
    m[1][1] = 0x5678;
    m[1][2] = 0x9ABC;
    return m[1][2];
}

test read_2d_numeric { assert_eq(read_2d_numeric(), 0x9ABC); }

endmodule
