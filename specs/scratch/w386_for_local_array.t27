module w386_for_local_array;

fn fill_and_sum_u16() -> u16 {
    var buf : [4]u16;
    for i in 0..4 {
        buf[i] = 0x1111 * (i + 1);
    }
    var sum : u16 = 0;
    for i in 0..4 {
        sum = sum + buf[i];
    }
    return sum;
}

fn copy_reverse() -> u16 {
    var src : [4]u16;
    var dst : [4]u16;
    src[0] = 0x0100;
    src[1] = 0x0200;
    src[2] = 0x0300;
    src[3] = 0x0400;
    for i in 0..4 {
        dst[3 - i] = src[i];
    }
    return dst[0] + dst[1] + dst[2] + dst[3];
}

test fill_and_sum_u16 { assert_eq(fill_and_sum_u16(), 0x1111 + 0x2222 + 0x3333 + 0x4444); }
test copy_reverse { assert_eq(copy_reverse(), 0x0400 + 0x0300 + 0x0200 + 0x0100); }

endmodule
