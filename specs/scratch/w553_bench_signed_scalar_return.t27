// W553 witness: deterministic bench block asserting a signed scalar function
// return. Exercises $signed(...) probe interpretation inside a bench block.
module w553_bench_signed_scalar_return;

pub fn neg() -> i8 {
    return -42;
}

test signed_scalar_test {
    assert_eq(neg(), -42);
}

bench "signed_scalar_bench" {
    assert_eq(neg(), -42);
}

endmodule
