// W560 witness: expected-side reuse of a scalar-struct return call. Both
// operands of assert_eq use the same call text, so the backend should share a
// single packed-vector temporary.
module w560_bench_scalar_struct_call_dedup_both_sides;

struct Pt {
    x: i16,
    y: i16,
}

pub fn make(a: i16, b: i16) -> Pt {
    return Pt{ .x = a, .y = b };
}

test scalar_struct_call_dedup_both_sides_test {
    assert_eq(make(5, 6), make(5, 6));
}

bench "scalar_struct_call_dedup_both_sides_bench" {
    assert_eq(make(7, 8), make(7, 8));
}

endmodule
