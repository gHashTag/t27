// W552 witness: deterministic bench block asserting equality on a wide packed
// scalar struct returned from a function. Reuses the W540 shape and exercises
// the multi-slice VCD probe path inside a bench block.
module w552_bench_wide_packed_struct;

struct Wide {
    data: [5]u16,
}

pub fn make() -> Wide {
    return Wide{ .data = [5]u16{1, 2, 3, 4, 5} };
}

test wide_packed_struct_array {
    assert_eq(make(), Wide{ .data = [5]u16{1, 2, 3, 4, 5} });
}

bench "wide_struct_bench" {
    assert_eq(make(), Wide{ .data = [5]u16{1, 2, 3, 4, 5} });
}

endmodule
