; SPDX-License-Identifier: Apache-2.0
; t27/specs/scratch/w512_aos_array_field_read.t27
; W512 witness: read scalar and array-typed fields of a packed-element
; bench-local array of structs.
; phi^2 + 1/phi^2 = 3 | TRINITY

module w512_aos_array_field_read;

pub struct S {
    tag : u32,
    vals : [3]u32,
}

fn read_tag(arr : [2]S, i : u8) -> u32 {
    return arr[i].tag;
}

fn read_val(arr : [2]S, i : u8, j : u8) -> u32 {
    return arr[i].vals[j];
}

bench w512_aos_array_field_read_bench {
    let arr : [2]S = [2]S{
        S{.tag = 1, .vals = [10, 20, 30]},
        S{.tag = 2, .vals = [40, 50, 60]},
    };
    assert_eq(read_tag(arr, 0), 1);
    assert_eq(read_tag(arr, 1), 2);
    assert_eq(read_val(arr, 0, 0), 10);
    assert_eq(read_val(arr, 0, 2), 30);
    assert_eq(read_val(arr, 1, 1), 50);
}

endmodule
