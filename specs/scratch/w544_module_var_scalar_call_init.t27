// W544 witness: a mutable module var initialized by a scalar function call,
// then updated by another function call inside a test block.
module w544_module_var_scalar_call_init;

pub fn inc(x : u32) -> u32 {
    return x + 1;
}

var v : u32 = inc(4);

test var_scalar_call_init {
    assert_eq(v, 5);
    v = inc(v);
    assert_eq(v, 6);
}

endmodule
