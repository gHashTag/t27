// SPDX-License-Identifier: Apache-2.0
// W493 positive witness: struct-literal field initialized from a local scalar
// struct variable. The backend lowers the local packed-vector register as one
// concatenation operand.
// φ² + 1/φ² = 3 | TRINITY

module w493_local_scalar_struct_field_lowerable;

pub struct Inner {
    y : u32,
}

pub struct Outer {
    x : Inner,
}

pub fn make_inner(a : u32) -> Inner {
    return Inner { y: a + 1 };
}

pub fn make_outer() -> Outer {
    let inner : Inner = make_inner(5);
    return Outer { x: inner };
}

pub fn get_y() -> u32 {
    return make_outer().x.y;
}

test local_scalar_struct_field {
    assert_eq(get_y(), 6);
}

endmodule
