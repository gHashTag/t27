module w473_module_var_struct_array_field_write;

pub struct Pt {
    x : u16,
    y : u16,
}

pub struct Shape {
    pts : [3]Pt,
}

pub var shapes : [2]Shape = [2]Shape{
    Shape{
        .pts = [3]Pt{
            Pt{.x = 1, .y = 2},
            Pt{.x = 3, .y = 4},
            Pt{.x = 5, .y = 6},
        },
    },
    Shape{
        .pts = [3]Pt{
            Pt{.x = 7, .y = 8},
            Pt{.x = 9, .y = 10},
            Pt{.x = 11, .y = 12},
        },
    },
};

pub fn write_and_read() -> u32 {
    shapes[1].pts[2].x = 100;
    shapes[0].pts[0].y = 200;
    let a : u32 = shapes[1].pts[2].x as u32;
    let b : u32 = shapes[0].pts[0].y as u32;
    return a + b;
}

test module_var_struct_array_field_write {
    assert_eq(write_and_read(), 300);
}

endmodule
