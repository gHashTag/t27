module c_api_contract;

// c_api_contract.t27
//
// This file contains the formal specification of the gHashTag C API contract.
//
// Version: 1.0

// Vector Lifecycle
// Creation and Initialization
export fn c_api_malloc(size: usize) -> *mut u8;
export fn c_api_free(ptr: *mut u8) -> void;
export fn c_api_memcpy(dest: *mut u8, src: *const u8, n: usize) -> *mut u8;
export fn c_api_memmove(dest: *mut u8, src: *const u8, n: usize) -> *mut u8;
export fn c_api_memcmp(ptr1: *const u8, ptr2: *const u8, n: usize) -> i32;
export fn c_api_memset(ptr: *mut u8, value: u8, n: usize) -> *mut u8;
export fn c_api_strlen(ptr: *const u8) -> usize;
export fn c_api_strcpy(dest: *mut u8, src: *const u8) -> *mut u8;
export fn c_api_strncpy(dest: *mut u8, src: *const u8, n: usize) -> *mut u8;
export fn c_api_strcmp(s1: *const u8, s2: *const u8) -> i32;
export fn c_api_strncmp(s1: *const u8, s2: *const u8, n: usize) -> i32;
export fn c_api_tolower(c: u8) -> u8;
export fn c_api_toupper(c: u8) -> u8;
export fn c_api_isalnum(c: u8) -> bool;
export fn c_api_isalpha(c: u8) -> bool;
export fn c_api_isdigit(c: u8) -> bool;
export fn c_api_isxdigit(c: u8) -> bool;
export fn c_api_iscntrl(c: u8) -> bool;
export fn c_api_isgraph(c: u8) -> bool;
export fn c_api_isprint(c: u8) -> u8;
export fn c_api_ispunct(c: u8) -> bool;
export fn c_api_isspace(c: u8) -> bool;
export fn c_api_isupper(c: u8) -> bool;
export fn c_api_islower(c: u8) -> bool;
export fn c_api_isblank(c: u8) -> bool;

// Memory Operations
// Allocation, Copying, and Comparison
export fn c_api_memalloc(size: usize, alignment: usize) -> *mut u8;
export fn c_api_memrealloc(ptr: *mut u8, size: usize) -> *mut u8;
export fn c_api_memalign(alignment: usize, size: usize) -> *mut u8;
export fn c_api_memzero(ptr: *mut u8, size: usize) -> *mut u8;

// String Operations
// Length, Copying, and Comparison
export fn c_api_strnlen(ptr: *const u8, max: usize) -> usize;
export fn c_api_strdup(src: *const u8) -> *mut u8;
export fn c_api_strndup(src: *const u8, n: usize) -> *mut u8;
export fn c_api_strcat(dest: *mut u8, src: *const u8) -> *mut u8;
export fn c_api_strncat(dest: *mut u8, src: *const u8, n: usize) -> *mut u8;

// Conversion Operations
// Numeric and String Conversions
export fn c_api_atoi(ptr: *const u8) -> i32;
export fn c_api_atol(ptr: *const u8) -> i64;
export fn c_api_atof(ptr: *const u8) -> f64;
export fn c_api_itoa(value: i32) -> *mut u8;
export fn c_api_ltoa(value: i64) -> *mut u8;
export fn c_api_ftoa(value: f64, precision: usize) -> *mut u8;

// Vector Operations
// Element-wise Operations
export fn c_api_vadd(a: *const u8, b: *const u8, dest: *mut u8, n: usize) -> *mut u8;
export fn c_api_vsub(a: *const u8, b: *const u8, dest: *mut u8, n: usize) -> *mut u8;
export fn c_api_vmul(a: *const u8, b: *const u8, dest: *mut u8, n: usize) -> *mut u8;
export fn c_api_vdiv(a: *const u8, b: *const u8, dest: *mut u8, n: usize) -> *mut u8;
export fn c_api_vmod(a: *const u8, b: *const u8, dest: *mut u8, n: usize) -> *mut u8;

// Memory and String Utilities
export fn c_api_memchr(ptr: *const u8, value: u8, n: usize) -> *mut u8;
export fn c_api_memrchr(ptr: *const u8, value: u8, n: usize) -> *mut u8;
export fn c_api_strstr(haystack: *const u8, needle: *const u8) -> *mut u8;
export fn c_api_strrstr(haystack: *const u8, needle: *const u8) -> *mut u8;
export fn c_api_strspn(ptr: *const u8, accept: *const u8) -> usize;
export fn c_api_strcspn(ptr: *const u8, reject: *const u8) -> usize;
export fn c_api_strpbrk(ptr: *const u8, accept: *const u8) -> *mut u8;
export fn c_api_strrptr(ptr: *const u8, accept: *const u8) -> *mut u8;
export fn c_api_strtok(str: *mut u8, delim: *const u8) -> *mut u8;
export fn c_api_strtok_r(str: *mut u8, delim: *const u8, saveptr: *mut *mut u8) -> *mut u8;

// Error Handling
export fn c_api_get_last_error() -> i32;
export fn c_api_set_last_error(error: i32) -> void;

// Trinity Vector Specific
export fn trinity_vsa_bind(a: *const u8, b: *const u8, dest: *mut u8, n: usize) -> *mut u8;
export fn trinity_vsa_bundle(vectors: *[*const u8], count: usize, dest: *mut u8, n: usize) -> *mut u8;
export fn trinity_vsa_similarity(a: *const u8, b: *const u8, n: usize) -> f32;
export fn trinity_vsa_cleanup(vec: *mut u8, n: usize) -> *mut u8;
export fn trinity_vsa_from_hex_string(s: *const u8) -> *mut u8;
export fn trinity_vsa_to_hex_string(vec: *const u8, n: usize) -> *mut u8;


