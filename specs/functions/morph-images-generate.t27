// SPDX-License-Identifier: Apache-2.0
; specs/functions/morph-images-generate.t27 -- function morph-images-generate (Inngest, 999-multibots-telegraf)
; Source of truth for the function card on t27.ai (#/functions?function=morph-images-generate).
; The registration was read from 999-multibots-telegraf:src/inngest_app/functions/training/morphImages.ts#L30 (main @a9c08b4).
; ID is the canonical id of the spec-first rename; LEGACY_ID and LEGACY_EVENTS are what the
; deployed code still answers to. STEPS lists step.run names in source order; a ${...} in a
; name is a template the code expands per item. Values here are read from the source, not
; inferred from a name; what could not be read says so in NOTE.
; phi^2 + 1/phi^2 = 3 | TRINITY

module fn_morph_images_generate;

pub const KIND : str = "function";
pub const ID : str = "morph-images-generate";
pub const LEGACY_ID : str = "morph-images";
pub const NAME : str = "Morph images";
pub const REPO : str = "999-multibots-telegraf";
; file:line of inngest.createFunction( in the repo named in REPO
pub const SERVICE : str = "src/inngest_app/functions/training/morphImages.ts:30";
pub const DOMAIN : str = "morph";
; "event" or "cron"; an event function has EVENT (+ LEGACY_EVENTS), a cron function has CRON
pub const TRIGGER : str = "event";
pub const EVENT : str = "morph/images.generate";
pub const LEGACY_EVENTS : [1]str = ["morph/images.requested"];
pub const CRON : str = "";
pub const TZ : str = "UTC";
pub const SUMMARY_EN : str = "Morphs a sequence of user images into one video: checks the user and the balance, notifies the start, processes each image pair into a clip, concatenates the clips, cleans up and delivers the result.";
; step.run names in source order
pub const STEPS : [8]str = ["check-user-exists", "check-balance", "notify-start", "process-all-pairs", "process-loop-pair", "concatenate-all-videos", "cleanup-temp-files", "deliver-result"];
; retries declared on the function; when the code declares none, the Inngest JS SDK v3 default (4) is written and NOTE says so
pub const RETRIES : u8 = 3;
; "admin-telegram" (onFailure handler messages the admin chat), "log" (no handler) or "refund+notify"
pub const ON_FAILURE : str = "log";
; what a run touches outside the function, from a fixed vocabulary (see README)
pub const SIDE_EFFECTS : [2]str = ["paid-api", "messages-user"];
; the first step that stops a bad payload; "none" when the first step already acts, "unknown" when not probed
pub const GUARD : str = "check-user-exists";
; JSON payload of the 2026-09-09 safe probe and what it reached ("" / "skipped" when none was sent; "not-deployed" when the function is not on the probed build)
pub const SAFE_PROBE : str = "{\"telegram_id\": \"0\", \"bot_name\": \"e2e_nonexistent_bot\", \"is_ru\": true, \"job_id\": \"e2e-probe\", \"image_files\": [], \"extraction_path\": \"/nonexistent/e2e\", \"morphing_type\": \"seamless\", \"model\": \"kling-v1.6-pro\"}";
pub const PROBE_RESULT : str = "FAILED-at-guard";
pub const CONTROL : str = "spec+code";
pub const NOTE : str = "Guard is check-user-exists. A second, unregistered copy of this function exists in the tree (src/inngest_app/functions/morphImages.ts); the registered one is the file named in SERVICE. 2026-09-17: charges-balance removed from SIDE_EFFECTS -- the file imports getUserBalance only; check-balance reads the balance against a constant of 50 and nothing in the file deducts it, so the manifest and this spec overstated what the function does with money. deliver-result: video_url is a path on the worker written by concatenate-all-videos, not a URL; the code passed the bare string to sendVideo and sendDocument (read by Telegram as file_id or URL), fell into the catch and sent the user that same path as a download link while returning delivered. Now the file is streamed as { source }, and a failed delivery rethrows so the step is retried and, after RETRIES, onFailure tells the admin. Not verified: a live morph run; the paid Kling calls in process-all-pairs remain unmetered. Test: 999-multibots-telegraf src/__tests__/render/deliveryIsNotSwallowed.test.ts.";

; The card held to the schema of specs/functions/README.md: the vocabularies of its fields,
; what TRIGGER decides about EVENT, LEGACY_EVENTS and CRON, SERVICE as `file:line`, and a
; SAFE_PROBE that agrees with its PROBE_RESULT.
test id_is_domain_object_verb {
    // ID is `<domain>-<object>-<verb>` with DOMAIN from the vocabulary of the README.
    assert DOMAIN == "neuro" or DOMAIN == "reels" or DOMAIN == "training" or DOMAIN == "morph" or DOMAIN == "render" or DOMAIN == "payment" or DOMAIN == "broadcast" or DOMAIN == "instagram" or DOMAIN == "content" or DOMAIN == "monitoring" or DOMAIN == "analytics" or DOMAIN == "webhook" or DOMAIN == "welcome" or DOMAIN == "crm";
    var i : usize = 0;
    while (i < DOMAIN.len) {
        assert ID[i] == DOMAIN[i];
        i = i + 1;
    }
    assert ID[DOMAIN.len] == '-';
    var dashes : u32 = 0;
    var k : usize = DOMAIN.len + 1;
    while (k < ID.len) {
        assert (ID[k] >= 'a' and ID[k] <= 'z') or (ID[k] >= '0' and ID[k] <= '9') or ID[k] == '-';
        if (ID[k] == '-') {
            dashes = dashes + 1;
        }
        k = k + 1;
    }
    assert dashes >= 1;
    assert ID[ID.len - 1] != '-';
}
test an_event_function_has_an_event_and_no_cron {
    // TRIGGER `event`: EVENT is set and CRON is `""` (README; the generator fails otherwise).
    assert TRIGGER == "event";
    assert EVENT.len > 0;
    assert CRON.len == 0;
    // The canonical EVENT names the same three parts as ID: `<domain>/<object>.<verb>` against
    // `<domain>-<object>-<verb>`, so one `/` and the last `.` stand where ID has a `-`.
    assert EVENT.len == ID.len;
    var last_dot : usize = 0;
    var p : usize = 0;
    while (p < EVENT.len) {
        if (EVENT[p] == '.') {
            last_dot = p;
        }
        p = p + 1;
    }
    assert EVENT[DOMAIN.len] == '/';
    assert last_dot > DOMAIN.len;
    var i : usize = 0;
    while (i < EVENT.len) {
        if (i == DOMAIN.len or i == last_dot) {
            assert ID[i] == '-';
        } else {
            assert EVENT[i] == ID[i];
        }
        i = i + 1;
    }
}
test fields_come_from_their_vocabularies {
    assert KIND == "function";
    assert REPO == "999-multibots-telegraf";
    assert TZ == "UTC";
    assert ON_FAILURE == "admin-telegram" or ON_FAILURE == "log" or ON_FAILURE == "refund+notify";
    assert PROBE_RESULT == "COMPLETED" or PROBE_RESULT == "FAILED-at-guard" or PROBE_RESULT == "skipped" or PROBE_RESULT == "not-deployed";
    assert CONTROL == "spec+code" or CONTROL == "spec-only" or CONTROL == "code-only" or CONTROL == "code-only/unregistered";
    assert SIDE_EFFECTS.len > 0;
    var i : usize = 0;
    while (i < SIDE_EFFECTS.len) {
        const e : str = SIDE_EFFECTS[i];
        assert e == "charges-balance" or e == "paid-api" or e == "messages-user" or e == "messages-owners" or e == "messages-admin" or e == "db-write" or e == "external-webhook" or e == "none";
        var j : usize = i + 1;
        while (j < SIDE_EFFECTS.len) {
            assert SIDE_EFFECTS[j] != e;
            j = j + 1;
        }
        i = i + 1;
    }
}
test the_probe_sent_is_json_and_was_answered {
    // SAFE_PROBE is the JSON object sent in the 2026-09-09 probe, so it reached the function:
    // PROBE_RESULT is COMPLETED or FAILED-at-guard.
    assert SAFE_PROBE[0] == '{';
    assert SAFE_PROBE[SAFE_PROBE.len - 1] == '}';
    assert PROBE_RESULT == "COMPLETED" or PROBE_RESULT == "FAILED-at-guard";
    // A probe stopped at a guard names that guard: GUARD is neither `none` (the first step
    // already acts) nor `unknown` (not probed).
    assert GUARD != "none";
    assert GUARD != "unknown";
}
test service_is_file_and_line {
    // SERVICE is `file:line` of inngest.createFunction( in REPO.
    var colon : usize = 0;
    var i : usize = 0;
    while (i < SERVICE.len) {
        if (SERVICE[i] == ':') {
            colon = i;
        }
        i = i + 1;
    }
    assert colon > 0;
    assert colon + 1 < SERVICE.len;
    var d : usize = colon + 1;
    while (d < SERVICE.len) {
        assert SERVICE[d] >= '0' and SERVICE[d] <= '9';
        d = d + 1;
    }
}
