// SPDX-License-Identifier: Apache-2.0
; specs/functions/crm-proactive-sweep.t27 -- function crm-proactive-sweep (Inngest, 999-multibots-telegraf)
; Source of truth for the function card on t27.ai (#/functions?function=crm-proactive-sweep).
; The registration was read from 999-multibots-telegraf:src/inngest_app/functions/crm/crmProactiveSweep.ts#L101 (main @7d48227).
; ID is the canonical id; this function was born spec-first on 2026-09-12, so LEGACY_ID is the
; same id the deployed code registers, and the cron card joins on it.
; STEPS lists step.run names in source order; a ${...} in a name is a template the code
; expands per item. Values here are read from the source, not inferred from a name; what
; could not be read says so in NOTE.
; phi^2 + 1/phi^2 = 3 | TRINITY

module fn_crm_proactive_sweep;

pub const KIND : str = "function";
pub const ID : str = "crm-proactive-sweep";
pub const LEGACY_ID : str = "crm-proactive-sweep";
pub const NAME : str = "CRM: proactive seller sweep";
pub const REPO : str = "999-multibots-telegraf";
; file:line of inngest.createFunction( in the repo named in REPO
pub const SERVICE : str = "src/inngest_app/functions/crm/crmProactiveSweep.ts:101";
pub const DOMAIN : str = "crm";
; "event" or "cron"; an event function has EVENT (+ LEGACY_EVENTS), a cron function has CRON
pub const TRIGGER : str = "cron";
pub const EVENT : str = "";
pub const LEGACY_EVENTS : [0]str = [];
pub const CRON : str = "*/30 * * * *";
pub const TZ : str = "UTC";
pub const SUMMARY_EN : str = "Every 30 minutes resolves the connected sellers (owner first) and runs one proactive CRM tick per seller, each in its own step, so a seller's stalled clients get a card in the seller's Telegram; one run at a time, no retries.";
; step.run names in source order; sweep-${owner} runs once per resolved seller, sequentially
pub const STEPS : [2]str = ["resolve-sellers", "sweep-${owner}"];
; retries declared on the function; when the code declares none, the Inngest JS SDK v3 default (4) is written and NOTE says so
pub const RETRIES : u8 = 0;
; "admin-telegram" (onFailure handler messages the admin chat), "log" (no handler) or "refund+notify"
pub const ON_FAILURE : str = "admin-telegram";
; what a run touches outside the function, from a fixed vocabulary (see README)
pub const SIDE_EFFECTS : [5]str = ["messages-owners", "messages-user", "paid-api", "external-webhook", "db-write"];
; the first step that stops a bad payload; "none" when the first step already acts, "unknown" when not probed
pub const GUARD : str = "safe-mode";
; JSON payload of the 2026-09-09 safe probe and what it reached ("" / "skipped" when none was sent; "not-deployed" when the function is not on the probed build)
pub const SAFE_PROBE : str = "";
pub const PROBE_RESULT : str = "skipped";
pub const CONTROL : str = "spec+code";
pub const NOTE : str = "Born 2026-09-12 when the proactive sweep left an in-process setInterval (CRM_SWEEP_DRIVER=timer restores it, CRM_PROACTIVE_MINUTES=0 disables both). Concurrency 1 and retries 0 because a tick may push a card to a seller; a retry or an overlap could push a second one. Safe mode (e2e_test=true) skips the run entirely; no carrier registered returns did=paused, not an error. 2026-09-17: three FAILED runs on 2026-09-16 (durations 15 s, 2m02s, 5m00s) all read 'HTTP 502 before the SDK responded' on the self-hosted Inngest dashboard -- until then the whole tick was one step.run(sweep), i.e. one HTTP request carrying every seller in turn, each allowed up to INGEST_TIMEOUT_MS=170 s; the Railway edge cut the request. Now resolve-sellers is a step and each seller is a sweep-<id> step: one request per seller, finished sellers memoized, the trace names the seller a 502 landed on. Not verified: which seller each 502 hit, and whether the two short failures were a redeploy under the request. Test: 999-multibots-telegraf src/__tests__/services/crmProactive.sweepSteps.test.ts. 2026-10-07: LEGACY_ID, GUARD, SIDE_EFFECTS and the probe fields were corrected after gHashTag/trinity#1124 wrote its own reading of this function straight into the site mirror; each was checked against 999 main 40d0531eb. The code registers the id crm-proactive-sweep (crmProactiveSweep.ts#L103), the id the cron card inngest/999-multibots-telegraf/crm-proactive-sweep joins on. It returns on isSafeMode before its first step. The card goes to the seller's own private chat (services/crmProactive.ts pushCard), after the render's CRM tools are called over HTTP and a model turn is paid for; when the seller has turned autopilot on (999 #2903, #2925), pushCard confirms the draft through the render's POST /api/tg/proposal/confirm instead, and the message lands in the client's chat from the seller's account with no press, so messages-user stays. No safe probe was sent: the 2026-09-09 probe pass predates the registration.";

; The card held to the schema of specs/functions/README.md: the vocabularies of its fields,
; what TRIGGER decides about EVENT, LEGACY_EVENTS and CRON, SERVICE as `file:line`, and a
; SAFE_PROBE that agrees with its PROBE_RESULT.
test id_is_domain_object_verb {
    // ID is `<domain>-<object>-<verb>` with DOMAIN from the vocabulary of the README.
    assert DOMAIN == "neuro" or DOMAIN == "reels" or DOMAIN == "training" or DOMAIN == "morph" or DOMAIN == "render" or DOMAIN == "payment" or DOMAIN == "broadcast" or DOMAIN == "instagram" or DOMAIN == "content" or DOMAIN == "monitoring" or DOMAIN == "analytics" or DOMAIN == "webhook" or DOMAIN == "welcome" or DOMAIN == "crm";
    var i : usize = 0;
    while (i < DOMAIN.len) {
        assert ID[i] == DOMAIN[i];
        i = i + 1;
    }
    assert ID[DOMAIN.len] == '-';
    var dashes : u32 = 0;
    var k : usize = DOMAIN.len + 1;
    while (k < ID.len) {
        assert (ID[k] >= 'a' and ID[k] <= 'z') or (ID[k] >= '0' and ID[k] <= '9') or ID[k] == '-';
        if (ID[k] == '-') {
            dashes = dashes + 1;
        }
        k = k + 1;
    }
    assert dashes >= 1;
    assert ID[ID.len - 1] != '-';
}
test a_cron_function_has_a_cron_and_no_event {
    // TRIGGER `cron`: CRON is a five-field cron expression, EVENT is `""` and LEGACY_EVENTS
    // is empty (README; the generator fails otherwise).
    assert TRIGGER == "cron";
    assert EVENT.len == 0;
    assert LEGACY_EVENTS.len == 0;
    assert CRON[0] != ' ';
    assert CRON[CRON.len - 1] != ' ';
    var spaces : u32 = 0;
    var i : usize = 0;
    while (i < CRON.len) {
        const c : u8 = CRON[i];
        if (c == ' ') {
            spaces = spaces + 1;
            assert CRON[i + 1] != ' ';
        } else {
            assert (c >= '0' and c <= '9') or c == '*' or c == '/' or c == ',' or c == '-';
        }
        i = i + 1;
    }
    assert spaces == 4;
}
test fields_come_from_their_vocabularies {
    assert KIND == "function";
    assert REPO == "999-multibots-telegraf";
    assert TZ == "UTC";
    assert ON_FAILURE == "admin-telegram" or ON_FAILURE == "log" or ON_FAILURE == "refund+notify";
    assert PROBE_RESULT == "COMPLETED" or PROBE_RESULT == "FAILED-at-guard" or PROBE_RESULT == "skipped" or PROBE_RESULT == "not-deployed";
    assert CONTROL == "spec+code" or CONTROL == "spec-only" or CONTROL == "code-only" or CONTROL == "code-only/unregistered";
    assert SIDE_EFFECTS.len > 0;
    var i : usize = 0;
    while (i < SIDE_EFFECTS.len) {
        const e : str = SIDE_EFFECTS[i];
        assert e == "charges-balance" or e == "paid-api" or e == "messages-user" or e == "messages-owners" or e == "messages-admin" or e == "db-write" or e == "external-webhook" or e == "none";
        var j : usize = i + 1;
        while (j < SIDE_EFFECTS.len) {
            assert SIDE_EFFECTS[j] != e;
            j = j + 1;
        }
        i = i + 1;
    }
}
test no_probe_was_sent {
    // SAFE_PROBE is `""` when none was sent, and PROBE_RESULT then says why: `skipped`, or
    // `not-deployed` with GUARD `unknown`.
    assert SAFE_PROBE.len == 0;
    assert PROBE_RESULT == "skipped" or PROBE_RESULT == "not-deployed";
    assert PROBE_RESULT != "not-deployed" or GUARD == "unknown";
}
test service_is_file_and_line {
    // SERVICE is `file:line` of inngest.createFunction( in REPO.
    var colon : usize = 0;
    var i : usize = 0;
    while (i < SERVICE.len) {
        if (SERVICE[i] == ':') {
            colon = i;
        }
        i = i + 1;
    }
    assert colon > 0;
    assert colon + 1 < SERVICE.len;
    var d : usize = colon + 1;
    while (d < SERVICE.len) {
        assert SERVICE[d] >= '0' and SERVICE[d] <= '9';
        d = d + 1;
    }
}
