// SPDX-License-Identifier: Apache-2.0
; specs/functions/ton-pending-watch.t27 -- function ton-pending-watch (Inngest, 999-multibots-telegraf)
; Source of truth for the function card on t27.ai (#/functions?function=ton-pending-watch).
; The registration was read from 999-multibots-telegraf:src/inngest_app/functions/money/tonPendingWatch.ts#L51 (main @05fd960).
; ID is the canonical id of the spec-first rename; LEGACY_ID and LEGACY_EVENTS are what the
; deployed code still answers to. STEPS lists step.run names in source order; a ${...} in a
; name is a template the code expands per item. Values here are read from the source, not
; inferred from a name; what could not be read says so in NOTE.
; phi^2 + 1/phi^2 = 3 | TRINITY

module fn_ton_pending_watch;

pub const KIND : str = "function";
pub const ID : str = "ton-pending-watch";
pub const LEGACY_ID : str = "ton-pending-watch";
pub const NAME : str = "Money: TON that arrived and was never credited";
pub const REPO : str = "999-multibots-telegraf";
; file:line of inngest.createFunction( in the repo named in REPO
pub const SERVICE : str = "src/inngest_app/functions/money/tonPendingWatch.ts:51";
pub const DOMAIN : str = "money";
; "event" or "cron"; an event function has EVENT (+ LEGACY_EVENTS), a cron function has CRON
pub const TRIGGER : str = "cron";
pub const EVENT : str = "";
pub const LEGACY_EVENTS : [0]str = [];
pub const CRON : str = "0 * * * *";
pub const TZ : str = "UTC";
pub const SUMMARY_EN : str = "Every hour reads the pending TON invoices, asks the chain whether the coins actually arrived, and writes one journal line to the render saying either that nothing is unclaimed or that somebody paid and was never credited. It reads only; it never completes a payment.";
; step.run names in source order
pub const STEPS : [1]str = ["look"];
; retries declared on the function; when the code declares none, the Inngest JS SDK v3 default (4) is written and NOTE says so
pub const RETRIES : u8 = 0;
; "admin-telegram" (onFailure handler messages the admin chat), "log" (no handler) or "refund+notify"
pub const ON_FAILURE : str = "admin-telegram";
; what a run touches outside the function, from a fixed vocabulary (see README)
pub const SIDE_EFFECTS : [2]str = ["paid-api", "external-webhook"];
; the first step that stops a bad payload; "none" when the first step already acts, "unknown" when not probed
pub const GUARD : str = "safe-mode";
; JSON payload of the 2026-09-09 safe probe and what it reached ("" / "skipped" when none was sent; "not-deployed" when the function is not on the probed build)
pub const SAFE_PROBE : str = "";
pub const PROBE_RESULT : str = "skipped";
pub const CONTROL : str = "spec+code";
pub const NOTE : str = "No safe probe has been sent: the 2026-09-09 probe pass predates this registration, which is why the manifest row carries no deployment reading. The live status endpoint answered on 2026-09-22 with 94 runs over seven days and none failed. SIDE_EFFECTS drops the manifest's db-read, which the catalog vocabulary cannot say, and adds external-webhook for the note the run posts to the render; the table read is stated here instead. GUARD is the isSafeMode early return at the top of the handler, which the manifest recorded as none. A chain the watcher cannot read returns did=unreadable and writes no quiet note, so a broken read never records a clean channel; that alarm is throttled to once every six hours.";

test "schema validation" {
  // Test KIND
  assert_eq KIND "function";

  // Test ID format: domain-object-verb
  let id_parts = split ID "-";
  assert_eq (len id_parts) 3;
  assert_eq (id_parts[0]) "money"; // DOMAIN from vocabulary

  // Test TRIGGER rules (cron function)
  assert_eq TRIGGER "cron";
  assert_eq EVENT "";
  assert_eq LEGACY_EVENTS [];
  assert_eq CRON "0 * * * *";
  assert_eq TZ "UTC";

  // Test ON_FAILURE vocabulary
  assert_eq ON_FAILURE "admin-telegram";
  assert ON_FAILURE == "admin-telegram" || ON_FAILURE == "log" || ON_FAILURE == "refund+notify";

  // Test SIDE_EFFECTS vocabulary and uniqueness
  assert_eq (len SIDE_EFFECTS) 2;
  assert contains SIDE_EFFECTS "paid-api";
  assert contains SIDE_EFFECTS "external-webhook";
  assert_eq (len (set SIDE_EFFECTS)) (len SIDE_EFFECTS); // No duplicates

  // Test PROBE_RESULT vocabulary
  assert_eq PROBE_RESULT "skipped";
  assert PROBE_RESULT == "COMPLETED" || PROBE_RESULT == "FAILED-at-guard" || PROBE_RESULT == "skipped" || PROBE_RESULT == "not-deployed";

  // Test CONTROL vocabulary
  assert_eq CONTROL "spec+code";
  assert CONTROL == "spec+code" || CONTROL == "spec-only" || CONTROL == "code-only" || CONTROL == "code-only/unregistered";

  // Test SAFE_PROBE agrees with PROBE_RESULT
  assert_eq SAFE_PROBE "";
  assert_eq PROBE_RESULT "skipped";

  // Test KIND, REPO, TZ schema
  assert_eq KIND "function";
  assert_eq REPO "999-multibots-telegraf";
  assert_eq TZ "UTC";

  // Test SERVICE format: file:line
  let service_parts = split SERVICE ":";
  assert_eq (len service_parts) 2;
  assert (service_parts[0] != "") && (service_parts[1] != "");

  // Test CRON format (5 fields)
  let cron_parts = split CRON " ";
  assert_eq (len cron_parts) 5;
}
