// SPDX-License-Identifier: Apache-2.0
// specs/t27os/labs.t27 -- the t27b lab as a T27 OS actor (issue #11783).
// One actor drives the lab sequence the Railway lab ran: fetch, build,
// corpus, reference path, ratchet, fuzz -- publishes the same JSON shape
// to the devices feed so `tri t27b doctor` and receipt comparison keep
// working -- and settles the run through the settle bridge (issue #11858):
// the run's receipt + the run challenge go to settle_bridge.t27's
// bridge_pay/bridge_settle, imported, the laws compose. The lab's
// orchestration lives here as t27 law; the commands it runs go through the
// OS's own PTY (pty_server.t27), not a separate daemon.
//
// WHAT IS NOT HERE: the build recipes (install.t27 owns the toolchain), the
// feed format (devices.t27), the receipt signing (t27c corpus-receipt -- the
// lab calls it, it does not reimplement it), the Railway lab itself
// (contrib/railway/t27b-lab -- stays as a remote fallback per FR-005), the
// settle amounts (ledger.t27's REWARD_PER_JOB_MTRI and payout.t27's shares
// own them; this wiring decides no rate, no amount, no split and registers
// no node -- the registry act is the owner's), and the receipt schema: the
// published receipt JSON is t27c corpus-receipt's shape, outside this tree,
// so the settle outcome (the OUT_* verdict and the payout gate's answer)
// travels in the bridge's own BridgeAnswer here and gains no field in any
// receipt schema from this spec.
//
// The SETTLE step's verdict reaches the actor's run state through
// settle_run_state: RUN_OK only on payout()'s PAY_NORMAL for a verified
// receipt; RUN_FAILED on every refusal, every slash and every credited job
// the tests did not verify. The mapping reads the BridgeAnswer only, and
// no mTRI moves on any of it.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module labs;

// the laws the settle step composes (settle_bridge.t27 and its own imports)
use t27os::settle_bridge::{bridge_pay, LabReceipt, Verification, SettlementRecord, BridgeAnswer, SB_OK, SB_REFUSE_NONCE, SB_REFUSE_VERIFICATIONS};
use network::identity::{IdentityTable, identity_table};
use trinet::ledger::{Ledger, ledger_init, default_policy, register_node, V_OK, V_WRONG_RESULT};
use verified::payout::{OUT_CREDITED, OUT_NOT_ELIGIBLE, PAY_NORMAL, PAY_SLASH_ONLY, PAY_NONE};

// --- lab run steps -------------------------------------------------------

pub const STEP_FETCH : u8 = 0;
pub const STEP_BUILD_T27C : u8 = 1;
pub const STEP_BUILD_T27B : u8 = 2;
pub const STEP_CORPUS : u8 = 3;
pub const STEP_REFERENCE : u8 = 4;
pub const STEP_CARGO_TESTS : u8 = 5;
pub const STEP_RATCHET : u8 = 6;
pub const STEP_FUZZ : u8 = 7;
pub const STEP_PUBLISH : u8 = 8;
pub const STEP_SETTLE : u8 = 9;
pub const STEP_COUNT : u8 = 10;

// step names, one per STEP_* constant, in run order
pub const STEP_NAMES : str = "fetch,build-t27c,build-t27b,corpus,reference,cargo-tests,ratchet,fuzz,publish,settle";

// --- run states ----------------------------------------------------------

pub const RUN_PENDING : u8 = 0;
pub const RUN_RUNNING : u8 = 1;
pub const RUN_OK : u8 = 2;
pub const RUN_FAILED : u8 = 3;

// --- pure functions ------------------------------------------------------

// step_name(s): the name of step s, or "?" for an out-of-range step. The
// names are spelled per step (land.t27's pattern): the language cannot split
// the joined STEP_NAMES text into per-step names, and a per-step function is
// pinable name by name -- the body before #11858 returned the whole joined
// list for every in-range step, which named no step at all.
pub fn step_name(s: u8) -> str {
    if (s == STEP_FETCH) { return "fetch"; }
    if (s == STEP_BUILD_T27C) { return "build-t27c"; }
    if (s == STEP_BUILD_T27B) { return "build-t27b"; }
    if (s == STEP_CORPUS) { return "corpus"; }
    if (s == STEP_REFERENCE) { return "reference"; }
    if (s == STEP_CARGO_TESTS) { return "cargo-tests"; }
    if (s == STEP_RATCHET) { return "ratchet"; }
    if (s == STEP_FUZZ) { return "fuzz"; }
    if (s == STEP_PUBLISH) { return "publish"; }
    if (s == STEP_SETTLE) { return "settle"; }
    return "?";
}

// is_final_step(s): true when s is the last step in the sequence.
pub fn is_final_step(s: u8) -> bool {
    return s == STEP_COUNT - 1;
}

// run_ok(ok, forced): a run verdict. The Railway lab's rule carries over: a
// forced test run or a failed test is never a clean pass.
pub fn run_verdict(ok: bool, forced: bool, failed: u32) -> u8 {
    if (forced) {
        return RUN_FAILED;
    }
    if (failed > 0) {
        return RUN_FAILED;
    }
    if (ok) {
        return RUN_OK;
    }
    return RUN_FAILED;
}

// --- the master repair cycle (proven 3x: #11735, #11786 pass 1 and 2) ------

// The ten local gates the repair cycle runs, in order. Every one exits 0 on
// a green tree, and every one runs on this machine -- no external service.
pub const GATE_WIDTHS : u8 = 0;
pub const GATE_TYPES_RATCHET : u8 = 1;
pub const GATE_TYPES_CLASSIFIED : u8 = 2;
pub const GATE_SEAL_COVERAGE : u8 = 3;
pub const GATE_SEAL_CURRENCY : u8 = 4;
pub const GATE_RING_DRIFT : u8 = 5;
pub const GATE_ASSERTIONLESS : u8 = 6;
pub const GATE_DOCUMENTED_CMDS : u8 = 7;
pub const GATE_EMIT_BITEXACT : u8 = 8;
pub const GATE_COUNT : u8 = 9;

// repair_needed(type_red, classified_red, coverage_red, currency_red,
//               widths_red, assertionless_red, documented_red, emit_red):
// the trigger rule. ANY red local gate means the repair cycle runs before
// any new work lands -- the port-train wave breaks master, the cycle
// clears it in ~3 minutes locally, and the repair PR opens itself.
pub fn repair_needed(type_red: bool, classified_red: bool, coverage_red: bool,
                     currency_red: bool, widths_red: bool, assertionless_red: bool,
                     documented_red: bool, emit_red: bool) -> bool {
    return type_red || classified_red || coverage_red || currency_red
        || widths_red || assertionless_red || documented_red || emit_red;
}

// gates_green(green_count): all GATE_COUNT gates must pass; 8 of 8.
pub fn gates_green(green_count: u8) -> bool {
    return green_count == GATE_COUNT;
}

// --- the settle step (the wiring; the law is settle_bridge.t27's) ----------

// After publish, the actor settles the run: the run's receipt + the run
// challenge go through the settle bridge. The wiring's own rule is the
// nonce: it IS the run challenge, never the actor's invention -- a challenge
// past the ledger's u32 nonce reaches the bridge's refusal (SB_REFUSE_NONCE),
// it does not truncate. The nonce is derived from the receipt here, never
// passed in, so an actor-side nonce-vs-challenge mismatch is not producible
// by construction; a caller-level mismatch is the bridge's own refusal,
// pinned in settle_bridge.t27 (the_nonce_is_the_challenge), which this step
// delegates to unchanged. Whether the call settles is the bridge's answer:
// the identity table, the two verifications and the coordinator's verdict
// pass through unchanged, and the amounts stay in the laws (ledger.t27 and
// payout.t27) -- no rate, no amount, no split, no registry here.
pub fn settle_step(l: Ledger, tab: IdentityTable, rec: LabReceipt,
                   v1: Verification, v2: Verification, node: u32, verdict: u8,
                   record: SettlementRecord) -> BridgeAnswer {
    const challenge : u64 = rec.challenge;
    return bridge_pay(l, tab, rec, v1, v2, node, (challenge as u32), verdict, record);
}

// --- the executor's surface steps (t27os#10: receipts lost) ----------------

// The executor (t27os .github/workflows/lab.yml, proposed by TRI CLAW from
// this law) measures the named specs, then runs optional surfaces, then
// writes the receipt. Three measured ways a run lost its receipt: the
// encoder fetch ran on every dispatch and died on a third-party CDN (~40%);
// a surface failure skipped the receipt step after the measurement had
// already run (run 39987596010); a full sha went through an unauthenticated
// API lookup that answered null (run 39993710023).
pub const SURF_ENCODER_FETCH : u8 = 0;
pub const SURF_M6 : u8 = 1;
pub const SURF_WASM : u8 = 2;
pub const SURF_COUNT : u8 = 3;
pub const SHA_HEX_LEN : u32 = 40;

// surface_runs(s, m6, wasm): the encoder fetch belongs to M6 -- a dispatch
// with m6 off never touches the encoder CDN. Out-of-range surfaces never run.
pub fn surface_runs(s: u8, m6: bool, wasm: bool) -> bool {
    if (s == SURF_ENCODER_FETCH or s == SURF_M6) {
        return m6;
    }
    if (s == SURF_WASM) {
        return wasm;
    }
    return false;
}

// receipt_written(measured, surface_failed): once the measurement step ran,
// the receipt is written whatever a later surface did -- the failure goes
// INTO the receipt, it does not erase it. No measurement, no receipt.
pub fn receipt_written(measured: bool, surface_failed: bool) -> bool {
    if (surface_failed and measured) {
        return true;
    }
    return measured;
}

// sha_needs_lookup(len, lower_hex): a ref that is already 40 lowercase hex is
// the sha; only a short sha, a branch or an empty ref goes to the API.
pub fn sha_needs_lookup(len: u32, lower_hex: bool) -> bool {
    if (len == SHA_HEX_LEN and lower_hex) {
        return false;
    }
    return true;
}

// sha_resolved_ok(len, lower_hex): the lookup's answer is accepted only when
// it is 40 hex; anything else (null, a rate-limit body) fails the step with
// the body printed, never checks out a branch named "null".
pub fn sha_resolved_ok(len: u32, lower_hex: bool) -> bool {
    return len == SHA_HEX_LEN and lower_hex;
}

// The SETTLE step's contribution to the actor's run state: a settle is OK
// only when payout() answered PAY_NORMAL for a verified receipt -- the green
// settle. Everything else is RUN_FAILED: a refusal (nothing was attempted),
// a slash the coordinator decided (PAY_SLASH_ONLY), and a job the ledger
// credited that still paid nothing because the receipt's counts were not
// green. The ledger's OUT_* alone never decides the run state -- the payout
// gate's answer and the receipt's verdict do.
pub fn settle_run_state(a: BridgeAnswer) -> u8 {
    if (a.pay == PAY_NORMAL and a.verified) {
        return RUN_OK;
    }
    return RUN_FAILED;
}

// The mapping law, on real settle_step calls (never hand-built answers):
// the green settle maps to RUN_OK, and a refusal, a slash and an unverified
// credited job each map to RUN_FAILED. Returns false on any violation.
pub fn settle_run_state_law_holds() -> bool {
    const rec : LabReceipt = LabReceipt { challenge: 11789, receipt_key: "25d5b8373b6d9986", tests_failed: 0, tests_vacuous: 0, stamp: true };
    const v1 : Verification = Verification { present: true, verifier_key: "5b5b5b5b5b5b5b5b", reproduced: true };
    const v2 : Verification = Verification { present: true, verifier_key: "6c6c6c6c6c6c6c6c", reproduced: true };
    const record : SettlementRecord = SettlementRecord { names_challenge: 11789, verdict_named: true };
    const l : Ledger = register_node(ledger_init(default_policy()), 1505, 6774813, true, 5000);
    // the green settle: PAY_NORMAL on a verified receipt, RUN_OK
    const ok = settle_step(l, identity_table(), rec, v1, v2, 1505, V_OK, record);
    if (ok.pay != PAY_NORMAL or ok.verified == false) { return false; }
    if (settle_run_state(ok) != RUN_OK) { return false; }
    // one verification short: the bridge refuses, nothing is attempted,
    // RUN_FAILED
    const none : Verification = Verification { present: false, verifier_key: "", reproduced: false };
    const short = settle_step(l, identity_table(), rec, v1, none, 1505, V_OK, record);
    if (short.attempt or short.refuse != SB_REFUSE_VERIFICATIONS) { return false; }
    if (settle_run_state(short) != RUN_FAILED) { return false; }
    // the coordinator caught the receipt: the slash stays a failed settle
    const slashed = settle_step(l, identity_table(), rec, v1, v2, 1505, V_WRONG_RESULT, record);
    if (slashed.pay != PAY_SLASH_ONLY) { return false; }
    if (settle_run_state(slashed) != RUN_FAILED) { return false; }
    // a job the ledger credited on a receipt the tests failed: pays nothing,
    // RUN_FAILED
    var failing : LabReceipt = rec;
    failing.tests_failed = 1;
    const unverified = settle_step(l, identity_table(), failing, v1, v2, 1505, V_OK, record);
    if (unverified.verified) { return false; }
    return settle_run_state(unverified) == RUN_FAILED;
}

invariant settle_maps_green_to_run_ok_and_everything_else_to_run_failed {
    assert settle_run_state_law_holds();
}

// --- tests ---------------------------------------------------------------

// The sequence's pin. History, honestly: #11784 landed the actor with NINE
// steps (fetch..publish, STEP_COUNT = 9) and this test pinned 9 under the
// name step_names_are_nine; #11858's work item 2 wired the SETTLE step in
// as the tenth, AFTER publish (#11861 on master) -- the count moved 9 -> 10
// and the names gained ",settle". The count, the names and this test are
// one truth: edit them together.
test step_names_are_ten {
    assert STEP_COUNT == 10;
    // ten names, in run order, the last is settle
    assert step_name(0) == "fetch";
    assert step_name(STEP_BUILD_T27C) == "build-t27c";
    assert step_name(STEP_BUILD_T27B) == "build-t27b";
    assert step_name(STEP_CORPUS) == "corpus";
    assert step_name(STEP_REFERENCE) == "reference";
    assert step_name(STEP_CARGO_TESTS) == "cargo-tests";
    assert step_name(STEP_RATCHET) == "ratchet";
    assert step_name(STEP_FUZZ) == "fuzz";
    assert step_name(STEP_PUBLISH) == "publish";
    assert step_name(STEP_SETTLE) == "settle";
    // settle happens AFTER publish: the order in the sequence is the law
    assert STEP_FETCH < STEP_PUBLISH and STEP_PUBLISH < STEP_SETTLE;
    assert STEP_SETTLE + 1 == STEP_COUNT;
    // the joined constant agrees with the ten names: 75 name bytes
    // (5+10+10+6+9+11+7+4+7+6) plus 9 commas = 84
    assert STEP_NAMES.len == 84;
}

test step_name_out_of_range {
    const unknown = step_name(99);
    assert unknown == "?";
}

test final_step_is_settle {
    assert is_final_step(STEP_SETTLE) == true;
    assert is_final_step(STEP_PUBLISH) == false;
    assert is_final_step(STEP_FETCH) == false;
}

test run_verdict_fails_on_forced {
    const ok_run = run_verdict(true, false, 0);
    assert ok_run == RUN_OK;
    const forced_run = run_verdict(true, true, 0);
    assert forced_run == RUN_FAILED;
    const failed_run = run_verdict(true, false, 1);
    assert failed_run == RUN_FAILED;
}

test repair_needed_fires_on_any_red {
    // any single red gate fires the repair cycle
    assert repair_needed(true, false, false, false, false, false, false, false) == true;
    assert repair_needed(false, true, false, false, false, false, false, false) == true;
    assert repair_needed(false, false, false, false, true, false, false, false) == true;
    assert repair_needed(false, false, false, false, false, false, false, true) == true;
    // all green -> no repair
    assert repair_needed(false, false, false, false, false, false, false, false) == false;
}

test gates_green_requires_all_nine {
    assert gates_green(GATE_COUNT) == true;
    assert gates_green(GATE_COUNT - 1) == false;
    assert gates_green(0) == false;
}

// The wired settle: the actor's nonce IS the run challenge, and with the real
// table binding the lab's receipt key (PR #11850 -- the landed truth
// settle_bridge.t27's tripwire pins; both flip together if the row ever
// moves) the wired call proceeds to the green settle, the ledger law's own
// reward and nothing else.
test settle_step_wires_the_nonce_to_the_challenge {
    const rec : LabReceipt = LabReceipt { challenge: 11789, receipt_key: "25d5b8373b6d9986", tests_failed: 0, tests_vacuous: 0, stamp: true };
    const v1 : Verification = Verification { present: true, verifier_key: "5b5b5b5b5b5b5b5b", reproduced: true };
    const v2 : Verification = Verification { present: true, verifier_key: "6c6c6c6c6c6c6c6c", reproduced: true };
    const record : SettlementRecord = SettlementRecord { names_challenge: 11789, verdict_named: true };
    const l : Ledger = register_node(ledger_init(default_policy()), 1505, 6774813, true, 5000);
    const a = settle_step(l, identity_table(), rec, v1, v2, 1505, V_OK, record);
    assert a.attempt and a.refuse == SB_OK;
    assert a.nonce == 11789;
    assert a.outcome == OUT_CREDITED and a.pay == PAY_NORMAL;
}

// The wiring does not truncate: a receipt whose challenge is past the
// ledger's u32 nonce reaches the bridge's nonce refusal through the same
// wired call -- no settle attempt, the OUT_NOT_ELIGIBLE shape, nothing paid.
test settle_step_refuses_a_challenge_past_the_u32_nonce {
    const big : LabReceipt = LabReceipt { challenge: 39970371982, receipt_key: "25d5b8373b6d9986", tests_failed: 0, tests_vacuous: 0, stamp: true };
    const v1 : Verification = Verification { present: true, verifier_key: "5b5b5b5b5b5b5b5b", reproduced: true };
    const v2 : Verification = Verification { present: true, verifier_key: "6c6c6c6c6c6c6c6c", reproduced: true };
    const record : SettlementRecord = SettlementRecord { names_challenge: 39970371982, verdict_named: true };
    const l : Ledger = register_node(ledger_init(default_policy()), 1505, 6774813, true, 5000);
    const big_challenge : u64 = big.challenge;
    const truncated : u64 = (big_challenge as u32) as u64;
    const a = settle_step(l, identity_table(), big, v1, v2, 1505, V_OK, record);
    assert a.attempt == false and a.refuse == SB_REFUSE_NONCE;
    assert truncated != big_challenge;
    assert a.outcome == OUT_NOT_ELIGIBLE and a.pay == PAY_NONE;
}

// t27os#10: an m6=false dispatch never runs the encoder fetch (the CDN that
// killed ~40% of runs); with m6 on it does; wasm follows its own flag.
test encoder_fetch_runs_only_with_m6 {
    assert surface_runs(SURF_ENCODER_FETCH, false, false) == false;
    assert surface_runs(SURF_ENCODER_FETCH, false, true) == false;
    assert surface_runs(SURF_ENCODER_FETCH, true, false) == true;
    assert surface_runs(SURF_M6, false, true) == false;
    assert surface_runs(SURF_WASM, false, true) == true;
    assert surface_runs(SURF_WASM, true, false) == false;
    assert surface_runs(SURF_COUNT, true, true) == false;
}

// run 39987596010: step 7 measured kernel 10/10 and lanes_view 42/42, M6
// failed, and no receipt was written. The law: that run writes its receipt.
test a_surface_failure_keeps_the_receipt {
    assert receipt_written(true, true) == true;
    assert receipt_written(true, false) == true;
    assert receipt_written(false, true) == false;
    assert receipt_written(false, false) == false;
}

// run 39993710023: a full 40-hex sha went to the API and came back null.
test a_full_sha_is_used_as_is {
    assert sha_needs_lookup(40, true) == false;
    assert sha_needs_lookup(9, true) == true;
    assert sha_needs_lookup(40, false) == true;
    assert sha_needs_lookup(0, false) == true;
    // "null" is 4 bytes, not 40 hex: the step fails instead of checking it out
    assert sha_resolved_ok(4, false) == false;
    assert sha_resolved_ok(40, true) == true;
    assert sha_resolved_ok(40, false) == false;
}

// The mapping, case by case, on real settle_step calls: PAY_NORMAL on a
// verified receipt is the only RUN_OK; a refusal (SB_REFUSE_VERIFICATIONS),
// the coordinator's slash (PAY_SLASH_ONLY) and a credited-but-unverified job
// are RUN_FAILED each.
test settle_run_state_maps_the_bridge_answer {
    const rec : LabReceipt = LabReceipt { challenge: 11789, receipt_key: "25d5b8373b6d9986", tests_failed: 0, tests_vacuous: 0, stamp: true };
    const v1 : Verification = Verification { present: true, verifier_key: "5b5b5b5b5b5b5b5b", reproduced: true };
    const v2 : Verification = Verification { present: true, verifier_key: "6c6c6c6c6c6c6c6c", reproduced: true };
    const record : SettlementRecord = SettlementRecord { names_challenge: 11789, verdict_named: true };
    const l : Ledger = register_node(ledger_init(default_policy()), 1505, 6774813, true, 5000);
    const a = settle_step(l, identity_table(), rec, v1, v2, 1505, V_OK, record);
    assert a.pay == PAY_NORMAL and a.verified;
    assert settle_run_state(a) == RUN_OK;
    const none : Verification = Verification { present: false, verifier_key: "", reproduced: false };
    const b = settle_step(l, identity_table(), rec, v1, none, 1505, V_OK, record);
    assert b.attempt == false and b.refuse == SB_REFUSE_VERIFICATIONS;
    assert settle_run_state(b) == RUN_FAILED;
    const c = settle_step(l, identity_table(), rec, v1, v2, 1505, V_WRONG_RESULT, record);
    assert c.pay == PAY_SLASH_ONLY and c.verified;
    assert settle_run_state(c) == RUN_FAILED;
    var failing : LabReceipt = rec;
    failing.tests_failed = 1;
    const d = settle_step(l, identity_table(), failing, v1, v2, 1505, V_OK, record);
    assert d.verified == false and d.pay == PAY_NONE;
    assert settle_run_state(d) == RUN_FAILED;
}

// The mapping law's run-time twin (the invariant runs it at compile time;
// this runs the same fn at run time so a comptime-only pass cannot hide a
// vacuous proof, T730).
test settle_run_state_law_at_run_time {
    assert settle_run_state_law_holds();
}
