// SPDX-License-Identifier: Apache-2.0
; Test mathematical operations and algorithms

module Heldout.MathOperations;

    // ============================================================================
    // Imports
    // ============================================================================

    pub fn main() void {
        // Test case 1: Factorial calculation
        assert factorial(0) == 1;
        assert factorial(1) == 1;
        assert factorial(5) == 120;
        assert factorial(10) == 3628800;
        
        // Test case 2: Fibonacci sequence
        assert fibonacci(0) == 0;
        assert fibonacci(1) == 1;
        assert fibonacci(5) == 5;
        assert fibonacci(10) == 55;
        
        // Test case 3: Prime number check
        assert is_prime(2) == true;
        assert is_prime(3) == true;
        assert is_prime(4) == false;
        assert is_prime(17) == true;
        assert is_prime(25) == false;
        
        // Test case 4: Greatest Common Divisor
        assert gcd(48, 18) == 6;
        assert gcd(35, 14) == 7;
        assert gcd(17, 23) == 1;
    }

    // ============================================================================
    // Mathematical functions
    // ============================================================================

    pub fn factorial(n : i32) i32 {
        if (n <= 1) {
            return 1;
        }
        var result : i32 = 1;
        var i : i32 = 2;
        while (i <= n) {
            result = result * i;
            i = i + 1;
        }
        return result;
    }

    pub fn fibonacci(n : i32) i32 {
        if (n <= 1) {
            return n;
        }
        var a : i32 = 0;
        var b : i32 = 1;
        var i : i32 = 2;
        while (i <= n) {
            var next : i32 = a + b;
            a = b;
            b = next;
            i = i + 1;
        }
        return b;
    }

    pub fn is_prime(n : i32) bool {
        if (n <= 1) {
            return false;
        }
        if (n <= 3) {
            return true;
        }
        if (n % 2 == 0 || n % 3 == 0) {
            return false;
        }
        var i : i32 = 5;
        while (i * i <= n) {
            if (n % i == 0 || n % (i + 2) == 0) {
                return false;
            }
            i = i + 6;
        }
        return true;
    }

    pub fn gcd(a : i32, b : i32) i32 {
        while (b != 0) {
            var temp : i32 = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    // ============================================================================
    // Test helpers
    // ============================================================================

    pub fn assert(condition : bool) void {
        if (!condition) {
            panic("Assertion failed");
        }
    }

    pub fn panic(message : str) void {
        return;
    }
}