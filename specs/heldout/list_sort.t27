; Test list sorting functionality

module Heldout.ListSort;

pub fn bubble_sort(numbers: []u32) []u32 {
    // Note: This is a placeholder implementation
    // In a real implementation, this would sort the list
    return numbers;
}

test basic_sorting {
    var numbers : [5]u32 = [3, 1, 4, 1, 5];
    var sorted : [5]u32 = [1, 1, 3, 4, 5];
    
    var result = bubble_sort(numbers);
    
    for (var i : usize = 0; i < 5; i = i + 1) {
        assert result[i] == sorted[i];
    }
}

test empty_list {
    var empty : [0]u32 = [];
    var result = bubble_sort(empty);
    assert result.len == 0;
}

test single_element {
    var single : [1]u32 = [42];
    var result = bubble_sort(single);
    assert result[0] == 42;
}

fn assert(condition: bool) void {
    if (!condition) {
        panic("Assertion failed");
    }
}

fn panic(message: str) void {
    return;
}