#!/usr/bin/env bash
# Gate: a fresh docs/now/ entry must exist before any commit.
# Plus: NotebookLM continuous sync integration.
# Pipeline entry: ./scripts/tri check-now → t27c check-now (Rust; see tests/OWNERS.md).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# ===== NOW entry Gate =====
# `set -e` would abort here with whatever scripts/tri printed, and #3045 is what
# that looked like: with t27c unbuilt the commit was refused by a message naming
# a build step, followed by "local commands still work". The gate had not run.
# It found nothing wrong. Exit 2 from scripts/tri means exactly that, and this
# says so rather than letting the reader infer a verdict from a tool's complaint.
#
# The commit is still refused. A gate that could not run must not pass.
# `if ! cmd; then rc=$?` does NOT capture the command's code -- it captures the
# negation's, which is 0. Probed rather than assumed, because this file is one
# of the places that trap has already cost this repository a wrong reading.
rc=0
bash "$ROOT/scripts/tri" check-now || rc=$?
if [ "$rc" -ne 0 ]; then
  if [ "$rc" -eq 2 ]; then
    echo ""
    echo "❌ The NOW entry gate could NOT RUN -- it did not examine this commit."
    echo "   Reason is printed above. Nothing about your change was checked."
    echo "   Build the compiler, or set TRI_T27C, and commit again."
    echo ""
  fi
  exit "$rc"
fi

# Entries are one file per unit of work: docs/now/<YYYY-MM-DD>-<slug>.md .
# They used to be prepended to the single file docs/NOW.md, which made every
# concurrent PR collide on its first line. docs/NOW.md is now a frozen archive,
# so a modification to it is no longer what this warning is looking for.
ENTRY_RE='^docs/now/[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Za-z0-9._-]+\.md$'
if ! git diff --cached --name-only | grep -qE "$ENTRY_RE"; then
  if git status --porcelain --untracked-files=all -- docs/now \
     | sed 's/^...//' | grep -qE "$ENTRY_RE"; then
    echo ""
    echo "⚠️  WARNING: a docs/now/ entry exists but is NOT staged."
    echo "   Run: git add docs/now"
    echo "   Or: stage and commit it together with your changes."
    echo ""
  fi
fi

echo "✅ NOW entry gate passed"

# ===== NotebookLM Continuous Sync =====
# Track commits for periodic activity.md sync

COMMITS_FILE="$ROOT/.trinity/notebook_commit_count"
SYNC_INTERVAL=3  # Sync every 3 commits

# Initialize commit counter
if [ ! -f "$COMMITS_FILE" ]; then
  mkdir -p "$(dirname "$COMMITS_FILE")"
  echo "0" > "$COMMITS_FILE"
fi

# Increment counter
COMMIT_COUNT=$(cat "$COMMITS_FILE")
COMMIT_COUNT=$((COMMIT_COUNT + 1))
echo "$COMMIT_COUNT" > "$COMMITS_FILE"

# Check for .t27 file changes
SPEC_CHANGED=0
if git diff --cached --name-only | grep -q '\.t27$'; then
  SPEC_CHANGED=1
fi

# Extract issue number from branch name for targeted sync
BRANCH_NAME=$(git branch --show-current)
# THE PREFIX IS REQUIRED (#3071).
#
# This read `(issue-|#)?[0-9]+` -- the prefix OPTIONAL -- so any digits anywhere
# in a branch name became an issue number. Measured over every branch in this
# repository, local and remote: 1294 examined, **1048 given a number the branch
# does not carry**, and **0** branches actually using the `issue-N` or `#N` form
# the comment documents. `w42-status-ruler`, `w42-tri-vsim`, `w42-verilog-break`
# and `w42-vsim-unknown` all answer #42, which is a WAVE number.
#
# The documented population is empty and the optional prefix turned that
# emptiness into 1048 confident wrong answers. Nothing visible went wrong only
# because the sync these feed cannot run at all (see PY below).
#
# With the prefix required, the three documented forms still work --
# `issue-357-xyz` -> 357, `feature/issue-42` -> 42, `#1031-topic` -> 1031 --
# and a `wNN-` branch correctly yields nothing.
ISSUE_NUM=$(echo "$BRANCH_NAME" | grep -oE '(issue-|#)[0-9]+' | head -1 | tr -d 'issue-#' || echo "")

# Run sync on interval or spec change
if [ $((COMMIT_COUNT % SYNC_INTERVAL)) -eq 0 ] || [ "$SPEC_CHANGED" -eq 1 ]; then
  echo "📊 NotebookLM sync: uploading activity.md..."

  # Run async in background to not block commit
  (
    if [ -n "$ISSUE_NUM" ]; then
      python3.10 "$ROOT/contrib/backend/notebooklm/sync.py" \
        --issue "$ISSUE_NUM" --event push >/dev/null 2>&1 || true
    fi
    python3.10 "$ROOT/contrib/backend/notebooklm/sync.py" \
      --activity >/dev/null 2>&1 || true
  ) &

  echo "   Background sync started (commit #$COMMIT_COUNT)"
fi

if [ "$SPEC_CHANGED" -eq 1 ]; then
  echo "   ⚠️  .t27 files changed — notebook sources will update"
fi

echo "✅ Pre-commit complete — proceed"
