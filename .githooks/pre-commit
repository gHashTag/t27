#!/usr/bin/env bash
# Commit-time gates (`tri hooks pre-commit`).
#
# The NotebookLM sync that used to follow was removed by owner decision
# 2026-10-04 (#5957).
#
# No docs/now/ entry is asked for here. The NOW entry gate was removed by owner
# decision 2026-10-04 (#5935). Which checks block a merge is the ruleset's answer:
#   gh api repos/gHashTag/t27/rules/branches/master
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# ===== tri hooks pre-commit =====
# Conflict markers, fix( carries source, census. Needs only the `tri` binary.
#
# NEWEST, not first. The list used to be tried in order, `debug` before `release`, and
# `break` on the first executable. Measured in one worktree on 2026-09-05:
#
#     target/debug/tri     03:49   30265384 bytes   <- chosen
#     target/release/tri   19:40    8771904 bytes
#
# Sixteen hours old, and it was the one every commit that day was checked by: it knew
# nothing of the two gates added in between. A hook that picks a stale ruler silently is
# worse than one that is absent, because its PASSED reads as a verdict.
TRI_BIN=""
for cand in "$ROOT/target/debug/tri" "$ROOT/target/release/tri"; do
  [ -x "$cand" ] || continue
  if [ -z "$TRI_BIN" ] || [ "$cand" -nt "$TRI_BIN" ]; then TRI_BIN="$cand"; fi
done
# And say so out loud when even the newest is older than what it is meant to read. Not a
# refusal: editing cli/tri/src without rebuilding is ordinary, and blocking every such
# commit would be a tax on the normal case. Silence was the defect, not permissiveness.
if [ -n "$TRI_BIN" ] && [ -d "$ROOT/cli/tri/src" ]; then
  NEWEST_SRC="$(find "$ROOT/cli/tri/src" -name '*.rs' -newer "$TRI_BIN" -print -quit 2>/dev/null)"
  if [ -n "$NEWEST_SRC" ]; then
    echo "note: ${TRI_BIN#$ROOT/} is older than cli/tri/src (e.g. ${NEWEST_SRC#$ROOT/})."
    echo "      The gates below are the ones that binary carries, not the ones you just wrote."
    echo "      cargo build --release -p tri"
  fi
fi
if [ -z "$TRI_BIN" ] && command -v tri >/dev/null 2>&1; then
  TRI_BIN="$(command -v tri)"
fi

# Exit 2 means the gates could NOT RUN (#3045): they examined nothing and found
# nothing wrong. The commit is still refused -- a gate that could not run must not
# pass -- but the message says which of the two happened.
# `if ! cmd; then rc=$?` does NOT capture the command's code -- it captures the
# negation's, which is 0. Hence `|| rc=$?`.
if [ -n "$TRI_BIN" ]; then
  rc=0
  "$TRI_BIN" hooks pre-commit || rc=$?
  if [ "$rc" -ne 0 ]; then
    if [ "$rc" -eq 2 ]; then
      echo ""
      echo "The commit-time gates could NOT RUN -- they did not examine this commit."
      echo "   Reason is printed above. Nothing about your change was checked."
      echo ""
    fi
    exit "$rc"
  fi
else
  echo "note: no tri binary is built; the commit-time gates did not run and nothing was checked."
  echo "      cargo build --release -p tri"
fi
