#!/usr/bin/env bash
# NotebookLM post-merge hook.
#
# Triggered after git merge completes successfully.
# Syncs final merge diff to NotebookLM and updates dashboard.
#
# phi^2 + 1/phi^2 = 3 | TRINITY

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "📊 NotebookLM post-merge sync..."

# Extract issue number from branch name (feature/issue-357-xyz -> 357)
# THE PREFIX IS REQUIRED (#3071).
#
# This read `(issue-|#)?[0-9]+` -- the prefix OPTIONAL -- so any digits anywhere
# in a branch name became an issue number. Measured over every branch in this
# repository, local and remote: 1294 examined, **1048 given a number the branch
# does not carry**, and **0** branches actually using the `issue-N` or `#N` form
# the comment documents. `w42-status-ruler`, `w42-tri-vsim`, `w42-verilog-break`
# and `w42-vsim-unknown` all answer #42, which is a WAVE number.
#
# The documented population is empty and the optional prefix turned that
# emptiness into 1048 confident wrong answers. Nothing visible went wrong only
# because the sync these feed cannot run at all (see PY below).
#
# With the prefix required, the three documented forms still work --
# `issue-357-xyz` -> 357, `feature/issue-42` -> 42, `#1031-topic` -> 1031 --
# and a `wNN-` branch correctly yields nothing.
MERGED_BRANCH=$(git rev-parse --abbrev-ref HEAD)
ISSUE_NUM=$(echo "$MERGED_BRANCH" | grep -oE '(issue-|#)[0-9]+' | head -1 | tr -d 'issue-#' || echo "")

# THE INTERPRETER, RESOLVED ONCE AND NAMED WHEN ABSENT.
#
# Three call sites hard-coded `python3.10`. On a host where it is not installed
# -- `command -v python3.10` empty while `python3` is 3.14 -- every one of them
# failed into an `|| echo` whose text blames CONFIGURATION:
#
#     WARNING  Sync failed (notebooklm may not be configured)
#     WARNING  Could not update metadata
#     OK       Metadata updated            <- printed anyway, one line later
#     OK       Post-merge complete
#
# Four lines that contradict each other, and a reader sent to check a
# configuration that is fine. Reproduced on this host verbatim.
PY=""
for c in python3.10 python3; do
  command -v "$c" >/dev/null 2>&1 && PY="$c" && break
done
if [ -z "$PY" ]; then
  echo "   NOTE: no python3 interpreter on PATH -- NotebookLM sync SKIPPED."
  echo "   Nothing was synced and nothing failed to sync. This is not a"
  echo "   configuration problem; install python3 or adjust PATH."
  echo "ℹ️  Post-merge finished with the sync skipped."
  exit 0
fi

if [ -n "$ISSUE_NUM" ]; then
  echo "   Found issue #$ISSUE_NUM in branch: $MERGED_BRANCH"

  # Get merge diff
  MERGE_COMMIT=$(git rev-parse HEAD)
  PARENT_COMMIT=$(git rev-parse HEAD^1)
  DIFF_FILE="/tmp/nb_merge_$ISSUE_NUM.diff"

  if [ -f "$DIFF_FILE" ]; then
    rm "$DIFF_FILE"
  fi

  git diff "$PARENT_COMMIT" "$MERGE_COMMIT" > "$DIFF_FILE" 2>/dev/null || true

  # Format diff for NotebookLM
  if [ -s "$DIFF_FILE" ]; then
    # Run sync with merge event
    echo "   Syncing merge diff to NotebookLM..."
    "$PY" "$ROOT/contrib/backend/notebooklm/sync.py" \
      --issue "$ISSUE_NUM" \
      --event merge \
      --trigger "merged" \
      >/dev/null 2>&1 || echo "   ⚠️  Sync failed (notebooklm may not be configured)"

    # Clean up
    rm "$DIFF_FILE"
  else
    echo "   ⚠️  No diff generated (fast-forward merge?)"
  fi

  # Update enrichment metadata for dashboard
  METADATA_FILE="$ROOT/contrib/backend/notebooklm/enrichment_metadata.json"
  if [ -f "$METADATA_FILE" ]; then
    "$PY" -c "
import json
from datetime import datetime

with open('$METADATA_FILE', 'r') as f:
    data = json.load(f)

for nb_id, meta in data.items():
    title = meta.get('notebook_title', '')
    if '$ISSUE_NUM' in title:
        meta['last_merged'] = datetime.utcnow().isoformat()
        meta['merge_count'] = meta.get('merge_count', 0) + 1

with open('$METADATA_FILE', 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null && echo "   ✅ Metadata updated" || echo "   ⚠️  Could not update metadata"
  fi
else
  echo "   ℹ️  No issue number found in branch name"
  echo "   Branch format should be: issue-<number> or #<number>-topic"
fi

# Sync activity.md if it was modified
if git diff --name-only HEAD~1 HEAD | grep -q '^activity.md$'; then
  echo "   Syncing activity.md to NotebookLM..."
  "$PY" "$ROOT/contrib/backend/notebooklm/sync.py" \
    --activity \
    >/dev/null 2>&1 || echo "   ⚠️  Activity sync failed"
fi

echo "✅ Post-merge complete"
