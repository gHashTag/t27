module test_issue_resolved;

/// Test case for gHashTag/t27#7604: character literal issue resolution
/// This test verifies that the boundary files use the correct workaround

/// Test the same pattern as in the issue description, but using the workaround
pub fn digit_value_workaround(c: u8) -> u8 {
    // Using numeric literals instead of character literals (workaround)
    if (c >= 48 and c <= 57) {
        return c - 48;
    }
    return 255;
}

/// Test the same pattern as in macho.t27
/// Note: This function assumes input is a valid hex digit (0-9, a-f, A-F)
pub fn hex_digit_workaround(c: u8) -> u8 {
    // Using numeric literals instead of character literals (workaround)
    if (c >= 97) { // 'a' or higher
        return c - 87; // 'a' = 97, 97 - 87 = 10
    }
    return c - 48; // '0' = 48, '9' = 57
}

/// Test the pattern from the issue description (this would fail if not using workaround)
pub fn digit_value_original_issue(c: u8) -> u8 {
    // This would be problematic if character literals were emitted as Rust char literals
    if (c >= '0' and c <= '9') {
        return c - '0';
    }
    return 255;
}

test workaround_digit_values {
    assert digit_value_workaround(48) == 0;  // '0'
    assert digit_value_workaround(57) == 9;  // '9'
    assert digit_value_workaround(65) == 255; // 'A' - not a digit
}

test workaround_hex_digit_values {
    // Test valid hex digits (the function assumes input is valid)
    assert hex_digit_workaround(48) == 0;   // '0'
    assert hex_digit_workaround(57) == 9;   // '9'
    assert hex_digit_workaround(97) == 10;  // 'a'
    assert hex_digit_workaround(102) == 15; // 'f'
}

test original_issue_pattern {
    // This test demonstrates the pattern from the issue description
    // The boundary files use the workaround to avoid compilation errors
    assert digit_value_original_issue(48) == 0;
    assert digit_value_original_issue(57) == 9;
    assert digit_value_original_issue(65) == 255;
}