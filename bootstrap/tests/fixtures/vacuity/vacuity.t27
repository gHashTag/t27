module vacuity_fixture;
; #6509 fixture for `t27c test-report`: one runtime assert counted per
; execution, callees included; an assert whose operands are all constants
; checks nothing at run time and is not counted (t27b `Interp::asserts`).
; Expected per test: empty_test 0 (VACUOUS), folded_only 0 (VACUOUS),
; checked 2, loop_checked 4 -- vacuous passes 2 of 4.

fn inc(x: u32) -> u32 {
    return x + 1;
}

test empty_test {
}

test folded_only {
    assert(1 + 1 == 2);
}

test checked {
    assert(inc(1) == 2);
    assert_eq(inc(2), 3);
}

test loop_checked {
    var i: u32 = 0;
    while (i < 4) {
        assert(inc(i) == i + 1);
        i = i + 1;
    }
}

test gate15_vacuity_diagnosis {
    // Gate 15: assert(1'b0) injection test for unsatisfiable assumption detection
    // This test verifies that the vacuity gate injects assert(1'b0) and fails proof
    // when unsatisfiable assumptions are present, rather than silently proving all properties.
    
    // Under -set-init-zero, every register is zero at t=0
    // So assume(R == k) for nonzero k on a reset-to-zero register is unsatisfiable
    // The assert(1'b0) injection should cause proof failure, not silent success
    
    assert(false); // This should fail proof when unsatisfiable assumptions exist
    // The gate must detect this as vacuous and report proof failure, not success
}
