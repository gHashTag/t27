// #7307: a `for` over one range, `for (a..b) |i|`, becomes a C `for` with a
// size_t counter, and `|_|` names it __t27_i. C reads the end on every pass,
// so the core takes it only when the body cannot change it (#7420).
module forranges;
const N: usize = 4;
var hits: [8]usize = [_]usize{0} ** 8;
fn tri(n: usize) -> usize {
    var s: usize = 0;
    for (0..n) |i| {
        s = s + i;
    }
    return s;
}
fn count(n: usize) -> usize {
    var s: usize = 0;
    for (2..n + 1) |_| {
        s += 1;
    }
    return s;
}
fn skip(n: usize) -> usize {
    var s: usize = 0;
    for (0..10) |i| {
        if (i == 3) {
            continue;
        } else if (i == n) {
            break;
        }
        s = s + 1;
    }
    return s;
}
fn nest(n: usize) -> usize {
    var s: usize = 0;
    for (0..n) |i| {
        for (0..i) |_| {
            for (0..2) |_| {
                s += 1;
            }
        }
    }
    return s;
}
fn shapes(a: usize, b: usize, x: i64) -> usize {
    var s: usize = 0;
    for (a + 1..b) |i| {
        s += i;
    }
    for (a * 2..b << 1) |i| {
        s += i;
    }
    for ((a)..(b)) |i| {
        s += i;
    }
    for (x as usize..b) |i| {
        while (s > 1000) {
            s = s - 1;
        }
        s += i;
    }
    return s;
}
fn mark() -> void {
    for (N..N * 2) |i| {
        hits[i] = i;
    }
}
test loops {
    assert(tri(5) == 10);
    assert(count(5) == 4);
    assert(skip(7) == 6);
    assert(nest(3) == 6);
    assert(shapes(1, 6, 2) == 108);
    mark();
    assert(hits[3] == 0);
    assert(hits[4] == 4);
    assert(hits[7] == 7);
}
