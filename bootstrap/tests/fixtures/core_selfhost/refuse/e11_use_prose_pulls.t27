// #7379: the splice reads identifiers in `;` prose as references, so the
// prose line below pulls `ud_unused` (and with it `UD_LIMIT` and `ud_step`)
// into gen-c's output, though no code calls it. The core reads the module
// and refuses a word gen-c would splice for that no token names (E_USE).
module use_prose;
use selfhost_use::use_dep;

; up_id does not call ud_unused.

fn up_id(a: i64) -> i64 {
    return a;
}
