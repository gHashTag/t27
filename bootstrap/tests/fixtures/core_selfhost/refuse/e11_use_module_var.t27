// #7381: the splice takes fn, const, struct, enum and type declarations
// only, so the imported module's `var ud_count` and `let UD_FLOOR` are never
// spliced. gen-c exits 0 and its C names two undeclared identifiers. The
// core refuses a name the module declares that is not spliced.
module use_var;
use selfhost_use::use_dep;
fn uv_tick() -> i64 {
    ud_count = ud_count + UD_FLOOR;
    return ud_count;
}
