// SPDX-License-Identifier: Apache-2.0
// bootstrap/src/codegen_python.t27
// Python Code Generator for CLARA (TA2 Deliverable)
// φ² + 1/φ² = 3 | TRINITY
//
// Generates Python code from .t27 specifications as declaration-only module
// Shares the value layer with gen-js and gen-ts (declarations only, no function bodies)
//
// ─────────────────────────────────────────────────────────────────────────────────────────────

module codegen_python;
    use base::types;
    use parser;

    // ═════════════════════════════════════════════════════════════════
    // CONFIGURATION
    // ════════════════════════════════════════════════════════════════

    /// Python module prefix for generated code
    pub const PYTHON_MODULE_PREFIX : []const u8 = "t27_";

    // ══════════════════════════════════════════════════════════════════
    // OUTPUT DESCRIPTION
    // ══════════════════════════════════════════════════════════════════

    /// Python module output format - declaration only
    /// 
    /// The Python backend generates a module containing:
    /// - Constants with their values (shares value layer with gen-js and gen-ts)
    /// - Struct definitions as data objects with type metadata
    /// - No function bodies (declarations only, like gen-js and gen-ts)
    /// - Comments explaining what was not emitted
    /// - Metadata for declaration order
    ///
    /// Example output:
    /// ```python
    /// # Generated by `t27c gen-python` from spec.t27. Do not edit.
    /// 
    /// export const MAGIC_NUMBER = 0xDEADBEEF
    /// export const FLAG_ENABLE = True
    /// export const ConfigPacked = {"__struct__": "ConfigPacked", "fields": [["width", "u8"], ["height", "u8"]]}
    /// 
    /// # t27c gen-python: fn create_config was not emitted -- this backend lowers declarations, not bodies.
    /// # t27c gen-python: fn calculate_area was not emitted -- this backend lowers declarations, not bodies.
    /// # t27c gen-python: a TestBlock was not emitted -- it is checked by the compiler, not by the artifact.
    /// # t27c gen-python: a InvariantBlock was not emitted -- it is checked by the compiler, not by the artifact.
    /// 
    /// export const __STRUCT_ORDER__ = ["ConfigPacked"]
    /// export const __DECL_ORDER__ = ["MAGIC_NUMBER", "FLAG_ENABLE", "ConfigPacked"]
    /// export const __NOT_EMITTED__ = []
    /// ```

    // ══════════════════════════════════════════════════════════════════
    // TYPE MAPPINGS
    // ══════════════════════════════════════════════════════════════════

    /// T27 type → Python type representation for declarations
    fn map_t27_type_to_python_type(tn : str) -> str {
        // Map T27 types to Python type representations for constants and struct fields
        if (tn == "u8") { return "int" }
        else if (tn == "u16") { return "int" }
        else if (tn == "u32") { return "int" }
        else if (tn == "u64") { return "int" }
        else if (tn == "i8") { return "int" }
        else if (tn == "i16") { return "int" }
        else if (tn == "i32") { return "int" }
        else if (tn == "i64") { return "int" }
        else if (tn == "bool") { return "bool" }
        else if (tn == "str") { return "str" }
        else { return "Any" }  // Fallback for complex types
    }

    /// Generate Python constant declaration
    fn gen_constant(const_name : str, const_value : str, const_type : str) -> str {
        var result : [256]u8 = undefined;
        var offset : usize = 0;
        
        offset = string_copy_str(&offset, "export const ");
        offset = string_copy_str(&offset, const_name);
        offset = string_copy_str(&offset, " = ");
        
        // Add type annotation for clarity (similar to gen-ts)
        if (const_type != "") {
            offset = string_copy_str(&offset, "/* ");
            offset = string_copy_str(&offset, const_type);
            offset = string_copy_str(&offset, " */ ");
        }
        
        offset = string_copy_str(&offset, const_value);
        offset = string_copy_str(&offset, "\n");
        
        return result[0..offset];
    }

    /// Generate Python struct declaration as data object
    fn gen_struct(struct_name : str, fields : [][2]str) -> str {
        var result : [512]u8 = undefined;
        var offset : usize = 0;
        
        offset = string_copy_str(&offset, "export const ");
        offset = string_copy_str(&offset, struct_name);
        offset = string_copy_str(&offset, " = Object.freeze({");
        offset = string_copy_str(&offset, "__struct__: \"");
        offset = string_copy_str(&offset, struct_name);
        offset = string_copy_str(&offset, "\", ");
        offset = string_copy_str(&offset, "fields: [");
        
        // Generate field list
        var i : usize = 0;
        while (i < fields.len) {
            if (i > 0) { offset = string_copy_str(&offset, ", "); }
            offset = string_copy_str(&offset, "[\"");
            offset = string_copy_str(&offset, fields[i][0]);
            offset = string_copy_str(&offset, "\", \"");
            offset = string_copy_str(&offset, fields[i][1]);
            offset = string_copy_str(&offset, "\"]");
            i += 1;
        }
        
        offset = string_copy_str(&offset, "]})\n");
        
        return result[0..offset];
    }

    /// Generate Python module header
    fn gen_module_header(spec_name : str) -> str {
        var result : [256]u8 = undefined;
        var offset : usize = 0;
        
        offset = string_copy_str(&offset, "# Generated by `t27c gen-python` from ");
        offset = string_copy_str(&offset, spec_name);
        offset = string_copy_str(&offset, ". Do not edit.\n");
        offset = string_copy_str(&offset, "#\n");
        offset = string_copy_str(&offset, "# Every name and every value here comes from that spec. Change the spec and\n");
        offset = string_copy_str(&offset, "# regenerate; an edit made here is lost the next time anyone builds.\n\n");
        
        return result[0..offset];
    }

    /// Generate metadata for declaration order
    fn gen_metadata(decl_order : []str, struct_order : []str, not_emitted : []str) -> str {
        var result : [512]u8 = undefined;
        var offset : usize = 0;
        
        // Struct order metadata
        offset = string_copy_str(&offset, "export const __STRUCT_ORDER__ = [");
        var i : usize = 0;
        while (i < struct_order.len) {
            if (i > 0) { offset = string_copy_str(&offset, ", "); }
            offset = string_copy_str(&offset, "\"");
            offset = string_copy_str(&offset, struct_order[i]);
            offset = string_copy_str(&offset, "\"");
            i += 1;
        }
        offset = string_copy_str(&offset, "]\n");
        
        // Declaration order metadata
        offset = string_copy_str(&offset, "export const __DECL_ORDER__ = [");
        i = 0;
        while (i < decl_order.len) {
            if (i > 0) { offset = string_copy_str(&offset, ", "); }
            offset = string_copy_str(&offset, "\"");
            offset = string_copy_str(&offset, decl_order[i]);
            offset = string_copy_str(&offset, "\"");
            i += 1;
        }
        offset = string_copy_str(&offset, "]\n");
        
        // Not emitted metadata
        offset = string_copy_str(&offset, "export const __NOT_EMITTED__ = Object.freeze([");
        i = 0;
        while (i < not_emitted.len) {
            if (i > 0) { offset = string_copy_str(&offset, ", "); }
            offset = string_copy_str(&offset, "\"");
            offset = string_copy_str(&offset, not_emitted[i]);
            offset = string_copy_str(&offset, "\"");
            i += 1;
        }
        offset = string_copy_str(&offset, "])\n");
        
        return result[0..offset];
    }

    // ════════════════════════════════════════════════════════════════
    // TESTS
    // ════════════════════════════════════════════════════════════════

    test "gen_constant_basic" {
        // given
        const const_name = "TEST_CONST";
        const const_value = "42";
        const const_type = "int";
        // when
        const result = gen_constant(const_name, const_value, const_type);
        // then: result contains expected constant declaration
        assert(@contains(result, "export const TEST_CONST = "));
        assert(@contains(result, "42"));
    }

    test "gen_struct_basic" {
        // given
        const struct_name = "TestStruct";
        const fields = [["field1", "u8"], ["field2", "bool"]];
        // when
        const result = gen_struct(struct_name, fields);
        // then: result contains expected struct declaration
        assert(@contains(result, "export const TestStruct = Object.freeze({"));
        assert(@contains(result, "__struct__: \"TestStruct\""));
        assert(@contains(result, "fields: [[\"field1\", \"u8\"], [\"field2\", \"bool\"]]"));
    }

    test "gen_module_header_format" {
        // given
        const spec_name = "test_spec";
        // when
        const result = gen_module_header(spec_name);
        // then: result contains header comment
        assert(@contains(result, "# Generated by `t27c gen-python` from test_spec"));
        assert(@contains(result, "# Every name and every value here comes from that spec"));
    }

    test "gen_metadata_format" {
        // given
        const decl_order = ["CONST1", "CONST2"];
        const struct_order = ["Struct1"];
        const not_emitted = ["func1", "test_block"];
        // when
        const result = gen_metadata(decl_order, struct_order, not_emitted);
        // then: result contains expected metadata
        assert(@contains(result, "export const __STRUCT_ORDER__ = [\"Struct1\"]"));
        assert(@contains(result, "export const __DECL_ORDER__ = [\"CONST1\", \"CONST2\"]"));
        assert(@contains(result, "export const __NOT_EMITTED__ = Object.freeze([\"func1\", \"test_block\"])"));
    }

    test "python_output_matches_declaration_pattern" {
        // given
        const output = gen_module_header("hello_world") + 
                      gen_constant("MAGIC_NUMBER", "0xDEADBEEF", "int") +
                      gen_struct("ConfigPacked", [["width", "u8"], ["height", "u8"]]);
        // then: output follows declaration-only pattern
        assert(@contains(output, "export const "));
        assert(@contains(output, "Object.freeze({"));
        assert(@contains(output, "__struct__:"));
        // Should NOT contain function definitions
        assert(!@contains(output, "def "));
        assert(!@contains(output, "return "));
    }

    // ════════════════════════════════════════════════════════════════
    // INVARIANTS
    // ════════════════════════════════════════════════════════════════

    invariant "python_output_is_declaration_only" {
        // given
        const test_fields = [["field1", "u8"], ["field2", "bool"]];
        const struct_output = gen_struct("TestStruct", test_fields);
        const const_output = gen_constant("TEST_CONST", "42", "int");
        // then: output contains only declarations, no implementations
        assert(@contains(struct_output, "Object.freeze"));
        assert(@contains(const_output, "export const"));
        assert(!@contains(struct_output, "def "));
        assert(!@contains(const_output, "def "));
    }

    invariant "python_shares_value_layer" {
        // given
        const magic_number = gen_constant("MAGIC_NUMBER", "0xDEADBEEF", "int");
        const flag_enable = gen_constant("FLAG_ENABLE", "True", "bool");
        // then: constants have identical values to gen-js and gen-ts
        assert(@contains(magic_number, "0xDEADBEEF"));
        assert(@contains(flag_enable, "True"));
        // Same values as JS/TS backends, just different syntax
    }