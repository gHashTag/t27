+    /// Lower `invariant name: <expr>` into an assertion, mirroring what W559
+    /// did for tests.
+    ///
+    /// The body was discarded by `skip_to_next_top_level()`, so codegen emitted
+    /// `// invariant: X verified (no statements)` -- a comment claiming
+    /// verification. 5,163 invariants are in this form.
+    ///
+    /// Only boolean expressions are lowered. `forall`-quantified statements
+    /// (837 of them) are not runtime-checkable and fall back to the original
+    /// skip, as does anything else this cannot model. Same safety contract as
+    /// the test lowering: it may only ADD assertions, never break a file.
+    fn parse_invariant_clause(&mut self, block: &mut Node) {
+        let entry = self.save_state();
+        let start_children = block.children.len();
+
+        // Two spellings exist. `invariant name: <expr>` carries the predicate
+        // inline; `invariant name` is followed by indented clauses in exactly
+        // the same style as a braceless test:
+        //
+        //     invariant board_name_not_empty
+        //         assert BOARD_NAME != ""
+        //
+        // The second form is the common one -- 76 of 81 invariants in the
+        // currently-compiling specs -- so requiring a colon lowered almost
+        // nothing. Hand the clause form to the same parser the tests use.
+        if self.current.kind != TokenKind::Colon {
+            self.parse_bdd_clauses(block);
+            return;
+        }
+        self.advance(); // consume ':'
+
+        // `forall x : T, P(x)` is a quantified statement, not an expression a
+        // backend can evaluate. Leave those exactly as they were.
+        if self.current.kind == TokenKind::Ident && self.current.lexeme == "forall" {
+            self.restore_bdd_fallback(block, start_children, entry);
+            return;
+        }
+
+        match self.parse_expr() {
+            Ok(expr) => {
+                let mut call = Node::new(NodeKind::ExprCall);
+                call.name = "assert".to_string();
+                call.children.push(expr);
+                let mut stmt = Node::new(NodeKind::StmtExpr);
+                stmt.children.push(call);
+                block.children.push(stmt);
+            }
+            Err(_) => {
+                self.restore_bdd_fallback(block, start_children, entry);
+                return;
+            }
+        }
+
+        // Anything left that is not a clean construct boundary means the
+        // expression over-consumed or the body has a shape we do not model.
+        if !Self::is_block_boundary(self.current.kind) {
+            self.restore_bdd_fallback(block, start_children, entry);
+        }
+    }
