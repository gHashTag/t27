module test_char_literal_fix;

/// Test case for gHashTag/t27#7604: character literals in byte context
/// should be emitted as Rust byte literals (b'0', b'9') not char literals ('0', '9')

pub fn digit_value_proper(c: u8) -> u8 {
    // This should be emitted as (c >= b'0') && (c <= b'9') and (c - b'0')
    if (c >= '0' and c <= '9') {
        return c - '0';
    }
    return 255;
}

pub fn hex_digit_proper(c: u8) -> u8 {
    // This should be emitted as (c >= b'a') and (c - b'a' + 10) or (c - b'0')
    if (c >= 'a') {
        return c - 'a' + 10;
    }
    return c - '0';
}

test digit_values_work {
    assert digit_value_proper(48) == 0;  // '0'
    assert digit_value_proper(57) == 9;  // '9'
    assert digit_value_proper(65) == 255; // 'A' - not a digit
}

test hex_digit_values_work {
    assert hex_digit_proper(48) == 0;   // '0'
    assert hex_digit_proper(57) == 9;   // '9'
    assert hex_digit_proper(97) == 10;  // 'a'
    assert hex_digit_proper(102) == 15; // 'f'
    assert hex_digit_proper(65) == 255;  // 'A' - not lowercase
}