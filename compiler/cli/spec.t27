// spec.t27 — Spec Management Commands
// Commands for creating and managing t27 specs with TDD enforcement

module spec_commands {
    // ═════════════════════════════════════════════════════════════════════
    // Command: tri spec create <name> — Create a new spec with TDD template
    // ═════════════════════════════════════════════════════════════════════

    pub fn spec_create(name: []const u8, path: []const u8) i32 {
        // Validate spec name
        if (!is_valid_spec_name(name)) {
            error_print("Invalid spec name: ");
            error_print(name);
            error_print("\nSpec names must be lowercase alphanumeric with underscores");
            return 1;
        }

        // Determine output path
        const output_path = if (path.len == 0) "specs/" ++ name ++ ".t27" else path;

        // Check if file exists
        if (file_exists(output_path)) {
            error_print("Spec already exists: ");
            error_print(output_path);
            error_print("\nUse --force to overwrite");
            return 1;
        }

        // Create spec with TDD template
        const content = generate_spec_template(name);
        const result = write_file(output_path, content);

        if (result != 0) {
            error_print("Failed to create spec: ");
            error_print(output_path);
            return result;
        }

        print("Created spec: ");
        print(output_path);
        print("\n");
        print("Next steps:\n");
        print("  1. Add constants, functions to your spec\n");
        print("  2. Add test cases using 'test <name>' blocks\n");
        print("  3. Add invariants using 'invariant <name>' blocks\n");
        print("  4. Run 'tri gen ");
        print(output_path);
        print("' to generate code\n");
        print("  5. Run 'tri test' to execute tests");

        return 0;
    }

    // ═════════════════════════════════════════════════════════════════════
    // Command: tri spec validate <path> — Validate spec has TDD compliance
    // ═════════════════════════════════════════════════════════════════════

    pub fn spec_validate(path: []const u8) i32 {
        if (!file_exists(path)) {
            error_print("Spec not found: ");
            error_print(path);
            return 1;
        }

        // Read spec content
        const content = read_file(path);
        if (content == null) {
            error_print("Failed to read spec: ");
            error_print(path);
            return 1;
        }

        // Parse spec
        const context = parse(content.?, path);

        if (context.has_errors()) {
            error_print("Parse errors in ");
            error_print(path);
            error_print(":\n");
            for (context.errors) |err| {
                error_print("  Line ");
                print_int(err.line);
                error_print(":");
                print_int(err.column);
                error_print(": ");
                error_print(err.message);
                error_print("\n");
            }
            return 1;
        }

        // Validate TDD compliance
        const tdd_errors = validate_tdd_compliance(context.ast_root);

        if (tdd_errors.len > 0) {
            error_print("TDD compliance violations in ");
            error_print(path);
            error_print(":\n");
            for (tdd_errors.items[0..tdd_errors.len]) |err| {
                error_print("  ");
                error_print(err);
                error_print("\n");
            }
            return 1;
        }

        print("Spec ");
        print(path);
        print(" is TDD compliant\n");
        print("\nSummary:\n");
        print("  Constants: ");
        print_int(context.ast_root.constants.len);
        error_print("\n");

        if (context.ast_root.spec_decl != null) {
            print("  Tests (spec-style): ");
            print_int(context.ast_root.spec_decl.?.test_blocks.len);
            error_print("\n");
            print("  Invariants (spec-style): ");
            print_int(context.ast_root.spec_decl.?.invariants.len);
            error_print("\n");
        }

        if (context.ast_root.test_section != null) {
            print("  Tests (assembly-style): ");
            print_int(context.ast_root.test_section.?.test_cases.len);
            error_print("\n");
        }

        if (context.ast_root.invariant_section != null) {
            print("  Invariants (assembly-style): ");
            print_int(context.ast_root.invariant_section.?.invariants.len);
            error_print("\n");
        }

        return 0;
    }

    // ═════════════════════════════════════════════════════════════════════
    // Command: tri spec list — List all specs in project
    // ═════════════════════════════════════════════════════════════════════

    pub fn spec_list() i32 {
        const spec_dir = "specs";
        if (!dir_exists(spec_dir)) {
            print("No specs directory found");
            return 0;
        }

        const spec_files = glob("specs/**/*.t27");

        if (spec_files.len == 0) {
            print("No spec files found");
            return 0;
        }

        print("Spec files in project:\n");

        for (spec_files) |spec_path| {
            // Open-ended slice `x[a..]` written with its end bound `x[a..x.len]`:
            // the Zig backend lowers the open form to a single index.
            const rel_path = spec_path[7..spec_path.len]; // Remove "specs/" prefix
            const content = read_file(spec_path);

            // Check if spec has tests
            var has_tests = false;
            // Optional capture `if (content) |c|` spelled as a null test plus
            // an explicit unwrap.
            if (content != null) {
                const c = content.?;
                const context = parse(c, spec_path);
                if (context.ast_root.test_section != null or
                    (context.ast_root.spec_decl != null and context.ast_root.spec_decl.?.test_blocks.len > 0)) {
                    has_tests = true;
                }
            }

            const status = if (has_tests) "✓" else "✗";
            print("  ");
            print(status);
            print(" ");
            print(rel_path);
            error_print("\n");
        }

        return 0;
    }

    // ═════════════════════════════════════════════════════════════════════
    // Helper functions
    // ═════════════════════════════════════════════════════════════════════

    // Validate spec name: lowercase alphanumeric with underscores
    pub fn is_valid_spec_name(name: []const u8) bool {
        if (name.len == 0) {
            return false;
        }

        // Must start with lowercase letter
        const first = name[0];
        if (first < 'a' or first > 'z') {
            return false;
        }

        // Only alphanumeric and underscores allowed
        // (open-ended slice `name[1..]` written with its end bound)
        for (name[1..name.len]) |c| {
            if ((c < 'a' or c > 'z') and (c < '0' or c > '9') and c != '_') {
                return false;
            }
        }

        return true;
    }

    // Generate spec template with TDD blocks (assembly-like format)
    pub fn generate_spec_template(name: []const u8) []const u8 {
        return "; " ++ name ++ ".t27 — Specification for " ++ name ++ "\n" ++
               "; φ² + 1/φ² = 3 | TRINITY\n" ++
               ";\n" ++
               "; This file is the source of truth for " ++ name ++ ".\n" ++
               "; Generated code is a derived artifact - DO NOT EDIT generated files.\n" ++
               ";\n" ++
               "; TDD Contract: This spec MUST include at least one test or invariant.\n" ++
               ";\n" ++
               "\n" ++
               ".use base::types\n" ++
               "\n" ++
               "; ═══════════════════════════════════════════════════════════════\n" ++
               "; Constants\n" ++
               "; ═══════════════════════════════════════════════════════════════\n" ++
               "\n" ++
               ".const EXAMPLE_CONSTANT 42\n" ++
               "\n" ++
               "; ═══════════════════════════════════════════════════════════════\n" ++
               "; Data Section\n" ++
               "; ═══════════════════════════════════════════════════════════════\n" ++
               "\n" ++
               ".data\n" ++
               "    .const DATA_INIT 0\n" ++
               "\n" ++
               "; ═══════════════════════════════════════════════════════════════\n" ++
               "; Code Section\n" ++
               "; ═══════════════════════════════════════════════════════════════\n" ++
               "\n" ++
               ".code\n" ++
               "main:\n" ++
               "    ; Your code here\n" ++
               "    HALT\n" ++
               "\n" ++
               "; ═══════════════════════════════════════════════════════════════\n" ++
               "; TDD-Inside-Spec: Tests and Invariants\n" ++
               "; ═══════════════════════════════════════════════════════════════\n" ++
               "\n" ++
               ".test\n" ++
               "    ; example_test\n" ++
               "    ; Verify: example functionality works correctly\n" ++
               "    ; Setup: initialize with EXAMPLE_CONSTANT\n" ++
               "    ; Expected: returns expected value\n" ++
               "\n" ++
               ".invariant\n" ++
               "    ; example_invariant\n" ++
               "    ; For all valid inputs: output is in valid range\n" ++
               "    ; Rationale: Ensures function correctness\n" ++
               "\n" ++
               ".bench\n" ++
               "    ; example_benchmark\n" ++
               "    ; Measure: operations per second\n" ++
               "    ; Target: > 1M ops/sec\n";
    }

    // Substring search: true when `needle` occurs in `haystack`. Stands in
    // for `std.mem.indexOf(u8, haystack, needle) != null`, which the tests
    // and invariants below used.
    pub fn contains(haystack: []const u8, needle: []const u8) bool {
        if (needle.len == 0) {
            return true;
        }
        if (needle.len > haystack.len) {
            return false;
        }
        var i: usize = 0;
        while (i + needle.len <= haystack.len) {
            var j: usize = 0;
            while (j < needle.len and haystack[i + j] == needle[j]) {
                j += 1;
            }
            if (j == needle.len) {
                return true;
            }
            i += 1;
        }
        return false;
    }

    // Validate TDD compliance: spec must have at least one test or invariant
    // The original collected messages in a heap std.ArrayList (page_allocator,
    // deinit on scope exit) and returned an owned [][]const u8 slice. t27 has
    // no allocator, so the messages go into a fixed-capacity TddErrors list
    // (items + len); callers read `errors.len` exactly as before. The check
    // can raise at most one violation, which sets the capacity.
    pub fn validate_tdd_compliance(ast_root: Program) TddErrors {
        var errors = TddErrors{ .items = [""], .len = 0 };

        // Check if spec has any tests or invariants
        var has_tests = false;

        // Optional captures `if (opt) |x|` are spelled as a null test plus
        // an explicit unwrap.
        if (ast_root.test_section != null) {
            const section = ast_root.test_section.?;
            if (section.test_cases.len > 0) {
                has_tests = true;
            }
        }

        if (ast_root.invariant_section != null) {
            const section = ast_root.invariant_section.?;
            if (section.invariants.len > 0) {
                has_tests = true;
            }
        }

        if (ast_root.spec_decl != null) {
            const spec = ast_root.spec_decl.?;
            if (spec.test_blocks.len > 0 or spec.invariants.len > 0) {
                has_tests = true;
            }
        }

        if (!has_tests) {
            errors.items[errors.len] = "TDD contract violated: spec must contain at least one 'test' or 'invariant' block";
            errors.len += 1;
        }

        return errors;
    }

    // ═════════════════════════════════════════════════════════════════════
    // Type definitions
    // ═════════════════════════════════════════════════════════════════════

    // Capacity of TddErrors: validate_tdd_compliance reports at most one
    // violation.
    pub const MAX_TDD_ERRORS: usize = 1;

    // Fixed-capacity list of TDD violation messages (replaces the heap
    // [][]const u8 the original returned). Valid entries: items[0..len].
    pub const TddErrors = struct {
        items: [MAX_TDD_ERRORS][]const u8,
        len: usize,
    };

    pub const Program = struct {
        constants: []Constant,
        test_section: ?TestSection,
        invariant_section: ?InvariantSection,
        spec_decl: ?SpecDecl,
    };

    pub const Constant = struct {
        name: []const u8,
        value: []const u8,
    };

    pub const TestSection = struct {
        test_cases: []TestCase,
    };

    pub const TestCase = struct {
        name: []const u8,
        verify: []const u8,
        setup: []const u8,
        expected: []const u8,
    };

    pub const InvariantSection = struct {
        invariants: []Invariant,
    };

    pub const Invariant = struct {
        name: []const u8,
        description: []const u8,
        rationale: []const u8,
    };

    pub const SpecDecl = struct {
        test_blocks: []TestBlock,
        invariants: []SpecInvariant,
    };

    pub const TestBlock = struct {
        name: []const u8,
        statements: []const u8,
    };

    pub const SpecInvariant = struct {
        name: []const u8,
        statement: []const u8,
    };

    pub const ParseError = struct {
        line: usize,
        column: usize,
        message: []const u8,
    };

    pub const ParseContext = struct {
        ast_root: Program,
        errors: []ParseError,

        pub fn has_errors(self: ParseContext) bool {
            return self.errors.len > 0;
        }
    };
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════
// TDD-Inside-Spec: Tests and Invariants for Spec Commands
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════

// The tests below were written in the braceless clause form with Zig's
// `try std.testing.expect(x)`; they are braced blocks with `assert(x)` now.
// They sit in the same file as module spec_commands, so its declarations are
// referenced directly rather than through the `spec_commands.` prefix, and
// the slice literals `&[_]T{ ... }` are written as bare lists `[ ... ]`.

test spec_create_returns_zero_on_success {
    const result = spec_create("test_spec", "");
    // In real test, would mock file operations
    _ = result;
    assert(true);
}

test spec_create_rejects_invalid_name {
    const result = spec_create("Invalid-Name", "");
    _ = result;
    assert(true);
}

test spec_create_rejects_empty_name {
    const result = spec_create("", "");
    _ = result;
    assert(true);
}

test spec_validate_returns_zero_for_compliant_spec {
    const result = spec_validate("specs/valid.t27");
    _ = result;
    assert(true);
}

test spec_validate_returns_one_for_nonexistent_spec {
    const result = spec_validate("specs/nonexistent.t27");
    _ = result;
    assert(true);
}

test spec_validate_returns_one_for_tdd_violation {
    const result = spec_validate("specs/no_tests.t27");
    _ = result;
    assert(true);
}

test spec_list_returns_zero_always {
    const result = spec_list();
    assert(result == 0);
}

test is_valid_spec_name_accepts_valid_names {
    assert(is_valid_spec_name("valid_name"));
    assert(is_valid_spec_name("another123"));
    assert(is_valid_spec_name("a"));
}

test is_valid_spec_name_rejects_invalid_names {
    assert(!is_valid_spec_name(""));
    assert(!is_valid_spec_name("Invalid-Name"));
    assert(!is_valid_spec_name("123start"));
    assert(!is_valid_spec_name("has.dots"));
}

test generate_spec_template_contains_tdd_blocks {
    const template = generate_spec_template("test");
    assert(contains(template, ".test"));
    assert(contains(template, ".invariant"));
    assert(contains(template, ".bench"));
}

test generate_spec_template_contains_use_statement {
    const template = generate_spec_template("test");
    assert(contains(template, ".use base::types"));
}

test validate_tdd_compliance_returns_empty_for_compliant {
    // Mock Program with test_section
    const program = Program{
        .constants = [],
        .test_section = TestSection{
            .test_cases = [
                TestCase{ .name = "test", .verify = "", .setup = "", .expected = "" },
            ],
        },
        .invariant_section = null,
        .spec_decl = null,
    };
    const errors = validate_tdd_compliance(program);
    assert(errors.len == 0);
}

test validate_tdd_compliance_returns_error_for_no_tests {
    const program = Program{
        .constants = [],
        .test_section = null,
        .invariant_section = null,
        .spec_decl = null,
    };
    const errors = validate_tdd_compliance(program);
    assert(errors.len == 1);
}

invariant spec_create_always_returns_zero_or_one {
    // spec_create returns 0 on success, 1 on failure
    assert(true);
}

invariant is_valid_spec_name_rejects_empty {
    // Empty name is never valid
    assert(!is_valid_spec_name(""));
}

invariant is_valid_spec_name_requires_lowercase_start {
    // First character must be a-z
    assert(!is_valid_spec_name("StartsUpper"));
}

invariant generate_spec_template_always_includes_tdd_contract {
    // Template always includes TDD contract comment
    const template = generate_spec_template("test");
    assert(contains(template, "TDD Contract"));
}

invariant validate_tdd_compliance_checks_all_sections {
    // Checks test_section, invariant_section, and spec_decl
    assert(true);
}

invariant parse_context_has_errors_returns_bool {
    // has_errors() returns true when errors exist
    assert(true);
}

// The `target:` metadata lines of the benches are kept as comments: a braced
// bench has no metadata slot, and the clause parser skipped them anyway.

bench spec_create_latency {
    // target: < 10ms
    _ = spec_create("test", "");
}

bench spec_validate_latency {
    // target: < 5ms
    _ = spec_validate("specs/valid.t27");
}

bench spec_list_latency {
    // target: < 10ms
    _ = spec_list();
}

    // ═════════════════════════════════════════════════════════════════════
    // Command: tri test-report <spec> — Generate test report with proper exit codes
    // ═════════════════════════════════════════════════════════════════════

    pub fn test_report(spec_path: []const u8, specs_dir: []const u8) i32 {
        // Check if spec exists
        if (!file_exists(spec_path)) {
            error_print("Spec not found: ");
            error_print(spec_path);
            return 1;
        }

        // Read spec content
        const content = read_file(spec_path);
        if (content == null) {
            error_print("Failed to read spec: ");
            error_print(spec_path);
            return 1;
        }

        // Parse spec
        const context = parse(content.?, spec_path);

        if (context.has_errors()) {
            error_print("Parse errors in ");
            error_print(spec_path);
            error_print(":\n");
            for (context.errors) |err| {
                error_print("  Line ");
                print_int(err.line);
                error_print(":");
                print_int(err.column);
                error_print(": ");
                error_print(err.message);
                error_print("\n");
            }
            return 1;
        }

        // ═════════════════════════════════════════════════════════════════════
        // TDD CONTRACT ENFORCEMENT
        // ═════════════════════════════════════════════════════════════════════
        var has_tests = false;
        var test_count: usize = 0;
        var invariant_count: usize = 0;

        // Count tests and invariants
        if (context.ast_root.test_section) |section| {
            test_count += section.test_cases.len;
        }

        if (context.ast_root.invariant_section) |section| {
            invariant_count += section.invariants.len;
        }

        if (context.ast_root.spec_decl) |spec| {
            test_count += spec.test_blocks.len;
            invariant_count += spec.invariants.len;
        }

        has_tests = (test_count > 0) or (invariant_count > 0);

        if (!has_tests) {
            error_print("TDD contract violated: no tests in spec\n");
            error_print("\n");
            error_print("The t27 project follows Test-Driven Development where:\n");
            error_print("  1. Every spec MUST have at least one 'test' or 'invariant' block\n");
            error_print("  2. Tests are written BEFORE or WITH the implementation\n");
            error_print("  3. Conformance JSON is generated FROM tests, not hand-written\n");
            error_print("\n");
            error_print("To fix this error:\n");
            error_print("  1. Add a .test section with test cases to your spec\n");
            error_print("  2. Or add a .invariant section with invariant declarations\n");
            error_print("  3. Or use the high-level TDD syntax with 'test' and 'invariant' blocks\n");
            error_print("\n");
            error_print("Example:\n");
            error_print("  .test\n");
            error_print("      ; my_test\n");
            error_print("      ; Verify: functionality works\n");
            error_print("      ; Expected: correct result\n");
            error_print("\n");
            error_print("  .invariant\n");
            error_print("      ; my_invariant\n");
            error_print("      ; For all valid inputs: output is valid\n");
            error_print("      ; Rationale: ensures correctness\n");
            error_print("\n");
            error_print("NOTE: There is NO --allow-no-tests flag (prototype mode is disabled per policy)");
            return 1;
        }

        print("TDD contract validated: ");
        print_int(test_count);
        error_print(" tests, ");
        print_int(invariant_count);
        error_print(" invariants\n");

        // ═════════════════════════════════════════════════════════════════════
        // CODE GENERATION AND COMPILATION CHECK
        // ═════════════════════════════════════════════════════════════════════

        // Generate Zig code to check compilation
        const codegen_opts = CodegenOptions{
            .emit_comments = true,
            .emit_debug = true,
            .optimize_level = 0,
            .target_triple = "native",
            .include_runtime = true,
        };

        const zig_code = generate_zig(content.?, spec_path, codegen_opts);
        
        // Write to temporary file for compilation check
        const temp_file = "temp_spec.zig";
        const write_result = write_file(temp_file, zig_code);
        if (write_result != 0) {
            error_print("Failed to write temporary Zig file\n");
            return 1;
        }

        // Check if compilation succeeds
        const compile_result = compile_zig_file(temp_file);
        
        // Clean up temporary file
        _ = delete_file(temp_file);

        if (compile_result != 0) {
            // Compilation failed - spec is BLOCKED
            error_print("BLOCKED  does not compile: ");
            error_print(spec_path);
            error_print("\n\n");
            error_print("A blocked spec is not a failing one. It never produced a\n");
            error_print("binary, so it has no per-test result to report.\n");
            
            // Exit with non-zero code when blocked (FR-001)
            return 1;
        }

        // ═════════════════════════════════════════════════════════════════════
        // TEST EXECUTION
        // ═════════════════════════════════════════════════════════════════════

        // Generate test code
        const testgen_opts = TestGenOptions{
            .backend = "zig",
            .emit_comments = true,
            .emit_benchmarks = true,
            .output_format = "code",
        };

        const testgen = TestGen.new(context.ast_root, testgen_opts);
        const test_code = testgen.generate();

        // Write test file
        const test_file = "temp_spec_test.zig";
        const test_write_result = write_file(test_file, test_code);
        if (test_write_result != 0) {
            error_print("Failed to write test file\n");
            return 1;
        }

        // Run tests
        const test_result = run_zig_tests(test_file);
        
        // Clean up test file
        _ = delete_file(test_file);

        if (test_result != 0) {
            error_print("Tests failed in ");
            error_print(spec_path);
            error_print("\n");
            return test_result;
        }

        print("All tests passed in ");
        print(spec_path);
        error_print("\n");
        return 0;
    }

    // ═════════════════════════════════════════════════════════════════════
    // Helper functions for test-report
    // ═════════════════════════════════════════════════════════════════════

    // Compile a Zig file and return exit code
    fn compile_zig_file(zig_file: []const u8) i32 {
        // Use system zig compiler to check compilation
        const cmd = "zig build-exe " ++ zig_file ++ " -femit-bin=/dev/null -fno-strip";
        const result = shell_command(cmd);
        return result.exit_code;
    }

    // Run Zig tests and return exit code
    fn run_zig_tests(test_file: []const u8) i32 {
        // Compile and run tests
        const cmd = "zig test " ++ test_file;
        const result = shell_command(cmd);
        return result.exit_code;
    }

    // Shell command execution result
    const ShellResult = struct {
        exit_code: i32,
        stdout: []const u8,
        stderr: []const u8,
    };

    // Execute shell command and return result
    fn shell_command(cmd: []const u8) ShellResult {
        // This is a simplified version - in practice you'd need to implement
        // proper shell command execution with stdout/stderr capture
        // For now, assume we have a way to execute commands and get exit codes
        const result = execute_shell_command(cmd);
        return ShellResult{
            .exit_code = result.exit_code,
            .stdout = result.stdout,
            .stderr = result.stderr,
        };
    }
