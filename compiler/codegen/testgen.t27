const TestGen = struct {
    arena: std.mem.Arena,
    outfile: std.fs.File,
    error_count: usize,

    pub fn init(arena: std.mem.Arena, outfile: std.fs.File) TestGen {
        return TestGen{
            .arena = arena,
            .outfile = outfile,
            .error_count = 0,
        };
    }

    pub fn deinit(self: *TestGen) void {
        self.arena.deinit();
    }

    fn emit(self: *TestGen, s: []const u8) void {
        const _ = self.outfile.writeAll(s);
    }

    fn emitLine(self: *TestGen, s: []const u8) void {
        self.emit(s);
        self.emit("\n");
    }

    fn emitSpec(self: *TestGen, spec: Spec) void {
        // Emit the spec header.
        self.emit("// Spec: ");
        self.emitLine(spec.name);

        // Emit the imports.
        self.emit("const std = @import(\"std\");\n");
        self.emit("const expect = @import(\"test\").expect;\n");
        self.emit("\n");

        // Emit the test groups.
        for (spec.test_blocks) |test_block| {
            self.emitSpecTestGroup(test_block);
        }

        // Emit the assembly tests.
        for (spec.assembly_tests) |test_case| {
            self.emitAssemblyTest(test_case);
        }

        // Emit the invariants.
        for (spec.invariants) |inv| {
            self.emitInvariant(inv);
        }

        // Emit the benchmarks.
        for (spec.benchmarks) |bench| {
            self.emitBenchmark(bench);
        }

        // Emit the footer.
        self.emit("\n");
    }

    fn emitSpecTestGroup(self: *TestGen, test_block: TestBlock) void {
        self.emit("test \"");
        self.emit(self.zig_string_body(test_block.name));
        self.emit("\" {\n");

        for (test_block.clauses) |clause| {
            switch (clause.kind) {
                .given => {
                    self.emit("    const ");
                    self.emit(clause.variable);
                    self.emit(" = ");
                    self.emit(clause.expression);
                    self.emit(";\n");
                }
                .when => {
                    self.emit("    const ");
                    self.emit(clause.variable);
                    self.emit(" = ");
                    self.emit(clause.expression);
                    self.emit(";\n");
                }
                .then => {
                    self.emit("    const ");
                    self.emit(clause.variable);
                    self.emit(" = ");
                    self.emit(clause.expression);
                    self.emit(";\n");
                }
            }
        }

        self.emit("}\n");
    }

    fn emitAssemblyTest(self: *TestGen, test_case: AssemblyTest) void {
        self.emit("test \"");
        self.emit(self.zig_string_body(test_case.name));
        self.emit("\" {\n");

        self.emit("    // Verify: ");
        self.emitLine(test_case.verify_description);
        self.emit("    // Expected: ");
        self.emitLine(test_case.expected_outcome);

        self.emit("    try std.testing.expect(true);  // Placeholder during bootstrap\n");
        self.emit("}\n");
    }

    fn emitInvariant(self: *TestGen, inv: Invariant) void {
        self.emit("test \"invariant_");
        self.emit(self.zig_string_body(inv.name));
        self.emit("\" {\n");

        self.emit("    // Formal: ");
        self.emitLine(inv.expression);
        self.emit("    // Rationale: ");
        self.emitLine(inv.rationale);

        self.emit("    try std.testing.expect(true);  // Placeholder during bootstrap\n");
        self.emit("}\n");
    }

    fn emitBenchmark(self: *TestGen, bench: Benchmark) void {
        self.emit("test \"bench_");
        self.emit(self.zig_string_body(bench.name));
        self.emit("\" {\n");

        self.emit("    // Measure: ");
        self.emitLine(bench.measure_description);
        self.emit("    // Target: ");
        self.emitLine(bench.target);

        self.emit("    try std.testing.expect(true);  // Placeholder during bootstrap\n");
        self.emit("}\n");
    }

    fn zig_string_body(self: *TestGen, s: []const u8) []const u8 {
        var buf: std.ArrayList(u8) = std.ArrayList(u8).init(self.arena);
        defer buf.deinit();
        for (s) |c| {
            switch (c) {
                '"' => { buf.append('\\'); buf.append('"'); },
                '\\' => { buf.append('\\'); buf.append('\\'); },
                '\n' => { buf.append('\\'); buf.append('n'); },
                '\r' => { buf.append('\\'); buf.append('r'); },
                '\t' => { buf.append('\\'); buf.append('t'); },
                else => { buf.append(c); },
            }
        }
        return buf.toSlice();
    }

    fn escape_json(self: *TestGen, s: []const u8) []const u8 {
        var buf: std.ArrayList(u8) = std.ArrayList(u8).init(self.arena);
        defer buf.deinit();
        for (s) |c| {
            switch (c) {
                '"' => { buf.append('\\'); buf.append('"'); },
                '\\' => { buf.append('\\'); buf.append('\\'); },
                '\n' => { buf.append('\\'); buf.append('n'); },
                '\r' => { buf.append('\\'); buf.append('r'); },
                '\t' => { buf.append('\\'); buf.append('t'); },
                else => { buf.append(c); },
            }
        }
        return buf.toSlice();
    }
};