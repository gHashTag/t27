#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

WAVE_SKILL="$REPO_ROOT/.claude/skills/t27-wave-loop.md"
THEORY_DOC="$REPO_ROOT/docs/theory/IGLA-FORMAL-RESULTS.md"
DISK_FLOOR_GIB="${TRI_DISK_FLOOR_GIB:-2}"

die() { echo "tri: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
tri -- the t27 front door.

Compiler commands (forwarded to t27c):
  tri test [--json] [...]     run the conformance suite (t27c suite --repo-root .)
  tri <anything else>         forwarded to t27c unchanged (gen, seal, fpga-build, ...)

Local commands (no compiler needed):
  tri audit                   every pre-wave invariant in one exit code (disk, tree, push, numbering)
  tri recall PATTERN          search lesson and theorem HEADINGS for a pattern
  tri last [N]                the N most recent lessons and theorems (default 5)
  tri frontier                list the committed measurement records and reports
  tri verify                  recompute every headline number from its record
  tri cells TOP FILE.v ...    cell census of a Verilog top via local yosys (LUT/CARRY4/MUXF/FF)
  tri wave                    one-screen wave state: branch, dirt, disk, lesson/theorem counters
  tri disk [--min GIB]        free-space gate; exits 1 below the floor (default 2 GiB)
  tri ci [SLUG ...]           live (non-completed) CI runs; defaults to this repo's origin
  tri lesson "TITLE" "BODY"   append the next-numbered lesson to the wave-loop skill
  tri lesson --check          audit lesson numbering (duplicates, gaps, non-monotonic)
  tri theorem [--check]       next theorem number; --check audits T-numbering
  tri help                    this text

Environment:
  TRI_T27C            explicit path to the t27c binary
  TRI_DISK_FLOOR_GIB  free-space floor for `tri disk` and `tri wave` (default 2)
EOF
}

# Free GiB on the volume holding the repo. POSIX df, so macOS and Linux agree.
free_gib() { df -Pk "$REPO_ROOT" | awk 'NR==2 { printf "%.1f", $4/1048576 }'; }

# Lesson headers are "**1401. TITLE.** body". The space after the period is what
# separates a header from bold prose like "**88.03% on Fashion**" -- without it
# the counter reads a percentage as a lesson number.
lesson_numbers() { grep -oE '^\*\*[0-9]+\.[[:space:]]' "$WAVE_SKILL" | tr -dc '0-9\n'; }

# Theorem headers are "### T763 -- TITLE [measured]", and sub-parts are real
# theorems: T709, T709a, T709b are three distinct entries, not a triple collision.
theorem_tokens() { grep -oE '^#{2,4} T[0-9]+[a-z]*' "$THEORY_DOC" | awk '{ print $2 }'; }

last_lesson_no() {
  [ -f "$WAVE_SKILL" ] || return 1
  lesson_numbers | sort -n | tail -1
}

last_theorem_no() {
  [ -f "$THEORY_DOC" ] || return 1
  theorem_tokens | tr -dc '0-9\n' | sort -n | tail -1
}

origin_slug() {
  local url
  url="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)"
  [ -n "$url" ] || return 1
  printf '%s\n' "$url" | sed -E 's#^git@[^:]+:##; s#^https?://[^/]+/##; s#\.git$##'
}

cmd="${1:-}"

# Local commands are dispatched BEFORE the compiler is resolved: `tri` used to
# exit "t27c not found" for every subcommand, including the ones that never
# touch the compiler -- which is exactly the state a machine is in when the
# compiler is what you are trying to fix.
case "$cmd" in
  help|-h|--help)
    usage
    exit 0
    ;;

  rungs)
    # W967: tri anomaly checks the SHAPE of records; it cannot see that a name is
    # bound to the wrong object. That defect has cost this project two sign-flipped
    # results (W954, W963), so it gets its own command: every TNFFormat(...) in every
    # rig, resolved to its physical width and its rung -- or to "not a rung at all".
    ORACLES="${T27_CONFORMANCE:-}"
    if [ -z "$ORACLES" ]; then
      for c in "$REPO_ROOT/conformance" "${TMPDIR:-/tmp}/oracles" \
               "$(dirname "${TMPDIR:-/tmp}")"/*/scratchpad/oracles; do
        [ -f "$c/tnf_ref.py" ] && { ORACLES="$c"; break; }
      done
    fi
    [ -f "$ORACLES/tnf_ref.py" ] || {
      echo "tri rungs: oracles not found; set T27_CONFORMANCE" >&2; exit 2; }
    ORACLES="$ORACLES" SRC="${T27_RECORDS:-$REPO_ROOT/docs/reports/upstream}" python3 - <<'PYRUNGS'
import os, re, sys, pathlib
sys.path.insert(0, os.environ["ORACLES"])
import tnf_ref as T

SRC = pathlib.Path(os.environ["SRC"])
LADDERS = {v: T.get_ladder(v) for v in (T.LADDERS if isinstance(T.LADDERS, dict) else {})}
known = {}
for ver, lad in LADDERS.items():
    for rung, f in lad.items():
        known.setdefault((f.exp_trits, f.mant_bits), []).append(f"TNF{rung}/{ver}")

# W967: the first version grepped the source text and flagged struct966.py because a
# COMMENT mentioned TNFFormat(4,3). A tool that reads prose as code produces exactly
# the noise it was built to remove, so this walks the AST: only real calls count.
import ast


def instantiations(path):
    try:
        tree = ast.parse(path.read_text())
    except SyntaxError:
        return
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        fn = node.func
        name = fn.attr if isinstance(fn, ast.Attribute) else getattr(fn, "id", None)
        if name != "TNFFormat" or len(node.args) != 2:
            continue
        a, b = node.args
        if isinstance(a, ast.Constant) and isinstance(b, ast.Constant) \
                and isinstance(a.value, int) and isinstance(b.value, int):
            yield a.value, b.value
rows, bad = [], 0
for f in sorted(SRC.glob("*.py")):
    seen = set()
    for et, mb in instantiations(f):
        if (et, mb) in seen:
            continue
        seen.add((et, mb))
        fmt = T.TNFFormat(et, mb)
        w = fmt.sign_shift + 1
        who = known.get((et, mb))
        rows.append([f.name, et, mb, w, ", ".join(who) if who else "not a rung", bool(who)])
    # A non-rung format is legitimate when the same file ALSO instantiates the true
    # rung -- that is a labelled control, which is how W963-W966 measured the
    # substitution deliberately. It is a defect only when it stands alone.
    true8 = any(x[:3] == [f.name, 3, 4] for x in rows if x[0] == f.name)
    for r in rows:
        if r[0] == f.name and not r[5]:
            r[4] = "not a rung, but a labelled control" if true8 else "NOT A RUNG -- stands alone"
            if not true8:
                bad += 1

print(f"{'file':30} {'TNFFormat':>12} {'bits':>5}  rung")
for name, et, mb, w, who, ok_ in rows:
    mark = "" if ok_ or "control" in who else "  <-- "
    print(f"{name[:30]:30} {f'({et}, {mb})':>12} {w:5d}  {mark}{who}")
print(f"\ntri rungs: {len(rows)} instantiation(s), {bad} standing alone as a non-rung")
print("A rung's NAME is not its object. Print (exp_trits, mant_bits) and the physical")
print("width beside every figure, and never label a measurement by the rung alone.")
raise SystemExit(1 if bad else 0)
PYRUNGS
    exit $?
    ;;
  anomaly)
    # W955: every measurement defect this loop has hit left a signature in the record
    # itself. They are cheap to look for and expensive to miss, so they are a command.
    #   zero-reading   a cost of exactly 0 (yosys -q silenced stat, W952; LUT-only
    #                  census reported TNF decoders at 0.000, lesson 1407)
    #   flat-fit       R2 = 1 with slope 0 -- a perfect line through a constant is
    #                  absence of signal, not precision
    #   twins          two different formats with byte-identical metric vectors
    #                  (the blockscale rig, W949: scaling had erased the difference)
    #   short-arm      fewer runs recorded than seeds declared (a killed sweep, W954)
    REC="${T27_RECORDS:-$REPO_ROOT/docs/reports/upstream}"
    REC="$REC" python3 - <<'PYANOM'
import json, os, pathlib
R = pathlib.Path(os.environ["REC"])
bad = 0


def walk(o, path=""):
    if isinstance(o, dict):
        for k, v in o.items():
            yield from walk(v, f"{path}.{k}" if path else str(k))
    elif isinstance(o, list):
        yield path, o
    else:
        yield path, o


for f in sorted(R.glob("*.json")):
    try:
        d = json.loads(f.read_text())
    except Exception:
        continue
    name = f.name
    cost = d.get("cost") if isinstance(d, dict) else None
    if isinstance(cost, dict):
        for fmt, c in cost.items():
            if not isinstance(c, dict):
                continue
            slope = next((c[k] for k in ("per_lane", "per_acc", "cost", "slope")
                          if k in c), None)
            if slope == 0:
                print(f"ZERO-READING  {name}: {fmt} costs exactly 0"); bad += 1
            if c.get("r2") == 1.0 and slope == 0:
                print(f"FLAT-FIT      {name}: {fmt} R2=1 with slope 0"); bad += 1
        vecs = {}
        for fmt, c in cost.items():
            if isinstance(c, dict) and isinstance(c.get("points"), list):
                vecs.setdefault(tuple(c["points"]), []).append(fmt)
        for pts, fmts in vecs.items():
            if len(fmts) > 1:
                print(f"TWINS         {name}: {', '.join(fmts)} share the vector {list(pts)}")
                bad += 1
    seeds = d.get("seeds") if isinstance(d, dict) else None
    runs = d.get("runs") if isinstance(d, dict) else None
    if isinstance(seeds, list) and isinstance(runs, dict):
        want = len(seeds)

        def arm_counts(node, label):
            """Yield (label, run_count). A record nests runs three ways, and the
            first version of this check counted a per-EPOCH trace as runs -- 255
            false positives on its first execution. Decide by shape, not by depth."""
            if isinstance(node, list):
                if all(isinstance(x, (int, float)) for x in node):
                    yield label, len(node)          # {fmt: [acc per seed]}
                return
            if isinstance(node, dict):
                vals = list(node.values())
                if vals and all(isinstance(v, list) and v and isinstance(v[-1], dict)
                                for v in vals):
                    yield label, len(node)          # {seed: [epoch trace]}
                    return
                for k2, v2 in node.items():
                    yield from arm_counts(v2, f"{label}/{k2}" if label else str(k2))

        for k, v in runs.items():
            for label, n in arm_counts(v, k):
                if n and n != want:
                    print(f"SHORT-ARM     {name}: {label} has {n} runs, {want} seeds declared")
                    bad += 1
print(f"\nanomaly: {'FAIL, ' + str(bad) + ' signature(s)' if bad else 'clean over ' + str(len(list(R.glob('*.json')))) + ' records'}")
raise SystemExit(1 if bad else 0)
PYANOM
    exit $?
    ;;
  cost)
    # W953: three silicon records now price the same three formats in three datapath
    # styles, and the ratio between them is the whole finding. Derived, never typed.
    REC="${T27_RECORDS:-$REPO_ROOT/docs/reports/upstream}"
    REC="$REC" python3 - <<'PYCOST'
import json, os, pathlib
R = pathlib.Path(os.environ["REC"])
FMTS = ("TNF4", "fp6e3m2", "fp6e2m3")
ALIAS = {"TNF4": ("TNF4", "tnf4"), "fp6e3m2": ("fp6e3m2", "fp6_e3m2"),
         "fp6e2m3": ("fp6e2m3", "fp6_e2m3")}
SRC = [("decode + const-multiply", "oracle_rtl6_w946.json", "consumer_cells"),
       ("MAC lane, fixed point", "mac_w952.json", "per_lane"),
       ("MAC lane, float style", "flane_w953.json", "per_lane"),
       ("block-32 accumulator", "acc_w952.json", "per_acc")]
print(f"{'datapath':26} " + " ".join(f"{c:>10}" for c in FMTS) + "   TNF4/e2m3")
for label, fn, key in SRC:
    p = R / fn
    if not p.exists():
        continue
    d = json.loads(p.read_text())
    cost = d.get("cost") or d.get("units") or {}
    vals = {}
    if not cost:
        cost = d                       # some records key formats at the top level
    for f in FMTS:
        v = None
        for a in ALIAS[f]:
            if a in cost:
                v = cost[a]
                break
        if isinstance(v, dict):
            v = next((v[k] for k in (key, "consumer_cells", "cells_per_unit",
                                     "per_lane", "per_acc", "cost", "slope")
                      if k in v), None)
        if isinstance(v, (int, float)):
            vals[f] = float(v)
    if len(vals) < 2:
        continue
    cells = " ".join(f"{vals.get(f, float('nan')):10.2f}" for f in FMTS)
    r = vals.get("TNF4", 0) / vals["fp6e2m3"] if vals.get("fp6e2m3") else float("nan")
    print(f"{label:26} {cells}   {r:8.2f}x")
print("\nLUT1-6 + CARRY4, cost = slope of cells(N) = fixture + cost*N over N = 1,2,4,8.")
print("The accumulator is shared by 32 elements; divide it by 32 before comparing per element.")
PYCOST
    exit 0
    ;;
  sweep)
    # W951: records multiply faster than any hand-kept table, and W948d showed what
    # a hand-kept tally costs. One command, every record, derived.
    REC="${T27_RECORDS:-$REPO_ROOT/docs/reports/upstream}"
    REC="$REC" python3 - <<'PYSWEEP'
import json, os, pathlib
R = pathlib.Path(os.environ["REC"])
TH = {"mnist": 60.0, "fashion": 60.0, "kmnist": 40.0}
FMTS = ("TNF4", "fp6e3m2", "fp6e2m3")


def accs_of(v):
    """A record stores runs three ways; return final accuracies in percent."""
    if isinstance(v, list):
        return [float(x) for x in v] if all(isinstance(x, (int, float)) for x in v) else None
    if isinstance(v, dict) and v:
        out = []
        for tr in v.values():
            if isinstance(tr, list) and tr and isinstance(tr[-1], dict) and "acc" in tr[-1]:
                a = float(tr[-1]["acc"])
                out.append(a * 100 if a <= 1.0 else a)
            else:
                return None
        return out
    return None


def arms(runs):
    """Some records nest an arm (block32, peak2max) above the format."""
    direct = {k: accs_of(v) for k, v in runs.items() if k in FMTS}
    direct = {k: v for k, v in direct.items() if v is not None}
    if direct:
        yield "", direct
        return
    for arm, inner in runs.items():
        if isinstance(inner, dict):
            got = {k: accs_of(v) for k, v in inner.items() if k in FMTS}
            got = {k: v for k, v in got.items() if v is not None}
            if got:
                yield arm, got


rows, tot = [], {}
for f in sorted(R.glob("*.json")):
    try:
        d = json.loads(f.read_text())
    except Exception:
        continue
    # W951: not every record is an object -- saturation_w951.json is a flat list of
    # runs. Ask what the JSON IS before asking what it contains.
    if not isinstance(d, dict):
        continue
    runs = d.get("runs")
    if not isinstance(runs, dict) or not runs:
        continue
    task = d.get("task", "?")
    th = d.get("threshold") or TH.get(task, 60.0)
    for arm, got in arms(runs):
        mode = d.get("mode") or (arm if arm else "learned")
        row = {"file": f.name[:30], "task": task, "mode": str(mode)[:11],
               "blk": d.get("block", 0), "ep": d.get("epochs", "?"), "fmt": {}}
        for fmt, accs in got.items():
            bad = sum(1 for a in accs if a < th)
            row["fmt"][fmt] = (bad, len(accs))
            t = tot.setdefault(fmt, [0, 0])
            t[0] += bad
            t[1] += len(accs)
        rows.append(row)

print(f"{'record':30} {'task':8} {'scale':11} {'blk':>4} {'ep':>3} " +
      " ".join(f"{c:>9}" for c in FMTS))
for r in rows:
    cells = [(f"{r['fmt'][c][0]}/{r['fmt'][c][1]}" if c in r["fmt"] else "-") for c in FMTS]
    print(f"{r['file']:30} {r['task']:8} {r['mode']:11} {r['blk']:>4} {str(r['ep']):>3} " +
          " ".join(f"{c:>9}" for c in cells))
print(f"\n{'FAILURES over every record':30} {'':8} {'':11} {'':>4} {'':>3} " +
      " ".join(f"{str(tot.get(c,[0,0])[0])+'/'+str(tot.get(c,[0,0])[1]):>9}" for c in FMTS))
print("(failure = final test accuracy below the task threshold: 60 %, 40 % on KMNIST)")
PYSWEEP
    exit 0
    ;;
  grid)
    # W949: the published underflow mechanism (0.0041 / 0.22 / 1.67 % of peak) was
    # computed as min/max of each grid -- i.e. assuming the tensor peak lands on the
    # format's MAXIMUM. Every training run instead put the peak on grid value 1.0,
    # which leaves TNF4 seven usable levels against fp6 e3m2's twelve and inverts
    # the underflow ordering. One command now prints both conventions side by side.
    ORACLES="${T27_CONFORMANCE:-}"
    if [ -z "$ORACLES" ]; then
      for c in "$REPO_ROOT/conformance" "${TMPDIR:-/tmp}/oracles" \
               "$(dirname "${TMPDIR:-/tmp}")"/*/scratchpad/oracles; do
        [ -f "$c/tnf_ref.py" ] && { ORACLES="$c"; break; }
      done
    fi
    [ -f "$ORACLES/tnf_ref.py" ] || {
      echo "tri grid: oracles not found; set T27_CONFORMANCE to the conformance/ dir" >&2
      exit 2; }
    ORACLES="$ORACLES" python3 - <<'PYGRID'
import os, sys, numpy as np
sys.path.insert(0, os.environ["ORACLES"])
import tnf_ref as T, fp8_ref as F8


def grid(mod, fmt, bits):
    v = []
    for c in range(1 << bits):
        try:
            x = float(mod.decode(fmt, c))
        except Exception:
            continue
        if np.isfinite(x):
            v.append(x)
    return np.unique(np.array(sorted(set(v)), dtype=np.float64))


G = {"TNF4": grid(T, T.TNFFormat(2, 1), 6)}
for n, f in sorted(F8.FORMATS.items()):
    b = 4 if "fp4" in n else (6 if "fp6" in n else 8)
    G[n] = grid(F8, f, b)
print(f"{'format':10} {'max+':>10} {'min+':>10} {'binades':>8} {'levels':>7}"
      f" | {'peak->max: zeroes below':>24} {'peak->1.0: below':>17} {'levels':>7}")
for k, g in G.items():
    p = g[g > 0]
    std = p.min() / p.max()
    rig = p.min()
    print(f"{k:10} {p.max():10.4g} {p.min():10.4g} "
          f"{np.log2(p.max()/p.min()):8.2f} {len(p):7d} |"
          f" {std*100:23.4f}% {min(rig,1.0)*100:16.2f}% {int((p<=1.0).sum()):7d}")
print("\nThe left convention is the standard max rule and the one the published")
print("mechanism assumes. The right one is what every run before W949 actually did.")
PYGRID
    exit 0
    ;;
  disk)
    # W948: the gate fired at 0.7 GiB while this session's own scratch held 47 MB
    # -- two other sessions' scratch directories were holding 8 GB between them.
    # A floor breach says nothing about whose files caused it, and deleting your
    # own already-minimal footprint is wasted work. So report both.
    floor="$DISK_FLOOR_GIB"
    [ "${2:-}" = "--min" ] && { floor="${3:?tri disk --min needs a number}"; }
    free="$(free_gib)"
    if [ -n "${TMPDIR:-}" ] && [ -d "${TMPDIR}" ]; then
      own="$(du -sk "$TMPDIR" 2>/dev/null | awk '{ printf "%.0f", $1/1024 }')"
      [ -n "$own" ] && echo "tri disk: this session's scratch holds ${own} MiB"
    fi
    if awk -v f="$free" -v fl="$floor" 'BEGIN { exit !(f + 0 < fl + 0) }'; then
      echo "tri disk: ${free} GiB free -- BELOW the ${floor} GiB floor"
      exit 1
    fi
    echo "tri disk: ${free} GiB free (floor ${floor} GiB) OK"
    exit 0
    ;;

  wave)
    branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')"
    head="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo '-')"
    dirty="$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    free="$(free_gib)"
    lesson="$(last_lesson_no || echo '-')"
    theorem="$(last_theorem_no || echo '-')"
    t27c_path="${TRI_T27C:-}"
    if [ -z "$t27c_path" ]; then
      for p in "$REPO_ROOT/target/release/t27c" "$REPO_ROOT/target/debug/t27c"; do
        [ -x "$p" ] && t27c_path="$p" && break
      done
    fi
    printf 'repo      %s\n' "$REPO_ROOT"
    printf 'branch    %s @ %s (%s dirty)\n' "$branch" "$head" "$dirty"
    printf 'disk      %s GiB free (floor %s GiB)%s\n' "$free" "$DISK_FLOOR_GIB" \
      "$(awk -v f="$free" -v fl="$DISK_FLOOR_GIB" 'BEGIN { print (f + 0 < fl + 0) ? "  <<< BELOW FLOOR" : "" }')"
    printf 'lesson    last %s -> next %s\n' "$lesson" \
      "$([ "$lesson" = '-' ] && echo '-' || echo $((lesson + 1)))"
    printf 'theorem   last T%s -> next T%s\n' "$theorem" \
      "$([ "$theorem" = '-' ] && echo '-' || echo $((theorem + 1)))"
    printf 't27c      %s\n' "${t27c_path:-not built (compiler commands unavailable)}"
    exit 0
    ;;

  cells)
    # The cell census of a Verilog top, via local yosys. Used constantly for
    # area work and it never needed the t27c compiler, so it lives here.
    command -v yosys >/dev/null 2>&1 || die "cells: yosys not found"
    top="${2:?tri cells needs TOP then one or more .v files}"
    shift 2
    [ "$#" -gt 0 ] || die "cells: give at least one .v file"
    log="$(mktemp "${TMPDIR:-/tmp}/tri-cells.XXXXXX")"
    if ! yosys -p "read_verilog $*; synth_xilinx -nodsp -top $top; stat" > "$log" 2>&1; then
      echo "tri cells: yosys failed" >&2
      grep -E '^ERROR|error:' "$log" | head -3 >&2
      rm -f "$log"
      exit 1
    fi
    awk -v top="$top" '
      /Printing statistics/ { inblock = 1; delete c; next }
      inblock && /^ *[0-9]+ +[A-Z]/ { gsub(/^ +/, ""); split($0, f, / +/); c[f[2]] += f[1] }
      END {
        lut = 0; for (k in c) if (k ~ /^LUT[1-6]$/) lut += c[k]
        cy = c["CARRY4"] + 0; mux = c["MUXF7"] + c["MUXF8"]
        ff = c["FDRE"] + c["FDSE"] + c["FDCE"] + c["FDPE"]
        printf "%s: LUT %d  CARRY4 %d  MUXF %d  FF %d  (LUT+CARRY4 = %d)\n", top, lut, cy, mux, ff, lut + cy
      }' "$log"
    rm -f "$log"
    exit 0
    ;;

  verify)
    # "Check all the numbers again" as a command rather than an act of attention:
    # every headline figure recomputed from its committed record.
    v="$REPO_ROOT/docs/reports/upstream/verify_numbers.py"
    [ -f "$v" ] || die "verify: $v not found"
    command -v python3 >/dev/null 2>&1 || die "verify: python3 not found"
    python3 "$v"
    exit $?
    ;;

  frontier)
    # The wave loop keeps re-deriving "what do we actually claim now". This prints
    # the current measured frontier from the committed records, so the answer is a
    # file read rather than a memory.
    d="$REPO_ROOT/docs/reports/upstream"
    [ -d "$d" ] || die "frontier: $d not found"
    for f in "$d"/*.json; do
      [ -e "$f" ] || continue
      printf '%-34s %s\n' "$(basename "$f")" "$(wc -c < "$f" | tr -d ' ') bytes"
    done
    echo "-- reports"
    ls "$d"/*.md 2>/dev/null | sed 's|.*/|  |'
    exit 0
    ;;

  last)
    # What did the previous waves conclude? The loop re-reads this constantly and
    # the files are 12k and 28k lines, so tail-with-context is the wrong tool.
    n="${2:-5}"
    case "$n" in ''|*[!0-9]*) die "last: N must be a number";; esac
    if [ -f "$WAVE_SKILL" ]; then
      echo "== last $n lessons"
      grep -nE '^\*\*[0-9]+\.[[:space:]]' "$WAVE_SKILL" | tail -"$n" | cut -c1-150 | sed 's/^/  /'
    fi
    if [ -f "$THEORY_DOC" ]; then
      echo "== last $n theorems"
      grep -nE '^#{2,4} T[0-9]+[a-z]* ' "$THEORY_DOC" | tail -"$n" | cut -c1-150 | sed 's/^/  /'
    fi
    exit 0
    ;;

  recall)
    # "Have I learned this before?" -- the question an unattended loop asks most
    # often and answers worst. Searches lesson headers and theorem headings only,
    # so the answer fits on a screen instead of being a full-text dump.
    pat="${2:?tri recall needs a pattern (case-insensitive extended regex)}"
    hits=0
    if [ -f "$WAVE_SKILL" ]; then
      out="$(grep -inE "^\*\*[0-9]+\.[[:space:]].*${pat}" "$WAVE_SKILL" | cut -c1-160 || true)"
      [ -n "$out" ] && { echo "== lessons"; printf '%s\n' "$out" | sed 's/^/  /'; hits=1; }
    fi
    if [ -f "$THEORY_DOC" ]; then
      out="$(grep -inE "^#{2,4} T[0-9]+[a-z]* .*${pat}" "$THEORY_DOC" | cut -c1-160 || true)"
      [ -n "$out" ] && { echo "== theorems"; printf '%s\n' "$out" | sed 's/^/  /'; hits=1; }
    fi
    [ "$hits" = "1" ] || echo "tri recall: nothing matches '$pat' in lesson or theorem headings"
    exit 0
    ;;

  audit)
    # Everything an unattended wave must check before it starts changing things.
    # One exit code, so a cron loop can gate on it.
    bad=0
    free="$(free_gib)"
    if awk -v f="$free" -v fl="$DISK_FLOOR_GIB" 'BEGIN { exit !(f + 0 < fl + 0) }'; then
      echo "FAIL  disk      ${free} GiB free, below the ${DISK_FLOOR_GIB} GiB floor"; bad=1
    else
      echo "ok    disk      ${free} GiB free"
    fi
    dirty="$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    if [ "$dirty" != "0" ]; then echo "warn  tree      $dirty uncommitted file(s)"; else echo "ok    tree      clean"; fi
    # Compare against origin/<this branch>, not @{upstream}: a worktree branch is
    # often configured to track master, and counting commits against master and
    # calling them "not pushed" is a true number about the wrong ref. The ref is
    # printed either way, because a count without its reference point is noise.
    br="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    ref="origin/$br"
    git -C "$REPO_ROOT" rev-parse --verify -q "$ref" >/dev/null 2>&1 || \
      ref="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo '')"
    if [ -n "$ref" ]; then
      up="$(git -C "$REPO_ROOT" log --oneline "$ref..HEAD" 2>/dev/null | wc -l | tr -d ' ')"
      if [ "${up:-0}" != "0" ]; then echo "warn  push      $up commit(s) ahead of $ref"
      else echo "ok    push      in sync with $ref"; fi
    else
      echo "warn  push      no remote ref for $br"
    fi
    if [ -f "$WAVE_SKILL" ]; then
      out="$("$0" lesson --check 2>&1)" && echo "ok    lessons   $out" || { echo "FAIL  lessons   $out"; bad=1; }
    fi
    if [ -f "$THEORY_DOC" ]; then
      out="$("$0" theorem --check 2>&1)" && echo "ok    theorems  $out" || { echo "FAIL  theorems  $out"; bad=1; }
    fi
    # W950: the published figures are only as good as their last recomputation, and
    # W948d showed a hand-carried number can sit wrong in three documents for a whole
    # wave. verify_numbers.py derives every headline figure from the records, so the
    # audit now refuses to pass while any of them disagrees with its evidence.
    # W968: the substitution class cost this project two sign-flipped results and eight
    # waves. Once cleared, it must not be able to return silently, so the gate checks it.
    if out="$("$0" rungs 2>&1)"; then
      echo "ok    rungs     $(printf '%s' "$out" | grep -E '^tri rungs:' | sed 's/^tri rungs: //')"
    else
      echo "FAIL  rungs     $(printf '%s' "$out" | grep -E '^tri rungs:' | sed 's/^tri rungs: //')"
      bad=1
    fi
    # W969: FALSIFY-ME.md invites an outside replication, and for eighteen waves that
    # was true of two rigs out of twenty -- the rest named this machine's directories.
    # The property is corpus-wide, so the gate checks it corpus-wide.
    # W971: origin/master was replaced by an orphan commit -- 2545 commits became 1,
    # with no merge-base. git status reported it only as a larger divergence number,
    # which is exactly the kind of change a loop reads past. A missing merge-base is
    # categorically different from being behind, so the gate says so.
    MAINB="$(git -C "$REPO_ROOT" rev-parse --verify -q origin/master >/dev/null 2>&1 && echo origin/master || echo '')"
    if [ -n "$MAINB" ]; then
      if git -C "$REPO_ROOT" merge-base "$MAINB" HEAD >/dev/null 2>&1; then
        lr="$(git -C "$REPO_ROOT" rev-list --left-right --count "$MAINB"...HEAD 2>/dev/null)"
        echo "ok    base      shares history with $MAINB (${lr:-?} behind/ahead)"
      else
        echo "FAIL  base      NO MERGE-BASE with $MAINB -- histories are unrelated;"
        echo "                see docs/reports/MASTER-ORPHANED-W971.md before any merge"
        bad=1
      fi
    fi
    RIGS="$REPO_ROOT/docs/reports/upstream"
    if [ -d "$RIGS" ]; then
      # `grep -l` exits 1 when it finds nothing, and under `set -o pipefail` that
      # aborted the whole audit the moment the corpus became clean -- a gate that
      # kills its own harness precisely on success. `|| true` is the fix.
      stuck="$( { grep -l -e '/private/tmp/claude-501' -e 'upstream-wt' "$RIGS"/*.py 2>/dev/null || true; } | wc -l | tr -d ' ')"
      unparsed=0
      for rig in "$RIGS"/*.py; do
        python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$rig" 2>/dev/null || \
          unparsed=$((unparsed+1))
      done
      if [ "$stuck" = "0" ] && [ "$unparsed" = "0" ]; then
        echo "ok    rigs      $(ls "$RIGS"/*.py | wc -l | tr -d ' ') rigs parse, none names a path outside its tree"
      else
        echo "FAIL  rigs      $stuck with hard-coded paths, $unparsed that do not parse"; bad=1
      fi
    fi
    VN="$REPO_ROOT/docs/reports/upstream/verify_numbers.py"
    if [ -f "$VN" ]; then
      out="$(python3 "$VN" 2>&1 | tail -1 | sed 's/^ *//')"
      case "$out" in
        *"расхождений 0"*) echo "ok    numbers   $out" ;;
        *) echo "FAIL  numbers   $out"; bad=1 ;;
      esac
    fi
    [ "$bad" = "0" ] && echo "audit: pass" || echo "audit: FAIL"
    exit "$bad"
    ;;

  ci)
    command -v gh >/dev/null 2>&1 || die "ci: gh CLI not found"
    shift
    slugs=("$@")
    [ "${#slugs[@]}" -gt 0 ] || slugs=("$(origin_slug || die 'ci: no origin remote; pass a SLUG')")
    for slug in "${slugs[@]}"; do
      echo "== $slug"
      gh run list --repo "$slug" --limit 30 \
        --json status,conclusion,displayTitle,databaseId,createdAt \
        --jq '.[] | select(.status != "completed")
              | "  " + (.databaseId | tostring) + "  " + .status + "  " + .createdAt + "  " + .displayTitle' \
        || echo "  (query failed)"
    done
    exit 0
    ;;

  lesson)
    [ -f "$WAVE_SKILL" ] || die "lesson: $WAVE_SKILL not found"
    if [ "${2:-}" = "--check" ]; then
      lesson_numbers | awk '
        { n = $1 + 0; seen[n]++; order[NR] = n }
        END {
          bad = 0
          for (n in seen) if (seen[n] > 1) { printf "duplicate lesson number %d (x%d)\n", n, seen[n]; bad = 1 }
          for (i = 2; i <= NR; i++) {
            if (order[i] < order[i-1]) { printf "out of order: %d follows %d\n", order[i], order[i-1]; bad = 1 }
            else if (order[i] > order[i-1] + 1) { printf "gap: %d -> %d\n", order[i-1], order[i]; bad = 1 }
          }
          printf "%d lessons, highest %d, %s\n", NR, order[NR], bad ? "ANOMALIES ABOVE" : "no anomalies"
          exit bad
        }'
      exit $?
    fi
    title="${2:?tri lesson needs a TITLE (or --check)}"
    body="${3:?tri lesson needs a BODY}"
    case "$title" in *.) ;; *) title="${title}." ;; esac
    if grep -qF -- "$title" "$WAVE_SKILL"; then
      die "lesson: a lesson with this title already exists -- refusing to duplicate"
    fi
    no="$(last_lesson_no)" || die "lesson: no numbered lessons found in $WAVE_SKILL"
    next=$((no + 1))
    anchor="$(grep -nE '^\*\*[0-9]+\.' "$WAVE_SKILL" | tail -1 | cut -d: -f1)"
    # Insert before the first heading after the last lesson, so the new entry
    # lands inside the lesson block instead of at end-of-file.
    insert_at="$(awk -v start="$anchor" 'NR > start && /^#/ { print NR; exit }' "$WAVE_SKILL")"
    [ -n "$insert_at" ] || insert_at="$(($(wc -l < "$WAVE_SKILL") + 1))"
    tmp="$(mktemp "${TMPDIR:-/tmp}/tri-lesson.XXXXXX")"
    awk -v at="$insert_at" -v n="$next" -v t="$title" -v b="$body" '
      NR == at { printf "**%d. %s** %s\n\n", n, t, b }
      { print }
      END { if (at > NR) printf "**%d. %s** %s\n", n, t, b }
    ' "$WAVE_SKILL" > "$tmp"
    mv "$tmp" "$WAVE_SKILL"
    echo "tri lesson: wrote #$next at line $insert_at of ${WAVE_SKILL#"$REPO_ROOT"/}"
    exit 0
    ;;

  theorem)
    [ -f "$THEORY_DOC" ] || die "theorem: $THEORY_DOC not found"
    if [ "${2:-}" = "--check" ]; then
      theorem_tokens | awk '
        { tok = $1; seen[tok]++; n = tok; gsub(/[^0-9]/, "", n); order[NR] = n + 0; last_tok = tok }
        END {
          bad = 0
          for (t in seen) if (seen[t] > 1) { printf "duplicate theorem %s (x%d)\n", t, seen[t]; bad = 1 }
          for (i = 2; i <= NR; i++)
            if (order[i] < order[i-1]) { printf "out of order: T%d follows T%d\n", order[i], order[i-1]; bad = 1 }
          printf "%d theorem headings, highest %s, %s\n", NR, last_tok, bad ? "ANOMALIES ABOVE" : "no anomalies"
          exit bad
        }'
      exit $?
    fi
    no="$(last_theorem_no)" || die "theorem: no theorem headings found"
    echo "last T${no} -> next T$((no + 1))"
    echo "append rule: '### T$((no + 1)) -- TITLE [measured|proved|open]' goes BEFORE the closing"
    echo "             '---' + 'φ² + φ⁻² = 3 | TRINITY' block of ${THEORY_DOC#"$REPO_ROOT"/}"
    exit 0
    ;;
esac

T27C="${TRI_T27C:-}"
if [[ -z "$T27C" ]]; then
  for p in "$REPO_ROOT/target/release/t27c" "$REPO_ROOT/target/debug/t27c" "$REPO_ROOT/bootstrap/target/release/t27c" "$REPO_ROOT/bootstrap/target/debug/t27c"; do
    [[ -x "$p" ]] && T27C="$p" && break
  done
fi
if [[ ! -x "$T27C" ]]; then
  echo "tri: t27c not found. Run: cd bootstrap && cargo build --release" >&2
  echo "tri: local commands still work -- see 'tri help'" >&2
  exit 1
fi
# `t27c suite` is the only subcommand that accepts --repo-root.
# Map `tri test` to the suite subcommand; pass other commands through unchanged.
if [[ "$cmd" == "test" || "$cmd" == "suite" ]]; then
    # Forward everything after the subcommand to t27c suite, including --json.
    exec "$T27C" suite --repo-root "$REPO_ROOT" "${@:2}"
else
    exec "$T27C" "$@"
fi
