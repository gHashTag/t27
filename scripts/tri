#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
T27C="${TRI_T27C:-}"
if [[ -z "$T27C" ]]; then
  for p in "$REPO_ROOT/target/release/t27c" "$REPO_ROOT/target/debug/t27c" "$REPO_ROOT/bootstrap/target/release/t27c" "$REPO_ROOT/bootstrap/target/debug/t27c"; do
    [[ -x "$p" ]] && T27C="$p" && break
  done
fi
if [[ ! -x "$T27C" ]]; then
  echo "tri: t27c not found. Run: cd bootstrap && cargo build --release" >&2
  exit 1
fi
# `--repo-root` is a per-subcommand option in the clap CLI, not a global one.
# Passing it before the subcommand made every `tri` invocation fail with
# "unexpected argument '--repo-root' found". Each subcommand already defaults
# --repo-root to ".", so running from the repo root is equivalent and correct.
cd "$REPO_ROOT"
exec "$T27C" "$@"
